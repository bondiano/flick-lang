{
  "name": "@flick-lang/runtime",
  "version": "0.1.0",
  "description": "Runtime adapter for code generated by the Flick compiler, on top of Effect",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings",
    "test": "tsc -p tsconfig.build.json && node --test"
  },
  "dependencies": {
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  }
}
