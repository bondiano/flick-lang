{
  "name": "@flick-lang/runtime",
  "version": "0.1.0",
  "description": "Runtime adapter for code generated by the Flick compiler, on top of Effect",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "default": "./dist/core/*.js"
    },
    "./runner/*": {
      "types": "./dist/runner/*.d.ts",
      "default": "./dist/runner/*.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./ui/react": {
      "types": "./dist/ui/react/index.d.ts",
      "default": "./dist/ui/react/index.js"
    },
    "./ui/html": {
      "types": "./dist/ui/html.d.ts",
      "default": "./dist/ui/html.js"
    },
    "./ui/server": {
      "types": "./dist/ui/server.d.ts",
      "default": "./dist/ui/server.js"
    },
    "./sql": {
      "types": "./dist/sql/index.d.ts",
      "default": "./dist/sql/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./effect/*": {
      "types": "./dist/effect/*.d.ts",
      "default": "./dist/effect/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings",
    "test": "tsc -p tsconfig.build.json && node --test"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "effect": "4.0.5"
  },
  "peerDependencies": {
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "jsdom": "30.1.3",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.1.0-beta"
  }
}
