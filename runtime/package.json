{
  "name": "@flick-lang/runtime",
  "version": "0.1.0",
  "description": "Flick-owned runtime, independent of Effect",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bondiano/flick-lang.git",
    "directory": "runtime"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/rt/index.d.ts",
      "default": "./dist/rt/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./tags": {
      "types": "./dist/tags.d.ts",
      "default": "./dist/tags.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "default": "./dist/core/*.js"
    },
    "./rt": {
      "types": "./dist/rt/index.d.ts",
      "default": "./dist/rt/index.js"
    },
    "./rt/*": {
      "types": "./dist/rt/*.d.ts",
      "default": "./dist/rt/*.js"
    },
    "./ui/dom": {
      "types": "./dist/ui/dom.d.ts",
      "default": "./dist/ui/dom.js"
    },
    "./ui/markup": {
      "types": "./dist/ui/markup.d.ts",
      "default": "./dist/ui/markup.js"
    },
    "./ui/react/handlers": {
      "types": "./dist/ui/react/handlers.d.ts",
      "default": "./dist/ui/react/handlers.js"
    },
    "./ui/react/nodes": {
      "types": "./dist/ui/react/nodes.d.ts",
      "default": "./dist/ui/react/nodes.js"
    },
    "./ui/react/tree": {
      "types": "./dist/ui/react/tree.d.ts",
      "default": "./dist/ui/react/tree.js"
    }
  },
  "files": [
    "dist/core",
    "dist/rt",
    "dist/internal.*",
    "dist/tags.*",
    "dist/ui/dom.*",
    "dist/ui/markup.*",
    "dist/ui/react/handlers.*",
    "dist/ui/react/nodes.*",
    "dist/ui/react/tree.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings",
    "test": "tsc -p tsconfig.build.json && node --test"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "jsdom": "30.1.3",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.1.0-beta"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
