module App.Main exposing (main)

import App.Driver as Driver
import App.Instances.Base as Base
import App.Instances.Other as Other
import App.Instances.Logged as Logged
import App.Instances.Alias as Alias

type error BodyError = BodyError

report : String -> Driver.State ->{} Unit
let report name state =
  let released = List.length state.closed
  let unique = List.length (List.dedupe state.closed) == released
  Platform.stdout_line
    "\{name} attempts=\{state.attempts} acquired=\{state.next} released=\{released} active=\{state.active} peak=\{state.peak} unique=\{unique}"

logging : Ref (List String) -> Layer none none {Log.Log}
let logging messages =
  Layer.succeed Log.Log { write = fun _ message -> Ref.update messages (fun xs -> xs ++ [message]) }

success : Unit ->{} Unit
let success () =
  let state = Ref.make Driver.initial
  let messages = Ref.make []
  let live = Driver.live 0 state
  report "construction" (Ref.get state)
  let outcome =
    Effect.exit
      (task {
        provide live {
          provide logging messages { provide Logged.layer { "\{Logged.get "a"} \{Alias.get "b"}" } }
        }
      })
  Platform.stdout_line "value=\{Option.with_default "failed" (Exit.value outcome)}"
  Platform.stdout_line "logs=\{String.join "|" (Ref.get messages)}"
  report "success" (Ref.get state)

failure : Int -> String ->{} Unit
let failure mode name =
  let state = Ref.make Driver.initial
  let outcome =
    Effect.exit
      (task {
        provide Driver.live mode state { provide Base.layer { from_result (Err BodyError) } }
      })
  Platform.stdout_line "\{name} failed=\{Exit.is_failure outcome}"
  report name (Ref.get state)

interruption : Unit ->{} Unit
let interruption () =
  let state = Ref.make Driver.initial
  let outcome =
    Effect.exit
      (task {
        provide Driver.live 0 state {
          provide Base.layer {
            let _ = Base.get "interrupted"
            Effect.interrupt ()
          }
        }
      })
  let interrupted =
    Option.with_default false (Option.map Cause.has_interrupts (Exit.failure outcome))
  Platform.stdout_line "interrupted=\{interrupted}"
  report "interruption" (Ref.get state)

overlap : Unit ->{Async} Unit
let overlap () =
  let state = Ref.make Driver.initial
  let first = Deferred.make ()
  let second = Deferred.make ()
  let outcome =
    Effect.exit
      (task {
        provide Driver.live 0 state {
          parallel
            (task {
              provide Base.layer {
                ignore (Deferred.succeed () first)
                Deferred.await_ second
                Base.get "one"
              }
            })
            (task {
              provide Other.layer {
                ignore (Deferred.succeed () second)
                Deferred.await_ first
                Other.get "two"
              }
            })
        }
      })
  Platform.stdout_line "overlap success=\{Exit.is_success outcome}"
  report "overlap" (Ref.get state)

main : Unit ->{Async} Unit
let main () =
  success ()
  failure 0 "body failure"
  failure 1 "acquisition failure"
  failure 2 "initialization failure"
  interruption ()
  overlap ()
