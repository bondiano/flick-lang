// The entry point: the external implementations, built as layers, are
// provided to the program here and nowhere else.
module App.Main exposing (main)

import App.Live exposing (users_live, log_live)
import App.Users exposing (Users, Log, NotFound(..), user_id, load_view, load_two)

describe : String ->{Users, Log;} String
let describe raw =
  try (load_view (user_id raw)).title with
  | NotFound id -> "not found: " ++ show id

program : Unit ->{Users, Log;} Unit
let program () =
  let both =
    try
      let (first, second) = load_two (user_id "u1") (user_id "u2")
      first.title ++ " and " ++ second.title
    with
    | NotFound id -> "not found: " ++ show id
  Platform.stdout_line both
  Platform.stdout_line (describe "u3")

main : Unit ->{; AppError} Unit
let main () = provide Layer.merge users_live log_live { program () }
