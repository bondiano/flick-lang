// The test implementations: `Users` over a fixed list and `Log` into a
// `Ref`, provided per test instead of the external ones.
module App.UsersTest

import App.Users exposing (User, Users, Log, NotFound(..), user_id, to_view, load_view, load_two)
import Test exposing (expect, to)

ada : User
let ada = { id = user_id "u1"; name = "  Ada  " }

grace : User
let grace = { id = user_id "u2"; name = "Grace" }

users_test : Layer none none {Users}
let users_test =
  Layer.succeed Users {
    get = fun id ->
      match List.find (fun user -> eq user.id id) [ada, grace] with
      | Some user -> user
      | None -> Fail.fail (NotFound id)
  }

log_test : Ref (List String) -> Layer none none {Log}
let log_test lines =
  Layer.succeed Log { info = fun line -> Ref.update lines (fun xs -> List.append xs [line]) }

suite "users" {
  test "to_view trims the name" { expect (to_view ada).title |> to.equal "Ada" }

  test "load_two loads both and logs each" {
    let lines = Ref.make []
    let (first, second) = provide Layer.merge users_test (log_test lines) {
      load_two (user_id "u1") (user_id "u2")
    }
    expect [first.title, second.title] |> to.equal ["Ada", "Grace"]
    expect (List.sort (Ref.get lines)) |> to.equal ["Loaded Ada", "Loaded Grace"]
  }

  test "load_view fails with NotFound" {
    let lines = Ref.make []
    let outcome =
      try
        let view = provide Layer.merge users_test (log_test lines) { load_view (user_id "nobody") }
        view.title
      with
      | NotFound id -> "missing \{show id}"
    expect outcome |> to.equal "missing \"nobody\""
    expect (Ref.get lines) |> to.equal []
  }
}
