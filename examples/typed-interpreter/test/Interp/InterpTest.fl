module Interp.InterpTest

import Interp.Check exposing (Term(..), Typed(..), check)
import Interp.Expr exposing (Expr(..), eval, pretty)
import Interp.Ty as Ty exposing (Ty(..))
import Interp.Value exposing (Showable(..), results)
import Test exposing (expect, to)

/// The type `check` gives a term, described, or why it has none.
typed : Term -> String
let typed term =
  match check term with
  | Ok (Typed t _) -> Ty.describe t
  | Err why -> why

/// A showable value shown: only a `match` arm takes its `Show` out.
shown : Showable -> String
let shown s =
  match s with
  | Showable x -> show x

suite "interpreter" {
  test "eval returns the type the expression has" {
    expect (eval (Apply (Apply Plus (IntLit 1)) (IntLit 2))) |> to.equal 3
    expect (eval (Apply (Apply Less (IntLit 1)) (IntLit 2))) |> to.equal true
    expect (eval (Named "seven" (If (BoolLit false) (IntLit 0) (IntLit 7)))) |> to.equal 7
  }

  test "pretty prints an application and a name" {
    expect (pretty (If (Apply Not (BoolLit true)) (IntLit 1) (Named "x" (IntLit 2))))
      |> to.equal "if (not true) then 1 else x"
  }

  test "check types a term or says why it has no type" {
    expect (typed (TmPlus (TmInt 1) (TmInt 2))) |> to.equal "Int"
    expect (typed (TmNot (TmBool false))) |> to.equal "Bool"
    expect (typed (TmPlus (TmInt 1) (TmBool true))) |> to.equal "expected Int, found Bool"
    expect (typed (TmIf (TmInt 0) (TmInt 1) (TmInt 2))) |> to.equal "expected Bool, found Int"
    expect (typed (TmIf (TmBool true) (TmInt 1) (TmBool false)))
    |> to.equal "expected Int, found Bool"
  }

  test "equal compares function types part by part" {
    expect (Option.is_some (Ty.equal (TFun TInt TBool) (TFun TInt TBool))) |> to.equal true
    expect (Option.is_some (Ty.equal (TFun TInt TBool) (TFun TBool TBool))) |> to.equal false
  }

  test "a list of showables shows each value with its own Show" {
    expect (List.map shown [Showable 1, Showable true, Showable [2, 3]])
      |> to.equal ["1", "true", "[2, 3]"]
  }

  test "results run the well-typed terms" {
    expect
      (results [
        TmPlus (TmInt 1) (TmInt 2),
        TmLess (TmInt 2) (TmInt 1),
        TmPlus (TmBool true) (TmInt 1),
      ])
      |> to.equal ["3", "false", "type error: expected Int, found Bool"]
  }
}
