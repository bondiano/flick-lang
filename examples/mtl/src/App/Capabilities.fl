/// The same capability-polymorphic workflow over pure and effectful bases.
module App.Capabilities exposing (main, Stack, workflow, lift_base, run)

import Mtl.Classes exposing (..)
import Mtl.Identity as Identity exposing (Identity)
import Mtl.ReaderT as ReaderT exposing (ReaderT)
import Mtl.StateT as StateT exposing (StateT)
import Mtl.WriterT as WriterT exposing (WriterT)
import Mtl.ExceptT as ExceptT exposing (ExceptT)

type alias Stack (m : Type -> Type) a =
  ExceptT String (WriterT (List String) (StateT Float (ReaderT Float m))) a

workflow :
  (MonadState m Float, MonadReader m Float, MonadWriter m (List String), MonadError m String) =>
  Float -> m Float
let workflow input = do {
  tell ["begin"]
  if input < 0 then
    throw_error "negative"
  else
    do {
      environment <- ask
      let value = input + environment
      before <- get
      put (before + value)
      tell ["done"]
      pure value
    }
}

lift_base : Monad m => (m a)^c -> (Stack m a)^c
let lift_base action =
  reading : (ReaderT Float m a)^c
  let reading = lift action
  changing : (StateT Float (ReaderT Float m) a)^c
  let changing = lift reading
  writing : (WriterT (List String) (StateT Float (ReaderT Float m)) a)^c
  let writing = lift changing
  lift writing

run : Float -> Float -> (Stack m a)^c -> (m ((Result String a, List String), Float))^c
let run environment initial action =
  ReaderT.run (StateT.run (WriterT.run (ExceptT.run action)) initial) environment

format : ((Result String Float, List String), Float) -> String
let format ((result, output), final) =
  let outcome =
    match result with
    | Ok value -> "ok=" ++ show value
    | Err problem -> "error=" ++ problem
  outcome ++ " state=" ++ show final ++ " log=" ++ String.join "," output

identity_run : Float -> ((Result String Float, List String), Float)
let identity_run input =
  base : Identity Unit
  let base = pure ()
  action : Stack Identity Float
  let action = do {
    lift_base base
    workflow input
  }
  Identity.run (run 3 10 action)

eff_run : Float ->{; AppError} ((Result String Float, List String), Float)
let eff_run input =
  let counter = Ref.make 0
  base : Eff none none Unit
  let base = task { Ref.update counter (fun n -> n + 1) }
  action : Stack (Eff none none) Float
  let action = do {
    lift_base base
    workflow input
  }
  let suspended = run 3 10 action
  if Ref.get counter != 0 then App.fail "lifted base action ran before await"
  let observed = await suspended
  if Ref.get counter != 1 then App.fail "lifted base action did not run exactly once"
  observed

main : Unit ->{; AppError} Unit
let main () =
  Platform.stdout_line ("identity " ++ format (identity_run 2))
  Platform.stdout_line ("identity " ++ format (identity_run (0 - 1)))
  Platform.stdout_line ("eff " ++ format (eff_run 2))
  Platform.stdout_line ("eff " ++ format (eff_run (0 - 1)))
