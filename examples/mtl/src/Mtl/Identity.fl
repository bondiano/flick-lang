/// The pure base for transformer stacks: `Identity a` holds only an `a`.
///
/// Its ordinary Prelude `Functor`, `Applicative` and `Monad` instances apply
/// callbacks directly. `map2` combines its left and right values in that order;
/// there is no extra effect, environment or state to interpret.
/// Finish a stack with `run` after removing its transformer layers.
module Mtl.Identity exposing (Identity(..), run)

/// A value with no additional computation context.
type Identity a = Identity a

/// Remove the base wrapper, preserving the value's captures.
run : (Identity a)^c -> a^c
let run (Identity value) = value

instance Functor Identity =
  map : (forall v. a^v -> b)^c -> (Identity a)^d -> (Identity b)^(c + d)
  let map f (Identity value) = Identity (f value)

instance Applicative Identity =
  pure : a^c -> (Identity a)^c
  let pure value = Identity value
  map2 : (forall u v. a^u -> b^v -> x)^c -> (Identity a)^d -> (Identity b)^d -> (Identity x)^(c + d)
  let map2 f (Identity left) (Identity right) = Identity (f left right)

instance Monad Identity =
  flat_map : (forall v. a^v -> (Identity b)^(c + v))^c -> (Identity a)^d -> (Identity b)^(c + d)
  let flat_map f (Identity value) = f value
