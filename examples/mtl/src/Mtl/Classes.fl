/// Capability classes shared by ordinary user-defined transformer instances.
module Mtl.Classes exposing (
  MonadTrans(..),
  MonadState(..),
  MonadReader(..),
  MonadWriter(..),
  MonadError(..),
)

class MonadTrans (t : (Type -> Type) -> Type -> Type) =
  lift : forall c m a. Monad m => (m a)^c -> (t m a)^c

class Monad m => MonadState (m : Type -> Type) s | m -> s =
  get : m s
  put : forall c. s^c -> (m Unit)^c
  state : forall c a. (forall v. s^v -> (a, s)^(c + v))^c -> (m a)^c
  let state step = do {
    before <- get
    let (value, after) = step before
    put after
    pure value
  }

class Monad m => MonadReader (m : Type -> Type) r | m -> r =
  ask : m r
  local : forall c d a. (forall v. r^v -> r^(c + v))^c ->
    ((m a)^d -> (m a)^(c + d))^c
  reader : forall c a. (forall v. r^v -> a)^c -> (m a)^c
  let reader project = map project ask

class (Monad m, Monoid w) => MonadWriter (m : Type -> Type) w | m -> w =
  tell : forall c. w^c -> (m Unit)^c
  listen : forall c a. (m a)^c -> (m (a, w))^c
  pass : forall c d a. (m (a, (w -> w)^c))^d -> (m a)^(c + d)
  writer : forall c a. (a, w)^c -> (m a)^c
  let writer (value, output) = do { tell output; pure value }

class Monad m => MonadError (m : Type -> Type) e | m -> e =
  throw_error : forall c a. e^c -> (m a)^c
  catch_error : forall c d a. (forall v. e^v -> (m a)^(c + v))^c ->
    ((m a)^d -> (m a)^(c + d))^c
