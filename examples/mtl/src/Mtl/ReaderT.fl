/// Share a read-only environment through an inner computation using `r -> m a`.
///
/// `run` supplies the environment; every action in a `do` block sees it.
/// `local` changes the environment for one nested action, not its siblings.
/// Unlike `StateT`, `map2` has no state dependency between its operands:
/// both receive the same environment, so only `Applicative m` is required.
/// Their combination follows the inner `m`'s `map2` semantics.
module Mtl.ReaderT exposing (ReaderT(..), run)

import Mtl.Classes exposing (
  MonadTrans(..),
  MonadState(..),
  MonadReader(..),
  MonadWriter(..),
  MonadError(..),
)

/// A delayed computation that reads an environment and returns an action in `m`.
type ReaderT r (m : Type -> Type) a = ReaderT (r -> m a)

/// Supply the environment and remove this layer, yielding `m a`.
run : (ReaderT r m a)^c -> r^d -> (m a)^(c + d)
let run (ReaderT read) environment = read environment

instance Functor m => Functor (ReaderT r m) =
  let map f (ReaderT read) = ReaderT (fun environment -> map f (read environment))

instance Applicative m => Applicative (ReaderT r m) =
  let pure value = ReaderT (fun _ -> pure value)
  let map2 f left right =
    ReaderT (fun environment -> map2 f (run left environment) (run right environment))

instance Monad m => Monad (ReaderT r m) =
  let flat_map f action =
    ReaderT (fun environment -> do {
      value <- run action environment
      run (f value) environment
    })

instance MonadTrans (ReaderT r) =
  let lift action = ReaderT (fun _ -> action)

instance Monad m => MonadReader (ReaderT r m) r =
  let ask = ReaderT (fun environment -> pure environment)
  let local update action = ReaderT (fun environment -> run action (update environment))
  let reader project = ReaderT (fun environment -> pure (project environment))

instance MonadState m s => MonadState (ReaderT r m) s =
  let get = lift get
  let put value = lift (put value)
  let state step = lift (state step)

instance MonadWriter m w => MonadWriter (ReaderT r m) w =
  let tell output = lift (tell output)
  let listen action = ReaderT (fun environment -> listen (run action environment))
  let pass action = ReaderT (fun environment -> pass (run action environment))
  let writer value = lift (writer value)

instance MonadError m e => MonadError (ReaderT r m) e =
  let throw_error failure = lift (throw_error failure)
  let catch_error handler action =
    ReaderT (fun environment ->
      catch_error (fun failure -> run (handler failure) environment) (run action environment)
    )
