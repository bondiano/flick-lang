/// Thread state through an inner computation using `s -> m (a, s)`.
///
/// Each action receives the preceding action's final state. `map2` therefore
/// needs `Monad m`, even for an applicative `and` group: the left action must
/// finish before the right action can receive its state.
/// `run` supplies the initial state and exposes both the result and final state
/// inside `m`; an inner failure can still prevent that pair from being returned.
module Mtl.StateT exposing (StateT(..), run)

import Mtl.Classes exposing (
  MonadTrans(..),
  MonadState(..),
  MonadReader(..),
  MonadWriter(..),
  MonadError(..),
)

/// A delayed state transition returning a value and the next state inside `m`.
type StateT s (m : Type -> Type) a = StateT (s -> m (a, s))

/// Supply the initial state and remove this layer, yielding `m (a, s)`.
run : (StateT s m a)^c -> s^d -> (m (a, s))^(c + d)
let run (StateT step) state = step state

instance Functor m => Functor (StateT s m) =
  let map f (StateT step) =
    StateT (fun state -> map (fun (value, next) -> (f value, next)) (step state))

instance Monad m => Applicative (StateT s m) =
  let pure value = StateT (fun state -> pure (value, state))
  let map2 f left right =
    StateT (fun state -> do {
      (a, next) <- run left state
      (b, final) <- run right next
      pure (f a b, final)
    })

instance Monad m => Monad (StateT s m) =
  let flat_map f action =
    StateT (fun state -> do {
      (value, next) <- run action state
      run (f value) next
    })

instance MonadTrans (StateT s) =
  let lift action =
    StateT (fun current -> do {
      value <- action
      pure (value, current)
    })

instance Monad m => MonadState (StateT s m) s =
  let get = StateT (fun current -> pure (current, current))

  let put next = StateT (fun _ -> pure ((), next))

  let state step = StateT (fun current -> pure (step current))

instance MonadReader m r => MonadReader (StateT s m) r =
  let ask = lift ask

  let local update action = StateT (fun current -> local update (run action current))

  let reader project = lift (reader project)

instance MonadWriter m w => MonadWriter (StateT s m) w =
  let tell output = lift (tell output)

  listen : (StateT s m a)^c -> (StateT s m (a, w))^c
  let listen action =
    StateT (fun current ->
      finish : ((a, s), w) -> ((a, w), s)
      let finish ((value, next), output) = ((value, output), next)
      map finish (listen (run action current))
    )

  pass : (StateT s m (a, (w -> w)^c))^d -> (StateT s m a)^(c + d)
  let pass action =
    StateT (fun current ->
      adapt : ((a, (w -> w)^c), s) -> ((a, s), (w -> w)^c)
      let adapt ((value, update), next) = ((value, next), update)
      pass (map adapt (run action current))
    )

  let writer value = lift (writer value)

instance MonadError m e => MonadError (StateT s m) e =
  let throw_error problem = lift (throw_error problem)

  let catch_error handler action =
    StateT (fun current ->
      catch_error (fun problem -> run (handler problem) current) (run action current)
    )
