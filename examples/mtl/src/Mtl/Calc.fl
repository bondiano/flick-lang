/// A calculator over any `MonadError String m`: the same `do` program
/// runs as a `Result`, which says what failed, and recovers with `catch`.
module Mtl.Calc exposing (Expr(..), eval, eval_or)

import Mtl.Error exposing (MonadError, throw, catch)

type Expr =
  | Num Number
  | Add Expr Expr
  | Div Expr Expr
  | Neg Expr

eval : MonadError String m => Expr -> m Number
let rec eval e =
  match e with
  | Num n -> pure n
  | Neg a -> do { x <- eval a; pure (0 - x) }
  // both operands are independent: an `and` group
  | Add a b -> do { x <- eval a and y <- eval b; pure (x + y) }
  | Div a b ->
    do {
      x <- eval a and y <- eval b
      if y == 0 then throw ("division of " ++ show x ++ " by zero") else pure (x / y)
    }

/// `eval`, with `fallback` when it fails.
eval_or : MonadError String m => Number -> Expr -> m Number
let eval_or fallback e = catch (fun _ -> pure fallback) (eval e)
