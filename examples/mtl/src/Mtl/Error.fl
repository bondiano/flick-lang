/// `MonadError`: monads that fail with an error of their own and recover
/// from it. The error is a function of the monad (`m -> e`), so `throw`
/// needs no annotation. The transformers of an MTL (`StateT`, `ReaderT`,
/// `WriterT`, `ExceptT`) cannot be instances yet: see
/// `implementation-decisions.md`, "Instances of user types".
module Mtl.Error exposing (..)

class Monad m => MonadError e m | m -> e =
  throw : forall a. e -> m a
  catch : forall a. (e -> m a) -> m a -> m a

instance MonadError e (Result e) =
  throw : forall a. e -> Result e a
  let throw e = Err e
  catch : forall a. (e -> Result e a) -> Result e a -> Result e a
  let catch handle result =
    match result with
    | Err e -> handle e
    | Ok x -> Ok x

/// `None` fails with nothing to say.
instance MonadError Unit Option =
  throw : forall a. Unit -> Option a
  let throw _ = None
  catch : forall a. (Unit -> Option a) -> Option a -> Option a
  let catch handle option =
    match option with
    | None -> handle ()
    | Some x -> Some x
