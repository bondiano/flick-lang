module App.PlanTest

import App.Plan exposing (plan)
import Test exposing (expect, to)

suite "planner" {
  test "an empty plan leaves the supplied budget untouched" {
    expect (plan { budget = 60; overhead = 0 } [])
      |> to.equal (Some [], { remaining = 60; completed = [] })
  }

  test "an exact fit completes every task" {
    expect (plan { budget = 60; overhead = 0 } ["docs", "tests", "lint"])
      |> to.equal (
        Some ["docs", "tests", "lint"],
        { remaining = 0; completed = ["docs", "tests", "lint"] },
      )
  }

  test "ReaderT configuration adds overhead to each task" {
    expect (plan { budget = 36; overhead = 3 } ["docs", "lint"])
      |> to.equal (Some ["docs", "lint"], { remaining = 0; completed = ["docs", "lint"] })
  }

  test "overhead can reject a task whose base time would fit" {
    expect (plan { budget = 20; overhead = 1 } ["docs", "lint"])
      |> to.equal (None, { remaining = 20; completed = [] })
  }

  test "zero budget accepts no tasks without charging overhead" {
    expect (plan { budget = 0; overhead = 3 } [])
      |> to.equal (Some [], { remaining = 0; completed = [] })
  }

  test "an unknown task preserves the prefix and stops before later tasks" {
    expect (plan { budget = 60; overhead = 0 } ["docs", "missing", "lint"])
      |> to.equal (None, { remaining = 40; completed = ["docs"] })
  }

  test "an over-budget task does not consume time or schedule later tasks" {
    expect (plan { budget = 25; overhead = 0 } ["docs", "lint", "tests"])
      |> to.equal (None, { remaining = 5; completed = ["docs"] })
  }

  test "repeated tasks consume time again" {
    expect (plan { budget = 60; overhead = 0 } ["docs", "docs"])
      |> to.equal (Some ["docs", "docs"], { remaining = 20; completed = ["docs", "docs"] })
  }
}
