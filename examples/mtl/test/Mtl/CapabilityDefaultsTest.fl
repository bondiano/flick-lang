module Mtl.CapabilityDefaultsTest exposing (tests)

import Mtl.Classes exposing (MonadState(..), MonadReader(..), MonadWriter(..))
import Mtl.Identity as Identity exposing (Identity)
import App.Capabilities as Capabilities exposing (Stack)

type Defaults a = Defaults (Stack Identity a)

unwrap : (Defaults a)^c -> (Stack Identity a)^c
let unwrap (Defaults action) = action

instance Functor Defaults =
  let map f (Defaults action) = Defaults (map f action)

instance Applicative Defaults =
  let pure value = Defaults (pure value)
  let map2 f (Defaults left) (Defaults right) = Defaults (map2 f left right)

instance Monad Defaults =
  let flat_map f (Defaults action) = Defaults (flat_map (fun value -> unwrap (f value)) action)

// Omit state, reader and writer so this wrapper executes the class defaults.
instance MonadState Defaults Float =
  let get = Defaults get
  let put next = Defaults (put next)

instance MonadReader Defaults Float =
  let ask = Defaults ask
  let local update (Defaults action) = Defaults (local update action)

instance MonadWriter Defaults (List String) =
  let tell output = Defaults (tell output)
  let listen (Defaults action) = Defaults (listen action)
  let pass (Defaults action) = Defaults (pass action)

tests : List Test.Test
let tests = [
  Test.test "state, reader and writer execute their class default bodies" (fun () ->
    action : Defaults (Float, Float)
    let action = do {
      old_state <- state (fun old -> (old, old + 2))
      environment_value <- reader (fun environment -> environment + 1)
      writer_value <- writer (environment_value, ["default"])
      pure (old_state, writer_value)
    }
    Test.equal
      ((Ok (10, 4), ["default"]), 12)
      (Identity.run (Capabilities.run 3 10 (unwrap action)))
  ),
]
