module Mtl.CapabilitiesTest

import App.Capabilities as Capabilities exposing (Stack)
import Mtl.Classes exposing (..)
import Mtl.ExceptT as ExceptT exposing (ExceptT)
import Mtl.Identity as Identity exposing (Identity)
import Mtl.MaybeT as MaybeT exposing (MaybeT)
import Mtl.ReaderT as ReaderT exposing (ReaderT)
import Mtl.StateT as StateT exposing (StateT)
import Mtl.WriterT as WriterT exposing (WriterT)
import Test exposing (expect, to)

state_probe : MonadState m Float => m (List Float)
let state_probe = do {
  first <- get
  same <- get
  put first
  restored <- get
  put 7
  seven <- get
  put 7
  put 9
  nine <- get
  old <- state (fun before -> (before, before + 2))
  final <- get
  pure [first, same, restored, seven, nine, old, final]
}

reader_probe : MonadReader m Float => m (List Float)
let reader_probe = do {
  before <- ask
  inside <- local (fun n -> n + 10) ask
  after <- ask
  projected <- reader (fun n -> n * 2)
  mapped <- map (fun n -> n * 2) ask
  unchanged <- local (fun n -> n) ask
  nested <- local (fun n -> n + 10) (local (fun n -> n * 2) ask)
  composed <- local (fun n -> (n + 10) * 2) ask
  pure [before, inside, after, projected, mapped, unchanged, nested, composed]
}

writer_probe : MonadWriter m (List String) => m ((Float, List String), Float)
let writer_probe = do {
  tell []
  tell ["prefix"]
  heard <-
    listen
      (do {
        tell ["a"]
        writer (7, ["b"])
      })
  changed <-
    pass
      (do {
        tell ["c"]
        tell ["d"]
        pure (9, List.reverse)
      })
  tell ["suffix"]
  pure (heard, changed)
}

error_probe : MonadError m String => m (Float, Float)
let error_probe = do {
  recovered <-
    catch_error
      (fun problem -> pure (if problem == "bad" then 7 else 0))
      (do {
        _ <- throw_error "bad"
        pure 99
      })
  successful <- catch_error (fun _ -> throw_error "unexpected handler") (pure 8)
  pure (recovered, successful)
}

suite "State capability matrix" {
  test "MaybeT inherits every State operation" {
    action : MaybeT (StateT Float Identity) (List Float)
    let action = state_probe
    expect (Identity.run (StateT.run (MaybeT.run action) 3))
    |> to.equal (Some [3, 3, 3, 7, 9, 9, 11], 11)
  }

  test "StateT supplies every native State operation" {
    action : StateT Float Identity (List Float)
    let action = state_probe
    expect (Identity.run (StateT.run action 3)) |> to.equal ([3, 3, 3, 7, 9, 9, 11], 11)
  }

  test "ReaderT inherits every State operation" {
    action : ReaderT String (StateT Float Identity) (List Float)
    let action = state_probe
    expect (Identity.run (StateT.run (ReaderT.run action "scope") 3))
    |> to.equal ([3, 3, 3, 7, 9, 9, 11], 11)
  }

  test "WriterT inherits every State operation without output" {
    action : WriterT (List String) (StateT Float Identity) (List Float)
    let action = state_probe
    expect (Identity.run (StateT.run (WriterT.run action) 3))
    |> to.equal (([3, 3, 3, 7, 9, 9, 11], []), 11)
  }

  test "ExceptT inherits every State operation" {
    action : ExceptT String (StateT Float Identity) (List Float)
    let action = state_probe
    expect (Identity.run (StateT.run (ExceptT.run action) 3))
    |> to.equal (Ok [3, 3, 3, 7, 9, 9, 11], 11)
  }
}

suite "Reader capability matrix" {
  test "MaybeT inherits every Reader operation" {
    action : MaybeT (ReaderT Float Identity) (List Float)
    let action = reader_probe
    expect (Identity.run (ReaderT.run (MaybeT.run action) 5))
    |> to.equal (Some [5, 15, 5, 10, 10, 5, 30, 30])
  }

  test "StateT inherits every Reader operation without changing state" {
    action : StateT Float (ReaderT Float Identity) (List Float)
    let action = reader_probe
    expect (Identity.run (ReaderT.run (StateT.run action 3) 5))
    |> to.equal ([5, 15, 5, 10, 10, 5, 30, 30], 3)
  }

  test "ReaderT supplies every native Reader operation" {
    action : ReaderT Float Identity (List Float)
    let action = reader_probe
    expect (Identity.run (ReaderT.run action 5)) |> to.equal [5, 15, 5, 10, 10, 5, 30, 30]
  }

  test "WriterT inherits every Reader operation without output" {
    action : WriterT (List String) (ReaderT Float Identity) (List Float)
    let action = reader_probe
    expect (Identity.run (ReaderT.run (WriterT.run action) 5))
    |> to.equal ([5, 15, 5, 10, 10, 5, 30, 30], [])
  }

  test "ExceptT inherits every Reader operation" {
    action : ExceptT String (ReaderT Float Identity) (List Float)
    let action = reader_probe
    expect (Identity.run (ReaderT.run (ExceptT.run action) 5))
    |> to.equal (Ok [5, 15, 5, 10, 10, 5, 30, 30])
  }
}

suite "Writer capability matrix" {
  test "MaybeT inherits every Writer operation" {
    action : MaybeT (WriterT (List String) Identity) ((Float, List String), Float)
    let action = writer_probe
    expect (Identity.run (WriterT.run (MaybeT.run action)))
    |> to.equal (Some ((7, ["a", "b"]), 9), ["prefix", "a", "b", "d", "c", "suffix"])
  }

  test "StateT inherits every Writer operation and preserves state" {
    action : StateT Float (WriterT (List String) Identity) ((Float, List String), Float)
    let action = writer_probe
    expect (Identity.run (WriterT.run (StateT.run action 3)))
    |> to.equal ((((7, ["a", "b"]), 9), 3), ["prefix", "a", "b", "d", "c", "suffix"])
  }

  test "ReaderT inherits every Writer operation" {
    action : ReaderT Float (WriterT (List String) Identity) ((Float, List String), Float)
    let action = writer_probe
    expect (Identity.run (WriterT.run (ReaderT.run action 5)))
    |> to.equal (((7, ["a", "b"]), 9), ["prefix", "a", "b", "d", "c", "suffix"])
  }

  test "WriterT supplies every native Writer operation" {
    action : WriterT (List String) Identity ((Float, List String), Float)
    let action = writer_probe
    expect (Identity.run (WriterT.run action))
    |> to.equal (((7, ["a", "b"]), 9), ["prefix", "a", "b", "d", "c", "suffix"])
  }

  test "ExceptT inherits every Writer operation" {
    action : ExceptT String (WriterT (List String) Identity) ((Float, List String), Float)
    let action = writer_probe
    expect (Identity.run (WriterT.run (ExceptT.run action)))
    |> to.equal (Ok ((7, ["a", "b"]), 9), ["prefix", "a", "b", "d", "c", "suffix"])
  }
}

suite "Error capability matrix" {
  test "MaybeT inherits throw and catch" {
    action : MaybeT (ExceptT String Identity) (Float, Float)
    let action = error_probe
    expect (Identity.run (ExceptT.run (MaybeT.run action))) |> to.equal (Ok (Some (7, 8)))
  }

  test "StateT inherits throw and catch" {
    action : StateT Float (ExceptT String Identity) (Float, Float)
    let action = error_probe
    expect (Identity.run (ExceptT.run (StateT.run action 3))) |> to.equal (Ok ((7, 8), 3))
  }

  test "ReaderT inherits throw and catch" {
    action : ReaderT Float (ExceptT String Identity) (Float, Float)
    let action = error_probe
    expect (Identity.run (ExceptT.run (ReaderT.run action 5))) |> to.equal (Ok (7, 8))
  }

  test "WriterT inherits throw and catch without inventing output" {
    action : WriterT (List String) (ExceptT String Identity) (Float, Float)
    let action = error_probe
    expect (Identity.run (ExceptT.run (WriterT.run action))) |> to.equal (Ok ((7, 8), []))
  }

  test "ExceptT supplies native throw and catch" {
    action : ExceptT String Identity (Float, Float)
    let action = error_probe
    expect (Identity.run (ExceptT.run action)) |> to.equal (Ok (7, 8))
  }
}

suite "full stack" {
  test "full-stack workflow uses the actual generic lift and runner" {
    base : Identity Unit
    let base = pure ()
    successful : Stack Identity Float
    let successful = do {
      Capabilities.lift_base base
      Capabilities.workflow 2
    }
    failed : Stack Identity Float
    let failed = do {
      Capabilities.lift_base base
      Capabilities.workflow (0 - 1)
    }
    expect (Identity.run (Capabilities.run 3 10 successful))
    |> to.equal ((Ok 5, ["begin", "done"]), 15)
    expect (Identity.run (Capabilities.run 3 10 failed))
    |> to.equal ((Err "negative", ["begin"]), 10)
  }
}
