module Mtl.TransformersTest

import Mtl.Classes exposing (ask, get, lift, local, put)
import Mtl.Identity as Identity exposing (Identity)
import Mtl.MaybeT as MaybeT exposing (MaybeT)
import Mtl.ReaderT as ReaderT exposing (ReaderT)
import Mtl.StateT as StateT exposing (StateT)
import Test exposing (expect, to)

run_maybe : MaybeT Identity a -> Option a
let run_maybe action = Identity.run (MaybeT.run action)

run_state : Float -> StateT Float Identity a -> (a, Float)
let run_state initial action = Identity.run (StateT.run action initial)

run_reader : Float -> ReaderT Float Identity a -> a
let run_reader env action = Identity.run (ReaderT.run action env)

tick : StateT Float Identity Float
let tick = do {
  before <- get
  put (before + 1)
  pure before
}

suite "transformer behavior" {
  test "StateT applicative do runs left to right" {
    action : StateT Float Identity (Float, Float)
    let action = do {
      a <- tick and b <- tick
      pure (a, b)
    }
    expect (run_state 10 action) |> to.equal ((10, 11), 12)
  }

  test "ReaderT local restores the outer environment" {
    action : ReaderT Float Identity (Float, Float, Float)
    let action = do {
      before <- ask
      inside <- local (fun n -> n + 10) ask
      after <- ask
      pure (before, inside, after)
    }
    expect (run_reader 5 action) |> to.equal (5, 15, 5)
  }

  test "MaybeT lift distinguishes base errors from Nothing" {
    failed : MaybeT (Result String) Float
    let failed = lift (Err "offline")
    absent : MaybeT (Result String) Float
    let absent = MaybeT.from_option None
    expect (MaybeT.run failed) |> to.equal (Err "offline")
    expect (MaybeT.run absent) |> to.equal (Ok None)
  }

  test "MaybeT outside StateT retains the prefix and skips later actions" {
    action : MaybeT (StateT Float Identity) Float
    let action = do {
      before <- lift tick
      _ <- MaybeT.from_option (None : Option Unit)
      after <- lift tick
      pure (before + after)
    }
    expect (run_state 3 (MaybeT.run action)) |> to.equal (None, 4)
  }

  test "MaybeT applicative short-circuits before the second action" {
    failed : MaybeT (StateT Float Identity) Float
    let failed = do {
      _ <- lift tick
      _ <- MaybeT.from_option (None : Option Unit)
      pure 0
    }
    action : MaybeT (StateT Float Identity) Float
    let action = do {
      a <- failed and b <- lift tick
      pure (a + b)
    }
    expect (run_state 0 (MaybeT.run action)) |> to.equal (None, 1)
  }

  test "StateT outside MaybeT loses the state on Nothing" {
    absent : MaybeT Identity Unit
    let absent = MaybeT.from_option None
    action : StateT Float (MaybeT Identity) Unit
    let action = do {
      before <- get
      put (before + 1)
      lift absent
    }
    expect (run_maybe (StateT.run action 3)) |> to.equal None
  }

  test "MaybeT over Eff stays cold and skips effects after Nothing" {
    let seen = Ref.make []
    counted : Float -> Eff none none Float
    let counted n = task {
      Ref.update seen (fun xs -> xs ++ [n])
      n
    }
    action : MaybeT (Eff none none) Float
    let action = do {
      first <- lift (counted 1)
      _ <- MaybeT.from_option (None : Option Unit)
      later <- lift (counted 2)
      pure (first + later)
    }
    expect (Ref.get seen) |> to.equal []
    let result = await (MaybeT.run action)
    expect result |> to.equal None
    expect (Ref.get seen) |> to.equal [1]
  }
}
