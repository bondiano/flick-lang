module Mtl.CapabilityOrdersTest

import Mtl.Classes exposing (..)
import Mtl.ExceptT as ExceptT exposing (ExceptT)
import Mtl.Identity as Identity exposing (Identity)
import Mtl.MaybeT as MaybeT exposing (MaybeT)
import Mtl.ReaderT as ReaderT exposing (ReaderT)
import Mtl.StateT as StateT exposing (StateT)
import Mtl.WriterT as WriterT exposing (WriterT)
import Test exposing (expect, to)

reader_catch_probe :
  (MonadReader m Float, MonadError m String) => m (Float, (String, Float), (String, Float), Float)
let reader_catch_probe =
  failed : m (String, Float)
  let failed = do {
    environment <- ask
    throw_error (show environment)
  }
  do {
    before <- ask
    local_outside <-
      local
        (fun n -> n + 10)
        (catch_error
          (fun problem -> do {
            environment <- ask
            pure (problem, environment)
          })
          failed)
    catch_outside <-
      catch_error
        (fun problem -> do {
          environment <- ask
          pure (problem, environment)
        })
        (local (fun n -> n + 10) failed)
    after <- ask
    pure (before, local_outside, catch_outside, after)
  }

suite "capability handler ordering" {
  test "StateT catch restarts the handler at entry state" {
    action : StateT Float (ExceptT String Identity) Float
    let action =
      catch_error
        (fun _ -> get)
        (do {
          put 1
          throw_error "bad"
        })
    expect (Identity.run (ExceptT.run (StateT.run action 0))) |> to.equal (Ok (0, 0))
  }

  test "ExceptT catch observes state retained below the error" {
    action : ExceptT String (StateT Float Identity) Float
    let action =
      catch_error
        (fun _ -> get)
        (do {
          put 1
          throw_error "bad"
        })
    expect (Identity.run (StateT.run (ExceptT.run action) 0)) |> to.equal (Ok 1, 1)
  }

  test "WriterT catch has no failed output pair to retain" {
    action : WriterT (List String) (ExceptT String Identity) Float
    let action =
      catch_error
        (fun _ -> do {
          tell ["recovered"]
          pure 9
        })
        (do {
          tell ["before"]
          throw_error "bad"
        })
    expect (Identity.run (ExceptT.run (WriterT.run action))) |> to.equal (Ok (9, ["recovered"]))
  }

  test "ExceptT catch retains output emitted below the error" {
    action : ExceptT String (WriterT (List String) Identity) Float
    let action =
      catch_error
        (fun _ -> do {
          tell ["recovered"]
          pure 9
        })
        (do {
          tell ["before"]
          throw_error "bad"
        })
    expect (Identity.run (WriterT.run (ExceptT.run action)))
    |> to.equal (Ok 9, ["before", "recovered"])
  }

  test "ReaderT catch shares the environment and local placement controls the handler" {
    action :
      ReaderT
        Float
        (ExceptT String Identity)
        (
          Float,
          (String, Float),
          (String, Float),
          Float,
        )
    let action = reader_catch_probe
    expect (Identity.run (ExceptT.run (ReaderT.run action 5)))
    |> to.equal (Ok (5, ("15", 15), ("15", 5), 5))
  }

  test "ExceptT local changes the handler only when outside catch" {
    action :
      ExceptT
        String
        (ReaderT Float Identity)
        (
          Float,
          (String, Float),
          (String, Float),
          Float,
        )
    let action = reader_catch_probe
    expect (Identity.run (ReaderT.run (ExceptT.run action) 5))
    |> to.equal (Ok (5, ("15", 15), ("15", 5), 5))
  }

  test "MaybeT None is not an inherited error" {
    action : MaybeT (ExceptT String Identity) Float
    let action = catch_error (fun _ -> throw_error "handler invoked") (MaybeT.from_option None)
    expect (Identity.run (ExceptT.run (MaybeT.run action))) |> to.equal (Ok None)
  }

  test "a catch does not catch its handler's rethrow" {
    action : ExceptT String Identity Float
    let action = catch_error (fun problem -> throw_error "\{problem}:handler") (throw_error "bad")
    expect (Identity.run (ExceptT.run action)) |> to.equal (Err "bad:handler")
  }

  test "throw skips the continuation and retains only preceding state" {
    action : ExceptT String (StateT Float Identity) Float
    let action = do {
      put 1
      _ <- throw_error "bad"
      put 99
      pure 0
    }
    expect (Identity.run (StateT.run (ExceptT.run action) 0)) |> to.equal (Err "bad", 1)
  }
}

suite "failure preserves only observable output" {
  test "MaybeT failure and listen retain the underlying ordered output" {
    action : MaybeT (WriterT (List String) Identity) Float
    let action = do {
      tell ["a"]
      tell ["b"]
      _ <- MaybeT.from_option (None : Option Unit)
      tell ["unreachable"]
      pure 9
    }
    expect (Identity.run (WriterT.run (MaybeT.run action))) |> to.equal (None, ["a", "b"])
    expect (Identity.run (WriterT.run (MaybeT.run (listen action)))) |> to.equal (None, ["a", "b"])
  }

  test "MaybeT pass uses identity on None rather than dropping its output" {
    action : MaybeT (WriterT (List String) Identity) (Float, List String -> List String)
    let action = do {
      tell ["a"]
      tell ["b"]
      _ <- MaybeT.from_option (None : Option Unit)
      pure (9, List.reverse)
    }
    expect (Identity.run (WriterT.run (MaybeT.run (pass action)))) |> to.equal (None, ["a", "b"])
  }

  test "ExceptT failure and listen retain the underlying ordered output" {
    action : ExceptT String (WriterT (List String) Identity) Float
    let action = do {
      tell ["a"]
      tell ["b"]
      _ <- throw_error "bad"
      tell ["unreachable"]
      pure 9
    }
    expect (Identity.run (WriterT.run (ExceptT.run action))) |> to.equal (Err "bad", ["a", "b"])
    expect (Identity.run (WriterT.run (ExceptT.run (listen action))))
    |> to.equal (Err "bad", ["a", "b"])
  }

  test "ExceptT pass uses identity on Err rather than dropping its output" {
    action : ExceptT String (WriterT (List String) Identity) (Float, List String -> List String)
    let action = do {
      tell ["a"]
      tell ["b"]
      _ <- throw_error "bad"
      pure (9, List.reverse)
    }
    expect (Identity.run (WriterT.run (ExceptT.run (pass action))))
    |> to.equal (Err "bad", ["a", "b"])
  }

  test "WriterT outside a failed MaybeT has no output pair" {
    absent : MaybeT Identity Unit
    let absent = MaybeT.from_option None
    action : WriterT (List String) (MaybeT Identity) Float
    let action = do {
      tell ["before"]
      lift absent
      writer (9, ["unreachable"])
    }
    expect (Identity.run (MaybeT.run (WriterT.run action))) |> to.equal None
  }

  test "WriterT outside a failed ExceptT has no output pair" {
    failed : ExceptT String Identity Unit
    let failed = throw_error "bad"
    action : WriterT (List String) (ExceptT String Identity) Float
    let action = do {
      tell ["before"]
      lift failed
      writer (9, ["unreachable"])
    }
    expect (Identity.run (ExceptT.run (WriterT.run action))) |> to.equal (Err "bad")
  }
}

suite "repeated capability selection" {
  test "native outer State wins and typed lift reaches inner State" {
    inner_get : StateT Float Identity Float
    let inner_get = get
    inner_put : Float -> StateT Float Identity Unit
    let inner_put = put
    action : StateT Float (StateT Float Identity) (Float, Float, Float, Float)
    let action = do {
      outer_before <- get
      put (outer_before + 1)
      inner_before <- lift inner_get
      lift (inner_put (inner_before + 10))
      outer_after <- get
      inner_after <- lift inner_get
      pure (outer_before, outer_after, inner_before, inner_after)
    }
    expect (Identity.run (StateT.run (StateT.run action 3) 100))
    |> to.equal (((3, 4, 100, 110), 4), 110)
  }

  test "native outer Reader wins and typed lift reaches inner Reader" {
    inner_ask : ReaderT Float Identity Float
    let inner_ask = ask
    action : ReaderT Float (ReaderT Float Identity) (Float, Float, Float, Float)
    let action = do {
      outer <- ask
      inner <- lift inner_ask
      changed_outer <- local (fun n -> n + 10) ask
      unchanged_inner <- local (fun n -> n + 10) (lift inner_ask)
      pure (outer, inner, changed_outer, unchanged_inner)
    }
    expect (Identity.run (ReaderT.run (ReaderT.run action 5) 20)) |> to.equal (5, 20, 15, 20)
  }

  test "native outer Writer wins and typed lift reaches inner Writer" {
    inner_tell : WriterT (List String) Identity Unit
    let inner_tell = tell ["inner"]
    action : WriterT (List String) (WriterT (List String) Identity) Float
    let action = do {
      tell ["outer"]
      lift inner_tell
      pure 9
    }
    expect (Identity.run (WriterT.run (WriterT.run action))) |> to.equal ((9, ["outer"]), ["inner"])
  }

  test "native outer Error wins and typed lift bypasses its catch" {
    outer : ExceptT String (ExceptT String Identity) Float
    let outer = throw_error "outer"
    recovered : ExceptT String (ExceptT String Identity) Float
    let recovered = catch_error (fun _ -> pure 7) outer
    inner : ExceptT String Identity Float
    let inner = throw_error "inner"
    lifted : ExceptT String (ExceptT String Identity) Float
    let lifted = catch_error (fun _ -> pure 99) (lift inner)
    expect (Identity.run (ExceptT.run (ExceptT.run outer))) |> to.equal (Ok (Err "outer"))
    expect (Identity.run (ExceptT.run (ExceptT.run recovered))) |> to.equal (Ok (Ok 7))
    expect (Identity.run (ExceptT.run (ExceptT.run lifted))) |> to.equal (Err "inner")
  }
}
