module Mtl.WriterExceptTest

import Mtl.Classes exposing (lift)
import Mtl.ExceptT as ExceptT exposing (ExceptT)
import Mtl.Identity as Identity exposing (Identity)
import Mtl.StateT as StateT exposing (StateT(..))
import Mtl.WriterT as WriterT exposing (WriterT(..))
import Test exposing (expect, to)

make_writer : (a, List String) -> WriterT (List String) Identity a
let make_writer pair = WriterT (pure pair)

run_writer : WriterT (List String) Identity a -> (a, List String)
let run_writer action = Identity.run (WriterT.run action)

record : String -> Float -> StateT (List String) Identity Float
let record label n = StateT (fun seen -> pure (n, seen ++ [label]))

logged : String -> Float -> WriterT (List String) (StateT (List String) Identity) Float
let logged label n = WriterT (map (fun value -> (value, [label])) (record label n))

run_recorded_writer :
  WriterT (List String) (StateT (List String) Identity) a -> ((a, List String), List String)
let run_recorded_writer action = Identity.run (StateT.run (WriterT.run action) [])

run_recorded_except :
  ExceptT String (StateT (List String) Identity) a -> (Result String a, List String)
let run_recorded_except action = Identity.run (StateT.run (ExceptT.run action) [])

suite "WriterT and ExceptT ordering and failure" {
  test "WriterT combines left output before right output in map2 and bind" {
    let left = make_writer (4, ["a"])
    let right = make_writer (7, ["b"])
    expect (run_writer (map2 (fun a b -> a - b) left right)) |> to.equal (0 - 3, ["a", "b"])
    expect (run_writer (flat_map (fun a -> map (fun b -> a + b) right) left))
    |> to.equal (11, ["a", "b"])
    expect (run_writer (map (fun n -> n) left)) |> to.equal (4, ["a"])
  }

  test "WriterT map, map2 and bind execute each base action once without duplicating logs" {
    action : WriterT (List String) (StateT (List String) Identity) Float
    let action = do {
      a <- map (fun n -> n + 1) (logged "a" 1) and b <- logged "b" 2
      c <- logged "c" 3
      pure (a + b + c)
    }
    lifted : WriterT (List String) (StateT (List String) Identity) Float
    let lifted = lift (record "base" 9)
    expect (run_recorded_writer action) |> to.equal ((7, ["a", "b", "c"]), ["a", "b", "c"])
    expect (run_recorded_writer lifted) |> to.equal ((9, []), ["base"])
  }

  test "WriterT preserves inner failures instead of manufacturing a value-log pair" {
    failed : WriterT (List String) (Result String) Float
    let failed = lift (Err "offline")
    expect (WriterT.run failed) |> to.equal (Err "offline")
    expect (WriterT.run (map (fun n -> n + 1) failed)) |> to.equal (Err "offline")
    expect (WriterT.run (flat_map (fun n -> pure (n + 1)) failed)) |> to.equal (Err "offline")
    expect (WriterT.run (map2 (fun a b -> a + b) failed (pure 1))) |> to.equal (Err "offline")
  }

  test "ExceptT map2 skips the right action and bind skips its continuation on a left Err" {
    failed : ExceptT String (StateT (List String) Identity) Float
    let failed = ExceptT.from_result (Err "domain")
    prefix : ExceptT String (StateT (List String) Identity) Float
    let prefix = do {
      _ <- lift (record "left" 0)
      failed
    }
    right : ExceptT String (StateT (List String) Identity) Float
    let right = lift (record "right" 8)
    expect (run_recorded_except (map2 (fun a b -> a + b) prefix right))
    |> to.equal (Err "domain", ["left"])
    expect (run_recorded_except (flat_map (fun n -> lift (record "continuation" n)) prefix))
    |> to.equal (Err "domain", ["left"])
    expect (run_recorded_except (map2 (fun a b -> a + b) right prefix))
    |> to.equal (Err "domain", ["right", "left"])
  }

  test "ExceptT successful map2 and bind retain ordered once-only base transitions" {
    left : ExceptT String (StateT (List String) Identity) Float
    let left = lift (record "left" 4)
    right : ExceptT String (StateT (List String) Identity) Float
    let right = lift (record "right" 7)
    expect (run_recorded_except (map2 (fun a b -> a - b) left right))
    |> to.equal (Ok (0 - 3), ["left", "right"])
    expect
      (run_recorded_except
        (flat_map (fun n -> map (fun m -> n + m) (lift (record "continuation" 7))) left))
    |> to.equal (Ok 11, ["left", "continuation"])
  }

  test "ExceptT distinguishes an inner Err offline from the domain Ok Err domain" {
    offline : ExceptT String (Result String) Float
    let offline = lift (Err "offline")
    domain : ExceptT String (Result String) Float
    let domain = ExceptT.from_result (Err "domain")
    expect (ExceptT.run offline) |> to.equal (Err "offline")
    expect (ExceptT.run domain) |> to.equal (Ok (Err "domain"))
    expect (ExceptT.run (map (fun n -> n + 1) offline)) |> to.equal (Err "offline")
    expect (ExceptT.run (flat_map (fun n -> pure (n + 1)) offline)) |> to.equal (Err "offline")
    expect (ExceptT.run (map2 (fun a b -> a + b) offline (pure 1))) |> to.equal (Err "offline")
    expect (ExceptT.run (map2 (fun a b -> a + b) (pure 1) offline)) |> to.equal (Err "offline")
    expect (ExceptT.run (flat_map (fun n -> pure (n + 1)) domain)) |> to.equal (Ok (Err "domain"))
  }
}
