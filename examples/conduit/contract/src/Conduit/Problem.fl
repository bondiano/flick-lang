/// The errors of the Conduit API. Each is answered with its status and the
/// body RealWorld uses for all of them, the problems by field or resource:
/// `{"errors": {"email": ["is invalid"]}}`.
module Conduit.Problem exposing (..)

import HttpApi.Derive exposing (Problem)
import Codec exposing (plugin codec)

/// What is wrong, by field or resource, in order.
type alias Problems = List (String, List String)

/// 401: no token, or one that does not name a user.
type error Unauthorized = Unauthorized Problems
  deriving Eq, Show, Schema

/// 403: the resource belongs to someone else.
type error Forbidden = Forbidden Problems
  deriving Eq, Show, Schema

/// 404: no such user, article or comment.
type error NotFound = NotFound Problems
  deriving Eq, Show, Schema

/// 409: a username or email another user has.
type error Conflict = Conflict Problems
  deriving Eq, Show, Schema

/// 422: a field missing, blank or malformed.
type error Unprocessable = Unprocessable Problems
  deriving Eq, Show, Schema

/// The body of every error: its problems under `errors`.
type alias Body = { errors : Problems }
  deriving Schema

/// One problem: the field or resource, and what is wrong with it.
problem : String -> String -> Problems
let problem subject message = [(subject, [message])]

/// The codec of the body of every error.
body : PureCodec Json Body
let body = codec Body.schema {
  errors = field "errors" (Codec.entries (Codec.list String.json));
}

/// The body of a 401.
unauthorized : PureCodec Json Unauthorized
let unauthorized =
  Codec.transform_as
    Unauthorized.schema
    (fun b -> Unauthorized b.errors)
    (fun (Unauthorized p) -> { errors = p })
    body

/// The body of a 403.
forbidden : PureCodec Json Forbidden
let forbidden =
  Codec.transform_as
    Forbidden.schema
    (fun b -> Forbidden b.errors)
    (fun (Forbidden p) -> { errors = p })
    body

/// The body of a 404.
not_found : PureCodec Json NotFound
let not_found =
  Codec.transform_as
    NotFound.schema
    (fun b -> NotFound b.errors)
    (fun (NotFound p) -> { errors = p })
    body

/// The body of a 409.
conflict : PureCodec Json Conflict
let conflict =
  Codec.transform_as
    Conflict.schema
    (fun b -> Conflict b.errors)
    (fun (Conflict p) -> { errors = p })
    body

/// The body of a 422.
unprocessable : PureCodec Json Unprocessable
let unprocessable =
  Codec.transform_as
    Unprocessable.schema
    (fun b -> Unprocessable b.errors)
    (fun (Unprocessable p) -> { errors = p })
    body

instance Problem Unauthorized =
  let problem = { status = 401; body = unauthorized }

instance Problem Forbidden =
  let problem = { status = 403; body = forbidden }

instance Problem NotFound =
  let problem = { status = 404; body = not_found }

instance Problem Conflict =
  let problem = { status = 409; body = conflict }

instance Problem Unprocessable =
  let problem = { status = 422; body = unprocessable }
