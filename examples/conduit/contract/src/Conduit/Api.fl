/// The endpoints of the Conduit API, shared by the client, which calls them,
/// and the server, which serves them: three groups, each a record that
/// derives `HttpApi`. Each endpoint declares the errors its handler may
/// answer with; every request carries the optional `Authorization` header,
/// which the server's checks read for the `Authed` endpoints, and for the
/// `MaybeAuthed` ones when it is there. Each part is decoded by the codec
/// named after its type in `Conduit.Input`, each error is answered as its
/// `Problem` instance in `Conduit.Problem` says.
module Conduit.Api exposing (..)

import HttpApi.Derive exposing (..)
import Conduit.Model exposing (..)
import Conduit.Input exposing (
  ArticlePath,
  CommentPath,
  Credentials,
  ListQuery,
  LoginBody,
  NewArticleBody,
  NewCommentBody,
  NewUserBody,
  Page,
  ProfilePath,
  UpdateArticleBody,
  UpdateUserBody,
)
import Conduit.Problem exposing (Conflict, Forbidden, NotFound, Unauthorized, Unprocessable)

/// A request of the API: its path, query and body, and the credentials.
type alias Request p q b = HttpApi.Request p q Credentials b

/// Signing up and in, and the tags: no user needed.
type alias Public = {
  register : Post
    "/api/users"
    { headers : Credentials; payload : NewUserBody }
    (Created UserBody)
    {Conflict, Unprocessable};
  login : Post
    "/api/users/login"
    { headers : Credentials; payload : LoginBody }
    UserBody
    {Unauthorized, Unprocessable};
  tags : Get "/api/tags" { headers : Credentials } TagsBody {};
} deriving HttpApi

/// The signed-in user and the profiles.
type alias Users = {
  current_user : Authed (Get "/api/user" { headers : Credentials } UserBody {Unauthorized});
  update_user : Authed
    (Put
      "/api/user"
      { headers : Credentials; payload : UpdateUserBody }
      UserBody
      {Unauthorized, Conflict, Unprocessable});
  get_profile : MaybeAuthed
    (Get
      "/api/profiles/:username"
      { headers : Credentials; path : ProfilePath }
      ProfileBody
      {Unauthorized, NotFound});
  follow : Authed
    (Post
      "/api/profiles/:username/follow"
      { headers : Credentials; path : ProfilePath }
      ProfileBody
      {Unauthorized, NotFound});
  unfollow : Authed
    (Delete
      "/api/profiles/:username/follow"
      { headers : Credentials; path : ProfilePath }
      ProfileBody
      {Unauthorized, NotFound});
} deriving HttpApi

/// The articles, the feed, favorites and comments.
type alias Articles = {
  list_articles : MaybeAuthed
    (Get "/api/articles" { headers : Credentials; query : ListQuery } ArticlesBody {Unauthorized});
  feed : Authed
    (Get "/api/articles/feed" { headers : Credentials; query : Page } ArticlesBody {Unauthorized});
  get_article : MaybeAuthed
    (Get
      "/api/articles/:slug"
      { headers : Credentials; path : ArticlePath }
      ArticleBody
      {Unauthorized, NotFound});
  create_article : Authed
    (Post
      "/api/articles"
      { headers : Credentials; payload : NewArticleBody }
      (Created ArticleBody)
      {Unauthorized, Unprocessable});
  update_article : Authed
    (Put
      "/api/articles/:slug"
      { headers : Credentials; path : ArticlePath; payload : UpdateArticleBody }
      ArticleBody
      {Unauthorized, Forbidden, NotFound, Unprocessable});
  delete_article : Authed
    (Delete
      "/api/articles/:slug"
      { headers : Credentials; path : ArticlePath }
      Unit
      {Unauthorized, Forbidden, NotFound});
  favorite : Authed
    (Post
      "/api/articles/:slug/favorite"
      { headers : Credentials; path : ArticlePath }
      ArticleBody
      {Unauthorized, NotFound});
  unfavorite : Authed
    (Delete
      "/api/articles/:slug/favorite"
      { headers : Credentials; path : ArticlePath }
      ArticleBody
      {Unauthorized, NotFound});
  list_comments : MaybeAuthed
    (Get
      "/api/articles/:slug/comments"
      { headers : Credentials; path : ArticlePath }
      CommentsBody
      {Unauthorized, NotFound});
  add_comment : Authed
    (Post
      "/api/articles/:slug/comments"
      { headers : Credentials; path : ArticlePath; payload : NewCommentBody }
      (Created CommentBody)
      {Unauthorized, NotFound, Unprocessable});
  delete_comment : Authed
    (Delete
      "/api/articles/:slug/comments/:id"
      { headers : Credentials; path : CommentPath }
      Unit
      {Unauthorized, Forbidden, NotFound});
} deriving HttpApi
