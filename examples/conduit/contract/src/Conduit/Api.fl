/// The endpoints of the Conduit API, shared by the client, which calls them,
/// and the server, which serves them: three groups, each a record that
/// derives `HttpApi`. An endpoint's path is a constructor of
/// `Conduit.Route.ApiRoute` with the type of each parameter in place of its
/// value, so `Profiles Username (Some Follow)` is
/// `/profiles/:username/follow`, and a typo is a type error. Each endpoint
/// declares the errors its handler may answer with; every request carries
/// the optional `Authorization` header, which the server's checks read for
/// the `Authed` endpoints, and for the `MaybeAuthed` ones when it is there.
/// Each part is decoded by the codec named after its type in
/// `Conduit.Input`, each error is answered as its `Problem` instance in
/// `Conduit.Problem` says.
module Conduit.Api exposing (..)

import HttpApi.Derive exposing (..)
import Conduit.Model exposing (..)
import Conduit.Route exposing (..)
import Conduit.Input exposing (
  ArticlePath,
  CommentPath,
  Credentials,
  ListQuery,
  LoginBody,
  NewArticleBody,
  NewCommentBody,
  NewUserBody,
  Page,
  ProfilePath,
  UpdateArticleBody,
  UpdateUserBody,
)
import Conduit.Problem exposing (Conflict, Forbidden, NotFound, Unauthorized, Unprocessable)

/// A request of the API: its path, query and body, and the credentials.
type alias Request p q b = HttpApi.Request p q Credentials b

/// Signing up and in, and the tags: no user needed.
type alias Public = {
  register : Post
    (Users None)
    { headers : Credentials; payload : NewUserBody }
    (Created UserBody)
    {Conflict, Unprocessable};
  login : Post
    (Users (Some Login))
    { headers : Credentials; payload : LoginBody }
    UserBody
    {Unauthorized, Unprocessable};
  tags : Get Tags { headers : Credentials } TagsBody {};
} deriving HttpApi

/// The signed-in user and the profiles.
type alias Users = {
  current_user : Authed (Get User { headers : Credentials } UserBody {Unauthorized});
  update_user : Authed
    (Put
      User
      { headers : Credentials; payload : UpdateUserBody }
      UserBody
      {Unauthorized, Conflict, Unprocessable});
  get_profile : MaybeAuthed
    (Get
      (Profiles Username None)
      { headers : Credentials; path : ProfilePath }
      ProfileBody
      {Unauthorized, NotFound});
  follow : Authed
    (Post
      (Profiles Username (Some Follow))
      { headers : Credentials; path : ProfilePath }
      ProfileBody
      {Unauthorized, NotFound});
  unfollow : Authed
    (Delete
      (Profiles Username (Some Follow))
      { headers : Credentials; path : ProfilePath }
      ProfileBody
      {Unauthorized, NotFound});
} deriving HttpApi

/// The articles, the feed, favorites and comments.
type alias Articles = {
  list_articles : MaybeAuthed
    (Get (Articles None) { headers : Credentials; query : ListQuery } ArticlesBody {Unauthorized});
  feed : Authed
    (Get (Articles (Some Feed)) { headers : Credentials; query : Page } ArticlesBody {Unauthorized});
  get_article : MaybeAuthed
    (Get
      (Articles (Some (Index Slug None)))
      { headers : Credentials; path : ArticlePath }
      ArticleBody
      {Unauthorized, NotFound});
  create_article : Authed
    (Post
      (Articles None)
      { headers : Credentials; payload : NewArticleBody }
      (Created ArticleBody)
      {Unauthorized, Unprocessable});
  update_article : Authed
    (Put
      (Articles (Some (Index Slug None)))
      { headers : Credentials; path : ArticlePath; payload : UpdateArticleBody }
      ArticleBody
      {Unauthorized, Forbidden, NotFound, Unprocessable});
  delete_article : Authed
    (Delete
      (Articles (Some (Index Slug None)))
      { headers : Credentials; path : ArticlePath }
      Unit
      {Unauthorized, Forbidden, NotFound});
  favorite : Authed
    (Post
      (Articles (Some (Index Slug (Some Favorite))))
      { headers : Credentials; path : ArticlePath }
      ArticleBody
      {Unauthorized, NotFound});
  unfavorite : Authed
    (Delete
      (Articles (Some (Index Slug (Some Favorite))))
      { headers : Credentials; path : ArticlePath }
      ArticleBody
      {Unauthorized, NotFound});
  list_comments : MaybeAuthed
    (Get
      (Articles (Some (Index Slug (Some (Comments None)))))
      { headers : Credentials; path : ArticlePath }
      CommentsBody
      {Unauthorized, NotFound});
  add_comment : Authed
    (Post
      (Articles (Some (Index Slug (Some (Comments None)))))
      { headers : Credentials; path : ArticlePath; payload : NewCommentBody }
      (Created CommentBody)
      {Unauthorized, NotFound, Unprocessable});
  delete_comment : Authed
    (Delete
      (Articles (Some (Index Slug (Some (Comments (Some CommentId))))))
      { headers : Credentials; path : CommentPath }
      Unit
      {Unauthorized, Forbidden, NotFound});
} deriving HttpApi
