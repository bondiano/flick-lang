/// What the Conduit API answers with, as on the wire: field names are the
/// JSON keys, an absent `bio` or `image` is `null`, and dates are ISO 8601
/// texts. The server builds these from its own domain values; the client
/// shows them.
module Conduit.Model exposing (..)

/// The signed-in user, with the token that authenticates their requests.
type alias User = {
  email : String;
  token : String;
  username : String;
  bio : Option String;
  image : Option String;
} deriving Schema

/// A user as others see them; `following` is whether the reader follows them.
type alias Profile = {
  username : String;
  bio : Option String;
  image : Option String;
  following : Bool;
} deriving Schema

/// An article with its body; `favorited` is the reader's.
type alias Article = {
  slug : String;
  title : String;
  description : String;
  body : String;
  tagList : List String;
  createdAt : String;
  updatedAt : String;
  favorited : Bool;
  favoritesCount : Int;
  author : Profile;
} deriving Schema

/// An article in a list: everything but its body.
type alias ArticlePreview = {
  slug : String;
  title : String;
  description : String;
  tagList : List String;
  createdAt : String;
  updatedAt : String;
  favorited : Bool;
  favoritesCount : Int;
  author : Profile;
} deriving Schema

type alias Comment = {
  id : Int;
  createdAt : String;
  updatedAt : String;
  body : String;
  author : Profile;
} deriving Schema

type alias UserBody = { user : User }
  deriving Schema

type alias ProfileBody = { profile : Profile }
  deriving Schema

type alias ArticleBody = { article : Article }
  deriving Schema

/// A page of articles and how many match in all.
type alias ArticlesBody = { articles : List ArticlePreview; articlesCount : Int }
  deriving Schema

type alias CommentBody = { comment : Comment }
  deriving Schema

type alias CommentsBody = { comments : List Comment }
  deriving Schema

type alias TagsBody = { tags : List String }
  deriving Schema

/// The preview of an article: the list form, without the body.
preview : Article -> ArticlePreview
let preview a = {
  slug = a.slug;
  title = a.title;
  description = a.description;
  tagList = a.tagList;
  createdAt = a.createdAt;
  updatedAt = a.updatedAt;
  favorited = a.favorited;
  favoritesCount = a.favoritesCount;
  author = a.author;
}
