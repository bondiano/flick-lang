/// The wire forms of the contract: requests decode with every field
/// optional, so the server can answer a missing one with 422, an update
/// tells a missing field from an explicit `null`, and errors are written in
/// RealWorld's `{"errors": {…}}` body.
module Conduit.InputTest

import Conduit.Input as Input
import Conduit.Problem as Problem exposing (Unprocessable(..))
import Test exposing (expect, to)

/// `text` decoded by `wire`, or the error's text.
decode : PureCodec Json a -> String -> Result String a
let decode wire text =
  match Json.parse text with
  | Ok value ->
    match Codec.decode_result wire value with
    | Ok decoded -> Ok decoded
    | Err e -> Err (show e)
  | Err e -> Err (show e)

/// `value` written by `wire` as JSON text.
encode : PureCodec Json a -> a -> String
let encode wire value =
  match Codec.encode_result wire value with
  | Ok json -> Json.stringify json
  | Err e -> show e

bio : String -> Result String (Option (Option String))
let bio text = Result.map (fun b -> b.user.bio) (decode Input.update_user_body text)

/// The checks of the codecs of what clients send.
suite "inputs" {
  test "a registration with fields missing still decodes" {
    expect
      (Result.map
        (fun b -> b.user)
        (decode Input.new_user_body "{\"user\":{\"username\":\"ada\"}}"))
      |> to.equal (Ok { username = Some "ada"; email = None; password = None })
  }

  test "an update tells a missing bio from a null one" {
    expect (bio "{\"user\":{\"email\":\"a@b.c\"}}") |> to.equal (Ok None)
    expect (bio "{\"user\":{\"bio\":null}}") |> to.equal (Ok (Some None))
    expect (bio "{\"user\":{\"bio\":\"hi\"}}") |> to.equal (Ok (Some (Some "hi")))
  }

  test "the list query reads its numbers from texts" {
    expect (decode Input.list_query "{\"tag\":\"dragons\",\"limit\":\"5\"}")
      |> to.equal
        (Ok {
          tag = Some "dragons"
          author = None
          favorited = None
          limit = Some 5
          offset = None
        })
  }

  test "a request without the header is anonymous" {
    expect (decode Input.credentials "{}") |> to.equal (Ok { authorization = None })
  }

  test "an error is written as RealWorld's errors body" {
    expect (encode Problem.unprocessable (Unprocessable (Problem.problem "email" "can't be blank")))
      |> to.equal "{\"errors\":{\"email\":[\"can't be blank\"]}}"
  }
}
