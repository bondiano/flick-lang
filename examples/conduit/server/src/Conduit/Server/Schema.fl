/// The database of Conduit, as its migrations build it. Each table they
/// leave is a type of this module, its row, with the companion `table` the
/// typed queries read: `users` is `Users`, `article_tags` `ArticleTags`.
/// `migrations` is the list `Database.Migrate.run` applies, each statement
/// as written here. Dates are ISO 8601 texts in UTC that the server writes
/// from its clock, so they sort as they read and go out as they are stored.
module Conduit.Server.Schema exposing (..)

/// The first schema: people, what they write and how they follow and
/// favor each other.
sql migration 1 "conduit" {
  create table users (
    id bigint primary key generated always as identity,
    username text not null unique,
    email text not null unique,
    password_hash text not null,
    bio text,
    image text
  );
  create table follows (
    follower_id bigint not null references users on delete cascade,
    followed_id bigint not null references users on delete cascade,
    primary key (follower_id, followed_id)
  );
  create table articles (
    id bigint primary key generated always as identity,
    slug text not null unique,
    title text not null,
    description text not null,
    body text not null,
    author_id bigint not null references users on delete cascade,
    created_at text not null,
    updated_at text not null
  );
  create index articles_by_date on articles (created_at desc, id desc);
  create table tags (
    id bigint primary key generated always as identity,
    name text not null unique
  );
  create table article_tags (
    article_id bigint not null references articles on delete cascade,
    tag_id bigint not null references tags,
    position integer not null,
    primary key (article_id, tag_id)
  );
  create table favorites (
    user_id bigint not null references users on delete cascade,
    article_id bigint not null references articles on delete cascade,
    primary key (user_id, article_id)
  );
  create table comments (
    id bigint primary key generated always as identity,
    body text not null,
    article_id bigint not null references articles on delete cascade,
    author_id bigint not null references users on delete cascade,
    created_at text not null,
    updated_at text not null
  );
}
