/// The Conduit server: it brings the database up to date, then serves the
/// API under `/api` and, given a directory, the client's built files, the
/// client's own routes answered with its `index.html`. Its settings come
/// from the environment: `PORT` (8000), `DATABASE_URL`, `JWT_SECRET` and
/// `STATIC_DIR`.
module Conduit.Server.Main exposing (main)

import Database exposing (Database)
import Conduit.Server.App as Server
import Conduit.Server.Schema as Schema
import Conduit.Server.Session exposing (Keys)

type alias Settings = { port : Float; database : String; secret : String; files : Option String }

settings : Unit ->{; Config.ConfigError} Settings
let settings () = {
  port = Config.get (Config.with_default 8000 (Config.port "PORT"));
  database = Config.get (Config.string "DATABASE_URL");
  secret = Config.get (Config.non_empty_string "JWT_SECRET");
  files = Config.get (Config.option (Config.string "STATIC_DIR"));
}

serve :
  Settings ->{Database, Keys, Crypto.Crypto, Http.Platform.HttpPlatform, FileSystem.FileSystem; PlatformError.PlatformError, Http.ServerError.ServeError}
  Unit
let serve config =
  // without its schema the server cannot answer anything
  let applied = Effect.or_die (task { Database.Migrate.run Schema.migrations })
  Platform.stdout_line ("migrations applied: " ++ show applied)
  scope {
    let options : Http.Server.ServeOptions = {
      host = "0.0.0.0";
      port = config.port;
      gracefulShutdownTimeout = None;
    }
    let server = Http.Server.serve options (Server.router config.files)
    Platform.stdout_line
      ("Conduit listens on " ++ Http.Server.format_address (Http.Server.address server))
    Effect.never ()
  }

main : Unit ->{; AppError} Unit
let main () =
  let config =
    try settings () with
    | Config.ConfigError message -> App.fail ("configuration: " ++ message)
  let keys = Server.keys config.secret
  let platform = Layer.merge Http.Server.layer_services FileSystem.node
  let database = Database.pg (Database.config config.database)
  provide (Layer.merge database (Layer.merge keys (Layer.merge Crypto.system platform))) {
    try serve config with
    | Http.ServerError.ServeError e -> App.fail ("cannot serve: " ++ show e)
    | PlatformError.PlatformError e -> App.fail ("cannot read the client's files: " ++ show e)
  }
