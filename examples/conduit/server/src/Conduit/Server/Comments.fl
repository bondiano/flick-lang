/// The comments of articles, in the database, each with its author and
/// whether the reader, if anyone, follows them.
module Conduit.Server.Comments exposing (..)

import Sql exposing (Pg)
import Database exposing (Database)
import Conduit.Server.Db as Db
import Conduit.Server.Schema exposing (Comments, Follows, Users)

/// A comment with its author and whether the reader follows them.
type alias Row = {
  id : BigInt;
  body : String;
  created_at : String;
  updated_at : String;
  author_id : BigInt;
  username : String;
  bio : Option String;
  image : Option String;
  following : BigInt;
}

/// The comments `which` keeps, oldest first.
rows : Option BigInt -> Option BigInt -> Option BigInt -> Sql.Template Pg {} Row
let rows reader article id = sql {
  from c in Comments
  join u in Users on u.id == c.author_id
  left_join fol in Follows on fol.followed_id == u.id && fol.follower_id == $reader
  where (is_null $article || c.article_id == $article) && (is_null $id || c.id == $id)
  group_by c.id, c.body, c.created_at, c.updated_at, c.author_id, u.username, u.bio, u.image
  order_by c.created_at, c.id
  select {
    id = c.id;
    body = c.body;
    created_at = c.created_at;
    updated_at = c.updated_at;
    author_id = c.author_id;
    username = u.username;
    bio = u.bio;
    image = u.image;
    following = count fol.follower_id;
  }
}

/// The comments of an article, oldest first.
of_article : Option BigInt -> BigInt ->{Async, Database} List Row
let of_article reader article = Db.rows (rows reader (Some article) None)

/// The comment `id` of the article, as `reader` sees it.
find : Option BigInt -> BigInt -> BigInt ->{Async, Database} Option Row
let find reader article id = Db.first (rows reader (Some article) (Some id))

/// Stores a comment: its id.
insert : BigInt -> BigInt -> String -> String ->{Async, Database} BigInt
let insert article author body now =
  Db.insert_id
    (sql {
      insert_into Comments
      values {
        body = $body;
        article_id = $article;
        author_id = $author;
        created_at = $now;
        updated_at = $now;
      }
      returning { id = Comments.id }
    })

/// Deletes a comment.
delete : BigInt ->{Async, Database} Unit
let delete id =
  Db.run
    (sql {
      delete_from Comments
      where Comments.id == $id
    })
