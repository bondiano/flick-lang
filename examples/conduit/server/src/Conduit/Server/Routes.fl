/// The API the server serves: the contract's endpoints in three groups.
/// Signing up and in and the tags need no user; the other endpoints get a
/// `Session` from the request's token, which those that change something
/// require and those that only read take if it is there.
module Conduit.Server.Routes exposing (api, handlers)

import Conduit.Api as Api
import Conduit.Server.Accounts as Accounts
import Conduit.Server.Publishing as Publishing
import Conduit.Server.Session as Auth exposing (Session)

/// The scheme of the document: the token in `Authorization`.
token : HttpApi.Security
let token = HttpApi.api_key "Token" { key = "authorization"; location = HttpApi.InHeader }

let public =
  HttpApi.group (Record.label : Record.Label "public")
  |> HttpApi.add Api.register
  |> HttpApi.add Api.login
  |> HttpApi.add Api.tags

let users =
  HttpApi.authenticated
    Session
    (HttpApi.group (Record.label : Record.Label "users")
      |> HttpApi.add (HttpApi.with_auth token Session Auth.check Api.current_user)
      |> HttpApi.add (HttpApi.with_auth token Session Auth.check Api.update_user)
      |> HttpApi.add (HttpApi.with_optional_auth token Session Auth.maybe Api.get_profile)
      |> HttpApi.add (HttpApi.with_auth token Session Auth.check Api.follow)
      |> HttpApi.add (HttpApi.with_auth token Session Auth.check Api.unfollow))

let articles =
  HttpApi.authenticated
    Session
    (HttpApi.group (Record.label : Record.Label "articles")
      |> HttpApi.add (HttpApi.with_optional_auth token Session Auth.maybe Api.list_articles)
      |> HttpApi.add (HttpApi.with_auth token Session Auth.check Api.feed)
      |> HttpApi.add (HttpApi.with_optional_auth token Session Auth.maybe Api.get_article)
      |> HttpApi.add (HttpApi.with_auth token Session Auth.check Api.create_article)
      |> HttpApi.add (HttpApi.with_auth token Session Auth.check Api.update_article)
      |> HttpApi.add (HttpApi.with_auth token Session Auth.check Api.delete_article)
      |> HttpApi.add (HttpApi.with_auth token Session Auth.check Api.favorite)
      |> HttpApi.add (HttpApi.with_auth token Session Auth.check Api.unfavorite)
      |> HttpApi.add (HttpApi.with_optional_auth token Session Auth.maybe Api.list_comments)
      |> HttpApi.add (HttpApi.with_auth token Session Auth.check Api.add_comment)
      |> HttpApi.add (HttpApi.with_auth token Session Auth.check Api.delete_comment))

let api =
  HttpApi.api "Conduit"
  |> HttpApi.info {
    version = "1.0.0";
    description = "The RealWorld Conduit API, served by Flick on the go target";
    servers = [];
  }
  |> HttpApi.add_group public
  |> HttpApi.add_group users
  |> HttpApi.add_group articles

let handlers = {
  public = { register = Accounts.register; login = Accounts.login; tags = Publishing.tags };
  users = {
    current_user = Accounts.current_user;
    update_user = Accounts.update_user;
    get_profile = Accounts.get_profile;
    follow = Accounts.follow;
    unfollow = Accounts.unfollow;
  };
  articles = {
    list_articles = Publishing.list_articles;
    feed = Publishing.feed;
    get_article = Publishing.get_article;
    create_article = Publishing.create_article;
    update_article = Publishing.update_article;
    delete_article = Publishing.delete_article;
    favorite = Publishing.favorite;
    unfavorite = Publishing.unfavorite;
    list_comments = Publishing.list_comments;
    add_comment = Publishing.add_comment;
    delete_comment = Publishing.delete_comment;
  };
}
