/// The API the server serves: the contract's three groups, under `/api`.
/// Signing up and
/// in and the tags need no user; the other endpoints get a `Session` from
/// the request's token, which the contract's `Authed` endpoints require and
/// its `MaybeAuthed` ones take if it is there.
module Conduit.Server.Routes exposing (api, handlers)

import Conduit.Api as Api
import Conduit.Server.Accounts as Accounts
import Conduit.Server.Publishing as Publishing
import Conduit.Server.Session as Auth exposing (Session)

/// The scheme of the document: the token in `Authorization`.
token : HttpApi.Security
let token = HttpApi.api_key "Token" { key = "authorization"; location = HttpApi.InHeader }

let api =
  HttpApi.api "Conduit"
  |> HttpApi.info {
    version = "1.0.0";
    description = "The RealWorld Conduit API, served by Flick on the go target";
    servers = [];
  }
  |> HttpApi.add_group Api.Public.api
  |> HttpApi.add_group (Api.Users.api token Session Auth.check Auth.maybe)
  |> HttpApi.add_group (Api.Articles.api token Session Auth.check Auth.maybe)
  |> HttpApi.Mount.under "/api"

let handlers = {
  public = { register = Accounts.register; login = Accounts.login; tags = Publishing.tags };
  users = {
    current_user = Accounts.current_user;
    update_user = Accounts.update_user;
    get_profile = Accounts.get_profile;
    follow = Accounts.follow;
    unfollow = Accounts.unfollow;
  };
  articles = {
    list_articles = Publishing.list_articles;
    feed = Publishing.feed;
    get_article = Publishing.get_article;
    create_article = Publishing.create_article;
    update_article = Publishing.update_article;
    delete_article = Publishing.delete_article;
    favorite = Publishing.favorite;
    unfavorite = Publishing.unfavorite;
    list_comments = Publishing.list_comments;
    add_comment = Publishing.add_comment;
    delete_comment = Publishing.delete_comment;
  };
}
