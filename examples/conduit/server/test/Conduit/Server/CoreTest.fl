/// The pure core of the server: what a request must hold and the addresses
/// of articles, without a database.
module Conduit.Server.CoreTest

import Conduit.Server.Slug as Slug
import Conduit.Server.Validate as Validate
import Test exposing (expect, to)

/// The problems of a registration, or none.
problems :
  { username : Option String; email : Option String; password : Option String } ->
  List (String, List String)
let problems input =
  match Validate.registration input with
  | Ok _ -> []
  | Err found -> found

/// The `bio` an update with only `bio` sets.
bio_of : Option (Option String) -> Result (List (String, List String)) (Option (Option String))
let bio_of bio =
  Result.map
    (fun c -> c.bio)
    (Validate.change { email = None; username = None; password = None; bio = bio; image = None })

/// The checks of the pure core.
suite "core" {
  test "a registration names each field it misses or gets wrong" {
    expect (problems { username = Some "  "; email = Some "not-an-email"; password = None })
      |> to.equal [
        ("username", ["can't be blank"]),
        ("email", ["is invalid"]),
        ("password", ["can't be blank"]),
      ]
  }

  test "a password needs 8 characters and takes 64" {
    expect
      (problems {
        username = Some "ada"
        email = Some "ada@example.org"
        password = Some "short7c"
      })
    |> to.equal [("password", ["is too short (minimum is 8 characters)"])]
    expect
      (problems {
        username = Some "ada"
        email = Some "ada@example.org"
        password = Some (String.repeat 64 "a")
      })
    |> to.equal []
  }

  test "a blank bio clears it, a missing one keeps it" {
    expect (bio_of (Some (Some "  "))) |> to.equal (Ok (Some None))
    expect (bio_of None) |> to.equal (Ok None)
    expect (bio_of (Some (Some "hi"))) |> to.equal (Ok (Some (Some "hi")))
  }

  test "tags keep their order without blanks or repeats" {
    expect (Validate.tags [" dragons", "", "training", "dragons"])
      |> to.equal ["dragons", "training"]
  }

  test "a slug is the title's words" {
    expect (Slug.base "How to train your Dragon?!") |> to.equal "how-to-train-your-dragon"
    expect (Slug.base "!!!") |> to.equal "article"
  }
}
