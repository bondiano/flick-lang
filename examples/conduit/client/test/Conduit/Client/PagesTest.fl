/// The pure core of the client: the URL of each page, which the spec's
/// routes are, read back as the same page, and dates as people read them.
module Conduit.Client.PagesTest

import Conduit.Client.Route exposing (Page(..), Tab(..), home)
import Conduit.Client.View as View
import Test exposing (expect, to)

/// Each page and its URL in the RealWorld spec.
pages : List (Page, String)
let pages = [
  (home, "/"),
  (Home { feed = Some "following"; page = None }, "/?feed=following"),
  (Home { feed = None; page = Some 2 }, "/?page=2"),
  (Tag "dragons" { page = Some 3 }, "/tag/dragons?page=3"),
  (Login, "/login"),
  (Register, "/register"),
  (Editor None, "/editor"),
  (Editor (Some "how-to"), "/editor/how-to"),
  (Settings, "/settings"),
  (Profile "ada" None, "/profile/ada"),
  (Profile "ada" (Some Favorites), "/profile/ada/favorites"),
  (Article "how-to", "/article/how-to"),
]

/// The checks of the pages' URLs and of dates.
suite "pages" {
  test.each pages "maps {1} to its page and back" (page, url) {
    expect (Route.print Page.url page) |> to.equal url
    expect (Route.parse Page.url url) |> to.equal (Some page)
  }

  test "an unknown address is no page" {
    expect (Route.parse Page.url "/nowhere/at/all") |> to.equal None
  }

  test "dates read as people write them" {
    expect (View.date "2024-03-01T09:30:00.000Z") |> to.equal "March 1, 2024"
    expect (View.date "not a date") |> to.equal "not a date"
  }
}
