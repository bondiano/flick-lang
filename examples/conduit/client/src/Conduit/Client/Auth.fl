/// Signing in and up. Each form's fields are states bound to its inputs;
/// a submit sends them, keeps the token the server answers and goes home,
/// or lists the problems the server named for each field.
module Conduit.Client.Auth exposing (form_input, form_area, sign_in_page, sign_up_page, keep)

import Conduit.Api as Api
import Conduit.Model exposing (User)
import Conduit.Problem exposing (Conflict(..), Unauthorized(..), Unprocessable(..))
import Conduit.Client.Route as Route exposing (Page(..))
import Conduit.Client.Session as Session
import Conduit.Client.View as View

/// The fields of the sign-in and sign-up forms.
username : Atom.Writable String
let username = Atom.make ""

email : Atom.Writable String
let email = Atom.make ""

password : Atom.Writable String
let password = Atom.make ""

/// An input of a form, named `name` for the browser and the spec's tests.
form_input : String -> Ui.InputType -> String -> Atom.Writable String -> Ui
let form_input name input placeholder bind = ui {
  let attributes = {
    host with
    name = Some name;
    input_type = Some input;
    class_name = Some "form-control form-control-lg";
  }
  fieldset { class_name = "form-group" }
    with_host attributes (field { bind = bind; placeholder = placeholder; on_input = None })
}

/// A text area of a form, named `name`.
form_area : String -> String -> Atom.Writable String -> Ui
let form_area name placeholder bind = ui {
  let attributes = { host with name = Some name; class_name = Some "form-control form-control-lg" }
  fieldset { class_name = "form-group" }
    with_host attributes (field_area { bind = bind; placeholder = placeholder; on_input = None })
}

/// Keeps the token of `user`, clears the form and goes home.
keep : User ->{Atom.Write} Unit
let keep user =
  Atom.set Session.token (Some user.token)
  Atom.set password ""
  Atom.set View.form_problems []
  Atom.set Route.current Route.home

/// The problems of a failed sign-in or sign-up.
failed :
  (Unit ->{Async; HttpApi.ClientError, Conflict, Unauthorized, Unprocessable} User) ->{Async, Atom.Write}
  Unit
let failed send =
  let outcome =
    try Ok (send ()) with
    | Unauthorized found -> Err found
    | Unprocessable found -> Err found
    | Conflict found -> Err found
    | HttpApi.ClientError e -> Err (Session.unreachable (HttpApi.ClientError e))
  match outcome with
  | Ok user -> keep user
  | Err found -> Atom.set View.form_problems found

/// Signs in with the email and password written.
sign_in : Action.Action Unit
let sign_in =
  Action.exhaust (fun _ -> task {
    let user = { email = Some (Atom.current email); password = Some (Atom.current password) }
    failed (fun () ->
      (Session.call (Session.at None () { user = user }) Api.Public.endpoints.login).user
    )
  })

/// Signs up with the name, email and password written.
sign_up : Action.Action Unit
let sign_up =
  Action.exhaust (fun _ -> task {
    let user = {
      username = Some (Atom.current username);
      email = Some (Atom.current email);
      password = Some (Atom.current password);
    }
    failed (fun () ->
      (Session.call (Session.at None () { user = user }) Api.Public.endpoints.register).user
    )
  })

/// What a form page shows beside its fields.
type alias Layout = { heading : String; other : Ui; submit : Action.Action Unit; label : String }

/// The page of a form: its heading, the link to the other one, its
/// problems and its fields.
component form_page (props : { layout : Layout; fields : List Ui }) = ui {
  let page = props.layout
  let send =
    View.classed
      "btn btn-lg btn-primary pull-xs-right"
      (submit { disabled = false } (text page.label))
  div { class_name = "auth-page" }
    div { class_name = "container page" }
      (div
        { class_name = "row" }
        (div
          { class_name = "col-md-6 offset-md-3 col-xs-12" }
          (View.classed "text-xs-center" (heading_at H1 (text page.heading)))
          (View.classed "text-xs-center" (paragraph (page.other)))
          (render View.errors ())
          (form { on_submit = page.submit } (props.fields ++ [send]))))
}

/// The page of `/login`.
sign_in_page : Ui
let sign_in_page = ui {
  render form_page {
    layout = {
      heading = "Sign in";
      other = Route.to Register (text "Need an account?");
      submit = sign_in;
      label = "Sign in";
    };
    fields = [
      form_input "email" EmailInput "Email" email,
      form_input "password" PasswordInput "Password" password,
    ];
  }
}

/// The page of `/register`.
sign_up_page : Ui
let sign_up_page = ui {
  render form_page {
    layout = {
      heading = "Sign up";
      other = Route.to Login (text "Have an account?");
      submit = sign_up;
      label = "Sign up";
    };
    fields = [
      form_input "username" TextInput "Username" username,
      form_input "email" EmailInput "Email" email,
      form_input "password" PasswordInput "Password" password,
    ];
  }
}
