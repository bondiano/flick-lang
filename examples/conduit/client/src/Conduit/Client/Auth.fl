/// Signing in and up. Each form's fields are states bound to its inputs;
/// a submit sends them, keeps the token the server answers and goes home,
/// or lists the problems the server named for each field.
module Conduit.Client.Auth exposing (field, area, sign_in_page, sign_up_page, keep)

import Conduit.Api as Api
import Conduit.Model exposing (User)
import Conduit.Problem exposing (Conflict(..), Unauthorized(..), Unprocessable(..))
import Conduit.Client.Route as Route exposing (Page(..))
import Conduit.Client.Session as Session
import Conduit.Client.View as View

username : Atom.Writable String
let username = Atom.make ""

email : Atom.Writable String
let email = Atom.make ""

password : Atom.Writable String
let password = Atom.make ""

/// An input of a form, named `name` for the browser and the spec's tests.
field : String -> Ui.InputType -> String -> Atom.Writable String -> Ui
let field name input placeholder bind =
  let host = {
    Ui.host with
    name = Some name;
    input_type = Some input;
    class_name = Some "form-control form-control-lg";
  }
  Ui.fieldset { class_name = "form-group" } [
    Ui.with_host host (Ui.field { bind = bind; placeholder = placeholder; on_input = None }),
  ]

/// A text area of a form, named `name`.
area : String -> String -> Atom.Writable String -> Ui
let area name placeholder bind =
  let host = { Ui.host with name = Some name; class_name = Some "form-control form-control-lg" }
  Ui.fieldset { class_name = "form-group" } [
    Ui.with_host host (Ui.field_area { bind = bind; placeholder = placeholder; on_input = None }),
  ]

/// Keeps the token of `user`, clears the form and goes home.
keep : User ->{Atom.Write;} Unit
let keep user =
  Atom.set Session.token (Some user.token)
  Atom.set password ""
  Atom.set View.form_problems []
  Atom.set Route.current Route.home

/// The problems of a failed sign-in or sign-up.
failed :
  (Unit ->{; HttpApi.ClientError, Conflict, Unauthorized, Unprocessable} User) ->{Atom.Write;} Unit
let failed send =
  let outcome =
    try Ok (send ()) with
    | Unauthorized found -> Err found
    | Unprocessable found -> Err found
    | Conflict found -> Err found
    | HttpApi.ClientError e -> Err (Session.unreachable (HttpApi.ClientError e))
  match outcome with
  | Ok user -> keep user
  | Err found -> Atom.set View.form_problems found

sign_in : Action.Action Unit
let sign_in =
  Action.exhaust (fun _ -> task {
    let user = { email = Some (Atom.current email); password = Some (Atom.current password) }
    failed (fun () ->
      (Session.call (Session.at None () { user = user }) Api.Public.endpoints.login).user
    )
  })

sign_up : Action.Action Unit
let sign_up =
  Action.exhaust (fun _ -> task {
    let user = {
      username = Some (Atom.current username);
      email = Some (Atom.current email);
      password = Some (Atom.current password);
    }
    failed (fun () ->
      (Session.call (Session.at None () { user = user }) Api.Public.endpoints.register).user
    )
  })

/// The page of a form: its heading, the link to the other one, its
/// problems and its fields.
layout : String -> Ui -> Action.Action Unit -> String -> List Ui -> Ui
let layout heading other submit label fields =
  Ui.div { class_name = "auth-page" } [
    Ui.div { class_name = "container page" } [
      Ui.div { class_name = "row" } [
        Ui.div { class_name = "col-md-6 offset-md-3 col-xs-12" } [
          View.classed "text-xs-center" (Ui.heading_at Ui.H1 [Ui.text heading]),
          View.classed "text-xs-center" (Ui.paragraph [other]),
          Ui.render View.errors (),
          Ui.form
            { on_submit = submit }
            (fields
              ++ [
                View.classed
                  "btn btn-lg btn-primary pull-xs-right"
                  (Ui.submit { disabled = false } [Ui.text label]),
              ]),
        ],
      ],
    ],
  ]

sign_in_page : Ui
let sign_in_page =
  layout "Sign in" (Route.to Register [Ui.text "Need an account?"]) sign_in "Sign in" [
    field "email" Ui.EmailInput "Email" email,
    field "password" Ui.PasswordInput "Password" password,
  ]

sign_up_page : Ui
let sign_up_page =
  layout "Sign up" (Route.to Login [Ui.text "Have an account?"]) sign_up "Sign up" [
    field "username" Ui.TextInput "Username" username,
    field "email" Ui.EmailInput "Email" email,
    field "password" Ui.PasswordInput "Password" password,
  ]
