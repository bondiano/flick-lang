/// The pieces every page shares: the navbar and the footer, avatars,
/// article previews with their favorite button, tags, the list of a
/// form's problems and the pagination of a feed. Their classes are those
/// of the RealWorld theme, which the spec's tests find them by.
module Conduit.Client.View exposing (..)

import Conduit.Api as Api
import Conduit.Input exposing (ArticlePath, Credentials)
import Conduit.Model exposing (ArticleBody, ArticlePreview, Profile, User)
import Conduit.Problem exposing (NotFound(..), Problems, Unauthorized(..))
import Conduit.Route as Paths
import Conduit.Client.Route as Route exposing (Page(..))
import Conduit.Client.Session as Session

/// `node` with the classes `classes`.
classed : String -> Ui -> Ui
let classed classes node = Ui.with_host { Ui.host with class_name = Some classes } node

/// A link to `target` with the classes `classes`.
link : String -> Page -> List Ui -> Ui
let link classes target children = classed classes (Route.to target children)

/// The image at `url`, or the default avatar when there is none or it is
/// no safe URL.
avatar : String -> Option String -> Ui
let avatar classes url =
  let fallback = Ui.safe_url "/default-avatar.svg"
  let src =
    match Option.bind Ui.safe_url (Option.filter (fun u -> String.trim u != "") url) with
    | Some safe -> Some safe
    | None -> fallback
  match src with
  | Some safe -> Ui.image { src = safe; alt = ""; class_name = classes }
  | None -> Ui.empty

/// The months of a date, by their number.
months : List String
let months = [
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
  "August",
  "September",
  "October",
  "November",
  "December",
]

/// An ISO 8601 date as people read it: `2024-03-01T…` is `March 1, 2024`.
date : String -> String
let date iso =
  match String.split "-" (String.take_left 10 iso) with
  | [year, month, day] ->
    let name = Option.bind (fun m -> List.get (m - 1) months) (Int.parse month)
    let number = Option.map Int.to_string (Int.parse day)
    match (name, number) with
    | (Some m, Some d) -> m ++ " " ++ d ++ ", " ++ year
    | _ -> iso
  | _ -> iso

/// The navbar: the brand, and the links of a visitor or of `user`.
navbar : Option User -> Ui
let navbar user =
  let links =
    match user with
    | None -> [
      Ui.item [link "nav-link" Route.home [Ui.text "Home"]],
      Ui.item [link "nav-link" Login [Ui.text "Sign in"]],
      Ui.item [link "nav-link" Register [Ui.text "Sign up"]],
    ]
    | Some me -> [
      Ui.item [link "nav-link" Route.home [Ui.text "Home"]],
      Ui.item [
        link "nav-link" (Editor None) [
          Ui.icon { class_name = "ion-compose" },
          Ui.text " New Article",
        ],
      ],
      Ui.item [
        link "nav-link" Settings [Ui.icon { class_name = "ion-gear-a" }, Ui.text " Settings"],
      ],
      Ui.item [
        link "nav-link" (Profile me.username None) [
          avatar "user-pic" me.image,
          Ui.text (" " ++ me.username),
        ],
      ],
    ]
  Ui.nav { class_name = "navbar navbar-light" } [
    Ui.div { class_name = "container" } [
      link "navbar-brand" Route.home [Ui.text "conduit"],
      classed "nav navbar-nav pull-xs-right" (Ui.list (List.map (classed "nav-item") links)),
    ],
  ]

/// The footer of every page.
footer : Ui
let footer =
  Ui.footer { class_name = "" } [
    Ui.div { class_name = "container" } [
      link "logo-font" Route.home [Ui.text "conduit"],
      Ui.span { class_name = "attribution" } [
        Ui.text " An interactive learning project from Thinkster, written in Flick.",
      ],
    ],
  ]

/// Each problem of a form as `field message`, in `ul.error-messages`.
problems : Problems -> Ui
let problems found =
  let lines =
    List.flat_map
      (fun (field, messages) -> List.map (fun m -> String.trim (field ++ " " ++ m)) messages)
      found
  if lines == [] then
    Ui.empty
  else
    classed "error-messages" (Ui.list (List.map (fun l -> Ui.item [Ui.text l]) lines))

/// What the last submit of a form went wrong with; leaving a page clears it.
form_problems : Atom.Writable Problems
let form_problems = Atom.make []

/// The problems of the last submit of a form.
component errors () = ui { problems (Atom.value form_problems) }

/// The tags of an article, in the order written.
tag_list : List String -> Ui
let tag_list tags =
  classed
    "tag-list"
    (Ui.list
      (List.map (fun t -> classed "tag-default tag-pill tag-outline" (Ui.item [Ui.text t])) tags))

/// The author and the date of an article.
meta : Profile -> String -> List Ui -> Ui
let meta author created more =
  Ui.div
    { class_name = "article-meta" }
    ([
      link "" (Profile author.username None) [avatar "" author.image],
      Ui.div { class_name = "info" } [
        link "author" (Profile author.username None) [Ui.text author.username],
        Ui.span { class_name = "date" } [Ui.text (date created)],
      ],
    ]
      ++ more)

/// Takes the favorite back when `favorited`, else favors the article.
toggle :
  Bool ->
  HttpApi.Request ArticlePath Unit Credentials Unit ->{; HttpApi.ClientError, Unauthorized, NotFound}
  ArticleBody
let toggle favorited request =
  if favorited then
    Session.call request Api.Articles.endpoints.unfavorite
  else
    Session.call request Api.Articles.endpoints.favorite

/// Favors the article, or takes the favorite back; a visitor signs up first.
favorite : Action.Action (ArticlePreview, Ui.ClickSnapshot)
let favorite =
  Action.exhaust (fun (article, _) -> task {
    let jwt = Atom.current Session.token
    match (jwt, Paths.Slug.parse article.slug) with
    | (Some _, Ok slug) ->
      let request = Session.at jwt { slug = slug } ()
      try ignore (Atom.mutation ["articles"] (toggle article.favorited) request) with
      | Unauthorized _ -> Atom.set Route.current Login
      | NotFound _ -> ()
      | HttpApi.ClientError _ -> ()
    | _ -> Atom.set Route.current Register
  })

/// The favorite button of an article: outlined until the reader favors it.
/// `place` is its classes of layout, as a host's classes replace them all.
favorite_button : String -> String -> ArticlePreview -> Ui
let favorite_button place label article =
  let style =
    if article.favorited then "btn btn-sm btn-primary" else "btn btn-sm btn-outline-primary"
  classed
    (style ++ " " ++ place)
    (Ui.button { disabled = false; on_click = Action.with favorite article } [
      Ui.icon { class_name = "ion-heart" },
      Ui.text (" " ++ label ++ show article.favoritesCount),
    ])

/// An article in a feed: its meta, title, description and tags.
preview : ArticlePreview -> Ui
let preview article =
  Ui.keyed
    article.slug
    (Ui.div { class_name = "article-preview" } [
      meta article.author article.createdAt [favorite_button "pull-xs-right" "" article],
      link "preview-link" (Article article.slug) [
        Ui.heading_at Ui.H1 [Ui.text article.title],
        Ui.paragraph [Ui.text article.description],
        Ui.span { class_name = "" } [Ui.text "Read more..."],
        tag_list article.tagList,
      ],
    ])

/// The link to page `n` of a list, `active` when it is the one shown.
page_link : Int -> (Int -> Page) -> Int -> Ui
let page_link current page_of n =
  let style = if n == current then "page-item active" else "page-item"
  classed style (Ui.item [link "page-link" (page_of n) [Ui.text (Int.to_string n)]])

/// The page links of a list of `count` articles, ten a page.
pagination : Int -> Int -> (Int -> Page) -> Ui
let pagination count current page_of =
  let pages = (count + 9) / 10
  if pages <= 1 then
    Ui.empty
  else
    let links = List.map (page_link current page_of) (List.range 1 (pages + 1))
    Ui.nav { class_name = "" } [classed "pagination" (Ui.list links)]

/// The articles of a feed, or what it says when it has none.
articles : List ArticlePreview -> Ui
let articles found =
  if found == [] then
    Ui.div { class_name = "article-preview empty-feed-message" } [
      Ui.text "No articles are here... yet.",
    ]
  else
    Ui.fragment (List.map preview found)

/// The articles of the reader's feed, or where to find some.
followed : List ArticlePreview -> Ui
let followed found =
  if found == [] then
    Ui.div { class_name = "article-preview empty-feed-message" } [
      Ui.text "Your feed is empty. Follow some authors, or see the ",
      Route.to Route.home [Ui.text "Global Feed"],
      Ui.text ".",
    ]
  else
    Ui.fragment (List.map preview found)
