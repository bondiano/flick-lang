module App.NotesTest exposing (tests)

import App.Notes as Notes

tests : List Test.Test
let tests = [
  Test.test "parse skips blank lines and trims" (fun () ->
    Test.equal ["milk", "mom"] (Notes.parse "  milk \n\nmom\n")
  ),
  Test.test "render writes a line per note, parse reads it back" (fun () ->
    Test.equal ["milk", "mom"] (Notes.parse (Notes.render ["milk", "mom"]))
  ),
  Test.test "remove counts from 1" (fun () ->
    Test.equal (Some ["milk", "tea"]) (Notes.remove 2 ["milk", "mom", "tea"])
  ),
  Test.test "remove of a number outside the list is None" (fun () ->
    Test.all [Test.equal None (Notes.remove 0 ["milk"]), Test.equal None (Notes.remove 2 ["milk"])]
  ),
  Test.test "listing numbers the notes" (fun () ->
    Test.equal ["1. milk", "2. mom"] (Notes.listing ["milk", "mom"])
  ),
]
