package flick:backend@0.1.0;

/// Compiler-owned data. This package has no checker, filesystem, clock,
/// network or process imports. IR bytes carry their own version as well.
interface types {
    use flick:command/types@0.1.0.{parameter, value-kind};
    enum profile { debug, release }
    enum mode { per-module, whole-program }
    /// Core CLI verbs that may accept backend-declared options.
    enum verb { build, run, dev, test, inspect }
    record environment { backend: string, platform: string }
    record abi { name: string, version: string }
    record version-range { minimum: string, maximum-exclusive: string }
    record named-range { name: string, versions: version-range }
    record backend-id { id: string, version: string }
    /// SHA-256 of the exact component bytes, supplied by the host.
    record backend-pin { identity: backend-id, sha256: string }
    record capability { name: string, version: string }
    /// A configurable axis of environment tags declared by a backend
    /// (for example `runtime`: `rt` / `effect`, or `dialect`: `luau` / `luajit`).
    record tag-axis {
        name: string,
        tags: list<string>,
        default: option<string>,
        exclusive: bool,
    }
    /// An option a backend declares for core verbs and `[target.<name>]`.
    record option-descriptor {
        parameter: parameter,
        default: option<string>,
        implicit-value: option<string>,
        choices: list<string>,
        verbs: list<verb>,
    }
    record option-value { key: string, value: string }
    /// Gated services handled at the root of an environment.
    record environment-services {
        environment: environment,
        services: list<string>,
    }
    /// Expected shape of one positional argument to a backend-declared foreign
    /// adapter word.
    variant adapter-arg-kind {
        /// One of a closed set of lowercase keyword choices.
        keyword(list<string>),
        /// A zero-based parameter index validated against the foreign binding's arity.
        param-index,
        /// A non-negative integer literal.
        uint,
        /// A string literal.
        text,
        /// Any identifier word.
        word,
    }
    /// One positional argument slot of a backend-declared foreign adapter word.
    record adapter-arg {
        name: string,
        kind: adapter-arg-kind,
    }
    /// A foreign metadata adapter word declared by a backend.
    record adapter-word {
        name: string,
        args: list<adapter-arg>,
        repeatable: bool,
        doc: string,
    }
    /// A foreign type-form attribute declared by a backend (such as `@ts` or `@go`).
    record type-form-attribute {
        name: string,
        doc: string,
    }
    record descriptor {
        identity: backend-id,
        backend-api: version-range,
        ir: version-range,
        language: version-range,
        runtime-abis: list<named-range>,
        environments: list<environment>,
        tags: list<string>,
        axes: list<tag-axis>,
        profiles: list<profile>,
        modes: list<mode>,
        capabilities: list<capability>,
        options: list<option-descriptor>,
        /// Host tool ids executed by `Launch.runtime` without `[tools]`.
        launch-runtimes: list<string>,
        /// Host tool ids used in steps or `doctor` inspection.
        host-tools: list<string>,
        /// Compiler frontend projection schemas this backend consumes.
        projections: list<abi>,
        /// Option key/value that selects class-derived effect stages, if any.
        stages-by-class-option: option<option-value>,
        /// Companion file extension for local foreign bindings when rewritten
        /// from the source specifier.
        foreign-extension: option<string>,
        /// Foreign source file suffixes tracked as build cache inputs.
        foreign-suffixes: list<string>,
        /// Gated services handled at the root of each environment.
        handled-services: list<environment-services>,
        /// Backend-owned foreign adapter words accepted in `foreign` metadata blocks.
        foreign-adapters: list<adapter-word>,
        /// Backend-owned type-form attributes accepted on `type` and `service` declarations.
        type-form-attributes: list<type-form-attribute>,
    }
    /// Available before IR generation; the host checks descriptor ranges
    /// first, then asks the backend for target-specific refusals.
    record target-request {
        backend-api: string,
        ir-version: string,
        language-version: string,
        runtime-abis: list<abi>,
        environment: environment,
        tags: list<string>,
        host-package: option<string>,
        profile: profile,
        mode: mode,
        required-capabilities: list<capability>,
        options: list<option-value>,
    }
    record target-support { capabilities: list<capability> }
    record span { file: u32, start: u32, end: u32 }
    enum severity { error, warning, note }
    record diagnostic {
        code: string,
        severity: severity,
        message: string,
        span: option<span>,
        notes: list<string>,
    }
    enum input-kind { source, foreign, %interface, target-facts, %resource, lockfile }
    /// An opaque id, never a host path. Every accessible byte is declared
    /// here and participates in the request's cache key.
    record input {
        id: string,
        kind: input-kind,
        sha256: string,
        size: u64,
    }
    record source {
        /// Same index and logical name as Program.files; UTF-8 bytes.
        name: string,
        input: string,
        line-starts: list<u32>,
    }
    enum module-role { %own, builtin, external }
    record module-input {
        name: string,
        role: module-role,
        %package: option<string>,
        /// A fixed relative target path, also in per-module mode.
        output: string,
        %interface: option<string>,
    }
    record symbol { module: string, name: string }
    record entry { name: string, symbol: symbol, runner: option<string> }
    record foreign-binding {
        module: string,
        specifier: string,
        resolved: string,
        abi: abi,
        inputs: list<string>,
    }
    /// Inline host code carried by a module: either a `foreign module inline`
    /// preamble (`name` is `none`) or a `from inline` binding (`name` is the
    /// lowered Flick binding name), with the span of its source string literal.
    record inline-foreign {
        module: string,
        name: option<string>,
        code: string,
        span: span,
    }
    /// A projection has a declared schema and version, and plain data in a
    /// content-addressed input. Unknown schemas must be refused, not guessed.
    /// Complete typing/effect facts and UI metadata are not implied by IR.
    record projection { module: string, schema: abi, input: string }
    /// Schema flick.typescript@0.1.0, produced by the shared projection.
    /// The JS backend consumes these strings without calling the checker.
    record typescript-projection {
        declarations: list<string>,
        annotations: list<option-value>,
        imports: string,
        modules: list<string>,
    }
    /// One physical ESM file of a logical module, including lexical prefixes.
    record typescript-file {
        module: string,
        output: string,
        projection: typescript-projection,
    }
    /// Schema flick.typescript@0.2.0: all physical files of one logical module.
    record typescript-module-projection { files: list<typescript-file> }
    /// Shared frontend entry classification; a component never typechecks main.
    /// `host` lists the `Host` services main's row names, `Host.Console`: the
    /// launcher of an entry without a runner provides only those as its root.
    record javascript-entry { name: string, module: string, pure: bool, host: list<string> }
    /// Source-map paths indexed by Program.files, for one physical output file.
    record javascript-file { module: string, output: string, source-paths: list<string> }
    /// Schema flick.javascript@0.1.0; visibility, entry rules and source paths.
    record javascript-projection {
        /// Historical builtin-name classification, including own replacements.
        /// Suppresses barrel exports independently of role and output path.
        builtin: bool,
        exports: list<string>,
        entries: list<javascript-entry>,
        files: list<javascript-file>,
    }
    /// Schema flick.go@0.1.0, one per own module: the values importers see,
    /// for release optimization, and the path `//line` directives give its
    /// source, relative to the directory of a Go module of the build.
    record go-projection { exports: list<string>, line-path: string }
    record package-target { %package: string, environments: list<environment> }
    record root-handler { environment: environment, service: symbol, handler: symbol }
    record build-request {
        target: target-request,
        backend: backend-pin,
        program: list<u8>,
        /// Required in per-module mode; graph and external ABI stay explicit.
        module-root: option<string>,
        modules: list<module-input>,
        sources: list<source>,
        entries: list<entry>,
        test-roots: list<symbol>,
        foreign: list<foreign-binding>,
        inline-foreign: list<inline-foreign>,
        projections: list<projection>,
        package-targets: list<package-target>,
        root-handlers: list<root-handler>,
        inputs: list<input>,
        toolchains: list<toolchain>,
        runtime-dependencies: list<runtime-dependency>,
        /// Direct ecosystem package names declared for this target by the
        /// project manifest and `[target.<name>.dependencies]` closure;
        /// `none` outside a project.
        declared-dependencies: option<list<string>>,
    }
    enum artifact-kind { source, source-map, declaration, object, executable, %resource, metadata }
    record artifact {
        id: string,
        path: string,
        kind: artifact-kind,
        bytes: list<u8>,
    }
    /// Exact host-approved toolchain; guests cannot select a process path.
    record toolchain { id: string, version: string, sha256: string }
    /// All ids of artifacts, inputs, steps and step outputs are disjoint.
    variant input-ref { source(string), artifact(string) }
    record step-output { id: string, path: string, kind: artifact-kind }
    record toolchain-step {
        id: string,
        dependencies: list<string>,
        toolchain: toolchain,
        arguments: list<string>,
        environment: list<option-value>,
        inputs: list<input-ref>,
        outputs: list<step-output>,
    }
    record runtime-dependency { %package: string, version: string, sha256: string }
    /// A file a backend asked for, by the path it asked with, and the
    /// canonical absolute path it is at, which tells shared instances apart.
    record project-file { path: string, real: string, bytes: list<u8> }
    /// The directory of a package that ships Flick modules, relative to the
    /// project's root.
    record package-root { %package: string, version: string, root: string }
    /// One package of a runtime graph: the directory whose files the host
    /// hashes, and its dependencies, by name and index in the graph.
    record runtime-node {
        name: string,
        version: string,
        dir: string,
        dependencies: list<tuple<string, u32>>,
    }
    /// A runtime package the backend's output loads and the packages it
    /// loads in turn, the first node its root; the host pins its contents.
    /// `skip` names the directories within a package that are not its
    /// contents, as those that hold other packages.
    record runtime-graph { %package: string, nodes: list<runtime-node>, skip: list<string> }
    /// What a backend's packages give the project: the source directories of
    /// those that ship Flick modules, the runtime graphs of its output, the
    /// files that invalidate its build cache, and what is wrong with them.
    /// With `needs`, the host reads those paths too, absolute or relative to
    /// the root, and asks again. A diagnostic about one of the `dependencies`
    /// asked of the call has that one's index as its span's file, which the
    /// host points at where it is declared.
    record packages {
        /// The project's own name in the backend's ecosystem.
        name: option<string>,
        /// The project's own version in the backend's ecosystem.
        version: option<string>,
        /// Direct package names declared by the project's ecosystem manifest.
        declared: list<string>,
        sources: list<package-root>,
        runtime: list<runtime-graph>,
        /// Files that affect build caches and `--inputs`, relative or absolute.
        inputs: list<string>,
        diagnostics: list<diagnostic>,
        needs: list<string>,
    }
    enum launch-kind { run, test }
    record launch {
        name: string,
        kind: launch-kind,
        artifact: string,
        /// None executes a generated executable; Some uses a pinned VM.
        runtime: option<toolchain>,
        /// Arguments passed to `runtime` before the launch artifact; must be empty when `runtime` is none.
        runtime-arguments: list<string>,
        arguments: list<string>,
        /// Environment variables set on the launched process (validated by host launch policy).
        environment: list<option-value>,
    }
    record build-result {
        artifacts: list<artifact>,
        steps: list<toolchain-step>,
        runtime-dependencies: list<runtime-dependency>,
        launches: list<launch>,
        diagnostics: list<diagnostic>,
    }
    enum input-error { undeclared, unavailable, digest-mismatch }
}

interface inputs {
    use types.{input-error};
    /// Only an id in this request's manifest may be read.
    read: func(id: string) -> result<list<u8>, input-error>;
}

world backend {
    import inputs;
    use types.{descriptor, target-request, target-support, build-request, build-result, diagnostic, project-file, packages, option-value};
    use flick:command/types@0.1.0.{dependency};
    export describe: func() -> descriptor;
    export check-target: func(request: build-request) -> result<target-support, list<diagnostic>>;
    export generate: func(request: build-request) -> result<build-result, list<diagnostic>>;
    /// The files of a project the backend reads to report its packages, as
    /// paths relative to the root; `*` stands for any one name in a path.
    export package-files: func() -> list<string>;
    /// The backend's packages, read from the files `package-files` names
    /// that the project has and those its last answer needed; `options` are
    /// those of the build, as its runtime.
    export packages: func(files: list<project-file>, dependencies: list<dependency>, options: list<option-value>) -> packages;
    export flick:command/command@0.1.0;
}
