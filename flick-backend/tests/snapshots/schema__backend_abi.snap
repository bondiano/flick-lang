---
source: flick-backend/tests/schema.rs
expression: printer.output.to_string()
---
package flick:backend@0.1.0;

interface types {
  use flick:command/types@0.1.0.{parameter, value-kind};

  enum profile {
    debug,
    release,
  }

  enum mode {
    per-module,
    whole-program,
  }

  enum verb {
    build,
    run,
    dev,
    test,
    inspect,
  }

  record environment {
    backend: string,
    platform: string,
  }

  record abi {
    name: string,
    version: string,
  }

  record version-range {
    minimum: string,
    maximum-exclusive: string,
  }

  record named-range {
    name: string,
    versions: version-range,
  }

  record backend-id {
    id: string,
    version: string,
  }

  record backend-pin {
    identity: backend-id,
    sha256: string,
  }

  record capability {
    name: string,
    version: string,
  }

  record tag-axis {
    name: string,
    tags: list<string>,
    default: option<string>,
    exclusive: bool,
  }

  record option-descriptor {
    parameter: parameter,
    default: option<string>,
    implicit-value: option<string>,
    choices: list<string>,
    verbs: list<verb>,
  }

  record option-value {
    key: string,
    value: string,
  }

  record environment-services {
    environment: environment,
    services: list<string>,
  }

  variant adapter-arg-kind {
    keyword(list<string>),
    param-index,
    uint,
    text,
    word,
  }

  record adapter-arg {
    name: string,
    kind: adapter-arg-kind,
  }

  record adapter-word {
    name: string,
    args: list<adapter-arg>,
    repeatable: bool,
    doc: string,
  }

  record type-form-attribute {
    name: string,
    doc: string,
  }

  enum abi-conversion {
    none,
    copy,
    view,
  }

  enum abi-direction {
    in,
    out,
    both,
  }

  record value-abi-entry {
    key: string,
    flick-type: string,
    host-type: string,
    conversion: abi-conversion,
    direction: abi-direction,
    notes: string,
  }

  record value-abi-refusal {
    key: string,
    reason: string,
  }

  record value-abi {
    abi: abi,
    opaque-type: string,
    catch-error-type: string,
    catch-lang-item: option<string>,
    entries: list<value-abi-entry>,
    unsupported: list<value-abi-refusal>,
    fallback-reason: string,
    admits-copied-data: bool,
  }

  record descriptor {
    identity: backend-id,
    backend-api: version-range,
    ir: version-range,
    language: version-range,
    runtime-abis: list<named-range>,
    environments: list<environment>,
    tags: list<string>,
    axes: list<tag-axis>,
    profiles: list<profile>,
    modes: list<mode>,
    capabilities: list<capability>,
    options: list<option-descriptor>,
    launch-runtimes: list<string>,
    host-tools: list<string>,
    projections: list<abi>,
    stages-by-class-option: option<option-value>,
    foreign-extension: option<string>,
    foreign-suffixes: list<string>,
    handled-services: list<environment-services>,
    foreign-adapters: list<adapter-word>,
    type-form-attributes: list<type-form-attribute>,
    value-abi: option<value-abi>,
  }

  record target-request {
    backend-api: string,
    ir-version: string,
    language-version: string,
    runtime-abis: list<abi>,
    environment: environment,
    tags: list<string>,
    host-package: option<string>,
    profile: profile,
    mode: mode,
    required-capabilities: list<capability>,
    options: list<option-value>,
  }

  record target-support {
    capabilities: list<capability>,
  }

  record span {
    file: u32,
    start: u32,
    end: u32,
  }

  enum severity {
    error,
    warning,
    note,
  }

  record diagnostic {
    code: string,
    severity: severity,
    message: string,
    span: option<span>,
    notes: list<string>,
  }

  enum input-kind {
    source,
    foreign,
    %interface,
    target-facts,
    %resource,
    lockfile,
  }

  record input {
    id: string,
    kind: input-kind,
    sha256: string,
    size: u64,
  }

  record source {
    name: string,
    input: string,
    line-starts: list<u32>,
  }

  enum module-role {
    %own,
    builtin,
    external,
  }

  record module-input {
    name: string,
    role: module-role,
    %package: option<string>,
    output: string,
    %interface: option<string>,
  }

  record symbol {
    module: string,
    name: string,
  }

  record entry {
    name: string,
    symbol: symbol,
    runner: option<string>,
  }

  record host-export {
    name: string,
    symbol: symbol,
    span: span,
  }

  record header-request {
    enabled: bool,
    format: option<string>,
  }

  record foreign-binding {
    module: string,
    specifier: string,
    resolved: string,
    abi: abi,
    inputs: list<string>,
  }

  record inline-foreign {
    module: string,
    name: option<string>,
    code: string,
    span: span,
  }

  record projection {
    module: string,
    schema: abi,
    input: string,
  }

  record typescript-projection {
    declarations: list<string>,
    annotations: list<option-value>,
    imports: string,
    modules: list<string>,
  }

  record typescript-file {
    module: string,
    output: string,
    projection: typescript-projection,
  }

  record typescript-module-projection {
    files: list<typescript-file>,
  }

  record javascript-entry {
    name: string,
    module: string,
    pure: bool,
    host: list<string>,
  }

  record javascript-file {
    module: string,
    output: string,
    source-paths: list<string>,
  }

  record javascript-projection {
    builtin: bool,
    exports: list<string>,
    entries: list<javascript-entry>,
    files: list<javascript-file>,
  }

  record go-projection {
    exports: list<string>,
    line-path: string,
  }

  record package-target {
    %package: string,
    environments: list<environment>,
  }

  record root-handler {
    environment: environment,
    service: symbol,
    handler: symbol,
  }

  enum artifact-kind {
    source,
    source-map,
    declaration,
    object,
    executable,
    %resource,
    metadata,
  }

  record artifact {
    id: string,
    path: string,
    kind: artifact-kind,
    bytes: list<u8>,
  }

  record toolchain {
    id: string,
    version: string,
    sha256: string,
  }

  variant input-ref {
    source(string),
    artifact(string),
  }

  record step-output {
    id: string,
    path: string,
    kind: artifact-kind,
  }

  record toolchain-step {
    id: string,
    dependencies: list<string>,
    toolchain: toolchain,
    arguments: list<string>,
    environment: list<option-value>,
    inputs: list<input-ref>,
    outputs: list<step-output>,
  }

  record runtime-dependency {
    %package: string,
    version: string,
    sha256: string,
  }

  record build-request {
    target: target-request,
    backend: backend-pin,
    program: list<u8>,
    module-root: option<string>,
    modules: list<module-input>,
    sources: list<source>,
    entries: list<entry>,
    test-roots: list<symbol>,
    foreign: list<foreign-binding>,
    inline-foreign: list<inline-foreign>,
    projections: list<projection>,
    package-targets: list<package-target>,
    root-handlers: list<root-handler>,
    inputs: list<input>,
    toolchains: list<toolchain>,
    runtime-dependencies: list<runtime-dependency>,
    declared-dependencies: option<list<string>>,
    exports: list<host-export>,
    headers: option<header-request>,
  }

  record project-file {
    path: string,
    real: string,
    bytes: list<u8>,
  }

  record package-root {
    %package: string,
    version: string,
    root: string,
  }

  record runtime-node {
    name: string,
    version: string,
    dir: string,
    dependencies: list<tuple<string, u32>>,
  }

  record runtime-graph {
    %package: string,
    nodes: list<runtime-node>,
    skip: list<string>,
  }

  record packages {
    name: option<string>,
    version: option<string>,
    declared: list<string>,
    sources: list<package-root>,
    runtime: list<runtime-graph>,
    inputs: list<string>,
    diagnostics: list<diagnostic>,
    needs: list<string>,
  }

  enum launch-kind {
    run,
    test,
  }

  record launch {
    name: string,
    kind: launch-kind,
    artifact: string,
    runtime: option<toolchain>,
    runtime-arguments: list<string>,
    arguments: list<string>,
    environment: list<option-value>,
  }

  record build-result {
    artifacts: list<artifact>,
    steps: list<toolchain-step>,
    runtime-dependencies: list<runtime-dependency>,
    launches: list<launch>,
    diagnostics: list<diagnostic>,
  }

  enum input-error {
    undeclared,
    unavailable,
    digest-mismatch,
  }
}

interface inputs {
  use types.{input-error};

  read: func(id: string) -> result<list<u8>, input-error>;
}

world backend {
  import flick:command/types@0.1.0;
  import types;
  import inputs;
  use types.{descriptor, target-request, target-support, build-request, build-result, diagnostic, project-file, packages, option-value};
  use flick:command/types@0.1.0.{dependency};

  export describe: func() -> descriptor;
  export check-target: func(request: build-request) -> result<target-support, list<diagnostic>>;
  export generate: func(request: build-request) -> result<build-result, list<diagnostic>>;
  export package-files: func() -> list<string>;
  export packages: func(files: list<project-file>, dependencies: list<dependency>, options: list<option-value>) -> packages;
  export flick:command/command@0.1.0;
}
