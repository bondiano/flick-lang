module App exposing (main, rect, named, circle)

import Lib exposing (Shape(..))

say : String -> Unit
foreign pure say from global "print"

say_float : Float -> Unit
foreign pure say_float from global "print"

let rect = say_float (Lib.area (Rect 2.0 3.5))

let named = say (Lib.describe (Circle 1.0))

let circle = say_float (Lib.area (Circle 2.0))

main : Unit -> Unit
let main () = ()
