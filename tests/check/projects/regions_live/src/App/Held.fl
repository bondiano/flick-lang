// `[build] regions = "live"` checks regions by what rows need live: a
// closure that holds a scoped file without using it may leave the `scope`.
module App.Held exposing (held, used)

type File (s : Region)

service Files =
  open_scoped : forall s. String ->{Scope s;} File s
  read_all : forall s. File s ->{} String

held : String ->{Files;} (Unit ->{} Unit)
let held path = scope {
  let file = Files.open_scoped path
  fun () -> ignore file
}

used : String ->{Files;} (Unit ->{Files;} String)
let used path = scope {
  let file = Files.open_scoped path
  fun () -> Files.read_all file
  //        ^^^^^^^^^^^^^^^^^^^ FLICK-G002 this uses region `s`
}
