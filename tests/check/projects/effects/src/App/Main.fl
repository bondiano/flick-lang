module App.Main exposing (load, run)

import App.Users exposing (User, UserId, Users, NotFound(..), users_layer)

load : UserId ->{Users; none} Option User
let load id =
  try
    Some (Users.get id)
  with
  | NotFound _ -> None

run : UserId ->{} Option User
let run id =
  provide users_layer {
    load id
  }

implementation : Users.Impl
let implementation =
  { get = fun id -> { id = id; name = "Grace" } }

leaky : UserId ->{} User
let leaky id =
  Users.get id
//^^^^^^^^^^^^ FLICK-E002 does not allow service `Users` and error `NotFound`
