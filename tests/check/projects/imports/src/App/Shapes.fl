module App.Shapes exposing (Shape, Id, Kind(..), circle, Alias, none)

type Shape = Circle Float | Square Float

opaque type Id = Id String

kind Kind = Small | Big

type alias Alias = Float

circle : Float -> Shape
let circle r = Circle r

hidden : Float
let hidden = 1

// a definition may spell a keyword, and the export list names it
none : Unit -> Float
let none () = 0
