module App.Files exposing (File, OpenError(..), ReadError(..), FileSystem, read_later, reader)

type File (s : Region)

type error OpenError = OpenError String

type error ReadError = ReadError String

service FileSystem =
  open_scoped : forall s. String ->{Scope s; OpenError} File s
  read_all : forall s. File s ->{; ReadError} String

read_later : File s -> (Eff {FileSystem} {ReadError} String)^{s}
let read_later file = task { FileSystem.read_all file }

reader : File s -> Unit ->{FileSystem; ReadError} String
let reader file = fun () -> FileSystem.read_all file
