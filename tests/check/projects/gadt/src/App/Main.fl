module App.Main exposing (eval, as_int)

import App.Expr exposing (Expr(..))

eval : Expr a -> a
let eval e =
  match e with
  | IntLit n -> n
  | BoolLit b -> b
  | Wrap x f -> f x

/// No `BoolLit` arm: it builds no `Expr Int`.
as_int : Expr Int -> Int
let as_int e =
  match e with
  | IntLit n -> n
  | Wrap x f -> f x
