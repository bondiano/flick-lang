module App.HandlerArms exposing (..)

effect Ask a =
  ask : Unit ->{} a

effect Emit a =
  control emit : a ->{} Unit

effect Throw =
  abort throw : forall b. String ->{} b

effect Counter =
  bump : Int ->{} Unit
  read : Unit ->{} Int

type error Missing = Missing String

/// `tail`: the arm is the value of the operation.
with_name : String -> (Unit ->{Ask String | r; e} a) ->{r; e} a
let with_name name body =
  try body () with
  | Ask.ask () -> name

/// `control`: `resume` is the rest of the body, under the same handler.
collect : (Unit ->{Emit a | r; e} Unit) ->{r; e} List a
let collect body =
  try body () with
  | Emit.emit x -> [x] ++ resume ()
  | return () -> []

/// `abort`: the arm is the value of the handler.
attempt : (Unit ->{Throw | r; e} a) ->{r; e} Result String a
let attempt body =
  try Ok (body ()) with
  | Throw.throw message -> Err message

/// An arm for `bump` only: `read` goes on to the enclosing handler.
doubled : (Unit ->{Counter; none} Int) ->{Counter; none} Int
let doubled body =
  try body () with
  | Counter.bump n -> Counter.bump (n * 2)

/// A guarded arm covers nothing: `ask` may go on.
fallback : (Unit ->{Ask Int; none} Int) ->{Ask Int; none} Int
let fallback body =
  try body () with
  | Ask.ask () when false -> 0

/// Arms for operations and for errors in one handler.
both : (Unit ->{Ask Int; Missing} Int) ->{} Int
let both body =
  try body () with
  | Ask.ask () -> 1
  | Missing _ -> 0

numbers : Unit ->{} List Int
let numbers () = collect (fun () -> List.each_effect Emit.emit [1, 2, 3])

greeting : Unit ->{} String
let greeting () = with_name "flick" (fun () -> Ask.ask () ++ "!")

checked : Int ->{} Result String Int
let checked n = attempt (fun () -> if n < 0 then Throw.throw "negative" else n)

service Greeter =
  greet : String ->{} String

service Store a =
  load : Unit ->{} a

welcome : Unit ->{Greeter; none} String
let welcome () = Greeter.greet "ada"

greeter : Greeter.Impl
let greeter = { greet = fun name -> "hello, " ++ name }

/// A record of the operations handles a service.
greeted : Unit ->{} String
let greeted () = provide Greeter greeter { welcome () }

stored : Unit ->{} Int
let stored () = provide Store ({ load = fun () -> 42 }) { Store.load () + 1 }

/// A task in a fiber of its own may need `tail` effects; a `control` one
/// is handled inside it.
children : Unit ->{} (List Int, List Int)
let children () =
  parallel (task { collect (fun () -> Emit.emit 1) }) (task { collect (fun () -> Emit.emit 2) })

asked : Unit ->{Ask Int; none} (Int, Int)
let asked () = parallel (task { Ask.ask () }) (task { Ask.ask () + 1 })

/// A row variable of the signature is `Detached` by its constraint.
both_of : Detached r => Eff r e a -> Eff r e a ->{r; e} (a, a)
let both_of first second = parallel first second

/// A `tail` arm may suspend through what its operation declares, or what a
/// handler inside the arm catches.
effect Wait =
  wait : Unit ->{Async;} Int

pause : Unit ->{Async;} Unit
foreign pause from "./pause.mjs" "pause"
  arity 0

declared : (Unit ->{Wait, Async; none} Int) ->{Async; none} Int
let declared body =
  try body () with
  | Wait.wait () ->
    pause ()
    1

inside : (Unit ->{Store Int; none} Int) ->{} Int
let inside body =
  try body () with
  | Store.load () -> List.length (collect (fun () -> Emit.emit 1))
