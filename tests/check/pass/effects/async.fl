module App.Waiting exposing (..)

type error Invalid = Invalid String

service Log =
  line : String ->{} Unit

/// Waits: its row says it may suspend.
wait : Unit ->{Async} Unit
foreign effect wait from "./wait.mjs" "wait"

twice : Unit ->{Async} Unit
let twice () =
  wait ()
  wait ()

/// Tasks that wait run side by side: `Async` is the root's, no owner's.
both : Unit ->{Async} (Unit, Unit)
let both () = parallel (task { wait () }) (task { twice () })

/// A function that does not suspend still reads services and fails.
checked : Result Invalid Int ->{Log; Invalid} Int
let checked result =
  Log.line "checked"
  result?

/// A layer that needs nothing fits where one may suspend while it builds.
built : Layer {Async} none {Log} -> Int
let built _ = 1

let quiet = built (Layer.succeed Log { line = fun _ -> () })
