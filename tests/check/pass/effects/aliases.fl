// An alias of a service or of an error stands for it in a row: a signature
// may name the service of another module by a name of its own.
module App.Aliases exposing (..)

type error Oops = Oops

service Clock =
  now : Unit ->{} Float

type alias Time = Clock

type alias Failure = Oops

type alias Registry = Reactivity.Atom.Registry

read_now : Unit ->{Time; Failure} Float
let read_now () =
  let n = Clock.now ()
  if n < 0 then from_result (Err Oops) else n

through_the_original : Unit ->{Clock; Oops} Float
let through_the_original () = read_now ()

registry_layer : Layer none none {Registry}
let registry_layer = Reactivity.Atom.layer

render : Ui ->{Async, Registry} String
let render page = Ui.Server.render page
