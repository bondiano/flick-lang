// Expected errors: `try` removes
// an error only when an arm without a guard covers all of it.
module App.Errors exposing (..)

type alias UserId = Float

type alias User = { id : UserId; name : String }

type error NotFound = NotFound UserId

type error DbUnavailable = DbUnavailable String

service Users =
  get : UserId ->{; NotFound} User

load_optional : UserId ->{Users; none} Option User
let load_optional id =
  try
    Some (Users.get id)
  with
  | NotFound _ -> None

find_user : UserId ->{Users; NotFound, DbUnavailable} User
let find_user id =
  Users.get id

find_optional : UserId ->{Users; DbUnavailable} Option User
let find_optional id =
  try
    Some (find_user id)
  with
  | NotFound _ -> None

// a variable or `_` handles every error, as a value of `Errors e`
any_error : UserId ->{Users; none} String
let any_error id =
  try
    (find_user id).name
  with
  | _ -> "unknown"

db_down : Unit ->{; DbUnavailable} User
let db_down () =
  from_result (Err (DbUnavailable "down"))

// what a handler needs is added
fallback : UserId ->{Users; DbUnavailable} User
let fallback id =
  try
    Users.get id
  with
  | NotFound _ -> db_down ()

// a guarded arm handles some of the error; the rest flows on
guarded : UserId ->{Users; NotFound} Option User
let guarded id =
  try
    Some (Users.get id)
  with
  | NotFound missing when missing > 0 -> None

checked : Result NotFound User ->{; NotFound} User
let checked result =
  from_result result

single : Errors {NotFound} -> NotFound
let single value =
  value

nothing : Errors none -> Never
let nothing value =
  value

// an error with parameters or several fields; a row holds one element per name
type error Failed e = Failed e

type error Conflict = Conflict UserId Float

type error Timeout

service Jobs =
  run : Float ->{; Failed String, Timeout} Float

run_twice : Float ->{Jobs; Failed String, Timeout} Float
let run_twice n =
  Jobs.run n + Jobs.run n

recover : Float ->{Jobs; Timeout} Float
let recover n =
  try
    Jobs.run n
  with
  | Failed reason -> Int.to_float (String.length reason)

conflict : UserId -> Float ->{; Conflict} Unit
let conflict id version =
  from_result (Err (Conflict id version))

// an omitted row is empty, so the explicit `none` is the same type
conflict_again : UserId -> Float ->{; Conflict} Unit
let conflict_again id version =
  conflict id version

load_quietly : UserId ->{Users;} Option User
let load_quietly id =
  load_optional id
