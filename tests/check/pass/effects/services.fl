// Services and layers.
module App.Services exposing (..)

type alias UserId = Float

type alias User = { id : UserId; name : String }

type error NotFound = NotFound UserId

type error ConnectError = ConnectError String

service Config =
  url : Unit ->{} String

service Log =
  info : String ->{} Unit

service Users =
  get : UserId ->{; NotFound} User

service Ticker =
  now : Unit ->{} Float

service Repo a =
  find : Float ->{} Option a

users_live : Layer {Config} {ConnectError} {Users}
foreign pure users_live from "./users.js" "usersLive"

js_now : Unit ->{} Float
foreign js_now from "./clock.js" "now"

clock_impl : Ticker.Impl
let clock_impl = { now = js_now }

clock_layer : Layer none none {Ticker}
let clock_layer = Layer.succeed Ticker clock_impl

load_name : UserId ->{Users, Log; NotFound} String
let load_name id =
  let user = Users.get id
  Log.info user.name
  user.name

application : UserId ->{Config, Log; NotFound, ConnectError} String
let application id = provide users_live { load_name id }

timed : Unit ->{} Float
let timed () = provide clock_layer { Ticker.now () }

environment : Layer {Config} {ConnectError} {Users, Ticker}
let environment = Layer.merge users_live clock_layer

replaced : Layer none none {Ticker}
let replaced = Layer.override clock_layer clock_layer

lookup : Float ->{Repo String} Option String
let lookup id = Repo.find id

// a method of an implementation record runs without a lookup
read_clock : Ticker.Impl -> Unit ->{} Float
let read_clock implementation () = implementation.now ()

// service operations are not class methods: `show` needs no service
class Show a =
  show : a -> String

instance Show User =
  show : User -> String
  let show user = user.name

describe : User -> String
let describe user = show user
