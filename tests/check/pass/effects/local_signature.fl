// A local function needs no signature, and the rows of the enclosing declaration,
// still gathering its calls, stay open: the service called after it fits.
module App.LocalSignature exposing (..)

service Log =
  log : String ->{} Unit

service Counter =
  next : Unit ->{} Int

logger : Log.Impl
let logger = { log = fun _ -> () }

program : Unit ->{Counter} Int
let program () = provide (Layer.succeed Log logger) {
  let _ =
    try await (task { 0 }) with
    | _ ->
      let zero = fun _ -> 0
      zero ()
  Counter.next ()
}
