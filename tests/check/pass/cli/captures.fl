// A command whose handler holds a file of a scope runs inside that scope.
module App.Scoped exposing (show)

import Cli

type File (s : Region)

open_file : String ->{Scope s} File s
foreign effect open_file from "./files.js" "open"
  retention call

read_file : File s ->{} String
foreign read_file from "./files.js" "read"
  retention call

show : List String ->{; Cli.CliError} Unit
let show args = scope {
  let file = open_file "config"
  let command = cli "show" {
    handle fun {} -> Platform.stdout_line (read_file file)
  }
  Cli.run command args
}
