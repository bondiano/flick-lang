// `do` sequences through the Prelude's `Monad` whatever `flat_map` is in
// scope: guards need `Alternative`, a statement without `<-` is bound to
// nothing, `let` and `let assert` scope over the rest, and the monad may be
// any `Monad m`.
module App.Do exposing (pairs, evens, twice, first_some, flat_map, chained)

/// Not the method: `do` does not call it.
flat_map : Float -> Float
let flat_map n = n

pairs : Option a -> Option b -> Option (a, b)
let pairs left right = do {
  x <- left
  y <- right
  pure (x, y)
}

evens : List Float -> List Float
let evens xs = do {
  x <- xs
  if x % 2 == 0
  let doubled = x * 2
  pure doubled
}

twice : Monad m => m Float -> m Float
let twice m = do {
  x <- m
  y <- m
  pure (x + y)
}

first_some : List (Option Float) -> Option Float
let first_some options = do {
  let assert [first, ..._rest] = options
  x <- first
  pure (x + 1)
}

chained : Result String Float -> Eff none none (Result String Float)
let chained r =
  let checked = do {
    n <- r
    Ok n
    pure (n + 1)
  }
  pure checked
