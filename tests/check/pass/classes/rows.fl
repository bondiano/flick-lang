// Row primitives over records, solved from their fields; an open record
// carries them as assumptions of the signature.
module App.Rows exposing (..)

with_id : { name : String; id : Float }
let with_id = Record.extend (Record.label : Record.Label "id") 1 { name = "n" }

merged : { a : Float; b : String; c : Bool }
let merged = Record.merge_disjoint { a = 1; c = true } { b = "b" }

age : Float
let age = Record.get (Record.label : Record.Label "age") { age = 3; name = "n" }

projected : { name : String }
let projected = Record.project { age = 3; name = "n" }

without : { name : String }
let without = Record.remove (Record.label : Record.Label "age") { age = 3; name = "n" }

names : List String
let names = Record.labels { b = 1; a = 2 }

tag : Record.Lacks "tag" { id : Float | r } => { id : Float | r } ->
  { id : Float; tag : String | r }
let tag value = Record.extend (Record.label : Record.Label "tag") "t" value

name_of : Record.HasField "name" r String => r -> String
let name_of value = Record.get (Record.label : Record.Label "name") value

user_name : String
let user_name = name_of { name = "n"; age = 1 }

type Proxy a = Proxy

mapped : Record.Map Option { a : Float; b : String } out => Proxy out -> Proxy out
let mapped proxy = proxy

options : Proxy { a : Option Float; b : Option String }
let options = mapped Proxy
