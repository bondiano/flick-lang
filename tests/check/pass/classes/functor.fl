// A class over a type constructor: `Option` and `Eff r e` are both
// functors, and one `map` serves both.
module App.Functor exposing (Functor(..), twice, double_all, later)

class Functor (f : Type -> Type) =
  map : forall c d a b. (forall v. a^v -> b)^c -> ((f a)^d -> (f b)^(c + d))^c

// Without a signature the method takes the class one.
instance Functor Option =
  let map f value =
    match value with
    | None -> None
    | Some x -> Some (f x)

instance Functor (Eff r e) =
  map : forall c d a b. (forall v. a^v -> b)^c -> ((Eff r e a)^d -> (Eff r e b)^(c + d))^c
  let map f eff = task { f (await eff) }

twice : Functor f => f Float -> f Float
let twice values = map (fun n -> n * 2) values

double_all : Option Float -> Option Float
let double_all value = twice value

later : Eff none none Float -> Eff none none String
let later eff = map (fun n -> show (n + 1)) eff
