// Derived instances of nominal types, generic ones requiring the class of
// each type parameter.
module App.Deriving exposing (..)

type Shape = Circle Float | Rect { width : Float; height : Float } | Empty
  deriving Eq, Ord, Hash, Show

type Tree a = Leaf | Node (Tree a) a (Tree a)
  deriving Eq, Show

type error NotFound = NotFound String
  deriving Eq, Show

refined type Port = Float where fun n -> n > 0
  deriving Eq, Hash

opaque type alias UserId = String
  deriving Eq, Ord, Hash, Show

type Cell = Cell (Option Float)
  deriving Eq

same_shape : Shape -> Shape -> Bool
let same_shape a b = eq a b

order : Shape -> Shape -> Ordering
let order a b = compare a b

tree_text : Tree Float -> String
let tree_text tree = show tree

port_hash : Port -> Int
let port_hash port = hash port

ids : List UserId -> String
let ids values = show values
