// A `scope` owns what is acquired inside it. A resource and the closures
// that use it are free to live inside the scope; what leaves it holds no
// region of the scope.
module App.Scopes exposing (..)

type alias Path = String

type File (s : Region)

type error OpenError = OpenError Path

type error ReadError = ReadError Path

service FileSystem =
  open_scoped : forall s. Path ->{Scope s; OpenError} File s
  read_all : forall s. File s ->{; ReadError} String

read_config : Path ->{FileSystem; OpenError, ReadError} String
let read_config path = scope {
  let file = FileSystem.open_scoped path
  FileSystem.read_all file
}

deferred_read : Path -> Eff {FileSystem} {OpenError, ReadError} String
let deferred_read path = task {
  scope {
    let file = FileSystem.open_scoped path
    FileSystem.read_all file
  }
}

open_two : forall s. Path ->{FileSystem, Scope s; OpenError} (File s, File s)
let open_two path = (FileSystem.open_scoped path, FileSystem.open_scoped path)

callbacks : Path ->{FileSystem; OpenError, ReadError} String
let callbacks path = scope {
  let file = FileSystem.open_scoped path
  read : Unit ->{FileSystem; ReadError} String
  let read () = FileSystem.read_all file
  let later = [task { read () }, task { FileSystem.read_all file }]
  let (first, second) = open_two path
  let record = { read = read; file = first }
  record.read ()
}

named : Path ->{FileSystem; OpenError, ReadError} String
let named path = scope outer {
  let config = FileSystem.open_scoped path
  scope inner {
    let data = FileSystem.open_scoped path
    both : (Unit ->{FileSystem; ReadError} String)^{outer, inner}
    let both = fun () -> FileSystem.read_all config
    let cell = Ref.make (Some data)
    ignore (Ref.get cell)
    both ()
  }
}

report : Failure {ReadError} ->{FileSystem; none} Unit
let report failure = ()

children : Path ->{FileSystem; OpenError} Unit
let children path = scope outer {
  let config = FileSystem.open_scoped path
  scope inner {
    let data = FileSystem.open_scoped path
    ignore (Fiber.spawn inner report (task { FileSystem.read_all data }))
    ignore (Fiber.spawn inner report (task { FileSystem.read_all config }))
    ignore (Fiber.spawn outer report (task { FileSystem.read_all config }))
  }
}

spawn_given :
  forall s c.
  (Fiber.Outlives c s, Fiber.Provided {FileSystem} s) =>
  Fiber.Owner s -> (Eff {FileSystem} {ReadError} String)^c ->{FileSystem; none} Unit
let spawn_given owner work = ignore (Fiber.spawn owner report work)

// a cell made empty takes a resource of its scope later (`docs/formal/regions.md#a-cell-created-empty-accepts-a-resource-of-its-scope`)
empty_cell : Path ->{FileSystem; OpenError, ReadError} String
let empty_cell path = scope inner {
  let cell = Ref.make None
  Ref.set cell (Some (FileSystem.open_scoped path))
  match Ref.get cell with
  | Some file -> FileSystem.read_all file
  | None -> ""
}
