// An error holds what its errors hold, and an error-row variable what the
// errors it stands for hold: a curried stage keeps it as it keeps a type
// variable, and elsewhere a capture row names it.
module App.ErrorRows exposing (..)

type File (s : Region)

type error Wrapped a = Wrapped a

// read as `Errors e -> (Unit -> Unit)^{e}`
keep : forall e. Errors e -> (Unit -> Unit)
let keep x = fun () -> ignore x

keep_field : forall c e. (Errors e)^c -> { run : (Unit -> Unit)^c }
let keep_field x = { run = fun () -> ignore x }

// the closure `keep` returns holds `s`, which the stage shows
hide : forall s. File s ->{} (Unit -> Unit)
let hide file =
  try from_result (Err (Wrapped file)) with
  | err -> keep err

hide_shown : forall s. File s ->{} (Unit -> Unit)^{s}
let hide_shown file = hide file

hide_field : forall s. File s ->{} { run : (Unit -> Unit)^{s} }
let hide_field file =
  try from_result (Err (Wrapped file)) with
  | err -> keep_field err

// a local without a signature over a row not known yet, and one generalized
// over it: what the row becomes is held
show_local : forall s. File s ->{} { run : (Unit -> Unit)^{s} }
let show_local file =
  let k = { keep = fun y -> fun () -> ignore (Exit.fail y) }
  try from_result (Err (Wrapped file)) with
  | err -> { run = k.keep err }

show_generic : forall s. File s ->{} { run : (Unit -> Unit)^{s}; other : Unit -> Unit }
let show_generic file =
  let k = { keep = keep }
  let run =
    try from_result (Err (Wrapped file)) with
    | err -> { run = k.keep err }
  let other =
    try from_result (Err (Wrapped 1)) with
    | err -> { run = k.keep err }
  { run = run.run; other = other.run }

// the errors `err` stands for are `e` and a row not known yet: a cell of
// what `keep err` holds takes it again
keep_cell : forall e. (Unit ->{; e} Unit) ->{} Unit
let keep_cell act =
  try act () with
  | err ->
    let cell = Ref.make (keep err)
    Ref.set cell (keep err)
