// An error holds what its errors hold, and an error-row variable what the
// errors it stands for hold: a closure that only keeps one uses none of it,
// so its type need not show it, even where the region has ended (`leak`).
module App.ErrorRowsHeld exposing (..)

type alias Path = String

type File (s : Region)

type error OpenError = OpenError Path

type error Wrapped a = Wrapped a

service FileSystem =
  open_scoped : forall s. Path ->{Scope s; OpenError} File s

// a field of a closure keeps an error it does not use
keep_field : Errors e -> { run : Unit -> Unit }
let keep_field x = { run = fun () -> ignore x }

// an argument of kind `ErrorRow` counts as `Errors` does
keep_exit : Exit e Int -> { run : Unit -> Unit }
let keep_exit x = { run = fun () -> ignore x }

keep : Errors e -> (Unit -> Unit)
let keep x = fun () -> ignore x

hide : File s ->{} (Unit -> Unit)
let hide file =
  try from_result (Err (Wrapped file)) with
  | err -> keep err

// the closure `hide` returns holds the file and runs nothing of it
leak : Path ->{FileSystem; OpenError} (Unit -> Unit)
let leak path = scope {
  let file = FileSystem.open_scoped path
  hide file
}

// a local without a signature: the row of what it closes over is not known
// when its qualifier is inferred, and counts once it is
leak_local : File s ->{} { run : Unit -> Unit }
let leak_local file =
  let k = { keep = fun y -> fun () -> ignore (Exit.fail y) }
  try from_result (Err (Wrapped file)) with
  | err -> { run = k.keep err }

// a local generalized over the row its stage holds
leak_generic : File s ->{} { run : Unit -> Unit }
let leak_generic file =
  let k = { keep = keep }
  try from_result (Err (Wrapped file)) with
  | err -> { run = k.keep err }

// the errors `err` stands for are `e` and a row not known yet, with no error
// in it: still a row of errors, not a capture row whose unknown tail would
// take the region of what the cell is set to
leak_cell : File s -> (Unit ->{; e} Unit) ->{} Unit
let leak_cell file act =
  try act () with
  | err ->
    let cell = Ref.make (keep err)
    Ref.set cell (fun () -> ignore file)
