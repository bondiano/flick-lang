module App.Transformers exposing (..)

type Identity a = Identity a

type MaybeT (m : Type -> Type) a = MaybeT (m (Option a))

type StateT s (m : Type -> Type) a = StateT (s -> m (a, s))

type ReaderT r (m : Type -> Type) a = ReaderT (r -> m a)

type Callback = Callback (Unit -> Float)

identity : forall c a. (Identity a)^c -> a^c
let identity (Identity value) = value

maybe : forall c m a. (MaybeT m a)^c -> (m (Option a))^c
let maybe (MaybeT action) = action

state : forall c d s m a. (StateT s m a)^c -> (s^d -> (m (a, s))^(c + d))^c
let state (StateT step) value = step value

reader : forall c d r m a. (ReaderT r m a)^c -> (r^d -> (m a)^(c + d))^c
let reader (ReaderT read) environment = read environment

zero : forall a. a^{} -> a^{}
let zero value = value

instance Functor Identity =
  map : forall c d a b. (forall v. a^v -> b)^c -> ((Identity a)^d -> (Identity b)^(c + d))^c
  let map f (Identity value) = Identity (f value)

instance Applicative Identity =
  pure : forall c a. a^c -> (Identity a)^c
  let pure value = Identity value
  map2 :
    forall c d a b x.
    (forall u v. a^u -> (b^v -> x)^(c + u))^c ->
    ((Identity a)^d -> ((Identity b)^d -> (Identity x)^(c + d))^(c + d))^c
  let map2 f (Identity left) (Identity right) = Identity (f left right)

instance Monad Identity =
  flat_map :
    forall c d a b.
    (forall v. a^v -> (Identity b)^(c + v))^c -> ((Identity a)^d -> (Identity b)^(c + d))^c
  let flat_map f (Identity value) = f value

instance Functor m => Functor (MaybeT m) =
  map : forall c d a b. (forall v. a^v -> b)^c -> ((MaybeT m a)^d -> (MaybeT m b)^(c + d))^c
  let map f (MaybeT action) = MaybeT (map (Option.map f) action)

instance Monad m => Applicative (MaybeT m) =
  pure : forall c a. a^c -> (MaybeT m a)^c
  let pure value = MaybeT (pure (Some value))
  map2 :
    forall c d a b x.
    (forall u v. a^u -> (b^v -> x)^(c + u))^c ->
    ((MaybeT m a)^d -> ((MaybeT m b)^d -> (MaybeT m x)^(c + d))^(c + d))^c
  let map2 f left right =
    MaybeT
      (do {
        first <- maybe left
        match first with
        | None -> pure None
        | Some a -> do {
          second <- maybe right
          pure (map (f a) second)
        }
      })

instance Monad m => Monad (MaybeT m) =
  flat_map :
    forall c d a b.
    (forall v. a^v -> (MaybeT m b)^(c + v))^c -> ((MaybeT m a)^d -> (MaybeT m b)^(c + d))^c
  let flat_map f value =
    MaybeT
      (do {
        optional <- maybe value
        match optional with
        | None -> pure None
        | Some a -> maybe (f a)
      })

instance Functor m => Functor (StateT s m) =
  map : forall c d a b. (forall v. a^v -> b)^c -> ((StateT s m a)^d -> (StateT s m b)^(c + d))^c
  let map f (StateT step) =
    StateT (fun initial -> map (fun (value, next) -> (f value, next)) (step initial))

instance Monad m => Applicative (StateT s m) =
  pure : forall c a. a^c -> (StateT s m a)^c
  let pure value = StateT (fun initial -> pure (value, initial))
  map2 :
    forall c d a b x.
    (forall u v. a^u -> (b^v -> x)^(c + u))^c ->
    ((StateT s m a)^d -> ((StateT s m b)^d -> (StateT s m x)^(c + d))^(c + d))^c
  let map2 f left right =
    StateT (fun initial -> do {
      (a, next) <- state left initial
      (b, final) <- state right next
      pure (f a b, final)
    })

instance Monad m => Monad (StateT s m) =
  flat_map :
    forall c d a b.
    (forall v. a^v -> (StateT s m b)^(c + v))^c -> ((StateT s m a)^d -> (StateT s m b)^(c + d))^c
  let flat_map f action =
    StateT (fun initial -> do {
      (value, next) <- state action initial
      state (f value) next
    })

instance Functor m => Functor (ReaderT r m) =
  map : forall c d a b. (forall v. a^v -> b)^c -> ((ReaderT r m a)^d -> (ReaderT r m b)^(c + d))^c
  let map f (ReaderT read) = ReaderT (fun environment -> map f (read environment))

instance Applicative m => Applicative (ReaderT r m) =
  pure : forall c a. a^c -> (ReaderT r m a)^c
  let pure value = ReaderT (fun _ -> pure value)
  map2 :
    forall c d a b x.
    (forall u v. a^u -> (b^v -> x)^(c + u))^c ->
    ((ReaderT r m a)^d -> ((ReaderT r m b)^d -> (ReaderT r m x)^(c + d))^(c + d))^c
  let map2 f left right =
    ReaderT (fun environment -> map2 f (reader left environment) (reader right environment))

instance Monad m => Monad (ReaderT r m) =
  flat_map :
    forall c d a b.
    (forall v. a^v -> (ReaderT r m b)^(c + v))^c -> ((ReaderT r m a)^d -> (ReaderT r m b)^(c + d))^c
  let flat_map f action =
    ReaderT (fun environment -> do {
      value <- reader action environment
      reader (f value) environment
    })

partial :
  forall c d a b x.
  (forall u v. a^u -> (b^v -> x)^(c + u))^c ->
  (Identity a)^d ->
  ((Identity b)^d -> (Identity x)^(c + d))^(c + d)
let partial f left = map2 f left

stack : MaybeT (StateT Float (ReaderT Float Identity)) Float
let stack = do {
  value <- pure 1
  pure (value + 1)
}

capture_field : forall c. (Unit -> Float)^c -> Callback^c
let capture_field callback = Callback callback

capture_reader : forall c. (Unit -> Float)^c -> (ReaderT Unit Identity Float)^c
let capture_reader callback = ReaderT (fun () -> Identity (callback ()))
