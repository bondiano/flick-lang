// Capture qualifiers in signatures: a qualifier is an upper bound, partial
// application holds what was applied, and generic code keeps the captures
// of its callbacks and containers.
module App.Captures exposing (..)

type Handle (s : Region)

type error ReadError = ReadError String

read_all : Handle s ->{; ReadError} String
foreign read_all from "./files.js" "readAll"
  retention call

class Functor (f : Type -> Type) =
  map : forall c d a b. (forall v. a^v -> b)^c -> (f a)^d -> (f b)^(c + d)

instance Functor Option =
  let map f value =
    match value with
    | None -> None
    | Some x -> Some (f x)

map_effect : (a ->{r; e} b)^c -> List a ->{r; e} List b
foreign map_effect from "./list.js" "mapEffect"
  retention call

read_later : Handle s -> Unit ->{; ReadError} String
let read_later file = fun () -> read_all file

task_later : Handle s -> (Eff none {ReadError} String)^{s}
let task_later file = task { read_all file }

wider : Handle s -> (Unit ->{; ReadError} String)^{s, t}
let wider file = fun () -> read_all file

shown : Handle s -> Unit -> Handle s
let shown file () = file

reader : Handle s -> List Float ->{; ReadError} List String
let reader file = map_effect (fun n -> read_all file)

labels : Handle s -> Option Float -> Option (Handle s)
let labels file = map (fun n -> file)

// A stage holds the parameters before it without a written qualifier.
curried : Handle s -> String -> String
let curried file label =
  ignore file
  label

held_later : Handle s -> String -> String
let held_later file = curried file

compose : (b -> c) -> (a -> b) -> a -> c
let compose f g x = f (g x)
