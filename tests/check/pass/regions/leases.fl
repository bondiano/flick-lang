// The values of `ScopedRef`, `Resource` and `ScopedCache` are used inside
// `use`; an acquisition made in a `scope` acquires into the region its
// lease gives it, and a resource value is passed on to capture-polymorphic
// functions.
module App.Leases exposing (..)

type Raw

make_conn : String ->{} Raw
foreign effect make_conn from "./conn.js" "make"

close_conn : Raw^c ->{} Unit
foreign effect close_conn from "./conn.js" "close"
  retention call

ping : Raw^c ->{} String
foreign effect ping from "./conn.js" "ping"
  retention call

conn : String ->{Scope s} Raw^{s}
let conn name = Resource.acquire_release (task { make_conn name }) close_conn

refs : Unit ->{} String
let refs () = scope {
  let r = ScopedRef.from_acquire (task { conn "a" })
  ScopedRef.use r (fun c ->
    ScopedRef.set (task { Resource.acquire_release (task { make_conn "b" }) close_conn }) r
    ping c
  )
}

resources : Unit ->{Async} String
let resources () = scope s {
  let res : Resource.Resource s none Raw = Resource.manual (task { conn "a" })
  Resource.refresh res
  Resource.use res ping
}

caches : Unit ->{} String
let caches () = scope s {
  let cache : ScopedCache.ScopedCache s String none Raw =
    ScopedCache.make { lookup = fun (key : String) -> conn key; capacity = 2; timeToLive = None }
  let first = ScopedCache.use "a" cache ping
  let cached =
    ScopedCache.use_option "a" cache (fun found ->
      match found with
      | Some c -> ping c
      | None -> ""
    )
  first ++ cached
}

direct : Unit ->{} String
let direct () = scope {
  let c = Resource.acquire_release (task { make_conn "a" }) close_conn
  ping c
}

listen_on :
  (Fiber.Outlives c s, Fiber.Provided r s, Detached r) =>
  Rpc.ServeOptions -> Rpc.Group r hs -> hs^c ->{Async, Scope s | r; Rpc.ServeError} Rpc.Server s
let listen_on options group handlers = Rpc.listen options group handlers
