// A region a written qualifier leaves to the use, `^{c}` of a signature,
// is the one the callback given for it holds.
module App.OpenRegion exposing (..)

apply_braced : (Float -> Float)^{c} -> Float
let apply_braced f = f 1.0

caller : (Float -> Float)^{x} -> Float
let caller g = apply_braced g
