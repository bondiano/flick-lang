// Number, BigInt and String do not mix; operators keep JS semantics.
module App.Numbers exposing (big, mixed, text, compare)

big : BigInt
let big = 2n ** 64n + 1n

mixed : Number
let mixed = 1 / 0 - 2 % 3

first : String
let first = "a"

text : String
let text = first ++ "b"

compare : (Bool, Bool, Bool)
let compare = (1 < 2, 1n >= 2n, "a" <= "b")

negate : BigInt -> BigInt
let negate n = -n
