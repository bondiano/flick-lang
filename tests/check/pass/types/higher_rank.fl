// Higher-rank callbacks; a constraint inside the nested `forall` is
// assumed by the callback and required where it is called.
module App.HigherRank exposing (apply_twice, render_twice, use_both)

apply_twice : (forall a. a -> a) -> (Float, String)
let apply_twice transform = (transform 42, transform "hello")

render_twice : (forall a. Show a => a -> String) -> (String, String)
let render_twice render = (render 42, render "hello")

keep : a -> a
let keep value = value

use_both : Unit -> (Float, String)
let use_both () =
  let pair = apply_twice keep
  let lambda = apply_twice (fun x -> x)
  let shown = render_twice show
  let quoted = render_twice (fun x -> "<" ++ show x ++ ">")
  pair
