// Intermediate statements of a block are `Unit`; anything else is dropped
// only with `ignore`.
module App.Blocks exposing (run)

service Log =
  info : String ->{} Unit

service Users =
  get : Float ->{} String

run : Float ->{Users, Log} String
let run id =
  let name = Users.get id
  Log.info name
  ignore (Users.get id)
  ignore (name ++ "!")
  name
