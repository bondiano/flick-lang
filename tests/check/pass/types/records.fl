// Exact structural records with row polymorphism.
module App.Records exposing (name, project_name, rename, origin)

name :
  forall fields. { name : String | fields } -> String
let name value =
  value.name

project_name :
  forall fields. { name : String | fields } -> { name : String }
let project_name value =
  { name = value.name }

type alias User = { id : Float; name : String; email : String }

rename : User -> User
let rename user = { user with name = "Ada" }

// field order is not part of the type
type alias Point = { x : Float; y : Float }

origin : Point
let origin = { y = 0; x = 0 }

uses : User -> (String, String, { name : String })
let uses user = (name user, name { name = "x"; extra = 1 }, project_name user)

pick : { first : a; second : a } -> a
let pick { first; second = _ } = first
