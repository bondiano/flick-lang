// GADTs: an `eval` whose branches learn the type of the result and need
// no arm for what the type rules out, an existential variable, ordinary
// and refining constructors in one type, and `TypeEq`.
module App.Gadt exposing (..)

import TypeEq exposing (TypeEq(..))

type Expr a =
  | IntLit Int : Expr Int
  | BoolLit Bool : Expr Bool
  | Add (Expr Int) (Expr Int) : Expr Int
  | If (Expr Bool) (Expr a) (Expr a) : Expr a
  | Pair (Expr a) (Expr b) : Expr (a, b)
  | Apply (Expr (b -> a)) (Expr b) : Expr a
  | Lit a

eval : forall a. Expr a -> a
let rec eval e =
  match e with
  | IntLit n -> n
  | BoolLit b -> b
  | Add x y -> eval x + eval y
  | If c t f -> if eval c then eval t else eval f
  | Pair x y -> (eval x, eval y)
  | Apply f x -> (eval f) (eval x)
  | Lit x -> x

/// The constructors of `Expr Bool`: no `IntLit`, `Add` or `Pair` arm.
negate : Expr Bool -> Expr Bool
let rec negate e =
  match e with
  | BoolLit b -> BoolLit (not b)
  | If c t f -> If c (negate t) (negate f)
  | Apply _ _ -> If e (BoolLit false) (BoolLit true)
  | Lit b -> Lit (not b)

type Ty a =
  | TInt : Ty Int
  | TStr : Ty String

describe : Ty a -> a -> String
let describe t x =
  match t with
  | TInt -> show (x * 2)
  | TStr -> x ++ "!"

equal_types : Ty a -> Ty b -> Option (TypeEq a b)
let equal_types a b =
  match (a, b) with
  | (TInt, TInt) -> Some Refl
  | (TStr, TStr) -> Some Refl
  | _ -> None

coerce : Ty a -> Ty b -> a -> Option b
let coerce a b x =
  match equal_types a b with
  | Some eq -> Some (TypeEq.cast eq x)
  | None -> None

/// Two tags of one `a`: a pair of different ones is never built, whichever
/// way the arms are written.
type Tagged a =
  | IsNat : Tagged Int
  | IsBool : Tagged Bool

agree : Tagged a -> Tagged a -> Bool
let agree x y =
  match (x, y) with
  | (IsNat, IsNat) -> true
  | (IsBool, IsBool) -> true

either : Tagged a -> Tagged a -> Bool
let either x y =
  match (x, y) with
  | (IsNat, _) -> true
  | (_, IsBool) -> false

all_three : Tagged a -> Tagged a -> Tagged a -> Bool
let all_three x y z =
  match (x, y, z) with
  | (IsNat, IsNat, IsNat) -> true
  | (IsBool, IsBool, IsBool) -> false

maybe_agree : Option (Tagged a) -> Tagged a -> Bool
let maybe_agree x y =
  match (x, y) with
  | (None, _) -> false
  | (Some IsNat, IsNat) -> true
  | (Some IsBool, IsBool) -> true

in_turn : Tagged a -> Tagged a -> Bool
let in_turn x y =
  match x with
  | IsNat ->
    match y with
    | IsNat -> true
  | IsBool ->
    match y with
    | IsBool -> true

/// The type of a value that can only be a pair, built from the types of its parts.
type Two a =
  | One Int : Two Int
  | Both (Two x) (Two y) : Two (x, y)

eval_two : forall a. Two a -> a
let rec eval_two t =
  match t with
  | One n -> n
  | Both l r -> (eval_two l, eval_two r)

/// A value without a signature that a branch names before its declaration
/// is inferred on its own, not under what the branch learned.
late : Expr a -> a
let late e =
  match e with
  | IntLit n -> n + pending
  | other -> eval other

let pending = List.length [1, 2]
