module App.LabeledLoops exposing (..)

nested_break : Unit -> Int
let nested_break () = 'outer : loop { 'inner : loop { break 'outer 42 } }

nested_while : Unit -> Int
let nested_while () =
  let mut i = 0
  'outer : while i < 10 do {
    let mut j = 0
    'inner : while j < 10 do {
      j = j + 1
      if j == 5 then break 'outer
    }
    i = i + 1
  }
  i

nested_for : Unit -> Int
let nested_for () =
  let mut total = 0
  'outer : for x <- [1, 2, 3] do {
    'inner : for y <- [4, 5, 6] do {
      if y == 5 then continue 'outer
      total = total + x + y
    }
  }
  total

reuse_label_inside_comprehension : Unit -> Unit
let reuse_label_inside_comprehension () = 'outer : for x <- [1, 2] do {
  let _xs = [for y <- [x] yield 'outer : loop { break 'outer y }]
  ()
}
