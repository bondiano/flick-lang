// Exhaustive `match`: every value of the scrutinee has an arm.
module App.Matching exposing (
  describe,
  area,
  flags,
  pairs,
  lists,
  rests,
  prefixes,
  asserted,
  everything,
)

type Shape =
  | Circle Float
  | Rect Float Float
  | Empty

describe : Option Float -> String
let describe value =
  match value with
  | Some 0 -> "zero"
  | Some _ -> "number"
  | None -> "nothing"

area : Shape -> Float
let area shape =
  match shape with
  | Circle r -> r * r * 3
  | Rect w h when w == h -> w * w
  | Rect w h -> w * h
  | Empty -> 0

flags : (Bool, Bool) -> Float
let flags pair =
  match pair with
  | (true, true) -> 3
  | (true, false) | (false, true) -> 1
  | (false, false) -> 0

pairs : Result String (Option Float) -> Float
let pairs value =
  match value with
  | Ok (Some n) -> n
  | Ok None -> 0
  | Err _ -> -1

lists : List Float -> Float
let lists items =
  match items with
  | [] -> 0
  | [x] -> x
  | [x, y] -> x + y
  | _ -> -1

rests : List Float -> Float
let rec rests items =
  match items with
  | [] -> 0
  | [x, ...rest] -> x + rests rest

prefixes : List Float -> Float
let prefixes items =
  match items with
  | [a] -> a
  | [a, b, ..._] -> a + b
  | [] -> 0

asserted : List Int -> Int
let asserted items =
  let assert [x, ...rest] = items as "no items"
  x + List.length rest

everything : List Float -> List Float
let everything items =
  let [...all] = items
  all

labels : { label : String; size : Float } -> String
let labels value =
  match value with
  | { label = "big" } -> "big"
  | { size = 0 } -> "empty"
  | _ -> "other"

unit : Unit -> Float
let unit () = 0
