// Exhaustive `match`: every value of the scrutinee has an arm.
module App.Matching exposing (describe, area, flags, pairs, lists)

type Shape =
  | Circle Number
  | Rect Number Number
  | Empty

describe : Option Number -> String
let describe value =
  match value with
  | Some 0 -> "zero"
  | Some _ -> "number"
  | None -> "nothing"

area : Shape -> Number
let area shape =
  match shape with
  | Circle r -> r * r * 3
  | Rect w h when w == h -> w * w
  | Rect w h -> w * h
  | Empty -> 0

flags : (Bool, Bool) -> Number
let flags pair =
  match pair with
  | (true, true) -> 3
  | (true, false) | (false, true) -> 1
  | (false, false) -> 0

pairs : Result String (Option Number) -> Number
let pairs value =
  match value with
  | Ok (Some n) -> n
  | Ok None -> 0
  | Err _ -> -1

lists : List Number -> Number
let lists items =
  match items with
  | [] -> 0
  | [x] -> x
  | [x, y] -> x + y
  | _ -> -1

labels : { label : String; size : Number } -> String
let labels value =
  match value with
  | { label = "big" } -> "big"
  | { size = 0 } -> "empty"
  | _ -> "other"

unit : Unit -> Number
let unit () = 0
