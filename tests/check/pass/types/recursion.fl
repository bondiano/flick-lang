// Recursion is explicit; polymorphic recursion needs a full `forall`.
module App.Recursion exposing (depth, countdown, is_even, sum, even_len, first_even, nested_depth)

type Nested a = Flat a | Nest (Nested (List a))

depth : forall a. Nested a -> Float
let rec depth value =
  match value with
  | Flat _ -> 0
  | Nest inner -> 1 + depth inner

countdown : Float -> List Float
let rec countdown n = if n <= 0 then [] else [n] ++ countdown (n - 1)

rec {
  is_even : Float -> Bool
  let is_even n = if n == 0 then true else is_odd (n - 1)

  is_odd : Float -> Bool
  let is_odd n = if n == 0 then false else is_even (n - 1)
}

// the members of a group use each other at their own types, whatever the
// names of their variables
rec {
  even_len : List a -> Bool
  let even_len xs =
    match xs with
    | [] -> true
    | [_, ...rest] -> odd_len rest

  odd_len : List b -> Bool
  let odd_len xs =
    match xs with
    | [] -> false
    | [_, ...rest] -> even_len rest
}

rec {
  first_even : (a -> Bool) -> List a -> Option a
  let first_even p xs =
    match xs with
    | [] -> None
    | [x, ...rest] -> if p x then Some x else first_odd p rest

  first_odd : (a -> Bool) -> List a -> Option a
  let first_odd p xs =
    match xs with
    | [] -> None
    | [_, ...rest] -> first_even p rest
}

sum : List Float -> Float
let sum items =
  go : List Float -> Float -> Float
  let rec go rest acc =
    match rest with
    | [] -> acc
    | [x] -> acc + x
    | _ -> acc
  go items 0

// a local function under a full `forall` uses itself at its own scheme,
// which holds no captures of the function it is in (found by the model properties)
nested_depth : Nested Float -> Float
let nested_depth value =
  go : forall a. Nested a -> Float -> Float
  let rec go v acc =
    match v with
    | Flat _ -> acc
    | Nest inner -> go inner (acc + 1)
  go value 0
