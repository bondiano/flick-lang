// Lazy views are pure, use Eq or a custom comparator, and keep every
// capture of the comparator, view and retained model. A renderer changes
// the host, not the services or supervision of event tasks.
module App.Lazy exposing (..)

type Count = Count Number
  deriving Eq

count_view : Count -> Ui none none
let count_view (Count n) = Ui.text (show n)

derived : Ui none none
let derived = Ui.lazy_view count_view (Count 1)

pair_view : (Number, String) -> Ui none none
let pair_view (n, label) = Ui.text (label ++ show n)

structural : Ui none none
let structural = Ui.lazy_view pair_view (1, "count ")

type alias Formatted = { value : Number; format : Number -> String }

formatted_view : Formatted -> Ui none none
let formatted_view m = Ui.text (m.format m.value)

same_formatted : Formatted -> Formatted -> Bool
let same_formatted a b = a.format a.value == b.format b.value

// Functions have no Eq; a comparator can compare exactly what is rendered.
custom : Ui none none
let custom =
  Ui.lazy_view_with same_formatted formatted_view { value = 2; format = show }

generic :
  forall c r e m.
  Eq m => (m -> (Ui r e)^c)^c -> m^c -> (Ui r e)^c
let generic view model = Ui.lazy_view view model

file_equal : forall s. File.File s -> (Unit -> (Unit -> Bool)^{s})^{s}
let file_equal file _ _ =
  ignore file
  true

retained_comparator : forall s. File.File s -> (Ui none none)^{s}
let retained_comparator file =
  Ui.lazy_view_with (file_equal file) (fun _ -> Ui.empty) ()

retained_model : forall s. File.File s -> (Ui none none)^{s}
let retained_model file =
  Ui.lazy_view_with (fun _ _ -> false) (fun _ -> Ui.empty) file

file_view : forall s. File.File s -> Unit -> (Ui {File.FileSystem} {File.ReadError})^{s}
let file_view file _ =
  Ui.button
    {
      disabled = false;
      on_click = Ui.Event.exhaust (fun _ -> task { ignore (File.read_all file) });
    }
    [Ui.text "read"]

retained_view : forall s. File.File s -> (Ui {File.FileSystem} {File.ReadError})^{s}
let retained_view file = Ui.lazy_view (file_view file) ()

type error SaveError = SaveError String

service Users =
  save : String ->{; SaveError} Unit

save_view : String -> Ui {Users} {SaveError}
let save_view label =
  Ui.button
    {
      disabled = false;
      on_click = Ui.Event.exhaust (fun _ -> task { Users.save label });
    }
    [Ui.text label]

run_serviced : Ui.Renderer -> Ref String ->{Users; none} Never
let run_serviced renderer model =
  Ui.run_with renderer (fun _ -> ()) model (Ui.lazy_view save_view)

run_captured : forall s. Ui.Renderer -> File.File s -> Ref Unit ->{File.FileSystem; none} Never
let run_captured renderer file model =
  Ui.run_with renderer (fun _ -> ()) model (fun value -> Ui.lazy_view (file_view file) value)
