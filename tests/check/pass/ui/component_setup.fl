// A component's `setup` runs once per instance: it makes the instance's own
// state and actions, which every render reads, and may call helpers that
// need `Setup s` too.
module App.ComponentSetup exposing (..)

counted : Float ->{Setup s;} (Atom.Writable Float)^{s}
let counted start = Atom.local (start + 1)

component counter (start : Float) =
  let count = counted start
  let bump = Action.exhaust (fun _ -> task { Atom.update count (fun n -> n + 1) })
  ui { button { on_click = bump; disabled = false } [text (show (Atom.value count))] }

type alias Labelled = { label : String; start : Float }

// the props are the first ones in `setup`, the current ones in `render`
component labelled (props : Labelled) =
  let count = Atom.local props.start
  ui { paragraph [text (props.label ++ show (Atom.value count))] }

query : Atom.Writable String
let query = Atom.make ""

// work of the instance while it is mounted: once, and whenever `query` changes
component search () =
  let found = Atom.local 0
  let _mounted = Ui.on_mount (task { Atom.set found 0 })
  let _watched =
    Ui.watch (fun () -> Atom.value query) (fun q -> task { Atom.set found (String.length q) })
  ui { text (show (Atom.value found)) }

// an outside source: a timer the instance starts once it mounts and stops
// when it unmounts
component clock () =
  let seconds = Atom.local 0
  let second = Result.with_default Duration.zero (Duration.seconds 1)
  let _ticking =
    Ui.on_mount
      (task {
        Effect.forever
          (task {
            Effect.sleep second
            Atom.update seconds (fun n -> n + 1)
          })
      })
  ui { text (show (Atom.value seconds)) }
