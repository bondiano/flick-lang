module App.Components exposing (..)

type alias Props = { label : String }

type alias Badge = Ui.Component Props

render : Badge -> Props -> Ui
let render badge props = ui {
  let local = badge
  let widgets = { badge = local }
  let preserved : Badge = local
  fragment [
    local props,
    widgets.badge props,
    (if props.label == "" then badge else preserved) props,
    ({ label = "piped" } |> local),
    Ui.component preserved props,
    (fun (p : Props) -> local p) props,
  ]
}

choose : Badge -> Unit -> Badge
let choose badge () = badge

returned : Badge -> Props -> Ui
let returned badge props = ui { choose badge () props }

outside : Badge -> Props -> Ui
let outside badge props = Ui.component badge props
