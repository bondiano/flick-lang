// Views on atoms through a renderer of the program's own: no React DOM.
module App.Views exposing (..)

count : Atom.Writable Float
let count = Atom.make 1

count_view : Ui.View Unit
let count_view = Ui.view (fun () -> Ui.text ("count " ++ show (Atom.value count)))

app : Ui
let app = Ui.render count_view ()

run : Ui.Renderer ->{Async, Atom.Registry, Atom.Write; none} Never
let run renderer = Ui.mount_with renderer (fun _ -> ()) app
