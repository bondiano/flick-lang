// A query whose loaded value a server hands to the client: its key is the
// binding's name, as for any serializable task.
module App.Orders exposing (..)

count : Atom.Atom (Atom.Async Float none)
let count = Atom.serializable_task (Codec.json Schema.number) (Atom.query ["orders"] (task { 3 }))

add : Float ->{Atom.Write} Unit
let add = Atom.mutation ["orders"] (fun (_n : Float) -> ())
