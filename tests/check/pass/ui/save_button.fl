// The two forms of `save_button`: the `Ui` functions and the `ui { … }`
// block, which only opens the names of `Ui`. Then the two ways a handler may
// use a scoped file: open it inside the task, or keep the UI in the scope.
module App.SaveButton exposing (..)

type error SaveError = SaveError String

service Users =
  save : String ->{; SaveError} Unit

type alias SaveButtonProps c =
  {
    label : String;
    disabled : Bool;
    on_save : (Unit ->{Users; SaveError} Unit)^c;
  }

save_button : SaveButtonProps c -> (Ui {Users} {SaveError})^c
let save_button props =
  Ui.button
    {
      disabled = props.disabled;
      on_click = Ui.Event.exhaust (fun _ ->
        task { props.on_save () }
      );
    }
    [Ui.text props.label]

save_button_ui : SaveButtonProps c -> (Ui {Users} {SaveError})^c
let save_button_ui props =
  ui {
    button
      {
        disabled = props.disabled;
        on_click = Ui.Event.exhaust (fun _ ->
          task { props.on_save () }
        );
      }
      [text props.label]
  }

type alias User = { id : Number; name : String }

users : Ui.SelectProps User {Users} {SaveError} c -> (Ui {Users} {SaveError})^c
let users props = Ui.select props

reader : File.Path -> Ui {File.FileSystem} {File.OpenError, File.ReadError}
let reader path =
  ui {
    button
      {
        disabled = false;
        on_click = Ui.Event.exhaust (fun _ -> task {
          scope { ignore (File.read_all (File.open_scoped path)) }
        });
      }
      [text "read"]
  }

held_in_scope : File.Path ->{File.FileSystem; File.OpenError} Number
let held_in_scope path =
  scope {
    let file = File.open_scoped path
    let view =
      ui {
        button
          {
            disabled = false;
            on_click = Ui.Event.exhaust (fun _ -> task { ignore (File.read_all file) });
          }
          [text "read"]
      }
    List.length [view, view]
  }
