// The two forms of `save_button`: the `Ui` functions and the `ui { … }`
// block, which only opens the names of `Ui`. A handler writes atoms and
// nothing else, so `save` provides `Users` and handles `SaveError` itself.
// Then the two ways a handler may use a scoped file: open it inside the
// task, or keep the UI in the scope.
module App.SaveButton exposing (..)

type error SaveError = SaveError String

service Users =
  save : String ->{; SaveError} Unit

type alias SaveButtonProps c =
  {
    label : String;
    disabled : Bool;
    on_save : (Unit ->{Atom.Write;} Unit)^c;
  }

failure : Atom.Writable (Option String)
let failure = Atom.make None

save : Layer none none {Users} -> String -> Unit ->{Atom.Write;} Unit
let save users name () =
  provide users {
    try Users.save name with
    | SaveError reason -> Atom.set failure (Some reason)
  }

save_button : SaveButtonProps c -> Ui^c
let save_button props =
  Ui.button
    {
      disabled = props.disabled;
      on_click = Ui.Event.exhaust (fun _ ->
        task { props.on_save () }
      );
    }
    [Ui.text props.label]

save_button_ui : SaveButtonProps c -> Ui^c
let save_button_ui props =
  ui {
    button
      {
        disabled = props.disabled;
        on_click = Ui.Event.exhaust (fun _ ->
          task { props.on_save () }
        );
      }
      [text props.label]
  }

type alias User = { id : Number; name : String }

users : Ui.SelectProps User c -> Ui^c
let users props = Ui.select props

reader : File.Path -> Ui
let reader path =
  ui {
    button
      {
        disabled = false;
        on_click = Ui.Event.exhaust (fun _ -> task {
          provide File.node {
            try scope { ignore (File.read_all (File.open_scoped path)) } with
            | _ -> ()
          }
        });
      }
      [text "read"]
  }

held_in_scope : File.Path ->{File.FileSystem; File.OpenError} Number
let held_in_scope path =
  scope {
    let file = File.open_scoped path
    let view =
      ui {
        button
          {
            disabled = false;
            on_click = Ui.Event.exhaust (fun _ -> task {
              provide File.node {
                try ignore (File.read_all file) with
                | _ -> ()
              }
            });
          }
          [text "read"]
      }
    List.length [view, view]
  }
