// Expression holes capture one argument of an application as `fun h -> ...`.
module App.Holes exposing (..)

type alias Path = String

type File (s : Region)

type error OpenError = OpenError Path

type error ReadError = ReadError Path

service FileSystem =
  open_scoped : forall s. Path ->{Scope s; OpenError} File s
  read_with : forall s. String -> File s ->{; ReadError} String

label : String -> String -> String -> String
let label open mid close = open ++ mid ++ close

full_name : String -> String -> String
let full_name last_name first_name = last_name |> (String.join _ [first_name])

wrapped : String -> String
let wrapped name = name |> label "[" _ "]"

wrapped_right : String -> String
let wrapped_right name = label "[" _ "]" <| name

plain : String -> String
let plain name = name |> label "[" "]" _

direct : String -> String
let direct name = label "[" name "]"

partial : String -> String -> String
let partial = label "[" _

single : a -> a
let single = identity _

wrap_some : a -> Option a
let wrap_some = Some _

mapped : List String -> List String
let mapped names = List.map (label "[" _ "]") names

apply_twice : (Int -> Int) -> Int -> Int
let apply_twice f x = f (f x)

add : Int -> Int -> Int
let add a b = a + b

nested : Int -> Int
let nested = apply_twice (add 1 _) _

composed : String -> String
let composed = label "[" _ "]" >> label "(" _ ")"

apply_runtime : (String ->{} String) -> String ->{} String
let apply_runtime f s = f s

lifted_outer : String ->{} String
let lifted_outer s = apply_runtime (label "[" _ "]") s

make_adder : Int -> Int -> Int
let make_adder a b = a + b

lifted_inner : Int -> Int ->{} Int
let lifted_inner = make_adder _

scoped_pipe : Path ->{FileSystem; OpenError, ReadError} String
let scoped_pipe path = scope {
  let file = FileSystem.open_scoped path
  file |> FileSystem.read_with "hdr" _
}

keep_wildcards : Option Int -> Int
let keep_wildcards item =
  let _ = 1
  ignore_arg : Int -> Int
  let ignore_arg = fun _ -> 2
  let value = ignore_arg 0
  match item with
  | Some n -> n + value
  | _ -> value
