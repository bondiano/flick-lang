// `Live s` gives no owner to acquire into: a parameter of region `s` keeps
// `s` live in the signature's row, which still lacks `Scope s`.
module App.Acquire exposing (..)

type File (s : Region)

service Files =
  open_scoped : forall s. String ->{Scope s} File s

reopened : File s ->{Files} File s
let reopened _ = Files.open_scoped "again"
//~ FLICK-G004 @11:18-11:43 which needs `Scope`
