// A lazy `for` that reads atoms reads them through the reader of the
// function that builds it, when it is iterated: the sequence cannot leave
// that function, by its result, a closure or an atom.
module App.Reader exposing (..)

count : Atom.Writable Number
let count = Atom.make 7

leaked : Atom.Atom (Seq Number)
let leaked = Atom.derived (fun () -> for n <- [1] yield Atom.value count + n)

signed : Unit ->{Atom.Read;} Seq Number
let signed () = for n <- [1] yield Atom.value count + n

held : Atom.Atom (Unit -> List Number)
let held =
  Atom.derived (fun () ->
    let xs = for n <- [1] yield Atom.value count + n
    fun () -> Seq.to_list xs)

//~ FLICK-G001 @10:38-10:77 holds the reader of a lazy `for`
//~ FLICK-G001 @13:17-13:56 holds the reader of a lazy `for`
//~ FLICK-G002 @19:5-19:29 cannot leave the function whose atoms it reads
