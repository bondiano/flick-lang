// Every way a scoped resource could outlive its scope: the result, a
// callback, a task, a container, a wrapper, an outer cell and an error.
module App.Escape exposing (..)

type alias Path = String

type File (s : Region)

type Wrapper s = Wrapper (File s)

opaque type Sealed s = Sealed (File s)

type error OpenError = OpenError Path

type error ReadError = ReadError Path

type error Wrapped a = Wrapped a

service FileSystem =
  open_scoped : forall s. Path ->{Scope s; OpenError} File s
  read_all : forall s. File s ->{; ReadError} String

bad_deferred : Path ->{FileSystem; OpenError} Eff {FileSystem} {ReadError} String
let bad_deferred path = scope {
  let file = FileSystem.open_scoped path
  task { FileSystem.read_all file }
}

bad_callback : Path ->{FileSystem; OpenError} (Unit ->{FileSystem; ReadError} String)
let bad_callback path = scope {
  let file = FileSystem.open_scoped path
  fun () -> FileSystem.read_all file
}

result : Path ->{FileSystem; OpenError} Unit
let result path =
  let file = scope { FileSystem.open_scoped path }
  ()

container : Path ->{FileSystem; OpenError} List (Unit ->{FileSystem; ReadError} String)
let container path = scope {
  let file = FileSystem.open_scoped path
  [fun () -> FileSystem.read_all file]
}

in_record : Path ->{FileSystem; OpenError} Unit
let in_record path =
  let record = scope {
    let file = FileSystem.open_scoped path
    read : Unit ->{FileSystem; ReadError} String
    let read () = FileSystem.read_all file
    { read = read }
  }
  ()

wrapper : Path ->{FileSystem; OpenError} Unit
let wrapper path =
  let wrapped = scope { Wrapper (FileSystem.open_scoped path) }
  ()

sealed : Path ->{FileSystem; OpenError} Unit
let sealed path =
  let hidden = scope { Sealed (FileSystem.open_scoped path) }
  ()

outer_cell : Path ->{FileSystem; OpenError} Unit
let outer_cell path =
  let cell = Ref.make None
  scope {
    let file = FileSystem.open_scoped path
    Ref.set cell (Some file)
  }

outer_callback : Path ->{FileSystem; OpenError} Unit
let outer_callback path =
  let cell = Ref.make (task { "" })
  scope {
    let file = FileSystem.open_scoped path
    Ref.set cell (task { FileSystem.read_all file })
  }

raised : Path ->{FileSystem; OpenError} String
let raised path = scope {
  let file = FileSystem.open_scoped path
  try from_result (Err (Wrapped file)) with
  | Wrapped _ -> "caught"
}

map_effect : forall c a b r e. (a ->{r; e} b)^c -> (List a ->{r; e} List b)^c
foreign map_effect from "./list.js" "mapEffect"
  retention call

partial : Path ->{FileSystem; OpenError} Unit
let partial path =
  let run = scope {
    let file = FileSystem.open_scoped path
    { go = map_effect (fun n -> FileSystem.read_all file) }
  }
  ()

no_owner : Path ->{FileSystem; OpenError} Unit
let no_owner path = ignore (FileSystem.open_scoped path)

// a cell made empty in a scope and written there still cannot leave it
empty_cell_out : Path ->{FileSystem; OpenError} Unit
let empty_cell_out path =
  let out = scope inner {
    let cell = Ref.make None
    Ref.set cell (Some (FileSystem.open_scoped path))
    cell
  }
  ignore out
