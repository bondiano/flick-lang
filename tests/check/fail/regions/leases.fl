// The value of a `ScopedRef` lives only inside `use`: it cannot be given
// back, kept in a closure or stored by the acquisition in an outer cell.
module App.Leases exposing (..)

type Raw

make_conn : String ->{} Raw
foreign effect make_conn from "./conn.js" "make"

close_conn : Raw^c ->{} Unit
foreign effect close_conn from "./conn.js" "close"
  retention call

conn : String ->{Scope s} Raw^{s}
let conn name = Resource.acquire_release (task { make_conn name }) close_conn

returned : Unit ->{} Unit
let returned () = scope {
  let r = ScopedRef.from_acquire (task { conn "a" })
  let leaked = ScopedRef.use r (fun c -> c)
  ()
}

kept : Unit ->{} Unit
let kept () = scope {
  let r = ScopedRef.from_acquire (task { conn "a" })
  later : Unit ->{} Unit
  let later = ScopedRef.use r (fun c -> fun () -> close_conn c)
  ()
}

stashed : Unit ->{} Unit
let stashed () = scope {
  let cell = Ref.make None
  let r =
    ScopedRef.from_acquire
      (task {
        let c = conn "a"
        Ref.set cell (Some c)
        c
      })
  ()
}
