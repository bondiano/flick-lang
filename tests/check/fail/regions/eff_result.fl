// A task holds what its result holds, as a function does: a region shown
// only in its result or its row does not hide the handle it captured, so
// the task cannot pass where that region is not allowed.
module App.EffResult exposing (..)

type Handle (s : Region)

service Files =
  open : forall s. String ->{Scope s} Handle s
  touch : forall s. Handle s ->{} Unit

report : Failure none ->{} Unit
let report _ = ()

forget_result : Eff {Files} none (Handle s) -> Eff {Files} none Unit
let forget_result t = task { ignore (await t) }

spawned : Unit ->{Files} Unit
let spawned () = scope outer {
  scope inner {
    let h = Files.open "inner"
    let t : Eff {Files} none (Handle inner) = task {
      Files.touch h
      h
    }
    ignore (Fiber.spawn outer report t)
  }
}

stored : Unit ->{Files} Unit
let stored () =
  let cell = Ref.make (task { () })
  scope inner {
    let h = Files.open "inner"
    let t : Eff {Files} none (Handle inner) = task {
      Files.touch h
      h
    }
    Ref.set cell (task { ignore (await t) })
  }

in_row : Unit ->{Files} Unit
let in_row () = scope outer {
  scope inner {
    let h = Files.open "inner"
    let t : Eff {Files, Scope inner} none Unit = task { Files.touch h }
    ignore (Fiber.spawn outer report t)
  }
}
