// A stream over a file may leave the file's `scope`, but running it there
// needs the file's region live: its qualifier `^{s}` is what using it
// needs (`../../pass/regions/stream_of_param.fl`).
module App.StreamLate exposing (..)

type File (s : Region)

type error ReadError = ReadError String

service Files =
  open_scoped : forall s. String ->{Scope s} File s
  read : forall s. File s ->{; ReadError} String

lines : File s -> (Stream.Stream {Files} {ReadError} String)^{s}
let lines file = Stream.map_effect (fun _ -> Files.read file) (Stream.from_list [1])

late : String ->{Files; ReadError} List String
let late path =
  let stream = scope { lines (Files.open_scoped path) }
  Stream.run_collect stream
//~ FLICK-G002 @19:24-19:54 region `s` ends with its `scope`, so the value cannot leave it
//~ FLICK-G002 @20:22-20:28 this value holds region `s`
