// A closure compared late still holds what it uses: a scoped file is no
// capture a position without captures allows.
module App.LateCaptures exposing (..)

type alias Path = String

type File (s : Region)

type error OpenError = OpenError Path

service FileSystem =
  open_scoped : forall s. Path ->{Scope s; OpenError} File s

type alias Batch o = { flush : List o ->{} Unit }

take : Batch String -> Unit
let take _ = ()

held : Path ->{FileSystem; OpenError} Unit
let held path =
  scope {
    let file = FileSystem.open_scoped path
    let seen = Ref.make []
    let collect = { flush = fun outputs -> ignore (file, Ref.set seen (Ref.get seen ++ outputs)) }
    take collect
  }
//~ FLICK-G001 @25:10-25:17 this value holds region `s`, but the expected type `Batch String` holds no captures
