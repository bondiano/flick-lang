// `Scope.current` gives the owner around as any region: with it, work could stay
// under an owner longer than the region the type of that owner names. It is the
// compiler's, for the outer owner of a `scope`.
module App.ForgedOwner exposing (..)

forged : forall o s. Fiber.Owner o ->{Scope o;} Fiber.Owner s
let forged _ = Scope.current ()
//~ FLICK-T001 @7:16-7:29 `Scope` does not export `current`
