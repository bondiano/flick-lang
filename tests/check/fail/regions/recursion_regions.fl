// A recursive use takes the regions of the signature, so callbacks passed
// on in the other order hold what the other position does not allow.
module App.RecursionRegionsSwapped exposing (..)

braced : (Float -> Float)^{c} -> (Float -> Float)^{d} -> Float -> Float
let rec braced f g n = if n <= 0 then 0 else f n + braced g f (n - 1)

bare : (Float -> Float)^c -> (Float -> Float)^d -> Float -> Float
let rec bare f g n = if n <= 0 then 0 else f n + bare g f (n - 1)

effects : (Float ->{Async} Float)^{c} -> (Float ->{Async} Float)^{d} -> Float ->{Async} Float
let rec effects f g n = if n <= 0 then 0 else f n + effects g f (n - 1)

// a local `let rec` too
local : (Float -> Float)^{c} -> (Float -> Float)^{d} -> Float
let local f g =
  go : (Float -> Float)^{e} -> (Float -> Float)^{h} -> Float -> Float
  let rec go a b n = if n <= 0 then 0 else a n + go b a (n - 1)
  go f g 3
