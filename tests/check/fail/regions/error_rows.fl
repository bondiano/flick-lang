// An error holds what its errors hold, and an error-row variable what the
// errors it stands for hold: a value that keeps one shows it.
module App.ErrorRows exposing (..)

type alias Path = String

type File (s : Region)

type error OpenError = OpenError Path

type error Wrapped a = Wrapped a

service FileSystem =
  open_scoped : forall s. Path ->{Scope s; OpenError} File s

// a field is no curried stage: its bare type allows no captures
keep_field : forall e. Errors e -> { run : Unit -> Unit }
let keep_field x = { run = fun () -> ignore x }

// an argument of kind `ErrorRow` counts as `Errors` does
keep_exit : forall e. Exit e Int -> { run : Unit -> Unit }
let keep_exit x = { run = fun () -> ignore x }

keep : forall e. Errors e -> (Unit -> Unit)
let keep x = fun () -> ignore x

hide : forall s. File s ->{} (Unit -> Unit)
let hide file =
  try from_result (Err (Wrapped file)) with
  | err -> keep err

// the closure `hide` returns shows the region of the file
leak : Path ->{FileSystem; OpenError} (Unit -> Unit)
let leak path = scope {
  let file = FileSystem.open_scoped path
  hide file
}

