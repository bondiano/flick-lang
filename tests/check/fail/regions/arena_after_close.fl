// A read, unlike mere retention, requires the arena's region live.
module App.ArenaAfterClose exposing (..)

import Arena

after_close : Unit ->{} String
let after_close () =
  let view = scope {
    let arena = Arena.make ()
    Arena.alloc arena "closed"
  }
  Arena.get view
