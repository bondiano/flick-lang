// Work `Ui.on_mount` starts runs from the instance's mount to its unmount,
// so what it uses must outlive the instance's region: here it uses a
// subscription of a `scope` inside the setup, which ends first. Both
// disciplines ask it of `Ui.on_mount` and `Ui.watch` (`Fiber.Outlives`).
module App.SetupScope exposing (..)

component feed (hub : PubSub.PubSub Float) =
  let _mounted = scope inner {
    let sub = PubSub.subscribe hub
    Ui.on_mount (task { ignore (PubSub.take sub) })
  }
  ui { text "feed" }
//~ FLICK-G003 @10:5-10:16 the child holds region `inner`
