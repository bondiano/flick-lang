// A child always has a supervisor: without one, `Fiber.spawn` does not
// take the task where the supervisor goes.
module App.Spawn exposing (..)

lost : Unit ->{} Unit
let lost () = scope owner {
  ignore (Fiber.spawn owner Effect.void)
  //~ FLICK-T003 @7:29-7:40 expected `Failure _ ->{Scope owner | _; none} Unit`
}
