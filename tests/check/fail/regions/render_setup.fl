// A render that makes an atom without `Setup` is `FLICK-U004` alone: the
// region of the atom, never known, is no region its view keeps live.
module App.RenderSetup exposing (..)

component again (n : Float) = ui {
  let made = Atom.local n
  text (show (Atom.value made))
}
//~ FLICK-U004 @6:14-6:26 service `Setup _` is not allowed here
