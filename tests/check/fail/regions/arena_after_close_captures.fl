// Using an arena or view after its region closes is rejected across closures,
// tasks, persistent Contexts (`FLICK-G002`), and outer-owner children (`FLICK-G003`).
module App.ArenaAfterCloseCaptures exposing (..)

import Arena

service Reader =
  read : Unit ->{} String

closure_read_after_close : Unit ->{} (Unit ->{} String)
let closure_read_after_close () = scope {
  let arena = Arena.make ()
  let view = Arena.alloc arena "closed"
  fun () -> Arena.get view
}

task_alloc_after_close : Unit ->{} Eff {} none Unit
let task_alloc_after_close () = scope {
  let arena = Arena.make ()
  task { ignore (Arena.alloc arena "late") }
}

context_read_after_close : Unit ->{} Context.Context {Reader}
let context_read_after_close () = scope {
  let arena = Arena.make ()
  let view = Arena.alloc arena "ctx-closed"
  Context.make Reader { read = fun () -> Arena.get view }
}

outer_owner_reads_inner_arena : Unit ->{} Unit
let outer_owner_reads_inner_arena () = scope outer {
  scope inner {
    let arena = Arena.make ()
    let view = Arena.alloc arena "inner"
    ignore (Fiber.spawn outer (fun _ -> ()) (task { ignore (Arena.get view) }))
  }
}
