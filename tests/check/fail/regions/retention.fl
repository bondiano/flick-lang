// A finalizer, a release, a listener and a background channel keep what
// they hold until their owner closes: each requires `Fiber.Outlives`, and
// work holding a shorter region cannot be registered with a longer owner.
module App.Retention exposing (..)

type Raw

make_conn : String ->{} Raw
foreign effect make_conn from "./conn.js" "make"

report : Failure e ->{} Unit
let report _ = ()

finalizer : forall s c. Fiber.Owner s -> (Eff none none Unit)^c ->{Scope s;} Unit
let finalizer _ w = Scope.add_finalizer w

finalizer_exit : forall s c. Fiber.Owner s -> (Option RawCause ->{} Unit)^c ->{Scope s;} Unit
let finalizer_exit _ w = Scope.add_finalizer_exit w

effect_finalizer : forall s c. Fiber.Owner s -> (Option RawCause ->{} Unit)^c ->{Scope s;} Unit
let effect_finalizer _ w = Effect.add_finalizer w

release : forall s c. Fiber.Owner s -> (Raw ->{} Unit)^c ->{Scope s;} Unit
let release _ r = ignore (Resource.acquire_release (task { make_conn "x" }) r)

channel_queue :
  forall s c. Fiber.Owner s ->
    (Channel.Channel none none Unit Float Unit none Unit)^c ->{Scope s;}
    Unit
let channel_queue _ ch = ignore (Channel.to_queue { capacity = None; strategy = None } ch)

listener : forall s c a. Fiber.Owner s -> (a -> Eff none none Unit)^c ->{} Events.Listener s a
let listener owner h = Events.listen owner (Events.queue 8) report h

managed : forall s c. Fiber.Owner s -> (Eff none none Float)^c ->{Scope s;} Unit
let managed _ t = ignore (Resource.manual t)
