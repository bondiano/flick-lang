// A local function whose closure uses a region its signature does not keep
// live: the use of `h` needs `s`, which `Unit ->{} Unit` does not keep.
module App.StageQualifier exposing (..)

type Handle (s : Region) = Handle

use_it : Handle s ->{} Unit
let use_it _ = ()

local : Handle s ->{} Unit
let local h =
  wrap : forall a. a -> (Unit ->{} Unit)
  let wrap _ = fun () -> use_it h
  (wrap 1) ()
//~ FLICK-G002 @13:26-13:34 this uses `s`, which the expected type `Unit ->{} Unit` does not keep live
