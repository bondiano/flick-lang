// A cell made from a value without captures still takes a later write
// that holds one; what the cell then holds cannot leave in a task that
// allows no captures.
module App.RefCapacity exposing (..)

unsafe : forall a. a -> a^{} -> a ->{} (Eff none none Unit)^{}
let unsafe exemplar empty full =
  ignore exemplar
  let ref = Ref.make empty
  Ref.set ref full
  task { ignore (Ref.get ref) }
//~ FLICK-G001 @11:3-11:32 this task uses `ref`, which holds `a`, but the expected type
