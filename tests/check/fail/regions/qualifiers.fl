// A capture qualifier is an upper bound: a narrower one than what the value
// holds is an error, mutable storage keeps its captures exactly, an error
// carries no region, and a child holds nothing shorter than its owner.
module App.Qualifiers exposing (..)

type alias Path = String

type File (s : Region)

type error OpenError = OpenError Path

type error ReadError = ReadError Path

type error Leak (s : Region) = Leak (File s)

service FileSystem =
  open_scoped : forall s. Path ->{Scope s; OpenError} File s
  read_all : forall s. File s ->{; ReadError} String

with_first :
  forall s. File s -> (Unit ->{FileSystem; ReadError} String)^{s} ->{FileSystem; ReadError} String
foreign sync with_first from "./files.js" "withFirst"
  retention call

narrow : forall s t. File s -> File t ->{FileSystem; ReadError} String
let narrow first second =
  with_first first (fun () -> FileSystem.read_all second)

forget : a -> (Unit -> Unit)^{}
let forget value = fun () -> ignore value

invariant : forall s. Ref (Unit ->{} String) -> Ref ((Unit ->{} String)^{s}) -> Unit
let invariant plain held =
  let both = [plain, held]
  ()

report : Failure {ReadError} ->{FileSystem; none} Unit
let report failure = ()

spawn_outer : Path ->{FileSystem; OpenError} Unit
let spawn_outer path =
  scope outer {
    scope inner {
      let file = FileSystem.open_scoped path
      ignore (Fiber.spawn outer report (task { FileSystem.read_all file }))
    }
  }

spawn_given :
  forall s c.
  Fiber.Owner s -> (Eff {FileSystem} {ReadError} String)^c ->{FileSystem; none} Unit
let spawn_given owner work =
  ignore (Fiber.spawn owner report work)
