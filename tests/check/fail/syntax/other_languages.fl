module App.Legacy exposing (..)

let with_do x =
  do
    y <- load x
    y

let starred x =
  let* y = load x
  y

let markup x =
  <div class="x">x</div>

let fine = 1

type Shape = Circle of Float | Empty

class Show a =
  val show : a -> String

