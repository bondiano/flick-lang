module App.Patterns exposing (..)

let f shape =
  match shape with
  | Square side | Circle radius -> side
  | Rect w w -> w
  | Pair (Some x | None) _ -> x
  | _ when -> 0

let g x x = x

let h = fun (a, a) -> a

