// The size and branching of a function past the default `[lint]` thresholds.
module App.Structure exposing (..)

deep : Number -> Number
let deep n =
  if n > 0 then
    match n with
      | 1 -> (fun x -> if x > 0 then (fun y -> if y > 0 then 1 else 2) x else 3) n
      | _ -> 4
  else if n < -10 then 5
  else 6
//~ FLICK-T037 @8:39-8:42 nested 5 levels deep, more than 4

many : Number -> Number -> Number -> Number -> Number -> Number -> Number
let many a b c d e f = a + b + c + d + e + f
//~ FLICK-T039 @15:5-15:9 `many` takes 6 parameters, more than 5

branchy : Number -> Bool -> Bool -> Number
let branchy n p q =
  if p && q || n > 1 then 1
  else if p || q then 2
  else match n with
    | 1 -> 3
    | 2 -> 4
    | 3 -> 5
    | x when x > 9 -> 6
    | _ -> if p && n > 0 then 7 else 8
//~ FLICK-T038 @19:5-19:12 `branchy` has a complexity of 13, more than 10
