// Names and arms that hide something.
module App.Scope exposing (..)

type Shape = Circle Float | Square Float | Dot

area : Shape -> Float
let area shape =
  match shape with
  | Circle r -> r * r
  | _ -> 0

total : Float -> Float
let total n =
  let m = n + 1
  f : Float -> Float
  let f = fun m -> m * 2
  let n = n + m
  let m = 2
  f (n + m)

outer : Float -> Float
let outer n =
  double : Float -> Float
  let double x =
    let twice = x * 2
    twice
  add : Float -> Float
  let add x = x + n
  add (double n)

pick : Option Float -> Float
let pick x =
  match x with
  | Some x -> x + 1
  | None -> 0
//~ FLICK-T055 @10:5-10:6 `_` stands for `Square`, `Dot` of `Shape`: a constructor added to it later lands here unchecked
//~ FLICK-R015 @18:7-18:8 `m` shadows the local `m` bound above
//~ FLICK-T054 @24:7-24:13 the local function `double` uses no local around it: it can be a top-level function
