// Names and arms that hide something.
module App.Scope exposing (..)

type Shape = Circle Number | Square Number | Dot

area : Shape -> Number
let area shape = match shape with
  | Circle r -> r * r
  | _ -> 0

total : Number -> Number
let total n =
  let m = n + 1
  f : Number -> Number
  let f = fun m -> m * 2
  let n = n + m
  let m = 2
  f (n + m)

outer : Number -> Number
let outer n =
  double : Number -> Number
  let double x =
    let twice = x * 2
    twice
  add : Number -> Number
  let add x = x + n
  add (double n)

pick : Option Number -> Number
let pick x = match x with
  | Some x -> x + 1
  | None -> 0
//~ FLICK-T055 @9:5-9:6 `_` stands for `Square`, `Dot` of `Shape`: a constructor added to it later lands here unchecked
//~ FLICK-R015 @17:7-17:8 `m` shadows the local `m` bound above
//~ FLICK-T054 @23:7-23:13 the local function `double` uses no local around it: it can be a top-level function
