// List and option code a library function says directly.
module App.Collections exposing (..)

first : List Float -> Option Float
let first xs = xs |> List.filter (fun x -> x > 1) |> List.head

some : List Float -> Bool
let some xs = List.length (List.filter (fun x -> x > 1) xs) > 0

none : List Float -> Bool
let none xs = List.length xs == 0

pairs : List Float -> List Float
let pairs xs = List.concat (List.map (fun x -> [x, x]) xs)

count : Option Float -> Float
let count o = match o with
  | Some n -> n
  | None -> 0

kept : List Float -> Bool
let kept xs = List.length xs == 2
