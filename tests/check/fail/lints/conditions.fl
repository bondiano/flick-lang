// Conditions with a shorter form, each with its rewrite.
module App.Conditions exposing (..)

same : Number -> Number -> Bool
let same a b = if a == b then true else false

differ : Bool -> Bool
let differ c = if c then false else true

label : Bool -> String
let label done = if not done then "pending" else "done"

sign : Number -> String
let sign n =
  if n > 0 then "+"
  else
    if n < 0 then "-" else "0"

zero : Number -> Bool
let zero n = 0 == n

smaller : Number -> Bool
let smaller n = 10 > n

itself : Number -> Bool
let itself x = x == x

debug : Number
let debug = if true then 1 else 2

flag : Bool -> Number
let flag b = match b with
  | true -> 1
  | false -> 2

quiet : Number -> Number
let quiet n = if n > 1 then n else 0
