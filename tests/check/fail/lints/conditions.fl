// Conditions with a shorter form, each with its rewrite.
module App.Conditions exposing (..)

same : Float -> Float -> Bool
let same a b = if a == b then true else false

differ : Bool -> Bool
let differ c = if c then false else true

label : Bool -> String
let label done = if not done then "pending" else "done"

sign : Float -> String
let sign n =
  if n > 0 then
    "+"
  else
    if n < 0 then "-" else "0"

zero : Float -> Bool
let zero n = 0 == n

smaller : Float -> Bool
let smaller n = 10 > n

itself : Float -> Bool
let itself x = x == x

debug : Float
let debug = if true then 1 else 2

flag : Bool -> Float
let flag b =
  match b with
  | true -> 1
  | false -> 2

quiet : Float -> Float
let quiet n = if n > 1 then n else 0
//~ FLICK-T040 @5:16-5:46 this `if` returns its condition
//~ FLICK-T040 @8:16-8:41 this `if` returns the opposite of its condition
//~ FLICK-T041 @11:21-11:29 an `if not` with an `else`: the condition without `not` reads directly
//~ FLICK-T042 @18:5-18:31 an `if` alone in an `else`: `else if` says it without nesting
//~ FLICK-T043 @21:14-21:20 the literal is on the left of `==`: the value compared reads first
//~ FLICK-T043 @24:17-24:23 the literal is on the left of `>`: the value compared reads first
//~ FLICK-T044 @27:16-27:22 `x` compared with itself is always `true`
//~ FLICK-T045 @30:16-30:20 this condition is always `true`
//~ FLICK-T046 @34:3-36:15 a `match` on a `Bool`: `if` says it directly
