// `Unit`, `Never` and the empty row are three different things, and
// diagnostics name each as written.
module App.Empty exposing (..)

type error Oops = Oops

unit_is_not_never : Unit -> Never
let unit_is_not_never () = ()

never_is_not_unit : Never -> Unit
let never_is_not_unit n = n

failing : Eff none {Oops} Float
let failing = task { 1 }

no_errors : Eff none none Float
let no_errors = failing

unit_is_not_a_row : Eff none Unit Float
let unit_is_not_a_row = task { 1 }

