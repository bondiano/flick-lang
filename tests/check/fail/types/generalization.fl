module App.Generalization exposing (..)

service Log =
  info : String ->{} Unit

invalid : Unit ->{} String
let invalid () =
  let cell = Ref.make None
  Ref.set cell (Some 42)
  match Ref.get cell with
  | Some value -> String.trim value
  | None -> ""

capture_cell : Ref (Option a) -> Eff none none (Ref (Option a))
let capture_cell cell =
  let shared = task { cell }
  let use : Eff none none (Ref (Option Float)) = shared
  shared

logged_none : Unit ->{Log; none} Option a
let logged_none () =
  Log.info "created an empty result"
  None

use_logged_none : Unit ->{Log; none} (Option Float, Option String)
let use_logged_none () =
  let empty = logged_none ()
  (empty, empty)

shared : forall a. Ref (Option a)
let shared = Ref.make None

annotated : Unit ->{} Unit
let annotated () =
  let cell : forall a. Ref (Option a) = Ref.make None
  Ref.set cell (Some 42)

expression : Unit ->{} Unit
let expression () =
  let cell = (Ref.make None : forall a. Ref (Option a))
  Ref.set cell (Some 42)

use_poly : (forall a. Ref (Option a)) ->{} Unit
let use_poly cell = Ref.set cell (Some 42)

argument : Unit ->{} Unit
let argument () = use_poly (Ref.make None)

counted : Unit ->{} Int
let counted () =
  let cell = Ref.make 0
  let n : Show Int => Int = Ref.modify cell (fun k -> (k + 1, k + 1))
  n

