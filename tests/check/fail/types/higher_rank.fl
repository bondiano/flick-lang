module App.HigherRank exposing (..)

apply_twice : (forall a. a -> a) -> (Number, String)
let apply_twice transform =
  (transform 42, transform "hello")

wrong : forall a. a -> a
let wrong x = x + 1

use_mono : Unit -> (Number, String)
let use_mono () =
  apply_twice (fun x -> x + 1)

trim_only : Unit -> (Number, String)
let trim_only () =
  apply_twice String.trim

each : (forall a. a ->{} Unit) ->{} Unit
let each log =
  log 1
  log "text"

escape : Unit ->{} Unit
let escape () =
  let cell = Ref.make None
  each (fun x -> Ref.set cell (Some x))

// The caller's effect and error rows flow through a higher-rank callback and
// are checked there; a nested `forall` without `Show` gives no dictionary.
type error Stop = Stop String

each_shown : forall r e. (forall a. Show a => a ->{r; e} Unit) ->{r; e} Unit
let each_shown log =
  log 1
  log "two"

failing : Show a => a ->{; Stop} Unit
let failing value = from_result (Err (Stop (show value)))

lost_error : Unit ->{} Unit
let lost_error () = each_shown failing

pure_only : (forall a. Show a => a ->{} Unit) ->{} Unit
let pure_only log = log 1

lost_effect : Unit ->{} Unit
let lost_effect () = pure_only failing

no_dictionary : (forall a. a -> String) -> String
let no_dictionary render = render 1

needs_show : Unit -> String
let needs_show () = no_dictionary show

