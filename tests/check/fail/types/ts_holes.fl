module App.TsHoles exposing (..)

// The Flick forms of the TypeScript holes in docs/formal/ts-holes.md.

/// A JS object as the importer gives it: an opaque type without fields.
type Handle

type alias Named = { name : String }

strict : Named -> String
let strict value = value.name

/// A lying `x is Point` comes through the importer as a plain `Bool`.
is_point : JsValue -> Bool
foreign pure is_point from "./shapes.mjs" "isPoint"

any_as_string : JsValue -> Int
let any_as_string value = String.length value

cast : Unit -> String
let cast () = (1 : String)

double_cast : String -> Float
let double_cast text = ((text : Unknown) : Float)

guard : JsValue -> String
let guard value = if is_point value then value.name else ""

run_now : (Unit -> Unit) ->{} Unit
let run_now f = f ()

pure_callback : (Unit ->{} Unit) ->{} Unit
let pure_callback = run_now

covariant_ref : Ref (Unit -> Unit) -> Ref (Unit ->{} Unit)
let covariant_ref cell = cell

width_via_variable : Unit -> String
let width_via_variable () =
  let person = { name = "a"; age = 1 }
  strict person

spread_handle : Handle -> Handle
let spread_handle handle = { handle with name = "x" }

field_of_handle : Handle -> String
let field_of_handle handle = handle.value

index_lookup : List Int -> Int
let index_lookup xs = List.get 0 xs

