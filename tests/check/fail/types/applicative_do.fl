module App.ApplicativeDo exposing (..)

lookup : Float -> Option Float
let lookup n = Some n

// the bindings of a group run independently: `x` is not in scope beside it
dependent : Option Float -> Option Float
let dependent a = do { x <- a and y <- lookup x; pure (x + y) }

// a group cannot end the block
ending : Option Float -> Option Float
let ending a = do { x <- a and y <- a }

// each operand is a container, the first as the others
scalar : Option Float
let scalar = do { x <- 1 and y <- Some 2; pure (x + y) }

//~ FLICK-T001 @8:47-8:48 `x` is bound by another binding of this `and` group
//~ FLICK-T019 @12:21-12:38 must end with an expression
//~ FLICK-T003 @16:24-16:25 expected `Option _`, found `Int`

// the monadic tail after an `and` group must still match the block's type
wrong_tail : Option Float
let wrong_tail = do { _ <- Some 1 and _ <- Some 2; Some "wrong" }
//~ FLICK-T003 @24:52-24:64 expected `Option Float`, found `Option String`
