module App.Debug exposing (render, total, piped, swap, names, label)

render : List Float -> String
let render _rows = todo "render the rows"
//                 ^^^^^^^^^^^^^^^^^^^^^^ FLICK-T022 `todo` is left in the code

total : List Float -> Float
let total xs = echo (Float.sum_all xs)
//             ^^^^ FLICK-T023 `echo` is left in the code

piped : Float -> Float
let piped x = x |> echo |> Float.abs
//                 ^^^^ FLICK-T023 `echo` is left in the code

swap : (Float, String) -> _
//                        ^ FLICK-T024 `_` is `(String, Float)`
let swap (a, b) = (b, a)

names : Float -> List _
//                    ^ FLICK-T024 `_` is `Float`
let names n = [n]

// the keywords stay labels
label : { echo : Float; todo : String }
let label = { echo = 1; todo = "x" }
