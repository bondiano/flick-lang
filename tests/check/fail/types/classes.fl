module App.Classes exposing (..)

class Show a =
  show : a -> String

instance Show Number =
  let show n = "number"

instance Show Bool =
  show : Bool -> String
  let show b = b

instance Show Missing =
  show : Missing -> String
  let show m = "?"

class Functor (f : Type -> Type) =
  map : (a -> b) -> f a -> f b

instance Functor Number =
  map : (a -> b) -> Number -> Number
  let map f n = n

