module App.Misc exposing (..)

unknown : Missing -> Number
let unknown value = nowhere value

ctor : Unit -> Number
let ctor () =
  match Nope with
  | _ -> 0

qualified : Unit -> Number
let qualified () = Nowhere.thing

misplaced : Number -> Number

other : Number
let other = 1

let misplaced n = n

infinite : Unit -> Unit
let infinite () =
  ignore (fun x -> x x)

let unknown_cell = Ref.make None

not_function : Number -> Number
let not_function n = n 1

awaited : Number ->{} Number
let awaited n = await n

phantom : Unit -> a
let phantom () = phantom_value

let phantom_value = []

