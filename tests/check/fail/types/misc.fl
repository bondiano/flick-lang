module App.Misc exposing (..)

unknown : Missing -> Float
let unknown value = nowhere value

ctor : Unit -> Float
let ctor () =
  match Nope with
  | _ -> 0

qualified : Unit -> Float
let qualified () = Nowhere.thing

misplaced : Float -> Float

other : Float
let other = 1

let misplaced n = n

infinite : Unit -> Unit
let infinite () = ignore (fun x -> x x)

let unknown_cell = Ref.make None

not_function : Float -> Float
let not_function n = n 1

awaited : Float ->{} Float
let awaited n = await n

phantom : Unit -> a
let phantom () = phantom_value

let phantom_value = []

// a number literal is no function, whatever number it becomes
literal_call : Float -> Float
let literal_call n = 2 n

// nor is it a function next to one: the list would hold a function as an
// `Int`
literal_element : Unit -> Int
let literal_element () =
  match [0, fun x -> x] with
  | [_, b] -> b + 1
  | _ -> 0

