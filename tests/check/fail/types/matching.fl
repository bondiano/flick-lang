module App.Matching exposing (..)

type Shape = Circle of Number | Rect of Number, Number | Empty

partial : Option Number -> Number
let partial value =
  match value with
  | Some n -> n

shapes : Shape -> Number
let shapes shape =
  match shape with
  | Circle r -> r
  | Rect w h when w == h -> w

nested : Option (Option Bool) -> Number
let nested value =
  match value with
  | Some (Some true) -> 1
  | None -> 0

numbers : Number -> String
let numbers n =
  match n with
  | 0 -> "zero"
  | 1 -> "one"

lists : List Number -> Number
let lists items =
  match items with
  | [] -> 0
  | [x] -> x

redundant : Bool -> Number
let redundant b =
  match b with
  | _ -> 0
  | true -> 1

arity : Shape -> Number
let arity shape =
  match shape with
  | Rect w -> w
  | _ -> 0

refutable : Option Number -> Number
let refutable value =
  let Some n = value
  n

