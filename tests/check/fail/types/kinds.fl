module App.Kinds exposing (..)

service Users =
  get : Float ->{} String

type error NotFound

applied : Option -> Float
foreign pure applied from "./k.js" "applied"

too_many : Float String -> Float
foreign pure too_many from "./k.js" "tooMany"

eff_units : Eff Unit Unit a -> a
foreign pure eff_units from "./k.js" "effUnits"

swapped : Unit ->{NotFound; Users} Unit
foreign sync swapped from "./k.js" "swapped"

not_error : Unit ->{; String} Unit
foreign sync not_error from "./k.js" "notError"

mixed : (a ->{c; none} b)^c -> Unit
foreign pure mixed from "./k.js" "mixed"

none_type : none -> Unit
foreign pure none_type from "./k.js" "noneType"

type alias Box (f : Type -> Type) = { value : f }

