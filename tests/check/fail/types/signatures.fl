// an operand of an operator keeps a local function of one type
one_type : Unit ->{} Unit
let one_type () =
  let join a b = a ++ b
  let _ = join "a" "b"
  let _ = join [1] [2]
  ()

// and a recursive one needs a signature, as at the top level
counted : Unit ->{} Int
let counted () =
  let rec count n = if n == 0 then 0 else count (n - 1)
  count 3
