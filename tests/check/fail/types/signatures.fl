//~ FLICK-T005 @20:3-20:38 write the type of function `f` as a signature above the

// without a signature a local function has one type
one_type : Unit ->{} Unit
let one_type () =
  let id x = x
  let _ = id 1
  let _ = id "a"
  ()

// and a recursive one needs a signature, as at the top level
counted : Unit ->{} Int
let counted () =
  let rec count n = if n == 0 then 0 else count (n - 1)
  count 3
