module App.Signatures exposing (..)

let double n = n * 2

let triple = fun n -> n * 3

let header (x : Float) : Float = x

add : Float -> Float -> Float

let partial = add 1

main : Unit -> Float
let main () =
  let local x = x + 1
  local 1

hinted : Unit -> Float
let hinted () =
  let f : Float -> Float = fun x -> x
  f 1

