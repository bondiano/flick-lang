module App.Signatures exposing (..)

let double n = n * 2

let triple = fun n -> n * 3

let header (x : Number) : Number = x

add : Number -> Number -> Number

let partial = add 1

main : Unit -> Number
let main () =
  let local x = x + 1
  local 1

hinted : Unit -> Number
let hinted () =
  let f : Number -> Number = fun x -> x
  f 1

