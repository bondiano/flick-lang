// Type, scope, monomorphism, GADT, existential, region, reachability, and
// block-tail errors for `let ... else`.
module App.LetElseFail exposing (..)

type Box =
  | Hide a : Box

type Expr a =
  | IntLit Int : Expr Int
  | BoolLit Bool : Expr Bool

type File (s : Region)

service Files =
  open : forall s. String ->{Scope s} File s

/// Fallback type must match the enclosing block remainder (checked).
branch_mismatch : Option Int -> Int
let branch_mismatch m =
  let Some n = m else "wrong"
  n + 1

/// Fallback type must match the inferred success remainder in an unannotated block.
inferred_branch_mismatch : Option Int -> String
let inferred_branch_mismatch m =
  let v =
    let Some n = m else "wrong"
    n + 1
  show v

/// Pattern bindings are not in scope in the fallback.
pattern_in_fallback : Option Int -> Int
let pattern_in_fallback m =
  let Some n = m else n
  n + 1

/// Pattern bindings are not in scope in the initializer.
pattern_in_init : Bool -> Option Int -> Int
let pattern_in_init flag m =
  let Some n = (if flag then Some n else m) else 0
  n + 1

/// Fallback locals do not escape to the success remainder.
fallback_local_escapes : Option Int -> Int
let fallback_local_escapes m =
  let Some n = m else
    let fb = 0
    fb
  n + fb

/// Pattern bindings are monomorphic (like `match`).
mono_refutable : Unit -> (Int, String)
let mono_refutable () =
  let Some id = Some (fun x -> x) else (0, "")
  (id 1, id "a")

/// Even an irrefutable single-variable `let-else` is monomorphic (like `match`).
mono_irrefutable : Unit -> (Int, String)
let mono_irrefutable () =
  let id = fun x -> x else (0, "")
  (id 1, id "a")

/// GADT refinement does not leak into the fallback.
gadt_leak : forall a. Expr a -> a -> Int
let gadt_leak e x =
  let IntLit n = e else x + 1
  n + x

/// Existentials bound by `let-else` cannot escape the block.
existential_escape : Option Box -> Int
let existential_escape m =
  let _result =
    let Some (Hide x) = m else 0
    x
  0

/// Scoped region handles cannot escape via `let-else`.
region_escape : Option String ->{Files} Unit
let region_escape m =
  let leaked = scope {
    let Some path = m else Files.open "fallback"
    Files.open path
  }
  ignore leaked

/// Impossible GADT pattern warns that `let-else` never matches.
impossible_gadt : Expr Int -> Int
let impossible_gadt e =
  let BoolLit b = e else 0
  if b then 1 else 2

/// Irrefutable tuple pattern warns that `else` is unreachable.
irrefutable_tuple : (Int, Int) -> Int
let irrefutable_tuple pair =
  let (a, b) = pair else 0
  a + b

/// Empty success remainder is a block-tail error (`FLICK-T019`).
empty_remainder : Option Int -> Int
let empty_remainder m =
  let Some _ = m else 0

/// A signature cannot be paired with `let ... else`.
paired_sig : Option Int -> Int
let paired_sig m =
  n : Int
  let Some n = m else 0
  n

