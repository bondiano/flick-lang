// What a GADT branch refuses to learn, and what it learns only under known
// types: a complete signature, a known type of the matched value, and no
// type from outside the branch getting its type from the branch.
module App.Gadt exposing (..)

type Expr a =
  | IntLit Int : Expr Int
  | BoolLit Bool : Expr Bool
  | Lit a

type Ty a =
  | TInt : Ty Int
  | TStr : Ty String

type Box =
  | Box b : Box

type Same (r : Region) (s : Region) =
  | Same : Same r r

type Bad =
  | NotMine Int : Option Int
  //~ FLICK-T056 @22:17-22:29 a constructor of `Bad` builds `Bad` applied
  | Partly : Bad

local_value : Expr a -> Int
let local_value e =
  let n =
    match e with
    | IntLit n -> n
    //~ FLICK-T057 @30:7-30:15 this constructor refines the type of the
    | BoolLit _ -> 0
    //~ FLICK-T057 @32:7-32:16 this constructor refines the type of the
    | Lit _ -> 1
  n

partial : Expr a -> _
//~ FLICK-T024 @37:21-37:22 `_` is `Int`
let partial e =
  match e with
  | IntLit n -> n
  //~ FLICK-T057 @41:5-41:13 this constructor refines the type of the
  | BoolLit _ -> 0
  //~ FLICK-T057 @43:5-43:14 this constructor refines the type of the
  | Lit _ -> 1

unknown : Expr a -> Int
let unknown e =
  (fun x ->
    match x with
    | IntLit n -> n
    //~ FLICK-T057 @51:7-51:15 the type of the matched value is
    | _ -> 0
  )
    e
//~ FLICK-T055 @53:7-53:8 `_` stands for `BoolLit`, `Lit` of `Expr`:

untouchable : Ty a -> a -> String
let untouchable t x =
  show
    (
      match t with
      | TInt -> x
      //~ FLICK-T057 @63:17-63:18 expected `_`, found `Int`: a type from
      | TStr -> 0
    )

escape : Box -> Int
let escape box =
  let inside =
    match box with
    | Box x -> x
  //~ FLICK-T007 @72:16-72:17 expected `_`, found `b`: the type variable
  ignore inside
  0

regions : Same r s -> Int
let regions same =
  match same with
  | Same -> 0
//~ FLICK-T058 @80:5-80:9 matching this constructor would mean that two

in_let : Box -> Int
let in_let box =
  let Box _ = box
  //~ FLICK-T058 @85:7-85:12 this constructor hides or refines a type,
  0

dead : Ty Int -> Int
let dead t =
  match t with
  | TInt -> 1
  | TStr -> 2
//~ FLICK-T010 @93:5-93:9 this arm is never reached: no value

type Tagged a =
  | IsNat : Tagged Int
  | IsBool : Tagged Bool

half : Tagged a -> Tagged a -> Bool
let half x y =
  match (x, y) with
  | (IsNat, IsNat) -> true
//~ FLICK-T009 @102:3-102:15 `match` does not cover every value: `(IsBool, _)`

mixed : Tagged a -> Tagged a -> Bool
let mixed x y =
  match (x, y) with
  | (IsNat, IsNat) -> true
  | (IsBool, IsBool) -> true
  | (IsNat, IsBool) -> false
//~ FLICK-T010 @111:5-111:20 this arm is never reached: no value

/// `a` and `b` may be different types, so a mixed pair is built.
unrelated : Tagged a -> Tagged b -> Bool
let unrelated x y =
  match (x, y) with
  | (IsNat, IsNat) -> true
  | (IsBool, IsBool) -> false
//~ FLICK-T009 @117:3-117:15 `match` does not cover every value: `(IsNat, IsBool)`

/// A type the constructor hides is not followed.
type Packed =
  | Packed (Tagged x) (Tagged x) : Packed

hidden : Packed -> Bool
let hidden p =
  match p with
  | Packed IsNat IsNat -> true
  | Packed IsBool IsBool -> false
//~ FLICK-T009 @128:3-128:10 `match` does not cover every value: `Packed IsNat IsBool`
