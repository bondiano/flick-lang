// What a GADT branch refuses to learn, and what it learns only under known
// types: a complete signature, a known type of the matched value, and no
// type from outside the branch getting its type from the branch.
module App.Gadt exposing (..)

type Expr a =
  | IntLit Int : Expr Int
  | BoolLit Bool : Expr Bool
  | Lit a

type Ty a =
  | TInt : Ty Int
  | TStr : Ty String

type Box =
  | Box b : Box

type Same (r : Region) (s : Region) =
  | Same : Same r r

type Bad =
  | NotMine Int : Option Int
  //~ FLICK-T056 @22:17-22:29 a constructor of `Bad` builds `Bad` applied
  | Partly : Bad

local_value : Expr a -> Int
let local_value e =
  let n =
    match e with
    | IntLit n -> n
    //~ FLICK-T057 @30:7-30:15 this constructor refines the type of the
    | BoolLit _ -> 0
    //~ FLICK-T057 @32:7-32:16 this constructor refines the type of the
    | Lit _ -> 1
  n

partial : Expr a -> _
//~ FLICK-T024 @37:21-37:22 `_` is `Int`
let partial e =
  match e with
  | IntLit n -> n
  //~ FLICK-T057 @41:5-41:13 this constructor refines the type of the
  | BoolLit _ -> 0
  //~ FLICK-T057 @43:5-43:14 this constructor refines the type of the
  | Lit _ -> 1

unknown : Expr a -> Int
let unknown e =
  let f = fun x ->
    match x with
    | IntLit n -> n
    //~ FLICK-T057 @51:7-51:15 the type of the matched value is
    | _ -> 0
  // typed where it is written, `f` has no argument to learn from
  f e

untouchable : Ty a -> a -> String
let untouchable t x =
  show
    (
      match t with
      | TInt -> x
      //~ FLICK-T057 @62:17-62:18 expected `_`, found `Int`: a type from
      | TStr -> 0
    )

escape : Box -> Int
let escape box =
  let inside =
    match box with
    | Box x -> x
  //~ FLICK-T007 @71:16-71:17 expected `_`, found `b`: the type variable
  ignore inside
  0

regions : Same r s -> Int
let regions same =
  match same with
  | Same -> 0
//~ FLICK-T058 @79:5-79:9 matching this constructor would mean that two

in_let : Box -> Int
let in_let box =
  let Box _ = box
  //~ FLICK-T058 @84:7-84:12 this constructor hides or refines a type,
  0

dead : Ty Int -> Int
let dead t =
  match t with
  | TInt -> 1
  | TStr -> 2
//~ FLICK-T010 @92:5-92:9 this arm is never reached: no value

type Tagged a =
  | IsNat : Tagged Int
  | IsBool : Tagged Bool

half : Tagged a -> Tagged a -> Bool
let half x y =
  match (x, y) with
  | (IsNat, IsNat) -> true
//~ FLICK-T009 @101:3-101:15 `match` does not cover every value: `(IsBool, _)`

mixed : Tagged a -> Tagged a -> Bool
let mixed x y =
  match (x, y) with
  | (IsNat, IsNat) -> true
  | (IsBool, IsBool) -> true
  | (IsNat, IsBool) -> false
//~ FLICK-T010 @110:5-110:20 this arm is never reached: no value

/// `a` and `b` may be different types, so a mixed pair is built.
unrelated : Tagged a -> Tagged b -> Bool
let unrelated x y =
  match (x, y) with
  | (IsNat, IsNat) -> true
  | (IsBool, IsBool) -> false
//~ FLICK-T009 @116:3-116:15 `match` does not cover every value: `(IsNat, IsBool)`

/// A type the constructor hides is not followed.
type Packed =
  | Packed (Tagged x) (Tagged x) : Packed

hidden : Packed -> Bool
let hidden p =
  match p with
  | Packed IsNat IsNat -> true
  | Packed IsBool IsBool -> false
//~ FLICK-T009 @127:3-127:10 `match` does not cover every value: `Packed IsNat IsBool`

// applied where it is written, the function takes the type of the matched
// value from its argument: then the branch refines a type from outside it
applied : Expr a -> Int
let applied e =
  (fun x ->
    match x with
    | IntLit n -> n
    | _ -> 0
  )
    e
//~ FLICK-T057 @138:19-138:20 expected `_`, found `Int`: a type from outside this branch would become `Int`
//~ FLICK-T055 @139:7-139:8 `_` stands for `BoolLit`, `Lit` of `Expr`:
