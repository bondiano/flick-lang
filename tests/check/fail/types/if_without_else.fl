module App.IfWithoutElse exposing (..)

say : Bool ->{a; b} Unit
let say c = if c then Console.log "yes" else ()

chain : Bool ->{a; b} Unit
let chain c = if c then Console.log "a" else if not c then Console.log "b" else ()

kept : Bool -> Unit
let kept c =
  if c then
    () // the comment stays
  else
    ()

quiet : Bool ->{a; b} Unit
let quiet c = if c then Console.log "c"

value : Bool -> Float
let value c = if c then 1

discarded : Bool -> Unit
let discarded c = if c then 2

//~ FLICK-T028 @7:76-7:83 `else ()` can be left out: an `if` without `else` is `Unit`
//~ FLICK-T028 @4:41-4:48 `else ()` can be left out: an `if` without `else` is `Unit`
