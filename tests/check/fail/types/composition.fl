module App.Composition exposing (..)

inc : Int -> Int
let inc n = n + 1

not_a_function : Int -> Int
let not_a_function = inc >> "three"

mismatch : Int -> Int
let mismatch = inc >> String.length

applied_text : Int
let applied_text = "a" <| 2

wrong_result : Int -> String
let wrong_result = inc << inc
