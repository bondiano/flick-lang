module App.OrElseFail exposing (..)

service Log =
  read : Unit ->{} Int

number_lhs : Int
let number_lhs = 7 orelse 0

result_lhs : Int
let result_lhs = Ok 7 orelse 0

rhs_mismatch : Int
let rhs_mismatch = Some 7 orelse "x"

no_flatten : String
let no_flatten = Some (Some "a") orelse "b"

pure_rhs_effect : Option Int -> Int
let pure_rhs_effect opt = opt orelse Log.read ()

