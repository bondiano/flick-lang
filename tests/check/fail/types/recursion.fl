module App.Recursion exposing (..)

type Nested a = Flat of a | Nest of Nested (List a)

depth : Nested a -> Number
let rec depth value =
  match value with
  | Flat _ -> 0
  | Nest inner -> 1 + depth inner

loop : Number -> Number
let loop n = loop n

ping : Number -> Number
let ping n = pong n

pong : Number -> Number
let pong n = ping n

let rec xs = [1] ++ xs

let a = b + 1

let b = a + 1

