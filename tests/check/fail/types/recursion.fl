module App.Recursion exposing (..)

type Nested a = Flat a | Nest (Nested (List a))

depth : Nested a -> Float
let rec depth value =
  match value with
  | Flat _ -> 0
  | Nest inner -> 1 + depth inner

loop : Float -> Float
let loop n = loop n

ping : Float -> Float
let ping n = pong n

pong : Float -> Float
let pong n = ping n

let rec xs = [1] ++ xs

let a = b + 1

let b = a + 1

rec {
  wrap : List a -> Float
  let wrap xs = match xs with | [] -> 0 | [x, ..._] -> unwrap [[x]]

  unwrap : List b -> Float
  let unwrap xs = match xs with | [] -> 0 | [_, ...rest] -> wrap rest
}

rec {
  swap_a : (a, b) -> Float
  let swap_a (x, y) = swap_b (y, x)

  swap_b : (c, d) -> Float
  let swap_b (x, y) = swap_a (x, y)
}

