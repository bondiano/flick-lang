module App.Records exposing (..)

type alias Named = { name : String }

strict : Named -> String
let strict value = value.name

extra : Unit -> String
let extra () = strict { name = "a"; age = 1 }

missing : Unit -> String
let missing () = strict {}

type alias Twice = { a : Float; a : String }

dup : Unit -> { x : Float }
let dup () = { x = 1; x = 2 }

no_field : Named -> Float
let no_field value = value.age

update : Named -> Named
let update value = { value with age = 1 }

wrong_type : Named -> Named
let wrong_type value = { value with name = 1 }

