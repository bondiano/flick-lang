module App.Collections exposing (..)

load : Float ->{} Float
let load n = n

/// `List.map` takes a pure callback; a runtime one needs `List.map_effect`.
loaded : List Float -> List Float
let loaded xs = List.map load xs
//                       ^^^^ FLICK-T003 a pure function

/// Sets of two witnesses do not mix without `rehash`.
mixed : HashSet.HashSet EqHash.Canonical String -> Int
let mixed canonical =
  EqHash.with
    (fun a b -> a == b)
    (fun s -> String.length s)
    (fun witness -> HashSet.size (HashSet.union canonical (HashSet.with witness)))
//                                                         ^^^^^^^^^^^^^^^^^^^^ FLICK-T003 found `HashSet w String`

/// A witness cannot leave the function it is given to.
escaped : Float
let escaped =
  EqHash.with (fun a b -> a == b) (fun n -> n) (fun witness -> HashSet.with witness)
//                                                             ^^^^^^^^^^^^^^^^^^^^ FLICK-T007 `w` would escape
