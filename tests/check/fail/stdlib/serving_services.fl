// The handlers' services are what serving needs: an API or a group whose
// handler asks for `Users` cannot be served where no layer provides it.
module App.ServingServices exposing (http, rpc)

service Users =
  count : Unit ->{} Float

ping : HttpApi.Endpoint "ping" (HttpApi.Request Unit Unit Unit Unit ->{r} Unit)
let ping = HttpApi.endpoint HttpApi.Get "/ping" (Record.label : Record.Label "ping")

total : Rpc.Rpc "total" (Unit ->{r} Unit)
let total = Rpc.make (Record.label : Record.Label "total")

http : Unit ->{Async; HttpApi.ServeError} Unit
let http () =
  let options : HttpApi.ServeOptions = {
    host = "127.0.0.1";
    port = 0;
    openapi = None;
    swagger = None;
    scalar = None;
  }
  let api =
    HttpApi.api "app"
    |> HttpApi.add_group (HttpApi.group (Record.label : Record.Label "app") |> HttpApi.add ping)
  scope s {
    let _server = HttpApi.listen options api { app = { ping = fun _ -> ignore (Users.count ()) } }
    ()
  }

rpc : Unit ->{Async; Rpc.ServeError} Unit
let rpc () = scope s {
  let _server =
    Rpc.listen Rpc.defaults (Rpc.group |> Rpc.add total) {
      total = fun () -> ignore (Users.count ());
    }
  ()
}

//~ FLICK-E002 @26:3-26:8 does not allow service `Users`
//~ FLICK-C001 @34:43-34:50 does not hold
