module App.Channels exposing (..)

type alias Path = String

type File (s : Region)

service Files =
  open : forall s. Path ->{Scope s} File s
  read : forall s. File s ->{} String

/// A channel of a subscription holds its region and cannot leave its scope.
escaped : PubSub.PubSub Float ->{} Unit
let escaped hub =
  let channel = scope { Channel.from_subscription (PubSub.subscribe hub) }
  //~ FLICK-G002 @14:25-14:73 region `s` ends with its `scope`
  ()

/// A callback kept in a channel may hold a scoped resource it uses there.
captured : Path ->{Files} Unit
let captured path = scope {
  let file = Files.open path
  let lines = Channel.map_effect (fun n -> Files.read file) (Channel.from_list [1])
  // the channel is not run, so nothing uses `file` after the scope
  ()
}
