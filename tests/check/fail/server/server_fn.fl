// What a `server fn` sends crosses the network: its signature says it, and
// each part of it has a Schema witness.
module App.ServerFn exposing (..)

import Server

type alias Order = { item : String }
  deriving Schema

type alias Secret = { check : String -> Bool }

type error Missing = Missing String

server fn unsigned x = x

pick : forall a. a ->{Server.Server;} a
server fn pick x = x

keep : Secret ->{Server.Server;} String
server fn keep secret = if secret.check "" then "yes" else "no"

find : Order ->{Server.Server; Missing} String
server fn find order = order.item

early : String ->{Server.Server;} String ->{Server.Server;} String
server fn early a b = a ++ b

sealed : String -> Secret ->{Server.Server;} String
server fn sealed a secret = if secret.check a then "yes" else "no"

local : Order -> String
let local order = order.item

served : List (Server.Function {Server.Server})
let served = [server local]
//~ std/E010 @14:1-14:25 server fn `unsigned` needs a signature right above it: what the server runs
//~ std/E010 @17:1-17:21 server fn `pick`: a server fn is not generic: its types cross the network
//~ FLICK-D001 @20:1-20:64 `Secret` derives no Schema: add `deriving Schema` to its declaration
//~ FLICK-D001 @23:1-23:34 `Missing` derives no Schema: add `deriving Schema` to its declaration
//~ std/E010 @26:1-26:29 server fn `early`: only the last arrow of a server fn runs: `A -> B ->{r; e} S`
//~ FLICK-D001 @29:1-29:67 `Secret` derives no Schema: add `deriving Schema` to its declaration
//~ FLICK-E010 @35:15-35:27 `local` is not a server fn: only `server fn` has an implementation to serve
