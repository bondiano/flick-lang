module App.Forms exposing (Rows, Boxed, Both, Lone, Twice)

@ts "Array<{1}>"
type Rows a = Rows (List a)

@ts "$Box<{0}>"
type Boxed a = Boxed a

@ts "number"
@ts none
type Both = Both

@ts import "boxes" "Box"
type Lone = Lone

@ts "number"
@ts "string"
type Twice = Twice

