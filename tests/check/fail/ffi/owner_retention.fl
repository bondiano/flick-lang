// With `retention owner` the JS code keeps an argument until the owner of
// a region closes: a capture row it keeps outlives that region, unless the
// result shows it, and the services of kept work are provided and detached. A
// signature with one region gets those constraints; with two it has to say which.
module App.OwnerRetention exposing (..)

defer : (Eff r none Unit)^c ->{Scope s | r;} Unit
foreign effect defer from "./scope.js" "defer"
  retention owner

defer_checked :
  (Fiber.Outlives c s, Fiber.Provided r s, Detached r) => (Eff r none Unit)^c ->{Scope s | r;} Unit
foreign effect defer_checked from "./scope.js" "defer"
  retention owner

shown : (Unit -> a)^c -> Unit -> a
foreign pure shown from "./scope.js" "shown"
  retention owner

// the caller has to meet what `defer` gets
without_constraints : (Eff r none Unit)^c ->{Scope s | r;} Unit
let without_constraints work = defer work

with_constraints :
  (Fiber.Outlives c s, Fiber.Provided r s, Detached r) => (Eff r none Unit)^c ->{Scope s | r;} Unit
let with_constraints work = defer work

without_detached : (Fiber.Outlives c s, Fiber.Provided r s) => (Eff r none Unit)^c ->{Scope s | r;} Unit
let without_detached work = defer work

type Handle (t : Region) = Handle

two_regions : Handle t -> (Eff r none Unit)^c ->{Scope s | r;} Unit
foreign effect two_regions from "./scope.js" "defer"
  retention owner
//~ FLICK-G003 @22:32-22:37 the child holds `c`, which may end before its owner `s`
//~ FLICK-G003 @22:32-22:37 this keeps work that uses `r` until `s` closes
//~ FLICK-E017 @29:29-29:34 cannot deduce `Detached r`
//~ FLICK-F002 @34:1-35:18 with `retention owner`
//~ FLICK-T059 @12:3-12:55 `retention owner` gives this signature `Fiber.Outlives c s, Fiber.Provided r s, Detached r` anyway
