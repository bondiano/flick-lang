// A written closed row, invariant container, contravariant parameter, or GADT
// index still rejects a function that needs a service; an unannotated cell
// initialized with `quiet` and updated with a logging function still needs
// `Log` where the cell is called.
module App.ServiceOrderFail exposing (..)

service Log =
  line : String ->{} Unit

quiet : Unit ->{} Unit
let quiet () = ()

logged : Unit ->{Log} Unit
let logged () = Log.line "x"

run_quiet : (Unit ->{} Unit) ->{} Unit
let run_quiet f = f ()

/// Parameter expecting a closed row rejects a logging closure.
param_closed : Unit ->{Log} Unit
let param_closed () = run_quiet (fun () -> Log.line "x")

/// Parameter expecting a closed row rejects a named logging function.
param_closed_named : Unit ->{Log} Unit
let param_closed_named () = run_quiet logged

/// A cell with a written closed row rejects storing a logging function.
written_cell_param : Ref (Unit ->{} Unit) ->{Log} Unit
let written_cell_param cell = Ref.set cell (fun () -> Log.line "x")

/// A local cell with a written closed row rejects storing a logging function.
written_cell_local : Unit ->{Log} Unit
let written_cell_local () =
  cell : Ref (Unit ->{} Unit)
  let cell = Ref.make quiet
  Ref.set cell logged

/// A local annotation with a closed row rejects a logging branch.
annotated_if : Bool ->{Log} Unit
let annotated_if b =
  let f = (if b then quiet else (fun () -> Log.line "x") : Unit ->{} Unit)
  f ()

/// An unannotated cell made from `quiet` and updated with `logged` still needs
/// `Log` when called.
unannotated_cell_called : Unit ->{} Unit
let unannotated_cell_called () =
  let cell = Ref.make quiet
  Ref.set cell logged
  let f = Ref.get cell
  f ()

/// `Ref` is invariant: `Ref (Unit ->{} Unit)` does not fit `Ref (Unit ->{Log} Unit)`.
invariant_ref : Ref (Unit ->{} Unit) -> Ref (Unit ->{Log} Unit)
let invariant_ref cell = cell

/// Joining two invariant `Ref`s of closed rows does not widen inside `Ref`.
invariant_ref_if : Bool -> Ref (Unit ->{} Unit) -> Ref (Unit ->{Log} Unit) ->{} Unit
let invariant_ref_if b c1 c2 = ignore (if b then c1 else c2)

/// Contravariant parameter position is never widened: a function needing a
/// logging callback does not accept a function that only handles quiet callbacks.
needs_logged : (Unit ->{Log} Unit) ->{Log} Unit
let needs_logged f = f ()

needs_quiet : (Unit ->{} Unit) ->{} Unit
let needs_quiet f = f ()

contra_if : Bool -> (Unit ->{Log} Unit) ->{Log} Unit
let contra_if b f =
  let g = if b then needs_logged else needs_quiet
  g f

/// GADT index fixing a closed row still rejects a logging function.
type Tag a =
  | Quiet : Tag (Unit ->{} Unit)

gadt_closed : Tag a -> a
let gadt_closed tag =
  match tag with
  | Quiet -> fun () -> Log.line "x"

gadt_invariant : Tag (Unit ->{} Unit) -> Tag (Unit ->{Log} Unit)
let gadt_invariant t = t

/// Written closed option cell still rejects a wrapped logging function.
written_closed_option_cell : Unit ->{Log} Unit
let written_closed_option_cell () =
  cell : Ref (Option (Unit ->{} Unit))
  let cell = Ref.make (Some quiet)
  Ref.set cell (Some logged)

/// Unifying a widened row with `{-Log | ?s}` preserves the `-Log` exclusion.
idle_task : Unit -> Eff s none Unit
let idle_task () = task { () }

later_without_log : Layer none none {Log} -> Eff s none Unit -> Unit ->{-Log | s} Unit
let later_without_log layer t () = provide layer { await t }

without_preserves_exclusion : Layer none none {Log} ->{} Unit
let without_preserves_exclusion layer =
  let cell = Ref.make quiet
  ignore (Ref.same cell (Ref.make (later_without_log layer (idle_task ()))))
  Ref.set cell logged

without_rejects_logged_first : Layer none none {Log} ->{} Bool
let without_rejects_logged_first layer =
  Ref.same (Ref.make logged) (Ref.make (later_without_log layer (idle_task ())))

