module App.Handlers exposing (..)

type error A = A Float

type error B = B String

type error C = C String

raise_any : Bool ->{; A, B, C} Unit
let raise_any b = if b then Fail.fail (C "not a number") else Fail.fail (B "x")

rethrow : Errors {A, B} ->{; A, B} String
let rethrow e = Fail.fail e

payload : A -> Float
let payload e =
  match e with
  | A x -> x + 1

// a variable receives every error of the body, whatever its use asks for
narrowed_row : Unit ->{; A, B} String
let narrowed_row () =
  try
    raise_any true
    "ok"
  with
  | e -> rethrow e

narrowed_error : Unit ->{; B, C} Float
let narrowed_error () =
  try
    raise_any true
    0
  with
  | e -> payload e

annotated : Unit ->{; A, B} String
let annotated () =
  try
    raise_any true
    "ok"
  with
  | (e : Errors {A, B}) -> rethrow e

//~ FLICK-E002 @27:5-27:6 the expected type `Errors {A, B}` does not allow error `C`, which this needs
//~ FLICK-E002 @35:5-35:6 the expected type `Errors {A}` does not allow errors `B`, `C`, which this needs
//~ FLICK-E002 @43:5-43:24 the expected type `Errors {A, B}` does not allow error `C`, which this needs

// a `match` on `Errors {A, B}` has an arm for each error of the row, and
// none for an error outside it
missing_arm : Errors {A, B} -> String
let missing_arm e =
  match e with
  | A _ -> "a"
//~ FLICK-T009 @53:3-53:10 `match` does not cover every value: `B _` is not matched

outside_row : Errors {A, B} -> String
let outside_row e =
  match e with
  | A _ -> "a"
  | B _ -> "b"
  | C _ -> "c"
//  ^^^ FLICK-T003 `C` is not one of the errors of `Errors {A, B}`

// an arm for every error tells nothing of the errors of `e`, which then
// have to be known
unknown_row : Unit ->{; A, B, C} String
let unknown_row () =
  try
    raise_any true
    "ok"
  with
  | e ->
    match e with
    | A _ -> "a"
    | _ -> "other"
//    ^ FLICK-T057 this arm matches every error, so the arms do not tell the errors of the value
