module App.Handlers exposing (..)

type error A = A Float

type error B = B String

type error C = C String

raise_any : Bool ->{; A, B, C} Unit
let raise_any b = if b then from_result (Err (C "not a number")) else from_result (Err (B "x"))

rethrow : Errors {A, B} ->{; A, B} String
let rethrow e = from_result (Err e)

payload : A -> Float
let payload e =
  match e with
  | A x -> x + 1

// a variable receives every error of the body, whatever its use asks for
narrowed_row : Unit ->{; A, B} String
let narrowed_row () =
  try
    raise_any true
    "ok"
  with
  | e -> rethrow e

narrowed_error : Unit ->{; B, C} Float
let narrowed_error () =
  try
    raise_any true
    0
  with
  | e -> payload e

annotated : Unit ->{; A, B} String
let annotated () =
  try
    raise_any true
    "ok"
  with
  | (e : Errors {A, B}) -> rethrow e

