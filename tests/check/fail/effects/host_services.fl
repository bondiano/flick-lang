module App.HostServices exposing (..)

read_environment : Unit ->{} Option String
let read_environment () = Host.Environment.env "MODE"

read_clock : Unit -> Float
let read_clock () = Host.Clock.current_time_millis ()

read_random : Unit ->{} Float
let read_random () = Host.Random.next ()

read_arguments : Unit ->{} List String
let read_arguments () = Host.Arguments.args ()

write_console : String ->{} Unit
let write_console text = Host.Console.stdout_line text

