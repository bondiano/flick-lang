module App.Services exposing (..)

service Users =
  get : Number ->{} String

service Clock =
  now : Unit ->{} Number

service Bad =
  value : Number

error Broken of Ref Number

error Hidden of { value : Unknown }

error Thunk of Unit ->{} Number

type Job = Job of Eff none none Unit

error Failed of Job

error Fine of { path : String; parse : String -> Number }

js_now : Unit ->{} Number
let js_now () = 0

clock_layer : Layer none none {Clock}
let clock_layer = Layer.succeed Clock { now = js_now }

conflict : Layer none none {Clock}
let conflict = Layer.merge clock_layer clock_layer

wrong_impl : Layer none none {Clock}
let wrong_impl = Layer.succeed Clock { now = 1 }

users_layer : Layer none none {Users}
let users_layer = Layer.succeed Users { get = fun id -> "user" }

with_users : Layer none none {Users} -> Eff {Users} none String ->{} String
let with_users layer action =
  provide layer { await action }

prepare : Number ->{Users; none} Eff {Users} none String
let prepare id =
  let name = Users.get id
  task { name }

run_early : Number ->{Users; none} String
let run_early id = with_users users_layer (prepare id)

