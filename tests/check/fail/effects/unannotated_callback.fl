module App.UnannotatedCallback exposing (..)

// Applied before its type is known, `h` is taken for a pure function, so a
// runtime function does not fit it; the note points at `h`, and the fix
// writes the runtime arrow it is given.
service Log =
  info : String ->{} Unit

say : Unit ->{Log} Unit
let say () = Log.info "hi"

apply : Unit ->{Log} Unit
let apply () = (fun h -> h ()) say

//~ FLICK-T003 @13:32-13:35 expected `Unit -> _`, found `Unit ->{Log} Unit`
