module App.UnannotatedCallback exposing (..)

// Applied before its type is known, `h` is taken for a pure function, so the
// runtime function `say` does not fit it: the error is at `say`, its related
// note at the binder of `h`, and its fix writes the arrow `h` is given.
service Log =
  info : String ->{} Unit

say : Unit ->{Log} Unit
let say () = Log.info "hi"

apply : Unit ->{Log} Unit
let apply () = (fun h -> h ()) say

//~ FLICK-T003 @13:32-13:35 expected `Unit -> _`, found `Unit ->{Log} Unit`

// A service from another module, such as `Host.Console`, keeps the qualifier
// this module needs to name it.
say_host : Unit ->{Host.Console} Unit
let say_host () = Platform.stdout_line "hi"

apply_host : Unit ->{Host.Console} Unit
let apply_host () =
  let run = fun action -> action ()
  run say_host

//~ FLICK-T003 @25:7-25:15 expected `Unit -> _`, found `Unit ->{Host.Console} Unit`

// Of two local functions with callbacks of one shape, the error explains the
// one applied: its note points to `h`, the parameter of `apply_it`.
apply_local : Unit ->{Log} Unit
let apply_local () =
  let call f x = f x
  let apply_it h = h ()
  call (fun x -> x) ()
  apply_it say

//~ FLICK-T003 @36:12-36:15 expected `Unit -> _`, found `Unit ->{Log} Unit`
