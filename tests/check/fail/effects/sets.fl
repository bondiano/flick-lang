// What a set of services and errors refuses.
module App.Sets exposing (..)

type error Boom = Boom

type error Oops = Oops

service Log =
  info : String ->{} Unit

service Users =
  get : String ->{} String

type alias Env = {Log, Users}

type alias Errs = {Boom}

type alias Mixed = {Log; Boom}

type alias Open r = {Log | r}

type alias Time = Log

no_dots : Unit ->{Env} Unit
let no_dots () = Log.info "a"

no_dots_errors : Unit ->{; Errs} Unit
let no_dots_errors () = ()

no_dots_in_omit : Unit ->{...Env, -Env} Unit
let no_dots_in_omit () = ()

dots_on_element : Unit ->{...Log} Unit
let dots_on_element () = ()

dots_on_alias_of_element : Unit ->{...Time} Unit
let dots_on_alias_of_element () = ()

dots_in_omit_on_element : Unit ->{...Env, -...Log} Unit
let dots_in_omit_on_element () = ()

dots_on_variable : Unit ->{...r} Unit
let dots_on_variable () = ()

dots_on_open : Unit ->{...Open r} Unit
let dots_on_open () = ()

omit_absent : Unit ->{...Env, -Async} Unit
let omit_absent () = ()

omit_absent_of_set : Unit ->{...Env, -...Mixed} Unit
let omit_absent_of_set () = ()

omit_from_variable : Unit ->{-Log | r} Unit
let omit_from_variable () = ()

omit_error_before_semi : Unit ->{...Mixed, -Boom} Unit
let omit_error_before_semi () = ()

added_and_omitted : Unit ->{Users, ...Env, -Users} Unit
let added_and_omitted () = ()

services_after_semi : Unit ->{; ...Env} Unit
let services_after_semi () = ()

errors_in_a_layer : Layer {...Mixed} none {Users} -> Int
let errors_in_a_layer _ = 1

semi_in_captures : Int^{s; t} -> Int
let semi_in_captures n = n

spread_in_captures : Int^{...s} -> Int
let spread_in_captures n = n

semi_in_error_position : Eff none {Log; Boom} Int -> Int
let semi_in_error_position _ = 1

opaque type alias Hidden = {Log}

// a set holds what it names, so what it does not name is still refused
outside : Unit ->{...Mixed} Unit
let outside () = from_result (Err Oops)

missing_service : Unit ->{...Mixed} String
let missing_service () = Users.get "a"

taken_out : Unit ->{...Env, -Log} Unit
let taken_out () = Log.info "a"

// one element of each name, as in any row
type alias Scoped s = {Scope s}

two_regions : Unit ->{...Scoped s, ...Scoped t} Unit
let two_regions () = ()

// rows stay invariant under another constructor
narrow_list : List (Eff {...Mixed} none Unit) -> List (Eff {Log, Users; Boom} none Unit)
let narrow_list tasks = tasks

// a set cannot hold itself
type alias Loop = {...Loop}

