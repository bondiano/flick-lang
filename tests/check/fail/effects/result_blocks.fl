module App.ResultBlocksFail exposing (..)

type error NotFound = NotFound Int

type error Timeout = Timeout

service Users =
  get : Int ->{; NotFound} String

// R04: wrong error annotation blames failing call inside body
wrong_error : Unit ->{} Result NotFound Int
let wrong_error () = result { Fail.fail Timeout }

// R04: dropping unknown open tail `e`
drop_tail : forall e a. (Unit ->{; e} a) ->{} Result Never a
let drop_tail f = result { f () }

// R04: non-error result type
bad_err_type : Unit ->{} Result String Int
let bad_err_type () = result { 42 }

// R08: `Result String a` with `?` inside `result { ... }`
bad_question_result : Result String Int ->{} Result Never Int
let bad_question_result r = result { r? }

// R08: `Option a` with `?` inside `result { ... }`
bad_question_option : Option Int ->{} Result Never Int
let bad_question_option o = result { o? }

// R09: pure arrow rejects `result { ... }` even with empty rows
pure_fn : Unit -> Result Never Int
let pure_fn () = result { 1 }

// R09: top-level value rejects `result { ... }`
top_level : Result Never Int
let top_level = result { 1 }

// R17: empty `result {}` rejected
empty_block : Unit ->{} Result Never Unit
let empty_block () = result {}

// R17: trailing `let` inside `result { ... }` rejected
trailing_let : Unit ->{} Result Never Unit
let trailing_let () = result {
  let x = 1
}

// Migration: callable `result` applied to record without parens
record_call_migration : ({ field : Int } -> Int) -> Int
let record_call_migration result = result { field = 1 }

// Missing service blames the call inside body
missing_service : Int ->{} Result NotFound String
let missing_service id = result { Users.get id }

// Cross-feature: unhandled error from `catch` inside `result` blames expected `Result` type
nested_catch_wrong_error : Unit ->{} Result NotFound Int
let nested_catch_wrong_error () = result {
  Fail.fail Timeout catch
  | NotFound _ -> 0
}

// Cross-feature: Option `?` inside `catch` inside `result` hits the `catch` boundary
option_question_in_nested_catch : Option Int ->{} Result NotFound Int
let option_question_in_nested_catch o = result {
  o? catch
  | NotFound _ -> 0
}

