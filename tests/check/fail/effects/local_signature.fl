// A local function without a signature is FLICK-T004 alone: the rows of the
// enclosing declaration, still gathering its calls, stay open, so the
// service called after it fits the signature (X3).
module App.LocalSignature exposing (..)

service Log =
  log : String ->{} Unit

service Counter =
  next : Unit ->{} Int

logger : Log.Impl
let logger = { log = fun _ -> () }

program : Unit ->{Counter;} Int
let program () = provide (Layer.succeed Log logger) {
  let _ =
    try await (task { 0 }) with
    | _ ->
      let zero = fun _ -> 0
      zero ()
  Counter.next ()
}

//~ FLICK-T004 @20:7-20:28 function `zero` needs a signature right above its `let`
