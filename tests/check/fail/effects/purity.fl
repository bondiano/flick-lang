module App.Purity exposing (..)

service Users =
  get : Number ->{} String

pure_get : Number -> String
let pure_get id = Users.get id

tick : Unit ->{} Number
let tick () = 0

empty_rows : Unit -> Number
let empty_rows () = tick ()

callback : (Number -> String) -> String
let callback f = f 1

bad_callback : Unit -> String
let bad_callback () = callback (fun id -> Users.get id)

as_pure : Unit -> String
let as_pure () = callback Users.get

let started = tick ()

late : Number -> Number ->{Users; none} String
let late a b = Users.get (a + b)

early : Number ->{Users; none} (Number -> String)
let early = late

partial_late : Number ->{Users; none} String
let partial_late = late 1

partial_early : Number -> String
let partial_early = early 1

