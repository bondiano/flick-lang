module App.Purity exposing (..)

service Users =
  get : Float ->{} String

pure_get : Float -> String
let pure_get id = Users.get id

tick : Unit ->{} Float
let tick () = 0

empty_rows : Unit -> Float
let empty_rows () = tick ()

callback : (Float -> String) -> String
let callback f = f 1

bad_callback : Unit -> String
let bad_callback () = callback (fun id -> Users.get id)

as_pure : Unit -> String
let as_pure () = callback Users.get

let started = tick ()

late : Float -> Float ->{Users; none} String
let late a b = Users.get (a + b)

early : Float ->{Users; none} (Float -> String)
let early = late

partial_late : Float ->{Users; none} String
let partial_late = late 1

partial_early : Float -> String
let partial_early = early 1

