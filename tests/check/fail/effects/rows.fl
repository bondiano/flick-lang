module App.Rows exposing (..)

type alias UserId = Number

type alias User = { id : UserId; name : String }

type error NotFound = NotFound UserId

type error ConnectError = ConnectError String

service Config =
  url : Unit ->{} String

service Log =
  info : String ->{} Unit

service Users =
  get : UserId ->{; NotFound} User

narrow : UserId ->{Users; none} String
let narrow id =
  let user = Users.get id
  Log.info user.name
  user.name

users_live : Layer {Config} {ConnectError} {Users}
foreign pure users_live from "./users.js" "usersLive"

load_name : UserId ->{Users, Log; NotFound} String
let load_name id =
  let user = Users.get id
  Log.info user.name
  user.name

application : UserId ->{Log; NotFound} String
let application id =
  provide users_live {
    load_name id
  }

load_guarded : UserId ->{Users; none} Option User
let load_guarded id =
  try
    Some (Users.get id)
  with
  | NotFound missing when missing > 0 -> None

load_partial : UserId ->{Users; none} Option User
let load_partial id =
  try
    Some (Users.get id)
  with
  | NotFound 0 -> None

narrow_task : UserId -> Eff none none User
let narrow_task id = task { Users.get id }

lenient : Result String Number ->{} Number
let lenient result = from_result result

not_an_error : Unit ->{} Number
let not_an_error () =
  try
    1
  with
  | Some x -> x

no_layer : Unit ->{} Number
let no_layer () = provide 1 { 2 }

type error Failed e = Failed e

service Jobs =
  count : Number ->{; Failed Number} Number
  label : Number ->{; Failed String} String

mixed : Number ->{Jobs; Failed Number} Number
let mixed n =
  let _ = Jobs.label n
  Jobs.count n

both : Number ->{Jobs; Failed Number, Failed String} Number
let both n = Jobs.count n

