module App.Form exposing (..)

type alias Signup = { name : String; tags : List String }
  deriving Schema, Form
//~ FLICK-D010 @4:3-4:24 `Signup.tags`: a form field is a `String`, a `Float`, a `Bool`, a refined type over them or an `Option` of one

type alias Login = { user : String }
  deriving Schema, Form

type Choice = Yes | No
  deriving Schema, Form
//~ FLICK-D010 @11:3-11:24 `Choice`: a form is of a record type

type alias Bare = { name : String }
  deriving Form
//~ FLICK-D010 @14:1-15:16 `Bare`: a type that derives `Form` derives `Schema` too

login : Form.Draft Login
let login = Form.draft Login.form

typo : Ui
let typo = Form.input login Login.fields.usr "User" None
//                          ^^^^^^^^^^^^^^^^ FLICK-T003 `{ user : Field }` has no field `usr`
