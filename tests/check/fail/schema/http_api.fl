module App.Api exposing (..)

import HttpApi.Derive exposing (..)

type alias Item = { id : String }
  deriving Schema

type alias Opaque = { id : String }

type error Gone = Gone
  deriving Schema

type error Teapot = Teapot
  deriving Schema

instance Problem Gone =
  let problem = { status = 410; body = Codec.json (schema Gone) }

type alias Params = {
  item : Get "/items/:id/:rev" { path : Item } Item {Gone};
} deriving HttpApi

type alias Parts = {
  item : Get "/items" { body : Item } Item {};
} deriving HttpApi

type alias Codecless = {
  item : Get "/items" {} Opaque {};
} deriving HttpApi

type alias Problemless = {
  item : Get "/items" {} Item {Teapot};
} deriving HttpApi

type alias Mixed = {
  item : Authed (Get "/items" {} Item {Gone});
  other : Get "/other" {} Item {};
} deriving HttpApi

type alias NotAnEndpoint = {
  item : Item;
} deriving HttpApi

type Variant = Variant
  deriving HttpApi

type alias Twice = {
  item : Get "/items/:id" { path : Item; path : Item } Item {};
} deriving HttpApi

//~ FLICK-C001 @20:3-20:59 `PathParams "/items/:id/:rev" { id : String }` does not hold: the path `/items/:id/:rev` has the parameters `id`, `rev`, and its `path` part the fields `id`
//~ std/D011 @24:3-24:46 `Parts.item`: `body` is not a part of a request: `path`, `query`, `headers` or `payload`
//~ FLICK-D011 @28:26-28:32 `Opaque` has no codec: name a `PureCodec Json` of it after it in its module, or derive `Schema`
//~ FLICK-C001 @32:3-32:39 no instance for `Problem Teapot`; instances of `Problem`: `Problem Gone`
