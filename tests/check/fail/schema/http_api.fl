module App.Api exposing (..)

import HttpApi.Derive exposing (..)

type alias Item = { id : String }
  deriving Schema

type alias Opaque = { id : String }

type error Gone = Gone
  deriving Schema

type error Teapot = Teapot
  deriving Schema

instance Problem Gone =
  let problem = { status = 410; body = Codec.json (schema Gone) }

type alias Params = {
  item : Get "/items/:id/:rev" { path : Item } Item {Gone};
} deriving HttpApi

type alias Parts = {
  item : Get "/items" { body : Item } Item {};
} deriving HttpApi

type alias Codecless = {
  item : Get "/items" {} Opaque {};
} deriving HttpApi

type alias Problemless = {
  item : Get "/items" {} Item {Teapot};
} deriving HttpApi

type alias Mixed = {
  item : Authed (Get "/items" {} Item {Gone});
  other : Get "/other" {} Item {};
} deriving HttpApi

type alias NotAnEndpoint = {
  item : Item;
} deriving HttpApi

type Variant = Variant
  deriving HttpApi

