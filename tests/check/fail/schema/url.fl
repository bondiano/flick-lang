module App.Url exposing (..)

type Page = Front | Tags (List String)
  deriving Schema, Url
//~ FLICK-D009 @4:3-4:23 `Page.Tags[0]`: a segment is a `String`, a `Number`, a `Bool` or a refined type over them

type Lookup = Lookup { tags : List String }
  deriving Schema, Url
//~ FLICK-D009 @8:3-8:23 `Lookup.Lookup[0].tags`: a query parameter is a segment's type or an `Option` of one

type alias Query = { q : String }
  deriving Schema, Url
//~ FLICK-D009 @12:3-12:23 `Query`: a route type is a variant type

type Root = Index | Home
  deriving Schema, Url
//~ FLICK-D009 @16:3-16:23 `Root.Home`: its URLs are those of `Index`

type Bare = Bare Number
  deriving Url
//~ FLICK-D009 @19:1-20:15 `Bare`: a type that derives `Url` derives `Schema` too
