module App.Codecs exposing (..)

import Codec exposing (plugin codec)

type File (s : Region)

type alias Profile = { email : String; nickname : Option String }
  deriving Schema

type alias Session = {
  name : String;
  handler : Float -> Float;
} deriving Schema
//~ std/D001 @13:12-13:18 `Session.handler`: a field of type `Float -> Float` has no Schema witness

type alias Cell = { value : Ref Float }
  deriving Schema
//~ std/D001 @17:12-17:18 `Cell.value`: a field of type `Ref Float` has no Schema witness

type Holder s = Holder (File s)
  deriving Schema
//~ std/D001 @21:12-21:18 a scoped resource has no wire form

type Plain = Plain Float

plain : Schema Plain
let plain = schema Plain
//          ^^^^^^^^^^^^ FLICK-D001 `Plain` derives no Schema

missing : PureCodec Json Profile
let missing =
  codec (schema Profile) {
    email = field "email" String.json;
  }
//~ std/D002 @32:3-34:4 the codec misses the field `nickname`

twice : PureCodec Json Profile
let twice =
  codec (schema Profile) {
    email = field "email" String.json;
    email = field "mail" String.json;
    nickname = optional_field "nickname" String.json;
  }
//~ std/D003 @41:5-41:37 `email` is given twice

unknown : PureCodec Json Profile
let unknown =
  codec (schema Profile) {
    email = field "email" String.json;
    nickname = optional_field "nickname" String.json;
    age = field "age" Float.json_finite;
  }
//~ std/D004 @51:5-51:40 the record has no field `age`

clash : PureCodec Json Profile
let clash =
  codec (schema Profile) {
    email = field "name" String.json;
    nickname = optional_field "name" String.json;
  }
//~ std/D005 @59:16-59:49 the wire name "name" is already a field's

type Shape = Dot | Line Float
  deriving Schema

shapes : PureCodec Json Shape
let shapes =
  codec (schema Shape) {
    x = field "x" Float.json_finite;
  }
//~ std/D007 @68:9-68:23 a `codec` block describes a record, but this is a schema of `Shape`

wrong : PureCodec Json Profile
let wrong =
  codec (schema Profile) {
    email = field "email" Float.json_finite;
    nickname = optional_field "nickname" String.json;
  }
//~ std/D012 @76:5-76:44 `email` is a `String`, but its codec decodes `Float`

service Directory =
  lookup : Unit ->{; SchemaError} String

effectful : PureCodec Json Profile
let effectful =
  codec (schema Profile) {
    email = field "email" String.json |> on_missing_effect (fun () -> Directory.lookup ());
    nickname = optional_field "nickname" String.json;
  }
//~ FLICK-T003 @86:3-89:4 expected `PureCodec Json Profile`, found `Codec

general : Codec {Directory} none Json Profile
let general =
  codec (schema Profile) {
    email = field "email" String.json |> on_missing_effect (fun () -> Directory.lookup ());
    nickname = optional_field "nickname" String.json;
  }

as_pure : PureCodec Json Profile
let as_pure = general
//            ^^^^^^^ FLICK-T003

refined type Port = Float where fun n -> n > 0 && n < 65536

bad_port : Result SchemaError Port
let bad_port = Port.parse 70000
//                        ^^^^^ FLICK-D006 fails the check of `Port`

good_port : Result SchemaError Port
let good_port = Port.parse 8080
