module App.Codecs exposing (..)

type File (s : Region)

type alias Profile = { email : String; nickname : Option String }
  deriving Schema

type alias Session = {
  name : String;
  handler : Float -> Float;
} deriving Schema
//~ std/D001 @11:12-11:18 `Session.handler`: a field of type `Float -> Float` has no Schema witness

type alias Cell = { value : Ref Float }
  deriving Schema
//~ std/D001 @15:12-15:18 `Cell.value`: a field of type `Ref Float` has no Schema witness

type Holder s = Holder (File s)
  deriving Schema
//~ std/D001 @19:12-19:18 a scoped resource has no wire form

type Plain = Plain Float

plain : Schema Plain
let plain = schema Plain
//          ^^^^^^^^^^^^ FLICK-D001 `Plain` derives no Schema

missing : PureCodec Json Profile
let missing =
  codec (schema Profile) {
    email = field "email" String.json;
  }
//~ FLICK-D002 @30:3-32:4 the codec misses the field `nickname`

twice : PureCodec Json Profile
let twice =
  codec (schema Profile) {
    email = field "email" String.json;
    email = field "mail" String.json;
    nickname = optional_field "nickname" String.json;
  }
//~ FLICK-D003 @39:5-39:37 `email` is given twice

unknown : PureCodec Json Profile
let unknown =
  codec (schema Profile) {
    email = field "email" String.json;
    nickname = optional_field "nickname" String.json;
    age = field "age" Float.json_finite;
  }
//~ FLICK-D004 @49:5-49:40 the record has no field `age`

clash : PureCodec Json Profile
let clash =
  codec (schema Profile) {
    email = field "name" String.json;
    nickname = optional_field "name" String.json;
  }
//~ FLICK-D005 @57:16-57:49 the wire name "name" is already a field's

service Directory =
  lookup : Unit ->{; SchemaError} String

effectful : PureCodec Json Profile
let effectful =
  codec (schema Profile) {
    email = field "email" String.json |> on_missing_effect (fun () -> Directory.lookup ());
    nickname = optional_field "nickname" String.json;
  }
//~ FLICK-E002 @67:71-67:90 does not allow service `Directory`

general : Codec {Directory} none Json Profile
let general =
  codec (schema Profile) {
    email = field "email" String.json |> on_missing_effect (fun () -> Directory.lookup ());
    nickname = optional_field "nickname" String.json;
  }

as_pure : PureCodec Json Profile
let as_pure = general
//            ^^^^^^^ FLICK-T003

refined type Port = Float where fun n -> n > 0 && n < 65536

bad_port : Result SchemaError Port
let bad_port = Port.parse 70000
//                        ^^^^^ FLICK-D006 fails the check of `Port`

good_port : Result SchemaError Port
let good_port = Port.parse 8080
