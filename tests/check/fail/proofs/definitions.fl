// What the domain keeps out of a proof: recursion, direct or through a
// group, a diverging argument a function ignores, a partial function
// inside a value, `todo` and foreign code. The definitions themselves are
// ordinary code; only the proofs that name them fail.
module App.Diverging exposing (..)

countdown : Int -> Bool
let rec countdown n = countdown n

forever : Unit -> Option Bool
let rec forever () = forever ()

rec {
  ping : Bool -> Bool
  let ping b = pong b

  pong : Bool -> Bool
  let pong b = ping b
}

later : Unit -> Bool
let later () = todo

flip : Bool -> Bool
foreign pure flip from "./flip.mjs" "flip"

proof direct (n : Int) where equal (countdown n) (countdown n) = refl

proof hidden (b : Bool) where equal (ping b) (ping b) = refl

proof ignored where equal ((fun _ -> None) (forever ())) None = refl

proof unfinished where equal (later ()) true = refl

proof partial_inside
where equal (Some (fun n -> countdown n)) (Some (fun n -> countdown n)) = refl

proof through_ffi (b : Bool) where equal (flip (flip b)) b = refl

