// The words of a table's columns: a SQL type the dialect knows, then
// attributes that do not contradict each other, each column once. A wrong
// column is left out of the table, which is still declared.
module App.Tables exposing (..)

sql table Users "users" {
  id : bigint primary key generated always as BigInt
  name : text default generated always as String
  email : text not null nope as String
  id : bigint as BigInt
  age : tinyint as Int
}

//~ std/Q010 @8:23-8:39 `generated always` contradicts `default` before it
//~ std/Q010 @9:25-9:29 unknown column attribute `nope`
//~ std/Q001 @10:3-10:24 the table has two columns `id`
//~ std/Q010 @11:9-11:16 unknown SQL type `tinyint`; known: bigint, int8, bigserial, integer, int, int4, smallint, int2, serial, real, double precision, float8, numeric, decimal, text, varchar, character varying, uuid, boolean, bool, date, timestamp, timestamptz, jsonb, json
