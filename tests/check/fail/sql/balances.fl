// The balances scenario, broken one rule at a time: what the SQL
// elaboration refuses besides the cases of `queries.fl`. Running a
// template needs `Sql.bind` first.

import Sql exposing (Pg, EncodeError, DbError, DecodeError, plugin sql)
import Database exposing (Database)
import BigDecimal exposing (BigDecimal)

type UserId = UserId BigInt

user_id_codec : PureCodec BigInt UserId
let user_id_codec = Sql.codec (fun n -> Ok (UserId n)) (fun (UserId n) -> n)

sql table Users "users" {
  id : bigint primary key generated always as UserId via user_id_codec
  name : text not null as String
}

sql table Accounts "accounts" {
  id : bigint primary key generated always as BigInt
  user_id : bigint not null as UserId via user_id_codec
  balance : numeric not null as BigDecimal
}

plain : Sql.Template Pg {} { balance : BigDecimal }
let plain =
  sql {
    from u in Users;
    left_join a in Accounts on a.user_id == u.id;
    select { balance = a.balance }
  }
//~ FLICK-T003 @27:3-31:4 `Option BigDecimal` is not `BigDecimal`

mistyped : Sql.Template Pg { owner : UserId } {}
let mistyped = sql p { insert_into Accounts; values { user_id = p.owner; balance = "ten" } }
//                                                                                 ^^^^^ FLICK-T003 expected `BigDecimal`, found `String`

dialect : Sql.Template Pg {} { name : String }
let dialect = sql { from u in Users; select { name = ifnull u.name "nobody" } }
//                                                   ^^^^^^ std/Q010 `ifnull` is not a SQL function

raw_id : Sql.Template Pg { user_id : BigInt } { name : String }
let raw_id = sql p { from u in Users; where u.id == p.user_id; select { name = u.name } }
//           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ FLICK-T003 found `Template Pg { user_id : UserId } { name : String }`

listed : List UserId -> Sql.Template Pg {} { name : String }
let listed ids = sql { from u in Users; where $ids == $ids; select { name = u.name } }
//                                            ^^^^ FLICK-C001 no instance for `Param (List UserId) _`
//                                                    ^^^^ FLICK-C001 no instance for `Param (List UserId) _`

unbound : Unit ->{Async, Database; EncodeError, DbError, DecodeError} List { name : String }
let unbound () = Database.query (sql { from u in Users; select { name = u.name } })
//                               ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ FLICK-T003 expected `Query Pg _`, found `Template Pg {} { name : String }`
