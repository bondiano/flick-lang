module App.Unused exposing (net, Shape(..), first, area, sum_with)

import List exposing (map, filter)
//                         ^^^^^^ FLICK-R012 `filter` is imported but never used
import String
//     ^^^^^^ FLICK-R012 `String` is imported but never used
import Float exposing (abs)

type Shape = Circle Float | Square Float

net : Float -> Float
let net price = helper price 0.8

helper : Float -> Float -> Float
let helper p rate = p * rate

// private values that only use each other are still unused
gross : Float -> Float
let gross price = Float.abs price
//  ^^^^^ FLICK-R014 `gross` is never used

area : Shape -> Float
let area shape =
  match shape with
  | Circle _radius -> 3
  | Square s -> s * s

first : (a, b) -> { name : String } -> List a
let first (a, b) { name } = map (fun x -> a) []
//            ^ FLICK-R013 `b` is never used
//                 ^^^^ FLICK-R013 `name` is never used
//                                   ^ FLICK-R013 `x` is never used

sum_with : List Float -> List Float
let sum_with xs =
  let unused = 1
  //~ FLICK-R013 @36:7-36:13 `unused` is never used
  List.map (fun x -> abs x) xs
//~ FLICK-T052 @38:12-38:28 a `fun` that only passes `x` on: `abs` is the same function
