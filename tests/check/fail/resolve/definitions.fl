module App.Definitions exposing (Status(..), Id(..), Name(..), missing, Gone, Alias(..), load, Show(..))

import App.Text exposing (trim, Text)

type Status = Active | Disabled
type Mode = Active | Off
//          ^^^^^^ FLICK-R008 `Active` is defined more than once

opaque type Id = Id String
//~ FLICK-R011 @1:46-1:52 opaque type `Id` cannot export its constructors

type alias Name = String
//~ FLICK-R011 @1:54-1:62 `Name` has no constructors to export
//~ FLICK-R011 @1:64-1:71 cannot export `missing`
//~ FLICK-R011 @1:73-1:77 cannot export `Gone`

type alias Alias = Number
//~ FLICK-R011 @1:79-1:88 `Alias` has no constructors

load : Number -> Number
let load n = n

load : Number -> Number
//~ FLICK-R008 @23:1-23:5 `load` is defined more than once
let load n = n + 1
//  ^^^^ FLICK-R008 `load` is defined more than once

trim : String -> String
let trim s = s
//  ^^^^ FLICK-R009 `trim` shadows the name imported from `App.Text`

class Show a =
  show : a -> String
