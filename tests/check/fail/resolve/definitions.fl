module App.Definitions exposing (
  Status(..),
  Id(..),
  Name(..),
  missing,
  Gone,
  Alias(..),
  load,
  Show(..),
)

import App.Text exposing (trim, Text)

type Status = Active | Disabled
type Mode = Active | Off
//          ^^^^^^ FLICK-R008 `Active` is defined more than once

opaque type Id = Id String
//~ FLICK-R011 @3:3-3:9 opaque type `Id` cannot export its constructors

type alias Name = String
//~ FLICK-R011 @4:3-4:11 `Name` has no constructors to export
//~ FLICK-R011 @5:3-5:10 cannot export `missing`
//~ FLICK-R011 @6:3-6:7 cannot export `Gone`

type alias Alias = Float
//~ FLICK-R011 @7:3-7:12 `Alias` has no constructors

load : Float -> Float
let load n = n

load : Float -> Float
//~ FLICK-R008 @32:1-32:5 `load` is defined more than once
let load n = n + 1
//  ^^^^ FLICK-R008 `load` is defined more than once

trim : String -> String
let trim s = s
//  ^^^^ FLICK-R009 `trim` shadows the name imported from `App.Text`

class Show a =
  show : a -> String
