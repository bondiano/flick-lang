module App.Implicit exposing (..)

type A = A
type B = B
type C = C
type D = D
type E = E

instance Into D E =
  let into _ = E

plain : E
let plain = D

@implicit
instance Into A B =
  let into _ = B

@implicit
instance Into B C =
  let into _ = C

chain : C
let chain = A

class Convert a b =
  convert : a -> b

@derive implicit
instance Convert D E =
  let convert _ = E

derived_attribute : E
let derived_attribute = D

@implicit
instance Convert A B =
  let convert _ = B

ambiguous : B
let ambiguous = A

@implicit
instance Eq D => Into D C =
  let into _ = C

@implicit
