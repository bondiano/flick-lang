// `deriving` a class of defaults gives an instance without methods: one
// whose default needs what a type lacks, a class with a method without a
// default and a class of two parameters derive nothing.
module App.DeriveDefaults exposing (..)

import Generic exposing (Generic(..), Con(..))

class Default a =
  default : a
  default : (Generic a rep, GDefault rep) => a
  let default = from_rep gdefault

class GDefault rep =
  gdefault : rep

instance GDefault Unit =
  let gdefault = ()

instance GDefault fields => GDefault (Con n fields) =
  let gdefault = Con gdefault

type Empty = Empty
  deriving Default

type Point = Point Float
  deriving Default

class Pretty a =
  pretty : a -> String
  verbose : a -> String
  let verbose x = pretty x

type Plain = Plain
  deriving Pretty

class Convert a b =
  convert : a -> b

type Unit2 = Unit2
  deriving Convert

empty : Empty
let empty = default


