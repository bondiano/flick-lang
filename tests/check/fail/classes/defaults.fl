module App.Defaults exposing (..)

class Pretty a =
  pretty : a -> String
  verbose : a -> String
  let verbose x = "<" ++ pretty x ++ ">"
  let extra x = "?"
//~ FLICK-C011 @7:3-7:20 `extra` is not a method of class `Pretty`

instance Pretty Float =
  //~ FLICK-C011 @10:10-10:22 `Pretty Float` lacks method `pretty`

  let verbose n = "number"
