// A default signature repeats its method's signature with constraints of
// its own: same type, no constraints of the method's, none on the method's
// variables, one per method, and a default to go with it; an instance that
// takes the default satisfies them.
module App.DefaultSignatures exposing (..)

class Describe a =
  describe : a -> String
  describe : Show a => a -> Float
  let describe x = show x

class Tagged a =
  tagged : Show b => a -> b -> String
  tagged : (Show a, Show b) => a -> b -> String
  let tagged x y = show x ++ show y

class Paired a =
  paired : a -> b -> String
  paired : Show b => a -> b -> String
  let paired _ y = show y

class Twice a =
  twice : a -> String
  twice : Show a => a -> String
  twice : Eq a => a -> String
  let twice x = show x

class Lone a =
  lone : a -> String
  lone : Show a => a -> String

class Shown a =
  shown : a -> String
  shown : Show a => a -> String
  let shown x = show x

type Opaque = Opaque

instance Shown Opaque

