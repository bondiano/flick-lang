// Instances are canonical: no overlap, consistent functional dependencies,
// strict coverage, a context that shrinks, acyclic superclasses.
module App.Coherence exposing (..)

type User = User String

type UserSet = UserSet (List User)

class Collection c a | c -> a =
  empty : c

instance Collection UserSet User =
  empty : UserSet
  let empty = UserSet []

instance Collection UserSet String =
  empty : UserSet
  let empty = UserSet []

instance Collection (List a) b =
  empty : List a
  let empty = []

class Describe a =
  describe : a -> String

instance Describe a => Describe (List a) =
  describe : List a -> String
  let describe items = "list"

instance Describe (List Float) =
  describe : List Float -> String
  let describe items = "numbers"

type Wrap a = Wrap a

instance Describe (List a) => Describe (Wrap a) =
  describe : Wrap a -> String
  let describe w = "wrap"

type Pair a = Pair a a

instance Describe b => Describe (Pair a) =
  describe : Pair a -> String
  let describe p = "pair"

class Second a => First a

class First a => Second a

// two aliases of one form share the structural instance
type alias Point = { x : Float; y : Float }

type alias Coords = { y : Float; x : Float }

instance Eq Point =
  eq : Point -> Point -> Bool
  let eq p q = true

class Show a => Pretty a =
  pretty : a -> String

type Secret = Secret String

instance Pretty Secret =
  pretty : Secret -> String
  let pretty s = "***"

