// A constraint needs an instance, an assumption of the signature, or a
// known type to choose by; candidates are listed.
module App.Resolution exposing (..)

type Shape = Circle Float

type User = User String

type UserSet = UserSet (List User)

class Collection c a | c -> a =
  empty : c

instance Collection UserSet User =
  empty : UserSet
  let empty = UserSet []

no_instance : String
let no_instance = show (Circle 1)

no_function_show : String
let no_function_show = show (fun x -> x + 1)

ambiguous : String
let ambiguous = show []

not_required : a -> String
let not_required x = show x

wrong_element : List Float
let wrong_element = empty

nested : List (Option Shape) -> String
let nested items = show items

open_record : { name : String | r } -> String
let open_record value = show value

type alias L1 a = List (List (List (List a)))
type alias L2 a = L1 (L1 (L1 (L1 a)))
type alias L3 a = L2 (L2 (L2 (L2 a)))
type alias L4 a = L3 (L3 (L3 (L3 a)))

// an artificially deep constraint runs into the depth budget
too_deep : L4 Float -> String
let too_deep value = show value

