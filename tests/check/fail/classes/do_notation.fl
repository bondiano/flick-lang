module App.DoErrors exposing (..)

// The rest of a `do` block is a pure function: a runtime call there is an
// error with the way out.
logged : Float -> Option Float
let logged n =
  do {
    x <- Some n
    Platform.stdout_line "no"
    pure x
  }

// A pattern after `<-` must match every value.
values : List (Option Float) -> List Float
let values xs =
  do {
    Some x <- xs
    pure x
  }

// The block ends with an expression, not a binding or a `let`.
dangling : Option Float -> Option Float
let dangling o =
  do {
    _x <- o
  }

trailing_let : Option Float -> Option Float
let trailing_let o =
  do {
    x <- o
    let _y = x
  }

// A guard needs `Alternative`, and `Result e` has none: there is no error
// to fail with.
guarded : Float -> Result String Float
let guarded n =
  do {
    if n > 0
    Ok n
  }

