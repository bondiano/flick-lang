module App.NumericClasses exposing (..)

import Numeric exposing (Numeric)

type Meters = Meters Float

instance Numeric Meters =
  let add a b = a

unconstrained : a -> a
let unconstrained x = x + x

integral : Numeric a => a -> a
let integral x = x * 0.5

huge : Numeric a => a -> a
let huge x = x + 3000000000

