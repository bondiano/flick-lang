// `Into` has only conversions that lose nothing, and its target comes from
// the place of `into`: without one no instance can be chosen.
module App.Into exposing (..)

lossy : Float -> Int
let lossy x = into x

unknown : Int -> String
let unknown n = into n

let unknown_target = show (into 1)

