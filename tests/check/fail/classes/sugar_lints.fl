module App.Sugar exposing (..)

// A binding only returned is the bound computation.
firsts : Option Float -> Option Float
let firsts o = do { x <- o; pure x }

// A whole infinite sequence never ends.
all_naturals : List Int
let all_naturals = Seq.from 1 |> Seq.map (fun n -> n * 2) |> Seq.to_list

// A forced `for` is a strict `[for …]`.
forced : List Float -> List Float
let forced xs = Seq.to_list (for { x <- xs } yield x + 1)

// A filter piped into a map is one comprehension.
piped : List Float -> List Float
let piped xs = xs |> List.filter (fun x -> x > 1) |> List.map (fun x -> x * 10)

// `do` over `Eff` is a `task` with direct calls.
both : Eff none none Float
let both =
  do {
    x <- pure 40
    y <- pure 2
    pure (x + y)
  }

// Nested binds are one `do`.
chained : Option Float -> Option Float -> Option Float
let chained a b = Option.bind (fun x -> Option.bind (fun y -> Some (x + y)) b) a

