// Context coverage does not invent a seed, reverse an FD or relax C007.
module App.FdCoverage exposing (..)

type Wrap a = Wrap a
type alias Erased a = Float

class Base a b | a -> b
class Reverse a b | b -> a
class Noise a b
class Join a b c | a b -> c
class Global a | -> a

class NoContext key output | key -> output
instance NoContext (Wrap a) b

class Unrelated key output | key -> output
instance Noise a b => Unrelated (Wrap a) b

class WrongWay key output | key -> output
instance Reverse a b => WrongWay (Wrap a) b

class Disconnected key left right | key -> left right
instance (Base b c, Base c b) => Disconnected (Wrap a) b c

class Partial key left right | key -> left right
instance Join a b c => Partial (Wrap a) b c

class Independent left right output | left -> output, right -> output
instance Base a c => Independent (Wrap a) (Wrap b) c

class Erasure key output | key -> output
instance Base a b => Erasure (Wrap (Erased a)) (a, b)

class Own key output | key -> output, output -> key
instance Own (Wrap a) b

instance Global a

class Missing key
instance Noise a b => Missing (Wrap a)

class EqualSize left right
instance Noise a b => EqualSize a b

class Occurrences key
instance Noise a a => Occurrences (Wrap a)

