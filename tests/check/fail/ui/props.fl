// What the UI library refuses: props that are not exactly the record,
// state read while rendering, a handler without a policy, a handler that
// escapes the scope of a file it holds, a select whose fields disagree on
// the item, a string where a checked URL is needed and a policy bound that
// is not a positive integer.
module App.Props exposing (..)

type error SaveError = SaveError String

type alias User = { id : Float; name : String }

type alias Product = { sku : String }

saved : Atom.Writable String
let saved = Atom.make ""

noop : Ui.Handler Ui.ClickSnapshot
let noop = Ui.Event.exhaust (fun _ -> task { Atom.set saved "x" })

typo : Ui
let typo = Ui.button { disabled = false; on_clik = noop } []
//                   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ FLICK-T003 the value has field `on_clik`

missing : Ui
let missing = Ui.button { on_click = noop } []
//                      ^^^^^^^^^^^^^^^^^^^ FLICK-T003 field `disabled` is missing

wrong : Ui
let wrong = Ui.button { disabled = "no"; on_click = noop } []
//                                 ^^^^ FLICK-T003 expected `Bool`, found `String`

counter : Ref Float -> Ui
let counter count = Ui.text (show (Ref.get count))
//                                 ^^^^^^^^^^^^^ FLICK-E001 runtime call

no_policy : Ui
let no_policy = Ui.button { disabled = false; on_click = fun _ -> task { Atom.set saved "x" } } []
//                                                       ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ FLICK-T003 expected `Handler

held : forall c. File.Path ->{File.FileSystem; File.OpenError}
  Ui^c
let held path =
  scope {
    let file = File.open_scoped path
    Ui.button
      {
        disabled = false;
        on_click =
          Ui.Event.exhaust
            (
              fun _ -> task { provide File.node { try ignore (File.read_all file) with | _ -> () } }
            );
      }
      []
  }
//~ FLICK-G001 @45:5-54:9 holds region `s`

mixed : Ui.SelectProps User c -> Ui^c
let mixed props =
  Ui.select
    {
      items = props.items;
      selected = props.selected;
      key = props.key;
      render_item = props.render_item;
      on_change = Ui.Event.latest (fun (product : Product) -> task { Atom.set saved product.sku });
    }
//~ FLICK-T003 @66:19-66:99 expected `Handler { id : Float; name : String }

link : Ui
let link = Ui.link { href = "javascript:alert(1)" } [Ui.text "x"]
//                          ^^^^^^^^^^^^^^^^^^^^^ FLICK-T003 expected `SafeUrl`, found `String`

overflow : Ui.Handler Ui.ClickSnapshot
let overflow = Ui.Event.queue 0 (fun _ -> task { Atom.set saved "x" })
//                            ^ FLICK-U001 the capacity of `Ui.Event.queue` must be a positive integer

too_many : Ui.Handler Ui.ClickSnapshot
let too_many = Ui.Event.concurrent 1.5 (fun _ -> task { Atom.set saved "x" })
//                                 ^^^ FLICK-U001 the limit
//                                 ^^^ FLICK-T003 expected `Int`, found `Float`

action_overflow : Action.Action Ui.ClickSnapshot
let action_overflow = Action.queue 0 (fun _ -> task { Atom.set saved "x" })
//                                 ^ FLICK-U001 the capacity of `Action.queue` must be a positive integer
