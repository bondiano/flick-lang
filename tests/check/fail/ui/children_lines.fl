// What the children of an element are not.
module App.ChildrenLinesFail exposing (..)

row : String -> Ui
let row label = ui { item (text label) }

// a list written where the children go one by one
listed : Ui
let listed = ui { heading [text "one"] }

// a list among the children
among : List String -> Ui
let among labels = ui {
  list
    item (text "first")
    List.map row labels
}

// a child that is no `Ui`
number : Ui
let number = ui {
  paragraph
    text "one"
    2
}

// a line under a function that takes no children is one more argument
extra : Ui
let extra = ui {
  text "one"
    text "two"
}

// outside `ui` the lines under a call are its arguments, as everywhere
outside : Ui
let outside =
  Ui.paragraph
    Ui.text "one"
