// `Setup s` belongs to a component's setup, the statements before its last
// expression: a render, a top-level value and a function without it in its
// signature cannot make an instance's state. The setup runs once, so it
// reads no atom, and a render makes no atom of its own.
module App.ComponentSetup exposing (..)

top : Atom.Writable Float
let top = Atom.local 0

helper : Float ->{} Atom.Writable Float
let helper n = Atom.local n

component plain (n : Float) = ui {
  let again = Atom.local n
  text (show (Atom.value again))
}

component counter (start : Float) =
  let count = Atom.local start
  ui {
    let other = Atom.make 0
    text (show (Atom.value count + Atom.value other))
  }

component ticking (n : Float) = ui {
  let _started = Ui.on_mount (task { Platform.stdout_line "tick" })
  text (show n)
}

component once (start : Float) =
  let count = Atom.local start
  let shown = Atom.value count
  ui { text (show shown) }

// a render has no `Ui.Document`, nor does a server: the DOM is reached by tasks
component grabbing () =
  let field : (Ui.Element Ui.Input)^c = Ui.element ()
  ui {
    let _focused =
      try Ui.focus field with
      | Ui.Detached -> ()
    text "grab"
  }

//~ FLICK-E001 @8:11-8:23 module initialization is pure
//~ FLICK-E002 @11:16-11:28 does not allow service `Setup _`
//~ FLICK-U004 @14:15-14:27 before a component's last expression
//~ FLICK-U006 @21:17-21:26 while rendering makes another one
//~ FLICK-U004 @26:18-26:68 service `Setup _` is not allowed here
//~ FLICK-E002 @32:15-32:31 a component's setup runs once per instance
//~ FLICK-U004 @40:11-40:25 reach the DOM in a task
