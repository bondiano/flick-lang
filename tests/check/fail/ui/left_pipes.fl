// A call written with `<|` is the call: the lints of a render see it so.
module App.LeftPipes exposing (..)

count : Atom.Writable Float
let count = Atom.make 0

handler : Ui.View Float
let handler =
  Ui.view <| fun n -> ui {
    button { disabled = false; on_click = Ui.Event.exhaust <| fun _ -> task { Atom.set count n } } (text "set")
  }

states : Ui.View Float
let states =
  Ui.view <| fun n ->
    let local = Atom.make <| n
    ui { text (show (Atom.value local)) }
//~ FLICK-U002 @10:43-10:97 `Ui.Event.exhaust` of a `fun` makes a handler on every render
//~ FLICK-U006 @16:17-16:26 `Atom.make` while rendering makes another one on every render
