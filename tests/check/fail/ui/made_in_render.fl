module App.MadeInRender exposing (..)

count : Atom.Writable Float
let count = Atom.make 0

drafts : Atom.Family Float (Atom.Writable String)
let drafts = Atom.family (fun _ -> Atom.make "")

remove : Action.Action (Float, Ui.ClickSnapshot)
let remove = Action.exhaust (fun (n, _) -> task { Atom.set count n })

states : Ui.View Float
let states =
  Ui.view (fun n ->
    let local = Atom.make n
    let twice = Atom.derived (fun () -> Atom.value local * 2)
    ui { text (show (Atom.get twice)) }
  )

actions : Ui.View Float
let actions =
  Ui.view (fun n -> ui {
    fragment
      button { disabled = false; on_click = Action.exhaust (fun _ -> task { Atom.set count n }) }
        (text "set")

      button { disabled = false; on_click = Action.with remove n } (text "remove")
  })

inner : Ui.View Unit
let inner = Ui.view (fun () -> ui { text "inner" })

views : Ui.View Unit
let views = Ui.view (fun () -> ui { Ui.render (Ui.view (fun () -> ui { text "made" })) () })

row : Float ->{Atom.Read} Ui
let row n =
  let made = Atom.make ""
  ui { Ui.field { bind = made; placeholder = ""; on_input = None } }

keyed : Ui.View Float
let keyed =
  Ui.view (fun id -> ui {
    fragment
      Ui.field { bind = Atom.at drafts id; placeholder = ""; on_input = None }
      Ui.render inner ()
  })

// a handler's task runs on an event, not while rendering
handler : Ui.View Unit
let handler =
  Ui.view (fun () ->
    let reset =
      Ui.Event.exhaust (fun _ -> task {
        let fresh = Atom.make 0
        Atom.set count (Atom.current fresh)
      })
    ui { button { disabled = false; on_click = reset } (text "reset") }
  )

fresh : Float -> Atom.Writable Float
let fresh n = Atom.make n

new_state : Float -> Atom.Writable Float
let new_state = Atom.make

notes : String -> Atom.Writable String
let notes = Atom.serializable_family (Codec.json Schema.string) (fun _ -> Atom.make "")

// a function that makes an atom, called or named, makes one while rendering
through : Ui.View Float
let through =
  Ui.view (fun n ->
    let a = fresh n
    let b = new_state n
    let made = List.map fresh [n]
    ui {
      Ui.field {
        bind = notes "x";
        placeholder = show (Atom.value a + Atom.value b);
        on_input = None;
      }
    }
  )

