// Lazy nodes cannot hide effects or erase captures, and run_with keeps
// the same pure-view, service and infallible-supervisor contract as run.
module App.LazyErrors exposing (..)

type NoEq = NoEq Number

no_eq_view : NoEq -> Ui none none
let no_eq_view _ = Ui.empty

missing_eq : Ui none none
let missing_eq = Ui.lazy_view no_eq_view (NoEq 0)
//~ FLICK-C001 @11:18-11:30 no instance for `Eq NoEq`

number_view : Number -> Ui none none
let number_view n = Ui.text (show n)

effectful_view : Number ->{} Ui none none
let effectful_view n = Ui.text (show n)

impure_view : Ui none none
let impure_view = Ui.lazy_view effectful_view 0
//~ FLICK-T003 @21:32-21:46 a pure function

effectful_equal : Number -> Number ->{} Bool
let effectful_equal a b = a == b

impure_equal : Ui none none
let impure_equal = Ui.lazy_view_with effectful_equal number_view 0
//~ FLICK-T003 @28:38-28:53 a pure function

file_equal : forall s. File.File s -> (Unit -> (Unit -> Bool)^{s})^{s}
let file_equal file _ _ =
  ignore file
  true

file_view : forall s. File.File s -> Number -> (Ui none none)^{s}
let file_view file n =
  ignore file
  Ui.text (show n)

erase_model : forall s. File.File s -> Ui none none
let erase_model file = Ui.lazy_view_with (fun _ _ -> false) (fun _ -> Ui.empty) file
//~ FLICK-G001 @42:24-42:85 holds `s`

erase_comparator : forall s. File.File s -> Ui none none
let erase_comparator file = Ui.lazy_view_with (file_equal file) (fun _ -> Ui.empty) ()
//~ FLICK-G001 @46:29-46:87 holds `s`

erase_view : forall s. File.File s -> Ui none none
let erase_view file = Ui.lazy_view (file_view file) 0
//~ FLICK-G001 @50:23-50:54 holds `s`

pure_run : Ui.Renderer -> Ref Number -> Never
let pure_run renderer model = Ui.run_with renderer (fun _ -> ()) model number_view
//~ FLICK-E001 @54:31-54:83 runtime call

type error SaveError = SaveError String

service Users =
  save : String ->{; SaveError} Unit

save_view : String -> Ui {Users} {SaveError}
let save_view label =
  Ui.button
    {
      disabled = false;
      on_click = Ui.Event.exhaust (fun _ -> task { Users.save label });
    }
    [Ui.text label]

missing_service : Ui.Renderer -> Ref String ->{} Never
let missing_service renderer model = Ui.run_with renderer (fun _ -> ()) model save_view
//~ FLICK-E002 @72:38-72:88 does not allow service `Users`

failing_report : Failure {SaveError} ->{; SaveError} Unit
let failing_report _ = from_result (Err (SaveError "supervisor"))

bad_supervisor : Ui.Renderer -> Ref Number ->{} Never
let bad_supervisor renderer model =
  Ui.run_with renderer failing_report model (fun n -> Ui.text (show n))
//~ FLICK-E002 @80:24-80:38 does not allow error `SaveError`
