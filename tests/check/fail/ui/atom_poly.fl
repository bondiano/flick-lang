module App.AtomPoly exposing (..)

let items = Atom.make []
//          ^^^^^^^^^^^^ FLICK-U005 the atom `items` has the type `Writable (List a)` for every type its variables stand for

nothing : Atom.Atom (Option a)
let nothing = Atom.derived (fun () -> None)
//            ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ FLICK-U005 give `nothing` the type of its value, without variables

pair : (Atom.Writable (List a), Float)
let pair = (Atom.make [], 0)
//         ^^^^^^^^^^^^^^^^^ FLICK-U005 the atom `pair`

numbers : Atom.Writable (List Float)
let numbers = Atom.make []

let count = Atom.make 0

make_list : Unit -> Atom.Writable (List a)
let make_list () = Atom.make []

// a local atom has one type too: without a type, its uses decide it
poke : Unit ->{Atom.Write} Unit
let poke () =
  let fresh = Atom.fresh None
  Atom.set fresh (Some 1)
  Atom.set fresh (Some "one")

poke_signed : Unit ->{Atom.Write} Unit
let poke_signed () =
  signed : Atom.Writable (Option a)
  let signed = Atom.fresh None
  Atom.set signed (Some 1)

poke_annotated : Unit ->{Atom.Write} Unit
let poke_annotated () =
  let annotated : forall a. Atom.Writable (Option a) = Atom.fresh None
  Atom.set annotated (Some 1)

set_any : (forall a. Atom.Writable (Option a)) ->{Atom.Write} Unit
let set_any atom = Atom.set atom (Some 1)

poke_argument : Unit ->{Atom.Write} Unit
let poke_argument () = set_any (Atom.fresh None)

