module App.Browser exposing (..)

query : Atom.Browser String
let query = Atom.search_param "q"

read : Ui.View Unit
let read = Ui.view (fun () -> Ui.text (Atom.get query))
//                                              ^^^^^ FLICK-T003 expected `Atom _`, found `Browser String`

value : Ui.View Unit
let value = Ui.view (fun () -> Ui.text (Atom.value query))
//                                                 ^^^^^ FLICK-T003 expected `Writable _`, found `Browser String`

served : Atom.Writable String
let served = Atom.on_server "" query

on_server : Ui.View Unit
let on_server = Ui.view (fun () -> Ui.text (Atom.value served))
