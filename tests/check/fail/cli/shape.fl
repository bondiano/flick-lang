// The shape of a command: defaults, many-valued arguments, clauses once,
// a handler or subcommands, no arguments beside subcommands.
module App.Shape exposing (defaults, many, twice, empty, mixed)

import Cli

defaults : Cli.Command none none
let defaults = cli "defaults" {
  flag region : Option String = Some "eu"
//~ std/L002 @9:33-9:42 takes no `= default`
  handle fun { region } -> ()
}

many : Cli.Command none none
let many = cli "many" {
  arg files : List String
//~ std/L003 @16:15-16:26 only the last one can
  arg target : String
  handle fun { files; target } -> ()
}

twice : Cli.Command none none
let twice = cli "twice" {
  description "one"
  description "two"
//~ std/L004 @25:3-25:14 `description` is given twice
  handle fun {} -> ()
}

empty : Cli.Command none none
let empty = cli "empty" {
  description "nothing to do"
}
//~ std/L005 @31:13-33:2 needs `handle` or at least one `subcommand`

mixed : Cli.Command none none
let mixed = cli "mixed" {
  arg name : String
//~ std/L006 @38:3-38:6 takes no `arg`
  subcommand twice
}
