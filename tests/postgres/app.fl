// Against a real PostgreSQL: the queries of the SQL subset, a typed
// LEFT JOIN bound and run directly and as a deferred `Eff`, values that
// stay data, an enum column read through its literals, schema drift as
// `DecodeError` and a violated constraint as `DbError`. Run by
// `flick/tests/sql_postgres.rs`.
module App.Main exposing (main)

import Sql exposing (Pg, EncodeError, DbError, DecodeError, plugin sql)
import Database exposing (Database)
import BigDecimal exposing (BigDecimal)

type UserId = UserId BigInt
  deriving Show

user_id : PureCodec BigInt UserId
let user_id = Sql.codec (fun n -> Ok (UserId n)) (fun (UserId n) -> n)

sql table Users "users" {
  id : bigint primary key generated always as UserId via user_id
  name : text not null as String
  email : text as String
}

sql table Accounts "accounts" {
  id : bigint primary key generated always as BigInt
  user_id : bigint not null as UserId via user_id
  balance : numeric not null default as BigDecimal
}

/// What the database calls `drift.amount` is text, not a number.
sql table Drift "drift" {
  id : bigint primary key as BigInt
  amount : bigint not null as BigInt
}

add_user : Sql.Template Pg { name : String; email : Option String } { id : UserId }
let add_user = sql p {
  insert_into Users
  values { name = p.name; email = p.email }
  returning { id = Users.id }
}

open_account : Sql.Template Pg { owner : UserId; balance : BigDecimal } { id : BigInt }
let open_account = sql p {
  insert_into Accounts
  values { user_id = p.owner; balance = p.balance }
  returning { id = Accounts.id }
}

balances : Sql.Template Pg {} { name : String; balance : Option BigDecimal }
let balances = sql {
  from user in Users
  left_join account in Accounts on account.user_id == user.id
  order_by user.name, account.balance
  select { name = user.name; balance = account.balance }
}

type alias BalanceRow = { name : String; balance : Option BigDecimal }

/// One user's balances: the LEFT JOIN alone makes `balance` optional.
balances_of : Sql.Template Pg { user_id : UserId } BalanceRow
let balances_of = sql params {
  from user in Users
  left_join account in Accounts on account.user_id == user.id
  where user.id == params.user_id
  order_by account.balance
  select {
    name = user.name;
    balance = account.balance;
  }
}

/// Binding is pure; `Database.query` encodes, runs and decodes.
load_balances : UserId ->{Async, Database; EncodeError, DbError, DecodeError} List BalanceRow
let load_balances user_id =
  let query = Sql.bind balances_of { user_id = user_id }
  Database.query query

/// The same call kept for later as an `Eff` value.
deferred_balances :
  UserId -> Eff {Async, Database} {EncodeError, DbError, DecodeError} (List BalanceRow)
let deferred_balances user_id = task { load_balances user_id }

totals : Sql.Template Pg {} { name : String; accounts : BigInt; total : Option BigDecimal }
let totals = sql {
  from user in Users
  left_join account in Accounts on account.user_id == user.id
  group_by user.id, user.name
  order_by user.name
  select { name = user.name; accounts = count account.id; total = sum account.balance }
}

deposit : Sql.Template Pg { account : BigInt; amount : BigDecimal } { balance : BigDecimal }
let deposit = sql p {
  update Accounts
  set { balance = Accounts.balance + p.amount }
  where Accounts.id == p.account
  returning { balance = Accounts.balance }
}

close : Sql.Template Pg { owner : UserId } { id : BigInt }
let close = sql p {
  delete_from Accounts
  where Accounts.user_id == p.owner
  returning { id = Accounts.id }
}

names : Sql.Template Pg {} { name : String }
let names = sql {
  from u in Users
  where is_not_null u.email
  select u.name
  union_all (sql {
    from u in Users
    where is_null u.email
    select u.name
  })
}

savers : Sql.Template Pg {} { name : String }
let savers = sql {
  from u in Users
  where exists
    (sql {
      from a in Accounts
      where a.balance > a.balance
      select { id = a.id }
    })
    || is_in
      u.id
      (sql {
        from a in Accounts
        select { id = a.user_id }
      })
  order_by u.name
  select u.name
}

named : Sql.Template Pg { name : String } { id : UserId }
let named = sql p {
  from u in Users
  where u.name == p.name
  select u.id
}

accounts_of : UserId -> Sql.Template Pg {} { balance : BigDecimal }
let accounts_of owner = sql {
  from a in Accounts
  where a.user_id == $owner
  order_by a.balance
  select a.balance
}

set_email : UserId -> Option String -> Sql.Template Pg {} { email : Option String }
let set_email who email = sql {
  update Users
  set { email = $email }
  where Users.id == $who
  returning { email = Users.email }
}

/// The users of a name, or all of them: a filter given or not.
filtered : Option String -> Sql.Template Pg {} { name : String }
let filtered name = sql {
  from u in Users
  where is_null $name || u.name == $name
  order_by u.name
  select u.name
}

untagged type Role = Admin = "admin" | Guest = "guest"
  deriving Eq, Show

/// `roles.role` holds a role the program does not know, `root`.
sql table Roles "roles" {
  id : bigint primary key as BigInt
  role : text not null as Role
}

having : Sql.Template Pg { role : Role } { id : BigInt }
let having = sql p {
  from r in Roles
  where r.role == p.role
  select r.id
}

roles : Sql.Template Pg {} { role : Role }
let roles = sql {
  from r in Roles
  order_by r.id
  select r.role
}

drift : Sql.Template Pg {} { amount : BigInt }
let drift = sql {
  from d in Drift
  select d.amount
}

/// The one row a query returns, or `fallback`.
one : (Sql.Template Pg p r, p, r) ->{Async, Database; EncodeError, DbError, DecodeError} r
let one (template, params, fallback) =
  match Database.query (Sql.bind template params) with
  | [row] -> row
  | _ -> fallback

/// Runs the queries; returns an account that stays open.
run : Unit ->{Async, Database; EncodeError, DbError, DecodeError} BigInt
let run () =
  let ada =
    (one (add_user, { name = "Ada"; email = Some "ada@example.org" }, { id = UserId 0n })).id
  let bob =
    (one (add_user, { name = "'; DROP TABLE users; --"; email = None }, { id = UserId 0n })).id
  let first =
    (one (open_account, { owner = ada; balance = BigDecimal.from_integer 10n }, { id = 0n })).id
  ignore (one (open_account, { owner = ada; balance = BigDecimal.from_integer 5n }, { id = 0n }))
  Platform.stdout_line
    (show (Database.query (Sql.bind named { name = "'; DROP TABLE users; --" }) |> List.length))
  Platform.stdout_line (show (Database.query (Sql.bind balances {})))
  Platform.stdout_line (show (await (deferred_balances ada)))
  Platform.stdout_line (show (load_balances bob))
  Platform.stdout_line (show (Database.query (Sql.bind totals {})))
  Platform.stdout_line
    (show
      (Database.query (Sql.bind deposit { account = first; amount = BigDecimal.from_integer 7n })))
  Platform.stdout_line (show (Database.query (Sql.bind names {})))
  Platform.stdout_line (show (Database.query (Sql.bind savers {})))
  Platform.stdout_line (show (Database.query (Sql.bind (accounts_of ada) {})))
  Platform.stdout_line (show (Database.query (Sql.bind (set_email ada None) {})))
  Platform.stdout_line (show (Database.query (Sql.bind (set_email bob (Some "'; --")) {})))
  Platform.stdout_line (show (Database.query (Sql.bind named { name = "nobody" })))
  Platform.stdout_line (show (Database.query (Sql.bind (filtered None) {})))
  Platform.stdout_line (show (Database.query (Sql.bind (filtered (Some "Ada")) {})))
  Platform.stdout_line (show (Database.query (Sql.bind close { owner = ada }) |> List.length))
  let kept =
    (one (open_account, { owner = bob; balance = BigDecimal.from_integer 1n }, { id = 0n })).id
  Platform.stdout_line (show (Database.execute (Sql.bind close { owner = UserId 404n })))
  Platform.stdout_line (show (Database.query (Sql.bind having { role = Admin })))
  kept

refused : BigInt ->{Async, Database; EncodeError, DbError, DecodeError} String
let refused account =
  let negative = BigDecimal.from_integer (-100n)
  try show (Database.query (Sql.bind deposit { account = account; amount = negative })) with
  | DbError e -> "DbError " ++ e.code ++ " " ++ show e.constraint

main : Unit ->{Async; AppError} Unit
let main () =
  match Platform.env "DATABASE_URL" with
  | None -> App.fail "DATABASE_URL is not set"
  | Some url ->
    let layer = Database.pg { Database.config url with max_connections = 2 }
    let text =
      try
        provide layer {
          let kept = run ()
          Platform.stdout_line (refused kept)
          let unknown =
            try show (Database.query (Sql.bind roles {})) with
            | DecodeError e -> "DecodeError " ++ e.column ++ ": " ++ e.message
          Platform.stdout_line unknown
          show (Database.query (Sql.bind drift {}))
        }
      with
      | DecodeError e -> "DecodeError " ++ e.column ++ ": " ++ e.message
      | DbError e -> "DbError " ++ e.message
      | EncodeError e -> "EncodeError " ++ e.parameter
    Platform.stdout_line text
