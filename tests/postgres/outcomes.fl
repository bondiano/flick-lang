// Against a real PostgreSQL, a transaction ends by how its body ended: it
// commits when the body succeeds, and rolls back when the body fails with a
// typed error or dies. When the body is interrupted, the connection is
// dropped with its transaction, which the server rolls back. Run by
// `flick/tests/sql_postgres.rs`.
module App.Outcomes exposing (main)

import Sql exposing (Pg, EncodeError, DbError, DecodeError)
import Database exposing (Database)
import BigDecimal exposing (BigDecimal)

type UserId = UserId BigInt
  deriving Show

user_id : PureCodec BigInt UserId
let user_id = Sql.codec (fun n -> Ok (UserId n)) (fun (UserId n) -> n)

sql table Users "users" {
  id : bigint primary key generated always as UserId via user_id
  name : text not null as String
  email : text as String
}

sql table Accounts "accounts" {
  id : bigint primary key generated always as BigInt
  user_id : bigint not null as UserId via user_id
  balance : numeric not null default as BigDecimal
}

type error Abandoned = Abandoned

type alias Count = { n : Float }
  deriving Schema

add_user : Sql.Template Pg { name : String } { id : UserId }
let add_user = sql p {
  insert_into Users
  values { name = p.name }
  returning { id = Users.id }
}

open_account : Sql.Template Pg { owner : UserId; balance : BigDecimal } { id : BigInt }
let open_account = sql p {
  insert_into Accounts
  values { user_id = p.owner; balance = p.balance }
  returning { id = Accounts.id }
}

deposit : Sql.Template Pg { account : BigInt; amount : BigDecimal } { balance : BigDecimal }
let deposit = sql p {
  update Accounts
  set { balance = Accounts.balance + p.amount }
  where Accounts.id == p.account
  returning { balance = Accounts.balance }
}

balance_of : Sql.Template Pg { account : BigInt } { balance : BigDecimal }
let balance_of = sql p {
  from a in Accounts
  where a.id == p.account
  select a.balance
}

/// The server process of this connection.
backend : Sql.Query Pg Count
let backend =
  Sql.unsafe_query [Sql.unsafe_text "select pg_backend_pid()::int as n"] (Codec.json Count.schema)

/// Whether the server process `pid` is still there.
alive : Float -> Sql.Query Pg Count
let alive pid =
  Sql.unsafe_query
    [
      Sql.unsafe_text
        ("select count(*)::int as n from pg_stat_activity where pid = " ++ Float.to_string pid),
    ]
    (Codec.json Count.schema)

put : BigInt -> BigInt ->{Async, Database; EncodeError, DbError, DecodeError} Unit
let put account amount =
  ignore (Database.query
    (Sql.bind deposit { account = account; amount = BigDecimal.from_integer amount }))

balance : BigInt ->{Async, Database; EncodeError, DbError, DecodeError} String
let balance account =
  match Database.query (Sql.bind balance_of { account = account }) with
  | [row] -> show row.balance
  | _ -> "missing"

/// An account of a new user, holding 10.
account : String ->{Async, Database; EncodeError, DbError, DecodeError} BigInt
let account name =
  match Database.query (Sql.bind add_user { name = name }) with
  | [user] ->
    match
      Database.query
        (Sql.bind open_account { owner = user.id; balance = BigDecimal.from_integer 10n })
    with
    | [opened] -> opened.id
    | _ -> 0n
  | _ -> 0n

nap : Float ->{Async} Unit
let nap ms =
  match Duration.millis ms with
  | Ok d -> Effect.sleep d
  | Err _ -> ()

/// Whether `pid` goes away within a second.
gone : Float ->{Async, Database; EncodeError, DbError, DecodeError} Bool
let gone pid =
  wait : Int ->{Async, Database; EncodeError, DbError, DecodeError} Bool
  let rec wait tries =
    let left =
      match Database.query (alive pid) with
      | [count] -> count.n
      | _ -> 1
    if left == 0 then
      true
    else if tries == 0 then
      false
    else
      nap 50
      wait (tries - 1)
  wait 20

run : Unit ->{Host.Console, Async, Database; EncodeError, DbError, DecodeError} Unit
let run () =
  let a = account "outcomes"
  Database.transaction (task { put a 1n })
  Platform.stdout_line ("succeeded: balance " ++ balance a)
  let failed =
    try
      Database.transaction
        (task {
          put a 100n
          Fail.fail Abandoned
        })
    with
    | Abandoned -> "rolled back"
  Platform.stdout_line ("failed, " ++ failed ++ ": balance " ++ balance a)
  ignore (Effect.exit
    (task {
      Database.transaction
        (task {
          put a 100n
          Effect.die "broken"
        })
    }))
  Platform.stdout_line ("died: balance " ++ balance a)
  let pid = Ref.make 0
  let interrupted =
    timeout_option
      200
      (task {
        Database.transaction
          (task {
            match Database.query backend with
            | [row] -> Ref.set pid row.n
            | _ -> ()
            put a 100n
            nap 10000
          })
      })
  Platform.stdout_line
    ("interrupted: " ++ show (Option.is_none interrupted) ++ ", balance " ++ balance a)
  Platform.stdout_line ("its connection dropped: " ++ show (gone (Ref.get pid)))

main : Unit ->{Host.Environment, Host.Console, Async; AppError} Unit
let main () =
  match Platform.env "DATABASE_URL" with
  | None -> App.fail "DATABASE_URL is not set"
  | Some url ->
    let two = { Database.config url with max_connections = 2 }
    let text =
      try
        provide Database.pg two { run () }
        "done"
      with
      | DecodeError e -> "DecodeError " ++ e.column ++ ": " ++ e.message
      | DbError e -> "DbError " ++ e.code ++ " " ++ e.message
      | EncodeError e -> "EncodeError " ++ e.parameter
    Platform.stdout_line text
