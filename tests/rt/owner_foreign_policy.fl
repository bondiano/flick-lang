opaque type alias Deep s = Eff {Scope s} none (Chain200 (Deep s))

// Returned code exposes s; the factory keeps nothing itself.
makeNonregular : Fiber.Owner s -> Nonregular Int s
foreign pure makeNonregular from "./owner_foreign_policy.mjs" "makeNonregular"
  retention call

makeRow : Fiber.Owner s -> RowGrow {} s
foreign pure makeRow from "./owner_foreign_policy.mjs" "makeRow"
  retention call

makeProjected : Fiber.Owner s -> Projected Int s
foreign pure makeProjected from "./owner_foreign_policy.mjs" "makeProjected"
  retention call

makeLongId : Fiber.Owner s -> LongId Int s
foreign pure makeLongId from "./owner_foreign_policy.mjs" "makeLongId"
  retention call

makeChain : Fiber.Owner s -> Deep s
foreign pure makeChain from "./owner_foreign_policy.mjs" "makeChain"
  retention call

makeHigher : Fiber.Owner s -> Higher s
foreign pure makeHigher from "./owner_foreign_policy.mjs" "makeHigher"
  retention call

makeIdle : Fiber.Owner s -> IdleTask s
foreign pure makeIdle from "./owner_foreign_policy.mjs" "makeIdle"
  retention call

inspect : String -> BigInt -> String
foreign pure inspect from "./owner_foreign_policy.mjs" "inspect"

mark_provider : String -> Eff {} none Unit
foreign pure mark_provider from "./owner_foreign_policy.mjs" "markProvider"

service Read =
  read : Unit ->{} String

main : Unit ->{Host.Console} Unit
let main () = scope outer {
  let layer = Layer.succeed Read { read = fun () -> "unused" }
  let nonregular1 = makeNonregular outer
  Platform.stdout_line (inspect "nonregular" 0)
  let nonregular2 = Layer.run layer (fun () -> await nonregular1)
  let nonregular3 = Layer.run layer (fun () -> await nonregular2)
  let _ = Layer.run layer (fun () -> await nonregular3)
  Platform.stdout_line (inspect "nonregular" 3)
  let row1 = makeRow outer
  Platform.stdout_line (inspect "row" 0)
  let row2 =
    Layer.run layer (fun () ->
      let _ = await (mark_provider "row")
      await row1
    )
  let row3 = Layer.run layer (fun () -> await row2)
  let _ = Layer.run layer (fun () -> await row3)
  Platform.stdout_line (inspect "row" 3)
  let projected1 = makeProjected outer
  Platform.stdout_line (inspect "projected" 0)
  let projected2 = Layer.run layer (fun () -> await projected1)
  let projected3 = Layer.run layer (fun () -> await projected2)
  let _ = Layer.run layer (fun () -> await projected3)
  Platform.stdout_line (inspect "projected" 3)
  let longid1 = makeLongId outer
  Platform.stdout_line (inspect "longid" 0)
  let longid2 = Layer.run layer (fun () -> await longid1)
  let longid3 = Layer.run layer (fun () -> await longid2)
  let _ = Layer.run layer (fun () -> await longid3)
  Platform.stdout_line (inspect "longid" 3)
  let chain1 = makeChain outer
  Platform.stdout_line (inspect "chain" 0)
  let chain2 = Layer.run layer (fun () -> await chain1)
  let chain3 = Layer.run layer (fun () -> await chain2)
  let _ = Layer.run layer (fun () -> await chain3)
  Platform.stdout_line (inspect "chain" 3)
  let higher1 = makeHigher outer
  Platform.stdout_line (inspect "higher" 0)
  let higher2 = Layer.run layer (fun () -> await higher1)
  let higher3 = Layer.run layer (fun () -> await higher2)
  let _ = Layer.run layer (fun () -> await higher3)
  Platform.stdout_line (inspect "higher" 3)
  let idle1 = makeIdle outer
  Platform.stdout_line (inspect "idle" 0)
  let _ = Layer.run layer (fun () -> await idle1)
  Platform.stdout_line (inspect "idle" 1)
}
