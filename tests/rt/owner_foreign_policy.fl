// Declared Scope controls activation, not a wider row.
// RowGrow: unscoped provider, outer, outer; other tasks: outer.
// Id80/Chain200: productive residual aliases; parser unchanged.
module App.Main exposing (main)

opaque type alias Nonregular a s = Eff {Scope s} none (Nonregular (List a) s)
opaque type alias RowGrow r s = Eff r none (RowGrow {Scope s | r} s)
type alias Reveal a = Errors {a | none}
opaque type alias Projected a s = Eff {Scope s} none (Reveal (Projected (List a) s))
opaque type alias Idle a = forall b. Idle (List a)
opaque type alias IdleTask s = Eff {Scope s} none (Idle Int)
type alias Apply f a = f a
type alias Task s = Eff {Scope s} none
opaque type alias Higher s = Apply (Task s) (Higher s)
opaque type alias Id a = a
