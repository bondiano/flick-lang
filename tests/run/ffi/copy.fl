// Flick data crosses an untrusted foreign boundary as a copy: JS that sorts
// an argument in place, mutates an array it returned earlier, edits a record
// or keeps what a callback returned does not change a Flick value.
module App.Main exposing (main)

type alias User = { name : String; tags : List String }

sort_in_place : List Float -> List Float
foreign pure sort_in_place from "./bindings.mjs" "sortInPlace"

kept : Unit ->{} List Float
foreign kept from "./bindings.mjs" "kept"
  arity 0

spoil : Unit ->{} Unit
foreign spoil from "./bindings.mjs" "spoil"
  arity 0

rename : User ->{} Unit
foreign rename from "./bindings.mjs" "rename"

push_into : (Unit -> List Float) ->{} Float
foreign push_into from "./bindings.mjs" "pushInto"

// Deep, finite plain data crosses each copy position without using the host
// call stack. The mutable host can only change its independent copy.
type Deep = Leaf | Branch (List Deep)

deep : Float -> Deep -> Deep -> Deep
foreign pure deep from "./bindings.mjs" "copyDeep"

depth_of : Deep -> Float
foreign pure depth_of from "./bindings.mjs" "copyDeepDepth"

spoil_deep : Deep ->{} Float
foreign spoil_deep from "./bindings.mjs" "spoilDeep"

callback_arg : (Deep -> Float) -> Deep -> Deep ->{} Float
foreign callback_arg from "./bindings.mjs" "copyDeepCallbackArg"

callback_result : (Unit -> Deep) ->{} Float
foreign callback_result from "./bindings.mjs" "copyDeepCallbackResult"

deep_effect : Deep ->{} Deep
foreign effect deep_effect from "./bindings.mjs" "copyDeepEffect"

deep_async : Float -> Deep -> Deep ->{Async} Deep
foreign deep_async from "./bindings.mjs" "copyDeepAsync"

say : String ->{} Unit
let say line = Platform.stdout_line line

main : Unit ->{Async} Unit
let main () =
  let xs = [3, 1, 2]
  let sorted = sort_in_place xs
  say ("argument " ++ show xs ++ ", result " ++ show sorted)
  let held = kept ()
  spoil ()
  say ("held result " ++ show held)
  let user = { name = "ann"; tags = ["a"] }
  rename user
  say ("record " ++ user.name ++ " " ++ show user.tags)
  let mine = [1, 2]
  let length = push_into (fun () -> mine)
  say ("callback result " ++ show mine ++ ", JS saw " ++ show length)
  let tree = deep 20000 Leaf (Branch [])
  let passed = spoil_deep tree
  say ("deep result " ++ show (depth_of tree) ++ ", argument " ++ show passed)
  let received = callback_arg depth_of Leaf (Branch [])
  let returned = callback_result (fun () -> tree)
  say
    ("deep callbacks "
      ++ show received
      ++ " "
      ++ show returned
      ++ ", retained "
      ++ show (depth_of tree))
  say ("deep effect " ++ show (depth_of (deep_effect tree)))
  say ("deep async " ++ show (depth_of (deep_async 20000 Leaf (Branch []))))
