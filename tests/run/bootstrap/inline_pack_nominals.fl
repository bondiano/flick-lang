module App.Main exposing (main)

module Child exposing (Describe(..), Greeter, speak) =
  class Describe a =
    describe : a -> String

  service Greeter =
    greet : String ->{} String

  speak : String ->{Greeter} String
  let speak name = Greeter.greet name

type module Sig =
  class Describe = Child.Describe
  service Greeter = Child.Greeter
  speak : String ->{Greeter} String

packed : Module Sig
let packed = pack Child as Sig

main : Unit ->{; AppError} Unit
let main () =
  let greeter : Child.Greeter.Impl = { greet = fun name -> "hello " ++ name }
  let message = provide Child.Greeter greeter {
    unpack packed as K in K.speak "Ada"
  }
  Platform.stdout_line message
