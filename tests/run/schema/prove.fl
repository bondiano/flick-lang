// `T.prove` makes a refined value where the facts of its path prove its
// check, with no `Result` and without running the check again: the value
// is its base when the program runs.
module App.Main exposing (main)

refined type Even = Int where fun n -> n % 2 == 0
  deriving Show

as_even : Int -> Option Even
let as_even n = if Even.check n then Some (Even.prove n) else None

half : Int -> Option Int
let half n = Option.map (fun e -> Even.value e / 2) (as_even n)

main : Unit ->{Host.Console} Unit
let main () =
  Platform.stdout_line (show (as_even 4))
  Platform.stdout_line (show (as_even 3))
  Platform.stdout_line (show (half 10))
  Platform.stdout_line (show (half 7))
