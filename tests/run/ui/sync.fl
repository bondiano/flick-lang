// Sync stages: a render reads atoms by plain calls; a Sync function passes
// where a runtime one is expected and back, and a runtime function (rows
// with variables) runs at once where a render calls it.
module App.Main exposing (main)

count : Atom.Writable Float
let count = Atom.make 3

doubled : Unit ->{Atom.Read} Float
let doubled () = Atom.value count * 2

twice : (Unit ->{r; e} Float) -> Unit ->{r; e} Float
let twice f () = f () + f ()

labelled : Float ->{Atom.Read; e} String
let labelled n = "n = " ++ show (Atom.value count + n)

plus_one : Unit ->{Atom.Read | r; e} Float
let plus_one () = Atom.value count + 1

next : Atom.Atom Float
let next = Atom.derived plus_one

// a runtime argument of a Sync call runs before the call
ident : Float ->{r; e} Float
let ident n = n

read_more : Float ->{Atom.Read} Float
let read_more n = Atom.value count + n

more : Unit ->{Atom.Read | r; e} Float
let more () = read_more (ident 1)

later : Atom.Atom Float
let later = Atom.derived more

total : Atom.Atom Float
let total = Atom.derived (fun () -> Atom.get next + doubled ())

page : Ui.View Unit
let page =
  Ui.view (fun () -> ui {
    paragraph [
      text (show (twice doubled ())),
      text (labelled 1),
      text (show (Atom.get total)),
      text (show (Atom.get later)),
    ]
  })

failing : Ui.View Unit
let failing =
  Ui.suspended (fun _ -> ui { text "failed" }) (ui { text "loading" }) (fun () -> ui {
    text (show (doubled ()))
  })

main : Unit ->{Async; AppError} Unit
let main () = provide Atom.layer {
  Platform.stdout_line (Ui.Server.render (Ui.render page ()))
  Atom.set count 5
  Platform.stdout_line (Ui.Server.render (Ui.render page ()))
  Platform.stdout_line (Ui.Server.render (Ui.render failing ()))
}
