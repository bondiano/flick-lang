// A counter mounted with React 19 in jsdom: changed models refresh the
// view, lazy children use Flick's Eq, failures reach the supervisor, text
// stays text, and both DOM and custom renderer scopes unmount their roots.
module App.Main exposing (main)

type error Refused = Refused String
  deriving Show

setup : Unit ->{} Unit
foreign sync setup from "./dom.mjs" "setup"
  arity 0

click : String ->{} Unit
foreign sync click from "./dom.mjs" "click"
  arity 1

settle : Unit ->{} Unit
foreign async settle from "./dom.mjs" "settle"
  arity 0

text : Unit ->{} String
foreign sync text from "./dom.mjs" "text"
  arity 0

markup : Unit ->{} String
foreign sync markup from "./dom.mjs" "markup"
  arity 0

badge_renders : Unit ->{} Number
foreign sync badge_renders from "./dom.mjs" "badgeRenders"
  arity 0

renderer : Ui.Renderer
foreign pure renderer from "./dom.mjs" "renderer"

badge : Ui.Component { label : String }
foreign pure badge from "./dom.mjs" "Badge"

type BadgeModel = BadgeModel { label : String; revision : Number }

// Revisions do not affect this view; equality must use this dictionary.
instance Eq BadgeModel =
  eq : BadgeModel -> BadgeModel -> Bool
  let eq (BadgeModel a) (BadgeModel b) = a.label == b.label

badge_view : forall r e. BadgeModel -> Ui r e
let badge_view (BadgeModel m) = Ui.component badge { label = m.label }

counter : Ref Number -> Number -> Ui none {Refused}
let counter model n =
  ui {
    div
      { class_name = "counter" }
      [
        heading [text ("count " ++ show n)],
        button
          {
            disabled = false;
            on_click = Ui.Event.exhaust (fun _ -> task { Ref.set model (n + 1) });
          }
          [text "+1"],
        button
          {
            disabled = false;
            on_click = Ui.Event.latest (fun _ -> task { from_result (Err (Refused "no")) });
          }
          [text "refuse"],
        paragraph [text "<b>bold?</b>"],
        lazy_view badge_view (BadgeModel { label = "new"; revision = n }),
      ]
  }

report : Failure e ->{} Unit
let report failure =
  Platform.stdout_line ("supervisor: " ++ RawCause.describe (Failure.inspect failure))

main : Unit ->{; AppError} Unit
let main () =
  setup ()
  let model = Ref.make 0
  let found = Ui.Dom.container "app"
  match found with
  | None -> Platform.stdout_line "no container"
  | Some root ->
    scope s {
      let ui =
        Fiber.spawn s report (task { Ui.Dom.run root report model (fun n -> counter model n) })
      settle ()
      Platform.stdout_line (text ())
      click "+1"
      settle ()
      click "+1"
      settle ()
      Platform.stdout_line (text ())
      Platform.stdout_line ("lazy badge renders: " ++ show (badge_renders ()))
      click "refuse"
      settle ()
      Platform.stdout_line (markup ())
    }
    Platform.stdout_line ("after the scope: [" ++ text () ++ "]")
    scope s {
      let custom = Ref.make 7
      let ui =
        Fiber.spawn
          s
          report
          (task { Ui.run_with renderer report custom (fun n -> Ui.text ("custom " ++ show n)) })
      settle ()
      Platform.stdout_line (text ())
    }
    Platform.stdout_line ("after renderer scope: [" ++ text () ++ "]")
