// A counter on atoms mounted with React 19 in jsdom: actions write its
// state and the view renders again, a foreign component renders inside it,
// a handler's defect reaches the supervisor, text stays text, and both DOM and custom
// renderer scopes unmount their roots.
module App.Main exposing (main)

setup : Unit ->{} Unit
foreign setup from "./dom.mjs" "setup"
  arity 0

click : String ->{} Unit
foreign click from "./dom.mjs" "click"
  arity 1

settle : Unit ->{Async} Unit
foreign settle from "./dom.mjs" "settle"
  arity 0

text : Unit ->{} String
foreign text from "./dom.mjs" "text"
  arity 0

markup : Unit ->{} String
foreign markup from "./dom.mjs" "markup"
  arity 0

renderer : Ui.Renderer
foreign pure renderer from "./dom.mjs" "renderer"

badge : Ui.Component { label : String }
foreign pure badge from "./dom.mjs" "Badge"

badge_for : Unit -> Ui.Component { label : String }
let badge_for () = badge

count : Atom.Writable Float
let count = Atom.make 0

increment : Action.Action Ui.ClickSnapshot
let increment = Action.exhaust (fun _ -> task { Atom.update count (fun n -> n + 1) })

refuse : Action.Action Ui.ClickSnapshot
let refuse = Action.latest (fun _ -> task { Failure.rethrow (Cause.die "refused") })

counter : Ui.View Unit
let counter =
  Ui.named
    "App.Main.counter"
    (Ui.view (fun () -> ui {
      let widgets = { badge = badge }
      div { class_name = "counter" }
        heading (text ("count " ++ show (Atom.value count)))
        button { disabled = false; on_click = increment } (text "+1")
        button { disabled = false; on_click = refuse } (text "refuse")
        paragraph (text "<b>bold?</b>")
        badge { label = "new" }
        badge_for () { label = "returned" }
        ({ label = "piped" } |> (if true then widgets.badge else badge))
    }))

report : Failure e ->{} Unit
let report failure =
  Platform.stdout_line ("supervisor: " ++ RawCause.describe (Failure.inspect failure))

main : Unit ->{Async; AppError} Unit
let main () =
  setup ()
  match Ui.Dom.container "app" with
  | None -> Platform.stdout_line "no container"
  | Some root -> provide Atom.layer {
    scope s {
      let _ui = Fiber.spawn s report (task { Ui.Dom.mount root report (Ui.render counter ()) })
      settle ()
      Platform.stdout_line (text ())
      click "+1"
      settle ()
      click "+1"
      settle ()
      Platform.stdout_line (text ())
      click "refuse"
      settle ()
      Platform.stdout_line (markup ())
    }
    Platform.stdout_line ("after the scope: [" ++ text () ++ "]")
    scope s {
      let custom = Atom.make 7
      let shown = Ui.view (fun () -> Ui.text ("custom " ++ show (Atom.value custom)))
      let _ui = Fiber.spawn s report (task { Ui.mount_with renderer report (Ui.render shown ()) })
      settle ()
      Platform.stdout_line (text ())
    }
    Platform.stdout_line ("after renderer scope: [" ++ text () ++ "]")
  }
