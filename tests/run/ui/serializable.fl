// Serializable atoms take their keys from the bindings that define them:
// `Module.name`, and `Module.name/key` for each atom of a family. The state
// a server hands over lists each serializable atom of the registry with its
// coded value, and no other atom.
module App.Main exposing (main)

count : Atom.Writable Float
let count = Atom.serializable (Codec.json Schema.number) (Atom.make 0)

draft : String -> Atom.Writable String
let draft = Atom.serializable_family (Codec.json Schema.string) (fun _ -> Atom.make "")

local : Atom.Writable Float
let local = Atom.make 7

main : Unit ->{; AppError} Unit
let main () = provide Atom.layer {
  Atom.set count 3
  Atom.set (draft "intro") "hello"
  Atom.set (draft "outro") "bye"
  Atom.set local 8
  Platform.stdout_line (Ui.Server.state "app")
}
