// `component` without `setup` is a view of its props: one renders inside
// another with `Ui.render`, and both read atoms as views do. With `setup`,
// each instance makes its own state once and renders with it.
module App.Main exposing (main)

greeting : Atom.Writable String
let greeting = Atom.make "Hello"

type alias Person = { name : String; tags : List String }

component salutation (name : String) = ui {
  paragraph [text (Atom.value greeting ++ ", " ++ name ++ "!")]
}

component card (person : Person) = ui {
  div { class_name = "card" } [
    Ui.render salutation person.name,
    list (List.map (fun t -> ui { item [text t] }) person.tags),
  ]
}

component counter (start : Float) =
  let count = Atom.local (start + 1)
  let bump = Action.exhaust (fun _ -> task { Atom.update count (fun n -> n + 1) })
  ui { button { on_click = bump; disabled = false } [text (show (Atom.value count))] }

// a server renders without mounting: its work never starts there
component mounted () =
  let _started = Ui.on_mount (task { Platform.stdout_line "mounted on a server" })
  ui { text "rendered" }

main : Unit ->{Async; AppError} Unit
let main () =
  Platform.stdout_line
    (Ui.Server.to_html (Ui.render card { name = "Ada"; tags = ["math", "engines"] }))
  provide Atom.layer {
    Platform.stdout_line (Ui.Server.render (Ui.render counter 41))
    Platform.stdout_line (Ui.Server.render (Ui.render counter 1))
    Platform.stdout_line (Ui.Server.render (Ui.render mounted ()))
  }
