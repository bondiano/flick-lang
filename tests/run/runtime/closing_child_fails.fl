// A child that fails while its owner closes reaches its supervisor before the
// owner's finalizers run (C2, C3, C5, R2, R4), and its failure stays out of
// the owner's outcome. The children fail after closing began: a group stops
// first (C1), and its child opens the deferred they wait for.
module App.Main exposing (main)

type error Oops = Oops String
  deriving Show

say : String ->{} Unit
let say line = Platform.stdout_line line

ping : Deferred.Deferred none Unit ->{} Unit
let ping d = ignore (Deferred.succeed () d)

/// A group whose child opens `closing` as the owner starts to close.
close_signal : Deferred.Deferred none Unit ->{Scope s, Async;} Unit
let close_signal closing =
  let set : FiberSet.FiberSet s none Unit = FiberSet.make ()
  let started : Deferred.Deferred none Unit = Deferred.make ()
  let _ =
    FiberSet.run
      { propagateInterruption = false; startImmediately = true }
      (task {
        Effect.ensuring
          (task { ping closing })
          (task {
            ping started
            Effect.never ()
          })
      })
      set
  Deferred.await_ started

/// The body's value comes back: a child's failure belongs to its supervisor.
masked_failure : Unit ->{Async;} String
let masked_failure () = scope owner {
  let closing : Deferred.Deferred none Unit = Deferred.make ()
  let entered : Deferred.Deferred none Unit = Deferred.make ()
  close_signal closing
  Scope.add_finalizer (task { say "owner finalizer, after the supervisor" })
  // not which reasons: the request of C2 may reach the child before it fails
  sup : Failure {Oops} ->{} Unit
  let sup f = say ("supervised, a defect: " ++ show (Cause.has_dies f))
  let _child =
    Fiber.spawn
      owner
      sup
      (task {
        Effect.uninterruptible
          (task {
            ping entered
            Deferred.await_ closing
            say "child fails while its owner closes"
            from_result (Err (Oops "late"))
          })
      })
  Deferred.await_ entered
  say "body done"
  "the body's value"
}

/// The failure comes from the child's own finalizer, under the request of C2.
finalizer_failure : Unit ->{Async;} String
let finalizer_failure () = scope owner {
  let started : Deferred.Deferred none Unit = Deferred.make ()
  Scope.add_finalizer (task { say "owner finalizer, after the supervisor" })
  sup : Failure none ->{} Unit
  let sup f = say ("supervised, a defect: " ++ show (Cause.has_dies f))
  let _child =
    Fiber.spawn
      owner
      sup
      (task {
        Effect.ensuring
          (task {
            say "child's finalizer dies"
            Effect.die "in the child's finalizer"
          })
          (task {
            ping started
            Effect.never ()
          })
      })
  Deferred.await_ started
  "the body's value"
}

/// A failing body keeps its own cause; the child's is its supervisor's.
failing_body : Unit ->{Async; Oops} String
let failing_body () = scope owner {
  let started : Deferred.Deferred none Unit = Deferred.make ()
  sup : Failure none ->{} Unit
  let sup f = say ("supervised, a defect: " ++ show (Cause.has_dies f))
  let _child =
    Fiber.spawn
      owner
      sup
      (task {
        Effect.ensuring
          (task { Effect.die "in the child's finalizer" })
          (task {
            ping started
            Effect.never ()
          })
      })
  Deferred.await_ started
  from_result (Err (Oops "the body's"))
}

main : Unit ->{Async; AppError} Unit
let main () =
  say (masked_failure ())
  say (finalizer_failure ())
  let ex : Exit {Oops} String = Effect.exit (task { failing_body () })
  say (show (Exit.has_dies ex, Exit.find_error_option ex))
