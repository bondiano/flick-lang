// A failure of a fiber asked to stop, while it is interruptible, skips every
// recovery handler on its way out: `Effect.exit`, `match_cause`, `retry`, a
// race and a stream's `catch_cause` see neither the failure nor run, and the
// fiber ends with its interruption alone (docs/formal/runtime.md G7g, `docs/formal/runtime.md#an-interruption-that-skips-a-handler-erases-fail-effect`).
module App.Main exposing (main)

type error A = A Float
  deriving Eq, Show

say : String ->{} Unit
let say line = Platform.stdout_line line

nap : Float ->{Async;} Unit
let nap millis =
  match Duration.millis millis with
  | Ok d -> Effect.sleep d
  | Err _ -> ()

/// Tells `entered` it is masked, then fails right after its mask ends, by
/// when the fiber was asked to stop.
late : Deferred.Deferred none Unit ->{Async; A} Float
let late entered =
  Effect.uninterruptible
    (task {
      let _ = Deferred.succeed () entered
      // a masked fiber cannot see the request come in: only time keeps the mask on until it does
      nap 250
      from_result (Err (A 1))
    })

quiet : forall e. Failure e ->{} Unit
let quiet _ = ()

/// The reasons of a failure: `F` typed, `D` defect, `I` interruption.
view : Failure e -> List String
let view f =
  label : Cause.Reason e -> String
  let label r = if Cause.is_fail_reason r then "F" else if Cause.is_die_reason r then "D" else "I"
  List.map label (Cause.reasons f)

/// Runs `body` in a child that is interrupted once `late` tells it is masked.
probe : String -> (Deferred.Deferred none Unit -> Eff {Async} none Unit) ->{Async;} Unit
let probe name body =
  let entered : Deferred.Deferred none Unit = Deferred.make ()
  let exits = scope owner {
    let fiber = Fiber.spawn owner quiet (body entered)
    Deferred.await_ entered
    Fiber.interrupt fiber
    Fiber.await_all [fiber]
  }
  List.each_effect
    (fun ex ->
      match Exit.failure ex with
      | Some f -> say (name ++ ": " ++ show (view f))
      | None -> say (name ++ ": succeeded")
    )
    exits

main : Unit ->{Async; AppError} Unit
let main () =
  probe "exit" (fun entered -> task {
    let ex = Effect.exit (task { late entered })
    say ("exit ran: " ++ show (Option.is_some (Exit.failure ex)))
  })
  probe "match_cause" (fun entered -> task {
    let s = Effect.match_cause (fun _ -> "failed") (fun _ -> "ok") (task { late entered })
    say ("match_cause ran: " ++ s)
  })
  let attempts = Ref.make 0
  probe "retry" (fun entered -> task {
    try
      let v =
        Effect.retry
          (Schedule.recurs 2)
          (task {
            Ref.set attempts (Ref.get attempts + 1)
            late entered
          })
      say ("retry gave " ++ show v)
    with
    | A _ -> say "retry handler ran"
  })
  say ("retry attempts: " ++ show (Ref.get attempts))
  probe "race" (fun entered -> task {
    try
      let v =
        race_first
          (task { late entered })
          (task {
            nap 1000
            2
          })
      say ("race gave " ++ show v)
    with
    | A _ -> say "race handler ran"
  })
  probe "stream" (fun entered -> task {
    let xs =
      Stream.from_effect (task { late entered })
      |> Stream.catch_cause (fun _ -> Stream.make [0])
      |> Stream.run_collect
    say ("stream gave " ++ show xs)
  })
