// Scope s, not a provider's private owner, receives the finalizer and arena.
module App.Main exposing (main)

service Read =
  read : Unit ->{} String

acquire : Unit ->{Scope s} Arena.Value s String
let acquire () =
  let arena = Arena.make ()
  let value = Arena.alloc arena "kept"
  // a finalizer prints through the trusted host adapter: it may outlive the
  // caller's provider of `Host.Console` (`FLICK-G003`)
  Scope.add_finalizer (task { Host.raw_stdout_line ("final " ++ Arena.get value) })
  value

main : Unit ->{Host.Console} Unit
let main () = scope {
  let layer = Layer.succeed Read { read = fun () -> "unused" }
  let value = Layer.run layer acquire
  Platform.stdout_line ("after " ++ Arena.get value)
}
