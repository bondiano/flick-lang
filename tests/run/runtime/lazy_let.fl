// A `let lazy` runs its value at most once, at its first `await`, and not at
// all when it is never awaited; a `let lazy mut` written before it is read
// never runs its value. Its function alone reads it, so no `Async`.
module App.Main exposing (main)

counted : Ref Int -> Int ->{} Int
let counted runs n =
  Ref.set runs (Ref.get runs + 1)
  n

main : Unit ->{} Unit
let main () =
  let runs = Ref.make 0
  let lazy answer = counted runs 42
  let lazy _never = counted runs 1
  let a = await answer
  let b = await answer
  let lazy mut replaced = counted runs 7
  replaced = 8
  let c = await replaced
  Platform.stdout_line "\{a} \{b} \{c}, runs: \{Ref.get runs}"
