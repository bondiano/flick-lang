// The phases of closing an owner (docs/formal/runtime.md §3.3): a resource
// a child acquires while its owner closes is released after the child; a
// supervisor acquires into the owner it watches for; a fiber group stops
// before the resources of its children; a request to interrupt that came
// in while masked interrupts as the mask ends.
module App.Main exposing (main)

type Res (s : Region)

open_res : String ->{Scope s} Res s
foreign effect open_res from "./resources.mjs" "open"

say : String ->{} Unit
let say line = Platform.stdout_line line

nap : Float ->{Async} Unit
let nap millis =
  match Duration.millis millis with
  | Ok d -> Effect.sleep d
  | Err _ -> ()

report : Failure e ->{} Unit
let report f =
  say ("supervised " ++ show (Cause.has_fails f, Cause.has_dies f, Cause.has_interrupts f))

late_acquire : Unit ->{Async} Unit
let late_acquire () = scope s {
  let started : Deferred.Deferred none Unit = Deferred.make ()
  let _child =
    Fiber.spawn
      s
      report
      (task {
        // interrupted as its owner closes: the finalizer, masked, acquires while it closes
        Effect.ensuring
          (task {
            let _r = open_res "late"
            say "child uses late"
            nap 20
            say "child done with late"
          })
          (task {
            let _ = Deferred.succeed () started
            Effect.never ()
          })
      })
  Deferred.await_ started
  say "body done"
}

supervisor_owner : Unit ->{Async} Unit
let supervisor_owner () = scope outer {
  // the supervisor and the inner body take turns through this, not through a timer
  let ran : Deferred.Deferred none Unit = Deferred.make ()
  sup : Failure e ->{Scope outer} Unit
  let sup _ =
    let _r = open_res "sup"
    say "supervisor ran"
    let _ = Deferred.succeed () ran
    ()
  scope inner {
    let _child = Fiber.spawn outer sup (task { todo })
    Deferred.await_ ran
    say "inner done"
  }
  say "outer body done"
}

group_close : Unit ->{Async} Unit
let group_close () = scope s {
  let set : FiberSet.FiberSet s none Unit = FiberSet.make ()
  // the child and the body take turns through these, not through timers
  let opened : Deferred.Deferred none Unit = Deferred.make ()
  let said : Deferred.Deferred none Unit = Deferred.make ()
  let _f =
    FiberSet.run
      { propagateInterruption = false; startImmediately = true }
      (task {
        Effect.uninterruptible
          (task {
            let _r = open_res "group"
            let _ = Deferred.succeed () opened
            Deferred.await_ said
            // still running as the owner closes
            nap 40
            say "group child done"
          })
      })
      set
  Deferred.await_ opened
  say "body done"
  let _ = Deferred.succeed () said
  ()
}

unmask : Unit ->{Async} Unit
let unmask () =
  scope s {
    let masked : Deferred.Deferred none Unit = Deferred.make ()
    let f =
      Fiber.spawn
        s
        report
        (task {
          Effect.uninterruptible
            (task {
              let _ = Deferred.succeed () masked
              // a masked fiber cannot see the request come in: only time keeps the mask on until it does
              nap 250
              say "block done"
            })
          say "after block"
        })
    Deferred.await_ masked
    Fiber.interrupt f
  }
  // after the scope: its close waits for the supervisor, which runs beside the interrupting fiber
  say "interrupted"

main : Unit ->{Async; AppError} Unit
let main () =
  late_acquire ()
  say "--"
  supervisor_owner ()
  say "--"
  group_close ()
  say "--"
  unmask ()
