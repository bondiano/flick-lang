// A file opened in a scope is closed when the scope closes, however its
// body ends: with a value, a typed error or an interruption. A failure of
// the file system carries the message Node gives it.
module App.Main exposing (main)

type error Oops = Oops String

say : String ->{} Unit
let say line = Platform.stdout_line line

nap : Float ->{Async} Unit
let nap millis =
  match Duration.millis millis with
  | Ok d -> Effect.sleep d
  | Err _ -> ()

/// The file, in Windows' temporary directory there and in `/tmp` elsewhere.
path : Unit ->{} String
let path () =
  match Platform.env "TEMP" with
  | Some dir -> dir ++ "/flick-scoped-file.txt"
  | None -> "/tmp/flick-scoped-file.txt"

/// Reads the file in a scope that says when it closes, then ends by `finish`.
reading :
  String ->
  (String ->{Async, File.FileSystem; e} String) ->{Async, File.FileSystem; e + {File.OpenError, File.ReadError}}
  String
let reading label finish = scope {
  let file = File.open_scoped (path ())
  Scope.add_finalizer (task { say (label ++ ": scope closed") })
  let text = File.read_all file
  finish text
}

main : Unit ->{Async; AppError} Unit
let main () = provide File.node {
  let outcome =
    try
      File.write_text (path ()) "hello from a file"
      say (reading "success" (fun text -> text))
      say
        (
          try reading "error" (fun _ -> from_result (Err (Oops "body failed"))) with
          | Oops text -> text
        )
      let timed =
        timeout_option
          20
          (task {
            reading "interrupted" (fun text ->
              nap 2000
              text
            )
          })
      say (show timed)
      File.read_text "/nonexistent/flick/file.txt"
    with
    | File.ReadError message -> message
    | File.OpenError message -> message
    | File.WriteError message -> message
  say outcome
}
