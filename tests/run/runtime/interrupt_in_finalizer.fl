// An interruption that arrives while a finalizer runs waits: the finalizer
// runs to its end, the rest of the stack runs after it, each once, and only
// then the fiber stops (R1, R2, closing is masked). Nothing here depends on
// time: the fiber that is asked to stop second tells the finalizer to go on,
// so the finalizer goes on after the request reached it.
module App.Main exposing (main)

say : String ->{} Unit
let say line = Platform.stdout_line line

quiet : Failure e ->{} Unit
let quiet _ = ()

report : Failure e ->{} Unit
let report f = say ("supervised, a defect: " ++ show (Cause.has_dies f))

ping : Deferred.Deferred none Unit ->{} Unit
let ping d = ignore (Deferred.succeed () d)

/// Waits to be stopped, and opens `stopped` when it is.
signal_when_stopped :
  Deferred.Deferred none Unit -> Deferred.Deferred none Unit -> Eff {Async} none Unit
let signal_when_stopped started stopped = task {
  Effect.ensuring
    (task { ping stopped })
    (task {
      ping started
      Effect.never ()
    })
}

/// A stack of two finalizers, the second holding until `go` opens.
holding : Deferred.Deferred none Unit -> Deferred.Deferred none Unit ->{Async;} Unit
let holding in_finalizer go =
  scope {
    Scope.add_finalizer (task { say "added first, runs last" })
    Scope.add_finalizer
      (task {
        say "finalizer starts"
        ping in_finalizer
        Deferred.await_ go
        say "finalizer ends"
      })
  }
  // an interruption point on both targets: leaving a close is one only on JS (`interrupt_after_close`)
  Effect.yield_now ()
  say "not reached: the request came in"

/// The request comes from another fiber.
requested : Unit ->{Async;} Unit
let requested () =
  scope owner {
    let in_finalizer : Deferred.Deferred none Unit = Deferred.make ()
    let go : Deferred.Deferred none Unit = Deferred.make ()
    let started : Deferred.Deferred none Unit = Deferred.make ()
    let target = Fiber.spawn owner report (task { holding in_finalizer go })
    let stopper = Fiber.spawn owner quiet (signal_when_stopped started go)
    Deferred.await_ started
    Deferred.await_ in_finalizer
    // a request reaches the target before the stopper, which then opens `go`
    Fiber.interrupt_all [target, stopper]
  }
  say "requested: closed"

/// The request comes from the owner closing (C2), with a sibling started
/// after the target: closing must ask both before it waits for either.
closing : Unit ->{Async;} Unit
let closing () =
  scope owner {
    let in_finalizer : Deferred.Deferred none Unit = Deferred.make ()
    let go : Deferred.Deferred none Unit = Deferred.make ()
    let started : Deferred.Deferred none Unit = Deferred.make ()
    let _target = Fiber.spawn owner report (task { holding in_finalizer go })
    let _stopper = Fiber.spawn owner quiet (signal_when_stopped started go)
    Scope.add_finalizer (task { say "owner finalizer, after both" })
    Deferred.await_ started
    Deferred.await_ in_finalizer
    say "owner body done"
  }
  say "closing: closed"

/// A finalizer that dies under a pending request does not stop the others.
dying : Unit ->{Async;} Unit
let dying () =
  scope owner {
    let in_finalizer : Deferred.Deferred none Unit = Deferred.make ()
    let go : Deferred.Deferred none Unit = Deferred.make ()
    let started : Deferred.Deferred none Unit = Deferred.make ()
    let target =
      Fiber.spawn
        owner
        report
        (task {
          scope {
            Scope.add_finalizer (task { say "added first, still runs" })
            Scope.add_finalizer
              (task {
                ping in_finalizer
                Deferred.await_ go
                say "finalizer dies"
                Effect.die "in the finalizer"
              })
          }
        })
    let stopper = Fiber.spawn owner quiet (signal_when_stopped started go)
    Deferred.await_ started
    Deferred.await_ in_finalizer
    Fiber.interrupt_all [target, stopper]
  }
  say "dying: closed"

main : Unit ->{Async; AppError} Unit
let main () =
  requested ()
  closing ()
  dying ()
