// The cells a release build need not make (`docs/formal/lazy.md` §6) behave
// as made: a lazy nothing reads never runs its task, nor one a function takes
// and drops; a lazy of a value gives it to every `await`; a lazy forced
// where it is made runs its task once, there; an `await` after the first one
// gives what the first gave; a `let lazy` awaited once runs its value there, and
// one whose `await` is not reached never runs it.
module App.Main exposing (main)

counted : Ref Int -> Int ->{} Int
let counted runs n =
  Ref.set runs (Ref.get runs + 1)
  n * 2

dropped : Lazy r e Int -> Int -> Int
let dropped _ n = n

main : Unit ->{Host.Console, Async} Unit
let main () =
  let runs = Ref.make 0
  ignore (lazy { counted runs 1 })
  let kept = dropped (lazy { counted runs 2 }) 3
  let five = lazy { 5 }
  let direct = await (lazy { counted runs 21 })
  let again = lazy { counted runs 4 }
  let first = await again
  let twice = fun () -> await again
  Platform.stdout_line "\{kept} \{await five + await five} \{direct}"
  Platform.stdout_line "\{first + await again + twice ()}"
  let lazy once = counted runs 5
  let lazy skipped = counted runs 6
  let picked = if kept > 0 then await once else 0
  let unpicked = if kept < 0 then await skipped else 1
  Platform.stdout_line "\{picked} \{unpicked}"
  Platform.stdout_line "runs: \{Ref.get runs}"
