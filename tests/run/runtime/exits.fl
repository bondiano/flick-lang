// How computations end, as values: exits of tasks and fibers, their
// failures and causes, and handlers that see how a task ended.
module App.Main exposing (main)

type error Boom = Boom Float
  deriving Show

say : String ->{} Unit
let say line = Platform.stdout_line line

nap : Float ->{Async} Unit
let nap millis =
  match Duration.millis millis with
  | Ok d -> Effect.sleep d
  | Err _ -> ()

flags : Failure e -> String
let flags f = show (Cause.has_fails f, Cause.has_dies f, Cause.has_interrupts f)

ended : Exit {Boom} Float -> String
let ended exit = Exit.match_ (fun v -> "value " ++ show v) (fun f -> "failed " ++ flags f) exit

quiet : Failure e ->{} Unit
let quiet _ = ()

main : Unit ->{Async; AppError} Unit
let main () =
  let exits = parallel_exits [task { 1 }, task { from_result (Err (Boom 2)) }]
  say (show (List.map ended exits))
  say (show (List.length (List.filter_map Exit.failure exits), List.filter_map Exit.value exits))
  let made : List (Exit {Boom} Float) = [
    Exit.succeed 3,
    Exit.fail (Boom 4),
    Exit.die "broken",
    Exit.interrupt (Some 7),
  ]
  say (show (List.map ended made))
  say (show (List.map Exit.is_success made, List.map Exit.has_dies made))
  say (show (List.map Exit.find_error_option made))
  say (show (List.map (fun e -> Exit.value (Exit.map (fun n -> n * 10) e)) made))
  match Exit.find_defect (Exit.die "broken" : Exit {Boom} Float) with
  | Ok text -> say ("defect " ++ text)
  | Err _ -> say "no defect"
  let awaited = scope owner {
    let ok = Fiber.spawn owner quiet (task { 5 })
    let bad = Fiber.spawn owner quiet (task { from_result (Err (Boom 6)) })
    let slow =
      Fiber.spawn
        owner
        quiet
        (task {
          nap 2000
          0
        })
    nap 5
    Fiber.interrupt_as (Some 9) slow
    List.map ended (Fiber.await_all [ok, bad, slow])
  }
  say (show awaited)
  let noted = Ref.make []
  note : String ->{} Unit
  let note text = Ref.modify noted (fun xs -> ((), xs ++ [text]))
  let watched : Eff none {Boom} Float = task { 8 }
  let _ =
    try Effect.on_exit (fun e -> note ("exit " ++ ended e)) watched with
    | Boom _ -> 0
  let _ =
    timeout_option
      5
      (task {
        Effect.on_interrupt
          (fun ids -> note ("interrupted " ++ show (List.length ids)))
          (task {
            nap 2000
            0
          })
      })
  say (show (Ref.get noted))
