// A resource is released by the owner of the region its `Scope s` names,
// which need not be the innermost scope around the call.
module App.Main exposing (main)

say : String ->{} Unit
let say line = Platform.stdout_line line

open_res : forall s. String ->{Scope s;} String
let open_res name =
  Resource.acquire_release (task {
    say ("open " ++ name)
    name
  }) (fun n -> say ("release " ++ n))

/// Acquires into the caller's region from inside a scope of its own.
keep : forall s. String ->{Scope s;} String
let keep name =
  acquire : Unit ->{Scope s;} String
  let acquire () = open_res name
  scope {
    let _ = open_res "local"
    let kept = acquire ()
    say "keep done"
    kept
  }

main : Unit ->{; AppError} Unit
let main () =
  scope outer {
    acquire : Unit ->{Scope outer;} String
    let acquire () = open_res "outer"
    scope inner {
      let _ = open_res "inner"
      let _ = acquire ()
      let _ = keep "kept"
      say "inner done"
    }
    say "outer done"
  }
