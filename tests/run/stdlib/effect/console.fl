// `Console` and `LogLevel`: the levels' lines go through `Host.Console`, in
// order, `log`, `info` and `debug` to stdout and `warn` and `error` to
// stderr; and how levels compare.
module App.Main exposing (main)

levels : List LogLevel.Severity
let levels = [
  LogLevel.Fatal,
  LogLevel.Error,
  LogLevel.Warn,
  LogLevel.Info,
  LogLevel.Debug,
  LogLevel.Trace,
]

/// A console that keeps what it is told, with the stream, in order.
recording : Ref (List String) -> Layer none none {Host.Console}
let recording lines =
  Layer.succeed Host.Console {
    stdout_line = fun text -> Ref.update lines (fun kept -> kept ++ ["out " ++ text])
    stderr_line = fun text -> Ref.update lines (fun kept -> kept ++ ["err " ++ text])
    stdout_write = fun text -> Ref.update lines (fun kept -> kept ++ ["write " ++ text])
  }

main : Unit ->{Host.Console, Async; AppError} Unit
let main () =
  Console.log "log"
  Console.info "info"
  Console.debug "debug"
  Console.warn "warn to stderr"
  Console.error "error to stderr"
  let lines = Ref.make []
  provide (recording lines) {
    Console.log "a"
    Console.warn "b"
    Console.info "c"
    Console.error "d"
    Console.debug "e"
  }
  Platform.stdout_line ("recorded: " ++ show (Ref.get lines))
  let warn_level = LogLevel.Warn
  Platform.stdout_line ("values: " ++ show LogLevel.all ++ " " ++ show warn_level)
  Platform.stdout_line ("compare info warn: " ++ show (compare LogLevel.Info LogLevel.Warn))
  Platform.stdout_line
    ("sorted: "
      ++ show
        (List.sort [LogLevel.Debug, LogLevel.Fatal, LogLevel.All, LogLevel.Off, LogLevel.Info]))
  Platform.stdout_line
    ("warn > info: " ++ show (LogLevel.Warn |> LogLevel.is_greater_than LogLevel.Info))
  Platform.stdout_line
    ("warn >= warn: " ++ show (LogLevel.Warn |> LogLevel.is_greater_than_or_equal_to LogLevel.Warn))
  Platform.stdout_line
    ("debug < trace: " ++ show (LogLevel.Debug |> LogLevel.is_less_than LogLevel.Trace))
  Platform.stdout_line
    ("error <= fatal: "
      ++ show (LogLevel.Error |> LogLevel.is_less_than_or_equal_to LogLevel.Fatal))
  Platform.stdout_line
    ("eq: "
      ++ show (
        warn_level == LogLevel.Warn,
        warn_level == LogLevel.Debug,
        LogLevel.value LogLevel.Trace,
      ))
  Platform.stdout_line
    ("enabled: "
      ++ show (
        List.length levels,
        LogLevel.is_enabled LogLevel.Info,
        LogLevel.is_enabled LogLevel.Debug,
      ))
