// Effect's `Console` and `LogLevel`: what the console writes, in order, and
// how levels compare.
module App.Main exposing (main)

type alias Row = { name : String; size : Number }

levels : List LogLevel.Severity
let levels =
  [LogLevel.fatal, LogLevel.error, LogLevel.warn, LogLevel.info, LogLevel.debug, LogLevel.trace]

main : Unit ->{; AppError} Unit
let main () =
  Console.log "log"
  Console.info "info"
  Console.debug "debug"
  Console.warn "warn to stderr"
  Console.error "error to stderr"
  Console.trace "traced"
  Console.assert true "never written"
  Console.assert false "written to stderr"
  Console.count "calls"
  Console.count "calls"
  Console.count_reset "calls"
  Console.count "calls"
  Console.dir 42
  Console.dirxml "xml"
  let rows : List Row = [{ name = "a"; size = 1 }, { name = "b"; size = 2 }]
  Console.table (Some ["size"]) rows
  let grouped =
    Console.with_group { label = Some "group"; collapsed = false } (task {
      Console.log "inside the group"
      1
    })
  Console.log ("after the group " ++ show grouped)
  scope {
    Console.group { label = Some "scoped"; collapsed = true }
    Console.log "in a scoped group"
  }
  Console.log "the scope closed the group"
  let quiet : Console.Console = Console.to_stderr ()
  Console.with_console quiet (task {
    scope {
      Console.time "timer"
      Console.time_log "timer" "is running"
    }
    Console.with_time "with_time" (task { () })
    Console.clear ()
    Console.log "to stderr"
  })
  let same = Console.with_console quiet (task { Console.current () })
  Console.dir (same == quiet)
  Console.log "back on stdout"
  let warn_level : LogLevel.LogLevel = LogLevel.warn
  Platform.stdout_line ("values: " ++ show LogLevel.values ++ " " ++ show warn_level)
  Platform.stdout_line
    ("ordinal info < warn: "
      ++ show (LogLevel.get_ordinal LogLevel.info < LogLevel.get_ordinal LogLevel.warn))
  Platform.stdout_line
    ("sorted: "
      ++ show
        (List.sort [LogLevel.debug, LogLevel.fatal, LogLevel.all, LogLevel.none_, LogLevel.info]))
  Platform.stdout_line
    ("warn > info: " ++ show (LogLevel.warn |> LogLevel.is_greater_than LogLevel.info))
  Platform.stdout_line
    ("warn >= warn: " ++ show (LogLevel.warn |> LogLevel.is_greater_than_or_equal_to LogLevel.warn))
  Platform.stdout_line
    ("debug < trace: " ++ show (LogLevel.debug |> LogLevel.is_less_than LogLevel.trace))
  Platform.stdout_line
    (
      "error <= fatal: "
        ++ show (LogLevel.error |> LogLevel.is_less_than_or_equal_to LogLevel.fatal)
    )
  Platform.stdout_line
    ("eq: "
      ++ show
        (
          LogLevel.info == LogLevel.info,
          LogLevel.info == LogLevel.debug,
          LogLevel.name LogLevel.trace,
        ))
  Platform.stdout_line
    ("enabled: "
      ++ show
        (List.length levels, LogLevel.is_enabled LogLevel.info, LogLevel.is_enabled LogLevel.debug))
