// Effect's `Console` and `LogLevel`: what the console writes, in order, and
// how levels compare.
module App.Main exposing (main)

type alias Row = { name : String; size : Float }

levels : List LogLevel.Severity
let levels = [
  LogLevel.Fatal,
  LogLevel.Error,
  LogLevel.Warn,
  LogLevel.Info,
  LogLevel.Debug,
  LogLevel.Trace,
]

main : Unit ->{Async; AppError} Unit
let main () =
  Console.log "log"
  Console.info "info"
  Console.debug "debug"
  Console.warn "warn to stderr"
  Console.error "error to stderr"
  Console.trace "traced"
  Console.assert true "never written"
  Console.assert false "written to stderr"
  Console.count "calls"
  Console.count "calls"
  Console.count_reset "calls"
  Console.count "calls"
  Console.dir 42
  Console.dirxml "xml"
  let rows : List Row = [{ name = "a"; size = 1 }, { name = "b"; size = 2 }]
  Console.table (Some ["size"]) rows
  let grouped =
    Console.with_group
      { label = Some "group"; collapsed = false }
      (task {
        Console.log "inside the group"
        1
      })
  Console.log ("after the group " ++ show grouped)
  scope {
    Console.group { label = Some "scoped"; collapsed = true }
    Console.log "in a scoped group"
  }
  Console.log "the scope closed the group"
  let quiet = Console.to_stderr ()
  Console.with_console
    quiet
    (task {
      scope {
        Console.time "timer"
        Console.time_log "timer" "is running"
      }
      Console.with_time "with_time" Effect.void
      Console.clear ()
      Console.log "to stderr"
    })
  let same = Console.with_console quiet (task { Console.current () })
  Console.dir (same == quiet)
  Console.log "back on stdout"
  let warn_level = LogLevel.Warn
  Platform.stdout_line ("values: " ++ show LogLevel.all ++ " " ++ show warn_level)
  Platform.stdout_line ("compare info warn: " ++ show (compare LogLevel.Info LogLevel.Warn))
  Platform.stdout_line
    ("sorted: "
      ++ show
        (List.sort [LogLevel.Debug, LogLevel.Fatal, LogLevel.All, LogLevel.Off, LogLevel.Info]))
  Platform.stdout_line
    ("warn > info: " ++ show (LogLevel.Warn |> LogLevel.is_greater_than LogLevel.Info))
  Platform.stdout_line
    ("warn >= warn: " ++ show (LogLevel.Warn |> LogLevel.is_greater_than_or_equal_to LogLevel.Warn))
  Platform.stdout_line
    ("debug < trace: " ++ show (LogLevel.Debug |> LogLevel.is_less_than LogLevel.Trace))
  Platform.stdout_line
    ("error <= fatal: "
      ++ show (LogLevel.Error |> LogLevel.is_less_than_or_equal_to LogLevel.Fatal))
  Platform.stdout_line
    ("eq: "
      ++ show (
        warn_level == LogLevel.Warn,
        warn_level == LogLevel.Debug,
        LogLevel.value LogLevel.Trace,
      ))
  Platform.stdout_line
    ("enabled: "
      ++ show (
        List.length levels,
        LogLevel.is_enabled LogLevel.Info,
        LogLevel.is_enabled LogLevel.Debug,
      ))
