// Effect's `Request` and `RequestResolver`: requests made at the same time
// are batched into one call of the resolver, which completes each entry.
module App.Main exposing (main)

import Request exposing (Entry, Request)
import RequestResolver exposing (RequestResolver)

type Query = UserName Float
  deriving Eq, Show

type error NotFound = NotFound Float

type alias UserEntry = Entry Query {NotFound} String

lookup : Float ->{; NotFound} String
let lookup id = if id < 10 then "user" ++ show id else from_result (Err (NotFound id))

id_of : UserEntry -> Float
let id_of entry =
  match Request.request entry with
  | UserName id -> id

ask : Float -> Request Query {NotFound} String
let ask id = Request.of (UserName id)

answer : UserEntry ->{} Unit
let answer entry =
  let id = id_of entry
  if id < 10 then Request.succeed ("user" ++ show id) entry else Request.fail (NotFound id) entry

answer_all : NonEmpty.NonEmpty UserEntry ->{; NotFound} Unit
let answer_all entries =
  Platform.stdout_line ("batch of " ++ show (NonEmpty.length entries))
  List.each_effect answer (NonEmpty.to_list entries)

describe : Result NotFound String -> String
let describe result =
  match result with
  | Ok name -> name
  | Err (NotFound id) -> "not found " ++ show id

fail_with : UserEntry -> Exit {NotFound} String ->{} Unit
let fail_with entry exit =
  match Exit.failure exit with
  | Some failure -> Request.fail_cause failure entry
  | None -> ()

run_all : RequestResolver Query {NotFound} String -> List Float ->{} String
let run_all resolver ids =
  let results = parallel_results (List.map (fun id -> task { Request.run resolver (ask id) }) ids)
  show (List.map describe results)

batched : RequestResolver Query {NotFound} String
let batched = RequestResolver.make answer_all

completing : RequestResolver Query {NotFound} String
let completing =
  RequestResolver.make (fun entries ->
    match NonEmpty.to_list entries with
    | [first, second, third] ->
      let exits = parallel_exits [task { lookup (id_of first) }]
      List.each_effect (fun exit -> Request.complete exit first) exits
      Request.complete_effect (task { lookup (id_of second) }) second
      let failures = parallel_exits [task { lookup 99 }]
      List.each_effect (fail_with third) failures
    | _ -> ()
  )

with_options : RequestResolver Query {NotFound} String
let with_options =
  RequestResolver.make_with {
    batchKey = fun entry -> id_of entry % 2;
    preCheck = None;
    delay = Effect.void;
    collectWhile = fun entries -> List.length entries < 10;
    runAll = fun entries key ->
      Platform.stdout_line ("key " ++ show key ++ " batch of " ++ show (NonEmpty.length entries))
      List.each_effect answer (NonEmpty.to_list entries);
  }

by_parity : RequestResolver Query {NotFound} String
let by_parity =
  RequestResolver.make_grouped {
    key = fun entry -> id_of entry < 3;
    resolver = fun entries small ->
      Platform.stdout_line
        ("small " ++ show small ++ " batch of " ++ show (NonEmpty.length entries))
      List.each_effect answer (NonEmpty.to_list entries);
  }

trace_options : Tracer.SpanOptions
let trace_options = {
  attributes = [];
  links = [];
  parent = None;
  root = false;
  kind_ = Tracer.internal;
  sampled = None;
  level = None;
  captureStackTrace = false;
  disablePropagation = false;
}

twice : (c ->{; e} String) -> c ->{; e} String
let twice get cache = get cache ++ " " ++ get cache

main : Unit ->{; AppError} Unit
let main () =
  Platform.stdout_line ("payload " ++ show (Request.payload (ask 1)))
  Platform.stdout_line ("make " ++ run_all batched [1, 2, 3, 12])
  Platform.stdout_line ("complete " ++ run_all completing [1, 2, 3])
  Platform.stdout_line ("make_with " ++ run_all with_options [1, 2, 3])
  Platform.stdout_line ("make_grouped " ++ run_all by_parity [1, 2, 3])
  Platform.stdout_line
    ("grouped " ++ run_all (RequestResolver.grouped (fun e -> id_of e < 2) batched) [1, 2, 3])
  Platform.stdout_line ("batch_n " ++ run_all (RequestResolver.batch_n 2 batched) [1, 2, 3])
  let one_by_one : RequestResolver Query {NotFound} String =
    RequestResolver.from_function (fun e -> "fn" ++ show (id_of e))
  Platform.stdout_line ("from_function " ++ run_all one_by_one [1, 2])
  let lists =
    RequestResolver.from_function_batched (fun es ->
      List.map (fun e -> "b" ++ show (id_of e)) (NonEmpty.to_list es)
    )
  Platform.stdout_line ("from_function_batched " ++ run_all lists [1, 2])
  let effects = RequestResolver.from_effect (fun e -> lookup (id_of e))
  Platform.stdout_line ("from_effect " ++ run_all effects [1, 11])
  let delayed =
    batched |> RequestResolver.set_delay (Result.with_default Duration.zero (Duration.millis 1))
  Platform.stdout_line ("set_delay " ++ run_all delayed [4, 5])
  let delayed_effect =
    batched |> RequestResolver.set_delay_effect (task { Platform.stdout_line "delay ran" })
  Platform.stdout_line ("set_delay_effect " ++ run_all delayed_effect [6])
  let wrapped =
    RequestResolver.around
      (fun es -> NonEmpty.length es)
      (fun _ n -> Platform.stdout_line ("around after " ++ show n))
      batched
  Platform.stdout_line ("around " ++ run_all wrapped [7, 8])
  Platform.stdout_line ("race " ++ run_all (RequestResolver.race RequestResolver.never batched) [1])
  let never : RequestResolver Query none String = RequestResolver.never
  let stuck = timeout_option 5 (task { Request.run never (Request.of (UserName 1)) })
  Platform.stdout_line ("never " ++ show (Option.is_none stuck))
  Platform.stdout_line
    ("with_span " ++ run_all (RequestResolver.with_span "users" trace_options batched) [1])
  let cached =
    RequestResolver.with_cache { capacity = 10; strategy = Some RequestResolver.lru } batched
  Platform.stdout_line ("with_cache " ++ run_all cached [1])
  Platform.stdout_line ("with_cache again " ++ run_all cached [1])
  let _ = RequestResolver.fifo
  let cache = RequestResolver.as_cache { capacity = 10; timeToLive = None } batched
  let cached_names =
    try twice (Cache.get (ask 2)) cache with
    | NotFound id -> "not found " ++ show id
  Platform.stdout_line ("as_cache " ++ cached_names)
