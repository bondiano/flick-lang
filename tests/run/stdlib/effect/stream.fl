// Sources of Effect's `Stream` and the calls that run them.
module App.Main exposing (main)

type error Boom = Boom Float

ms1 : Duration.Duration
let ms1 = Result.with_default Duration.zero (Duration.millis 1)

line : Show a => (String, List a) ->{} Unit
let line (label, xs) = Platform.stdout_line (label ++ ": " ++ show xs)

/// Counts down from `n`, built by recursion.
countdown : Float -> Stream.Stream none none Float
let rec countdown n =
  if n <= 0 then
    Stream.empty
  else
    Stream.concat (Stream.suspend (fun () -> countdown (n - 1))) (Stream.succeed n)

/// Adds one to the counter, giving the new count.
bump : Ref Float -> Eff none none Float
let bump calls = task {
  Ref.set calls (Ref.get calls + 1)
  Ref.get calls
}

/// Records `n`, going on while it is below 5.
record : Ref (List Int) -> Int ->{} Bool
let record seen n =
  Ref.set seen (Ref.get seen ++ [n])
  n < 5

main : Unit ->{Async; AppError} Unit
let main () =
  line ("make", (Stream.run_collect (Stream.make [1, 2, 3])))
  line ("from_list", (Stream.run_collect (Stream.from_list [4, 5])))
  line ("from_lists", (Stream.run_collect (Stream.from_lists [[1], [2, 3]])))
  let nothing : List Float = Stream.run_collect Stream.empty
  line ("empty", nothing)
  line ("range", (Stream.run_collect (Stream.range 1 5)))
  line ("countdown", (Stream.run_collect (countdown 3)))
  line ("iterate", (Stream.run_collect (Stream.take 4 (Stream.iterate 1 (fun n -> n * 2)))))
  line (
    "unfold",
    (Stream.run_collect (Stream.unfold 1 (fun n -> if n > 3 then None else Some (n * 10, n + 1)))),
  )
  line (
    "paginate",
    (Stream.run_collect
      (Stream.paginate 0 (fun n -> ([n, n], if n < 2 then Some (n + 1) else None)))),
  )
  let calls = Ref.make 0
  let counted = Stream.from_effect (bump calls)
  line ("from_effect twice", (Stream.run_collect (Stream.concat counted counted)))
  line (
    "from_effect_drain",
    (Stream.run_collect
      (Stream.concat (Stream.from_effect_drain (task { Ref.set calls 10 })) (Stream.succeed 0))),
  )
  line ("after drain", [Ref.get calls])
  line (
    "from_effect_repeat",
    (Stream.run_collect (Stream.take 3 (Stream.from_effect_repeat (bump calls)))),
  )
  line (
    "from_effect_schedule",
    (Stream.run_collect (Stream.from_effect_schedule (Schedule.recurs 2) (task { 7 }))),
  )
  line ("from_list_effect", (Stream.run_collect (Stream.from_list_effect (task { [1, 2] }))))
  line (
    "from_list_effect_repeat",
    (Stream.run_collect (Stream.take 5 (Stream.from_list_effect_repeat (task { [8, 9] })))),
  )
  line ("unwrap", (Stream.run_collect (Stream.unwrap (task { Stream.make [Ref.get calls] }))))
  line ("tick", [Stream.run_count (Stream.take 3 (Stream.tick ms1))])
  line ("from_schedule", (Stream.run_collect (Stream.from_schedule (Schedule.recurs 2))))
  let queue = Queue.unbounded ()
  let _ = Queue.offer_all [1, 2, 3] queue
  let _ = Queue.end queue
  line ("from_queue", (Stream.run_collect (Stream.from_queue queue)))
  let produced =
    Stream.callback (fun q ->
      let _ = Queue.offer_all [5, 6] q
      Queue.end q
    )
  line ("callback", (Stream.run_collect produced))
  let hub = PubSub.unbounded { replay = Some 3 }
  let _ = PubSub.publish_all [1, 2, 3] hub
  line ("from_pubsub", (Stream.run_collect (Stream.take 3 (Stream.from_pubsub hub))))
  let ref = SubscriptionRef.make 4
  line (
    "from_subscription_ref",
    (Stream.run_collect (Stream.take 1 (Stream.from_subscription_ref ref))),
  )
  let tx = TxSubscriptionRef.make 6
  line (
    "from_tx_subscription_ref",
    (Stream.run_collect (Stream.take 1 (Stream.from_tx_subscription_ref tx))),
  )
  line ("never", [Stream.run_count (Stream.take 0 Stream.never)])
  line ("default_chunk_size", [Stream.default_chunk_size])
  line ("run_count", [Stream.run_count (Stream.range 1 4)])
  line ("run_sum", [Stream.run_sum (Stream.map Int.to_float (Stream.range 1 4))])
  line ("run_head", (Option.to_list (Stream.run_head (Stream.range 7 9))))
  line ("run_last", (Option.to_list (Stream.run_last (Stream.range 7 9))))
  line ("run_fold", [Stream.run_fold 0 (fun acc n -> acc * 10 + n) (Stream.range 1 3)])
  line ("run_fold_effect", [Stream.run_fold_effect 1 (fun acc n -> acc * n) (Stream.range 1 4)])
  let seen = Ref.make []
  Stream.run_for_each (fun n -> Ref.set seen (Ref.get seen ++ [n])) (Stream.range 1 3)
  line ("run_for_each", (Ref.get seen))
  Stream.run_for_each_while (fun n -> record seen n) (Stream.range 4 9)
  line ("run_for_each_while", (Ref.get seen))
  let sizes = Ref.make []
  Stream.run_for_each_chunk
    (fun chunk -> Ref.set sizes (Ref.get sizes ++ [Int.to_float (NonEmpty.length chunk)]))
    (Stream.from_lists [[1, 2], [3]])
  line ("run_for_each_chunk", (Ref.get sizes))
  Stream.run_drain (Stream.from_effect (task { Ref.set calls 99 }))
  line ("run_drain", [Ref.get calls])
  Platform.stdout_line ("mk_string: " ++ Stream.mk_string (Stream.make ["a", "b", "c"]))
  line ("mk_bytes", (Stream.mk_bytes (Stream.make [[1, 2], [3]])))
  let target = PubSub.unbounded { replay = Some 2 }
  Stream.run_into_pubsub target (Stream.make [1, 2])
  line ("run_into_pubsub", (Stream.run_collect (Stream.take 2 (Stream.from_pubsub target))))
  let sink = Queue.unbounded ()
  Stream.run_into_queue sink (Stream.make [3, 4])
  line ("run_into_queue", (Queue.collect sink))
  let failed =
    Stream.run_collect (Stream.result (Stream.concat (Stream.fail (Boom 1)) (Stream.succeed 1)))
  Platform.stdout_line
    ("fail: "
      ++ show
        (List.map
          (fun r ->
            match r with
            | Ok n -> n
            | Err (Boom n) -> 0 - n
          )
          failed))
  let died =
    Stream.run_collect (Stream.catch_defect (fun _ -> Stream.succeed "caught") (Stream.die "no"))
  Platform.stdout_line ("die: " ++ show died)
  let rethrown : Stream.Stream none {Boom} Float =
    Stream.catch_cause (fun failure -> Stream.fail_cause failure) (Stream.fail (Boom 2))
  let recovered =
    try Stream.run_collect rethrown with
    | Boom n -> [n]
  line ("fail_cause", recovered)
