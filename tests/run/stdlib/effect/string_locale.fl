// `String.locale_compare` and the case mappings of a locale: Intl's
// collation and ICU's special casing. An invalid tag is a defect.
module App.Main exposing (main)

main : Unit ->{} Unit
let main () =
  Platform.stdout_line
    ("locale_compare: "
      ++ show ("a" |> String.locale_compare "en" "b")
      ++ " "
      ++ show ("b" |> String.locale_compare "en" "a")
      ++ " "
      ++ show ("a" |> String.locale_compare "en" "a"))
  Platform.stdout_line ("el: " ++ String.to_locale_upper "el" "άδικος, ή ῃ ΐ άι")
  Platform.stdout_line
    ("lt: "
      ++ String.to_locale_lower "lt" "Ì J\u{301}"
      ++ " "
      ++ show (String.length (String.to_locale_upper "lt" "i\u{307}\u{300}")))
  Platform.stdout_line ("tr: " ++ String.to_locale_lower "tur" "İI I\u{307}" ++ " " ++ String.to_locale_upper "AZ" "i")
  Platform.stdout_line (String.to_locale_upper "tr_TR" "i")
