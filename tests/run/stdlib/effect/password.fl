// PBKDF2 against the vectors of RFC 7914 and RFC 6070, and password hashes:
// a hash written elsewhere verifies here, a fresh one verifies itself, and a
// stored text of another form is refused.
module App.Main exposing (main)

line : String -> String -> Unit ->{} Unit
let line label value () = Platform.stdout_line (label ++ ": " ++ value)

digit : Int -> String
let digit n = String.slice n (n + 1) "0123456789abcdef"

hex : List Int -> String
let hex bytes = String.join "" (List.map (fun b -> digit (b / 16) ++ digit (b % 16)) bytes)

text : String -> List Int
let text s = Bytes.from_string s

stored : String
let stored =
  "$pbkdf2-sha256$i=1000$AAECAwQFBgcICQoLDA0ODw$yRTMTwbMbo9G0VfjobWqerzuuxe7BETNTErBbKKumGQ"

refused : String -> Unit ->{Async;} Unit
let refused hash () =
  let outcome =
    try show (Crypto.verify_password "x" hash) with
    | Crypto.CryptoError _ -> "refused"
  line "malformed" outcome ()

checks : Unit ->{Async, Crypto.Crypto; Crypto.CryptoError} Unit
let checks () =
  line "sha256 c=1" (hex (Crypto.pbkdf2 Crypto.Sha256 1 64 (text "salt") (text "passwd"))) ()
  line "sha1 c=4096" (hex (Crypto.pbkdf2 Crypto.Sha1 4096 20 (text "salt") (text "password"))) ()
  line "sha512 c=2" (hex (Crypto.pbkdf2 Crypto.Sha512 2 64 (text "salt") (text "password"))) ()
  line "stored right" (show (Crypto.verify_password "correct horse" stored)) ()
  line "stored wrong" (show (Crypto.verify_password "battery staple" stored)) ()
  let fresh = Crypto.hash_password "s3cret"
  line
    "fresh form"
    (show (List.length (String.split "$" fresh))
      ++ " "
      ++ show (String.starts_with "$pbkdf2-sha256$i=600000$" fresh))
    ()
  line
    "fresh verifies"
    (show (Crypto.verify_password "s3cret" fresh)
      ++ " "
      ++ show (Crypto.verify_password "s3cre" fresh))
    ()
  refused "plain" ()
  refused "$pbkdf2-sha256$i=0$AAEC$AAEC" ()
  refused "$argon2id$i=1$AAEC$AAEC" ()
  let zero =
    try show (Crypto.pbkdf2 Crypto.Sha256 0 32 [] []) with
    | Crypto.CryptoError _ -> "refused"
  line "zero rounds" zero ()

main : Unit ->{Async; AppError} Unit
let main () =
  try provide Crypto.system { checks () } with
  | Crypto.CryptoError message -> line "error" message ()
