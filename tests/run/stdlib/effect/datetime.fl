// Effect's `DateTime`: parsing that fails with a typed error, time zones,
// parts, calendar arithmetic, comparisons and formatting.
module App.Main exposing (main)

import DateTime exposing (CurrentTimeZone)

keep : DateTime.ZoneOptions
let keep = { adjustForTimeZone = None; disambiguation = None }

wall : DateTime.Disambiguation -> DateTime.ZoneOptions
let wall d = { adjustForTimeZone = Some true; disambiguation = Some d }

styles : DateTime.FormatOptions
let styles = { locale = Some "en-GB"; dateStyle = Some "medium"; timeStyle = Some "short" }

iso : Result DateTime.DateTimeError DateTime.DateTime -> String
let iso r =
  match r with
  | Ok t -> DateTime.format_iso_offset t
  | Err (DateTime.DateTimeError message) -> "error: " ++ message

text : Result DateTime.DateTimeError String -> String
let text r =
  match r with
  | Ok s -> s
  | Err (DateTime.DateTimeError message) -> "error: " ++ message

/// A date-time of a string the test knows is valid.
at : String ->{} DateTime.DateTime
let at s =
  match DateTime.make s with
  | Ok t -> t
  | Err _ -> DateTime.now ()

paris : DateTime.TimeZone
let paris =
  match DateTime.zone_make_named "Europe/Paris" with
  | Ok z -> z
  | Err _ -> DateTime.zone_make_offset 3600000

describe : DateTime.DateTime -> String
let describe t =
  DateTime.match_
    {
      onUtc = fun u -> "utc " ++ DateTime.format_iso u;
      onZoned = fun z -> "zoned " ++ DateTime.format_iso_offset z;
    }
    t

zoned_in : DateTime.DateTime ->{CurrentTimeZone;} String
let zoned_in t =
  let here = DateTime.now_in_current_zone ()
  DateTime.format_iso_offset (DateTime.set_zone_current t)
    ++ " "
    ++ show (Option.is_some (DateTime.zoned_offset here))

main : Unit ->{; AppError} Unit
let main () =
  let t = at "2024-03-10T08:30:15.250Z"
  Platform.stdout_line
    ("make: "
      ++ show [
        iso (DateTime.make "2024-03-10T08:30:00"),
        iso (DateTime.make "not a date"),
        iso (DateTime.make "March 10, 2024 8:30 PM"),
        iso (DateTime.make "3/10/24"),
        iso (DateTime.from_epoch_seconds 86400),
        iso (DateTime.from_epoch_seconds (0 / 0)),
      ])
  Platform.stdout_line
    ("from_parts: "
      ++ iso
        (DateTime.from_parts {
          DateTime.no_parts with
          year = Some 2024;
          month = Some 2;
          day = Some 29;
          hour = Some 12;
        }))
  Platform.stdout_line
    ("zoned string: "
      ++ show [
        iso (DateTime.make_zoned_from_string "2024-03-10T09:00:00.000+01:00[Europe/Paris]"),
        iso (DateTime.make_zoned_from_string "2024-03-10T09:00:00+02:00"),
        iso (DateTime.make_zoned_from_string "nowhere"),
      ])
  Platform.stdout_line
    ("zones: "
      ++ show [
        DateTime.zone_to_string paris,
        DateTime.zone_to_string (DateTime.zone_make_offset (-5400000)),
        text (Result.map DateTime.zone_to_string (DateTime.zone_from_string "+05:30")),
        text (Result.map DateTime.zone_to_string (DateTime.zone_from_string "Mars/Olympus")),
      ])
  let in_paris = DateTime.set_zone keep paris t
  Platform.stdout_line
    ("set_zone: "
      ++ show [
        iso in_paris,
        iso (DateTime.set_zone_offset keep 7200000 t),
        iso (DateTime.set_zone_named keep "Asia/Tokyo" t),
        iso (DateTime.set_zone_named keep "Atlantis" t),
      ])
  Platform.stdout_line
    ("make_zoned: "
      ++ show [
        iso (DateTime.make_zoned (wall DateTime.Compatible) paris (at "2024-03-31T02:30:00Z")),
        iso (DateTime.make_zoned (wall DateTime.Reject) paris (at "2024-03-31T02:30:00Z")),
        iso (DateTime.make_zoned (wall DateTime.Earlier) paris (at "2024-10-27T02:30:00Z")),
        iso (DateTime.make_zoned (wall DateTime.Later) paris (at "2024-10-27T02:30:00Z")),
      ])
  let z = Result.with_default t in_paris
  Platform.stdout_line
    ("kind: "
      ++ show (
        DateTime.is_utc t,
        DateTime.is_zoned z,
        describe t,
        describe z,
        DateTime.format_iso (DateTime.to_utc z),
      ))
  Platform.stdout_line
    ("offsets: "
      ++ show (
        DateTime.zoned_offset z,
        DateTime.zoned_offset_iso z,
        DateTime.zoned_offset t,
        DateTime.format_iso_zoned z,
        DateTime.format_iso_zoned t,
      ))
  let p : DateTime.Parts = DateTime.to_parts z
  let u : DateTime.Parts = DateTime.to_parts_utc z
  Platform.stdout_line
    ("parts: "
      ++ show (p.year, p.month, p.day, p.weekDay, p.hour, p.minute, p.second, p.millisecond)
      ++ " utc hour "
      ++ show u.hour)
  Platform.stdout_line
    ("set_parts: "
      ++ show [
        DateTime.format_iso_offset
          (DateTime.set_parts { DateTime.no_parts with hour = Some 23; minute = Some 0 } z),
        DateTime.format_iso (DateTime.set_parts_utc { DateTime.no_parts with weekDay = Some 1 } t),
        DateTime.format_iso (DateTime.remove_time t),
      ])
  Platform.stdout_line
    ("epoch: "
      ++ show (
        DateTime.to_epoch_millis t,
        DateTime.to_epoch_seconds t,
        DateTime.format_iso (DateTime.map_epoch_millis (fun n -> n + 1000) t),
      ))
  Platform.stdout_line
    ("add: "
      ++ show [
        DateTime.format_iso (t |> DateTime.add DateTime.Day 3),
        DateTime.format_iso (t |> DateTime.add DateTime.Month 1),
        DateTime.format_iso (t |> DateTime.subtract DateTime.Year 1),
        DateTime.format_iso (t |> DateTime.subtract DateTime.Hour 9),
        DateTime.format_iso
          (t
            |> DateTime.add DateTime.Week 1
            |> DateTime.add DateTime.Minute 30
            |> DateTime.add DateTime.Second 1
            |> DateTime.add DateTime.Millisecond 5),
      ])
  let hour = Result.with_default Duration.zero (Duration.hours 1)
  Platform.stdout_line
    ("durations: "
      ++ show [
        DateTime.format_iso (DateTime.add_duration hour t),
        DateTime.format_iso (DateTime.subtract_duration hour t),
        Duration.format (DateTime.distance t (at "2024-03-11T08:30:15.250Z")),
        Duration.format (DateTime.distance (at "2024-03-11T08:30:15.250Z") t),
      ])
  let sunday = { weekStartsOn = None }
  let monday = { weekStartsOn = Some 1 }
  Platform.stdout_line
    ("units: "
      ++ show [
        DateTime.format_iso (DateTime.start_of sunday DateTime.Day t),
        DateTime.format_iso (DateTime.end_of sunday DateTime.Month t),
        DateTime.format_iso (DateTime.start_of monday DateTime.Week t),
        DateTime.format_iso (DateTime.start_of sunday DateTime.Week t),
        DateTime.format_iso (DateTime.nearest sunday DateTime.Hour t),
        DateTime.format_iso (DateTime.nearest sunday DateTime.Year t),
      ])
  let early = at "2024-01-01T00:00:00Z"
  let late = at "2025-01-01T00:00:00Z"
  let bounds = { minimum = early; maximum = late }
  Platform.stdout_line
    ("compare: "
      ++ show [
        t |> DateTime.is_less_than late,
        t |> DateTime.is_less_than_or_equal_to early,
        t |> DateTime.is_greater_than early,
        late |> DateTime.is_greater_than_or_equal_to late,
        t |> DateTime.between bounds,
        at "2030-01-01" |> DateTime.between bounds,
      ])
  Platform.stdout_line
    ("order: "
      ++ show (
        DateTime.compare_date_time early late,
        eq t z,
        compare late early,
        DateTime.format_iso (DateTime.min early late),
        DateTime.format_iso (DateTime.max early late),
        DateTime.format_iso (DateTime.clamp bounds (at "2030-01-01")),
      ))
  Platform.stdout_line
    ("format: "
      ++ show [
        text (DateTime.format styles z),
        text (DateTime.format_utc styles z),
        text
          (DateTime.format_intl { styles with locale = Some "en-US" } t
            |> Result.map (fun _ -> "ok")),
        text (DateTime.format_local styles t |> Result.map (fun _ -> "ok")),
        text (DateTime.format { styles with dateStyle = Some "huge" } t),
        text (DateTime.format { styles with locale = Some "!!" } t),
      ])
  let midnight = at "2024-03-10T23:30:00Z" |> DateTime.set_zone keep paris |> Result.with_default t
  Platform.stdout_line
    ("iso: "
      ++ show [
        DateTime.format_iso z,
        DateTime.format_iso_date midnight,
        DateTime.format_iso_date_utc midnight,
        DateTime.format_iso_offset z,
      ])
  let now = DateTime.now ()
  Platform.stdout_line
    ("now: "
      ++ show (
        DateTime.is_utc now,
        DateTime.is_past early,
        DateTime.is_future early,
        DateTime.is_future (DateTime.add DateTime.Year 1 now),
      ))
  let named =
    try DateTime.zone_to_string (DateTime.zone_make_named_effect "Nowhere/City") with
    | DateTime.DateTimeError message -> message
  Platform.stdout_line ("zone_make_named_effect: " ++ named)
  let local = DateTime.zone_make_local ()
  Platform.stdout_line ("local zone: " ++ show (String.length (DateTime.zone_to_string local) > 0))
  let in_tokyo =
    match DateTime.layer_current_zone_named "Asia/Tokyo" with
    | Ok layer -> provide layer { zoned_in t }
    | Err (DateTime.DateTimeError message) -> message
  Platform.stdout_line ("current zone: " ++ in_tokyo)
  Platform.stdout_line
    ("current offset: " ++ provide (DateTime.layer_current_zone_offset (-3600000)) { zoned_in t })
  Platform.stdout_line
    ("current fixed: " ++ provide (DateTime.layer_current_zone paris) { zoned_in t })
  Platform.stdout_line
    ("current local: "
      ++ provide DateTime.layer_current_zone_local { String.length (zoned_in t) > 0 |> show })
  Platform.stdout_line
    ("bad zone layer: " ++ show (Result.is_err (DateTime.layer_current_zone_named "Atlantis")))
