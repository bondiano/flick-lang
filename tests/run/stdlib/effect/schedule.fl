// Schedules from Effect's `Schedule`, run by `Effect.repeat` and `Effect.retry`.
module App.Main exposing (main)

type error Flaky = Flaky Float

ms : Float -> Duration.Duration
let ms n = Result.with_default Duration.zero (Duration.millis n)

/// Throws: a defect, not a typed failure.
explode : String ->{} JsValue
foreign sync explode from global "JSON.parse"

/// Fails with `Flaky n` on the first `failures` calls, counting them.
flaky : Ref Float -> Float -> Eff none {Flaky} String
let flaky calls failures = task {
  let n = Ref.get calls + 1
  Ref.set calls n
  if n <= failures then from_result (Err (Flaky n)) else "ok after " ++ show n
}

/// The attempt a step's metadata names, read through both record types.
attempt_of : Schedule.Metadata o i -> Int
let attempt_of m =
  let input : Schedule.InputMetadata i = {
    input = m.input;
    attempt = m.attempt;
    start = m.start;
    now = m.now;
    elapsed = m.elapsed;
    elapsedSincePrevious = m.elapsedSincePrevious;
  }
  input.attempt

/// At most two steps of `schedule`.
limited : Schedule.Schedule r e i o -> Schedule.Schedule r e i o
let limited schedule = Schedule.up_to { duration = None; times = Some 2 } schedule

/// How many times `schedule` runs a task that counts its runs.
count : Schedule.Schedule none none Float o ->{} Float
let count schedule =
  let calls = Ref.make 0
  let _ =
    Effect.repeat
      schedule
      (task {
        Ref.set calls (Ref.get calls + 1)
        Ref.get calls
      })
  Ref.get calls

delays : Schedule.Schedule none none Float Duration.Duration ->{} List String
let delays schedule =
  let seen = Ref.make []
  let traced =
    Schedule.tap (fun m -> Ref.set seen (Ref.get seen ++ [Duration.format m.output])) schedule
  let _ = Effect.repeat (Schedule.up_to { duration = None; times = Some 3 } traced) (task { 0 })
  Ref.get seen

main : Unit ->{; AppError} Unit
let main () =
  Platform.stdout_line ("recurs 2: " ++ show (count (Schedule.recurs 2)))
  Platform.stdout_line ("once: " ++ show (count (Schedule.map (fun _ -> 0) Schedule.once)))
  Platform.stdout_line ("forever up to 2: " ++ show (count (limited Schedule.forever)))
  Platform.stdout_line ("spaced: " ++ show (count (limited (Schedule.spaced (ms 1)))))
  Platform.stdout_line ("fixed: " ++ show (count (limited (Schedule.fixed (ms 1)))))
  Platform.stdout_line ("windowed: " ++ show (count (limited (Schedule.windowed (ms 1)))))
  Platform.stdout_line ("duration: " ++ show (count (Schedule.duration (ms 1))))
  Platform.stdout_line ("jittered: " ++ show (count (Schedule.jittered (Schedule.recurs 1))))
  Platform.stdout_line ("exponential: " ++ show (delays (Schedule.exponential (ms 1) 3)))
  Platform.stdout_line ("fibonacci: " ++ show (delays (Schedule.fibonacci (ms 1))))
  Platform.stdout_line ("during: " ++ show (List.length (delays (Schedule.during (ms 1000)))))
  Platform.stdout_line
    ("max: " ++ show (count (Schedule.max (NonEmpty.cons (Schedule.recurs 1) [Schedule.recurs 3]))))
  Platform.stdout_line
    ("min: " ++ show (count (Schedule.min (NonEmpty.cons (Schedule.recurs 1) [Schedule.recurs 3]))))
  Platform.stdout_line
    ("concat: " ++ show (count (Schedule.concat (Schedule.recurs 2) (Schedule.recurs 1))))
  let tagged = Schedule.concat_result (Schedule.recurs 1) (Schedule.recurs 1)
  let last = Effect.repeat tagged (task { 0 })
  Platform.stdout_line
    ("concat_result: "
      ++ (
        match last with
        | Err n -> "first " ++ show n
        | Ok n -> "second " ++ show n
      ))
  let passed = Effect.repeat (Schedule.passthrough (Schedule.recurs 2)) (task { 7 })
  Platform.stdout_line ("passthrough: " ++ show passed)
  let echoed =
    Effect.repeat
      (Schedule.up_to { duration = None; times = Some 1 } (Schedule.identity ()))
      (task { "echo" })
  Platform.stdout_line ("identity: " ++ echoed)
  let small = Schedule.while (fun m -> attempt_of m < 3) Schedule.forever
  Platform.stdout_line ("while: " ++ show (count small))
  let slow = Schedule.add_delay (fun _ -> ms 1) (Schedule.recurs 1)
  let none_delay = Schedule.modify_delay (fun _ -> Duration.zero) (Schedule.spaced (ms 10000))
  Platform.stdout_line ("delays: " ++ show (count slow, count (limited none_delay)))
  let attempts =
    Effect.repeat
      (Schedule.recurs 2)
      (task {
        let m = Schedule.current_metadata ()
        m.attempt
      })
  Platform.stdout_line ("current_metadata: " ++ show attempts)
  let calls = Ref.make 0
  let retried =
    try Effect.retry (Schedule.recurs 5) (flaky calls 2) with
    | Flaky n -> "failed at " ++ show n
  Platform.stdout_line retried
  let exhausted = Ref.make 0
  let gave_up =
    try Effect.retry (Schedule.recurs 2) (flaky exhausted 10) with
    | Flaky n -> "gave up at " ++ show n
  Platform.stdout_line gave_up
  let other = Ref.make 0
  let fallback =
    Effect.retry_or_else
      (Schedule.recurs 1)
      (fun (Flaky n) out -> "fallback " ++ show (n, out))
      (flaky other 10)
  Platform.stdout_line fallback
  let defects = Ref.make 0
  let died =
    parallel_exits [
      task {
        Effect.retry
          (Schedule.recurs 5)
          (task {
            Ref.set defects (Ref.get defects + 1)
            let _ = explode "{"
            "unreachable"
          })
      },
    ]
  let defect =
    match died with
    | [exit] ->
      match Exit.failure exit with
      | Some failure -> if Option.is_some (Failure.primary failure) then "some" else "none"
      | None -> "succeeded"
    | _ -> "?"
  Platform.stdout_line ("defect runs " ++ show (Ref.get defects) ++ ", typed error " ++ defect)
  let recovered =
    Effect.repeat_or_else
      (Schedule.recurs 3)
      (fun _ step -> if Option.is_some step then 1 else 0)
      (task { from_result (Err (Flaky 0)) })
  Platform.stdout_line ("repeat_or_else: " ++ show recovered)
  Platform.stdout_line ("schedule: " ++ show (Effect.schedule (Schedule.recurs 2) Effect.void))
  Platform.stdout_line
    ("schedule_from: "
      ++ show (Effect.schedule_from 5 (Schedule.passthrough (Schedule.recurs 1)) (task { 6 })))
  Effect.sleep (ms 1)
  Platform.stdout_line "slept"
