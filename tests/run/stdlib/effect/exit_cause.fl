// Effect's `Exit` and `Cause` over Flick's opaque `Exit` and `Failure`: a
// typed failure, a defect and an interruption stay apart.
module App.Main exposing (main)

type error Boom = Boom Number
  deriving Show

type error Other = Other String
  deriving Show

type alias Ex = Exit {Boom} Number

span_options : Tracer.SpanOptions
let span_options =
  {
    attributes = [];
    links = [];
    parent = None;
    root = false;
    kind_ = Tracer.internal;
    sampled = None;
    level = None;
    captureStackTrace = true;
    disablePropagation = false
  }

/// What a failure holds: fails, dies, interrupts, only interrupts.
flags : Failure e -> String
let flags f =
  show (Cause.has_fails f, Cause.has_dies f, Cause.has_interrupts f, Cause.has_interrupts_only f)

kind_of : Cause.Reason e -> String
let kind_of r =
  if Cause.is_fail_reason r then "fail"
  else if Cause.is_die_reason r then "die"
  else if Cause.is_interrupt_reason r then "interrupt"
  else "?"

kinds : Failure e -> List String
let kinds f = List.map kind_of (Cause.reasons f)

boom_text : Option Boom -> String
let boom_text o =
  match o with
  | Some (Boom n) -> "Boom " ++ show n
  | None -> "none"

defect_of : Ex -> String
let defect_of x =
  match Exit.find_defect x with
  | Ok d -> "defect " ++ d
  | Err _ -> "no defect"

error_of : Ex -> String
let error_of x =
  match Exit.find_error x with
  | Ok (Boom n) -> "error " ++ show n
  | Err e -> "kept " ++ show (Exit.is_failure e)

value_of : Ex -> String
let value_of x =
  match Exit.filter_value x with
  | Ok n -> "value " ++ show n
  | Err e -> "failed " ++ show (Exit.is_failure e)

side : Result Ex Ex -> String
let side r =
  match r with
  | Ok e -> "ok " ++ show (Exit.is_success e)
  | Err e -> "err " ++ show (Exit.is_success e)

cause_of : Ex -> String
let cause_of x =
  match Exit.filter_cause x with
  | Ok f -> flags f
  | Err _ -> "success"

described : Ex -> String
let described x = Exit.match_ (fun n -> "got " ++ show n) (fun f -> "failure " ++ flags f) x

rename : Boom -> Other
let rename e =
  match e with
  | Boom n -> Other ("b" ++ show n)

other_text : Option Other -> String
let other_text o =
  match o with
  | Some (Other s) -> "Other " ++ s
  | None -> "none"

failed : Failure {Boom}
let failed = Cause.fail (Boom 1)

exits : Unit ->{} Unit
let exits () =
  let ok : Ex = Exit.succeed 1
  let bad : Ex = Exit.fail (Boom 2)
  let died : Ex = Exit.die "broken"
  let stopped : Ex = Exit.interrupt (Some 7)
  let from_cause : Ex = Exit.fail_cause failed
  let all = [ok, bad, died, stopped, from_cause]
  Platform.stdout_line ("is_success: " ++ show (List.map Exit.is_success all))
  Platform.stdout_line ("is_failure: " ++ show (List.map Exit.is_failure all))
  Platform.stdout_line ("has: " ++ show (List.map (fun x -> (Exit.has_fails x, Exit.has_dies x, Exit.has_interrupts x)) all))
  Platform.stdout_line ("value: " ++ show (List.map Exit.value all))
  Platform.stdout_line ("find_error_option: " ++ show (List.map (fun x -> boom_text (Exit.find_error_option x)) all))
  Platform.stdout_line ("find_defect: " ++ show (List.map defect_of all))
  Platform.stdout_line ("find_error: " ++ show (List.map error_of all))
  Platform.stdout_line ("filter_value: " ++ show (List.map value_of all))
  Platform.stdout_line ("filter_success: " ++ show (List.map (fun x -> side (Exit.filter_success x)) all))
  Platform.stdout_line ("filter_failure: " ++ show (List.map (fun x -> side (Exit.filter_failure x)) all))
  Platform.stdout_line ("filter_cause: " ++ show (List.map cause_of all))
  Platform.stdout_line ("match_: " ++ show (List.map described all))
  Platform.stdout_line ("map: " ++ show (List.map (fun x -> Exit.value (Exit.map (fun n -> n * 10) x)) all))
  let renamed : Exit {Other} Number = Exit.map_error rename bad
  Platform.stdout_line ("map_error: " ++ other_text (Exit.find_error_option renamed))
  let both : Exit {Other} String = Exit.map_both rename (fun n -> show n) ok
  let both_bad : Exit {Other} String = Exit.map_both rename (fun n -> show n) bad
  Platform.stdout_line ("map_both: " ++ show (Exit.value both) ++ " " ++ other_text (Exit.find_error_option both_bad))
  let nothing : Exit none Unit = Exit.void
  Platform.stdout_line ("as_void: " ++ show (Exit.value (Exit.as_void ok), Exit.is_success nothing))
  Platform.stdout_line ("as_void_all: " ++ show (Exit.is_success (Exit.as_void_all [ok, ok]), Exit.is_success (Exit.as_void_all [ok, bad])))
  Platform.stdout_line ("failure: " ++ show (List.map (fun x -> Option.is_some (Exit.failure x)) all))

find_fail_of : Failure {Boom} -> String
let find_fail_of f =
  match Cause.find_fail f with
  | Ok r -> "fail " ++ kind_of r
  | Err rest -> "rest " ++ show (Cause.has_fails rest)

cause_error : Failure {Boom} -> String
let cause_error f =
  match Cause.find_error f with
  | Ok (Boom n) -> "Boom " ++ show n
  | Err rest -> "rest " ++ show (Cause.has_dies rest)

die_of : Failure {Boom} -> String
let die_of f =
  match Cause.find_die f with
  | Ok r -> kind_of r
  | Err _ -> "no die"

cause_defect : Failure {Boom} -> String
let cause_defect f =
  match Cause.find_defect f with
  | Ok d -> d
  | Err _ -> "no defect"

interrupt_of : Failure {Boom} -> String
let interrupt_of f =
  match Cause.find_interrupt f with
  | Ok r -> kind_of r
  | Err _ -> "no interrupt"

ids : Failure {Boom} -> String
let ids f =
  match Cause.filter_interruptors f with
  | Ok xs -> show xs
  | Err _ -> "none"

causes : Unit ->{} Unit
let causes () =
  let died : Failure {Boom} = Cause.die "broken"
  let stopped : Failure {Boom} = Cause.interrupt (Some 3)
  let nothing : Failure {Boom} = Cause.empty
  let both = Cause.combine died failed
  Platform.stdout_line ("flags: " ++ show (List.map flags [failed, died, stopped, nothing, both]))
  Platform.stdout_line ("kinds: " ++ show (kinds both))
  let rebuilt : Failure {Boom} =
    Cause.from_reasons [Cause.make_fail_reason (Boom 4), Cause.make_die_reason "again", Cause.make_interrupt_reason None]
  Platform.stdout_line ("from_reasons: " ++ show (kinds rebuilt))
  Platform.stdout_line ("find_error_option: " ++ boom_text (Cause.find_error_option rebuilt))
  Platform.stdout_line ("find_fail: " ++ show (List.map find_fail_of [failed, died]))
  Platform.stdout_line ("find_error: " ++ show (List.map cause_error [failed, died]))
  Platform.stdout_line ("find_die: " ++ show (List.map die_of [failed, both]))
  Platform.stdout_line ("find_defect: " ++ show (List.map cause_defect [failed, both]))
  Platform.stdout_line ("find_interrupt: " ++ show (List.map interrupt_of [failed, stopped]))
  Platform.stdout_line ("interruptors: " ++ show (Cause.interruptors stopped))
  Platform.stdout_line ("filter_interruptors: " ++ show (List.map ids [stopped, failed]))
  let mapped : Failure {Other} = Cause.map rename both
  Platform.stdout_line ("map: " ++ other_text (Cause.find_error_option mapped) ++ " " ++ flags mapped)
  Platform.stdout_line ("pretty: " ++ show (String.contains "broken" (Cause.pretty died)))
  Platform.stdout_line ("pretty_errors: " ++ show (List.length (Cause.pretty_errors both)))
  Platform.stdout_line ("stack_trace: " ++ show (Option.is_some (Cause.stack_trace stopped), Option.is_some (Cause.interruptor_stack_trace stopped)))
  Platform.stdout_line ("reason_stack_trace: " ++ show (List.map (fun r -> Option.is_some (Cause.reason_stack_trace r)) (Cause.reasons died)))

/// A stack frame of a traced failure, annotated on another one.
frames : Unit ->{} Unit
let frames () =
  let traced : Exit {Boom} Unit = Effect.exit (task {
    Tracer.with_span "outer" span_options (task { from_result (Err (Boom 9)) })
  })
  let frame : Option Cause.StackFrame = Option.bind Cause.stack_trace (Exit.failure traced)
  match frame with
  | Some f ->
    let again : Failure {Boom} = Cause.annotate true f failed
    Platform.stdout_line ("annotate: " ++ show (Option.map Cause.frame_name (Cause.stack_trace again) == Some (Cause.frame_name f)))
    let stack = Cause.frame_stack f
    Platform.stdout_line ("frame: " ++ show (Option.is_some (Cause.frame_parent f), Option.is_some stack))
  | None -> Platform.stdout_line ("annotate: " ++ "no frame")

handled : Eff none {Cause.NoSuchElementError, Cause.IllegalArgumentError, Cause.UnknownError, TimeoutError} String ->{} String
let handled t =
  try
    await t
  with
  | Cause.NoSuchElementError m -> "no such element: " ++ m
  | Cause.IllegalArgumentError m -> "illegal argument: " ++ m
  | Cause.UnknownError m -> "unknown: " ++ m
  | TimeoutError -> "timed out"

/// Errors of `Cause` raised and handled as Flick errors.
errors : Unit ->{} Unit
let errors () =
  let raised =
    [ task { from_result (Err (Cause.NoSuchElementError "empty")) },
      task { from_result (Err (Cause.IllegalArgumentError "negative")) },
      task { from_result (Err (Cause.UnknownError "foreign")) },
      task { timeout 1 (task { Effect.never () }) } ]
  Platform.stdout_line ("errors: " ++ show (List.map_effect handled raised))

/// `Failure.rethrow` fails with the whole cause again.
rethrown : Unit ->{} Unit
let rethrown () =
  let again : Exit {Boom} Unit = Effect.exit (task { Failure.rethrow (Cause.combine (Cause.die "x") failed) })
  Platform.stdout_line ("rethrow: " ++ show (Option.map flags (Exit.failure again)))

main : Unit ->{; AppError} Unit
let main () =
  exits ()
  causes ()
  frames ()
  errors ()
  rethrown ()
