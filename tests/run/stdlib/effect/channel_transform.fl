// Effect's `Channel`: what a channel emits, changed.
module App.Main exposing (main)

type error Boom = Boom String

say : String ->{} Unit
let say line = Platform.stdout_line line

nums : Channel.Channel none none i Number Unit ie id
let nums = Channel.from_list [1, 2, 3, 4]

lists : Channel.Channel r e i (NonEmpty.NonEmpty a) d none Unit ->{r; e} List (List a)
let lists channel = Channel.run_collect (Channel.map NonEmpty.to_list channel)

chunks : Channel.Channel none none i (NonEmpty.NonEmpty Number) Unit ie id
let chunks = Channel.from_list_chunked 2 [1, 2, 3, 4, 5]

even : Number -> Bool
let even n = n % 2 == 0

halves : Filter.Filter Number Number Number
let halves = Filter.make (fun n -> if even n then Ok (n / 2) else Err n)

halves_effect : Filter.FilterEffect none none Number Number Number
let halves_effect = Filter.make_effect (fun n -> if even n then Ok (n / 2) else Err n)

elements : Unit ->{; Boom} Unit
let elements () =
  say ("map: " ++ show (Channel.run_collect (Channel.map (fun n -> n * 10) nums)))
  say ("map_effect: " ++ show (Channel.run_collect (Channel.map_effect (fun n -> n + 1) nums)))
  let seen = Ref.make []
  let tapped = Channel.run_collect (Channel.tap (fun n -> Ref.set seen (Ref.get seen ++ [n])) nums)
  say ("tap: " ++ show (tapped, Ref.get seen))
  say ("map_done: " ++ Channel.run_drain (Channel.map_done (fun _ -> "mapped") nums))
  say ("map_done_effect: " ++ Channel.run_drain (Channel.map_done_effect (fun _ -> "effect") nums))
  let doubled = nums |> Channel.pipe_to (Channel.map_input (fun n -> n * 2) (Channel.identity ()))
  say ("map_input: " ++ show (Channel.run_collect doubled))
  let failing : Channel.Channel none {Boom} i Number Unit ie id = Channel.fail (Boom "up")
  let renamed = failing |> Channel.pipe_to (Channel.map_input_error (fun _ -> Boom "renamed") (Channel.identity ()))
  let outcome =
    try
      show (Channel.run_collect renamed)
    with
    | Boom why -> why
  say ("map_input_error: " ++ outcome)
  say ("flat_map: " ++ show (Channel.run_collect (Channel.flat_map (fun n -> Channel.from_list [n, n]) (Channel.from_list [1, 2]))))
  say ("switch_map: " ++ show (Channel.run_collect (Channel.switch_map (fun n -> Channel.succeed (n * 3)) (Channel.from_list [2]))))
  let nested = Channel.from_list [Channel.from_list [1], Channel.from_list [2, 3]]
  say ("flatten: " ++ show (Channel.run_collect (Channel.flatten nested)))
  say ("flatten_array: " ++ show (Channel.run_collect (Channel.flatten_array (Channel.from_list [[1, 2], [], [3]]))))
  let merged = Channel.merge_all { concurrency = Some 1; bufferSize = None; switch = false } nested
  say ("merge_all: " ++ show (Channel.run_collect merged))
  say ("concat: " ++ show (Channel.run_collect (Channel.concat (Channel.from_list [9]) nums)))
  let continued = Channel.concat_with (fun _ -> Channel.from_list [0]) nums
  say ("concat_with: " ++ show (Channel.run_collect continued))
  say ("or_else_if_empty: " ++ show (Channel.run_collect (Channel.or_else_if_empty (fun _ -> Channel.from_list [7]) Channel.empty), Channel.run_collect (Channel.or_else_if_empty (fun _ -> Channel.from_list [7]) nums)))
  say ("drain: " ++ show (Channel.run_count (Channel.drain nums)))
  let looped = Ref.make []
  Channel.run_for_each_while (fun n -> Ref.set looped (Ref.get looped ++ [n]) |> fun _ -> List.length (Ref.get looped) < 5) (Channel.forever (Channel.from_list [1, 2]))
  say ("forever: " ++ show (Ref.get looped))

filters : Unit ->{; Boom} Unit
let filters () =
  say ("filter: " ++ show (Channel.run_collect (Channel.filter even nums)))
  say ("filter_map: " ++ show (Channel.run_collect (Channel.filter_map halves nums)))
  say ("filter_effect: " ++ show (Channel.run_collect (Channel.filter_effect (fun n -> n > 2) nums)))
  say ("filter_map_effect: " ++ show (Channel.run_collect (Channel.filter_map_effect halves_effect nums)))
  say ("filter_array: " ++ show (lists (Channel.filter_array even chunks)))
  say ("filter_map_array: " ++ show (lists (Channel.filter_map_array halves chunks)))
  say ("filter_array_effect: " ++ show (lists (Channel.filter_array_effect (fun n -> n > 2) chunks)))
  say ("filter_map_array_effect: " ++ show (lists (Channel.filter_map_array_effect halves_effect chunks)))
  let pairs = Channel.map_accum (fun () -> 0) (fun total n -> (total + n, [total + n])) nums
  say ("map_accum: " ++ show (Channel.run_collect pairs))
  say ("scan: " ++ show (Channel.run_collect (Channel.scan 0 (fun total n -> total + n) nums)))
  say ("scan_effect: " ++ show (Channel.run_collect (Channel.scan_effect 1 (fun total n -> total * n) nums)))
  say ("buffer: " ++ show (Channel.run_collect (Channel.buffer { capacity = Some 2; strategy = None } nums)))
  say ("buffer_array: " ++ show (List.concat (lists (Channel.buffer_array { capacity = None; strategy = Some Queue.Suspend } chunks))))

text : Unit ->{; Boom} Unit
let text () =
  let raw = Channel.from_list_chunked 1 ["one\ntw", "o\nthree"]
  say ("split_lines: " ++ show (lists (raw |> Channel.pipe_to (Channel.split_lines ()))))
  let bytes = Channel.from_list_chunked 1 ["hé"] |> Channel.pipe_to (Channel.encode_text ())
  say ("encode_text: " ++ show (lists bytes))
  let decoded = bytes |> Channel.pipe_to (Channel.decode_text "utf-8")
  say ("decode_text: " ++ show (lists decoded))
  say ("mk_uint8_array: " ++ show (Channel.mk_uint8_array bytes))
  let strict = nums |> Channel.pipe_to_or_fail (Channel.map_input (fun n -> n + 100) (Channel.identity ()))
  say ("pipe_to_or_fail: " ++ show (Channel.run_collect strict))

main : Unit ->{; AppError} Unit
let main () =
  try
    elements ()
    filters ()
    text ()
  with
  | Boom why -> say ("unexpected " ++ why)
