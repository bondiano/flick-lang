// Effect's logs, spans and metrics around tasks, and the references every
// fiber carries.
module App.Main exposing (main)

type error Boom = Boom Float
  deriving Show

options : Tracer.SpanOptions
let options = {
  attributes = [("user", "ada")];
  links = [];
  parent = None;
  root = false;
  kind_ = Tracer.internal;
  sampled = None;
  level = None;
  captureStackTrace = false;
  disablePropagation = false;
}

/// A logger writing the level and the message to stdout.
plain : Logger.Logger Unit
let plain =
  Logger.with_console_log
    (Logger.make (fun o -> show o.logLevel ++ " " ++ String.join " " o.message))

none_loggers : List (Logger.Logger Unit)
let none_loggers = []

counter_options : Metric.CounterOptions
let counter_options = { description = None; attributes = []; incremental = false }

count_of : Metric.Counter ->{} Float
let count_of c = (Metric.value c).count

logs : Unit ->{} Unit
let logs () =
  Logger.with_loggers
    none_loggers
    (task {
      Effect.with_logger
        plain
        (task {
          Effect.log "plain"
          Effect.log_fatal "fatal"
          Effect.log_error "error"
          Effect.log_warning "warning"
          Effect.log_info "info"
          Effect.log_debug "debug is below the minimum level"
          Effect.log_trace "trace is below the minimum level"
          Effect.log_with_level LogLevel.Warn "with level"
          References.with_minimum_log_level
            LogLevel.Trace
            (task { Effect.log_debug "debug at trace" })
          References.with_current_log_level
            LogLevel.Error
            (task {
              Effect.log "at the current level"
              Platform.stdout_line
                ("current_log_level: " ++ LogLevel.value (References.current_log_level ()))
            })
          Effect.annotate_logs
            "user"
            "ada"
            (task {
              Platform.stdout_line
                ("annotate_logs: " ++ show (References.current_log_annotations ()))
            })
          scope {
            Effect.annotate_logs_scoped "request" "7"
            Platform.stdout_line
              ("annotate_logs_scoped: " ++ show (References.current_log_annotations ()))
          }
          Effect.with_log_span
            "outer"
            (task {
              Effect.with_log_span
                "inner"
                (task {
                  Platform.stdout_line ("with_log_span: " ++ show (References.current_log_spans ()))
                })
            })
          References.with_unhandled_log_level
            None
            (task { Platform.stdout_line ("with_unhandled_log_level: " ++ "set") })
        })
    })

spans : Unit ->{; Cause.NoSuchElementError} Unit
let spans () =
  let _ : Tracer.Tracer = Effect.tracer ()
  let outside =
    try show (Tracer.span_name (Effect.current_span ())) with
    | Cause.NoSuchElementError _ -> "no span"
  Platform.stdout_line ("current_span: " ++ outside)
  Tracer.with_span
    "outer"
    options
    (task {
      Platform.stdout_line ("current_span: " ++ show (Tracer.span_name (Effect.current_span ())))
      Platform.stdout_line
        ("current_parent_span: " ++ show (Tracer.span_name (Effect.current_parent_span ())))
      Effect.annotate_current_span "step" "1"
      Platform.stdout_line
        ("annotate_current_span: " ++ show (Tracer.attributes (Effect.current_span ())))
    })
  Effect.annotate_spans
    "team"
    "core"
    (task { Platform.stdout_line ("span_annotations: " ++ show (References.span_annotations ())) })
  let made = Effect.make_span "made" options
  Platform.stdout_line ("make_span: " ++ show (Tracer.span_name made))
  Effect.link_spans
    [made]
    [("why", "test")]
    (task {
      Platform.stdout_line
        ("span_links: "
          ++ show (List.map (fun l -> Tracer.span_name l.span) (Effect.span_links ())))
    })
  Effect.with_parent_span
    made
    (task {
      Tracer.with_span
        "child"
        options
        (task {
          Platform.stdout_line
            ("with_parent_span: "
              ++ show (Option.bind Tracer.span_name (Tracer.parent (Effect.current_span ()))))
        })
    })
  Platform.stdout_line
    ("use_span: " ++ Effect.use_span "used" options (fun s -> show (Tracer.span_name s)))
  scope {
    let scoped = Effect.make_span_scoped "scoped" options
    Platform.stdout_line ("make_span_scoped: " ++ show (Tracer.span_name scoped))
    Effect.with_span_scoped
      "scoped task"
      options
      (task {
        Platform.stdout_line
          ("with_span_scoped: " ++ show (Tracer.span_name (Effect.current_span ())))
      })
  }
  References.with_tracer_enabled
    false
    (task { Platform.stdout_line ("with_tracer_enabled: " ++ "off") })
  References.with_tracer_timing
    false
    (task { Platform.stdout_line ("with_tracer_timing: " ++ "off") })
  References.with_disable_propagation
    true
    (task { Platform.stdout_line ("with_disable_propagation: " ++ "on") })
  Platform.stdout_line
    ("current_stack_frame: " ++ show (Option.is_some (References.current_stack_frame ())))

all_runs : Metric.Counter
let all_runs = Metric.counter "observe_all" counter_options

wins : Metric.Counter
let wins = Metric.counter "observe_wins" counter_options

error_count : Metric.Counter
let error_count = Metric.counter "observe_errors" counter_options

defects : Metric.Counter
let defects = Metric.counter "observe_defects" counter_options

timing : Metric.Counter
let timing = Metric.counter "observe_duration" counter_options

boom_number : Boom -> Float
let boom_number e =
  match e with
  | Boom n -> n

/// Runs `t` under every tracking wrapper, ignoring how it ends.
tracked : Eff none {Boom} Float ->{} Unit
let tracked t =
  let _ =
    Effect.exit
      (task {
        Effect.track
          all_runs
          (fun x -> 1)
          (task {
            Effect.track_successes
              wins
              (fun n -> n)
              (task {
                Effect.track_errors
                  error_count
                  boom_number
                  (task {
                    Effect.track_defects
                      defects
                      (fun d -> Int.to_float (String.length d))
                      (task { Effect.track_duration timing (fun d -> 1) t })
                  })
              })
          })
      })
  ()

metrics : Unit ->{} Unit
let metrics () =
  let ok : Eff none {Boom} Float = task { 2 }
  let bad : Eff none {Boom} Float = task { from_result (Err (Boom 3)) }
  let broken : Eff none {Boom} Float = task { Effect.die "broken" }
  List.each_effect tracked [ok, bad, broken]
  Platform.stdout_line
    ("track: "
      ++ show (
        count_of all_runs,
        count_of wins,
        count_of error_count,
        count_of defects,
        count_of timing,
      ))

main : Unit ->{; AppError} Unit
let main () =
  logs ()
  try spans () with
  | Cause.NoSuchElementError m -> Platform.stdout_line ("spans failed: " ++ m)
  metrics ()
