// `Metric`: each kind of metric updated and read back, through
// `value` and `snapshot`, and the metrics of the fiber runtime.
module App.Main exposing (main)

none_options : Metric.GaugeOptions
let none_options = { description = None; attributes = [] }

requests : Metric.Counter
let requests =
  Metric.counter "test_requests" {
    description = Some "requests seen";
    attributes = [];
    incremental = false;
  }

ms : Float -> Duration.Duration
let ms n = Result.with_default Duration.zero (Duration.millis n)

/// The state of a snapshot, without times.
describe : Metric.State -> String
let describe state =
  match state with
  | Metric.CounterValue c -> "counter " ++ show c.count
  | Metric.GaugeValue g -> "gauge " ++ show g.value
  | Metric.FrequencyValue f -> "frequency " ++ show (List.sort f.occurrences)
  | Metric.HistogramValue h -> "histogram " ++ show h.count
  | Metric.SummaryValue s -> "summary " ++ show s.count

/// How many child fibers the runtime metrics counted.
started : Unit ->{} Float
let started () =
  let counts =
    List.filter_map
      (fun m ->
        match m.state with
        | Metric.CounterValue c -> if m.id == "child_fibers_started" then Some c.count else None
        | _ -> None
      )
      (Metric.snapshot ())
  List.sum counts

main : Unit ->{Async; AppError} Unit
let main () =
  requests |> Metric.update 1
  requests |> Metric.update 2
  let counted : Metric.CounterState = Metric.value requests
  Platform.stdout_line ("counter " ++ show (counted.count, counted.incremental))
  let level : Metric.Gauge = Metric.gauge "test_level" none_options
  level |> Metric.update 5
  level |> Metric.modify 2
  let gauged : Metric.GaugeState = Metric.value level
  Platform.stdout_line ("gauge " ++ show gauged.value)
  let words : Metric.Frequency =
    Metric.frequency "test_words" {
      description = None;
      attributes = [];
      preregisteredWords = ["zero"];
    }
  words |> Metric.update "a"
  words |> Metric.update "a"
  words |> Metric.update "b"
  let seen : Metric.FrequencyState = Metric.value words
  Platform.stdout_line ("frequency " ++ show (List.sort seen.occurrences))
  let bounds = Metric.linear_boundaries { start = 0; width = 10; count = 3 }
  Platform.stdout_line ("linear " ++ show bounds)
  Platform.stdout_line
    ("exponential " ++ show (Metric.exponential_boundaries { start = 1; factor = 2; count = 4 }))
  Platform.stdout_line ("from_iterable " ++ show (Metric.boundaries_from_iterable [5, 1, 5, 3]))
  let sizes : Metric.Histogram Float =
    Metric.histogram "test_sizes" { description = None; attributes = []; boundaries = bounds }
  List.each_effect (fun n -> sizes |> Metric.update n) [1, 15, 25]
  let h : Metric.HistogramState = Metric.value sizes
  Platform.stdout_line ("histogram " ++ show (h.buckets, h.count, h.min, h.max, h.sum))
  let options = {
    description = None;
    attributes = [];
    maxAge = ms 60000;
    maxSize = 10;
    quantiles = [0.5];
  }
  let latency : Metric.Summary Float = Metric.summary "test_latency" options
  List.each_effect (fun n -> latency |> Metric.update n) [1, 2, 3]
  let s : Metric.SummaryState = Metric.value latency
  Platform.stdout_line ("summary " ++ show (s.quantiles, s.count, s.min, s.max, s.sum))
  let stamped = Metric.summary_with_timestamp "test_stamped" options
  stamped |> Metric.update (4, 1000)
  Platform.stdout_line ("summary_with_timestamp " ++ show (Metric.value stamped).count)
  let timer =
    Metric.timer "test_timer" { description = None; attributes = []; boundaries = Some [1, 100] }
  timer |> Metric.update (ms 50)
  Platform.stdout_line ("timer " ++ show (Metric.value timer).buckets)
  let lengths : Metric.Metric String Metric.HistogramState =
    Metric.map_input
      (fun s -> Int.to_float (String.length s))
      (Metric.histogram "test_lengths" { description = None; attributes = []; boundaries = [5] })
  lengths |> Metric.update "abc"
  Platform.stdout_line ("map_input " ++ show (Metric.value lengths).sum)
  let constant =
    Metric.with_constant_input
      1
      (Metric.counter "test_constant" { description = None; attributes = []; incremental = true })
  constant |> Metric.update "ignored"
  constant |> Metric.update ()
  Platform.stdout_line ("with_constant_input " ++ show (Metric.value constant).count)
  let tagged = Metric.with_attributes [("route", "/a")] requests
  tagged |> Metric.update 10
  Metric.with_current_attributes [("route", "/b")] (task { requests |> Metric.update 100 })
  let mine =
    List.filter (fun (m : Metric.Snapshot) -> String.starts_with "test_" m.id) (Metric.snapshot ())
  let lines =
    List.map
      (fun m ->
        m.id ++ " " ++ show m.attributes ++ " " ++ show m.description ++ " " ++ describe m.state
      )
      mine
  List.each_effect (fun l -> Platform.stdout_line l) (List.sort lines)
  Platform.stdout_line ("dump " ++ show (String.contains "test_requests" (Metric.dump ())))
  Metric.enable_runtime_metrics (task { ignore (parallel (task { 1 }) (task { 2 })) })
  let enabled = started ()
  Metric.disable_runtime_metrics (task { ignore (parallel (task { 1 }) (task { 2 })) })
  provide Metric.disable_runtime_metrics_layer { ignore (parallel (task { 1 }) (task { 2 })) }
  let disabled = started ()
  provide Metric.enable_runtime_metrics_layer { ignore (parallel (task { 1 }) (task { 2 })) }
  let layered = started ()
  Platform.stdout_line
    ("runtime metrics " ++ show (enabled > 0, disabled == enabled, layered > disabled))
