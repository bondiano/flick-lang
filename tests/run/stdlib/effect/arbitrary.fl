// Effect's `Arbitrary`: seeded samples of generators made from schemas and
// combinators, and property checks that pass, shrink a failure, report a
// typed error of the property, or run out of values.
module App.Main exposing (main)

type error TooBig = TooBig Float

type alias Point = { x : Float; tags : List String }
  deriving Schema

type Shape = Dot | Circle Float
  deriving Show, Schema

seeded : Int -> Arbitrary.SampleOptions
let seeded n = { count = Some n; size = None; maxDiscards = None; seed = Some 42 }

checking : Arbitrary.CheckOptions
let checking = {
  runs = Some 50;
  size = None;
  maxDiscards = None;
  maxShrinks = None;
  seed = Some 7;
  replay = None;
}

/// Effect generates within the bounds its checks state.
digit_json : PureCodec Json Float
let digit_json =
  Float.json_finite
  |> Check.apply Check.int
  |> Check.apply
    (Check.between { minimum = 0; maximum = 9; exclusiveMinimum = false; exclusiveMaximum = false })

digits : Arbitrary.Arbitrary Float
let digits = Arbitrary.map (fun n -> n) (Arbitrary.from_schema (Codec.to_schema digit_json))

describe : Show a => Arbitrary.CheckResult e a -> String
let describe result =
  match result with
  | Arbitrary.Passed r -> "passed " ++ show r.runs
  | Arbitrary.Falsified r ->
    let failure = r.failure
    let why =
      match failure with
      | Arbitrary.ReturnedFalse -> "false"
      | Arbitrary.PropertyError _ -> "error"
    let replay : Arbitrary.Replay = r.replay
    "falsified at "
      ++ show r.shrunkInput
      ++ " ("
      ++ why
      ++ "), replay "
      ++ show (String.length replay > 0)
  | Arbitrary.Exhausted r -> "exhausted after " ++ show r.discards ++ " discards"
  | Arbitrary.ReplayMismatch reason -> "replay mismatch " ++ reason

below_five : Float ->{} Bool
let below_five n = n < 5

small : Float ->{; TooBig} Bool
let small n = if n > 3 then from_result (Err (TooBig n)) else true

run : Unit ->{; Arbitrary.SampleError} Unit
let run () =
  let all_digits = Arbitrary.sample (seeded 20) digits
  Platform.stdout_line
    ("digits in range: "
      ++ show (List.all (fun n -> n >= 0 && n <= 9) all_digits)
      ++ ", count "
      ++ show (List.length all_digits))
  Platform.stdout_line ("constant: " ++ show (Arbitrary.sample (seeded 2) (Arbitrary.constant "x")))
  let bounds : Arbitrary.ArrayOptions = { minLength = Some 1; maxLength = Some 3 }
  let lists = Arbitrary.sample (seeded 10) (Arbitrary.list bounds digits)
  Platform.stdout_line
    ("list lengths in bounds: "
      ++ show (List.all (fun xs -> List.length xs >= 1 && List.length xs <= 3) lists))
  let evens =
    Arbitrary.sample (seeded 10) (Arbitrary.filter (fun n -> n == 2 * Float.floor (n / 2)) digits)
  Platform.stdout_line
    ("filter evens: " ++ show (List.all (fun n -> n == 2 * Float.floor (n / 2)) evens))
  let tens =
    Arbitrary.sample
      (seeded 10)
      (Arbitrary.filter_map (fun n -> if n > 4 then Ok (n * 10) else Err n) digits)
  Platform.stdout_line ("filter_map: " ++ show (List.all (fun n -> n >= 50) tens))
  let pairs =
    Arbitrary.sample
      (seeded 5)
      (Arbitrary.flat_map
        (fun n -> Arbitrary.all [Arbitrary.constant n, Arbitrary.constant (n + 1)])
        digits)
  Platform.stdout_line
    ("flat_map and all: "
      ++ show
        (List.all
          (fun p ->
            match p with
            | [a, b] -> b == a + 1
            | _ -> false
          )
          pairs))
  let pair = Arbitrary.sample (seeded 3) (Arbitrary.zip2 digits (Arbitrary.constant "y"))
  Platform.stdout_line
    ("zip2: "
      ++ show
        (List.all
          (fun p ->
            match p with
            | (n, s) -> n >= 0 && n <= 9 && s == "y"
          )
          pair))
  let triple =
    Arbitrary.sample
      (seeded 3)
      (Arbitrary.zip3 digits (Arbitrary.constant true) (Arbitrary.constant 3))
  Platform.stdout_line
    ("zip3: "
      ++ show
        (List.all
          (fun t ->
            match t with
            | (n, b, k) -> n >= 0 && n <= 9 && b && k == 3
          )
          triple))
  let zipped =
    Arbitrary.sample
      (seeded 5)
      (Arbitrary.zip4
        digits
        (Arbitrary.constant "x")
        (Arbitrary.constant true)
        (Arbitrary.constant 2))
  Platform.stdout_line
    ("zip4: "
      ++ show
        (List.all
          (fun z ->
            match z with
            | (n, s, b, k) -> n >= 0 && n <= 9 && s == "x" && b && k == 2
          )
          zipped))
  let shrinking : Arbitrary.SchemaOptions Float = { shrink = None }
  Platform.stdout_line
    ("from_schema_with: "
      ++ show
        (List.length
          (Arbitrary.sample (seeded 3) (Arbitrary.from_schema_with shrinking Schema.number))))
  let passed = Arbitrary.check checking (fun n -> n < 10) digits
  Platform.stdout_line
    ("check: " ++ describe passed ++ ", report " ++ show (Arbitrary.format_check_failure passed))
  let falsified = Arbitrary.check checking below_five digits
  Platform.stdout_line ("check: " ++ describe falsified)
  let report = Option.with_default "" (Arbitrary.format_check_failure falsified)
  Platform.stdout_line
    ("report mentions shrunk input: " ++ show (String.contains "Shrunk input: 5" report))
  let failed = Arbitrary.check checking small digits
  Platform.stdout_line ("check: " ++ describe failed)
  let exhausted =
    Arbitrary.check checking (fun _ -> true) (Arbitrary.filter (fun _ -> false) digits)
  Platform.stdout_line ("check: " ++ describe exhausted)
  let sampled =
    try show (Arbitrary.sample (seeded 2) (Arbitrary.filter (fun _ -> false) digits)) with
    | Arbitrary.SampleError e -> "sample error after " ++ show e.discards ++ " discards"
  Platform.stdout_line sampled
  reports ()
  linked ()

report : Arbitrary.CheckResult e a ->{} Unit
let report result =
  Platform.stdout_line (Option.with_default "passed" (Arbitrary.format_check_failure result))

/// Reports of falsified checks, their values as Effect's Formatter writes them.
reports : Unit ->{} Unit
let reports () =
  report (Arbitrary.check checking (fun p -> p.x < 5) (Arbitrary.from_schema Point.schema))
  report
    (Arbitrary.check
      checking
      (fun s ->
        match s with
        | Dot -> true
        | Circle r -> r < 3
      )
      (Arbitrary.from_schema Shape.schema))
  report
    (Arbitrary.check
      checking
      (fun o -> Option.is_none o)
      (Arbitrary.from_schema (Schema.option (Schema.list Schema.bool))))
  report (Arbitrary.check checking small digits)
  report
    (Arbitrary.check checking (fun s -> String.length s < 2) (Arbitrary.from_schema Schema.string))

/// Values Effect generates through the link of their declaration.
linked : Unit ->{; Arbitrary.SampleError} Unit
let linked () =
  Platform.stdout_line
    ("durations: " ++ show (Arbitrary.sample (seeded 6) (Arbitrary.from_schema Schema.duration)))
  Platform.stdout_line
    ("chunks: "
      ++ show (Arbitrary.sample (seeded 3) (Arbitrary.from_schema (Schema.chunk Schema.bool))))
  let instants = Arbitrary.from_schema (Codec.to_schema DateTime.json_utc_millis)
  Platform.stdout_line
    ("instants: "
      ++ show (List.map DateTime.to_epoch_millis (Arbitrary.sample (seeded 4) instants)))
  let zones = Arbitrary.from_schema (Codec.to_schema DateTime.json_zone)
  Platform.stdout_line
    ("zones: " ++ show (List.map DateTime.zone_to_string (Arbitrary.sample (seeded 4) zones)))

main : Unit ->{; AppError} Unit
let main () =
  try run () with
  | Arbitrary.SampleError _ -> App.fail "a sample ran out of values"
