// Effect's `HashSet` through Flick's sets, which keep their witness.
module App.Main exposing (main)

sorted : HashSet.HashSet w Float -> List Float
let sorted s = List.sort (HashSet.to_list s)

odd : HashSet.HashSet EqHash.Canonical Float
let odd = HashSet.from_list EqHash.canonical [1, 3, 5, 7]

small : HashSet.HashSet EqHash.Canonical Float
let small = HashSet.insert 2 (HashSet.insert 1 HashSet.empty)

main : Unit ->{; AppError} Unit
let main () =
  Platform.stdout_line ("from_list: " ++ show (sorted odd, HashSet.size odd))
  Platform.stdout_line
    ("member: "
      ++ show (HashSet.member 3 odd, HashSet.member 4 odd, HashSet.member 1 (HashSet.remove 1 odd)))
  Platform.stdout_line
    ("is_empty: "
      ++ show (HashSet.is_empty odd, HashSet.is_empty (HashSet.remove 2 (HashSet.remove 1 small))))
  Platform.stdout_line ("union: " ++ show (sorted (HashSet.union odd small)))
  Platform.stdout_line ("intersection: " ++ show (sorted (HashSet.intersection small odd)))
  Platform.stdout_line ("difference: " ++ show (sorted (HashSet.difference small odd)))
  Platform.stdout_line
    ("is_subset: "
      ++ show
        (
          HashSet.is_subset odd (HashSet.from_list EqHash.canonical [1, 5]),
          HashSet.is_subset odd small,
        ))
  Platform.stdout_line
    ("map: " ++ show (sorted (HashSet.map EqHash.canonical (fun n -> n % 3) odd)))
  Platform.stdout_line ("filter: " ++ show (sorted (HashSet.filter (fun n -> n > 3) odd)))
  Platform.stdout_line
    ("some, every: "
      ++ show
        (
          HashSet.some (fun n -> n > 6) odd,
          HashSet.every (fun n -> n % 2 == 1) odd,
          HashSet.every (fun n -> n > 1) odd,
        ))
  Platform.stdout_line ("reduce: " ++ show (HashSet.reduce 0 (fun acc n -> acc + n) odd))
  let lengths =
    EqHash.with
      (fun a b -> String.length a == String.length b)
      (fun s -> Int.to_float (String.length s))
      (fun w ->
        List.sort
          (HashSet.to_list (HashSet.map w (fun n -> String.repeat (Int.truncate n) "x") odd)))
  Platform.stdout_line ("map into a witness: " ++ show lengths)
