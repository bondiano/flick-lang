// JSON codecs of sizes, date-times and zones, bytes, graphs, network
// addresses and DNS records, from Effect's `Schema`: each case decodes JSON
// text and encodes the value back, or shows the `SchemaError`.
module App.Main exposing (main)

issues : SchemaError -> String
let issues (SchemaError found) =
  let first : List SchemaIssue = found
  "err " ++ String.join "; " (List.map (fun i -> i.message) first)

wire : Result SchemaError Json -> String
let wire result =
  match result with
  | Ok json -> Json.stringify json
  | Err e -> issues e

/// Decodes `text` and encodes the value back.
rt : String -> PureCodec Json a -> String
let rt text c =
  match Json.parse text with
  | Ok u ->
    (
      match Codec.decode_result c u with
      | Ok v -> wire (Codec.encode_result c v)
      | Err e -> issues e
    )
  | Err e -> issues e

decoded : String -> PureCodec Json a -> Result SchemaError a
let decoded text c =
  match Json.parse text with
  | Ok u -> Codec.decode_result c u
  | Err e -> Err e

case : String -> String -> PureCodec Json a -> String
let case name text c = name ++ " " ++ text ++ ": " ++ rt text c

addresses : List String
let addresses = [
  case "domain_name" "\"Example.com\"" Net.domain_name,
  case "host" "\"Example.COM\"" Net.host,
  case "host_port" "\"example.com:8080\"" Net.host_port,
  case "inet_address" "\"[::1]:80\"" Net.inet_address,
  case "inet_address_v4" "\"127.0.0.1:80\"" Net.inet_address_v4,
  case "inet_address_v4" "\"[::1]:80\"" Net.inet_address_v4,
  case "inet_address_v6" "\"[::1]:80\"" Net.inet_address_v6,
  case "socket_address" "\"/run/app.sock\"" Net.socket_address,
  case "unix_path_address" "\"/run/app.sock\"" Net.unix_path_address,
  case "ip_address" "\"2001:DB8:0::1\"" Net.ip_address,
  case "ip_interface" "\"10.1.2.3/8\"" Net.ip_interface,
  case "ip_link_local_address" "\"169.254.1.1\"" Net.ip_link_local_address,
  case "ip_loopback_address" "\"127.0.0.1\"" Net.ip_loopback_address,
  case "ip_multicast_address" "\"224.0.0.1\"" Net.ip_multicast_address,
  case "ip_network" "\"10.1.2.3/8\"" Net.ip_network,
  case "ip_unicast_address" "\"8.8.8.8\"" Net.ip_unicast_address,
  case "ip_unspecified_address" "\"::\"" Net.ip_unspecified_address,
  case "ipv4_address" "\"192.168.000.1\"" Net.ipv4_address,
  case "ipv4_broadcast_address" "\"255.255.255.255\"" Net.ipv4_broadcast_address,
  case "ipv4_interface" "\"192.168.0.1/24\"" Net.ipv4_interface,
  case "ipv4_network" "\"192.168.0.0/24\"" Net.ipv4_network,
  case "ipv4_private_address" "\"8.8.8.8\"" Net.ipv4_private_address,
  case "ipv6_address" "\"::FFFF:1\"" Net.ipv6_address,
  case "ipv6_interface" "\"fe80::1/64\"" Net.ipv6_interface,
  case "ipv6_network" "\"2001:db8::/32\"" Net.ipv6_network,
  case "ipv6_unique_local_address" "\"fd00::1\"" Net.ipv6_unique_local_address,
  case "mac_address" "\"AA:BB:CC:DD:EE:FF\"" Net.mac_address,
  case "mac_broadcast_address" "\"ff:ff:ff:ff:ff:ff\"" Net.mac_broadcast_address,
  case
    "mac_locally_administered_address"
    "\"02:00:00:00:00:01\""
    Net.mac_locally_administered_address,
  case "mac_multicast_address" "\"01:00:5e:00:00:01\"" Net.mac_multicast_address,
  case "mac_unicast_address" "\"00:1a:2b:3c:4d:5e\"" Net.mac_unicast_address,
  case
    "mac_universally_administered_address"
    "\"00:1a:2b:3c:4d:5e\""
    Net.mac_universally_administered_address,
  case "scoped_ipv6_literal" "\"fe80::1%eth0\"" Net.scoped_ipv6_literal,
  case "dns_record_type" "\"MX\"" Net.dns_record_type,
]

records : List (String, PureCodec Json Net.DnsRecord, String)
let records = [
  ("dns_record", Net.dns_record, "{\"_tag\": \"A\", \"address\": \"192.0.2.1\"}"),
  ("dns_a_record", Net.dns_a_record, "{\"_tag\": \"A\", \"address\": \"192.0.2.1\"}"),
  ("dns_aaaa_record", Net.dns_aaaa_record, "{\"_tag\": \"AAAA\", \"address\": \"2001:db8::1\"}"),
  (
    "dns_caa_record",
    Net.dns_caa_record,
    "{\"_tag\": \"CAA\", \"critical\": false, \"tag\": \"issue\", \"value\": \"ca.example\"}",
  ),
  (
    "dns_cname_record",
    Net.dns_cname_record,
    "{\"_tag\": \"CNAME\", \"target\": \"example.com\"}",
  ),
  (
    "dns_mx_record",
    Net.dns_mx_record,
    "{\"_tag\": \"MX\", \"exchange\": \"mail.example.com\", \"priority\": 10}",
  ),
  (
    "dns_naptr_record",
    Net.dns_naptr_record,
    "{\"_tag\": \"NAPTR\", \"order\": 1, \"preference\": 2, \"flags\": \"u\", \"service\": \"E2U+sip\", \"regexp\": \"\", \"replacement\": \"example.com\"}",
  ),
  ("dns_ns_record", Net.dns_ns_record, "{\"_tag\": \"NS\", \"host\": \"ns.example.com\"}"),
  ("dns_ptr_record", Net.dns_ptr_record, "{\"_tag\": \"PTR\", \"host\": \"host.example.com\"}"),
  (
    "dns_soa_record",
    Net.dns_soa_record,
    "{\"_tag\": \"SOA\", \"primary\": \"ns.example.com\", \"admin\": \"admin.example.com\", \"serial\": 1, \"refresh\": 1000, \"retry\": 1000, \"expire\": 1000, \"minimum\": 1000}",
  ),
  (
    "dns_srv_record",
    Net.dns_srv_record,
    "{\"_tag\": \"SRV\", \"target\": \"sip.example.com\", \"port\": 5060, \"priority\": 1, \"weight\": 5}",
  ),
  (
    "dns_tlsa_record",
    Net.dns_tlsa_record,
    "{\"_tag\": \"TLSA\", \"certUsage\": 3, \"selector\": 1, \"matchingType\": 1, \"data\": \"010203\"}",
  ),
  ("dns_txt_record", Net.dns_txt_record, "{\"_tag\": \"TXT\", \"chunks\": [\"v=spf1\"]}"),
  ("dns_txt_record", Net.dns_txt_record, "{\"_tag\": \"A\", \"address\": \"192.0.2.1\"}"),
]

main : Unit ->{; AppError} Unit
let main () =
  Platform.stdout_line (case "ByteSize.json" "\"1.5 KiB\"" ByteSize.json)
  Platform.stdout_line (case "ByteSize.json" "\"lots\"" ByteSize.json)
  Platform.stdout_line (case "ByteSize.json_number" "1536" ByteSize.json_number)
  Platform.stdout_line (case "ByteSize.json_number" "1.5" ByteSize.json_number)
  Platform.stdout_line (case "ByteSize.json_bigint" "\"5\"" ByteSize.json_bigint)
  Platform.stdout_line
    ("ByteSize decoded: "
      ++ (
        match decoded "\"2 MiB\"" ByteSize.json with
        | Ok size -> show size
        | Err e -> issues e
      ))
  Platform.stdout_line (case "DateTime.json_utc" "\"2024-01-01T10:00:00+02:00\"" DateTime.json_utc)
  Platform.stdout_line (case "DateTime.json_utc_millis" "0" DateTime.json_utc_millis)
  Platform.stdout_line
    (case "DateTime.json_zoned" "\"2024-01-01T10:00:00+02:00[Europe/Paris]\"" DateTime.json_zoned)
  Platform.stdout_line (case "DateTime.json_zone" "\"+02:00\"" DateTime.json_zone)
  Platform.stdout_line (case "DateTime.json_zone" "\"Europe/Paris\"" DateTime.json_zone)
  Platform.stdout_line (case "DateTime.json_zone_named" "\"Nowhere/X\"" DateTime.json_zone_named)
  Platform.stdout_line (case "DateTime.json_zone_offset" "3600000" DateTime.json_zone_offset)
  Platform.stdout_line (case "Codec.bytes_base64" "\"AQID\"" Codec.bytes_base64)
  Platform.stdout_line (case "Codec.bytes_base64url" "\"-_8\"" Codec.bytes_base64url)
  Platform.stdout_line (case "Codec.bytes_hex" "\"0a0B\"" Codec.bytes_hex)
  Platform.stdout_line
    ("bytes decoded: "
      ++ (
        match decoded "\"ff00\"" Codec.bytes_hex with
        | Ok xs -> show xs
        | Err e -> issues e
      ))
  Platform.stdout_line ("bytes 300: " ++ wire (Codec.encode_result Codec.bytes_base64 [1, 300]))
  graph_json : PureCodec Json (Graph.DirectedGraph String Float)
  let graph_json = Graph.json Graph.directed_kind String.json Float.json
  let g_text =
    "{\"type\": \"directed\", \"nodes\": [{\"index\": 0, \"data\": \"a\"}, {\"index\": 1, \"data\": \"b\"}], \"edges\": [{\"index\": 0, \"source\": 0, \"target\": 1, \"data\": 3}]}"
  Platform.stdout_line ("Graph.json: " ++ rt g_text graph_json)
  Platform.stdout_line
    ("Graph.json counts: "
      ++ (
        match decoded g_text graph_json with
        | Ok g -> show (Graph.node_count g, Graph.edge_count g)
        | Err e -> issues e
      ))
  Platform.stdout_line (String.join "\n" addresses)
  Platform.stdout_line
    ("parse: "
      ++ (
        match (Net.parse_ip "::FFFF:1", Net.parse_host_port "example.com:8080") with
        | (Ok ip, Ok hp) -> show ip ++ ", " ++ show hp
        | _ -> "err"
      ))
  Platform.stdout_line
    ("parse bad: "
      ++ (
        match Net.parse_mac "zz" with
        | Ok m -> show m
        | Err e -> issues e
      ))
  Platform.stdout_line
    ("ip typed: "
      ++ (
        match (decoded "\"::1\"" Net.ip_address, decoded "\"0:0::1\"" Net.ipv6_address) with
        | (Ok x, Ok y) -> show x ++ " == " ++ Net.format_ip y ++ ": " ++ show (x == y)
        | _ -> "err"
      ))
  Platform.stdout_line
    (String.join "\n" (List.map (fun (name, c, text) -> case name text c) records))
  Platform.stdout_line
    ("format_record: "
      ++ (
        match
          decoded
            "{\"_tag\": \"MX\", \"exchange\": \"mail.example.com\", \"priority\": 10}"
            Net.dns_mx_record
        with
        | Ok r -> Net.format_record r
        | Err e -> issues e
      ))
  Platform.stdout_line
    ("parse_host bad: "
      ++ (
        match Net.parse_host "bad host!!" with
        | Ok h -> show h
        | Err e -> issues e
      ))
  Platform.stdout_line
    ("unions of a number: "
      ++ String.join " | " [
        rt "1" Net.host,
        rt "1" Net.socket_address,
        rt "{\"_tag\": \"ZZ\"}" Net.dns_record,
      ])
