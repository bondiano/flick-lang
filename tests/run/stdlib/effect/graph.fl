// Effect's `Graph`: building persistent graphs, querying, changing,
// combining, walking and rendering them; invalid input is a `GraphError`.
module App.Main exposing (main)

type alias G = Graph.DirectedGraph String Number

res : Show a => Result Graph.GraphError a -> String
let res r = match r with
  | Ok a -> "Ok " ++ show a
  | Err (Graph.GraphError message) -> "Err " ++ message

node : String -> Graph.Graph String e k -> Graph.Graph String e k
let node name g =
  let (_, next) = Graph.add_node name g
  next

edge : Graph.NodeIndex -> Graph.NodeIndex -> e -> Graph.Graph n e k -> Graph.Graph n e k
let edge s t w g =
  Result.with_default g (Result.map (fun (_, next) -> next) (Graph.add_edge s t w g))

/// A -1-> B -2-> C -1-> D, and A -5-> C.
sample : G
let sample =
  Graph.directed ()
  |> node "A"
  |> node "B"
  |> node "C"
  |> node "D"
  |> edge 0 1 1
  |> edge 1 2 2
  |> edge 0 2 5
  |> edge 2 3 1

walk : Result Graph.GraphError (Graph.NodeWalker String) -> String
let walk r = res (Result.map Graph.values r)

no_search : Graph.SearchConfig
let no_search = { start = Some [0]; direction = None; radius = None }

from_roots : Graph.TopoConfig
let from_roots = { initials = None }

same : Graph.IdentityOptions String Number String Number
let same = { nodeIdentity = None; edgeIdentity = None }

shape : String -> Graph.MermaidNodeShape
let shape n = if n == "A" then Graph.circle else Graph.rectangle

main : Unit ->{; AppError} Unit
let main () =
  Platform.stdout_line ("counts: " ++ show (Graph.node_count sample, Graph.edge_count sample))
  Platform.stdout_line
    ("nodes: "
      ++ show
        (
          Graph.get_node 2 sample,
          Graph.get_node 9 sample,
          Graph.has_node 3 sample,
          Graph.has_node 4 sample,
        ))
  let first : Option (Graph.Edge Number) = Graph.get_edge 0 sample
  Platform.stdout_line
    (
      "edge 0: "
        ++ show first
        ++ ", "
        ++ show (Graph.has_edge 0 1 sample, Graph.has_edge 1 0 sample)
    )
  let (index, with_e) = Graph.add_node "E" sample
  Platform.stdout_line
    ("add_node: " ++ show (index, Graph.node_count with_e, Graph.node_count sample))
  Platform.stdout_line
    ("add_edge: "
      ++ res (Result.map (fun (i, g) -> (i, Graph.edge_count g)) (Graph.add_edge 3 0 7 sample)))
  Platform.stdout_line
    ("add_edge to a missing node: "
      ++ res (Result.map (fun (i, _) -> i) (Graph.add_edge 0 9 1 sample)))
  Platform.stdout_line
    ("find: "
      ++ show
        (Graph.find_node (fun n -> n == "C") sample, Graph.find_nodes (fun n -> n != "B") sample))
  Platform.stdout_line
    ("find edges: "
      ++ show
        (
          Graph.find_edge (fun w s _ -> w > 1 && s == 0) sample,
          Graph.find_edges (fun w _ t -> w < 5 && t > 1) sample,
        ))
  Platform.stdout_line
    ("incident: "
      ++ res (Graph.incident_edges 2 sample)
      ++ " "
      ++ res (Graph.incident_edges 9 sample))
  Platform.stdout_line
    (
      "out, in: "
        ++ res (Graph.outgoing_edges 0 sample)
        ++ " "
        ++ res (Graph.incoming_edges 2 sample)
    )
  Platform.stdout_line ("between: " ++ res (Graph.edges_between 0 2 sample))
  Platform.stdout_line
    ("degrees: " ++ res (Graph.out_degree 0 sample) ++ " " ++ res (Graph.in_degree 2 sample))
  Platform.stdout_line
    ("neighbors: "
      ++ show (Graph.neighbors 0 sample, Graph.successors 1 sample, Graph.predecessors 2 sample))
  Platform.stdout_line
    ("directed neighbors: "
      ++ show
        (
          Graph.neighbors_directed 2 Graph.incoming sample,
          Graph.neighbors_directed 2 Graph.outgoing sample,
        ))
  let changed =
    sample |> Graph.update_node 0 (fun n -> n ++ "!") |> Graph.update_edge 2 (fun w -> w * 10)
  Platform.stdout_line
    (
      "update: "
        ++ show (Graph.get_node 0 changed, Graph.get_edge 2 changed, Graph.get_node 0 sample)
    )
  let mapped = sample |> Graph.map_nodes String.to_lower |> Graph.map_edges (fun w -> w + 100)
  Platform.stdout_line
    ("map: "
      ++ show
        (
          Graph.values (Graph.nodes mapped),
          List.map (fun (_, e) -> e.data) (Graph.entries (Graph.edges mapped)),
        ))
  let kept = Graph.filter_map_nodes (fun n -> if n == "B" then None else Some (n ++ n)) sample
  Platform.stdout_line
    ("filter_map_nodes: " ++ show (Graph.entries (Graph.nodes kept), Graph.edge_count kept))
  let light = Graph.filter_map_edges (fun w -> if w < 5 then Some (w * 2) else None) sample
  Platform.stdout_line
    ("filter_map_edges: "
      ++ show (List.map (fun (_, e) -> e.data) (Graph.entries (Graph.edges light))))
  Platform.stdout_line
    ("filter: "
      ++ show
        (
          Graph.node_count (Graph.filter_nodes (fun n -> n != "A") sample),
          Graph.edge_count (Graph.filter_edges (fun w -> w == 1) sample),
        ))
  Platform.stdout_line ("reverse: " ++ show (Graph.successors 2 (Graph.reverse sample)))
  Platform.stdout_line
    ("remove: "
      ++ show
        (
          Graph.edge_count (Graph.remove_edge 0 sample),
          Graph.edge_count (Graph.remove_edges [0, 1] sample),
          Graph.edge_count (Graph.remove_node 2 sample),
          Graph.node_count (Graph.remove_nodes [0, 1] sample),
        ))
  let snapshot : Graph.Snapshot String Number Graph.Directed = Graph.to_snapshot sample
  let node_zero : List (Graph.IndexedNode String) = List.take 1 snapshot.nodes
  let edge_zero : List (Graph.IndexedEdge Number) = List.take 1 snapshot.edges
  Platform.stdout_line ("snapshot: " ++ show (node_zero, edge_zero))
  let rebuilt =
    Graph.from_snapshot
      { graph_type = Graph.directed_kind; nodes = snapshot.nodes; edges = snapshot.edges }
  Platform.stdout_line ("from_snapshot: " ++ res (Result.map Graph.edge_count rebuilt))
  let broken =
    Graph.from_snapshot { graph_type = Graph.directed_kind; nodes = []; edges = snapshot.edges }
  Platform.stdout_line ("broken snapshot: " ++ res (Result.map Graph.edge_count broken))
  let kind_value = Graph.undirected_kind
  let plain : Graph.UndirectedGraph String Number =
    Graph.make kind_value |> node "x" |> node "y" |> edge 0 1 3
  Platform.stdout_line ("make: " ++ show (Graph.has_edge 1 0 plain, Graph.neighbors 1 plain))
  let other = Graph.directed () |> node "C" |> node "D" |> node "Z" |> edge 0 1 1 |> edge 1 2 4
  Platform.stdout_line
    ("compose: "
      ++ show
        (
          Graph.node_count (Graph.compose same other sample),
          Graph.edge_count (Graph.compose same other sample),
        ))
  Platform.stdout_line
    ("intersection: "
      ++ show
        (
          Graph.values (Graph.nodes (Graph.intersection same other sample)),
          Graph.edge_count (Graph.intersection same other sample),
        ))
  Platform.stdout_line
    ("difference: "
      ++ show
        (
          Graph.node_count (Graph.difference same other sample),
          Graph.edge_count (Graph.difference same other sample),
        ))
  Platform.stdout_line
    ("symmetric_difference: "
      ++ show
        (
          Graph.node_count (Graph.symmetric_difference same other sample),
          Graph.edge_count (Graph.symmetric_difference same other sample),
        ))
  let by_letter : Graph.IdentityOptions String Number String Bool =
    { nodeIdentity = Some String.to_lower; edgeIdentity = Some (fun _ -> true) }
  let lower = Graph.map_nodes String.to_lower other
  Platform.stdout_line
    ("identity: " ++ show (Graph.edge_count (Graph.intersection by_letter lower sample)))
  Platform.stdout_line
    ("sum: "
      ++ show
        (Graph.node_count (Graph.sum other sample), Graph.edge_count (Graph.sum other sample)))
  let missing = Graph.complement (fun s t -> String.length (s ++ t)) sample
  Platform.stdout_line
    ("complement: "
      ++ show (Graph.edge_count missing, Graph.has_edge 1 0 missing, Graph.has_edge 0 1 missing))
  let forward = Graph.outgoing
  let follow = Graph.along forward
  let one_step : Graph.NeighborhoodConfig = { radius = Some 1; direction = Some follow }
  let near = Graph.neighborhood 1 one_step sample
  Platform.stdout_line
    ("neighborhood: " ++ res (Result.map (fun g -> Graph.values (Graph.nodes g)) near))
  let around = Graph.neighborhood 1 { radius = None; direction = Some Graph.both_ways } sample
  Platform.stdout_line
    ("both ways: " ++ res (Result.map (fun g -> Graph.values (Graph.nodes g)) around))
  Platform.stdout_line
    ("bad radius: "
      ++ res
        (Result.map
          Graph.node_count
          (Graph.neighborhood 1 { radius = Some (0 - 1); direction = None } sample)))
  Platform.stdout_line
    ("induced: "
      ++ res (Result.map Graph.edge_count (Graph.induced_subgraph [0, 1, 2] sample))
      ++ " "
      ++ res (Result.map Graph.edge_count (Graph.induced_subgraph [7] sample)))
  Platform.stdout_line ("dfs: " ++ walk (Graph.dfs no_search sample))
  Platform.stdout_line ("bfs: " ++ walk (Graph.bfs no_search sample))
  Platform.stdout_line ("post order: " ++ walk (Graph.dfs_post_order no_search sample))
  Platform.stdout_line
    ("dfs radius 1: "
      ++ walk (Graph.dfs { start = Some [0]; direction = None; radius = Some 1 } sample))
  Platform.stdout_line
    ("bfs back from D: "
      ++ walk
        (Graph.bfs
          { start = Some [3]; direction = Some (Graph.along Graph.incoming); radius = None }
          sample))
  Platform.stdout_line
    ("missing start: "
      ++ walk (Graph.dfs { start = Some [8]; direction = None; radius = None } sample))
  let order : Result Graph.GraphError (List Graph.NodeIndex) =
    Result.map Graph.indices (Graph.topo from_roots sample)
  Platform.stdout_line
    ("topo: " ++ res order ++ " " ++ walk (Graph.topo { initials = Some [1] } sample))
  let cyclic = edge 3 0 1 sample
  Platform.stdout_line ("topo of a cycle: " ++ walk (Graph.topo { initials = None } cyclic))
  let leaves : Graph.ExternalsConfig = { direction = None }
  let sinks : Graph.NodeWalker String = Graph.externals leaves sample
  Platform.stdout_line
    ("externals: "
      ++ show
        (
          Graph.entries sinks,
          Graph.values (Graph.externals { direction = Some Graph.incoming } sample),
        ))
  let all_edges : Graph.EdgeWalker Number = Graph.edges sample
  let walker : Graph.Walker Graph.EdgeIndex (Graph.Edge Number) = all_edges
  Platform.stdout_line ("edges: " ++ show (Graph.indices walker))
  let dot : Graph.GraphVizOptions String Number =
    { nodeLabel = Some (fun n -> n); edgeLabel = Some show; graphName = Some "G" }
  Platform.stdout_line (Graph.to_graph_viz dot sample)
  let diagram : Graph.MermaidOptions String Number =
    {
      nodeLabel = Some (fun n -> n);
      edgeLabel = None;
      diagramType = Some Graph.flowchart;
      direction = Some Graph.left_to_right;
      nodeShape = Some shape;
    }
  Platform.stdout_line (Graph.to_mermaid diagram sample)
  let direction = Graph.top_to_bottom
  let diagram_type = Graph.graph_diagram
  let shapes =
    [
      Graph.rounded,
      Graph.diamond,
      Graph.hexagon,
      Graph.stadium,
      Graph.subroutine,
      Graph.cylindrical,
    ]
  let each =
    List.map
      (fun s ->
        Graph.to_mermaid
          {
            nodeLabel = None;
            edgeLabel = None;
            diagramType = Some diagram_type;
            direction = Some direction;
            nodeShape = Some (fun _ -> s);
          }
          plain)
      shapes
  Platform.stdout_line (String.join "\n" each)
  let rest = [Graph.top_down, Graph.bottom_to_top, Graph.right_to_left]
  Platform.stdout_line
    (String.join
      "\n"
      (List.map
        (fun d ->
          Graph.to_mermaid
            {
              nodeLabel = None;
              edgeLabel = None;
              diagramType = None;
              direction = Some d;
              nodeShape = None;
            }
            plain)
        rest))
