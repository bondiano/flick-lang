// Effect's `ChannelSchema`: channels that encode and decode each chunk with
// a codec, failing with the program's `SchemaError`.
module App.Main exposing (main)

type alias Point = { x : Number; y : Number }
  deriving Schema

point : Codec none none Json Point
let point = Codec.general (Codec.json (schema Point))

text : Codec none none Json String
let text = Codec.general String.json

say : String ->{} Unit
let say line = Platform.stdout_line line

issues : SchemaError -> String
let issues (SchemaError found) =
  "err " ++ String.join "; " (List.map (fun i -> i.path ++ ": " ++ i.message) found)

points : Channel.Channel none none i (NonEmpty.NonEmpty Point) Unit ie id
let points = Channel.from_list_chunked 2 [{ x = 1; y = 2 }, { x = 3; y = 4 }, { x = 5; y = 6 }]

flat : Channel.Channel none {SchemaError} Unit (
  NonEmpty.NonEmpty a
) Unit none Unit ->{; SchemaError}
  List a
let flat channel = List.concat (Channel.run_collect (Channel.map NonEmpty.to_list channel))

round_trips : Unit ->{; SchemaError} Unit
let round_trips () =
  let wire = points |> Channel.pipe_to (ChannelSchema.encode point)
  say ("encode: " ++ show (List.map Json.stringify (flat wire)))
  let back = wire |> Channel.pipe_to (ChannelSchema.decode point)
  say ("decode: " ++ show (flat back))
  let unknown = points |> Channel.pipe_to (ChannelSchema.encode_unknown point)
  let decoded = unknown |> Channel.pipe_to (ChannelSchema.decode_unknown point)
  say ("encode_unknown, decode_unknown: " ++ show (flat decoded))
  let moved = Channel.map_input (fun chunk -> chunk) (Channel.identity ())
  let shifted =
    points
    |> Channel.pipe_to (ChannelSchema.duplex { inputSchema = point; outputSchema = point } moved)
  say ("duplex: " ++ show (flat shifted))
  let reencoded = ChannelSchema.decode point |> Channel.pipe_to (ChannelSchema.encode_unknown point)
  let through =
    points
    |> Channel.pipe_to
      (ChannelSchema.duplex_unknown { inputSchema = point; outputSchema = point } reencoded)
  say ("duplex_unknown: " ++ show (flat through))

main : Unit ->{; AppError} Unit
let main () =
  try
    round_trips ()
    let words =
      Channel.from_list_chunked 1 ["a"] |> Channel.pipe_to (ChannelSchema.encode_unknown text)
    let wrong = words |> Channel.pipe_to (ChannelSchema.decode_unknown point)
    say ("wrong: " ++ show (flat wrong))
  with
  | SchemaError found -> say (issues (SchemaError found))
