// Effect's `Effect` beyond the language: one task timed, repeated, raced
// and checked, and tasks run per element of a list.
module App.Main exposing (main)

type error Boom = Boom Float
  deriving Show

type error Odd = Odd Float
  deriving Show

ms1 : Duration.Duration
let ms1 = Result.with_default Duration.zero (Duration.millis 1)

ms2 : Duration.Duration
let ms2 = Result.with_default Duration.zero (Duration.millis 2)

ms50 : Duration.Duration
let ms50 = Result.with_default Duration.zero (Duration.millis 50)

/// How a task that may fail with `Boom` ends.
outcome : Eff none {Boom} String ->{} String
let outcome t =
  try await t with
  | Boom n -> "Boom " ++ show n

/// A task that counts its runs in `runs` and gives the count.
counting : Ref Float -> Eff none none Float
let counting runs = task {
  Ref.update runs (fun n -> n + 1)
  Ref.get runs
}

/// Fails with `Boom n` for the first `failures` runs.
flaky : Ref Float -> Float -> Eff none {Boom} Float
let flaky runs failures = task {
  Ref.update runs (fun n -> n + 1)
  let n = Ref.get runs
  if n <= failures then from_result (Err (Boom n)) else n
}

even : Float ->{; Odd} Float
let even n = if n % 2 == 0 then n * 10 else from_result (Err (Odd n))

parity : Float -> Result String Float
let parity n = if n % 2 == 0 then Ok (n * 10) else Err ("odd " ++ show n)

head_of : Eff none none (List Float) ->{} String
let head_of t =
  try show (Effect.head t) with
  | Cause.NoSuchElementError _ -> "empty"

checked : Eff none {Odd} Float ->{} String
let checked t =
  try show (await t) with
  | Odd n -> "Odd " ++ show n

single : Unit ->{} Unit
let single () =
  let exit : Exit {Boom} Float = Effect.exit (task { from_result (Err (Boom 1)) })
  Platform.stdout_line ("exit: " ++ show (Exit.is_failure exit))
  let died : Exit none Float = Effect.exit (task { Effect.die "broken" })
  Platform.stdout_line
    ("die: " ++ show (Exit.find_defect died == Ok "broken" || Exit.has_dies died))
  let failure = Cause.fail (Boom 2)
  Platform.stdout_line
    ("fail_cause_sync: " ++ outcome (task { Effect.fail_cause_sync (fun () -> failure) }))
  Effect.yield_now ()
  Effect.yield_now_with 1
  let pair = Effect.zip (task { "b" }) (task { "a" })
  Platform.stdout_line ("zip: " ++ show pair)
  Platform.stdout_line
    ("zip_with: " ++ show (task { 2 } |> Effect.zip_with (task { 3 }) (fun a b -> a * b)))
  Platform.stdout_line ("delay: " ++ show (Effect.delay ms1 (task { "late" })))
  let (took, value) =
    Effect.timed
      (task {
        Effect.sleep ms2
        "timed"
      })
  Platform.stdout_line
    ("timed: " ++ value ++ " " ++ show (Option.with_default 0 (Duration.to_millis took) >= 1))
  Platform.stdout_line
    ("timeout_or_else: "
      ++ show (Effect.timeout_or_else ms1 (task { "fallback" }) (task { Effect.never () })))
  Platform.stdout_line
    ("timeout_or_else: "
      ++ show (Effect.timeout_or_else ms50 (task { "fallback" }) (task { "fast" })))
  let runs = Ref.make 0
  Platform.stdout_line
    ("forever: "
      ++ outcome
        (task {
          Effect.forever
            (flaky runs 3
              |> fun t -> task {
                let _ = await t
                ()
              })
        }))
  let tries = Ref.make 0
  Platform.stdout_line ("eventually: " ++ show (Effect.eventually (flaky tries 2)))
  let fresh = Ref.make 0
  let copies = Effect.replicate 3 (counting fresh)
  Platform.stdout_line ("replicate: " ++ show (List.length copies))
  let shared = Ref.make 0
  Platform.stdout_line
    ("replicate_effect: " ++ show (Effect.replicate_effect Effect.Sequential 3 (counting shared)))
  Platform.stdout_line
    ("when_: "
      ++ show (
        Effect.when_ (task { true }) (task { 1 }),
        Effect.when_ (task { false }) (task { 2 }),
      ))
  Platform.stdout_line
    ("timeout: "
      ++ show
        (
          try timeout 1 (task { Effect.never () }) with
          | TimeoutError -> "timed out"
        ))
  let quick = timeout_option 50 (task { 5 })
  let slow : Option Float = timeout_option 1 (task { Effect.never () })
  Platform.stdout_line ("timeout_option: " ++ show (quick, slow))
  Platform.stdout_line
    ("race_success: " ++ show (race_success (task { Effect.never () }) (task { "fast" })))
  Platform.stdout_line
    ("race_first: " ++ show (race_first (task { Effect.never () }) (task { "first" })))

collections : Unit ->{} Unit
let collections () =
  let xs = [1, 2, 3, 4]
  Platform.stdout_line
    ("for_each: " ++ show (Effect.for_each (Effect.Bounded 2) (fun n -> n * 2) xs))
  Platform.stdout_line ("all: " ++ show (Effect.all Effect.Unbounded [task { 1 }, task { 2 }]))
  let (passes, fails) = Effect.partition Effect.Sequential even xs
  Platform.stdout_line
    ("partition: "
      ++ show (
        List.map
          (fun e ->
            match e with
            | Odd n -> n
          )
          fails,
        passes,
      ))
  let validated =
    try show (Effect.validate Effect.Sequential even xs) with
    | Effect.ValidationError errors ->
      "invalid "
        ++ show
          (List.map
            (fun e ->
              match e with
              | Odd n -> n
            )
            (NonEmpty.to_list errors))
  Platform.stdout_line ("validate: " ++ validated)
  Platform.stdout_line
    ("validate: "
      ++ try show (Effect.validate Effect.Sequential even [2, 4]) with
      | Effect.ValidationError _ -> "invalid")
  Platform.stdout_line ("filter: " ++ show (Effect.filter Effect.Sequential (fun n -> n > 2) xs))
  Platform.stdout_line ("filter_map: " ++ show (Effect.filter_map parity xs))
  Platform.stdout_line
    ("filter_map_effect: "
      ++ show (Effect.filter_map_effect Effect.Sequential (fun n -> parity n) xs))
  Platform.stdout_line
    ("find_first: "
      ++ show (Effect.find_first (fun n -> n > 1) xs, Effect.find_first (fun n -> n > 9) xs))
  Platform.stdout_line
    ("find_first_filter: " ++ show (Effect.find_first_filter (fun n -> parity n) xs))
  let attempts : List (Eff none {Boom} String) = [
    task { from_result (Err (Boom 1)) },
    task { "second" },
  ]
  Platform.stdout_line ("first_success_of: " ++ outcome (task { Effect.first_success_of attempts }))
  Platform.stdout_line ("head: " ++ head_of (task { [7, 8] }) ++ " " ++ head_of (task { [] }))
  Platform.stdout_line ("reduce: " ++ show (Effect.reduce 0 (fun acc n -> acc + n) xs))
  Platform.stdout_line
    ("filter_or_else: "
      ++ show (task { 3 } |> Effect.filter_or_else (fun n -> n > 5) (fun n -> n * 100)))
  Platform.stdout_line
    ("filter_map_or_else: "
      ++ show
        (task { 3 } |> Effect.filter_map_or_else parity (fun s -> Int.to_float (String.length s))))
  Platform.stdout_line
    ("filter_or_fail: "
      ++ checked (task { Effect.filter_or_fail (fun n -> n > 5) (fun n -> Odd n) (task { 3 }) }))
  Platform.stdout_line
    ("filter_map_or_fail: "
      ++ checked (task { Effect.filter_map_or_fail parity (fun _ -> Odd 0) (task { 4 }) }))

resources : Unit ->{} Unit
let resources () =
  let log = Ref.make []
  let used =
    Resource.bracket (task { "file" }) (fun r -> r ++ " used") (fun r ->
      Ref.update log (fun xs -> xs ++ ["released " ++ r])
    )
  Platform.stdout_line ("bracket: " ++ used ++ ", " ++ show (Ref.get log))
  let acquired = Ref.make 0
  let refreshed = Latch.make false
  // the second acquisition opens the latch: the resource has been refreshed
  let acquire = task {
    let n = await (counting acquired)
    let _ = if n >= 2 then Latch.open refreshed else false
    n
  }
  // a busy machine may refresh it before the first use, and the latch opens
  // before the refresh replaces the value: the first use sees an acquisition,
  // and the resource comes to hold a later one
  let seen = scope {
    let auto = Effect.resource_auto (Schedule.spaced ms1) acquire
    let first = Resource.use auto (fun v -> v)
    Latch.await_ refreshed
    let later = Effect.eventually (task {
      let n = Resource.use auto (fun v -> v)
      if n >= 2 then n else from_result (Err (Boom n))
    })
    (first >= 1, later >= 2)
  }
  Platform.stdout_line ("resource_auto: " ++ show seen)

transactions : Unit ->{} Unit
let transactions () =
  let meta : Tx.Meta = Tx.atomically (task { Tx.current () })
  let reason = meta.retryReason
  Platform.stdout_line ("tx: " ++ show (meta.attempt, reason))

main : Unit ->{; AppError} Unit
let main () =
  single ()
  collections ()
  resources ()
  transactions ()
