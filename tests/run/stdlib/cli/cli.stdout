###-begin-greet-completions-###
#
# Static completion script for Fish
#
# Installation:
#   greet --completions fish > ~/.config/fish/completions/greet.fish
#

complete -c greet -f
complete -c greet -n 'not __fish_contains_opt loud no-loud' -l loud -d 'Print in capitals'
complete -c greet -n 'not __fish_contains_opt loud no-loud' -l no-loud -d 'Disable loud'
complete -c greet -n 'begin; not __fish_contains_opt -s n times; or contains -- (commandline -poc)[-1] --times -n; end' -l times -s n -d 'How many times' -r -f
complete -c greet -n 'begin; not __fish_contains_opt -s c color; or contains -- (commandline -poc)[-1] --color -c; end' -l color -s c -d 'The color of the text' -r -f
complete -c greet -n 'not string match -q -- "-*" (commandline -ct); and not __fish_contains_opt loud no-loud' -f -a '--loud' -d 'Print in capitals'
complete -c greet -n 'not string match -q -- "-*" (commandline -ct); and not __fish_contains_opt loud no-loud' -f -a '--no-loud' -d 'Disable loud'
complete -c greet -n 'not string match -q -- "-*" (commandline -ct); and not __fish_contains_opt -s n times' -f -a '--times' -d 'How many times'
complete -c greet -n 'not string match -q -- "-*" (commandline -ct); and not __fish_contains_opt -s c color' -f -a '--color' -d 'The color of the text'

###-end-greet-completions-###
