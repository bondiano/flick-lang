// Command lines parsed by Effect's CLI: flags and arguments of each
// multiplicity, subcommands, invalid input as `CliError` before any handler,
// `--help`, `--version` and completions.
module App.Main exposing (main)

import Cli

type Color = Red | GreenLight
  deriving Cli.Value, Show

greet : Cli.Command none none
let greet = cli "greet" {
  description "Prints a greeting"
  /// Print in capitals
  flag loud : Bool
  /// How many times
  flag times "n" : Float = 1
  /// The color of the text
  flag color "c" : Option Color
  /// Who to greet
  arg name : String
  handle fun { loud; times; color; name } ->
    let text = "Hello, " ++ name ++ show color
    let line = if loud then String.to_upper text else text
    Platform.stdout_line (String.join " / " (List.repeat (Int.truncate times) line))
}

sum : Cli.Command none none
let sum = cli "sum" {
  description "Adds numbers"
  arg numbers : NonEmpty.NonEmpty Float
  handle fun { numbers } -> Platform.stdout_line (show (List.sum (NonEmpty.to_list numbers)))
}

tool : Cli.Command none none
let tool = cli "tool" {
  description "Project tools"
  /// Verbose output
  flag verbose "v" : Bool
  subcommand greet
  subcommand sum
}

/// Runs the command line, printing the error a bad one gives.
attempt : Cli.Command none none -> List String ->{Async} Unit
let attempt command args =
  Platform.stdout_line ("$ " ++ String.join " " args)
  try Cli.run command args with
  | Cli.CliError message -> Platform.stdout_line ("CliError: " ++ message)

main : Unit ->{Async; AppError} Unit
let main () =
  attempt greet ["Ada"]
  attempt greet ["--loud", "-n", "2", "--color", "green-light", "Bob"]
  attempt greet ["--times", "abc", "Ada"]
  attempt greet ["--loud=maybe", "Ada"]
  attempt greet ["--color", "blue", "Ada"]
  attempt greet ["--nope", "Ada"]
  attempt greet []
  attempt sum ["1", "2", "3.5"]
  attempt sum []
  attempt tool ["greet", "Cy"]
  attempt tool ["sum", "4", "5"]
  attempt tool ["--verbose", "sum", "1"]
  attempt tool ["nope"]
  attempt greet ["--help"]
  attempt tool ["--help"]
  attempt greet ["--version"]
  attempt greet ["--completions", "fish"]
