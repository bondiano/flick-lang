// The built-in flags `--log-level` and `--trace`: the first sets the
// handler's minimum log level, the second runs it as a span of its command
// with OTLP, sending to `OTEL_EXPORTER_OTLP_ENDPOINT` as `OTEL_SERVICE_NAME`.
module App.Main exposing (main)

import Cli exposing (plugin cli)

start : Unit ->{Async;} Float
foreign start from "../observability/receiver.mjs" "start"
  arity 0

received : Unit ->{} String
foreign received from "../observability/receiver.mjs" "received"
  arity 0

stop : Unit ->{Async;} Unit
foreign stop from "../observability/receiver.mjs" "stop"
  arity 0

set_env : String -> String ->{} Unit
foreign set_env from "./env.mjs" "set"
  arity 2

/// A logger writing the level and the message, without the time.
plain : Logger.Logger Unit
let plain =
  Logger.with_console_log
    (Logger.make (fun o -> show o.logLevel ++ " " ++ String.join " " o.message))

/// A child span of the command's, with an attribute.
options : Tracer.SpanOptions
let options = {
  attributes = [("cart", "3 items")];
  links = [];
  parent = None;
  root = false;
  kind_ = Tracer.internal;
  sampled = None;
  level = None;
  captureStackTrace = false;
  disablePropagation = false;
}

type error Declined = Declined

command : Cli.Command none none
let command = cli "shop" {
  description "Checks out"
  handle fun _ ->
    Logger.with_loggers
      [plain]
      (task {
        Tracer.with_span "pay" options (task { Effect.log_info "checkout" })
        // a span that fails has an `exception` event
        try Tracer.with_span "refund" options (task { from_result (Err Declined) }) with
        | Declined -> ()
        Effect.log_debug "details"
      })
}

has : String -> String -> String
let has text needle = needle ++ ": " ++ show (String.contains needle text)

main : Unit ->{Async; AppError} Unit
let main () =
  try
    Platform.stdout_line "default:"
    Cli.run command []
    Platform.stdout_line "--log-level debug:"
    Cli.run command ["--log-level", "debug"]
    Platform.stdout_line "--trace:"
    set_env "OTEL_EXPORTER_OTLP_ENDPOINT" ("http://127.0.0.1:" ++ show (start ()))
    set_env "OTEL_SERVICE_NAME" "shop-cli"
    Cli.run command ["--trace"]
    let got = received ()
    Platform.stdout_line (has got "/v1/traces")
    Platform.stdout_line (has got "\"name\":\"shop\"")
    Platform.stdout_line (has got "\"shop-cli\"")
    Platform.stdout_line (has got "\"name\":\"pay\"")
    Platform.stdout_line (has got "\"3 items\"")
    Platform.stdout_line (has got "\"name\":\"exception\"")
    Platform.stdout_line (has got "/v1/metrics")
    stop ()
    let settings = { Cli.settings with builtIns = [Cli.HelpFlag] }
    Platform.stdout_line "without TraceFlag:"
    Cli.run_with settings command ["--trace"]
  with
  | Cli.CliError message -> Platform.stdout_line ("CliError: " ++ message)
