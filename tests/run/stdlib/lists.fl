// List traversals: `List.map` is pure, `List.map_effect` runs its callback
// one element after another from the first; building tasks runs nothing,
// and `parallel_all` keeps at most its limit of branches running.
module App.Main exposing (main)

sleep : Number ->{} Unit
foreign async sleep from "../runtime/timers.mjs" "sleep"

logged : Ref (List Number) -> Number ->{} Number
let logged log n =
  Ref.modify log (fun xs -> ((), xs ++ [n]))
  n * 10

/// Tracks how many tasks run at once, and the most at any time.
track : Ref Number -> Ref Number -> Number -> Eff none none Number
let track active peak n =
  task {
    let now = Ref.modify active (fun a -> (a + 1, a + 1))
    Ref.modify peak (fun p -> ((), if now > p then now else p))
    sleep 5
    Ref.modify active (fun a -> ((), a - 1))
    n
  }

main : Unit ->{; AppError} Unit
let main () =
  Platform.stdout_line (show (List.map (fun x -> x + 1) [1, 2, 3]))
  let log = Ref.make []
  let tens = List.map_effect (logged log) [3, 1, 2]
  Platform.stdout_line (show tens ++ " in order " ++ show (Ref.get log))
  let started = Ref.make 0
  let requests = List.map (fun n -> task { Ref.modify started (fun s -> ((), s + 1)) }) [1, 2, 3]
  Platform.stdout_line ("built, started " ++ show (Ref.get started))
  let active = Ref.make 0
  let peak = Ref.make 0
  let results = parallel_all 8 (List.map (track active peak) (List.range 0 20))
  Platform.stdout_line ("sum " ++ show (List.sum results) ++ ", at most " ++ show (Ref.get peak))
  Platform.stdout_line (show (List.sort [3, Number.nan, 1, -Number.infinity, 2, Number.infinity, 0]))
  let pairs = [(2, "a"), (1, "b"), (2, "c"), (1, "d")]
  let by_first = List.sort_by (fun (a, _) (b, _) -> compare a b) pairs
  Platform.stdout_line (show (List.map (fun (_, s) -> s) by_first))
  Platform.stdout_line (show [compare (-0) 0, compare Number.nan Number.nan, compare Number.infinity Number.nan])
  Platform.stdout_line (show (List.fold_left (fun acc x -> acc ++ show x) "" [1, 2, 3]))
  Platform.stdout_line (show (List.get 1 ["x", "y"], List.get 5 ["x"], List.reverse [1, 2]))
