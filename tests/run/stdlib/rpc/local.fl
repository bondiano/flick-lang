// A group called in memory with `call_local`: a unary call, a declared
// error and a stream, no server started. Then over HTTP, a client that
// gives up on a slow call interrupts an ordinary handler, while an
// uninterruptible one runs to its end.
module App.Main exposing (main)

import Stream.Core exposing (Stream)

mark : String ->{} Unit
foreign sync mark from "./marks.mjs" "mark"
  arity 1

marked : Unit ->{} String
foreign sync marked from "./marks.mjs" "marked"
  arity 0

sleep : Number ->{} Unit
foreign async sleep from "./marks.mjs" "sleep"
  arity 1

type error NotFound = NotFound { id : Number }
  deriving Schema

double : Rpc.Rpc "double" (Number ->{r; NotFound} Number)
let double =
  Rpc.make (Record.label : Record.Label "double")
    |> Rpc.with_payload (Codec.json Schema.number)
    |> Rpc.with_success (Codec.json Schema.number)
    |> Rpc.with_errors [Rpc.error_case (Codec.json (schema NotFound))]

count_to : Rpc.Rpc "count_to" (Number ->{r;} Stream none none Number)
let count_to =
  Rpc.make (Record.label : Record.Label "count_to")
    |> Rpc.with_payload (Codec.json Schema.number)
    |> Rpc.with_stream (Codec.json Schema.number)

slow : Rpc.Rpc "slow" (Unit ->{r;} Unit)
let slow = Rpc.make (Record.label : Record.Label "slow")

steady : Rpc.Rpc "steady" (Unit ->{r;} Unit)
let steady = Rpc.make (Record.label : Record.Label "steady") |> Rpc.uninterruptible

type alias Handlers r =
  {
    double : Number ->{r; NotFound} Number;
    count_to : Number ->{r;} Stream none none Number;
    slow : Unit ->{r;} Unit;
    steady : Unit ->{r;} Unit;
  }

group : Rpc.Group (Handlers r)
let group =
  Rpc.group |> Rpc.add double |> Rpc.add count_to |> Rpc.add slow |> Rpc.add steady

handlers : Handlers none
let handlers =
  {
    double = fun n -> if n < 0 then from_result (Err (NotFound { id = n })) else n * 2;
    count_to = fun n -> Stream.from_list (List.range 1 (n + 1));
    slow = fun () ->
      sleep 100
      mark "slow";
    steady = fun () ->
      sleep 100
      mark "steady";
  }

main : Unit ->{; AppError} Unit
let main () =
  let local = try show (Rpc.call_local group handlers double 21) with | NotFound _ -> "not found"
  Platform.stdout_line ("local: " ++ local)
  let refused =
    try show (Rpc.call_local group handlers double (0 - 1)) with
    | NotFound e -> "not found " ++ show e.id
  Platform.stdout_line ("local error: " ++ refused)
  let counted = Stream.run_collect (Rpc.call_stream_local group handlers count_to 3)
  Platform.stdout_line ("local stream: " ++ show counted)
  let result =
    try
      scope s {
        let server = Rpc.listen Rpc.defaults group handlers
        let url = "http://127.0.0.1:" ++ show (Rpc.port server) ++ "/rpc"
        let slow_answer =
          try
            timeout 20 (task { Rpc.call url slow () })
            "slow answered"
          with
          | TimeoutError -> "slow gave up"
        Platform.stdout_line slow_answer
        let steady_answer =
          try
            timeout 20 (task { Rpc.call url steady () })
            "steady answered"
          with
          | TimeoutError -> "steady gave up"
        Platform.stdout_line steady_answer
        sleep 300
      }
    with
    | Rpc.ServeError message -> Platform.stdout_line ("serve: " ++ message)
    | Rpc.ClientError message -> Platform.stdout_line ("client: " ++ message)
  result
  Platform.stdout_line ("finished: " ++ marked ())
