// A group called in memory with `call_local`: a unary call, a declared
// error and a stream, no server started. Then over HTTP, a client that
// gives up on a slow call interrupts an ordinary handler, while an
// uninterruptible one runs to its end.
module App.Main exposing (main)

import Stream.Core exposing (Stream)

mark : String ->{} Unit
foreign sync mark from "./marks.mjs" "mark"
  arity 1

marked : Unit ->{} String
foreign sync marked from "./marks.mjs" "marked"
  arity 0

sleep : Float ->{Async;} Unit
foreign async sleep from "./marks.mjs" "sleep"
  arity 1

start : String ->{} Unit
foreign sync start from "./marks.mjs" "start"
  arity 1

started : String ->{Async;} Unit
foreign async started from "./marks.mjs" "started"
  arity 1

type error NotFound = NotFound { id : Float }
  deriving Schema

double : Rpc.Rpc "double" (Float ->{r; NotFound} Float)
let double =
  Rpc.make (Record.label : Record.Label "double")
  |> Rpc.with_payload (Codec.json Schema.number)
  |> Rpc.with_success (Codec.json Schema.number)
  |> Rpc.with_errors (Rpc.errors |> Rpc.error_case (Codec.json NotFound.schema))

count_to : Rpc.Rpc "count_to" (Float ->{r;} Stream none none Float)
let count_to =
  Rpc.make (Record.label : Record.Label "count_to")
  |> Rpc.with_payload (Codec.json Schema.number)
  |> Rpc.with_stream (Codec.json Schema.number)

slow : Rpc.Rpc "slow" (Unit ->{r;} Unit)
let slow = Rpc.make (Record.label : Record.Label "slow")

steady : Rpc.Rpc "steady" (Unit ->{r;} Unit)
let steady = Rpc.make (Record.label : Record.Label "steady") |> Rpc.uninterruptible

type alias Handlers r = {
  double : Float ->{r; NotFound} Float;
  count_to : Float ->{r;} Stream none none Float;
  slow : Unit ->{r;} Unit;
  steady : Unit ->{r;} Unit;
}

group : Rpc.Group r (Handlers r)
let group = Rpc.group |> Rpc.add double |> Rpc.add count_to |> Rpc.add slow |> Rpc.add steady

handlers : Handlers {Async}
let handlers = {
  double = fun n -> if n < 0 then from_result (Err (NotFound { id = n })) else n * 2;
  count_to = fun n -> Stream.from_list (List.map Int.to_float (List.range 1 (Int.truncate n + 1)));
  slow = fun () ->
    start "slow"
    sleep 100
    mark "slow";
  steady = fun () ->
    start "steady"
    sleep 100
    mark "steady";
}

main : Unit ->{Async; AppError} Unit
let main () =
  let local =
    try show (Rpc.call_local group handlers double 21) with
    | NotFound _ -> "not found"
  Platform.stdout_line ("local: " ++ local)
  let refused =
    try show (Rpc.call_local group handlers double (0 - 1)) with
    | NotFound e -> "not found " ++ show e.id
  Platform.stdout_line ("local error: " ++ refused)
  let counted = Stream.run_collect (Rpc.call_stream_local group handlers count_to 3)
  Platform.stdout_line ("local stream: " ++ show counted)
  let result =
    try
      scope s {
        let server = Rpc.listen Rpc.defaults group handlers
        let url = "http://127.0.0.1:" ++ show (Rpc.port server) ++ "/rpc"
        // the client gives up once the handler runs, not on a timer the
        // request might not beat
        let slow_call = Fiber.spawn s (fun _ -> ()) (task { Rpc.call url slow () })
        started "slow"
        Fiber.interrupt slow_call
        Platform.stdout_line "slow gave up"
        let steady_call = Fiber.spawn s (fun _ -> ()) (task { Rpc.call url steady () })
        started "steady"
        Fiber.interrupt steady_call
        Platform.stdout_line "steady gave up"
        sleep 300
      }
    with
    | Rpc.ServeError message -> Platform.stdout_line ("serve: " ++ message)
    | Rpc.ClientError message -> Platform.stdout_line ("client: " ++ message)
  result
  Platform.stdout_line ("finished: " ++ marked ())
