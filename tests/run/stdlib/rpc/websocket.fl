// RPC over WebSocket: a call per connection with `Rpc.websocket`, a stream
// whose elements come as they are sent, and one connection several calls
// share, over WebSocket and over HTTP.
module App.Main exposing (main)

import Stream.Core exposing (Stream)

type error NotFound = NotFound { id : Float }
  deriving Schema

double : Rpc.Rpc "double" (Float ->{r; NotFound} Float)
let double =
  Rpc.make (Record.label : Record.Label "double")
    |> Rpc.with_payload (Codec.json Schema.number)
    |> Rpc.with_success (Codec.json Schema.number)
    |> Rpc.with_errors (Rpc.errors |> Rpc.error_case (Codec.json (schema NotFound)))

count_to : Rpc.Rpc "count_to" (Float ->{r;} Stream none none Float)
let count_to =
  Rpc.make (Record.label : Record.Label "count_to")
    |> Rpc.with_payload (Codec.json Schema.number)
    |> Rpc.with_stream (Codec.json Schema.number)

type alias Handlers r =
  { double : Float ->{r; NotFound} Float; count_to : Float ->{r;} Stream none none Float }

group : Rpc.Group r (Handlers r)
let group = Rpc.group |> Rpc.add double |> Rpc.add count_to

handlers : Handlers none
let handlers =
  {
    double = fun n -> if n < 0 then from_result (Err (NotFound { id = n })) else n * 2;
    count_to =
      fun n -> Stream.from_list (List.map Int.to_float (List.range 1 (Int.truncate n + 1)));
  }

main : Unit ->{; AppError} Unit
let main () =
  let options = { serialization = Rpc.json; transport = Rpc.websocket }
  let result =
    try
      scope s {
        let sockets =
          Rpc.listen_websocket { Rpc.defaults with serialization = Rpc.json } group handlers
        let ws = "ws://127.0.0.1:" ++ show (Rpc.port sockets) ++ "/rpc"
        Platform.stdout_line ("ws call: " ++ show (Rpc.call_with options ws double 21))
        let refused =
          try show (Rpc.call_with options ws double (0 - 1)) with
          | NotFound e -> "not found " ++ show e.id
        Platform.stdout_line ("ws error: " ++ refused)
        let counted = Stream.run_collect (Rpc.call_stream_with options ws count_to 3)
        Platform.stdout_line ("ws stream: " ++ show counted)
        let connection = Rpc.connect options ws
        let first = Rpc.call_on connection double 1
        let second = Rpc.call_on connection double 2
        let streamed = Stream.run_collect (Rpc.call_stream_on connection count_to 2)
        Platform.stdout_line
          ("ws connection: " ++ show first ++ ", " ++ show second ++ ", " ++ show streamed)
        let http = Rpc.listen Rpc.defaults group handlers
        let over_http =
          Rpc.connect
            Rpc.call_defaults
            ("http://127.0.0.1:" ++ show (Rpc.port http) ++ "/rpc")
        Platform.stdout_line ("http connection: " ++ show (Rpc.call_on over_http double 5))
      }
    with
    | Rpc.ServeError message -> Platform.stdout_line ("serve: " ++ message)
    | Rpc.ClientError message -> Platform.stdout_line ("client: " ++ message)
    | NotFound e -> Platform.stdout_line ("not found " ++ show e.id)
  result
