// A guarded `server fn` runs with the session `Server.authenticated` makes
// from the headers of each call: over HTTP, and in memory from a page the
// server renders, with the cookie of the page's request. A call without a
// session gets `Server.Unauthorized` and the body does not run.
module App.Main exposing (main)

import Http.ServerRequest exposing (ServerRequest)
import Http.ServerResponse exposing (ServerResponse)

ran : Unit ->{} Unit
foreign sync ran from "./auth.mjs" "ran"
  arity 0

runs : Unit ->{} Float
foreign sync runs from "./auth.mjs" "runs_"
  arity 0

/// Who calls.
service Session =
  user : Unit ->{} String

whoami : Unit ->{Server.Server, Session; Server.Unauthorized} String
server fn whoami () =
  ran ()
  Session.user ()

open_door : Unit ->{Server.Server;} String
server fn open_door () = "open"

session : String -> Session.Impl
let session name = { user = fun () -> name }

/// The session of a `user=<name>` cookie.
check : Http.Headers.Headers ->{; Server.Unauthorized} Session.Impl
let check headers =
  match Http.Headers.get "cookie" headers with
  | Some "user=ada" -> session "ada"
  | Some "user=bob" -> session "bob"
  | _ -> from_result (Err Server.Unauthorized)

/// A page that greets who asks.
page : ServerRequest ->{Server.Server;} ServerResponse
let page _ =
  let greeting =
    try "hello " ++ whoami () with
    | Server.Unauthorized -> "sign in"
    | Rpc.ClientError message -> "rpc: " ++ message
  Http.ServerResponse.text greeting Http.ServerResponse.defaults

/// A call of `whoami` over HTTP with `cookie`, as a browser makes it.
posted : String -> String ->{Http.Client.HttpClient; Http.ClientError.HttpClientError} String
let posted base cookie =
  let call =
    "{\"_tag\":\"Request\",\"id\":\"1\",\"tag\":\"App.Main.whoami\",\"payload\":null,\"headers\":[]}\n"
  let request =
    Http.ClientRequest.set_header
      "cookie"
      cookie
      (Http.ClientRequest.body_text
        call
        (Some "application/ndjson")
        (Http.ClientRequest.post (base ++ Server.path)))
  Http.ClientResponse.text (Http.Client.execute request)

/// The page as a browser with `cookie` gets it.
visited : String -> String ->{Http.Client.HttpClient; Http.ClientError.HttpClientError} String
let visited base cookie =
  Http.ClientResponse.text
    (Http.Client.execute
      (Http.ClientRequest.set_header "cookie" cookie (Http.ClientRequest.get (base ++ "/page"))))

main : Unit ->{; AppError} Unit
let main () = provide (Layer.merge
  Server.node
  (Layer.merge Http.FetchClient.layer Http.Server.layer_services)) {
  try
    scope s {
      functions : (ServerRequest ->{} ServerResponse)^{s}
      let functions =
        Server.handler (Server.authenticated Session check [server whoami] ++ [server open_door])
      app : (ServerRequest ->{Server.Server; Http.ServerError.HttpServerError} ServerResponse)^{s}
      let app =
        Http.Router.router Http.Router.config [
          Http.Router.route (Some Http.Method.POST) Server.path (fun request -> functions request),
          Http.Router.route (Some Http.Method.GET) "/page" page,
        ]
      let options : Http.Server.ServeOptions = {
        host = "127.0.0.1";
        port = 0;
        gracefulShutdownTimeout = None;
      }
      let server = Http.Server.serve options app
      let base = Http.Server.format_address (Http.Server.address server)
      Platform.stdout_line
        ("ada over HTTP: " ++ show (String.contains "ada" (posted base "user=ada")))
      Platform.stdout_line
        ("bob over HTTP: " ++ show (String.contains "bob" (posted base "user=bob")))
      let refused = posted base "user=eve"
      Platform.stdout_line ("eve over HTTP: " ++ show (String.contains "Unauthorized" refused))
      Platform.stdout_line ("page for ada: " ++ visited base "user=ada")
      Platform.stdout_line ("page for eve: " ++ visited base "user=eve")
      Platform.stdout_line ("open: " ++ open_door ())
      Platform.stdout_line ("body runs: " ++ show (runs ()))
    }
  with
  | Http.ServerError.ServeError _ -> Platform.stdout_line "serve failed"
  | Http.ClientError.HttpClientError _ -> Platform.stdout_line "client failed"
  | Rpc.ClientError message -> Platform.stdout_line ("rpc: " ++ message)
}
