// A `server fn` served by `Server.handler` on `Http.Router`, called by its
// name: the success, a declared error as itself, and `ClientError` when no
// server answers. While the handler is mounted, a call in its process runs
// in memory, whatever `FLICK_SERVER_URL` says; others come over HTTP.
module App.Main exposing (main)

import Http.ServerRequest exposing (ServerRequest)
import Http.ServerResponse exposing (ServerResponse)
import Server

set_env : String -> String ->{} Unit
foreign set_env from "../cli/env.mjs" "set"
  arity 2

type alias Order = { item : String; count : Float }
  deriving Schema

type error OutOfStock = OutOfStock String
  deriving Schema

/// Up to three of an item.
place : Order ->{Server.Server; OutOfStock} String
server fn place order =
  if order.count > 3 then
    from_result (Err (OutOfStock order.item))
  else
    "placed " ++ show order.count ++ " " ++ order.item

/// Two parameters travel as one payload.
label : String -> Float ->{Server.Server} String
server fn label item count = item ++ " x" ++ show count

/// What the client sees of a call.
shown : Order ->{Async} String
let shown order =
  try place order with
  | OutOfStock item -> "out of stock: " ++ item
  | Rpc.ClientError _ -> "no server"

main : Unit ->{Async; AppError} Unit
let main () =
  set_env "FLICK_SERVER_URL" "http://127.0.0.1:1"
  Platform.stdout_line (shown { item = "tea"; count = 1 })
  provide (Layer.merge Server.node (Layer.merge Http.FetchClient.layer Http.Server.layer_services)) {
    try
      scope s {
        functions : (ServerRequest ->{Async} ServerResponse)^{s}
        let functions = Server.handler [server place, server label]
        app : (ServerRequest ->{Async; Http.ServerError.HttpServerError} ServerResponse)^{s}
        let app =
          Http.Router.router Http.Router.config [
            Http.Router.route (Some Http.Method.POST) Server.path (fun request ->
              functions request
            ),
          ]
        let options : Http.Server.ServeOptions = {
          host = "127.0.0.1";
          port = 0;
          gracefulShutdownTimeout = None;
        }
        let server = Http.Server.serve options app
        Platform.stdout_line (shown { item = "tea"; count = 2 })
        Platform.stdout_line (shown { item = "cake"; count = 5 })
        Platform.stdout_line
          (
            try label "jam" 4 with
            | Rpc.ClientError _ -> "no server"
          )
        let call =
          "{\"_tag\":\"Request\",\"id\":\"1\",\"tag\":\"App.Main.label\",\"payload\":[\"tea\",2],\"headers\":[]}\n"
        let request =
          Http.ClientRequest.body_text
            call
            (Some "application/ndjson")
            (Http.ClientRequest.post
              (Http.Server.format_address (Http.Server.address server) ++ Server.path))
        let answer = Http.ClientResponse.text (Http.Client.execute request)
        Platform.stdout_line ("over HTTP: " ++ show (String.contains "tea x2" answer))
      }
      Platform.stdout_line ("unmounted: " ++ shown { item = "tea"; count = 1 })
    with
    | Http.ServerError.ServeError _ -> Platform.stdout_line "serve failed"
    | Http.ClientError.HttpClientError _ -> Platform.stdout_line "client failed"
  }
