// Effect's atoms through `Reactivity.Atom`: a state, derived atoms that
// compute again after a write, a family, labels, idle time, and a task's
// result as an `AsyncResult`.
module App.Main exposing (main)

import Reactivity.Atom as Atom
import Reactivity.AsyncResult as AsyncResult

count : Atom.Writable Number
let count = Atom.label_state "App.Main.count" (Atom.state 1)

doubled : Atom.Atom Number
let doubled =
  Atom.keep_alive (Atom.readable (fun ctx -> Atom.read ctx (Atom.readonly count) * 2))

shown : Atom.Atom String
let shown = Atom.with_label "App.Main.shown" (Atom.map (fun n -> "n=" ++ show n) doubled)

greeting : String -> Atom.Atom String
let greeting = Atom.family (fun name -> Atom.readonly (Atom.state ("hello " ++ name)))

answer : Atom.Atom (AsyncResult.AsyncResult Number none)
let answer =
  Atom.idle_ttl
    (Result.with_default Duration.zero (Duration.seconds 1))
    (Atom.from_task (task { 41 + 1 }))

/// The doubled count, from whatever registry is provided.
read_doubled : Unit ->{Atom.Registry;} Number
let read_doubled () = Atom.get doubled

describe : AsyncResult.AsyncResult Number none -> String
let describe result =
  AsyncResult.fold
    "initial"
    (fun n -> "success " ++ show n)
    (fun _ -> "failure")
    result

main : Unit ->{; AppError} Unit
let main () =
  provide Atom.layer {
    Platform.stdout_line (show (read_doubled ()))
    Atom.set count 5
    Platform.stdout_line (Atom.get shown)
    Atom.update count (fun n -> n + 1)
    Platform.stdout_line (show (Atom.get doubled))
    let previous = Atom.modify count (fun n -> (n, n * 10))
    Platform.stdout_line (show (previous, Atom.get (Atom.readonly count)))
    Platform.stdout_line (Atom.get (greeting "ada"))
    let first = Atom.get answer
    Platform.stdout_line (describe first ++ ", waiting " ++ show (AsyncResult.is_waiting first))
    Atom.refresh answer
    Platform.stdout_line (show (AsyncResult.value (Atom.get answer)))
  }
