// Prometheus: a recorded counter in the text a `/metrics` route of a real
// server answers, and named with a prefix or renamed by `format_with`.
module App.Main exposing (main)

scrape : String ->{Async;} String
foreign async scrape from "./scrape.mjs" "scrape"
  arity 1

checkouts : Metric.Counter
let checkouts =
  Metric.counter "checkouts" { description = None; attributes = []; incremental = false }

has : String -> String -> String
let has text needle = needle ++ ": " ++ show (String.contains needle text)

main : Unit ->{Async; AppError} Unit
let main () =
  Metric.update 2 checkouts
  let result =
    try
      scope s {
        app :
          Http.ServerRequest.ServerRequest ->{; Http.ServerError.HttpServerError}
          Http.ServerResponse.ServerResponse
        let app = Http.Router.router Http.Router.config [Prometheus.route "/metrics"]
        let options : Http.Server.ServeOptions = {
          host = "127.0.0.1";
          port = 0;
          gracefulShutdownTimeout = None;
        }
        let server = Http.Server.serve options app
        let scraped = scrape (Http.Server.format_address (Http.Server.address server) ++ "/metrics")
        Platform.stdout_line (has scraped "text/plain; version=0.0.4")
        Platform.stdout_line (has scraped "checkouts")
      }
    with
    | Http.ServerError.ServeError message -> Platform.stdout_line ("serve: " ++ message)
  result
  let prefixed = Prometheus.format_with { prefix = Some "shop"; rename = None } ()
  Platform.stdout_line (has prefixed "shop_checkouts")
  let renamed = Prometheus.format_with { prefix = None; rename = Some String.to_upper } ()
  Platform.stdout_line (has renamed "CHECKOUTS")
