// OTLP exporters sending to a local collector: a span, a log record and a
// metric made inside the provided layer reach it, with their names,
// attributes and the service, once the layer's scope closes; the layer of
// all three sends to their paths under one URL; Prometheus formats a
// recorded counter.
module App.Main exposing (main)

start : Unit ->{Async} Float
foreign start from "./receiver.mjs" "start"
  arity 0

received : Unit ->{} String
foreign received from "./receiver.mjs" "received"
  arity 0

stop : Unit ->{Async} Unit
foreign stop from "./receiver.mjs" "stop"
  arity 0

options : Tracer.SpanOptions
let options = {
  attributes = [("user", "ada")];
  links = [];
  parent = None;
  root = false;
  kind_ = Tracer.internal;
  sampled = None;
  level = None;
  captureStackTrace = false;
  disablePropagation = false;
}

checkouts : Metric.Counter
let checkouts =
  Metric.counter "checkouts" { description = None; attributes = []; incremental = false }

has : String -> String -> String
let has text needle = needle ++ ": " ++ show (String.contains needle text)

main : Unit ->{Async; AppError} Unit
let main () =
  let base = "http://127.0.0.1:" ++ show (start ())
  provide (Otlp.traces { url = base ++ "/v1/traces"; service_name = "shop" }) {
    Tracer.with_span "checkout" options (task { Metric.update 1 checkouts })
  }
  let got = received ()
  Platform.stdout_line (has got "/v1/traces")
  Platform.stdout_line (has got "\"checkout\"")
  Platform.stdout_line (has got "\"user\"")
  Platform.stdout_line (has got "\"ada\"")
  Platform.stdout_line (has got "\"shop\"")
  // no console logger, so only the collector gets the record
  let quiet : List (Logger.Logger Unit) = []
  provide (Logger.layer { mergeWithExisting = false } quiet) {
    provide (Otlp.logs { url = base ++ "/v1/logs"; service_name = "shop" }) { Effect.log "paid" }
  }
  provide (Otlp.metrics { url = base ++ "/v1/metrics"; service_name = "shop" }) {
    Metric.update 1 checkouts
  }
  provide (Otlp.layer { url = base; service_name = "shop" }) {
    Tracer.with_span "refund" options Effect.void
  }
  let all = received ()
  Platform.stdout_line (has all "/v1/logs")
  Platform.stdout_line (has all "\"paid\"")
  Platform.stdout_line (has all "/v1/metrics")
  Platform.stdout_line (has all "\"refund\"")
  Platform.stdout_line (has (Prometheus.format ()) "checkouts")
  stop ()
