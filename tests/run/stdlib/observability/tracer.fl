// An OTLP tracer of a scope given to `Tracer.with_tracer`: the spans of the
// task it runs reach the collector when the scope closes, and a span made
// outside it stays with the native tracer.
module App.Main exposing (main)

start : Unit ->{Async;} Float
foreign async start from "./receiver.mjs" "start"
  arity 0

received : Unit ->{} String
foreign sync received from "./receiver.mjs" "received"
  arity 0

stop : Unit ->{Async;} Unit
foreign async stop from "./receiver.mjs" "stop"
  arity 0

options : Tracer.SpanOptions
let options = {
  attributes = [("user", "ada")];
  links = [];
  parent = None;
  root = false;
  kind_ = Tracer.internal;
  sampled = None;
  level = None;
  captureStackTrace = false;
  disablePropagation = false;
}

has : String -> String -> String
let has text needle = needle ++ ": " ++ show (String.contains needle text)

main : Unit ->{Async; AppError} Unit
let main () =
  let base = "http://127.0.0.1:" ++ show (start ())
  scope {
    let tracer = Otlp.tracer { url = base ++ "/v1/traces"; service_name = "shop" }
    Tracer.with_tracer tracer (task { Tracer.with_span "checkout" options Effect.void })
  }
  Tracer.with_span "elsewhere" options Effect.void
  let got = received ()
  Platform.stdout_line (has got "/v1/traces")
  Platform.stdout_line (has got "\"checkout\"")
  Platform.stdout_line (has got "\"shop\"")
  Platform.stdout_line (has got "\"elsewhere\"")
  stop ()
