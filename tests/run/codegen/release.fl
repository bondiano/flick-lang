// What the release optimizer must keep (every case also runs in release):
// a runtime first stage is not joined with the next, a full application
// and a partial one agree, an endless runtime loop stays interruptible, a
// chosen witness stays chosen, and unused runtime calls still run.
module App.Main exposing (main)

type Shape = Circle Float | Square Float
  deriving Eq, Hash, Show

noisy : Float ->{} Float
let noisy n =
  Platform.stdout_line ("argument " ++ show n)
  n

first_stage : Float ->{} (Float -> Float)
let first_stage x =
  Platform.stdout_line ("first stage " ++ show x)
  fun y -> x + y

scale : Float -> Float -> Float
let scale factor n =
  let pair = (factor, n)
  let (f, m) = pair
  f * m + 1

triple : Float -> Float
let triple = scale 3

spin : Float ->{} Float
let rec spin n = spin (n + 1)

size_of : Shape -> Float
let size_of s =
  match s with
  | Circle r -> r
  | Square r -> r

distinct : List Shape -> (Float, Float)
let distinct shapes =
  let canonical = HashSet.size (HashSet.from_list EqHash.canonical shapes)
  let by_size =
    EqHash.with (fun a b -> size_of a == size_of b) size_of (fun witness ->
      HashSet.size (HashSet.from_list witness shapes)
    )
  (canonical, by_size)

main : Unit ->{; AppError} Unit
let main () =
  let total = first_stage 1 (noisy 2)
  Platform.stdout_line (show total)
  Platform.stdout_line (show (scale 2 5, triple 5, List.map (scale 4) [1, 2]))
  let stopped = timeout_option 30 (task { spin 0 })
  Platform.stdout_line (show stopped)
  Platform.stdout_line (show (distinct [Circle 1, Square 1, Circle 2]))
  let unused = Platform.stdout_line "an unused result still runs"
  Platform.stdout_line (show (60 * 60 * 24, 0.1 + 0.2, 2 ** 0.5, -0 == 0))
