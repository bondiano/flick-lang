// Arguments, tuple items and record fields are evaluated left to right,
// fields in the order written.
module App.Main exposing (main)

trace : String -> Float ->{Host.Console} Float
let trace label n =
  Platform.stdout_line label
  n

pair : Float -> Float -> Float
let pair a b = a * 10 + b

first :
  (Float ->{Host.Console} Float) -> (Float ->{Host.Console} Float) -> Float ->{Host.Console} Float
let first f g x =
  match (f x, g x) with
  | (a, _) -> a

guarded : Float -> Float -> Float
let guarded x y =
  match (x, y) with
  | (0, _) -> 0
  | (a, b) when a > b -> a
  | (_, b) -> b

main : Unit ->{Host.Console; AppError} Unit
let main () =
  let (x, y) = (trace "t1" 1, trace "t2" 2)
  let r = { b = trace "rb" 3; a = trace "ra" 4 }
  let p = pair (trace "p1" 1) (trace "p2" 2)
  Platform.stdout_line (show (x + y + r.a + r.b + p))
  let result = first (fun x -> trace "f" (x + 1)) (fun x -> trace "g" (x + 2)) 7
  Platform.stdout_line (show result)
  Platform.stdout_line (show (guarded result (result + 1)))
