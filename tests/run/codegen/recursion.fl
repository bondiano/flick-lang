// Pure tail recursion is a loop: of a function itself, through its own
// dictionaries, behind `&&` and `||`, and between the members of a `rec`
// group. A loop walks a list by offset instead of copying its rest. Runtime
// recursion runs through the runtime without growing the JS stack.
module App.Main exposing (main)

sum_to : Float -> Float -> Float
let rec sum_to acc n =
  if n == 0 then acc else sum_to (acc + n) (n - 1)

count_down : Ref Float -> Float ->{} Unit
let rec count_down cell n =
  if n == 0 then () else
    Ref.set cell n
    count_down cell (n - 1)

steps : Eq a => Float -> a -> Float
let rec steps n x =
  if n == 0 then 0 else if x == x then steps (n - 1) x else n

all_below : Float -> Float -> Bool
let rec all_below limit n =
  n == 0 || n < limit && all_below limit (n - 1)

rec {
  is_even : Float -> Bool
  let is_even n = if n == 0 then true else is_odd (n - 1)

  is_odd : Float -> Bool
  let is_odd n = if n == 0 then false else is_even (n - 1)
}

rec {
  ping : Float -> Float -> Float
  let ping acc n = if n == 0 then acc else pong (acc + 1) (n - 1)

  pong : Float -> Float -> Float
  let pong acc n = if n == 0 then acc else pang acc (n - 1)

  pang : Float -> Float -> Float
  let pang acc n = if n == 0 then acc else ping (acc + 2) (n - 1)
}

pairs : Int -> List Int -> Int
let rec pairs acc xs =
  match xs with
  | [a, b, ...rest] -> pairs (acc + b - a) rest
  | [a] -> acc + a
  | _ -> acc

restart : Float -> Float -> List Float -> Float
let rec restart acc n xs =
  match xs with
  | [] -> if n == 0 then acc else restart acc (n - 1) [1, 2, 3]
  | [x, ...rest] -> restart (acc + x) n rest

rec {
  even_len : List a -> Bool
  let even_len xs =
    match xs with
    | [] -> true
    | [_, ...rest] -> odd_len rest

  odd_len : List a -> Bool
  let odd_len xs =
    match xs with
    | [] -> false
    | [_, ...rest] -> even_len rest
}

main : Unit ->{; AppError} Unit
let main () =
  Platform.stdout_line (show (sum_to 0 1000000))
  let cell = Ref.make 0
  count_down cell 100000
  Platform.stdout_line (show (Ref.get cell))
  Platform.stdout_line (show (steps 1000000 "a"))
  Platform.stdout_line (show (all_below 2000000 1000000))
  Platform.stdout_line (show (is_even 1000000) ++ " " ++ show (is_odd 1000001))
  Platform.stdout_line (show (ping 0 1000000))
  let big = List.range 0 1000000
  Platform.stdout_line (show (pairs 0 big) ++ " " ++ show (pairs 0 [1, 2, 3]))
  Platform.stdout_line (show (restart 0 2 [10]))
  Platform.stdout_line (show (even_len big) ++ " " ++ show (odd_len [1, 2, 3]))
