// Every export of this module has a TypeScript type in `--emit ts`, which
// `tsc --strict` checks against the generated code.
module App.Main exposing (..)

type Shape = Circle Float | Rect Float Float

type Tree a = Leaf | Node (Tree a) a (Tree a)

type alias Point = { x : Float; y : Float }

// a string in JS, and to TypeScript an opaque brand
opaque unboxed type Token = Token String

type error NotFound = NotFound String

service Users =
  get : String ->{; NotFound} Point

identity : a -> a
let identity x = x

area : Shape -> Float
let area shape =
  match shape with
  | Circle r -> r * r
  | Rect w h -> w * h

origin : Point
let origin = { x = 0; y = 1 }

empty : List a
let empty = []

pair : a -> b -> (a, b)
let pair a b = (a, b)

size : Tree a -> Float
let rec size tree =
  match tree with
  | Leaf -> 0
  | Node l _ r -> size l + 1 + size r

token : String -> Token
let token text = Token text

first : List a -> Option a
let first xs =
  match xs with
  | [x] -> Some x
  | _ -> None

parse : String -> Result NotFound Float
let parse text = if text == "one" then Ok 1 else Err (NotFound text)

load : String ->{Users; NotFound} Point
let load id = Users.get id

main : Unit ->{; AppError} Unit
let main () =
  Platform.stdout_line (show (area (Rect 2 3) + size (Node Leaf 1 Leaf)))
  Platform.stdout_line (show (first [origin.y]))
