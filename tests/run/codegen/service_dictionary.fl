// An operation with class constraints: its implementation takes their
// dictionaries, and each call of the operation passes them.
module App.Main exposing (main)

service Render =
  render : Show a => a ->{} String
  pair : (Show a, Show b) => a -> b ->{} String

render_impl : Render.Impl
let render_impl =
  {
    render = fun x -> "<" ++ show x ++ ">";
    pair = fun x y -> show x ++ "/" ++ show y;
  }

// the dictionary of `a` is the one `twice` is given
twice : Show a => a ->{Render;} String
let twice x =
  Render.render x ++ Render.render [x]

main : Unit ->{} Unit
let main () =
  provide (Layer.succeed Render render_impl) {
    Platform.stdout_line (Render.render 42)
    Platform.stdout_line (Render.render "text")
    half : Bool ->{Render;} String
    let half = Render.pair 1
    Platform.stdout_line (half true)
    Platform.stdout_line (twice 1.5)
  }
