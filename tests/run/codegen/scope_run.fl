// `Scope.run` is what `scope` stands for, and a function can take the body as
// a value: it is polymorphic in the region, whose owner it receives.
module App.Main exposing (main)

/// Prints through the trusted host adapter: the finalizers that print may
/// outlive the caller's provider of `Host.Console` (`FLICK-G003`).
log : String -> Eff none none Unit
let log line = task { Host.raw_stdout_line line }

with_region : (forall s. Fiber.Owner s ->{Scope s} String) ->{} String
let with_region body = Scope.run body

closes : Fiber.Owner s ->{Scope s} String
let closes owner =
  Scope.add_finalizer (log "closed")
  ignore owner
  "body"

nested : Unit ->{} String
let nested () = scope outer {
  scope inner {
    ignore (Resource.acquire_release (log "acquired") (fun _ -> Host.raw_stdout_line "released"))
    ignore inner
    ignore outer
    "nested"
  }
}

main : Unit ->{Host.Console; AppError} Unit
let main () =
  Platform.stdout_line
    (Scope.run (fun owner ->
      ignore owner
      "lambda"
    ))
  Platform.stdout_line (with_region closes)
  Platform.stdout_line (nested ())
