// `for … do` runs its body for each element right where it stands: a
// `for…of` inside the computation, no generator; it stops when interrupted.
module App.Main exposing (main)

sleep : Number ->{} Unit
foreign async sleep from "../runtime/timers.mjs" "sleep"

report : List (String, Number) ->{} Unit
let report scores =
  for { (name, score) <- scores; if score > 1 } do
    Platform.stdout_line (name ++ " " ++ show score)

main : Unit ->{; AppError} Unit
let main () =
  for x <- [1, 2, 3] do Platform.stdout_line ("item " ++ show x)
  report [("ada", 3), ("bob", 1), ("cy", 2)]
  for { x <- Seq.range 0 2; y <- ["a", "b"] } do {
    let label = show x ++ y
    Platform.stdout_line label
  }
  let counter = Ref.make 0
  let stopped =
    timeout_option 30 (task {
      for n <- Seq.from 1 do
        Ref.set counter n
        sleep 5
    })
  Platform.stdout_line (show stopped)
  Platform.stdout_line (show (Ref.get counter > 0))
