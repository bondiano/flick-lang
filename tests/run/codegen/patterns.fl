// Patterns: literals, tuples, lists, records, nested constructors,
// or-patterns with bindings and guards.
module App.Main exposing (main)

type Shape = Circle Float | Rect Float Float | Empty

classify : Shape -> String
let classify shape =
  match shape with
  | Circle r | Rect r _ when r > 10 -> "large"
  | Rect w h when w == h -> "square"
  | Circle _ | Rect _ _ -> "shape"
  | Empty -> "empty"

/// The last arm binds one name in either alternative.
extent : Shape -> Float
let extent shape =
  match shape with
  | Empty -> 0
  | Circle r | Rect r _ -> r

first : List (Option Float) -> Float
let first xs =
  match xs with
  | [Some n, _] | [Some n] -> n
  | [None, Some (1 | 2)] -> -1
  | _ -> 0

sum : List Float -> Float
let rec sum xs =
  match xs with
  | [] -> 0
  | [x, ...rest] -> x + sum rest

split : List Float -> String
let split xs =
  match xs with
  | [a, b, ...rest] -> show (a + b) ++ " " ++ show rest
  | _ -> "short"

area : { w : Float; h : Float } -> Float
let area { w; h = height } = w * height

main : Unit ->{; AppError} Unit
let main () =
  Platform.stdout_line
    (classify (Circle 20)
      ++ " "
      ++ classify (Rect 11 1)
      ++ " "
      ++ classify (Rect 2 2)
      ++ " "
      ++ classify (Circle 1)
      ++ " "
      ++ classify Empty)
  Platform.stdout_line (show [extent (Circle 2), extent (Rect 3 4), extent Empty])
  Platform.stdout_line (show [first [Some 5], first [Some 6, None], first [None, Some 2], first []])
  Platform.stdout_line (show (area { w = 3; h = 4 }))
  Platform.stdout_line (show (sum [1, 2, 3, 4]))
  Platform.stdout_line (split [1] ++ ", " ++ split [1, 2] ++ ", " ++ split [1, 2, 3])
  let (a, (b, c)) = (1, (2, 3))
  Platform.stdout_line (show (a + b + c))
  let words = ["a"] ++ ["b", "c"]
  Platform.stdout_line (show words)
  let r = { x = 1; y = 2 }
  let moved = { r with x = 10 }
  Platform.stdout_line (show (moved.x + moved.y + r.x))
