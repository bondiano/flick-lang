// Services are looked up when an operation runs; `provide` builds the
// layer before its body.
module App.Main exposing (main)

service Greeter =
  greet : String ->{} String

service Counter =
  next : Unit ->{} Number

greeter_impl : Greeter.Impl
let greeter_impl =
  { greet = fun name -> "hello, " ++ name }

counter_impl : Ref Number -> Counter.Impl
let counter_impl cell =
  { next = fun () -> Ref.modify cell (fun n -> (n + 1, n + 1)) }

welcome : String ->{Greeter, Counter; none} String
let welcome name =
  let n = Counter.next ()
  Greeter.greet name ++ " #" ++ show n

main : Unit ->{none; AppError} Unit
let main () =
  let cell = Ref.make 0
  let layer = Layer.merge (Layer.succeed Greeter greeter_impl) (Layer.succeed Counter (counter_impl cell))
  let first = provide layer {
    welcome "ada"
  }
  let second = provide layer {
    welcome "bob"
  }
  Platform.stdout_line first
  Platform.stdout_line second
  Platform.stdout_line (greeter_impl.greet "direct")
