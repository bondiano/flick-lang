// `f x y` is `(f x) y`: a runtime first stage finishes before the second
// argument is evaluated.
module App.Main exposing (main)

stage : Float ->{} (Float -> Float)
let stage x =
  Platform.stdout_line "stage 1"
  fun y -> x + y

argument : Float ->{} Float
let argument n =
  Platform.stdout_line "argument"
  n

main : Unit ->{; AppError} Unit
let main () =
  let result = stage 1 (argument 2)
  Platform.stdout_line (show result)
