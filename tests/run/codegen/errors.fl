// `try … with` recovers typed failures; an arm that does not match leaves
// the error to the caller, and a defect is not a typed failure.
module App.Main exposing (main)

type error NotFound = NotFound Number

type error Denied = Denied String

find : Number ->{none; NotFound, Denied} String
let find id =
  if id == 1 then "one"
  else if id == 2 then from_result (Err (NotFound id))
  else from_result (Err (Denied "no"))

lookup : Number ->{none; Denied} String
let lookup id =
  try
    find id
  with
  | NotFound n when n > 5 -> "big"
  | NotFound n -> "missing " ++ show n

outer : Number ->{none; none} String
let outer id =
  try
    lookup id
  with
  | Denied reason -> "denied: " ++ reason

main : Unit ->{none; AppError} Unit
let main () =
  Platform.stdout_line (outer 1)
  Platform.stdout_line (outer 2)
  Platform.stdout_line (outer 3)
  let shown = try Some (find 2) with
    | NotFound _ -> None
    | Denied _ -> None
  Platform.stdout_line (show shown)
