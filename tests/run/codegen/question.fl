// Postfix `?`: on an `Option` in a function returning one, `None` returns
// at once; on a `Result` in a runtime function, an `Err` fails with its
// error.
module App.Main exposing (main)

type error Invalid = Invalid String

half : Float -> Option Float
let half n = if n % 2 == 0 then Some (n / 2) else None

quarter : Float -> Option Float
let quarter n = half (half n)?

// an early `None` skips the rest, even inside an expression
labelled : Float -> Option String
let labelled n =
  let q = quarter n
  Some ("q = " ++ show q? ++ ", h = " ++ show (half n)?)

parse : String -> Result Invalid Float
let parse s =
  match String.to_number s with
  | Some n -> Ok n
  | None -> Err (Invalid s)

sum : String -> String ->{; Invalid} Float
let sum a b = (parse a)? + (parse b)?

summed : String -> String ->{} String
let summed a b =
  try show (sum a b) with
  | Invalid s -> "invalid " ++ s

// `let ... else` keeps `?` targeting the enclosing function in initializer,
// fallback, and remainder.
let_else_question : Option (Option Int) -> Option Int -> Option Int
let let_else_question m backup =
  let Some inner = m else Some (backup? + 100)
  let Some n = Some inner? else None
  Some (n + 5)

main : Unit ->{Host.Console; AppError} Unit
let main () =
  Platform.stdout_line (show (quarter 8))
  Platform.stdout_line (show (quarter 6))
  Platform.stdout_line (show (labelled 12))
  Platform.stdout_line (show (labelled 6))
  Platform.stdout_line (summed "1" "2")
  Platform.stdout_line (summed "1" "x")
  Platform.stdout_line (show (let_else_question (Some (Some 10)) None))
  Platform.stdout_line (show (let_else_question (Some None) (Some 1)))
  Platform.stdout_line (show (let_else_question None (Some 2)))
  Platform.stdout_line (show (let_else_question None None))
