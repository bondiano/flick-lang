module Main exposing (main)

type error Missing = Missing
type error Other = Other

service Counter =
  value : Unit ->{} Int

effect Ask =
  ask : Unit ->{} Int

effect Stop =
  abort stop : forall a. Unit ->{} a

error_guard : Int ->{} (Int, Int)
let error_guard n =
  let mut seen = 0
  let chosen =
    try from_result (Err Missing) with
    | Missing when (
      if n > 0 then
        seen = seen + 1
        false
      else
        false
    ) ->
      99
    | Missing -> seen
  (seen, chosen)

match_guard : Int -> (Int, Int)
let match_guard n =
  let mut seen = 0
  let chosen =
    match n with
    | x when (
      if x > 0 then
        seen = seen + 1
        false
      else
        false
    ) ->
      99
    | _ -> seen
  (seen, chosen)

mixed_errors : Int ->{} (Int, Int)
let mixed_errors n =
  let mut seen = 0
  let chosen =
    try
      seen = seen + 1
      if n > 0 then from_result (Err Missing) else from_result (Err Other)
    with
    | Missing -> seen + 10
    | Other -> seen + 20
  (seen, chosen)

nested_guard : Int ->{} (Int, Int)
let nested_guard n =
  let mut seen = 0
  let chosen =
    try
      try
        seen = 1
        from_result (Err Missing)
      with
      | Missing when (
        if n > 0 then
          seen = seen + n
          false
        else
          false
      ) ->
        99
    with
    | Missing -> seen
  (seen, chosen)

handler_failure : Unit ->{} (Int, Int)
let handler_failure () =
  let mut seen = 0
  let chosen =
    try
      try
        seen = 1
        from_result (Err Missing)
      with
      | Missing ->
        seen = seen + 1
        from_result (Err Other)
      | Other -> 99
    with
    | Other -> seen
  (seen, chosen)

delayed_loop : Unit ->{} Int
let delayed_loop () =
  let mut count = 0
  try
    loop {
      count = count + 1
      let work = task {
        let mut local = 0
        try
          local = 7
          from_result (Err Missing)
        with
        | Missing -> local
      }
      break await work
    }
  with
  | Missing -> count

provider_failure : Int ->{} (Int, Int)
let provider_failure n =
  let mut seen = 0
  let failed = Layer.effect Counter (task { from_result (Err Missing) })
  let chosen =
    try
      seen = 1
      provide (
        if n > 0 then
          seen = 2
          failed
        else
          failed
      ) {
        seen = 99
        Counter.value ()
      }
    with
    | Missing -> seen
  (seen, chosen)

handler_error_state : Unit ->{} (Int, Int)
let handler_error_state () =
  let mut value = 0
  let recovered =
    try
      value = Ask.ask ()
      from_result (Err Missing)
    with
    | Ask.ask () -> 20
    | Missing -> value
  (value, recovered)

handler_abort_state : Unit ->{} (Int, Int)
let handler_abort_state () =
  let mut value = 0
  let result =
    try
      value = 2
      let _unreachable = Stop.stop ()
      value = 99
      0
    with
    | Stop.stop () -> 7
  (value, result)

return_state : Unit ->{} (Int, Int)
let return_state () =
  let mut value = 0
  let result =
    try
      value = 2
      3
    with
    | return n ->
      value = value + n
      value
  (value, result)

nested_handler_state : Unit ->{} (Int, Int)
let nested_handler_state () =
  let mut value = 0
  let result =
    try
      value = 1
      let inner =
        try
          value = Ask.ask ()
          from_result (Err Missing)
        with
        | Ask.ask () -> 20
        | Missing -> value
      ignore inner
      from_result (Err Other)
    with
    | Ask.ask () -> 5
    | Other -> value
  (value, result)

protected_operation : Unit ->{} Int
let protected_operation () =
  let mut value = 0
  try
    value = 1
    loop {
      try
        value = Ask.ask ()
        break value
      with
      | Ask.ask () -> 20
    }
  with
  | Missing -> 0

strict_collection : List Int -> List Int
let strict_collection xs = [
  for {
    x <- xs
    if x >= 0
  } yield (
    if x >= 0 then
      let mut next = x
      next = next + 1
      next
    else
      x
  ),
]

long_loop_match : Int -> Int
let long_loop_match n =
  loop {
    match n with
    | _ when n == 0 -> break 0
    | _ when n == 1 -> break 1
    | _ when n == 2 -> break 2
    | _ when n == 3 -> break 3
    | _ when n == 4 -> break 4
    | _ when n == 5 -> break 5
    | _ when n == 6 -> break 6
    | _ when n == 7 -> break 7
    | _ when n == 8 -> break 8
    | _ when n == 9 -> break 9
    | _ when n == 10 -> break 10
    | _ when n == 11 -> break 11
    | _ when n == 12 -> break 12
    | _ when n == 13 -> break 13
    | _ when n == 14 -> break 14
    | _ when n == 15 -> break 15
    | _ when n == 16 -> break 16
    | _ when n == 17 -> break 17
    | _ when n == 18 -> break 18
    | _ when n == 19 -> break 19
    | _ -> break n
  }

long_protected_match : Int ->{} (Int, Int)
let long_protected_match n =
  let mut seen = 0
  let value =
    try
      seen = 1
      if n < 0 then from_result (Err Missing)
      match n with
      | _ when n == 0 -> 0
      | _ when n == 1 -> 1
      | _ when n == 2 -> 2
      | _ when n == 3 -> 3
      | _ when n == 4 -> 4
      | _ when n == 5 -> 5
      | _ when n == 6 -> 6
      | _ when n == 7 -> 7
      | _ when n == 8 -> 8
      | _ when n == 9 -> 9
      | _ when n == 10 -> 10
      | _ when n == 11 -> 11
      | _ when n == 12 -> 12
      | _ when n == 13 -> 13
      | _ when n == 14 -> 14
      | _ when n == 15 -> 15
      | _ when n == 16 -> 16
      | _ when n == 17 -> 17
      | _ when n == 18 -> 18
      | _ when n == 19 -> 19
      | _ -> n
    with
    | Missing -> 0
  (seen, value)

abort_loop : Unit ->{} Int
let abort_loop () =
  loop {
    let n =
      try
        let value = Stop.stop ()
        break value
      with
      | Stop.stop () -> 8
    break n
  }

scrutinee : Unit ->{} Int
let scrutinee () =
  Platform.stdout_line "scrutinee"
  1

scrutinee_once : Unit ->{} Int
let scrutinee_once () =
  let mut value = 0
  match scrutinee () with
  | 0 -> value = 10
  | 1 -> value = 20
  | _ -> value = 30
  value

callback_exit : Unit ->{} Int
let callback_exit () =
  let layer = Layer.succeed Ask { ask = fun () -> 5 }
  loop { ignore (Layer.run layer (if true then break 7 else fun () -> Ask.ask ())) }

scope_callback_exit : Unit ->{} Int
let scope_callback_exit () =
  loop { ignore (Scope.run (if true then break 8 else fun _ -> "scope")) }

make_layer : Unit ->{} Layer {} {} {Ask}
let make_layer () =
  Platform.stdout_line "layer"
  Layer.succeed Ask { ask = fun () -> 5 }

make_callback : Unit ->{} (Unit ->{Ask; none} Int)
let make_callback () =
  Platform.stdout_line "callback"
  fun () -> Ask.ask ()

main : Unit ->{} Unit
let main () =
  Platform.stdout_line (show (scrutinee_once ()))
  Platform.stdout_line (show (callback_exit ()))
  Platform.stdout_line (show (scope_callback_exit ()))
  Platform.stdout_line (show (Layer.run (make_layer ()) (make_callback ())))
  Platform.stdout_line (show (abort_loop ()))
  let mut handled = 0
  try handled = Ask.ask () with
  | Ask.ask () -> 20
  Platform.stdout_line (show handled)
  Platform.stdout_line (show (error_guard 1))
  Platform.stdout_line (show (match_guard 1))
  Platform.stdout_line (show (mixed_errors 1))
  Platform.stdout_line (show (mixed_errors 0))
  Platform.stdout_line (show (nested_guard 2))
  Platform.stdout_line (show (handler_failure ()))
  Platform.stdout_line (show (delayed_loop ()))
  Platform.stdout_line (show (provider_failure 0))
  Platform.stdout_line (show (provider_failure 1))
  Platform.stdout_line (show (long_loop_match 23))
  Platform.stdout_line (show (long_protected_match 23))
  Platform.stdout_line (show (handler_error_state ()))
  Platform.stdout_line (show (handler_abort_state ()))
  Platform.stdout_line (show (return_state ()))
  Platform.stdout_line (show (nested_handler_state ()))
  Platform.stdout_line (show (protected_operation ()))
  Platform.stdout_line (show (strict_collection [1, -2, 3]))
