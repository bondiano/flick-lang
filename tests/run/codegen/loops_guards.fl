module Main exposing (main)

type error Missing = Missing
type error Other = Other

service Counter =
  value : Unit ->{} Int

error_guard : Int ->{} (Int, Int)
let error_guard n =
  let mut seen = 0
  let chosen =
    try from_result (Err Missing) with
    | Missing when (
      if n > 0 then
        seen = seen + 1
        false
      else
        false
    ) ->
      99
    | Missing -> seen
  (seen, chosen)

match_guard : Int -> (Int, Int)
let match_guard n =
  let mut seen = 0
  let chosen =
    match n with
    | x when (
      if x > 0 then
        seen = seen + 1
        false
      else
        false
    ) ->
      99
    | _ -> seen
  (seen, chosen)

mixed_errors : Int ->{} (Int, Int)
let mixed_errors n =
  let mut seen = 0
  let chosen =
    try
      seen = seen + 1
      if n > 0 then from_result (Err Missing) else from_result (Err Other)
    with
    | Missing -> seen + 10
    | Other -> seen + 20
  (seen, chosen)

nested_guard : Int ->{} (Int, Int)
let nested_guard n =
  let mut seen = 0
  let chosen =
    try
      try
        seen = 1
        from_result (Err Missing)
      with
      | Missing when (
        if n > 0 then
          seen = seen + n
          false
        else
          false
      ) ->
        99
    with
    | Missing -> seen
  (seen, chosen)

handler_failure : Unit ->{} (Int, Int)
let handler_failure () =
  let mut seen = 0
  let chosen =
    try
      try
        seen = 1
        from_result (Err Missing)
      with
      | Missing ->
        seen = seen + 1
        from_result (Err Other)
      | Other -> 99
    with
    | Other -> seen
  (seen, chosen)

delayed_loop : Unit ->{} Int
let delayed_loop () =
  let mut count = 0
  try
    loop {
      count = count + 1
      let work = task {
        let mut local = 0
        try
          local = 7
          from_result (Err Missing)
        with
        | Missing -> local
      }
      break await work
    }
  with
  | Missing -> count

provider_failure : Int ->{} (Int, Int)
let provider_failure n =
  let mut seen = 0
  let failed = Layer.effect Counter (task { from_result (Err Missing) })
  let chosen =
    try
      seen = 1
      provide (
        if n > 0 then
          seen = 2
          failed
        else
          failed
      ) {
        seen = 99
        Counter.value ()
      }
    with
    | Missing -> seen
  (seen, chosen)

main : Unit ->{} Unit
let main () =
  Platform.stdout_line (show (error_guard 1))
  Platform.stdout_line (show (match_guard 1))
  Platform.stdout_line (show (mixed_errors 1))
  Platform.stdout_line (show (mixed_errors 0))
  Platform.stdout_line (show (nested_guard 2))
  Platform.stdout_line (show (handler_failure ()))
  Platform.stdout_line (show (delayed_loop ()))
  Platform.stdout_line (show (provider_failure 0))
  Platform.stdout_line (show (provider_failure 1))
