module Syntax.LetMut exposing (..)

counter : Int -> Int
let counter start =
  let mut n = start
  n = n + 1
  if n > 10 then n = 10
  if n < 0 then
    n = 0
    n = n - 1
  else
    n = n * 2
  match n with
  | 0 -> n = 1
  | _ -> ()
  x : Int
  let mut x = n
  x =
    let doubled = x * 2
    doubled + 1
  scope {
    x = x * 2
    x = x + 1
  }
  x
