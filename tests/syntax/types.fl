module App.Types exposing (..)

apply : (forall a. Show a => a -> String) -> (String, String)

decode :
  forall r. (forall a. Schema a -> Unknown ->{r; SchemaError} a) -> Unknown ->{r; SchemaError} User

open_rows : a ->{Users, Log | r; NotFound | e} b

unions : Eff (r1 + r2) (e1 + e2) a -> Layer none none {Clock}

pure_runtime : Unit ->{} Unit

fields : forall fields. { name : String | fields } -> { name : String }

captures : forall c d. (a -> b)^c -> ((f a)^d -> (f b)^(c + d))^c

scoped : File s -> (Unit ->{; ReadError} String)^{s}

record_arg : a -> { label : String }

constrained : (Show a, Eq a) => a -> a -> Bool

multiline : forall c. SaveButtonProps c -> Ui^c

type alias Props c = {
  on_save : (Unit ->{Users; SaveError} Unit)^c;
  render : (a -> Ui^c)^c;
}

holes : List _ -> (_, Float)
