// Custom types: constructors with and without fields, type parameters,
// recursion, derived Eq, Ord, Hash and Show, and constructors of another
// module.
module Language.Adts exposing (tests)

import Language.Shapes exposing (Shape(..), area)

type Tree a = Leaf | Node (Tree a) a (Tree a)
  deriving Eq, Ord, Show

type Suit = Hearts | Spades
  deriving Eq, Ord, Hash, Show

type Card = Card Suit Int | Joker
  deriving Eq, Ord, Hash, Show

type ScalarRec = Empty | Entry Int Float Bool String | Pair Float Float | Mixed Bool (Option Int) Int String
  deriving Eq, Ord, Hash, Show

type Wrap a = Wrap a
  deriving Eq, Ord, Hash, Show

type Tagged a = Tagged Int a
  deriving Eq, Ord, Hash, Show

type Choice a = NumVal Int | PolyVal a

extract_choice : Choice Int -> Int
let extract_choice c =
  match c with
  | NumVal n | PolyVal n -> n

is_zero_pair : ScalarRec -> Bool
let is_zero_pair r =
  match r with
  | Pair 0.0 -0.0 -> true
  | Empty | Entry _ _ _ _ | Pair _ _ | Mixed _ _ _ _ -> false

insert : Int -> Tree Int -> Tree Int
let rec insert x tree =
  match tree with
  | Leaf -> Node Leaf x Leaf
  | Node l v r -> if x < v then Node (insert x l) v r else Node l v (insert x r)

to_list : Tree a -> List a
let rec to_list tree =
  match tree with
  | Leaf -> []
  | Node l v r -> to_list l ++ [v] ++ to_list r

tree_of : List Int -> Tree Int
let tree_of xs = List.fold_left (fun t x -> insert x t) Leaf xs

tests : List Test.Test
let tests = [
  Test.test "recursive type" (fun () ->
    Test.equal [1, 2, 3, 5, 8] (to_list (tree_of [5, 2, 8, 1, 3]))
  ),
  Test.test "derived Eq" (fun () -> Test.equal (tree_of [2, 1]) (tree_of [2, 1])),
  Test.test "structure matters" (fun () ->
    Test.is_true "shapes differ" (tree_of [1, 2] != tree_of [2, 1])
  ),
  Test.test "derived Show" (fun () ->
    Test.equal "Node (Node Leaf 1 Leaf) 2 Leaf" (show (tree_of [2, 1]))
  ),
  Test.test "negative fields" (fun () -> Test.equal "Node Leaf -1 Leaf" (show (tree_of [-1]))),
  Test.test "show of nested constructors" (fun () ->
    Test.equal
      "[Card Hearts 10, Joker, Card Spades -2]"
      (show [Card Hearts 10, Joker, Card Spades (-2)])
  ),
  Test.test "derived Ord follows constructor order" (fun () ->
    Test.equal
      [Card Hearts 2, Card Hearts 10, Card Spades 1, Joker]
      (List.sort [Joker, Card Spades 1, Card Hearts 10, Card Hearts 2])
  ),
  Test.test "derived Hash agrees with Eq" (fun () ->
    Test.equal (hash (Card Spades 1)) (hash (Card Spades (2 - 1)))
  ),
  Test.test "constructors are functions" (fun () ->
    Test.equal [Card Hearts 1, Card Hearts 2] (List.map (Card Hearts) [1, 2])
  ),
  Test.test "imported type" (fun () -> Test.equal [3, 0] (List.map area [Rect 1 3, Dot])),
  Test.test "imported show" (fun () -> Test.equal "Rect 1 3" (show (Rect 1 3))),
  Test.test "Option puts an argument with fields in parentheses" (fun () ->
    Test.equal "[Some (Some 1), Some None, None]" (show [Some (Some 1), Some None, None])
  ),
  Test.test "comparisons order a derived type by its Ord" (fun () ->
    Test.equal [true, false, true, true] [
      Card Hearts 12 < Card Spades 1,
      Card Spades 2 >= Card Spades 3,
      true > false,
      [1, 2] < [1, 3],
    ]
  ),
  Test.test "results" (fun () ->
    Test.equal "[Ok 1, Err \"no\"]" (show [(Ok 1 : Result String Int), Err "no"])
  ),
  Test.test "payload-free constructors equality, order, hash, and show" (fun () ->
    let empty : Tree Int = Leaf
    let red_suit = Hearts
    let joker = Joker
    let map = HashMap.insert Hearts "red" (HashMap.insert Spades "black" HashMap.empty)
    Test.all [
      Test.equal true (red_suit == Hearts),
      Test.equal false (red_suit == Spades),
      Test.equal true (red_suit != Spades),
      Test.equal true (empty == Leaf),
      Test.equal false (empty == Node Leaf 1 Leaf),
      Test.equal true (joker == Joker),
      Test.equal false (joker == Card Hearts 1),
      Test.equal LT (compare red_suit Spades),
      Test.equal EQ (compare red_suit Hearts),
      Test.equal GT (compare joker (Card Spades 9)),
      Test.equal (hash red_suit) (hash Hearts),
      Test.equal (hash joker) (hash Joker),
      Test.equal "Leaf" (show empty),
      Test.equal "[Hearts, Spades]" (show [Hearts, Spades]),
      Test.equal true ((empty, red_suit) == (Leaf, Hearts)),
      Test.equal false ((empty, red_suit) == (Leaf, Spades)),
      Test.equal LT (compare (empty, red_suit) (Leaf, Spades)),
      Test.equal "{ suit = Spades, tree = Leaf }" (show { tree = empty; suit = Spades }),
      Test.equal (Some "red") (HashMap.get red_suit map),
      Test.equal (Some "black") (HashMap.get Spades map),
    ]
  ),
  Test.test "unboxed scalar fields equality, order, hash, show, and patterns" (fun () ->
    let nan = 0.0 / 0.0
    let neg_zero = -1.0 * 0.0
    let inf = 1.0 / 0.0
    let e1 = Entry (-7) 2.5 true "alpha"
    let e2 = Entry (-7) 2.5 true "alpha"
    let e3 = Entry (-7) 2.5 false "alpha"
    let p_pos = Pair 0.0 1.5
    let p_neg = Pair neg_zero 1.5
    let p_nan1 = Pair nan 1.5
    let p_nan2 = Pair nan 1.5
    let m1 = Mixed true (Some 4) (-2) "hi"
    let m2 = Mixed true (Some 4) (-2) "hi"
    let curried = List.map (Entry 1 0.5 false) ["a", "b"]
    let Tagged tag_id tag_val = Tagged 9 "ok"
    let map =
      HashMap.insert p_neg "zero" (HashMap.insert p_nan1 "nan" (HashMap.insert e1 "entry" HashMap.empty))
    Test.all [
      Test.equal true (e1 == e2),
      Test.equal false (e1 == e3),
      Test.equal true (eq e1 e2),
      Test.equal false (eq e1 e3),
      Test.equal true (p_pos == p_neg),
      Test.equal true (eq p_pos p_neg),
      Test.equal true (p_nan1 == p_nan2),
      Test.equal true (eq p_nan1 p_nan2),
      Test.equal true (m1 == m2),
      Test.equal EQ (compare p_pos p_neg),
      Test.equal LT (compare (Pair inf 1.5) p_nan1),
      Test.equal GT (compare p_nan1 (Pair inf 1.5)),
      Test.equal LT (compare e3 e1),
      Test.equal LT (compare Empty e1),
      Test.equal (hash e1) (hash e2),
      Test.equal (hash p_pos) (hash p_neg),
      Test.equal (hash p_nan1) (hash p_nan2),
      Test.equal (Some "zero") (HashMap.get p_pos map),
      Test.equal (Some "nan") (HashMap.get p_nan2 map),
      Test.equal (Some "entry") (HashMap.get e2 map),
      Test.equal "Entry -7 2.5 true \"alpha\"" (show e1),
      Test.equal "Pair -0 1.5" (show p_neg),
      Test.equal "Pair NaN 1.5" (show p_nan1),
      Test.equal "Mixed true (Some 4) -2 \"hi\"" (show m1),
      Test.equal [Entry 1 0.5 false "a", Entry 1 0.5 false "b"] curried,
      Test.equal (9, "ok") (tag_id, tag_val),
      Test.equal (Wrap 1 == Wrap 1, Wrap "a" == Wrap "a") (true, true),
      Test.equal (Tagged 1 "x" == Tagged 1 "x", Tagged 1 "x" == Tagged 2 "x") (true, false),
      Test.equal [11, 22] [extract_choice (NumVal 11), extract_choice (PolyVal 22)],
      Test.equal [true, true, false] [
        is_zero_pair (Pair 0.0 neg_zero),
        is_zero_pair (Pair neg_zero 0.0),
        is_zero_pair p_nan1,
      ],
    ]
  ),
]
