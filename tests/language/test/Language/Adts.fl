// Custom types: constructors with and without fields, type parameters,
// recursion, derived Eq, Ord, Hash and Show, and constructors of another
// module.
module Language.Adts exposing (tests)

import Language.Shapes exposing (Shape(..), area)

type Tree a = Leaf | Node (Tree a) a (Tree a)
  deriving Eq, Ord, Show

type Suit = Hearts | Spades
  deriving Eq, Ord, Hash, Show

type Card = Card Suit Int | Joker
  deriving Eq, Ord, Hash, Show

insert : Int -> Tree Int -> Tree Int
let rec insert x tree =
  match tree with
  | Leaf -> Node Leaf x Leaf
  | Node l v r -> if x < v then Node (insert x l) v r else Node l v (insert x r)

to_list : Tree a -> List a
let rec to_list tree =
  match tree with
  | Leaf -> []
  | Node l v r -> to_list l ++ [v] ++ to_list r

tree_of : List Int -> Tree Int
let tree_of xs = List.fold_left (fun t x -> insert x t) Leaf xs

tests : List Test.Test
let tests = [
  Test.test "recursive type" (fun () ->
    Test.equal [1, 2, 3, 5, 8] (to_list (tree_of [5, 2, 8, 1, 3]))
  ),
  Test.test "derived Eq" (fun () -> Test.equal (tree_of [2, 1]) (tree_of [2, 1])),
  Test.test "structure matters" (fun () ->
    Test.is_true "shapes differ" (tree_of [1, 2] != tree_of [2, 1])
  ),
  Test.test "derived Show" (fun () ->
    Test.equal "Node (Node Leaf 1 Leaf) 2 Leaf" (show (tree_of [2, 1]))
  ),
  Test.test "negative fields" (fun () -> Test.equal "Node Leaf -1 Leaf" (show (tree_of [-1]))),
  Test.test "show of nested constructors" (fun () ->
    Test.equal
      "[Card Hearts 10, Joker, Card Spades -2]"
      (show [Card Hearts 10, Joker, Card Spades (-2)])
  ),
  Test.test "derived Ord follows constructor order" (fun () ->
    Test.equal
      [Card Hearts 2, Card Hearts 10, Card Spades 1, Joker]
      (List.sort [Joker, Card Spades 1, Card Hearts 10, Card Hearts 2])
  ),
  Test.test "derived Hash agrees with Eq" (fun () ->
    Test.equal (hash (Card Spades 1)) (hash (Card Spades (2 - 1)))
  ),
  Test.test "constructors are functions" (fun () ->
    Test.equal [Card Hearts 1, Card Hearts 2] (List.map (Card Hearts) [1, 2])
  ),
  Test.test "imported type" (fun () -> Test.equal [3, 0] (List.map area [Rect 1 3, Dot])),
  Test.test "imported show" (fun () -> Test.equal "Rect 1 3" (show (Rect 1 3))),
  Test.test "Option puts an argument with fields in parentheses" (fun () ->
    Test.equal "[Some (Some 1), Some None, None]" (show [Some (Some 1), Some None, None])
  ),
  Test.test "comparisons order a derived type by its Ord" (fun () ->
    Test.equal [true, false, true, true] [
      Card Hearts 12 < Card Spades 1,
      Card Spades 2 >= Card Spades 3,
      true > false,
      [1, 2] < [1, 3],
    ]
  ),
  Test.test "results" (fun () ->
    Test.equal "[Ok 1, Err \"no\"]" (show [(Ok 1 : Result String Int), Err "no"])
  ),
]
