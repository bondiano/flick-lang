// Derived schemas and their canonical JSON codec: what encoding writes,
// what decoding accepts, and the text of each issue, by path.
module Language.Schemas exposing (tests)

type Shape = Circle Float | Rect Float Float | Dot
  deriving Eq, Show, Schema

type Color = Red | Green | Blue
  deriving Eq, Ord, Hash, Show, Schema

type Tree = Leaf | Node Tree String Tree
  deriving Eq, Show, Schema

type Entry = Empty | Entry Int Float Bool String | Mixed Bool (Option Int) Int String
  deriving Eq, Ord, Hash, Show, Schema

type ScalarVal = SFloat Float | SBool Bool | SString String | SAll Float Bool String
  deriving Eq, Ord, Hash, Show, Schema

type alias Point = { x : Int; y : Int; label : Option String }
  deriving Schema

type alias Order = {
  id : BigInt
  items : List { sku : String; qty : Int }
  shape : Shape
  paid : Result String Bool
} deriving Schema

refined type Port = Float where fun n -> n > 0 && n < 65536
  deriving Schema

encoded : Schema a -> a -> String
let encoded s value =
  match Codec.encode_result (Codec.json s) value with
  | Ok json -> Json.stringify json
  | Err (SchemaError issues) ->
    String.join "; " (List.map (fun i -> i.path ++ ": " ++ i.message) issues)

/// Decodes a JSON string through a schema's canonical codec.
decode_value : Schema a -> String -> Result SchemaError a
let decode_value s text =
  match Json.parse text with
  | Ok input -> Codec.decode_result (Codec.json s) input
  | Err err -> Err err

/// The value decoded and encoded again, or the issues by path.
decoded : Schema a -> String -> String
let decoded s text =
  match Json.parse text with
  | Err (SchemaError issues) -> String.join "; " (List.map (fun i -> i.message) issues)
  | Ok input ->
    match Codec.decode_result (Codec.json s) input with
    | Ok value -> "ok " ++ encoded s value
    | Err (SchemaError issues) ->
      String.join "; " (List.map (fun i -> i.path ++ ": " ++ i.message) issues)

order : String
let order =
  "{\"id\": \"1\", \"items\": [{\"sku\": \"a\", \"qty\": 1}], \"shape\": {\"_tag\": \"Dot\"}, \"paid\": {\"ok\": true}}"

tests : List Test.Test
let tests = [
  Test.group "encode" [
    Test.test "labels are sorted" (fun () ->
      Test.equal
        "{\"label\":null,\"x\":1,\"y\":-2}"
        (encoded Point.schema { y = -2; x = 1; label = None })
    ),
    Test.test "variants" (fun () ->
      Test.equal
        "[{\"_tag\":\"Circle\",\"_0\":1},{\"_tag\":\"Rect\",\"_0\":2,\"_1\":3.5},{\"_tag\":\"Dot\"}]"
        (encoded (Schema.list Shape.schema) [Circle 1, Rect 2 3.5, Dot])
    ),
    Test.test "NaN has no JSON form" (fun () ->
      Test.equal "(root): NaN has no JSON form" (encoded Schema.number (0.0 / 0.0))
    ),
    Test.test "BigInt as a string" (fun () ->
      Test.equal "\"-12345678901234567890\"" (encoded Schema.bigint (-12345678901234567890n))
    ),
  ],
  Test.group "decode" [
    Test.test "a whole order" (fun () ->
      Test.equal
        "ok {\"id\":\"1\",\"items\":[{\"qty\":1,\"sku\":\"a\"}],\"paid\":{\"ok\":true},\"shape\":{\"_tag\":\"Dot\"}}"
        (decoded Order.schema order)
    ),
    Test.test "Int out of range" (fun () ->
      Test.equal
        "x: expected an Int, an integer from -2147483648 to 2147483647"
        (decoded Point.schema "{\"x\": 4294967296, \"y\": 2, \"label\": null}")
    ),
    Test.test "a fraction for an Int" (fun () ->
      Test.equal
        "x: expected an Int, an integer from -2147483648 to 2147483647"
        (decoded Point.schema "{\"x\": 1.5, \"y\": 2, \"label\": null}")
    ),
    Test.test "a missing key" (fun () ->
      Test.equal "y: a missing key" (decoded Point.schema "{\"x\": 1, \"label\": null}")
    ),
    Test.test "an unknown key" (fun () ->
      Test.equal
        "z: an unknown key"
        (decoded Point.schema "{\"x\": 1, \"y\": 2, \"label\": null, \"z\": 0}")
    ),
    Test.test "a wrong type" (fun () ->
      Test.equal
        "x: expected an Int, got string"
        (decoded Point.schema "{\"x\": \"1\", \"y\": 2, \"label\": null}")
    ),
    Test.test "not an object" (fun () ->
      Test.equal "(root): expected an object, got an array" (decoded Point.schema "[1, 2]")
    ),
    Test.test "an unknown variant" (fun () ->
      Test.equal
        "_tag: expected one of Circle, Rect, Dot"
        (decoded Shape.schema "{\"_tag\": \"Oval\"}")
    ),
    Test.test "a missing field of a variant" (fun () ->
      Test.equal "_1: a missing key" (decoded Shape.schema "{\"_tag\": \"Rect\", \"_0\": 1}")
    ),
    Test.test "nested paths" (fun () ->
      Test.equal
        "items[1].qty: expected an Int, got boolean"
        (decoded
          Order.schema
          (String.replace_all
            "[{\"sku\": \"a\", \"qty\": 1}]"
            "[{\"sku\": \"a\", \"qty\": 1}, {\"sku\": \"b\", \"qty\": true}]"
            order))
    ),
    Test.test "a record stops at its first issue" (fun () ->
      Test.equal
        "id: expected a string of digits"
        (decoded
          Order.schema
          (String.replace_all "true" "1" (String.replace_all "\"1\"" "\"x\"" order)))
    ),
    Test.test "a result" (fun () ->
      Test.equal
        "paid: expected an object with `ok` or `err`, got number"
        (decoded Order.schema (String.replace_all "{\"ok\": true}" "5" order))
    ),
    Test.test "invalid JSON" (fun () ->
      Test.equal
        "not JSON: Expected double-quoted property name in JSON at position 8 (line 1 column 9)"
        (decoded Point.schema "{\"x\": 1,")
    ),
  ],
  Test.group "refined" [
    Test.test "accepts a valid value" (fun () -> Test.equal "ok 8080" (decoded Port.schema "8080")),
    Test.test "rejects an invalid value" (fun () ->
      Test.equal "(root): not a valid Port" (decoded Port.schema "70000")
    ),
  ],
  Test.group "payload-free constructors" [
    Test.test "decode matches, equals, and shows" (fun () ->
      let shape_result = decode_value Shape.schema "{\"_tag\": \"Dot\"}"
      let color_result = decode_value Color.schema "{\"_tag\": \"Green\"}"
      let tree_result =
        decode_value
          Tree.schema
          "{\"_tag\": \"Node\", \"_0\": {\"_tag\": \"Leaf\"}, \"_1\": \"mid\", \"_2\": {\"_tag\": \"Leaf\"}}"
      let shape_label =
        match shape_result with
        | Ok Dot -> "dot"
        | Ok (Circle _) -> "circle"
        | Ok (Rect _ _) -> "rect"
        | Err _ -> "err"
      let color_label =
        match color_result with
        | Ok Red -> "red"
        | Ok Green -> "green"
        | Ok Blue -> "blue"
        | Err _ -> "err"
      let tree_label =
        match tree_result with
        | Ok (Node Leaf s Leaf) -> s
        | Ok Leaf | Ok (Node _ _ _) | Err _ -> "other"
      Test.all [
        Test.equal "dot" shape_label,
        Test.equal (Ok Dot) shape_result,
        Test.equal "Ok Dot" (show shape_result),
        Test.equal "green" color_label,
        Test.equal (Ok Green) color_result,
        Test.equal "Ok Green" (show color_result),
        Test.equal "mid" tree_label,
        Test.equal (Ok (Node Leaf "mid" Leaf)) tree_result,
        Test.equal "Ok (Node Leaf \"mid\" Leaf)" (show tree_result),
      ]
    ),
    Test.property
      "Schema.arbitrary of all-nullary Color matches, compares, shows, and round-trips"
      (Schema.arbitrary Color.schema)
      (fun c ->
        let expected =
          match c with
          | Red -> ("Red", c == Red)
          | Green -> ("Green", c == Green)
          | Blue -> ("Blue", c == Blue)
        let (name, same) = expected
        Test.all [
          Test.equal true same,
          Test.equal name (show c),
          Test.equal
            ("ok {\"_tag\":\"" ++ name ++ "\"}")
            (decoded Color.schema (encoded Color.schema c)),
        ]
      ),
    Test.property
      "Schema.arbitrary of Shape handles payload-free Dot"
      (Schema.arbitrary Shape.schema)
      (fun s ->
        let checked =
          match s with
          | Dot -> s == Dot && show s == "Dot" && encoded Shape.schema s == "{\"_tag\":\"Dot\"}"
          | Circle _ | Rect _ _ -> decode_value Shape.schema (encoded Shape.schema s) == Ok s
        Test.is_true (show s) checked
      ),
  ],
  Test.group "scalar-field constructors" [
    Test.test "decode, match, equal, hash, and show" (fun () ->
      let entry_res =
        decode_value
          Entry.schema
          "{\"_tag\": \"Entry\", \"_0\": -42, \"_1\": 3.25, \"_2\": true, \"_3\": \"ok\"}"
      let mixed_res =
        decode_value
          Entry.schema
          "{\"_tag\": \"Mixed\", \"_0\": false, \"_1\": 7, \"_2\": 9, \"_3\": \"hi\"}"
      let expected_entry = Entry (-42) 3.25 true "ok"
      let expected_mixed = Mixed false (Some 7) 9 "hi"
      let entry_summary =
        match entry_res with
        | Ok (Entry i f b s) -> show i ++ ":" ++ show f ++ ":" ++ show b ++ ":" ++ s
        | _ -> "other"
      Test.all [
        Test.equal "-42:3.25:true:ok" entry_summary,
        Test.equal (Ok expected_entry) entry_res,
        Test.equal (Ok expected_mixed) mixed_res,
        Test.equal "Ok (Entry -42 3.25 true \"ok\")" (show entry_res),
        Test.equal
          "{\"_tag\":\"Entry\",\"_0\":-42,\"_1\":3.25,\"_2\":true,\"_3\":\"ok\"}"
          (encoded Entry.schema expected_entry),
        Test.equal
          "{\"_tag\":\"Mixed\",\"_0\":false,\"_1\":7,\"_2\":9,\"_3\":\"hi\"}"
          (encoded Entry.schema expected_mixed),
      ]
    ),
    Test.property
      "Schema.arbitrary of scalar-field ScalarVal round-trips and preserves equality"
      (Schema.arbitrary ScalarVal.schema)
      (fun v ->
        match decode_value ScalarVal.schema (encoded ScalarVal.schema v) with
        | Ok d ->
          Test.all [
            Test.equal true (v == d),
            Test.equal true (eq v d),
            Test.equal EQ (compare v d),
            Test.equal (hash v) (hash d),
            Test.equal (encoded ScalarVal.schema v) (encoded ScalarVal.schema d),
          ]
        | Err err -> Test.is_true ("decode failed: " ++ show err) false
      ),
  ],
]
