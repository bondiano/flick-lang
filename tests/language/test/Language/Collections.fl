// Lists, options, results and hash collections. A hash map or set is
// ordered by the hashes of its keys, five bits at a time from the lowest,
// so the hashes of strings, numbers and records must agree across targets.
module Language.Collections exposing (tests)

type alias Person = { name : String; age : Int }

people : List Person
let people = [
  { name = "ann"; age = 30 },
  { name = "bob"; age = 25 },
  { name = "cid"; age = 30 },
  { name = "dee"; age = 25 },
]

words : List String
let words = ["pear", "apple", "fig", "kiwi", "plum", "lime", "\u{1F600}", "äpfel"]

tests : List Test.Test
let tests = [
  Test.group "lists" [
    Test.test "sort_by is stable" (fun () ->
      Test.equal
        ["bob", "dee", "ann", "cid"]
        (List.map (fun p -> p.name) (List.sort_with (fun p -> p.age) people))
    ),
    Test.test "range is half open" (fun () ->
      Test.equal ([0, 1, 2], []) (List.range 0 3, List.range 3 0)
    ),
    Test.test "get" (fun () ->
      Test.equal [Some "pear", None, None] [List.get 0 words, List.get 8 words, List.get (-1) words]
    ),
    Test.test "slice" (fun () -> Test.equal ["fig", "kiwi"] (List.slice 2 4 words)),
    Test.test "zip stops at the shorter" (fun () ->
      Test.equal [(1, "a"), (2, "b")] (List.zip [1, 2, 3] ["a", "b"])
    ),
    Test.test "dedupe keeps the first" (fun () ->
      Test.equal [3, 1, 2] (List.dedupe [3, 1, 3, 2, 1])
    ),
    Test.test "sort_by a comparison" (fun () ->
      Test.equal
        ["ann", "cid", "bob", "dee"]
        (List.map (fun p -> p.name) (List.sort_by (fun a b -> compare b.age a.age) people))
    ),
    Test.test "fold_right" (fun () ->
      Test.equal "abc" (List.fold_right (fun x acc -> x ++ acc) "" ["a", "b", "c"])
    ),
    Test.test "list comprehension" (fun () ->
      Test.equal [(1, "a"), (2, "a")] [for n <- [1, 2, 3]; s <- ["a"] if n < 3 yield (n, s)]
    ),
    Test.test "sort of strings by code units" (fun () ->
      Test.equal
        ["Z", "a", "ä", "\u{1F600}", "\u{FF61}"]
        (List.sort ["\u{1F600}", "a", "\u{FF61}", "Z", "ä"])
    ),
  ],
  Test.group "options and results" [
    Test.test "Option.map and with_default" (fun () ->
      Test.equal [2, 0] [
        Option.with_default 0 (Option.map (fun x -> x + 1) (Some 1)),
        Option.with_default 0 (Option.map (fun x -> x + 1) None),
      ]
    ),
    Test.test "Option.bind" (fun () ->
      Test.equal (Some 3) (Option.bind (fun x -> if x > 1 then Some (x + 1) else None) (Some 2))
    ),
    Test.test "Result.map_err" (fun () ->
      Test.equal (Err 4) (Result.map_err String.length (Err "four" : Result String Int))
    ),
    Test.test "Result.bind short-circuits" (fun () ->
      Test.equal
        (Err "first")
        (Result.bind
          (fun x -> if x > 0 then Ok x else Err "second")
          (Err "first" : Result String Int))
    ),
    Test.test "do over options" (fun () ->
      Test.equal
        (Some 5)
        (do {
          a <- Some 2
          b <- Some 3
          pure (a + b)
        })
    ),
  ],
  Test.group "hash order" [
    Test.test "string keys" (fun () ->
      Test.equal
        "[\"plum\", \"pear\", \"lime\", \"apple\", \"fig\", \"😀\", \"kiwi\", \"äpfel\"]"
        (show (HashSet.to_list (HashSet.from_list EqHash.canonical words)))
    ),
    Test.test "integer keys" (fun () ->
      Test.equal
        [0, 32, 64, 1, 33, 2, 3]
        (HashSet.to_list (HashSet.from_list EqHash.canonical [64, 33, 32, 3, 2, 1, 0]))
    ),
    Test.test "float keys" (fun () ->
      Test.equal
        "[3, 0.5, 1e+21, -1]"
        (show (HashSet.to_list (HashSet.from_list EqHash.canonical [0.5, 3.0, -1.0, 1e21])))
    ),
    Test.test "record keys" (fun () ->
      Test.equal
        ["ann", "dee", "cid", "bob"]
        (List.map (fun p -> p.name) (HashSet.to_list (HashSet.from_list EqHash.canonical people)))
    ),
    Test.test "replacing keeps the place" (fun () ->
      let m = HashMap.from_list EqHash.canonical [("a", 1), ("b", 2), ("c", 3)]
      Test.equal (HashMap.keys m) (HashMap.keys (HashMap.insert "b" 20 m))
    ),
    Test.test "hash values" (fun () ->
      Test.equal [5381, 0, -182423092, 177629] [hash "", hash 0, hash 1.5, hash (Some "x")]
    ),
  ],
  Test.group "hash seq" [
    Test.test "empty map and set sequences" (fun () ->
      let empty_map : HashMap.HashMap EqHash.Canonical Int String = HashMap.empty
      let empty_set : HashSet.HashSet EqHash.Canonical Int = HashSet.empty
      let built_map : HashMap.HashMap EqHash.Canonical Int String =
        HashMap.from_seq EqHash.canonical Seq.empty
      let built_set : HashSet.HashSet EqHash.Canonical Int =
        HashSet.from_seq EqHash.canonical Seq.empty
      Test.equal ([], None, [], None, true, 0, true, 0) (
        Seq.to_list (HashMap.to_seq empty_map),
        Seq.first (HashMap.to_seq empty_map),
        Seq.to_list (HashSet.to_seq empty_set),
        Seq.first (HashSet.to_seq empty_set),
        HashMap.is_empty built_map,
        HashMap.size built_map,
        HashSet.is_empty built_set,
        HashSet.size built_set,
      )
    ),
    Test.test "repeat and partial traversal preserve walk order" (fun () ->
      let m = HashMap.from_seq EqHash.canonical (for { n <- Seq.range 0 40 } yield (n, n * 10))
      let s = HashSet.from_seq EqHash.canonical (Seq.range 0 40)
      let ms = HashMap.to_seq m
      let ss = HashSet.to_seq s
      let first_five = [(0, 0), (32, 320), (1, 10), (33, 330), (2, 20)]
      let mut broken : List Int = []
      for x <- ss do {
        if List.length broken == 4 then break
        broken = broken ++ [x]
      }
      Test.equal
        (
          [],
          Some (0, 0),
          first_five,
          first_five,
          [((0, 0), (0, 0)), ((32, 320), (32, 320)), ((1, 10), (1, 10))],
          HashMap.to_list m,
          [0, 32, 1, 33],
          [0, 32, 1, 33, 2, 34],
          HashSet.to_list s,
        )
        (
          Seq.to_list (Seq.take 0 ms),
          Seq.first ms,
          Seq.to_list (Seq.take 5 ms),
          Seq.to_list (Seq.take 5 ms),
          Seq.to_list (Seq.take 3 (Seq.zip ms ms)),
          Seq.to_list ms,
          broken,
          Seq.to_list (Seq.take 6 ss),
          Seq.to_list ss,
        )
    ),
    Test.test "collisions keep bucket and insertion order in to_seq" (fun () ->
      let constant_hash =
        EqHash.with (fun a b -> a == b) (fun _ -> 7) (fun w ->
          let m =
            HashMap.from_seq
              w
              (Seq.of_list [("first", 1), ("second", 2), ("third", 3), ("fourth", 4)])
          let replaced = HashMap.insert "second" 20 m
          (
            Seq.to_list (Seq.take 2 (HashMap.to_seq m)),
            Seq.to_list (HashMap.to_seq replaced),
          )
        )
      let thirds =
        EqHash.with (fun a b -> a == b) (fun n -> n % 3) (fun w ->
          let s = HashSet.from_seq w (Seq.of_list [7, 4, 1, 9, 6, 2, 5, 8, 3])
          (Seq.to_list (Seq.take 4 (HashSet.to_seq s)), Seq.to_list (HashSet.to_seq s))
        )
      Test.equal
        (
          (
            [("first", 1), ("second", 2)],
            [("first", 1), ("second", 20), ("third", 3), ("fourth", 4)],
          ),
          ([9, 6, 3, 7], [9, 6, 3, 7, 4, 1, 2, 5, 8]),
        )
        (constant_hash, thirds)
    ),
    Test.test "custom witnesses, duplicates, and from_seq on lazy sequences" (fun () ->
      let result =
        EqHash.with
          (fun a b -> String.to_lower a == String.to_lower b)
          (fun s -> hash (String.to_lower s))
          (fun w ->
            let map_input = for {
              pair <- Seq.of_list [("A", 1), ("b", 2), ("a", 10), ("B", 20), ("c", 3)]
            } yield pair
            let m = HashMap.from_seq w map_input
            let merged = HashMap.union m (HashMap.insert "C" 30 (HashMap.with w))
            let set_input =
              Seq.unfold
                (fun xs ->
                  match xs with
                  | [] -> None
                  | [head, ...tail] -> Some (head, tail)
                )
                ["Ada", "ada", "Bob", "BOB", "Cid"]
            let s = HashSet.from_seq w set_input
            let merged_set = HashSet.union s (HashSet.insert "CID" (HashSet.with w))
            (
              HashMap.size m,
              HashMap.get "A" m,
              HashMap.get "b" m,
              HashMap.get "c" merged,
              List.sort (Seq.to_list (HashMap.to_seq m)),
              HashSet.size s,
              HashSet.size merged_set,
              HashSet.member "ADA" s,
              List.sort (Seq.to_list (HashSet.to_seq s)),
            )
          )
      Test.equal
        (
          3,
          Some 10,
          Some 20,
          Some 30,
          [("B", 20), ("a", 10), ("c", 3)],
          3,
          3,
          true,
          ["Ada", "Bob", "Cid"],
        )
        result
    ),
    Test.test "persistent snapshots stay isolated across inserts and removals" (fun () ->
      let m0 =
        HashMap.from_seq
          EqHash.canonical
          (Seq.of_list [(0, "zero"), (32, "thirty-two"), (1, "one"), (2, "two")])
      let seq0 = HashMap.to_seq m0
      let prefix_before = Seq.to_list (Seq.take 2 seq0)
      let m1 = HashMap.insert 33 "thirty-three" (HashMap.insert 0 "ZERO" (HashMap.remove 32 m0))
      let s0 = HashSet.from_seq EqHash.canonical (Seq.of_list [0, 32, 1, 2])
      let sseq0 = HashSet.to_seq s0
      let set_before = Seq.to_list (Seq.take 2 sseq0)
      let s1 = HashSet.insert 33 (HashSet.remove 32 s0)
      Test.equal
        (
          [(0, "zero"), (32, "thirty-two")],
          [(0, "zero"), (32, "thirty-two"), (1, "one"), (2, "two")],
          [(0, "ZERO"), (1, "one"), (33, "thirty-three"), (2, "two")],
          [0, 32],
          [0, 32, 1, 2],
          [0, 1, 33, 2],
        )
        (
          prefix_before,
          Seq.to_list seq0,
          Seq.to_list (HashMap.to_seq m1),
          set_before,
          Seq.to_list sseq0,
          Seq.to_list (HashSet.to_seq s1),
        )
    ),
  ],
]
