// Lists, options, results and hash collections. A hash map or set is
// ordered by the hashes of its keys, five bits at a time from the lowest,
// so the hashes of strings, numbers and records must agree across targets.
module Language.Collections exposing (tests)

type alias Person = { name : String; age : Int }

people : List Person
let people = [
  { name = "ann"; age = 30 },
  { name = "bob"; age = 25 },
  { name = "cid"; age = 30 },
  { name = "dee"; age = 25 },
]

words : List String
let words = ["pear", "apple", "fig", "kiwi", "plum", "lime", "\u{1F600}", "äpfel"]

tests : List Test.Test
let tests = [
  Test.group "lists" [
    Test.test "sort_by is stable" (fun () ->
      Test.equal
        ["bob", "dee", "ann", "cid"]
        (List.map (fun p -> p.name) (List.sort_with (fun p -> p.age) people))
    ),
    Test.test "range is half open" (fun () ->
      Test.equal ([0, 1, 2], []) (List.range 0 3, List.range 3 0)
    ),
    Test.test "get" (fun () ->
      Test.equal [Some "pear", None, None] [List.get 0 words, List.get 8 words, List.get (-1) words]
    ),
    Test.test "slice" (fun () -> Test.equal ["fig", "kiwi"] (List.slice 2 4 words)),
    Test.test "zip stops at the shorter" (fun () ->
      Test.equal [(1, "a"), (2, "b")] (List.zip [1, 2, 3] ["a", "b"])
    ),
    Test.test "dedupe keeps the first" (fun () ->
      Test.equal [3, 1, 2] (List.dedupe [3, 1, 3, 2, 1])
    ),
    Test.test "sort_by a comparison" (fun () ->
      Test.equal
        ["ann", "cid", "bob", "dee"]
        (List.map (fun p -> p.name) (List.sort_by (fun a b -> compare b.age a.age) people))
    ),
    Test.test "fold_right" (fun () ->
      Test.equal "abc" (List.fold_right (fun x acc -> x ++ acc) "" ["a", "b", "c"])
    ),
    Test.test "list comprehension" (fun () ->
      Test.equal [(1, "a"), (2, "a")] [for n <- [1, 2, 3]; s <- ["a"] if n < 3 yield (n, s)]
    ),
    Test.test "sort of strings by code units" (fun () ->
      Test.equal
        ["Z", "a", "ä", "\u{1F600}", "\u{FF61}"]
        (List.sort ["\u{1F600}", "a", "\u{FF61}", "Z", "ä"])
    ),
  ],
  Test.group "options and results" [
    Test.test "Option.map and with_default" (fun () ->
      Test.equal [2, 0] [
        Option.with_default 0 (Option.map (fun x -> x + 1) (Some 1)),
        Option.with_default 0 (Option.map (fun x -> x + 1) None),
      ]
    ),
    Test.test "Option.bind" (fun () ->
      Test.equal (Some 3) (Option.bind (fun x -> if x > 1 then Some (x + 1) else None) (Some 2))
    ),
    Test.test "Result.map_err" (fun () ->
      Test.equal (Err 4) (Result.map_err String.length (Err "four" : Result String Int))
    ),
    Test.test "Result.bind short-circuits" (fun () ->
      Test.equal
        (Err "first")
        (Result.bind
          (fun x -> if x > 0 then Ok x else Err "second")
          (Err "first" : Result String Int))
    ),
    Test.test "do over options" (fun () ->
      Test.equal
        (Some 5)
        (do {
          a <- Some 2
          b <- Some 3
          pure (a + b)
        })
    ),
  ],
  Test.group "hash order" [
    Test.test "string keys" (fun () ->
      Test.equal
        "[\"plum\", \"pear\", \"lime\", \"apple\", \"fig\", \"😀\", \"kiwi\", \"äpfel\"]"
        (show (HashSet.to_list (HashSet.from_list EqHash.canonical words)))
    ),
    Test.test "integer keys" (fun () ->
      Test.equal
        [0, 32, 64, 1, 33, 2, 3]
        (HashSet.to_list (HashSet.from_list EqHash.canonical [64, 33, 32, 3, 2, 1, 0]))
    ),
    Test.test "float keys" (fun () ->
      Test.equal
        "[3, 0.5, 1e+21, -1]"
        (show (HashSet.to_list (HashSet.from_list EqHash.canonical [0.5, 3.0, -1.0, 1e21])))
    ),
    Test.test "record keys" (fun () ->
      Test.equal
        ["ann", "dee", "cid", "bob"]
        (List.map (fun p -> p.name) (HashSet.to_list (HashSet.from_list EqHash.canonical people)))
    ),
    Test.test "replacing keeps the place" (fun () ->
      let m = HashMap.from_list EqHash.canonical [("a", 1), ("b", 2), ("c", 3)]
      Test.equal (HashMap.keys m) (HashMap.keys (HashMap.insert "b" 20 m))
    ),
    Test.test "hash values" (fun () ->
      Test.equal [5381, 0, -182423092, 177629] [hash "", hash 0, hash 1.5, hash (Some "x")]
    ),
  ],
]
