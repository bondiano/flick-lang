// Property tests: laws that hold for every generated value, and the cases
// themselves. Each case draws from a generator seeded by the run's seed
// and its index, so a seed gives the same values on every target: the
// group "cases of --seed 42" lists them, and fails under another seed.
module Language.Properties exposing (tests)

/// A sorted list.
sorted : List Int -> Bool
let rec sorted xs =
  match xs with
  | [a, b, ...rest] -> a <= b && sorted ([b] ++ rest)
  | _ -> true

/// The BigInt of an Int.
big : Int -> BigInt
let big n = BigInt.from_number (Int.to_float n) |> Option.with_default 0n

/// Passes when `x` is one of `cases`.
one_of_cases : (Eq a, Show a) => List a -> a -> Test.Assertion
let one_of_cases cases x =
  Test.is_true ("not a case of --seed 42: " ++ show x) (List.contains x cases)

