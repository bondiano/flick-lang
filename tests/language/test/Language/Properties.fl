tests : List Test.Test
let tests =
  [
    Test.group
      "laws"
      [
        Test.property
          "reverse twice"
          (Gen.list 20 (Gen.int (-100) 100))
          (fun xs -> Test.equal xs (List.reverse (List.reverse xs))),
        Test.property
          "sort orders and keeps the length"
          (Gen.list 20 (Gen.int (-100) 100))
          (fun xs ->
          let s = List.sort xs
          Test.all [Test.is_true "sorted" (sorted s), Test.equal (List.length xs) (List.length s)]),
        Test.property
          "Int addition wraps like two's complement"
          (Gen.pair (Gen.int (-2147483648) 2147483647) (Gen.int (-2147483648) 2147483647))
          (fun (a, b) -> Test.equal (a + b - b) a),
        Test.property
          "division and remainder"
          (Gen.pair (Gen.int (-1000) 1000) (Gen.int 1 50))
          (fun (a, b) -> Test.equal a (a / b * b + a % b)),
        Test.property
          "strings join back"
          (Gen.list 5 (Gen.string 8))
          (fun parts ->
            Test.equal (String.join "" parts) (String.join "" (List.map (fun p -> p) parts))),
        Test.property
          "split and join"
          (Gen.string 20)
          (fun s -> Test.equal s (String.join "," (String.split "," s))),
        Test.property
          "a number in its range"
          (Gen.number (-1.5) 2.5)
          (fun x -> Test.is_true (show x) (x >= -1.5 && x < 2.5)),
        Test.property
          "an integer in its range"
          (Gen.int 3 5)
          (fun n -> Test.is_true (show n) (n >= 3 && n <= 5)),
        Test.property
          "functions are pure"
          (Gen.function (Gen.int 0 1000))
          (fun f -> Test.equal (f "x") (f "x")),
        Test.property
          "show and parse"
          (Gen.int (-100000) 100000)
          (fun n -> Test.equal (Some n) (Int.parse (show n))),
        Test.property
          "BigInt and Int agree"
          (Gen.pair (Gen.int (-46340) 46340) (Gen.int (-46340) 46340))
          (fun (a, b) -> Test.equal (big (a * b)) (big a * big b)),
      ],
    Test.group
      "cases of --seed 42"
      [
        Test.property "Gen.int" (Gen.int (-1000000) 1000000) (one_of_cases int_cases),
        Test.property "Gen.number" (Gen.number (-1) 1) (one_of_cases number_cases),
        Test.property "Gen.string" (Gen.string 6) (one_of_cases string_cases),
        Test.property
          "Gen.list of Gen.one_of"
          (Gen.list 4 (Gen.one_of ["a", "b", "c"]))
          (one_of_cases list_cases),
        Test.property
          "Gen.function by the hash of its argument"
          (Gen.function (Gen.int 0 99))
          (fun f -> one_of_cases function_cases [f "a", f "b", f "\u{1F600}"]),
      ],
  ]
