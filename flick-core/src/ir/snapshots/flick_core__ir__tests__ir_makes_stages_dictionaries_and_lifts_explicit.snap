module App
constructor App.NotFound.NotFound/1
service Users = App.Users
constructor App.Shape.Circle/1
constructor App.Shape.Square/1
let render [Show a] = (fun value -> (?Show a.show value))
let load = (fun id! -> { let name = (try (App.Users.get id)! | (NotFound _) -> "?"); (Platform.stdout_line ((App.render[<Show Int>] 1) ++ name))!; name })
let twice = (fun f x! -> (f (f x)!)!)
let inc = (fun x -> (x + 1))
let run = (fun ()! -> ((App.twice (lift(!) App.inc)) 1)!)
let pick = (fun o -> (match o | (Some (1 | 2)) -> 0 | (Some n) when (n > 3) -> n | _ -> (-1)))
instance Eq Shape derived [<Eq Float>, <Eq Float>]
  eq = (fun a b -> (match a | (Circle x0_0) -> (match b | (Circle y0_0) -> ((<Eq Float>.eq x0_0) y0_0) | _ -> false) | (Square x1_0) -> (match b | (Square y1_0) -> ((<Eq Float>.eq x1_0) y1_0) | _ -> false)))
