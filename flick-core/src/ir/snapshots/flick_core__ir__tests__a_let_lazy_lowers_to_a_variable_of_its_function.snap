module App
constructor App.Boom.Boom/0
let load = (fun n! -> (if (n < 0) then (Fail.fail Boom)! else n))
let run = (fun flag! -> { let mut x = (task (try (Ok { let t = (App.load 1)!; (t + 1) }) | $error -> (Err $error))); let mut y = (task (try (Ok (App.load 2)!) | $error$1 -> (Err $error$1))); y := { let $written = 3; (task (Ok $written)) }; (if flag then ({ let $outcome = (await !x); x := (task $outcome); (Prelude.from_result $outcome)! } + { let $outcome$1 = (await !y); y := (task $outcome$1); (Prelude.from_result $outcome$1)! }) else { let $outcome$2 = (await !x); x := (task $outcome$2); (Prelude.from_result $outcome$2)! }) })
