module App
constructor App.Boom.Boom/0
let load = (fun n! -> (if (n < 0) then (Fail.fail Boom)! else n))
let run = (fun flag! -> { let x$run = (task (try (Ok { let t = (App.load 1)!; (t + 1) }) | $error -> (Err $error))); let mut x = None; let y$run = (task (try (Ok (App.load 2)!) | $error$1 -> (Err $error$1))); let mut y = None; y := (Some (Ok 3)); (if flag then ((Prelude.from_result (match !x | (Some $kept) -> $kept | _ -> { let $outcome = (await x$run); x := (Some $outcome); $outcome }))! + (Prelude.from_result (match !y | (Some $kept$1) -> $kept$1 | _ -> { let $outcome$1 = (await y$run); y := (Some $outcome$1); $outcome$1 }))!) else (Prelude.from_result (match !x | (Some $kept$2) -> $kept$2 | _ -> { let $outcome$2 = (await x$run); x := (Some $outcome$2); $outcome$2 }))!) })
