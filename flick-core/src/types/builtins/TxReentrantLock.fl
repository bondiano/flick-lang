/// Effect's `TxReentrantLock`: a read/write lock over transactional
/// state. Many fibers may hold the read lock, one the write lock, and a
/// fiber may take a lock it already holds again.
module TxReentrantLock exposing (..)

/// A transactional read/write lock.
type TxReentrantLock

/// A new lock, not held.
make : Unit ->{} TxReentrantLock
foreign effect make from "@flick-lang/runtime/effect/TxReentrantLock" "make"
  arity 0
  reviewed "effect@4.0.5 sha256:917b23a5e9f4a929"

/// Takes the read lock once more, waiting while another fiber writes; the
/// fiber's read count.
acquire_read : TxReentrantLock ->{Tx.Transaction;} Number
foreign effect acquire_read from "@flick-lang/runtime/effect/TxReentrantLock" "acquireRead"
  reviewed "effect@4.0.5 sha256:c6df9f0afe74b624"

/// Takes the write lock once more, waiting while another fiber holds the
/// lock; the fiber's write count.
acquire_write : TxReentrantLock ->{Tx.Transaction;} Number
foreign effect acquire_write from "@flick-lang/runtime/effect/TxReentrantLock" "acquireWrite"
  reviewed "effect@4.0.5 sha256:52a7f11c2bd83a3f"

/// Gives back one read of the fiber; its read count left.
release_read : TxReentrantLock ->{Tx.Transaction;} Number
foreign effect release_read from "@flick-lang/runtime/effect/TxReentrantLock" "releaseRead"
  reviewed "effect@4.0.5 sha256:c64cede8ab76ef39"

/// Gives back one write of the fiber; its write count left.
release_write : TxReentrantLock ->{Tx.Transaction;} Number
foreign effect release_write from "@flick-lang/runtime/effect/TxReentrantLock" "releaseWrite"
  reviewed "effect@4.0.5 sha256:a43d50d417e7e793"

/// Holds the read lock until the scope of region `s` closes.
read_lock : forall s. TxReentrantLock ->{Scope s;} Number
foreign effect read_lock from "@flick-lang/runtime/effect/TxReentrantLock" "readLock"
  reviewed "effect@4.0.5 sha256:354f2f76d383630a"

/// Holds the write lock until the scope of region `s` closes.
write_lock : forall s. TxReentrantLock ->{Scope s;} Number
foreign effect write_lock from "@flick-lang/runtime/effect/TxReentrantLock" "writeLock"
  reviewed "effect@4.0.5 sha256:cbc38353299ca90d"

/// Runs `body` holding the read lock.
with_read_lock : forall c r e a. (Eff r e a)^c -> (TxReentrantLock ->{r; e} a)^c
foreign effect with_read_lock from "@flick-lang/runtime/effect/TxReentrantLock" "withReadLock"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:a080c94a792a5892"

/// Runs `body` holding the write lock.
with_write_lock : forall c r e a. (Eff r e a)^c -> (TxReentrantLock ->{r; e} a)^c
foreign effect with_write_lock from "@flick-lang/runtime/effect/TxReentrantLock" "withWriteLock"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:fa9e9410181f8d01"

/// Runs `body` holding the write lock, as `with_write_lock`.
with_lock : forall c r e a. (Eff r e a)^c -> (TxReentrantLock ->{r; e} a)^c
foreign effect with_lock from "@flick-lang/runtime/effect/TxReentrantLock" "withLock"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:bd45c10dc77569d9"

/// The number of reads held, by every fiber.
read_locks : TxReentrantLock ->{Tx.Transaction;} Number
foreign effect read_locks from "@flick-lang/runtime/effect/TxReentrantLock" "readLocks"
  reviewed "effect@4.0.5 sha256:3266db62ff2d9b74"

/// The number of writes held.
write_locks : TxReentrantLock ->{Tx.Transaction;} Number
foreign effect write_locks from "@flick-lang/runtime/effect/TxReentrantLock" "writeLocks"
  reviewed "effect@4.0.5 sha256:178e956879b80425"

/// Whether a fiber holds the lock, to read or to write.
locked : TxReentrantLock ->{Tx.Transaction;} Bool
foreign effect locked from "@flick-lang/runtime/effect/TxReentrantLock" "locked"
  reviewed "effect@4.0.5 sha256:21fbe39a5e39f7c5"

/// Whether a fiber holds the read lock.
read_locked : TxReentrantLock ->{Tx.Transaction;} Bool
foreign effect read_locked from "@flick-lang/runtime/effect/TxReentrantLock" "readLocked"
  reviewed "effect@4.0.5 sha256:21075991c8ea4b09"

/// Whether a fiber holds the write lock.
write_locked : TxReentrantLock ->{Tx.Transaction;} Bool
foreign effect write_locked from "@flick-lang/runtime/effect/TxReentrantLock" "writeLocked"
  reviewed "effect@4.0.5 sha256:acb9caf1b2933997"
