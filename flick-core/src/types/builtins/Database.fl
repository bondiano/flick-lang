/// Runs `Sql` queries: `query` returns the rows, `execute` the number of
/// rows changed. `pg` connects to PostgreSQL through a pool of `pg`
/// connections, closed with the scope of the `provide`.
module Database exposing (..)

service Database =
  run_query : forall a. Sql.Query Sql.Pg a ->{; Sql.EncodeError, Sql.DbError, Sql.DecodeError}
    List a
  run_execute : forall a. Sql.Query Sql.Pg a ->{; Sql.EncodeError, Sql.DbError} Float

query : forall a. Sql.Query Sql.Pg a ->{Database; Sql.EncodeError, Sql.DbError, Sql.DecodeError}
  List a
let query q = Database.run_query q

execute : forall a. Sql.Query Sql.Pg a ->{Database; Sql.EncodeError, Sql.DbError} Float
let execute q = Database.run_execute q

/// Where and how many connections at most.
type alias PgConfig = { connection_string : String; max_connections : Float }

pg_layer : ServiceTag {Database} -> PgConfig -> Layer none none {Database}
foreign pure pg_layer from "@flick-lang/runtime/sql" "pgLayer"

/// A pool of PostgreSQL connections. An interrupted query is not rolled
/// back; its connection is closed, never returned to the pool.
pg : PgConfig -> Layer none none {Database}
let pg config = pg_layer Database config
