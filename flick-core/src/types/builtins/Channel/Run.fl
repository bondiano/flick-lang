/// Running a channel that reads no upstream: collecting, folding, or
/// feeding a queue or hub. A runner needs the channel's services and fails
/// with its errors.
module Channel.Run exposing (..)

import Channel.Core exposing (..)

/// Every element, in order.
run_collect : forall r e i o d c. (Channel r e i o d none Unit)^c ->{r; e} List o
foreign effect run_collect from "@flick-lang/runtime/effect/Channel" "runCollect"
  retention call
  reviewed "effect@4.0.5 sha256:a579a781daa25c53"

/// The number of elements.
run_count : forall r e i o d c. (Channel r e i o d none Unit)^c ->{r; e} Int
foreign effect run_count from "@flick-lang/runtime/effect/Channel" "runCount"
  retention call
  reviewed "effect@4.0.5 sha256:92bd1128b972ff79"

/// Runs the channel for its effects; its done value.
run_drain : forall r e i o d c. (Channel r e i o d none Unit)^c ->{r; e} d
foreign effect run_drain from "@flick-lang/runtime/effect/Channel" "runDrain"
  retention call
  reviewed "effect@4.0.5 sha256:f87d19b55e46b366"

/// The first element, if any; the rest is not pulled.
run_head : forall r e i o d c. (Channel r e i o d none Unit)^c ->{r; e} Option o
foreign effect run_head from "@flick-lang/runtime/effect/Channel" "runHead"
  retention call
  reviewed "effect@4.0.5 sha256:c9501f65006cd8ab"

/// The last element, if any.
run_last : forall r e i o d c. (Channel r e i o d none Unit)^c ->{r; e} Option o
foreign effect run_last from "@flick-lang/runtime/effect/Channel" "runLast"
  retention call
  reviewed "effect@4.0.5 sha256:915b541bcee8f9fb"

/// Folds the elements from `initial` with `f`.
run_fold :
  forall z o r e i d c. (Unit -> z) -> (z -> o -> z) -> (Channel r e i o d none Unit)^c ->{r; e} z
foreign effect run_fold from "@flick-lang/runtime/effect/Channel" "runFold"
  arity 2
  retention call
  reviewed "effect@4.0.5 sha256:c27cd38796549ab6"

/// `run_fold` with a task for each step.
run_fold_effect :
  forall z o r2 e2 r e i d c.
  (Unit -> z) -> (z -> o ->{r2; e2} z) -> (Channel r e i o d none Unit)^c ->{r + r2; e + e2} z
foreign effect run_fold_effect from "@flick-lang/runtime/effect/Channel" "runFoldEffect"
  arity 2
  retention call
  reviewed "effect@4.0.5 sha256:19e47755d3d1221f"

/// Runs `f` on each element; the done value.
run_for_each :
  forall o r2 e2 r e i d c.
  (o ->{r2; e2} Unit) -> (Channel r e i o d none Unit)^c ->{r + r2; e + e2} d
foreign effect run_for_each from "@flick-lang/runtime/effect/Channel" "runForEach"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:5b2f4a8deae8de50"

/// Runs `f` on each element while it gives `True`.
run_for_each_while :
  forall o r2 e2 r e i d c.
  (o ->{r2; e2} Bool) -> (Channel r e i o d none Unit)^c ->{r + r2; e + e2} Unit
foreign effect run_for_each_while from "@flick-lang/runtime/effect/Channel" "runForEachWhile"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:87dea9b128efdb10"

/// The bytes of all the chunks, concatenated.
mk_uint8_array :
  forall r e i d c. (Channel r e i (NonEmpty.NonEmpty (List Int)) d none Unit)^c ->{r; e} List Int
foreign effect mk_uint8_array from "@flick-lang/runtime/effect/Channel" "flickMkUint8Array"
  retention call
  reviewed "effect@4.0.5 sha256:55b163c5f42bdbee"

/// Offers every element to the queue, then ends it, or fails it with the
/// channel's failure.
run_into_queue : forall e o r i d c. Queue.Queue e o -> (Channel r e i o d none Unit)^c ->{r;} Unit
foreign effect run_into_queue from "@flick-lang/runtime/effect/Channel" "runIntoQueue"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:e6579706bb27eb9c"

/// `run_into_queue` of the elements of each chunk.
run_into_queue_array :
  forall e o r i d c.
  Queue.Queue e o -> (Channel r e i (NonEmpty.NonEmpty o) d none Unit)^c ->{r;} Unit
foreign effect run_into_queue_array from "@flick-lang/runtime/effect/Channel" "runIntoQueueArray"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:fc83c8c3086c8860"

/// Runs the channel in the background of the innermost `scope` (or the
/// one of region `s`) into a queue with the options; the queue ends, or
/// fails, as the channel does, and is shut down when the scope closes.
to_queue :
  forall c s r e i o d. Buffer -> (Channel r e i o d none Unit)^c ->{Scope s | r;} Queue.Queue e o
foreign effect to_queue from "@flick-lang/runtime/effect/Channel" "flickToQueue"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:35bf155638ac3ccd"

/// `to_queue` of the elements of each chunk.
to_queue_array :
  forall c s r e i o d.
  Buffer -> (Channel r e i (NonEmpty.NonEmpty o) d none Unit)^c ->{Scope s | r;} Queue.Queue e o
foreign effect to_queue_array from "@flick-lang/runtime/effect/Channel" "flickToQueueArray"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:8d3912690d60c04a"

/// A hub's options for `to_pubsub`: its `capacity` (`None`: unbounded)
/// and strategy, the last `replay` messages for a new subscriber, and
/// whether the hub shuts down when the channel ends.
type alias HubOptions = {
  capacity : Option Int;
  strategy : Option Queue.Strategy;
  replay : Option Int;
  shutdownOnEnd : Bool;
}

/// Runs the channel in the background of the innermost `scope` (or the
/// one of region `s`), publishing its elements to a new hub.
to_pubsub :
  forall c s r e i o d.
  HubOptions -> (Channel r e i o d none Unit)^c ->{Scope s | r;} PubSub.PubSub o
foreign effect to_pubsub from "@flick-lang/runtime/effect/Channel" "flickToPubSub"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:f98bc48088216d95"

/// `to_pubsub` of the elements of each chunk.
to_pubsub_array :
  forall c s r e i o d.
  HubOptions -> (Channel r e i (NonEmpty.NonEmpty o) d none Unit)^c ->{Scope s | r;} PubSub.PubSub o
foreign effect to_pubsub_array from "@flick-lang/runtime/effect/Channel" "flickToPubSubArray"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:498f7380ef865025"

/// Publishes every element to the hub, shutting it down at the end when
/// `shutdownOnEnd`.
run_into_pubsub :
  forall o r e i d c.
  { shutdownOnEnd : Bool } -> PubSub.PubSub o -> (Channel r e i o d none Unit)^c ->{r; e} Unit
foreign effect run_into_pubsub from "@flick-lang/runtime/effect/Channel" "flickRunIntoPubSub"
  arity 2
  retention call
  reviewed "effect@4.0.5 sha256:1e2c1ae62a1426e7"

/// `run_into_pubsub` of the elements of each chunk; the done value.
run_into_pubsub_array :
  forall o r e i d c.
  { shutdownOnEnd : Bool } ->
  PubSub.PubSub o ->
  (Channel r e i (NonEmpty.NonEmpty o) d none Unit)^c ->{r; e}
  d
foreign effect run_into_pubsub_array from "@flick-lang/runtime/effect/Channel" "flickRunIntoPubSubArray"
  arity 2
  retention call
  reviewed "effect@4.0.5 sha256:8adf743b7375ba01"
