/// How a channel fails, ends, repeats and runs: recovery, finalizers,
/// merging, schedules, services and spans. Typed errors are `Errors e`; a
/// whole cause, defects included, is a `Failure e`.
module Channel.Control exposing (..)

import Channel.Core exposing (..)

/// Recovers from a typed error with the channel `f` builds of it; a
/// defect or an interruption is not recovered.
catch : (Errors e -> Channel r2 e2 i o d ie id) -> Channel r e i o d ie id -> Channel (r + r2) e2 i o d ie id
foreign pure catch from "@flick-lang/runtime/effect/Channel" "catch"
  arity 1
  reviewed "effect@4.0.5 sha256:73e4f3439d7f7730"

/// Recovers from any failure with the channel `f` builds of it.
catch_cause :
  (Failure e -> Channel r2 e2 i o d ie id) -> Channel r e i o d ie id -> Channel (r + r2) e2 i o d ie id
foreign pure catch_cause from "@flick-lang/runtime/effect/Channel" "flickCatchCause"
  arity 1
  reviewed "effect@4.0.5 sha256:147c2af27851edf5"

/// Runs `f` on a typed error, then fails with it.
tap_error : (Errors e ->{r2; e2} x) -> Channel r e i o d ie id -> Channel (r + r2) (e + e2) i o d ie id
foreign pure tap_error from "@flick-lang/runtime/effect/Channel" "tapError"
  arity 1
  reviewed "effect@4.0.5 sha256:755d233ba3282444"

/// Runs `f` on any failure, then fails with it.
tap_cause : (Failure e ->{r2; e2} x) -> Channel r e i o d ie id -> Channel (r + r2) (e + e2) i o d ie id
foreign pure tap_cause from "@flick-lang/runtime/effect/Channel" "flickTapCause"
  arity 1
  reviewed "effect@4.0.5 sha256:1f26049d7be48184"

/// Each typed error mapped by `f`.
map_error : (Errors e -> Errors e2) -> Channel r e i o d ie id -> Channel r e2 i o d ie id
foreign pure map_error from "@flick-lang/runtime/effect/Channel" "mapError"
  arity 1
  reviewed "effect@4.0.5 sha256:528e2866e0e4ffd3"

/// Ends instead of failing with a typed error.
ignore_ : Channel r e i o Unit ie id -> Channel r none i o Unit ie id
foreign pure ignore_ from "@flick-lang/runtime/effect/Channel" "ignore"
  reviewed "effect@4.0.5 sha256:299efd923cd0b43d"

/// Ends instead of failing in any way.
ignore_cause : Channel r e i o Unit ie id -> Channel r none i o Unit ie id
foreign pure ignore_cause from "@flick-lang/runtime/effect/Channel" "ignoreCause"
  reviewed "effect@4.0.5 sha256:d1d16bb3bc822969"

/// Runs the task when the channel ends, however it ends.
ensuring : Eff r2 none x -> Channel r e i o d ie id -> Channel (r + r2) e i o d ie id
foreign pure ensuring from "@flick-lang/runtime/effect/Channel" "ensuring"
  arity 1
  reviewed "effect@4.0.5 sha256:392968793dbade6c"

/// Runs `f` with the failure when the channel fails.
on_error : (Failure e ->{r2;} x) -> Channel r e i o d ie id -> Channel (r + r2) e i o d ie id
foreign pure on_error from "@flick-lang/runtime/effect/Channel" "flickOnError"
  arity 1
  reviewed "effect@4.0.5 sha256:9013037f080633da"

/// Runs `f` with how the channel ended.
on_exit : (Exit e d ->{r2;} x) -> Channel r e i o d ie id -> Channel (r + r2) e i o d ie id
foreign pure on_exit from "@flick-lang/runtime/effect/Channel" "flickOnExit"
  arity 1
  reviewed "effect@4.0.5 sha256:c0aefbd18d2a567b"

/// Runs the task before the channel starts.
on_start : Eff r2 e2 x -> Channel r e i o d ie id -> Channel (r + r2) (e + e2) i o d ie id
foreign pure on_start from "@flick-lang/runtime/effect/Channel" "onStart"
  arity 1
  reviewed "effect@4.0.5 sha256:13e06ad568f591f7"

/// Runs `f` on the first element.
on_first : (o ->{r2; e2} x) -> Channel r e i o d ie id -> Channel (r + r2) (e + e2) i o d ie id
foreign pure on_first from "@flick-lang/runtime/effect/Channel" "onFirst"
  arity 1
  reviewed "effect@4.0.5 sha256:c12e5cb7fd9f38fa"

/// Runs the task when the channel ends without failing.
on_end : Eff r2 e2 x -> Channel r e i o d ie id -> Channel (r + r2) (e + e2) i o d ie id
foreign pure on_end from "@flick-lang/runtime/effect/Channel" "onEnd"
  arity 1
  reviewed "effect@4.0.5 sha256:79cf3bb13c330306"

/// Interrupts the channel when the task ends first, ending with its value.
interrupt_when : Eff r2 e2 d -> Channel r e i o d ie id -> Channel (r + r2) (e + e2) i o d ie id
foreign pure interrupt_when from "@flick-lang/runtime/effect/Channel" "interruptWhen"
  arity 1
  reviewed "effect@4.0.5 sha256:c42a49474a524cb5"

/// Stops pulling the channel once the task has ended, after the element
/// being emitted.
halt_when : Eff r2 e2 d -> Channel r e i o d ie id -> Channel (r + r2) (e + e2) i o d ie id
foreign pure halt_when from "@flick-lang/runtime/effect/Channel" "haltWhen"
  arity 1
  reviewed "effect@4.0.5 sha256:127f02cb398757d0"

/// Runs the task alongside the channel; its failure fails the channel.
merge_effect : Eff r2 e2 x -> Channel r e i o d ie id -> Channel (r + r2) (e + e2) i o d ie id
foreign pure merge_effect from "@flick-lang/runtime/effect/Channel" "mergeEffect"
  arity 1
  reviewed "effect@4.0.5 sha256:c659cc9755d0f49f"

/// `left |> merge strategy right`: the elements of both, as they come,
/// until the side the strategy names ends.
merge :
  HaltStrategy -> Channel r2 e2 i o d ie id -> Channel r e i o d ie id -> Channel (r + r2) (e + e2) i o d ie id
foreign pure merge from "@flick-lang/runtime/effect/Channel" "flickMerge"
  arity 2
  reviewed "effect@4.0.5 sha256:5a188ccedb346870"

/// Runs the channel again by the schedule, which gets each done value.
repeat :
  Schedule.Schedule r2 e2 d so -> Channel r e i o d ie id -> Channel (r + r2) (e + e2) i o d ie id
foreign pure repeat from "@flick-lang/runtime/effect/Channel" "repeat"
  arity 1
  reviewed "effect@4.0.5 sha256:9a1909f59655b5ff"

/// Runs the channel again after a typed error, as long as the schedule,
/// which gets the error, recurs.
retry :
  Schedule.Schedule r2 e2 (Errors e) so -> Channel r e i o d ie id -> Channel (r + r2) (e + e2) i o d ie id
foreign pure retry from "@flick-lang/runtime/effect/Channel" "retry"
  arity 1
  reviewed "effect@4.0.5 sha256:61f20d41ed7c4b00"

/// Emits each element after the schedule's delay; the channel ends with
/// the schedule's last output when the schedule stops first.
schedule :
  Schedule.Schedule r2 e2 o d -> Channel r e i o d ie id -> Channel (r + r2) (e + e2) i o d ie id
foreign pure schedule from "@flick-lang/runtime/effect/Channel" "schedule"
  arity 1
  reviewed "effect@4.0.5 sha256:ef01d15ab59ed821"

/// Builds the layer's services for the channel each time it runs.
provide_ : Layer li le lo -> Channel (lo + r) e i o d ie id -> Channel (li + r) (e + le) i o d ie id
foreign pure provide_ from "@flick-lang/runtime/effect/Channel" "provide"
  arity 1
  reviewed "effect@4.0.5 sha256:2375bbe8c2f75863"

/// Provides the service named by the tag with the implementation.
provide_service :
  ServiceTag s -> ServiceImpl s -> Channel (s + r) e i o d ie id -> Channel r e i o d ie id
foreign pure provide_service from "@flick-lang/runtime/effect/Channel" "provideService"
  arity 2
  reviewed "effect@4.0.5 sha256:5dcdafb03d6818eb"

/// Provides the service with the implementation the task builds.
provide_service_effect :
  ServiceTag s -> Eff r2 e2 (ServiceImpl s) -> Channel (s + r) e i o d ie id -> Channel (r + r2) (e + e2) i o d ie id
foreign pure provide_service_effect from "@flick-lang/runtime/effect/Channel" "provideServiceEffect"
  arity 2
  reviewed "effect@4.0.5 sha256:7b5bccbd5cf1b6f8"

/// Runs the channel with the service's implementation changed by `f`.
update_service :
  ServiceTag s -> (ServiceImpl s -> ServiceImpl s) -> Channel r e i o d ie id -> Channel (s + r) e i o d ie id
foreign pure update_service from "@flick-lang/runtime/effect/Channel" "updateService"
  arity 2
  reviewed "effect@4.0.5 sha256:6222f30661c5b8c1"

/// Runs the channel in a new span with the name.
with_span : String -> Tracer.SpanOptions -> Channel r e i o d ie id -> Channel r e i o d ie id
foreign pure with_span from "@flick-lang/runtime/effect/Channel" "flickWithSpan"
  arity 2
  reviewed "effect@4.0.5 sha256:662859dd9b85a188"
