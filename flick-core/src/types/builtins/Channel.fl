/// Effect's `Channel`: the pull-based stage that streams and sinks are made
/// of. `Channel r e i o d ie id` reads `i` from an upstream that fails with
/// `ie` and ends with `id`, emits `o`, fails with `e` and ends with `d`. A
/// channel is a pure description; `Channel.run_*` runs it. Callbacks kept
/// in a channel hold no captures. A channel of a scoped subscription holds
/// its region: it stays in its `scope`, where a runner takes it as it is.
module Channel exposing (
  Channel,
  HaltStrategy,
  halt_left,
  halt_right,
  halt_both,
  halt_either,
  ReadableStream,
  WritableStream,
  TransformStream,
  AsyncIterable,
  default_chunk_size,
  from_list,
  from_list_chunked,
  from_chunk,
  succeed,
  sync,
  end,
  end_sync,
  empty,
  never,
  fail,
  fail_sync,
  fail_cause,
  fail_cause_sync,
  from_effect,
  from_effect_done,
  from_effect_drain,
  from_queue,
  from_queue_array,
  from_subscription,
  from_subscription_array,
  from_pubsub,
  from_pubsub_array,
  from_schedule,
  suspend,
  unwrap,
  identity,
  Buffer,
  callback,
  callback_array,
  acquire_release,
  acquire_use_release,
  from_readable_stream,
  from_writable_stream,
  from_transform_stream,
  from_async_iterable,
  from_async_iterable_array,
  map,
  map_effect,
  tap,
  map_done,
  map_done_effect,
  map_input,
  map_input_error,
  flat_map,
  switch_map,
  flatten,
  flatten_array,
  MergeOptions,
  merge_all,
  concat,
  concat_with,
  or_else_if_empty,
  drain,
  forever,
  filter,
  filter_map,
  filter_effect,
  filter_map_effect,
  filter_array,
  filter_map_array,
  filter_array_effect,
  filter_map_array_effect,
  map_accum,
  scan,
  scan_effect,
  buffer,
  buffer_array,
  split_lines,
  decode_text,
  encode_text,
  pipe_to,
  pipe_to_or_fail,
  catch,
  catch_cause,
  tap_error,
  tap_cause,
  map_error,
  ignore_,
  ignore_cause,
  ensuring,
  on_error,
  on_exit,
  on_start,
  on_first,
  on_end,
  interrupt_when,
  halt_when,
  merge_effect,
  merge,
  repeat,
  retry,
  schedule,
  provide_,
  provide_service,
  provide_service_effect,
  update_service,
  with_span,
  run_collect,
  run_count,
  run_drain,
  run_head,
  run_last,
  run_fold,
  run_fold_effect,
  run_for_each,
  run_for_each_while,
  mk_uint8_array,
  run_into_queue,
  run_into_queue_array,
  to_queue,
  to_queue_array,
  HubOptions,
  to_pubsub,
  to_pubsub_array,
  run_into_pubsub,
  run_into_pubsub_array,
)

