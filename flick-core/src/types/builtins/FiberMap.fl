/// Effect's `FiberMap`: at most one child per key, owned by a `scope` and
/// interrupted when it closes; running a key again interrupts its child.
/// `join` waits for the first failure, so the map supervises its children.
module FiberMap exposing (..)

/// Children of region `s` by keys of `k`, failing with `e` or giving `a`.
type FiberMap (s : Region) k (e : ErrorRow) a

/// How `set` keeps a child: `onlyIfMissing` leaves a running one of the
/// key; `propagateInterruption` makes an interruption fail `join`.
type alias SetOptions = { onlyIfMissing : Bool; propagateInterruption : Bool }

/// `SetOptions` for `run`; `startImmediately` runs the child before `run`
/// returns.
type alias RunOptions = {
  onlyIfMissing : Bool;
  propagateInterruption : Bool;
  startImmediately : Bool;
}

/// An empty map owned by the innermost `scope` (or the one of region `s`).
make : forall s k e a. Unit ->{Scope s;} FiberMap s k e a
foreign effect make from "@flick-lang/runtime/effect/FiberMap" "flickMake"
  arity 0
  reviewed "effect@4.0.5 sha256:3062dfe43eb79c37"

/// Runs `task` as the child of `key`; it may hold only what outlives the
/// map's region.
run :
  forall s c r k e a.
  Fiber.Outlives c s =>
  RunOptions -> k -> (Eff r e a)^c -> FiberMap s k e a ->{r;} Fiber.Fiber e a
foreign effect run from "@flick-lang/runtime/effect/FiberMap" "flickRun"
  arity 1
  retention owner
  reviewed "effect@4.0.5 sha256:19752d4c68444c31"

/// Keeps a child spawned elsewhere as the one of `key`.
set : SetOptions -> k -> Fiber.Fiber e a -> FiberMap s k e a ->{} Unit
foreign effect set from "@flick-lang/runtime/effect/FiberMap" "flickSet"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:75b8b63da4b3283d"

/// The child of `key`, if one is running.
get : k -> FiberMap s k e a ->{} Option (Fiber.Fiber e a)
foreign effect get from "@flick-lang/runtime/effect/FiberMap" "flickGet"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:f51f688382dcfd46"

/// Whether a child of `key` is running.
has : k -> FiberMap s k e a ->{} Bool
foreign effect has from "@flick-lang/runtime/effect/FiberMap" "has"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:f1062c1c871ae65f"

/// Interrupts the child of `key` and removes it.
remove : k -> FiberMap s k e a ->{} Unit
foreign effect remove from "@flick-lang/runtime/effect/FiberMap" "remove"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:1f708524facb6472"

/// Interrupts every child and empties the map.
clear : FiberMap s k e a ->{} Unit
foreign effect clear from "@flick-lang/runtime/effect/FiberMap" "clear"
  retention call
  reviewed "effect@4.0.5 sha256:8f198f7500242507"

/// How many children are running.
size : FiberMap s k e a ->{} Number
foreign effect size from "@flick-lang/runtime/effect/FiberMap" "size"
  retention call
  reviewed "effect@4.0.5 sha256:42ae4b52db567a98"

/// Waits until the scope closes or a child fails, and fails as it did.
join : FiberMap s k e a ->{; e} Unit
foreign effect join from "@flick-lang/runtime/effect/FiberMap" "join"
  retention call
  reviewed "effect@4.0.5 sha256:e53d549b25e4c0fd"

/// Waits until no child is running, or fails as the first failed one did.
await_empty : FiberMap s k e a ->{; e} Unit
foreign effect await_empty from "@flick-lang/runtime/effect/FiberMap" "awaitEmpty"
  retention call
  reviewed "effect@4.0.5 sha256:1b6002d5015f7c15"
