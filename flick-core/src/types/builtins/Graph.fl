/// Effect's `Graph`: immutable directed and undirected graphs with data on
/// nodes and edges, their changes, queries, traversals and algorithms. A
/// change returns a new graph; invalid input is a `GraphError` in a `Result`.
module Graph exposing (
  Graph, Directed, Undirected, DirectedGraph, UndirectedGraph, Kind, directed_kind,
  undirected_kind, NodeIndex, EdgeIndex, Edge, IndexedNode, IndexedEdge, Snapshot,
  GraphError(..), Direction, outgoing, incoming, TraversalDirection, along, both_ways,
  IdentityOptions, NeighborhoodConfig, ReachabilityConfig, SearchConfig, TopoConfig,
  ExternalsConfig, CycleResult, BipartiteMatch, MaximumFlowConfig, MaximumFlowResult,
  MinimumCutResult, PathResult, DijkstraConfig, BellmanFordConfig, AstarConfig,
  SimplePathsConfig, AllShortestPathsConfig, AllPairsResult, PathWalker, Walker, NodeWalker,
  EdgeWalker, GraphVizOptions, MermaidNodeShape, rectangle, rounded, circle, diamond, hexagon,
  stadium, subroutine, cylindrical, MermaidDirection, top_to_bottom, top_down, bottom_to_top,
  right_to_left, left_to_right, MermaidDiagramType, flowchart, graph_diagram, MermaidOptions,
  make, directed, undirected, from_snapshot, to_snapshot, add_node, add_edge, remove_node,
  remove_nodes, remove_edge, remove_edges, update_node, update_edge, map_nodes, map_edges,
  filter_map_nodes, filter_map_edges, filter_nodes, filter_edges, reverse, compose, intersection,
  difference, symmetric_difference, sum, complement, neighborhood, induced_subgraph, get_node,
  has_node, node_count, find_node, find_nodes, find_edge, find_edges, get_edge, has_edge,
  edge_count, incident_edges, outgoing_edges, incoming_edges, edges_between, degree, out_degree,
  in_degree, neighbors, successors, predecessors, neighbors_directed, to_graph_viz, to_mermaid,
  find_cycle, is_acyclic, is_bipartite, maximum_bipartite_matching, unweighted_distances,
  has_path, connected_components, bridges, articulation_points, biconnected_components,
  weakly_connected_components, strongly_connected_components, is_connected, is_weakly_connected,
  is_strongly_connected, is_tree, maximum_flow, minimum_cut, minimum_spanning_forest,
  transitive_reduction, dijkstra, astar, bellman_ford, floyd_warshall, simple_paths,
  all_shortest_paths, dfs, bfs, dfs_post_order, topo, nodes, edges, externals, indices, values,
  entries
)

