/// Effect's `AsyncResult` (unstable in Effect 4.0.5): the value of an atom
/// an effect computes. It is not there yet, it succeeded, or it failed, and
/// each case may be waiting for a run that has started again.
module Reactivity.AsyncResult exposing (..)

/// The state of an effect's result: initial, a success of `a` or a failure
/// with the cause of `e`, waiting or not.
type AsyncResult a (e : ErrorRow)

/// `initial` when nothing has finished, else `success` of the value or
/// `failure` of what went wrong.
fold : b -> (a -> b) -> (Failure e -> b) -> AsyncResult a e -> b
foreign pure fold from "@flick-lang/runtime/effect/reactivity/AsyncResult" "flickFold"
  reviewed "effect@4.1.2 sha256:bb0f230e80dc1cfc"

/// The value of a success, the last one kept by a failure, else `None`.
value : AsyncResult a e -> Option a
foreign pure value from "@flick-lang/runtime/effect/reactivity/AsyncResult" "value"
  reviewed "effect@4.1.2 sha256:d43f686611659163"

/// Whether a run is under way.
is_waiting : AsyncResult a e -> Bool
foreign pure is_waiting from "@flick-lang/runtime/effect/reactivity/AsyncResult" "isWaiting"
  reviewed "effect@4.1.2 sha256:aa0af91299b3a059"
