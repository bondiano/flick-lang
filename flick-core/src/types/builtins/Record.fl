/// Row primitives: relations between records that the compiler solves from
/// their fields. A program cannot declare instances of them.
module Record exposing (..)

@lang label
/// A label as a value: `(Record.label : Label "name")`.
type Label (l : Symbol)

@lang field
/// `Field "x" T` is `{ x : T }`.
type Field (l : Symbol) a

@lang has_field
/// The record `r` has field `l` of type `a`.
class HasField (l : Symbol) r a | l r -> a

@lang lacks
/// The record `r` has no field `l`.
class Lacks (l : Symbol) r

@lang remove
/// `out` is `r` without its field `l`.
class Remove (l : Symbol) r out | l r -> out

@lang project
/// Every field of `out` is a field of `r` of the same type.
class Project r out

@lang union_disjoint
/// `a` and `b` have no label in common, and `out` has the fields of both.
class UnionDisjoint a b out | a b -> out

@lang map_fields
/// `out` has the labels of `r`, each field of type `t` becoming `f t`.
class Map (f : Type -> Type) r out | f r -> out

@lang labels
/// The labels of `r` are known: `labels` lists them in canonical order.
class Labels r

@lang record_label
label : Label l
foreign pure label from "@flick-lang/runtime" "recordLabel"

get : HasField l r a => Label l -> r -> a
foreign pure get from "@flick-lang/runtime" "recordGet"

extend : (Lacks l r, UnionDisjoint r (Field l a) out) => Label l -> a -> r -> out
foreign pure extend from "@flick-lang/runtime" "recordExtend"

remove : Remove l r out => Label l -> r -> out
foreign pure remove from "@flick-lang/runtime" "recordRemove"

/// The record with only the fields of `out`.
project : Project r out => r -> out
foreign pure project from "@flick-lang/runtime" "recordProject"
  reviewed "effect@4.1.2 sha256:0c8a737842e9bc05"

merge_disjoint : UnionDisjoint a b out => a -> b -> out
foreign pure merge_disjoint from "@flick-lang/runtime" "recordMergeDisjoint"

/// The labels of the record, in canonical order.
labels : Labels r => r -> List String
foreign pure labels from "@flick-lang/runtime" "recordLabels"
  reviewed "effect@4.1.2 sha256:59a472c41aac0334"

/// A dictionary from string keys to values of one type, as Effect's
/// `Record` keeps it: a plain JS object. Unlike a record, its keys are data.
type ReadonlyRecord a

instance Eq a => Eq (ReadonlyRecord a) =
  eq : ReadonlyRecord a -> ReadonlyRecord a -> Bool
  let eq x y = make_equivalence eq x y

instance Show a => Show (ReadonlyRecord a) =
  show : ReadonlyRecord a -> String
  let show x = "Record " ++ show (to_entries x)

/// The dictionary without keys.
empty : Unit -> ReadonlyRecord a
foreign pure empty from "@flick-lang/runtime/effect/Record" "empty"
  arity 0
  reviewed "effect@4.1.2 sha256:ebce6623720a0f97"

/// Whether the dictionary has no key.
is_empty : ReadonlyRecord a -> Bool
foreign pure is_empty from "@flick-lang/runtime/effect/Record" "isEmptyReadonlyRecord"
  reviewed "effect@4.1.2 sha256:09ec0c7e68b2435d"

/// The dictionary of the pairs; a later key wins.
from_entries : List (String, a) -> ReadonlyRecord a
foreign pure from_entries from "@flick-lang/runtime/effect/Record" "fromEntries"
  reviewed "effect@4.1.2 sha256:b6ba3da813c127ee"

/// The dictionary of the key and value `f` gives each element; a later key wins.
from_iterable_with : forall c a b. (a -> (String, b))^c -> (List a -> ReadonlyRecord b)^c
foreign pure from_iterable_with from "@flick-lang/runtime/effect/Record" "fromIterableWith"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:719ab8c0675463a9"

/// The elements under the key `f` gives each; a later key wins.
from_iterable_by : forall c a. (a -> String)^c -> (List a -> ReadonlyRecord a)^c
foreign pure from_iterable_by from "@flick-lang/runtime/effect/Record" "fromIterableBy"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:41c0015d159b7ebc"

/// The dictionary with `value` under each key.
from_keys : List String -> a -> ReadonlyRecord a
foreign pure from_keys from "@flick-lang/runtime/effect/Struct" "Record"
