/// The keys, in order.
keys : ReadonlyRecord a -> List String
foreign pure keys from "@flick-lang/runtime/effect/Record" "keys"
  reviewed "effect@4.1.2 sha256:c8e94b3075648fc0"

/// The values, in key order.
values : ReadonlyRecord a -> List a
foreign pure values from "@flick-lang/runtime/effect/Record" "values"
  reviewed "effect@4.1.2 sha256:a1a0ac144ab23772"

/// How many keys the dictionary has.
size : ReadonlyRecord a -> Int
foreign pure size from "@flick-lang/runtime/effect/Record" "size"
  reviewed "effect@4.1.2 sha256:26ab4b926e6db68b"

/// Whether the key is in the dictionary.
has : String -> ReadonlyRecord a -> Bool
foreign pure has from "@flick-lang/runtime/effect/Record" "has"
  arity 1
  reviewed "effect@4.1.2 sha256:45fa17996e387f2e"

/// The value under the key.
get_key : String -> ReadonlyRecord a -> Option a
foreign pure get_key from "@flick-lang/runtime/effect/Record" "get"
  arity 1
  reviewed "effect@4.1.2 sha256:ee7f276ae38e1254"

/// The value under the key replaced by `f` of it; `None` without the key.
modify : forall c a. String -> (a -> a)^c -> (ReadonlyRecord a -> Option (ReadonlyRecord a))^c
foreign pure modify from "@flick-lang/runtime/effect/Record" "modify"
  arity 2
  retention call
  reviewed "effect@4.1.2 sha256:9e1fd7e09fe10ca6"

/// The value under the key replaced; `None` without the key.
replace : String -> a -> ReadonlyRecord a -> Option (ReadonlyRecord a)
foreign pure replace from "@flick-lang/runtime/effect/Record" "replace"
  arity 2
  reviewed "effect@4.1.2 sha256:dd1ae384f755dc6a"

/// The dictionary with `value` under the key, added or replaced.
set : String -> a -> ReadonlyRecord a -> ReadonlyRecord a
foreign pure set from "@flick-lang/runtime/effect/Record" "set"
  arity 2
  reviewed "effect@4.1.2 sha256:5708e71ab154f714"

/// The dictionary without the key.
remove_key : String -> ReadonlyRecord a -> ReadonlyRecord a
foreign pure remove_key from "@flick-lang/runtime/effect/Record" "remove"
  arity 1
  reviewed "effect@4.1.2 sha256:4681f3e03fb7655b"

/// The value under the key and the dictionary without it; `None` without the key.
pop : String -> ReadonlyRecord a -> Option (a, ReadonlyRecord a)
foreign pure pop from "@flick-lang/runtime/effect/Record" "pop"
  arity 1
  reviewed "effect@4.1.2 sha256:b95ac903ac7f2924"

/// Each value replaced by `f` of it and its key.
map : forall c a b. (a -> String -> b)^c -> (ReadonlyRecord a -> ReadonlyRecord b)^c
foreign pure map from "@flick-lang/runtime/effect/Record" "map"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:6c876862a16a1465"

/// Each key replaced by `f` of it and its value; a later key wins.
map_keys : forall c a. (String -> a -> String)^c -> (ReadonlyRecord a -> ReadonlyRecord a)^c
foreign pure map_keys from "@flick-lang/runtime/effect/Record" "mapKeys"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:74bc9be1e78f5c07"

/// Each entry replaced by the key and value `f` gives of its value and key.
map_entries :
  forall c a b. (a -> String -> (String, b))^c -> (ReadonlyRecord a -> ReadonlyRecord b)^c
foreign pure map_entries from "@flick-lang/runtime/effect/Record" "mapEntries"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:dc1e6b7bc7a55c63"

/// The entries whose value and key satisfy `p`.
filter : forall c a. (a -> String -> Bool)^c -> (ReadonlyRecord a -> ReadonlyRecord a)^c
foreign pure filter from "@flick-lang/runtime/effect/Record" "filter"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:743af5c938465c30"

/// The `Ok` values of `f` over each value and key.
filter_map :
  forall c a b e. (a -> String -> Result e b)^c -> (ReadonlyRecord a -> ReadonlyRecord b)^c
foreign pure filter_map from "@flick-lang/runtime/effect/Record" "filterMap"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:d1e7a89c087d0753"

/// The `Ok` values and the `Err` errors of `f` over each value and key.
partition :
  forall c a f p.
  (a -> String -> Result f p)^c -> (ReadonlyRecord a -> (ReadonlyRecord p, ReadonlyRecord f))^c
foreign pure partition from "@flick-lang/runtime/effect/Record" "partition"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:e8e24b93183935e8"

/// The values of the `Some` entries.
get_somes : ReadonlyRecord (Option a) -> ReadonlyRecord a
foreign pure get_somes from "@flick-lang/runtime/effect/Record" "getSomes"
  reviewed "effect@4.1.2 sha256:7f8d49ffc9a3b0ac"

/// The errors of the `Err` entries.
get_failures : ReadonlyRecord (Result e a) -> ReadonlyRecord e
foreign pure get_failures from "@flick-lang/runtime/effect/Record" "getFailures"
  reviewed "effect@4.1.2 sha256:dc8fc3e111495327"

/// The values of the `Ok` entries.
get_successes : ReadonlyRecord (Result e a) -> ReadonlyRecord a
foreign pure get_successes from "@flick-lang/runtime/effect/Record" "getSuccesses"
  reviewed "effect@4.1.2 sha256:9541688fb1ba3bbb"

/// The `Ok` values and the `Err` errors.
separate : ReadonlyRecord (Result e a) -> (ReadonlyRecord a, ReadonlyRecord e)
foreign pure separate from "@flick-lang/runtime/effect/Record" "separate"
  reviewed "effect@4.1.2 sha256:f7cc9b22a0dd7cf2"

/// Folds the values in key order, `f` seeing each value and key.
reduce : forall c a b. b -> (b -> a -> String -> b)^c -> (ReadonlyRecord a -> b)^c
foreign pure reduce from "@flick-lang/runtime/effect/Record" "reduce"
  arity 2
  retention call
  reviewed "effect@4.1.2 sha256:28c146a2f26c1bb4"

/// Whether every value and key satisfy `p`.
every : forall c a. (a -> String -> Bool)^c -> (ReadonlyRecord a -> Bool)^c
foreign pure every from "@flick-lang/runtime/effect/Record" "every"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:a59d1da567b262ff"

/// Whether some value and key satisfy `p`.
some : forall c a. (a -> String -> Bool)^c -> (ReadonlyRecord a -> Bool)^c
foreign pure some from "@flick-lang/runtime/effect/Record" "some"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:2c419dcd222b33b7"

/// The first key and value, in key order, that satisfy `p`.
find_first : forall c a. (a -> String -> Bool)^c -> (ReadonlyRecord a -> Option (String, a))^c
foreign pure find_first from "@flick-lang/runtime/effect/Record" "findFirst"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:ba87d0f6208bbc7e"

/// `self |> union that combine`: the keys of both, `combine` of the two
/// values under a shared key.
union : forall c a. ReadonlyRecord a -> (a -> a -> a)^c -> (ReadonlyRecord a -> ReadonlyRecord a)^c
foreign pure union from "@flick-lang/runtime/effect/Record" "union"
  arity 2
  retention call
  reviewed "effect@4.1.2 sha256:cd57676a46225568"

/// `self |> intersection that combine`: the shared keys, with `combine` of
/// the two values.
intersection :
  forall c a b d. ReadonlyRecord b -> (a -> b -> d)^c -> (ReadonlyRecord a -> ReadonlyRecord d)^c
foreign pure intersection from "@flick-lang/runtime/effect/Record" "intersection"
  arity 2
  retention call
  reviewed "effect@4.1.2 sha256:1859f7c944910710"

/// `self |> difference that`: the entries whose key only one of the two has.
difference : ReadonlyRecord a -> ReadonlyRecord a -> ReadonlyRecord a
foreign pure difference from "@flick-lang/runtime/effect/Record" "difference"
  arity 1
  reviewed "effect@4.1.2 sha256:baeb87dcd291fcf5"

/// `self |> is_subrecord_by same that`: every entry of `self` is in `that`,
/// its value `same` as the one there.
is_subrecord_by : forall c a. (a -> a -> Bool)^c -> (ReadonlyRecord a -> ReadonlyRecord a -> Bool)^c
foreign pure is_subrecord_by from "@flick-lang/runtime/effect/Record" "isSubrecordBy"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:a272e6e6496f929b"

/// `self |> is_subrecord that`: every entry of `self` is in `that`, by `Eq`.
is_subrecord : Eq a => ReadonlyRecord a -> ReadonlyRecord a -> Bool
let is_subrecord that self = is_subrecord_by eq that self

/// Whether both have the same keys, with values `same` under each.
make_equivalence :
  forall c a. (a -> a -> Bool)^c -> (ReadonlyRecord a -> ReadonlyRecord a -> Bool)^c
foreign pure make_equivalence from "@flick-lang/runtime/effect/Record" "flickMakeEquivalence"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:19051946cb775edd"
