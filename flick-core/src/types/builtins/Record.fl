/// `f` of each key and value, in key order.
collect : forall c a b. (String -> a -> b)^c -> (ReadonlyRecord a -> List b)^c
foreign pure collect from "@flick-lang/runtime/effect/Record" "collect"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:a79badd974887206"

/// The key and value pairs, in key order.
to_entries : ReadonlyRecord a -> List (String, a)
foreign pure to_entries from "@flick-lang/runtime/effect/Record" "toEntries"
