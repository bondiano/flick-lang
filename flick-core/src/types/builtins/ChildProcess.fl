/// Effect's child processes: a `Command` describes a program to run, its
/// arguments, directory, environment and standard streams; `spawn` starts
/// it as a `Process` of a scope, whose closing stops what still runs, and
/// `string`, `lines` and `exit_code` run it to its end. A process starts in
/// a process group of its own, which stopping it signals.
module ChildProcess exposing (..)

import Stream.Core exposing (Stream)

/// A program to run, with its arguments and how it runs.
type Command

/// A running process of region `s`.
type Process (s : Region)

/// A signal by its name, as `"SIGTERM"`.
type alias Signal = String

/// How `kill_with` stops a process: the signal, and how long to wait for
/// it to end before `SIGKILL`.
type alias KillOptions = { signal : Signal; force_after : Option Duration.Duration }

/// The program with its arguments, without a shell.
make : String -> List String -> Command
foreign pure make from "@flick-lang/runtime/effect/ChildProcess" "flickMake"
  arity 2
  reviewed "effect@4.0.5 sha256:2e0344f65efa4af3"

/// Runs the command in the directory.
set_cwd : String -> Command -> Command
foreign pure set_cwd from "@flick-lang/runtime/effect/ChildProcess" "setCwd"
  arity 1
  reviewed "effect@4.0.5 sha256:6643453c15cdce07"

/// Adds the variables to the environment the command inherits.
set_env : List (String, String) -> Command -> Command
foreign pure set_env from "@flick-lang/runtime/effect/ChildProcess" "flickSetEnv"
  arity 2
  reviewed "effect@4.0.5 sha256:fea99ecf8a4d611c"

/// Runs the command through the program and its arguments, as `sudo` or
/// `env`.
prefix : String -> List String -> Command -> Command
foreign pure prefix from "@flick-lang/runtime/effect/ChildProcess" "flickPrefix"
  arity 3
  reviewed "effect@4.0.5 sha256:3f3b0f47781740b0"

/// `a |> pipe_to b`: the stdout of `a` is the stdin of `b`; the pipeline's
/// output is that of `b`.
pipe_to : Command -> Command -> Command
foreign pure pipe_to from "@flick-lang/runtime/effect/ChildProcess" "pipeTo"
  arity 1
  reviewed "effect@4.0.5 sha256:fb3d583618428084"

/// Writes the text to the command's stdin, then closes it.
set_stdin : String -> Command -> Command
foreign pure set_stdin from "@flick-lang/runtime/effect/ChildProcess" "flickSetStdin"
  arity 2
  reviewed "effect@4.0.5 sha256:85a7a94d87b0aa57"

/// Lets the command write to the program's own stdout and stderr instead
/// of pipes.
inherit_output : Command -> Command
foreign pure inherit_output from "@flick-lang/runtime/effect/ChildProcess" "flickInheritOutput"
  reviewed "effect@4.0.5 sha256:08317a9ab947f5ff"

/// Starts the command; the scope of region `s` stops it if it still runs.
spawn : forall s. Command ->{Scope s; PlatformError.PlatformError} Process s
foreign effect spawn from "@flick-lang/runtime/effect/ChildProcess" "flickSpawn"
  reviewed "effect@4.0.5 sha256:40dccc7fabdf7b49"

/// The process's ID.
pid : forall s. Process s -> Int
foreign pure pid from "@flick-lang/runtime/effect/ChildProcess" "flickPid"
  retention call
  reviewed "effect@4.0.5 sha256:f7d1cc90ab08e778"

/// Waits for the process to end: its exit code. A process a signal ended
/// fails.
wait : forall s. Process s ->{; PlatformError.PlatformError} Int
foreign effect wait from "@flick-lang/runtime/effect/ChildProcess" "flickWait"
  retention call
  reviewed "effect@4.0.5 sha256:6da3b9d4e047c7e2"

/// Whether the process still runs.
is_running : forall s. Process s ->{; PlatformError.PlatformError} Bool
foreign effect is_running from "@flick-lang/runtime/effect/ChildProcess" "flickIsRunning"
  retention call
  reviewed "effect@4.0.5 sha256:2687b5e42628f930"

/// Stops the process with `SIGTERM` and waits a second for it to end.
kill : forall s. Process s ->{; PlatformError.PlatformError} Unit
foreign effect kill from "@flick-lang/runtime/effect/ChildProcess" "flickKill"
  retention call
  reviewed "effect@4.0.5 sha256:2687b5e42628f930"

/// Stops the process with the signal, then `SIGKILL` after `force_after`.
kill_with : forall s. KillOptions -> Process s ->{; PlatformError.PlatformError} Unit
foreign effect kill_with from "@flick-lang/runtime/effect/ChildProcess" "flickKillWith"
  arity 2
  retention call
  reviewed "effect@4.0.5 sha256:0ab80168e973487b"

/// The bytes the process writes to stdout; the stream cannot leave the
/// process's scope.
stdout : forall s. Process s -> (Stream none {PlatformError.PlatformError} (List Int))^{s}
foreign pure stdout from "@flick-lang/runtime/effect/ChildProcess" "flickStdout"
  retention call
  reviewed "effect@4.0.5 sha256:fbc5852c8234490f"

/// The bytes the process writes to stderr.
stderr : forall s. Process s -> (Stream none {PlatformError.PlatformError} (List Int))^{s}
foreign pure stderr from "@flick-lang/runtime/effect/ChildProcess" "flickStderr"
  retention call
  reviewed "effect@4.0.5 sha256:3fe00f74628a0caf"

/// What the command writes to stdout, as text; it runs to its end.
string : Command ->{; PlatformError.PlatformError} String
foreign effect string from "@flick-lang/runtime/effect/ChildProcess" "flickString"
  reviewed "effect@4.0.5 sha256:40dccc7fabdf7b49"

/// The lines the command writes to stdout.
lines : Command ->{; PlatformError.PlatformError} List String
foreign effect lines from "@flick-lang/runtime/effect/ChildProcess" "flickLines"
  reviewed "effect@4.0.5 sha256:40dccc7fabdf7b49"

/// Runs the command to its end: its exit code.
exit_code : Command ->{; PlatformError.PlatformError} Int
foreign effect exit_code from "@flick-lang/runtime/effect/ChildProcess" "flickExitCode"
  reviewed "effect@4.0.5 sha256:40dccc7fabdf7b49"
