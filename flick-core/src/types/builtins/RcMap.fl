/// Effect's `RcMap`: resources by key, each shared by reference count as
/// an `RcRef` is. Keys are compared by `==`.
module RcMap exposing (..)

/// Resources of `a` by keys of `k`, of region `s`, whose lookup fails with
/// `e`.
type RcMap (s : Region) k (e : ErrorRow) a

/// A `get` of a new key found the map at its capacity.
type error ExceededCapacity = ExceededCapacity String
  deriving Eq, Show

/// A map owned by the innermost `scope` (or the one of region `s`);
/// `lookup` runs with the services of this call. A resource stays for
/// `idleTimeToLive key` after its last holder (`None`: no time), and the map
/// holds at most `capacity` keys (`None`: no bound).
make :
  forall s k r e a.
  {
    lookup : k ->{r; e} a;
    idleTimeToLive : Option (k -> Duration.Duration);
    capacity : Option Float;
  } ->{Scope s | r;}
  RcMap s k e a
foreign effect make from "@flick-lang/runtime/effect/RcMap" "flickMake"
  reviewed "effect@4.0.5 sha256:a1751cbe903120cf"

/// The resource of `key`, looking it up if no one holds it; the innermost
/// `scope` (or the one of region `t`) holds it until it closes.
get : forall s t k e a. k -> RcMap s k e a ->{Scope t; ExceededCapacity | e} a
foreign effect get from "@flick-lang/runtime/effect/RcMap" "flickGet"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:361e3835af8b8aab"

/// The resource of `key` if it is held now, holding it as `get` does.
get_option : forall s t k e a. k -> RcMap s k e a ->{Scope t; e} Option a
foreign effect get_option from "@flick-lang/runtime/effect/RcMap" "getOption"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:1f853b27223bed36"

/// The keys with a resource.
keys : forall s k e a. RcMap s k e a ->{} List k
foreign effect keys from "@flick-lang/runtime/effect/RcMap" "flickKeys"
  retention call
  reviewed "effect@4.0.5 sha256:415be2871c1c1181"

/// Releases the resource of `key` once its holders are done.
invalidate : forall s k e a. k -> RcMap s k e a ->{} Unit
foreign effect invalidate from "@flick-lang/runtime/effect/RcMap" "invalidate"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:7bef59e4b2678f52"

/// Whether `key` has a resource.
has : forall s k e a. k -> RcMap s k e a ->{} Bool
foreign effect has from "@flick-lang/runtime/effect/RcMap" "has"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:c83c9f79b2b36805"

/// Starts the idle time of `key`'s resource anew.
touch : forall s k e a. k -> RcMap s k e a ->{} Unit
foreign effect touch from "@flick-lang/runtime/effect/RcMap" "touch"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:292a9ca3a7723ca2"
