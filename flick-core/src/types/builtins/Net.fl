dns_naptr_record : PureCodec Json DnsRecord
foreign pure dns_naptr_record from "@flick-lang/runtime/effect/Net" "flickDnsNaptrRecord"
  reviewed "effect@4.0.5 sha256:f750f7cb39f8cec5"

/// A DNS NS record as JSON; a record of another type is a `SchemaError`.
dns_ns_record : PureCodec Json DnsRecord
foreign pure dns_ns_record from "@flick-lang/runtime/effect/Net" "flickDnsNsRecord"
  reviewed "effect@4.0.5 sha256:29d0b46be1138b2d"

/// A DNS PTR record as JSON; a record of another type is a `SchemaError`.
dns_ptr_record : PureCodec Json DnsRecord
foreign pure dns_ptr_record from "@flick-lang/runtime/effect/Net" "flickDnsPtrRecord"
  reviewed "effect@4.0.5 sha256:709baa0375fa7aa7"

/// A DNS SOA record as JSON; a record of another type is a `SchemaError`.
dns_soa_record : PureCodec Json DnsRecord
foreign pure dns_soa_record from "@flick-lang/runtime/effect/Net" "flickDnsSoaRecord"
