/// A DNS TLSA record as JSON; a record of another type is a `SchemaError`.
dns_tlsa_record : PureCodec Json DnsRecord
foreign pure dns_tlsa_record from "@flick-lang/runtime/effect/Net" "flickDnsTlsaRecord"
