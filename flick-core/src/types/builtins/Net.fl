/// A DNS TXT record as JSON; a record of another type is a `SchemaError`.
dns_txt_record : PureCodec Json DnsRecord
foreign pure dns_txt_record from "@flick-lang/runtime/effect/Net" "flickDnsTxtRecord"
  reviewed "effect@4.0.5 sha256:7b7d169925990254"

/// A DNS record type name as JSON text: `"A"`, `"AAAA"`, `"MX"`, ….
dns_record_type : PureCodec Json String
foreign pure dns_record_type from "@flick-lang/runtime/effect/Net" "flickDnsRecordType"
