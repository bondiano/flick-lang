/// Effect's `ExecutionPlan`: steps that each provide the services `p` of a
/// task, tried in order until one succeeds (`Effect.with_execution_plan`).
/// A step builds its layer, which needs `r` and may fail with `e`, and may
/// be tried several times; the task's error, of type `i`, decides retries.
module ExecutionPlan exposing (..)

/// A plan of steps providing `p` from `r`, failing with `e`, for a task
/// whose errors are `i`.
type ExecutionPlan (p : ServiceRow) (r : ServiceRow) (e : ErrorRow) i

/// One step of a plan, built by `step` and the `with_*` functions.
type Step (p : ServiceRow) (r : ServiceRow) (e : ErrorRow) i

/// Which attempt of the plan runs: counted from 1, and the index of its
/// step from 0.
type alias Metadata = { attempt : Int; stepIndex : Int }

/// An attempt of the plan: counted from 1 overall and within its step, and
/// the index of its step from 0.
type alias Attempt = { attempt : Int; stepAttempt : Int; stepIndex : Int }

/// What happens while a plan runs a task: an attempt starts, succeeds after
/// a duration, or fails after a duration with a failure of the task.
type Event (e : ErrorRow) =
  | AttemptStart Attempt
  | AttemptSuccess Attempt Duration.Duration
  | AttemptFailure Attempt Duration.Duration (Failure e)

/// A step providing the services the layer builds, tried once.
step : Layer r e p -> Step p r e i
foreign pure step from "@flick-lang/runtime/effect/ExecutionPlan" "flickStep"

/// The step tried up to `n` times.
with_attempts : Int -> Step p r e i -> Step p r e i
foreign pure with_attempts from "@flick-lang/runtime/effect/ExecutionPlan" "flickWithAttempts"
  arity 1

/// The step tried again by the schedule, which gets the task's error.
with_schedule : Schedule.Schedule r e i o -> Step p r e i -> Step p r e i
foreign pure with_schedule from "@flick-lang/runtime/effect/ExecutionPlan" "flickWithSchedule"
  arity 1

/// The step tried again only while `f` of the task's error holds.
with_while : (i ->{r; e} Bool) -> Step p r e i -> Step p r e i
foreign pure with_while from "@flick-lang/runtime/effect/ExecutionPlan" "flickWithWhile"
  arity 1

/// The plan of these steps, tried in order.
make : NonEmpty.NonEmpty (Step p r e i) -> ExecutionPlan p r e i
foreign pure make from "@flick-lang/runtime/effect/ExecutionPlan" "flickMake"
  reviewed "effect@4.0.5 sha256:558d7d1b14e5c534"

/// The steps of the plans, one plan after another.
merge : NonEmpty.NonEmpty (ExecutionPlan p r e i) -> ExecutionPlan p r e i
foreign pure merge from "@flick-lang/runtime/effect/ExecutionPlan" "flickMerge"
  reviewed "effect@4.0.5 sha256:3b9926fe30ac6c1e"

/// The attempt the current task runs as, inside a plan.
current_metadata : Unit ->{} Metadata
foreign effect current_metadata from "@flick-lang/runtime/effect/ExecutionPlan" "flickCurrentMetadata"
  arity 0
  reviewed "effect@4.0.5 sha256:331a4ec44cf66af8"
