/// Effect's `ScopedCache`: a `Cache` whose lookups acquire resources. A value
/// is used only inside `use`, which holds it: an entry's resources are
/// released when it is dropped and no `use` holds its value, and all of them
/// when the `scope` owning the cache's region closes. Keys are compared by
/// `==`.
module ScopedCache exposing (..)

/// A cache of region `s` from keys of `k` to values of `a`, whose lookup
/// fails with `e`.
type ScopedCache (s : Region) k (e : ErrorRow) a

/// A cache owned by the innermost `scope` (or the one of region `s`);
/// `lookup` runs with the services of the call that made it, and what it
/// acquires belongs to its entry, a region `t` of its own: a value of a type
/// that names its region, such as `File t`, cannot be cached. Entries live
/// for `timeToLive` (`None`: until evicted).
make :
  forall s k r e a.
  {
    lookup : forall t. k ->{Scope t | r; e} a^{t};
    capacity : Int;
    timeToLive : Option Duration.Duration;
  } ->{Scope s | r;}
  ScopedCache s k e a
foreign effect make from "@flick-lang/runtime/effect/ScopedCache" "flickMake"
  reviewed "effect@4.0.5 sha256:463f2234265282d1"

/// `make`, the time to live of each entry computed from how its lookup
/// ended and its key.
make_with :
  forall s k r e a.
  {
    lookup : forall t. k ->{Scope t | r; e} a^{t};
    capacity : Int;
    timeToLive : Option (Exit e a -> k -> Duration.Duration);
  } ->{Scope s | r;}
  ScopedCache s k e a
foreign effect make_with from "@flick-lang/runtime/effect/ScopedCache" "flickMakeWith"
  reviewed "effect@4.0.5 sha256:d09a00e4ddb73874"

/// Runs `f` with the value of `key`, looking it up once if it is missing or
/// expired; a failed lookup is cached too. The value stays acquired until
/// `f` ends, and what `f` gives cannot hold it.
use :
  forall c s k r e e2 a b.
  k -> ScopedCache s k e a -> (forall t. a^{t} ->{r; e2} b)^c ->{r; e + e2} b
foreign effect use from "@flick-lang/runtime/effect/ScopedCache" "flickUse"
  retention call

/// `use` of the value of `key` if it is cached, waiting for a lookup under
/// way, without a new one; fails as the cached lookup did.
use_option :
  forall c s k r e e2 a b.
  k -> ScopedCache s k e a -> (forall t. (Option a)^{t} ->{r; e2} b)^c ->{r; e + e2} b
foreign effect use_option from "@flick-lang/runtime/effect/ScopedCache" "flickUseOption"
  retention call

/// `use` of the value of `key` if a lookup of it has succeeded and not
/// expired.
use_success :
  forall c s k r e e2 a b.
  k -> ScopedCache s k e a -> (forall t. (Option a)^{t} ->{r; e2} b)^c ->{r; e2} b
foreign effect use_success from "@flick-lang/runtime/effect/ScopedCache" "flickUseSuccess"
  retention call

/// Caches `value` for `key`.
set : forall s k e a. k -> a -> ScopedCache s k e a ->{} Unit
foreign effect set from "@flick-lang/runtime/effect/ScopedCache" "flickSet"
  arity 2
  retention call
  reviewed "effect@4.0.5 sha256:e53b86618baa477e"

/// Whether `key` is cached.
has : forall s k e a. k -> ScopedCache s k e a ->{} Bool
foreign effect has from "@flick-lang/runtime/effect/ScopedCache" "has"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:a78d8aa2a0d7e860"

/// Drops `key`.
invalidate : forall s k e a. k -> ScopedCache s k e a ->{} Unit
foreign effect invalidate from "@flick-lang/runtime/effect/ScopedCache" "invalidate"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:c314077e04cc8375"

/// Drops `key` if its value satisfies `f`; whether it did.
invalidate_when : forall c s k e a. k -> (a -> Bool)^c -> (ScopedCache s k e a ->{} Bool)^c
foreign effect invalidate_when from "@flick-lang/runtime/effect/ScopedCache" "flickInvalidateWhen"
  arity 2
  retention call
  reviewed "effect@4.0.5 sha256:5f0df96a161630e0"

/// Looks `key` up again, cached or not, starting its time to live anew; the
/// previous value is released once no `use` holds it.
refresh : forall s k e a. k -> ScopedCache s k e a ->{; e} Unit
foreign effect refresh from "@flick-lang/runtime/effect/ScopedCache" "flickRefresh"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:ae56c86a6d037203"

/// Drops every key.
invalidate_all : forall s k e a. ScopedCache s k e a ->{} Unit
foreign effect invalidate_all from "@flick-lang/runtime/effect/ScopedCache" "invalidateAll"
  retention call
  reviewed "effect@4.0.5 sha256:5455eb215e13d5aa"

/// The number of cached keys.
size : forall s k e a. ScopedCache s k e a ->{} Int
foreign effect size from "@flick-lang/runtime/effect/ScopedCache" "size"
  retention call
  reviewed "effect@4.0.5 sha256:9ccf109c88ed2682"

/// The cached keys.
keys : forall s k e a. ScopedCache s k e a ->{} List k
foreign effect keys from "@flick-lang/runtime/effect/ScopedCache" "keys"
  retention call
  reviewed "effect@4.0.5 sha256:339c1fe6110bad0b"
