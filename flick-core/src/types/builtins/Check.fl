  reviewed "effect@4.1.2 sha256:1da4a52985b358bd"

/// URL-safe base64 text, without padding.
base64url : Check String
foreign pure base64url from "@flick-lang/runtime/effect/Schema" "flickIsBase64Url"
  reviewed "effect@4.1.2 sha256:0023432d0e950c08"

