  reviewed "effect@4.1.2 sha256:b7d6b562dc4fc03d"

/// Greater than the bound.
greater_than : Float -> Check Float
foreign pure greater_than from "@flick-lang/runtime/effect/Schema" "isGreaterThan"
  reviewed "effect@4.1.2 sha256:e1fd1d098feb730a"

/// At least the bound.
greater_than_or_equal_to : Float -> Check Float
foreign pure greater_than_or_equal_to from "@flick-lang/runtime/effect/Schema" "isGreaterThanOrEqualTo"
  reviewed "effect@4.1.2 sha256:f954f1c75e85b59b"

/// Less than the bound.
less_than : Float -> Check Float
foreign pure less_than from "@flick-lang/runtime/effect/Schema" "isLessThan"
  reviewed "effect@4.1.2 sha256:1db615b16c861f04"

/// At most the bound.
less_than_or_equal_to : Float -> Check Float
foreign pure less_than_or_equal_to from "@flick-lang/runtime/effect/Schema" "isLessThanOrEqualTo"
  reviewed "effect@4.1.2 sha256:daf02fd9efb0618d"

/// Between the bounds; each excluded when its flag is set.
between :
  {
    /// The lower bound.
    minimum : Float;
    /// The upper bound.
    maximum : Float;
    /// Whether the lower bound itself is excluded.
    exclusiveMinimum : Bool;
    /// Whether the upper bound itself is excluded.
    exclusiveMaximum : Bool;
  } ->
  Check Float
foreign pure between from "@flick-lang/runtime/effect/Schema" "isBetween"
  reviewed "effect@4.1.2 sha256:79353aaa06cb14d9"

/// A multiple of the divisor.
multiple_of : Float -> Check Float
foreign pure multiple_of from "@flick-lang/runtime/effect/Schema" "isMultipleOf"
  reviewed "effect@4.1.2 sha256:4fb163cbebd7797c"

/// A safe integer.
int : Check Float
foreign pure int from "@flick-lang/runtime/effect/Schema" "flickIsInt"
  reviewed "effect@4.1.2 sha256:44a60667ef66074f"

/// An integer that fits in 32 signed bits.
int32 : Check Float
foreign pure int32 from "@flick-lang/runtime/effect/Schema" "flickIsInt32"
  reviewed "effect@4.1.2 sha256:d60a1337f9ea88cd"

/// An integer that fits in 32 unsigned bits.
uint32 : Check Float
foreign pure uint32 from "@flick-lang/runtime/effect/Schema" "flickIsUint32"
  reviewed "effect@4.1.2 sha256:341e2c1abc9b152b"

/// Neither `NaN` nor an infinity.
finite : Check Float
foreign pure finite from "@flick-lang/runtime/effect/Schema" "flickIsFinite"
  reviewed "effect@4.1.2 sha256:6e7ca9ed57962346"

/// Greater than the bound.
greater_than_bigint : BigInt -> Check BigInt
foreign pure greater_than_bigint from "@flick-lang/runtime/effect/Schema" "isGreaterThanBigInt"
  reviewed "effect@4.1.2 sha256:c1c72657d7c0895d"

/// At least the bound.
greater_than_or_equal_to_bigint : BigInt -> Check BigInt
foreign pure greater_than_or_equal_to_bigint from "@flick-lang/runtime/effect/Schema" "isGreaterThanOrEqualToBigInt"
  reviewed "effect@4.1.2 sha256:b5a57f80f234caf8"

/// Less than the bound.
less_than_bigint : BigInt -> Check BigInt
foreign pure less_than_bigint from "@flick-lang/runtime/effect/Schema" "isLessThanBigInt"
  reviewed "effect@4.1.2 sha256:4aeed7ff58112503"

/// At most the bound.
less_than_or_equal_to_bigint : BigInt -> Check BigInt
foreign pure less_than_or_equal_to_bigint from "@flick-lang/runtime/effect/Schema" "isLessThanOrEqualToBigInt"
  reviewed "effect@4.1.2 sha256:d73801f2576fd562"

/// Between the bounds; each excluded when its flag is set.
between_bigint :
  {
    /// The lower bound.
    minimum : BigInt;
    /// The upper bound.
    maximum : BigInt;
    /// Whether the lower bound itself is excluded.
    exclusiveMinimum : Bool;
    /// Whether the upper bound itself is excluded.
    exclusiveMaximum : Bool;
  } ->
  Check BigInt
foreign pure between_bigint from "@flick-lang/runtime/effect/Schema" "isBetweenBigInt"
  reviewed "effect@4.1.2 sha256:fc75d2b810b84787"

/// Greater than the bound.
greater_than_decimal : BigDecimal.BigDecimal -> Check BigDecimal.BigDecimal
