  reviewed "effect@4.1.2 sha256:48921469629e24a9"

/// At most `n` code points.
max_code_points : Int -> Check String
foreign pure max_code_points from "@flick-lang/runtime/effect/Schema" "isMaxCodePoints"
  reviewed "effect@4.1.2 sha256:99e66dd2ec37f435"

/// Between `low` and `high` code points, inclusive.
