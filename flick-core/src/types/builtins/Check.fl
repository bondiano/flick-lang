foreign pure code_points_between from "@flick-lang/runtime/effect/Schema" "isBetweenCodePoints"
  reviewed "effect@4.1.2 sha256:f5ae99b4fba2c9fd"

/// Matches the regular expression `source` (no flags); a malformed one is
/// a defect.
pattern : String -> Check String
foreign pure pattern from "@flick-lang/runtime/effect/Schema" "flickIsPattern"
  reviewed "effect@4.1.2 sha256:a4f632a0bc6bade9"

/// Begins with the prefix.
