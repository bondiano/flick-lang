foreign pure starts_with from "@flick-lang/runtime/effect/Schema" "isStartingWith"
  reviewed "effect@4.1.2 sha256:332b1877fa023bba"

/// Ends with the suffix.
ends_with : String -> Check String
foreign pure ends_with from "@flick-lang/runtime/effect/Schema" "isEndingWith"
  reviewed "effect@4.1.2 sha256:ef98d333f7917b04"

/// Contains the text.
includes : String -> Check String
foreign pure includes from "@flick-lang/runtime/effect/Schema" "isIncluding"
  reviewed "effect@4.1.2 sha256:4aa88fc34e688f86"

/// No leading or trailing whitespace.
trimmed : Check String
foreign pure trimmed from "@flick-lang/runtime/effect/Schema" "flickIsTrimmed"
  reviewed "effect@4.1.2 sha256:63bb833d418a1e78"

/// No uppercase letter.
lowercased : Check String
foreign pure lowercased from "@flick-lang/runtime/effect/Schema" "flickIsLowercased"
  reviewed "effect@4.1.2 sha256:cf510ad98cb838ba"

/// No lowercase letter.
uppercased : Check String
foreign pure uppercased from "@flick-lang/runtime/effect/Schema" "flickIsUppercased"
  reviewed "effect@4.1.2 sha256:b10ba778ac9d8838"

/// The first character is not lowercase.
capitalized : Check String
foreign pure capitalized from "@flick-lang/runtime/effect/Schema" "flickIsCapitalized"
  reviewed "effect@4.1.2 sha256:d7c771b8ecef258d"

/// The first character is not uppercase.
uncapitalized : Check String
foreign pure uncapitalized from "@flick-lang/runtime/effect/Schema" "flickIsUncapitalized"
  reviewed "effect@4.1.2 sha256:882ff1774bfbe675"

/// A UUID, of the version given or of any.
uuid : Option Int -> Check String
foreign pure uuid from "@flick-lang/runtime/effect/Schema" "isUUID"
  optional 0
