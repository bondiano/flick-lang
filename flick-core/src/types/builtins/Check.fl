/// Checks of decoded values: Effect Schema's filters as values, applied to
/// a codec by `apply`: `String.json |> Check.apply (Check.min_length 3)`.
/// The strict JSON Schema exporter states a check only when its keywords
/// are exact, and refuses it otherwise.
module Check exposing (..)

/// A check of values of type `a`.
type Check a

/// The codec, accepting only values that pass the check both ways.
apply : Check a -> PureCodec i a -> PureCodec i a
foreign pure apply from "@flick-lang/runtime/effect/Schema" "flickCheck"
  reviewed "effect@4.1.2 sha256:bfef4982ef0cbdbc"

/// All of the checks, reported together.
all : NonEmpty.NonEmpty (Check a) -> Check a
foreign pure all from "@flick-lang/runtime/effect/Schema" "makeFilterGroup"
  reviewed "effect@4.1.2 sha256:a32bb44f8aa2efa9"

/// A check by a pure predicate, failing with `message`; it has no JSON
/// Schema form.
predicate : (a -> Bool) -> String -> Check a
foreign pure predicate from "@flick-lang/runtime/effect/Schema" "flickMakeFilter"
  reviewed "effect@4.1.2 sha256:7eab283772e9e378"

/// At least `n` UTF-16 code units.
min_length : Int -> Check String
foreign pure min_length from "@flick-lang/runtime/effect/Schema" "isMinLength"
  reviewed "effect@4.1.2 sha256:f1d7a04512c67b3e"

/// At most `n` UTF-16 code units.
max_length : Int -> Check String
foreign pure max_length from "@flick-lang/runtime/effect/Schema" "isMaxLength"
  reviewed "effect@4.1.2 sha256:24a60bba09eeaf98"

/// Between `low` and `high` UTF-16 code units, inclusive.
length_between : Int -> Int -> Check String
foreign pure length_between from "@flick-lang/runtime/effect/Schema" "isBetweenLength"
  reviewed "effect@4.1.2 sha256:3c385000227a76d5"

/// Not the empty string.
