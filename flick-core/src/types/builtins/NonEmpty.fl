/// Lists with at least one element.
module NonEmpty exposing (NonEmpty, from_list, singleton, cons, head, to_list, length, map)

/// A list with at least one element, represented as the list.
type NonEmpty a

from_list : List a -> Option (NonEmpty a)
foreign pure from_list from "@flick-lang/runtime" "nonEmptyFromList"

singleton : a -> NonEmpty a
foreign pure singleton from "@flick-lang/runtime" "listSingleton"

cons : a -> List a -> NonEmpty a
foreign pure cons from "@flick-lang/runtime" "nonEmptyCons"

head : NonEmpty a -> a
foreign pure head from "@flick-lang/runtime" "nonEmptyHead"

to_list : NonEmpty a -> List a
foreign pure to_list from "@flick-lang/runtime" "identity"

length : NonEmpty a -> Number
foreign pure length from "@flick-lang/runtime" "listLength"

map : forall c a b. (a -> b)^c -> (NonEmpty a -> NonEmpty b)^c
foreign pure map from "@flick-lang/runtime" "listMap"
  arity 2

instance Eq a => Eq (NonEmpty a) =
  eq : NonEmpty a -> NonEmpty a -> Bool
  let eq x y = eq (to_list x) (to_list y)

instance Show a => Show (NonEmpty a) =
  show : NonEmpty a -> String
  let show x = "NonEmpty " ++ show (to_list x)
