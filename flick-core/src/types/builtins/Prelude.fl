/// Built-in types and constructors; every module
/// sees them without an import.
module Prelude exposing (..)

type Unit
type Never
type Bool
type Number
type BigInt
type String
type Unknown

/// Any JS value, as it comes from foreign code: getters, proxies, cycles
/// and all. `Js.snapshot` turns supported data into an `Unknown`.
type JsValue
type List a
type Ref a
type Redacted a
type Schema a
type PureCodec i a
type Eff (r : ServiceRow) (e : ErrorRow) a
type Layer (ri : ServiceRow) (e : ErrorRow) (ro : ServiceRow)
type Codec (rd : ServiceRow) (re : ServiceRow) i a
type Errors (e : ErrorRow)

/// A user interface: see the module `Ui`.
type Ui

/// A service named as a value, as in `Layer.succeed Clock clock_impl`.
type ServiceTag (r : ServiceRow)

/// The owner of what a `scope` acquires: an operation that acquires a
/// resource of region `s` needs `Scope s`, which the innermost `scope`
/// provides. It has no operations of its own.
service Scope (s : Region)

/// The implementation record of the one service of `r`:
/// `ServiceImpl {Clock}` is `Clock.Impl`.
type ServiceImpl (r : ServiceRow)

type Option a = None | Some a

type Result e a = Err e | Ok a

type Ordering = LT | EQ | GT

/// Canonical equality; `Eq Number` is SameValueZero, like `==`.
class Eq a =
  eq : a -> a -> Bool

/// A total order that agrees with `Eq`.
class Eq a => Ord a =
  compare : a -> a -> Ordering

/// Equal values have equal hashes.
class Eq a => Hash a =
  hash : a -> Number

class Show a =
  show : a -> String

/// Containers whose elements a pure function maps. A container may apply
/// the function later, so the result keeps the captures of both.
class Functor (f : Type -> Type) =
  map : forall c d a b. (a -> b)^c -> ((f a)^d -> (f b)^(c + d))^c

/// Containers folded from the first element to the last.
class Foldable (f : Type -> Type) =
  fold : forall c a b. (b -> a -> b)^c -> (b -> (f a -> b)^c)^c

/// Containers whose elements a runtime function maps, one after another
/// from the first.
class Functor f => Traversable (f : Type -> Type) =
  traverse : forall c a b r e. (a ->{r; e} b)^c -> (f a ->{r; e} f b)^c

class Functor f => Applicative (f : Type -> Type) =
  return : forall a. a -> f a
  /// `f` of the values of both, in order: for `List`, every pair.
  map2 :
    forall c d a b x. (a -> b -> x)^c -> ((f a)^d -> ((f b)^d -> (f x)^(c + d))^(c + d))^c

class Applicative m => Monad (m : Type -> Type) =
  flat_map : forall c d a b. (a -> (m b)^d)^c -> ((m a)^d -> (m b)^(c + d))^c

/// Applicative containers with a choice: `nothing` holds no value, and
/// `or_else` keeps the first that holds one (`List` keeps both).
class Applicative f => Alternative (f : Type -> Type) =
  nothing : forall a. f a
  or_else : forall a. f a -> f a -> f a

/// Values with an associative `combine`.
class Semigroup a =
  combine : a -> a -> a

/// A `Semigroup` whose `empty` changes nothing it is combined with.
class Semigroup a => Monoid a =
  empty : a

/// How a computation ended: its value, or how it failed (`Exit.value`,
/// `Exit.failure`).
type Exit (e : ErrorRow) a

/// How a computation failed, as a supervisor or `Exit.failure` sees it:
/// opaque, read through `Failure.primary` and `Failure.inspect`.
type Failure (e : ErrorRow)

/// The whole native cause of a failure, for diagnostics only.
type RawCause

/// An inert report of a cause: the kind of each reason, safe tags and text.
type CauseReport

/// The error of a computation that ran out of time.
type error TimeoutError

/// A JSON value: what a JSON codec reads and writes.
type Json

/// What a schema check found wrong, and where: `profile.email`.
type alias SchemaIssue = { message : String; path : String }

/// Decoding or encoding failed; the issues name the paths, never the value.
type error SchemaError = SchemaError (List SchemaIssue)

/// One field of a `codec` block: its wire name, its codec and its policy for
/// a missing key; decoding it may need the services `rd`.
type FieldCodec (rd : ServiceRow) a

/// The error an application fails with through `App.fail`.
type error AppError = AppError { message : String; details : Option String }

identity : a -> a
let identity value = value

/// Fails with the error of an `Err`: `Result NotFound a` has the error row
/// `{NotFound}`.
from_result : Result (Errors e) a ->{; e} a
foreign effect from_result from "@flick-lang/runtime" "fromResult"
  reviewed "effect@4.0.5 sha256:5776a5b0ab051f96"

/// Runs both, as children: on a failure the other one is interrupted and
/// awaited. The results keep the order of the arguments.
parallel :
  forall c r e a b. (Eff r e a)^c -> ((Eff r e b)^c ->{r; e} (a, b))^c
foreign effect parallel from "@flick-lang/runtime" "parallel"
  retention call

/// Runs every task, at most `limit` at a time; `limit` must be a positive
/// finite integer. The results keep the order of the input.
parallel_all : forall c r e a. Number -> List ((Eff r e a)^c) ->{r; e} List a
foreign effect parallel_all from "@flick-lang/runtime" "parallelAll"
  retention call

/// Each task's typed failure as an `Err`; a defect or an interruption still
/// stops the group.
parallel_results :
  forall c r e a. List ((Eff r e a)^c) ->{r; none} List (Result (Errors e) a)
foreign effect parallel_results from "@flick-lang/runtime" "parallelResults"
  retention call

/// The opaque exit of every task.
parallel_exits : forall c r e a. List ((Eff r e a)^c) ->{r; none} List (Exit e a)
foreign effect parallel_exits from "@flick-lang/runtime" "parallelExits"
  retention call

/// The first task to succeed; the loser is interrupted and awaited.
race_success :
  forall c r e a. (Eff r e a)^c -> ((Eff r e a)^c ->{r; e} a)^c
foreign effect race_success from "@flick-lang/runtime" "raceSuccess"
  retention call
  reviewed "effect@4.0.5 sha256:ac5b5886f22dc7c6"

/// The first task to end, however it ends.
race_first : forall c r e a. (Eff r e a)^c -> ((Eff r e a)^c ->{r; e} a)^c
foreign effect race_first from "@flick-lang/runtime" "raceFirst"
  retention call
  reviewed "effect@4.0.5 sha256:5247faa250c6adc7"

/// Fails with `TimeoutError` when `millis` pass before the task ends.
timeout : forall c r e a. Number -> (Eff r e a)^c ->{r; TimeoutError | e} a
foreign effect timeout from "@flick-lang/runtime" "timeout"
  retention call
  reviewed "effect@4.0.5 sha256:297e05405fa2e747"

/// `None` when `millis` pass before the task ends; other failures stay.
timeout_option : forall c r e a. Number -> (Eff r e a)^c ->{r; e} Option a
foreign effect timeout_option from "@flick-lang/runtime" "timeoutOption"
  retention call
  reviewed "effect@4.0.5 sha256:35e1a71b230ac8e2"

/// `ma` followed by `f` of its value, for any monad.
bind :
  forall c d m a b.
  Monad m => (m a)^c ->
  ((a -> (m b)^d)^d -> (m b)^(c + d))^c
let bind ma f = flat_map f ma

/// A task followed by `f` of its value; the rows of both join.
bind_eff :
  forall c d r1 r2 e1 e2 a b.
  (Eff r1 e1 a)^c ->
  ((a -> (Eff r2 e2 b)^d)^d ->
    (Eff (r1 + r2) (e1 + e2) b)^(c + d))^c
foreign pure bind_eff from "@flick-lang/runtime" "bindEff"
  arity 2
  retention call

/// A field under the wire name `wire`: the key must be present.
field : String -> PureCodec Json a -> FieldCodec none a
foreign pure field from "@flick-lang/runtime" "dslField"
  reviewed "effect@4.0.5 sha256:e623c16c7b6244f7"

/// A field that may be missing: missing is `None`, `None` is not written.
optional_field : String -> PureCodec Json a -> FieldCodec none (Option a)
foreign pure optional_field from "@flick-lang/runtime" "dslOptionalField"
  reviewed "effect@4.0.5 sha256:6f386babb608471d"

/// A field whose codec may need services to decode.
field_effect : String -> Codec rd none Json a -> FieldCodec rd a
foreign pure field_effect from "@flick-lang/runtime" "dslFieldEffect"

/// `null` is `None`; a missing key is an error.
option_as_null : PureCodec Json a -> PureCodec Json (Option a)
foreign pure option_as_null from "@flick-lang/runtime" "codecOptionNull"
  reviewed "effect@4.0.5 sha256:833c83dfb847977e"

/// `null` and a missing key are `None`; `None` is written as `null`.
option_as_nullish : PureCodec Json a -> PureCodec Json (Option a)
foreign pure option_as_nullish from "@flick-lang/runtime" "codecOptionNullish"
  reviewed "effect@4.0.5 sha256:038a29f7741a127f"

/// A missing key decodes to `default ()`, called once per decode; `null` or
/// a wrong value is still an error.
on_missing : forall c rd a. (Unit -> a)^c -> (FieldCodec rd a -> FieldCodec rd a)^c
foreign pure on_missing from "@flick-lang/runtime" "dslOnMissing"
  arity 2
  retention call
  reviewed "effect@4.0.5 sha256:f0155391ca2658bc"

/// `on_missing` with a runtime default, whose services decoding then needs.
on_missing_effect :
  forall c r rd a.
  (Unit ->{r; SchemaError} a)^c -> (FieldCodec rd a -> FieldCodec (rd + r) a)^c
foreign pure on_missing_effect from "@flick-lang/runtime" "dslOnMissingEffect"
  arity 2
  retention call
  reviewed "effect@4.0.5 sha256:f0155391ca2658bc"

/// The codec of a `codec` block, dropping keys it does not name instead of
/// refusing them.
ignore_extra_fields : PureCodec Json a -> PureCodec Json a
foreign pure ignore_extra_fields from "@flick-lang/runtime" "codecIgnoreExtra"
