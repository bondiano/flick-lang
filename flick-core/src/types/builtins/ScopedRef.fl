/// Effect's `ScopedRef`: a reference to a resource that `set` replaces,
/// releasing the previous one. The last resource is released when the
/// `scope` owning the reference's region closes.
module ScopedRef exposing (..)

/// A reference of region `s` to a resource of `a`.
type ScopedRef (s : Region) a

/// A reference owned by the innermost `scope` (or the one of region `s`),
/// holding the resource `acquire` gives.
from_acquire : forall c s r e a. (Eff r e a)^c ->{Scope s | r; e} ScopedRef s a
foreign effect from_acquire from "@flick-lang/runtime/effect/ScopedRef" "fromAcquire"
  retention call
  reviewed "effect@4.0.5 sha256:1c33b94716042fb2"

/// A reference holding `f ()`, which needs no release.
make : forall c s a. (Unit -> a)^c ->{Scope s;} ScopedRef s a
foreign effect make from "@flick-lang/runtime/effect/ScopedRef" "make"
  retention call
  reviewed "effect@4.0.5 sha256:08ddb0a145dd95ab"

/// The current resource.
get : forall s a. ScopedRef s a ->{} a
foreign effect get from "@flick-lang/runtime/effect/ScopedRef" "get"
  retention call
  reviewed "effect@4.0.5 sha256:d7696b1c832538c0"

/// Acquires a new resource with `acquire` and releases the previous one;
/// if `acquire` fails, the previous one stays.
set : forall c s r e a. (Eff r e a)^c -> (ScopedRef s a ->{r; e} Unit)^c
foreign effect set from "@flick-lang/runtime/effect/ScopedRef" "set"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:317987717da02276"
