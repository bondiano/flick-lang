/// Traversals of graphs as walkers, read with `indices`, `values` and
/// `entries`. A start node that is missing or an invalid radius is a
/// `GraphError`.
module Graph.Walk exposing (..)

import Graph.Types exposing (..)

/// Depth-first from `start` (default: nothing), along `direction` (default
/// outgoing), at most `radius` steps.
dfs : SearchConfig -> Graph n e k -> Result GraphError (NodeWalker n)
foreign pure dfs from "@flick-lang/runtime/effect/Graph" "flickDfs"
  reviewed "effect@4.0.5 sha256:b9ca82abbc9e02a7"

/// Breadth-first, as `dfs` is depth-first.
bfs : SearchConfig -> Graph n e k -> Result GraphError (NodeWalker n)
foreign pure bfs from "@flick-lang/runtime/effect/Graph" "flickBfs"
  reviewed "effect@4.0.5 sha256:82b74e2641ec8cd3"

/// Depth-first, each node after the nodes it leads to.
dfs_post_order : SearchConfig -> Graph n e k -> Result GraphError (NodeWalker n)
foreign pure dfs_post_order from "@flick-lang/runtime/effect/Graph" "flickDfsPostOrder"
  reviewed "effect@4.0.5 sha256:4e0d3888799beaa1"

/// Each node before the nodes it leads to, from `initials` (default: the
/// nodes without incoming edges); a cycle, or an initial node with incoming
/// edges, is an error.
topo : TopoConfig -> Graph n e Directed -> Result GraphError (NodeWalker n)
foreign pure topo from "@flick-lang/runtime/effect/Graph" "flickTopo"
  reviewed "effect@4.0.5 sha256:f98e4271cb53a5d8"

/// Every node, in index order.
nodes : Graph n e k -> NodeWalker n
foreign pure nodes from "@flick-lang/runtime/effect/Graph" "nodes"
  reviewed "effect@4.0.5 sha256:5b7aa18f6ad5bd6c"

/// Every edge, in index order.
edges : Graph n e k -> EdgeWalker e
foreign pure edges from "@flick-lang/runtime/effect/Graph" "edges"
  reviewed "effect@4.0.5 sha256:b4886bcba543b7b4"

/// The nodes without edges in the direction (default outgoing).
externals : ExternalsConfig -> Graph n e k -> NodeWalker n
foreign pure externals from "@flick-lang/runtime/effect/Graph" "flickExternals"
  reviewed "effect@4.0.5 sha256:d719ff55263572fc"

/// The indices a walker visits, in order.
indices : Walker t a -> List t
foreign pure indices from "@flick-lang/runtime/effect/Graph" "flickIndices"
  reviewed "effect@4.0.5 sha256:c746fbd13ca4b96f"

/// The data a walker visits, in order.
values : Walker t a -> List a
foreign pure values from "@flick-lang/runtime/effect/Graph" "flickValues"
  reviewed "effect@4.0.5 sha256:f3f499b9e9ac29cc"

/// The index and data of each visit, in order.
entries : Walker t a -> List (t, a)
foreign pure entries from "@flick-lang/runtime/effect/Graph" "flickEntries"
  reviewed "effect@4.0.5 sha256:65ad6c755e7dbcc0"
