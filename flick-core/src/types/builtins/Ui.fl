/// User interfaces as values. A `Ui` describes elements and the handlers
/// of their events; building one runs no handler and reads no state.
/// `Ui.Dom.mount` renders it with React and runs each event as a task under
/// the policy of its handler (`Action`, `Ui.Event`). Inside `ui { … }` the
/// names of this module need no `Ui.`.
module Ui exposing (..)

/// What handles DOM events with snapshot `s`: a task per event under a
/// concurrency policy. Only `Ui.Event.exhaust`, `latest`, `queue` and
/// `concurrent` and their `Action` forms make one, so no handler is
/// fire-and-forget. A handler's task writes atoms and nothing else: it
/// provides any other service itself and handles its own errors.
type Handler s

/// A click, as an inert copy of the DOM event.
type alias ClickSnapshot =
  { button : Number; alt : Bool; ctrl : Bool; shift : Bool; meta : Bool }

/// The text of an input after an edit.
type alias InputSnapshot = { value : String }

/// A tab of `tabs`: a label and its content.
type Tab

/// A URL with a safe scheme (`http`, `https`, `mailto`) or relative.
type SafeUrl

/// HTML trusted to be safe; nothing checks it.
type SanitizedHtml

/// A React renderer factory bound with `foreign pure`. It is called when
/// `mount_with` starts and returns `render(node)` and `unmount()` operations;
/// importing it does not mount a root. The adapter supplies its host nodes.
type Renderer

/// A React component of foreign code taking props `p`, bound with
/// `foreign pure`: Flick renders it and never calls it.
type Component p

/// The props of `button`.
type alias ButtonProps c =
  { disabled : Bool; on_click : (Handler ClickSnapshot)^c }

/// The props of `input`.
type alias InputProps c =
  { value : String; placeholder : String; on_input : (Handler InputSnapshot)^c }

/// The props of `select`: every field speaks of the same `a`.
type alias SelectProps a c =
  {
    items : List a;
    selected : Option a;
    key : (a -> String)^c;
    render_item : (a -> Ui^c)^c;
    on_change : (Handler a)^c;
  }

/// The named places of `panel`.
type alias PanelSlots c =
  { header : Ui^c; body : Ui^c; footer : Option (Ui^c) }

/// Text through the text channel: markup in it stays text.
text : String -> Ui
foreign pure text from "@flick-lang/runtime/ui/react" "uiText"

/// No node at all.
empty : Ui
let empty = fragment []

fragment : forall c. List (Ui^c) -> Ui^c
foreign pure fragment from "@flick-lang/runtime/ui/react" "uiFragment"
  retention call

/// The node, or nothing.
optional : forall c. Option (Ui^c) -> Ui^c
foreign pure optional from "@flick-lang/runtime/ui/react" "uiOptional"
  retention call

/// The React key of a node in a dynamic list: metadata, not a prop.
keyed : forall c. String -> Ui^c -> Ui^c
foreign pure keyed from "@flick-lang/runtime/ui/react" "uiKeyed"
  retention call

div : forall c. { class_name : String } -> List (Ui^c) -> Ui^c
foreign pure div from "@flick-lang/runtime/ui/react" "uiDiv"
  retention call

span : forall c. { class_name : String } -> List (Ui^c) -> Ui^c
foreign pure span from "@flick-lang/runtime/ui/react" "uiSpan"
  retention call

paragraph : forall c. List (Ui^c) -> Ui^c
foreign pure paragraph from "@flick-lang/runtime/ui/react" "uiParagraph"
  retention call

heading : forall c. List (Ui^c) -> Ui^c
foreign pure heading from "@flick-lang/runtime/ui/react" "uiHeading"
  retention call

list : forall c. List (Ui^c) -> Ui^c
foreign pure list from "@flick-lang/runtime/ui/react" "uiList"
  retention call

item : forall c. List (Ui^c) -> Ui^c
foreign pure item from "@flick-lang/runtime/ui/react" "uiItem"
  retention call

button : forall c. ButtonProps c -> List (Ui^c) -> Ui^c
foreign pure button from "@flick-lang/runtime/ui/react" "uiButton"
  retention call

/// A text input; it has no children.
input : forall c. InputProps c -> Ui^c
foreign pure input from "@flick-lang/runtime/ui/react" "uiInput"
  retention call

/// A text area of several lines; like `input`, `value` is the initial text.
textarea : forall c. InputProps c -> Ui^c
foreign pure textarea from "@flick-lang/runtime/ui/react" "uiTextarea"
  retention call

/// Preformatted text: spaces and line breaks are kept.
pre : forall c. { class_name : String } -> List (Ui^c) -> Ui^c
foreign pure pre from "@flick-lang/runtime/ui/react" "uiPre"
  retention call

link : forall c. { href : SafeUrl } -> List (Ui^c) -> Ui^c
foreign pure link from "@flick-lang/runtime/ui/react" "uiLink"
  retention call

/// Trusted HTML, inside a `div`.
html : SanitizedHtml -> Ui
foreign pure html from "@flick-lang/runtime/ui/react" "uiHtml"

/// A listbox of `items`; choosing one runs `on_change` with it.
select : forall c a. SelectProps a c -> Ui^c
foreign pure select from "@flick-lang/runtime/ui/react" "uiSelect"
  retention call

/// Header, body and an optional footer, each in its place.
panel : forall c. PanelSlots c -> Ui^c
foreign pure panel from "@flick-lang/runtime/ui/react" "uiPanel"
  retention call

tab : forall c. String -> Ui^c -> Tab^c
foreign pure tab from "@flick-lang/runtime/ui/react" "uiTab"
  retention call

/// At least one tab; `selected` counts from 0.
tabs : forall c. { selected : Number } -> NonEmpty.NonEmpty (Tab^c) -> Ui^c
foreign pure tabs from "@flick-lang/runtime/ui/react" "uiTabs"
  retention call

/// A foreign component with its props, which React gets as they are.
component : forall p. Component p -> p -> Ui
foreign pure component from "@flick-lang/runtime/ui/react" "uiComponent"

/// The URL if its scheme is safe.
safe_url : String -> Option SafeUrl
foreign pure safe_url from "@flick-lang/runtime/ui/react" "uiSafeUrl"

/// HTML the program vouches for: it is inserted as it is.
trusted_html : String -> SanitizedHtml
foreign pure trusted_html from "@flick-lang/runtime/ui/react" "uiTrustedHtml"

/// Like `Ui.Dom.mount`, with a renderer factory instead of a DOM container.
/// The factory is called only when this runtime call starts; the registry,
/// events, supervision and cleanup are the same. The DOM helpers of this
/// module still build DOM nodes, not host-neutral primitives; a native
/// adapter supplies its own components.
mount_with :
  forall c r.
  Renderer ->
    (Failure none ->{r; none} Unit)^c ->
    Ui^c ->{Reactivity.Atom.Registry, Atom.Write | r; none}
    Never
foreign effect mount_with from "@flick-lang/runtime/ui/react" "uiMountWith"
  retention call

/// A component that reads atoms while it renders: React renders it again
/// when one of them changes, or when its props do.
type View p

/// The component of `render`.
view : forall c p. (p ->{Atom.Read;} Ui^c)^c -> (View p)^c
foreign pure view from "@flick-lang/runtime/ui/react" "uiView"
  retention call

/// The component named `name` in React's developer tools.
named : forall c p. String -> (View p)^c -> (View p)^c
foreign pure named from "@flick-lang/runtime/ui/react" "uiNamed"
  retention call

/// The component with the props `props`.
render : forall c p. (View p)^c -> p^c -> Ui^c
foreign pure render from "@flick-lang/runtime/ui/react" "uiRender"
  retention call

/// The props of a field bound to a state.
type alias FieldProps c =
  {
    bind : Atom.Writable String;
    placeholder : String;
    on_input : Option ((Handler InputSnapshot)^c);
  }

/// An input showing the state `bind`. Each keystroke writes it at once,
/// inside the browser's event, so the caret and an IME composition stay
/// where the user left them; a write to the state from elsewhere, a reset,
/// shows in the field. `on_input` then runs as a task.
field : forall c. FieldProps c -> Ui^c
foreign pure field from "@flick-lang/runtime/ui/react" "uiField"
  retention call

/// A text area bound to a state as `field` is.
field_area : forall c. FieldProps c -> Ui^c
foreign pure field_area from "@flick-lang/runtime/ui/react" "uiFieldArea"
  retention call

/// How a live region announces its changes.
type Live = Polite | Assertive | Off
  deriving Eq, Show

/// Host attributes an element may carry beside its props: its identity and
/// class (`class_name` replaces the one its props give), accessibility,
/// text-entry hints and `data-*` attributes. `host` sets
/// none: `with_host { host with role = Some "status" } node`.
type alias Host =
  {
    id : Option String;
    class_name : Option String;
    role : Option String;
    aria_label : Option String;
    aria_describedby : Option String;
    aria_hidden : Option Bool;
    aria_pressed : Option Bool;
    aria_live : Option Live;
    tab_index : Option Number;
    data : List (String, String);
    auto_capitalize : Option Bool;
    auto_correct : Option Bool;
    wrap : Option Bool;
  }

/// No host attribute.
host : Host
let host =
  {
    id = None;
    class_name = None;
    role = None;
    aria_label = None;
    aria_describedby = None;
    aria_hidden = None;
    aria_pressed = None;
    aria_live = None;
    tab_index = None;
    data = [];
    auto_capitalize = None;
    auto_correct = None;
    wrap = None;
  }

/// The element `node` with the host attributes `attrs`; `data` names are
/// lowercase letters, digits and hyphens, written `data-<name>`. A node
/// that is not an element is a defect.
with_host : forall c. Host -> Ui^c -> Ui^c
foreign pure with_host from "@flick-lang/runtime/ui/react" "uiWithHost"
  retention call

/// The level of a heading, `h1` to `h6`.
type Level = H1 | H2 | H3 | H4 | H5 | H6
  deriving Eq, Show

/// A heading of the level.
heading_at : forall c. Level -> List (Ui^c) -> Ui^c
foreign pure heading_at from "@flick-lang/runtime/ui/react" "uiHeadingAt"
  retention call

/// A view whose render may read tasks with `Atom.ready`: while one loads
/// it shows `fallback`, and when one failed it shows `failed` of the
/// failure, so each error of `x` has a place to go.
suspended :
  forall p x. (Failure x -> Ui) -> Ui -> (p ->{Atom.Read; x} Ui) -> View p
foreign pure suspended from "@flick-lang/runtime/ui/react" "uiSuspended"
