/// User interfaces as values. A `Ui` describes elements and the handlers
/// of their events; building one runs no handler and reads no state.
/// `Ui.Dom.mount` renders it with React and runs each event as a task under
/// the policy of its handler (`Action`, `Ui.Event`). Inside `ui { … }` the
/// names of this module need no `Ui.`, and a `Component p` takes its props
/// directly: `badge props` means `Ui.component badge props`.
module Ui exposing (..)

/// What handles DOM events with snapshot `s`: a task per event under a
/// concurrency policy. Only `Ui.Event.exhaust`, `latest`, `queue` and
/// `concurrent` and their `Action` forms make one, so no handler is
/// fire-and-forget. A handler's task writes atoms and nothing else: it
/// provides any other service itself and handles its own errors.
type Handler s

/// A click, as an inert copy of the DOM event: the mouse button (0 the main
/// one, 1 the wheel, 2 the secondary one) and whether Alt (Option), Control,
/// Shift and Meta (Command, Windows) were held.
type alias ClickSnapshot = { button : Int; alt : Bool; ctrl : Bool; shift : Bool; meta : Bool }

/// The text of an input after an edit.
type alias InputSnapshot = {
  /// The whole text, as the input holds it now.
  value : String;
}

/// A tab of `tabs`: a label and its content.
type Tab

/// A URL with a safe scheme (`http`, `https`, `mailto`) or relative.
type SafeUrl

/// HTML trusted to be safe; nothing checks it.
type SanitizedHtml

/// A React renderer factory bound with `foreign pure`: `mount_with` calls it
/// for `render(node)` and `unmount()`; importing it mounts nothing.
type Renderer

/// A React component of foreign code taking props `p`, bound with
/// `foreign pure`: Flick renders it and never calls it.
type Component p

/// The props of `div`, `span` and `pre`.
type alias ElementProps = {
  /// The CSS classes of the element, separated by spaces: its `class`
  /// attribute.
  class_name : String;
}

/// The props of `link`.
type alias LinkProps = {
  /// Where the link goes: a URL with a safe scheme, or a relative one.
  href : SafeUrl;
}

/// The props of `image`: a URL with a safe scheme or a relative one, the
/// text that stands for it, and its CSS classes.
type alias ImageProps = { src : SafeUrl; alt : String; class_name : String }

/// The props of `form`: what runs on a submit, by Enter or by `submit`;
/// the page never reloads.
type alias FormProps c = { on_submit : (Handler Unit)^c }

/// The props of `submit`.
type alias SubmitProps = { disabled : Bool }

/// The props of `tabs`.
type alias TabsProps = {
  /// The tab shown, counting from 0.
  selected : Int;
}

/// The props of `button`.
type alias ButtonProps c = {
  /// Whether the button is greyed out and ignores clicks.
  disabled : Bool;
  /// What runs on each click, with a copy of it.
  on_click : (Handler ClickSnapshot)^c;
}

/// The props of `input`.
type alias InputProps c = {
  /// The initial text: later edits do not reset it.
  value : String;
  /// The hint shown while the input is empty.
  placeholder : String;
  /// What runs after each edit, with the new text.
  on_input : (Handler InputSnapshot)^c;
}

/// The props of `select`: every field speaks of the same `a`.
type alias SelectProps a c = {
  /// The choices, in the order they are listed.
  items : List a;
  /// The item shown as chosen, if any: the one with its `key`.
  selected : Option a;
  /// What tells the items apart: their React key, which finds `selected`.
  key : (a -> String)^c;
  /// How an item is shown in the list.
  render_item : (a -> Ui^c)^c;
  /// What runs when an item is chosen, with that item.
  on_change : (Handler a)^c;
}

/// The named places of `panel`.
type alias PanelSlots c = {
  /// The top of the panel.
  header : Ui^c;
  /// The content of the panel.
  body : Ui^c;
  /// The bottom of the panel, when there is one.
  footer : Option (Ui^c);
}

/// Text through the text channel: markup in it stays text.
text : String -> Ui
foreign pure text from "@flick-lang/runtime/ui/react" "uiText"

/// No node at all.
empty : Ui
let empty = fragment []

fragment : forall c. List (Ui^c) -> Ui^c
foreign pure fragment from "@flick-lang/runtime/ui/react" "uiFragment"
  retention call

/// The node, or nothing.
optional : forall c. Option (Ui^c) -> Ui^c
foreign pure optional from "@flick-lang/runtime/ui/react" "uiOptional"
  retention call

/// The React key of a node in a dynamic list: metadata, not a prop.
keyed : forall c. String -> Ui^c -> Ui^c
foreign pure keyed from "@flick-lang/runtime/ui/react" "uiKeyed"
  retention call

div : forall c. ElementProps -> List (Ui^c) -> Ui^c
foreign pure div from "@flick-lang/runtime/ui/react" "uiDiv"
  retention call

span : forall c. ElementProps -> List (Ui^c) -> Ui^c
foreign pure span from "@flick-lang/runtime/ui/react" "uiSpan"
  retention call

paragraph : forall c. List (Ui^c) -> Ui^c
foreign pure paragraph from "@flick-lang/runtime/ui/react" "uiParagraph"
  retention call

heading : forall c. List (Ui^c) -> Ui^c
foreign pure heading from "@flick-lang/runtime/ui/react" "uiHeading"
  retention call

list : forall c. List (Ui^c) -> Ui^c
foreign pure list from "@flick-lang/runtime/ui/react" "uiList"
  retention call

item : forall c. List (Ui^c) -> Ui^c
foreign pure item from "@flick-lang/runtime/ui/react" "uiItem"
  retention call

button : forall c. ButtonProps c -> List (Ui^c) -> Ui^c
foreign pure button from "@flick-lang/runtime/ui/react" "uiButton"
  retention call

/// A text input; it has no children.
input : forall c. InputProps c -> Ui^c
foreign pure input from "@flick-lang/runtime/ui/react" "uiInput"
  retention call

/// A text area of several lines; like `input`, `value` is the initial text.
textarea : forall c. InputProps c -> Ui^c
foreign pure textarea from "@flick-lang/runtime/ui/react" "uiTextarea"
  retention call

/// Preformatted text: spaces and line breaks are kept.
pre : forall c. ElementProps -> List (Ui^c) -> Ui^c
foreign pure pre from "@flick-lang/runtime/ui/react" "uiPre"
  retention call

link : forall c. LinkProps -> List (Ui^c) -> Ui^c
foreign pure link from "@flick-lang/runtime/ui/react" "uiLink"
  retention call

nav : forall c. ElementProps -> List (Ui^c) -> Ui^c
foreign pure nav from "@flick-lang/runtime/ui/react" "uiNav"
  retention call

footer : forall c. ElementProps -> List (Ui^c) -> Ui^c
foreign pure footer from "@flick-lang/runtime/ui/react" "uiFooter"
  retention call

fieldset : forall c. ElementProps -> List (Ui^c) -> Ui^c
foreign pure fieldset from "@flick-lang/runtime/ui/react" "uiFieldset"
  retention call

/// The `i` element of an icon font, which its classes name.
icon : ElementProps -> Ui
foreign pure icon from "@flick-lang/runtime/ui/react" "uiIcon"

/// A thematic break, `hr`.
hr : Ui
foreign pure hr from "@flick-lang/runtime/ui/react" "uiHr"

image : ImageProps -> Ui
foreign pure image from "@flick-lang/runtime/ui/react" "uiImage"

form : forall c. FormProps c -> List (Ui^c) -> Ui^c
foreign pure form from "@flick-lang/runtime/ui/react" "uiForm"
  retention call

/// The button that submits the `form` around it.
submit : forall c. SubmitProps -> List (Ui^c) -> Ui^c
foreign pure submit from "@flick-lang/runtime/ui/react" "uiSubmit"
  retention call

/// Trusted HTML, inside a `div`.
html : SanitizedHtml -> Ui
foreign pure html from "@flick-lang/runtime/ui/react" "uiHtml"

/// A listbox of `items`; choosing one runs `on_change` with it.
select : forall c a. SelectProps a c -> Ui^c
foreign pure select from "@flick-lang/runtime/ui/react" "uiSelect"
  retention call

/// Header, body and an optional footer, each in its place.
panel : forall c. PanelSlots c -> Ui^c
foreign pure panel from "@flick-lang/runtime/ui/react" "uiPanel"
  retention call

tab : forall c. String -> Ui^c -> Tab^c
foreign pure tab from "@flick-lang/runtime/ui/react" "uiTab"
  retention call

/// At least one tab; `selected` counts from 0.
tabs : forall c. TabsProps -> NonEmpty.NonEmpty (Tab^c) -> Ui^c
foreign pure tabs from "@flick-lang/runtime/ui/react" "uiTabs"
  retention call

/// A foreign component with its props, which React gets as they are.
/// Inside `ui { … }`, `value props` inserts this operation automatically
/// when `value` has type `Component p`; the component itself stays opaque.
component : forall p. Component p -> p -> Ui
foreign pure component from "@flick-lang/runtime/ui/react" "uiComponent"

/// The URL if its scheme is safe.
safe_url : String -> Option SafeUrl
foreign pure safe_url from "@flick-lang/runtime/ui/react" "uiSafeUrl"

/// HTML the program vouches for: it is inserted as it is.
trusted_html : String -> SanitizedHtml
foreign pure trusted_html from "@flick-lang/runtime/ui/react" "uiTrustedHtml"

/// `Ui.Dom.mount` with a renderer factory, called when this call starts,
/// instead of a DOM container. The elements here are still DOM ones.
mount_with :
  forall c r.
  Renderer ->
  (Failure none ->{r; none} Unit)^c ->
  Ui^c ->{Atom.Registry, Atom.Write | r; none}
  Never
foreign effect mount_with from "@flick-lang/runtime/ui/react" "uiMountWith"
  retention call

/// A component that reads atoms while it renders: React renders it again
/// when one of them changes, or when its props do.
type View p

/// The component of `render`.
view : forall c p. (p ->{Atom.Read;} Ui^c)^c -> (View p)^c
foreign pure view from "@flick-lang/runtime/ui/react" "uiView"
  retention call

/// A DOM element of a component instance, of the tag `t`: its setup makes
/// it with `element`, a render binds it to a node with `input_at`,
/// `textarea_at`, `button_at` or `div_at`, and a task reaches the node
/// through `Document`. React's `useRef`, for the DOM alone.
type Element t

/// The tag of an `input`.
type Input

/// The tag of a `textarea`.
type Textarea

/// The tag of a `button`.
type Button

/// The tag of a `div`.
type Div

/// An element with no mounted node: before its instance renders it, after
/// it unmounts, or with a renderer without a DOM.
type error Detached = Detached

/// Where a node is on the page, in CSS pixels.
type alias Rect = { width : Float; height : Float; top : Float; left : Float }

/// The live document of a root: the nodes of elements. A root provides it
/// to the tasks of its handlers and instances; a server renders without it.
service Document =
  /// Moves the keyboard focus to the node.
  focus : forall t d. (Element t)^d ->{; Detached} Unit
  /// Takes the keyboard focus away from the node.
  blur : forall t d. (Element t)^d ->{; Detached} Unit
  /// Scrolls the page until the node is in view.
  scroll_into_view : forall t d. (Element t)^d ->{; Detached} Unit
  /// The node's place on the page.
  measure : forall t d. (Element t)^d ->{; Detached} Rect

/// A fresh element, not bound to a node yet.
handle : Unit -> Element t
foreign pure handle from "@flick-lang/runtime/ui/react" "uiElementHandle"
  arity 1

/// An element of the instance whose setup makes it.
element : forall s t. Unit ->{Setup s;} (Element t)^{s}
let element () = Setup.own (handle ())

/// `input props` whose node is `element`'s.
input_at : forall c d. (Element Input)^d -> InputProps c -> Ui^(c + d)
foreign pure input_at from "@flick-lang/runtime/ui/react" "uiInputAt"
  retention call

/// `textarea props` whose node is `element`'s.
textarea_at : forall c d. (Element Textarea)^d -> InputProps c -> Ui^(c + d)
foreign pure textarea_at from "@flick-lang/runtime/ui/react" "uiTextareaAt"
  retention call

/// `button props children` whose node is `element`'s.
button_at : forall c d. (Element Button)^d -> ButtonProps c -> List (Ui^c) -> Ui^(c + d)
foreign pure button_at from "@flick-lang/runtime/ui/react" "uiButtonAt"
  retention call

/// `div props children` whose node is `element`'s.
div_at : forall c d. (Element Div)^d -> ElementProps -> List (Ui^c) -> Ui^(c + d)
foreign pure div_at from "@flick-lang/runtime/ui/react" "uiDivAt"
  retention call

/// Moves the keyboard focus to `element`'s node.
focus : forall t d. (Element t)^d ->{Document; Detached} Unit
let focus element = Document.focus element

/// Takes the keyboard focus away from `element`'s node.
blur : forall t d. (Element t)^d ->{Document; Detached} Unit
let blur element = Document.blur element

/// Scrolls the page until `element`'s node is in view.
scroll_into_view : forall t d. (Element t)^d ->{Document; Detached} Unit
let scroll_into_view element = Document.scroll_into_view element

/// Where `element`'s node is on the page.
measure : forall t d. (Element t)^d ->{Document; Detached} Rect
let measure element = Document.measure element

/// The component whose instances run `setup` once, when they mount, and
/// render with what it made, which has the instance's region `s`.
stateful :
  forall c p. (forall s. p ->{Setup s;} (p ->{Atom.Read;} Ui^{s | c})^{s | c})^c -> (View p)^c
foreign pure stateful from "@flick-lang/runtime/ui/react" "uiStateful"
  retention call

/// `task` as work of an instance: it starts after the instance mounts,
/// and its unmount interrupts it.
mounted : forall c. (Eff {Atom.Write, Document} none Unit)^c -> Lifecycle^c
foreign pure mounted from "@flick-lang/runtime/ui/react" "uiMounted"
  retention call

/// Runs `task` in a component's `setup` once the instance mounts, as a
/// task of the root: its unmount interrupts it and waits for it, and a
/// defect goes to the root's supervisor. React's `useEffect` without
/// dependencies, run once per instance.
on_mount : forall s c. (Eff {Atom.Write, Document} none Unit)^c ->{Setup s;} Unit
let on_mount work = Setup.start (mounted work)

/// `run` of what `read` reads as work of an instance, again whenever it
/// changes.
watched :
  forall c a.
  (Unit ->{Atom.Read;} a)^c -> (a -> (Eff {Atom.Write, Document} none Unit)^c)^c -> Lifecycle^c
foreign pure watched from "@flick-lang/runtime/ui/react" "uiWatched"
  retention call

/// Runs `run` of the value `read` computes in a component's `setup` once
/// the instance mounts, and again whenever an atom `read` read changes; it
/// interrupts the previous run and waits for it first, and the unmount
/// interrupts the last one. The dependencies are the atoms read, not a
/// list.
watch :
  forall s c a.
  (Unit ->{Atom.Read;} a)^c -> (a -> (Eff {Atom.Write, Document} none Unit)^c)^c ->{Setup s;} Unit
let watch read run = Setup.start (watched read run)

/// The component named `name` in React's developer tools.
named : forall c p. String -> (View p)^c -> (View p)^c
foreign pure named from "@flick-lang/runtime/ui/react" "uiNamed"
  retention call

/// The component with the props `props`.
render : forall c p. (View p)^c -> p^c -> Ui^c
foreign pure render from "@flick-lang/runtime/ui/react" "uiRender"
  retention call

/// The props of a field bound to a state.
type alias FieldProps c = {
  /// The state the field shows and each keystroke writes.
  bind : Atom.Writable String;
  /// The hint shown while the field is empty.
  placeholder : String;
  /// What runs as a task after each edit, once `bind` is written.
  on_input : Option ((Handler InputSnapshot)^c);
}

/// An input showing the state `bind`. Each keystroke writes it at once,
/// inside the browser's event, so the caret and an IME composition stay
/// where the user left them; a write to the state from elsewhere, a reset,
/// shows in the field. `on_input` then runs as a task.
field : forall c. FieldProps c -> Ui^c
foreign pure field from "@flick-lang/runtime/ui/react" "uiField"
  retention call

/// A text area bound to a state as `field` is.
field_area : forall c. FieldProps c -> Ui^c
foreign pure field_area from "@flick-lang/runtime/ui/react" "uiFieldArea"
  retention call

/// How a live region announces its changes.
type Live = Polite | Assertive | Off
  deriving Eq, Show

/// Host attributes an element may carry beside its props: its identity and
/// class (`class_name` replaces the one its props give), accessibility,
/// text-entry hints and `data-*` attributes. `host` sets
/// none: `with_host { host with role = Some "status" } node`.
type alias Host = {
  /// The `id` attribute: unique in the page.
  id : Option String;
  /// The CSS classes, separated by spaces; they replace the ones the
  /// props give.
  class_name : Option String;
  /// The ARIA role, such as `"status"` or `"dialog"`.
  role : Option String;
  /// The name assistive technology reads.
  aria_label : Option String;
  /// The `id` of the element that describes this one.
  aria_describedby : Option String;
  /// Whether assistive technology skips the element.
  aria_hidden : Option Bool;
  /// The value fails its check.
  aria_invalid : Option Bool;
  /// A toggle button is on.
  aria_pressed : Option Bool;
  /// `aria-live`: how changes inside the element are announced.
  aria_live : Option Live;
  /// `tabindex`: 0 puts the element in the tab order, -1 takes it out.
  tab_index : Option Int;
  /// `data-*` attributes, by the name after `data-`: lowercase letters,
  /// digits and hyphens.
  data : List (String, String);
  /// `autocapitalize`: whether text entry starts sentences with a capital.
  auto_capitalize : Option Bool;
  /// `autocorrect`: whether text entry corrects spelling.
  auto_correct : Option Bool;
  /// Whether a text area wraps long lines (`wrap="soft"`) or scrolls
  /// (`wrap="off"`).
  wrap : Option Bool;
  /// The `name` of a form field.
  name : Option String;
  /// The kind of text an input takes: its `type`.
  input_type : Option InputType;
}

/// The `type` of an input: `text`, `password` or `email`.
type InputType = TextInput | PasswordInput | EmailInput
  deriving Eq, Show

/// No host attribute.
host : Host
let host = {
  id = None;
  class_name = None;
  role = None;
  aria_label = None;
  aria_describedby = None;
  aria_hidden = None;
  aria_invalid = None;
  aria_pressed = None;
  aria_live = None;
  tab_index = None;
  data = [];
  auto_capitalize = None;
  auto_correct = None;
  wrap = None;
  name = None;
  input_type = None;
}

/// The element `node` with the host attributes `attrs`; `data` names are
/// lowercase letters, digits and hyphens, written `data-<name>`. On a
/// `field` or `field_area` they go on its input or text area. Another node
/// that is not an element is a defect.
with_host : forall c. Host -> Ui^c -> Ui^c
foreign pure with_host from "@flick-lang/runtime/ui/react" "uiWithHost"
  retention call

/// The level of a heading, `h1` to `h6`.
type Level = H1 | H2 | H3 | H4 | H5 | H6
  deriving Eq, Show

/// A heading of the level.
heading_at : forall c. Level -> List (Ui^c) -> Ui^c
foreign pure heading_at from "@flick-lang/runtime/ui/react" "uiHeadingAt"
  retention call

/// A view whose render may read tasks with `Atom.ready`: while one loads
/// it shows `fallback`, and when one failed it shows `failed` of the
/// failure, so each error of `x` has a place to go.
suspended : forall c p x. (Failure x -> Ui^c)^c -> Ui^c -> (p ->{Atom.Read; x} Ui^c)^c -> (View p)^c
foreign pure suspended from "@flick-lang/runtime/ui/react" "uiSuspended"
  retention call

/// A view of a task atom, its props: `fallback` while it loads, `failed`
/// of its failure, `render` of its value. It is `suspended` reading one task.
awaiting :
  forall c a e.
  (Failure e -> Ui^c)^c ->
  Ui^c ->
  (a ->{Atom.Read;} Ui^c)^c ->
  (View (Atom.Atom (Atom.Async a e)))^c
let awaiting failed fallback render =
  suspended failed fallback (fun atom -> render (Atom.ready atom))
