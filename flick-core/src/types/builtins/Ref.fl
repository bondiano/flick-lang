/// Mutable cells. Every operation runs through
/// the runtime, so a fresh cell is never generalized.
module Ref exposing (make, get, set, modify)

make : a ->{} Ref a
foreign sync make from "@flick-lang/runtime" "refMake"

get : Ref a ->{} a
foreign sync get from "@flick-lang/runtime" "refGet"

set : forall c a. (Ref a)^c -> (a ->{} Unit)^c
foreign sync set from "@flick-lang/runtime" "refSet"

modify : forall c d a b. (Ref a)^c -> ((a -> (b, a))^d ->{} b)^c
foreign sync modify from "@flick-lang/runtime" "refModify"
