/// Mutable cells. Every operation runs through
/// the runtime, so a fresh cell is never generalized. A cell is Effect's
/// `Ref`: each operation is atomic, since nothing else runs during it.
/// A cell's capture bound covers both its current contents and every later write.
module Ref exposing (
  make, get, set, modify, same, get_and_set, get_and_update, get_and_update_some, set_and_get,
  modify_some, update, update_and_get, update_some, update_some_and_get, compare_and_set, increment,
  decrement, increment_and_get, decrement_and_get, get_and_increment, get_and_decrement, toggle,
)

/// A fresh cell holding `value`.
make : forall c a. a^c ->{} Ref (a^c)
foreign sync make from "@flick-lang/runtime" "refMake"
  retention call
  reviewed "effect@4.0.5 sha256:13ba531db6f50e31"

/// The current contents.
get : forall c a. (Ref a)^c ->{} a^c
foreign sync get from "@flick-lang/runtime" "refGet"
  retention call
  reviewed "effect@4.0.5 sha256:b4713cd12c52d94d"

/// Whether both are the same cell. Cells have no `Eq` or `Hash`: a write
/// would change what they compare by.
same : Ref a -> Ref a -> Bool
foreign pure same from "@flick-lang/runtime" "refSame"

/// Replaces the contents.
set : forall c a. (Ref a)^c -> (a^c ->{} Unit)^c
foreign sync set from "@flick-lang/runtime" "refSet"
  retention call
  reviewed "effect@4.0.5 sha256:7ab1cc29131d058b"

/// `f` gives the result and the new contents, in one step.
modify : forall c d x a b. (Ref a)^c -> ((a^c -> (b^x, a^c))^d ->{} b^x)^c
foreign sync modify from "@flick-lang/runtime" "refModify"
  retention call
  reviewed "effect@4.0.5 sha256:2931caacecf3556c"

/// The contents after a partial update: `next`, or `old` with `None`.
or_old : forall c a. a^c -> ((Option a)^c -> a^c)^c
let or_old old next =
  match next with
  | Some value -> value
  | None -> old

/// Replaces the contents, giving the previous ones.
get_and_set : forall c a. (Ref a)^c -> (a^c ->{} a^c)^c
let get_and_set ref value = modify ref (fun old -> (old, value))

/// Applies `f` to the contents, giving the previous ones.
get_and_update : forall c d a. (Ref a)^c -> ((a^c -> a^c)^d ->{} a^c)^c
let get_and_update ref f = modify ref (fun old -> (old, f old))

/// Applies `f` where it gives `Some`, giving the previous contents.
get_and_update_some : forall c d a. (Ref a)^c -> ((a^c -> (Option a)^c)^d ->{} a^c)^c
let get_and_update_some ref f = modify ref (fun old -> (old, or_old old (f old)))

/// Replaces the contents, giving the new ones.
set_and_get : forall c a. (Ref a)^c -> (a^c ->{} a^c)^c
let set_and_get ref value = modify ref (fun _ -> (value, value))

/// `modify` where `f` may leave the contents as they are with `None`.
modify_some : forall c d x a b. (Ref a)^c -> ((a^c -> (b^x, (Option a)^c))^d ->{} b^x)^c
let modify_some ref f =
  modify ref (fun old ->
    let (result, next) = f old
    (result, or_old old next))

/// Applies `f` to the contents.
update : forall c d a. (Ref a)^c -> ((a^c -> a^c)^d ->{} Unit)^c
let update ref f = modify ref (fun old -> ((), f old))

/// Applies `f` to the contents, giving the new ones.
update_and_get : forall c d a. (Ref a)^c -> ((a^c -> a^c)^d ->{} a^c)^c
let update_and_get ref f =
  modify ref (fun old ->
    let next = f old
    (next, next))

/// Applies `f` where it gives `Some`.
update_some : forall c d a. (Ref a)^c -> ((a^c -> (Option a)^c)^d ->{} Unit)^c
let update_some ref f = modify ref (fun old -> ((), or_old old (f old)))

/// Applies `f` where it gives `Some`, giving the contents after.
update_some_and_get : forall c d a. (Ref a)^c -> ((a^c -> (Option a)^c)^d ->{} a^c)^c
let update_some_and_get ref f =
  modify ref (fun old ->
    let next = or_old old (f old)
    (next, next))

/// Sets the contents to `next` only if they equal `expected`; whether it did.
compare_and_set : forall c a. Eq a => (Ref a)^c -> (a^c -> (a^c ->{} Bool)^c)^c
let compare_and_set ref expected next =
  modify ref (fun a -> if a == expected then (true, next) else (false, a))

/// Adds one.
increment : Ref Float ->{} Unit
let increment ref = update ref (fun n -> n + 1)

/// Subtracts one.
decrement : Ref Float ->{} Unit
let decrement ref = update ref (fun n -> n - 1)

/// Adds one, giving the new count.
increment_and_get : Ref Float ->{} Float
let increment_and_get ref = update_and_get ref (fun n -> n + 1)

/// Subtracts one, giving the new count.
decrement_and_get : Ref Float ->{} Float
let decrement_and_get ref = update_and_get ref (fun n -> n - 1)

/// Adds one, giving the count before.
get_and_increment : Ref Float ->{} Float
let get_and_increment ref = get_and_update ref (fun n -> n + 1)

/// Subtracts one, giving the count before.
get_and_decrement : Ref Float ->{} Float
let get_and_decrement ref = get_and_update ref (fun n -> n - 1)

/// Negates the flag.
toggle : Ref Bool ->{} Unit
let toggle ref = update ref (fun b -> not b)
