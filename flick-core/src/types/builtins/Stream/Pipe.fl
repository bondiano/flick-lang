/// Streams with sinks, channels and execution plans: a stream run into a
/// sink, its elements regrouped or passed through one, a stream as the
/// channel it is made of and back, and a stream retried by a plan.
module Stream.Pipe exposing (..)

import Stream.Core exposing (Stream)
import Sink exposing (Sink)
import Channel exposing (Channel)

/// Runs the stream into the sink and gives what the sink gives.
run : forall c r e a r2 e2 l b. Sink r2 e2 a l b -> (Stream r e a)^c ->{r + r2; e + e2} b
foreign effect run from "@flick-lang/runtime/effect/Stream" "run"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:6fb1ab9d6a6747fa"

/// The values of the sink, run again over the rest each time it ends; an
/// element it leaves over starts its next run.
transduce : forall c r e a r2 e2 b. Sink r2 e2 a a b ->
  (Stream r e a)^c ->
  (Stream (r + r2) (e + e2) b)^c
foreign pure transduce from "@flick-lang/runtime/effect/Stream" "transduce"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:60ee018766ec2cef"

/// `transduce` that feeds the sink while the downstream is busy, so a slow
/// consumer gets fewer, larger values.
aggregate : forall c r e a r2 e2 b. Sink r2 e2 a a b ->
  (Stream r e a)^c ->
  (Stream (r + r2) (e + e2) b)^c
foreign pure aggregate from "@flick-lang/runtime/effect/Stream" "aggregate"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:eaffc96aa5eafd58"

/// `aggregate` that also ends the sink's run each time the schedule fires;
/// the schedule gets the last value, if any.
aggregate_within : forall c r e a r2 e2 b r3 e3 o. Sink r2 e2 a a b ->
  Schedule.Schedule r3 e3 (Option b) o ->
  (Stream r e a)^c ->
  (Stream (r + r2 + r3) (e + e2 + e3) b)^c
foreign pure aggregate_within from "@flick-lang/runtime/effect/Stream" "aggregateWithin"
  arity 2
  retention call
  reviewed "effect@4.0.5 sha256:47dbb4412f1ede76"

/// The leftovers of the sink, which reads the stream.
pipe_through : forall c r e a r2 e2 l b. Sink r2 e2 a l b ->
  (Stream r e a)^c ->
  (Stream (r + r2) (e + e2) l)^c
foreign pure pipe_through from "@flick-lang/runtime/effect/Stream" "pipeThrough"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:11b397949cd59f9d"

/// The stream, with every element also fed to the sink.
tap_sink : forall c r e a r2 e2 l x. Sink r2 e2 a l x ->
  (Stream r e a)^c ->
  (Stream (r + r2) (e + e2) a)^c
foreign pure tap_sink from "@flick-lang/runtime/effect/Stream" "tapSink"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:36c45c59338ecd64"

/// The first value of the sink and the rest of the stream, which belongs to
/// the scope of region `s`.
peel :
  forall s c r e a r2 e2 b.
  Fiber.Outlives c s =>
  Sink r2 e2 a a b ->
    (Stream r e a)^c ->{Scope s | r + r2; e + e2}
    (b, (Stream none e a)^{s})
foreign effect peel from "@flick-lang/runtime/effect/Stream" "peel"
  arity 1
  retention owner
  reviewed "effect@4.0.5 sha256:707e1796543327f9"

/// The channel the stream is made of: it emits chunks of the elements.
to_channel : forall c r e a i ie id. (Stream r e a)^c ->
  (Channel r e i (NonEmpty.NonEmpty a) Unit ie id)^c
foreign pure to_channel from "@flick-lang/runtime/effect/Stream" "toChannel"
  retention call
  reviewed "effect@4.0.5 sha256:55d89455ce5afc88"

/// The stream of the elements of the chunks the channel emits.
from_channel : forall c r e a i. (Channel r e i (NonEmpty.NonEmpty a) Unit none Unit)^c ->
  (Stream r e a)^c
foreign pure from_channel from "@flick-lang/runtime/effect/Stream" "fromChannel"
  retention call
  reviewed "effect@4.0.5 sha256:bbbdae98c9854d69"

/// What the channel emits when it reads the chunks of the stream, its
/// failure and its end.
pipe_through_channel : forall c r e a r2 e2 b d. Channel r2 e2 (NonEmpty.NonEmpty a) (
  NonEmpty.NonEmpty b
) d e Unit ->
  (Stream r e a)^c ->
  (Stream (r + r2) e2 b)^c
foreign pure pipe_through_channel from "@flick-lang/runtime/effect/Stream" "pipeThroughChannel"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:f48e8b8b83b331fc"

/// `pipe_through_channel` with a channel that sees no failure: one of the
/// stream fails the result directly.
pipe_through_channel_or_fail : forall c r e a r2 e2 b d. Channel r2 e2 (NonEmpty.NonEmpty a) (
  NonEmpty.NonEmpty b
) d none Unit ->
  (Stream r e a)^c ->
  (Stream (r + r2) (e + e2) b)^c
foreign pure pipe_through_channel_or_fail from "@flick-lang/runtime/effect/Stream" "pipeThroughChannelOrFail"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:3d6acc9efcb47f3c"

/// Runs the stream with the services of the plan's first step, and on a
/// failure with those of the next steps as the plan says; with
/// `preventFallback`, a failure after the first element is not retried.
/// `on_event` sees each attempt.
with_execution_plan :
  forall c p r e a r2 e2.
  ExecutionPlan.ExecutionPlan p r2 e2 (Errors e) ->
    Bool ->
    (ExecutionPlan.Event e ->{r;} Unit) ->
    (Stream (p + r) e a)^c ->
    (Stream (r + r2) (e + e2) a)^c
foreign pure with_execution_plan from "@flick-lang/runtime/effect/Stream" "flickStreamWithExecutionPlan"
  arity 3
  retention call
  reviewed "effect@4.0.5 sha256:e771fc190fc8f7d1"
