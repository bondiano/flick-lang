/// Streams changed element by element: mapped, filtered, cut, chunked,
/// accumulated and paced. A callback is stored in the stream, so the stream
/// holds what the callback holds (`^c`): a closure over a scoped value
/// makes a stream that cannot leave that scope, and may be used inside it.
module Stream.Transform exposing (..)

import Stream.Core exposing (Stream)

/// What `throttle` does with a chunk over the budget: drop it, or delay it.
type ThrottleStrategy = Enforce | Shape

/// Each element mapped by `f`.
map : forall c r e a b. (a -> b)^c -> ((Stream r e a)^c -> (Stream r e b)^c)^c
foreign pure map from "@flick-lang/runtime/effect/Stream" "map"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:fdb463fe8e574a24"

/// Each element replaced by `value`.
as_ : forall c r e a b. b -> (Stream r e a)^c -> (Stream r e b)^c
foreign pure as_ from "@flick-lang/runtime/effect/Stream" "as"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:02da9fa6dee3e577"

/// The elements mapped by `onElement` and the error by `onError`.
map_both : forall c r e e2 a b. { onElement : (a -> b)^c; onError : (Errors e -> Errors e2)^c } ->
  ((Stream r e a)^c -> (Stream r e2 b)^c)^c
foreign pure map_both from "@flick-lang/runtime/effect/Stream" "mapBoth"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:99059bd9dd788b16"

/// The error mapped by `f`.
map_error : forall c r e e2 a. (Errors e -> Errors e2)^c ->
  ((Stream r e a)^c -> (Stream r e2 a)^c)^c
foreign pure map_error from "@flick-lang/runtime/effect/Stream" "mapError"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:8c3b6e500a5b7049"

/// Each chunk of elements mapped by `f`.
map_chunks : forall c r e a b. (NonEmpty.NonEmpty a -> NonEmpty.NonEmpty b)^c ->
  ((Stream r e a)^c -> (Stream r e b)^c)^c
foreign pure map_chunks from "@flick-lang/runtime/effect/Stream" "mapArray"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:28f2cbca5320c2cc"

/// Each element mapped by the task `f` gives, one at a time.
map_effect : forall c r e a r2 e2 b. (a ->{r2; e2} b)^c ->
  ((Stream r e a)^c -> (Stream (r + r2) (e + e2) b)^c)^c
foreign pure map_effect from "@flick-lang/runtime/effect/Stream" "mapEffect"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:77d4a816f5aa00b0"

/// `map_effect` running at most `concurrency` tasks at once (`None`: no
/// bound) as children of the stream's run; `unordered` emits each result
/// as soon as it is ready.
map_effect_par : forall c r e a r2 e2 b. { concurrency : Option Number; unordered : Bool } ->
  (a ->{r2; e2} b)^c ->
  ((Stream r e a)^c -> (Stream (r + r2) (e + e2) b)^c)^c
foreign pure map_effect_par from "@flick-lang/runtime/effect/Stream" "flickMapEffectPar"
  arity 2
  retention call
  reviewed "effect@4.0.5 sha256:77d4a816f5aa00b0"

/// Each chunk mapped by the task `f` gives.
map_chunks_effect : forall c r e a r2 e2 b. (
  NonEmpty.NonEmpty a ->{r2; e2} NonEmpty.NonEmpty b
)^c ->
  ((Stream r e a)^c -> (Stream (r + r2) (e + e2) b)^c)^c
foreign pure map_chunks_effect from "@flick-lang/runtime/effect/Stream" "mapArrayEffect"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:88e3be9c90adc528"

/// Runs each task element, emitting its value.
flatten_effect : forall c r e r2 e2 a. (Stream r e (Eff r2 e2 a))^c ->
