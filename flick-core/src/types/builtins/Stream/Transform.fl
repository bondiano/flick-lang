/// The chunks paced to `units` of `cost` per `duration`, with `burst`
/// units more at once (`None`: 0); `Shape` delays a chunk over the budget,
/// `Enforce` (the default) drops it.
throttle : forall c r e a. {
  cost : (NonEmpty.NonEmpty a -> Number)^c;
  units : Number;
  duration : Duration.Duration;
  burst : Option Number;
  strategy : Option ThrottleStrategy;
} ->
  ((Stream r e a)^c -> (Stream r e a)^c)^c
foreign pure throttle from "@flick-lang/runtime/effect/Stream" "flickThrottle"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:95ccf7c414b423c8"

/// `throttle` with a task as the cost.
throttle_effect : forall c r e a r2 e2. {
  cost : (NonEmpty.NonEmpty a ->{r2; e2} Number)^c;
  units : Number;
  duration : Duration.Duration;
  burst : Option Number;
  strategy : Option ThrottleStrategy;
} ->
  ((Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c)^c
foreign pure throttle_effect from "@flick-lang/runtime/effect/Stream" "flickThrottleEffect"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:3741a791c300a874"

