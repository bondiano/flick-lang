foreign pure tap from "@flick-lang/runtime/effect/Stream" "tap"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:362dadb0f8d68319"

/// Runs `onElement` on each element and `onError` on the error.
tap_both : forall c r e a r2 e2 x r3 e3 y. {
  onElement : (a ->{r2; e2} x)^c;
  onError : (Errors e ->{r3; e3} y)^c;
} ->
  ((Stream r e a)^c -> (Stream (r + r2 + r3) (e + e2 + e3) a)^c)^c
foreign pure tap_both from "@flick-lang/runtime/effect/Stream" "tapBoth"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:bf8eb9e24bae54d6"

