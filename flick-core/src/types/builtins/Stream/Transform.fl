foreign pure flatten_effect from "@flick-lang/runtime/effect/Stream" "flattenEffect"
  retention call
  reviewed "effect@4.0.5 sha256:2d0b839349412fa5"

/// The elements as `Ok` and the error, which ends the stream, as `Err`.
result : forall c r e a. (Stream r e a)^c -> (Stream r none (Result (Errors e) a))^c
foreign pure result from "@flick-lang/runtime/effect/Stream" "result"
  retention call
  reviewed "effect@4.0.5 sha256:82abdedf7bc768ae"

/// Runs `f` on each element, keeping it.
tap : forall c r e a r2 e2 x. (a ->{r2; e2} x)^c ->
