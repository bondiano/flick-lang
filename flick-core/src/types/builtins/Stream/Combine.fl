/// Streams combined: one after another, nested, merged, zipped, raced,
/// repeated and split. What runs concurrently runs as children of the
/// stream's run, interrupted when it ends; a stream split for consumers in
/// a `scope` (`broadcast`, `share`, `partition`) belongs to that scope.
module Stream.Combine exposing (..)

import Stream.Core exposing (Stream, HaltStrategy)

/// `first` and then `second`: `first |> Stream.concat second`.
concat :
  forall c r e r2 e2 a. (Stream r2 e2 a)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure concat from "@flick-lang/runtime/effect/Stream" "concat"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:a62191d22f3e68a3"

/// The values before the elements of the stream.
prepend : forall c r e a. List a -> (Stream r e a)^c -> (Stream r e a)^c
foreign pure prepend from "@flick-lang/runtime/effect/Stream" "prepend"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:effa63dcf2be81a3"

/// The elements of the stream `f` gives for each element, one stream after
/// the other.
flat_map :
  forall c r e a r2 e2 b.
  (a -> Stream r2 e2 b)^c -> ((Stream r e a)^c -> (Stream (r + r2) (e + e2) b)^c)^c
foreign pure flat_map from "@flick-lang/runtime/effect/Stream" "flatMap"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:8d242a075f924d9a"

/// `flat_map` running at most `concurrency` inner streams at once (`None`:
/// no bound), with a buffer of `bufferSize` elements of each.
flat_map_par :
  forall c r e a r2 e2 b.
  {
    concurrency : Option Int;
    bufferSize : Option Int;
  } ->
  (a -> Stream r2 e2 b)^c ->
  ((Stream r e a)^c -> (Stream (r + r2) (e + e2) b)^c)^c
foreign pure flat_map_par from "@flick-lang/runtime/effect/Stream" "flickFlatMapPar"
  arity 2
  retention call
  reviewed "effect@4.0.5 sha256:8d242a075f924d9a"

/// `flat_map` where a new element interrupts the inner stream of the
/// previous one.
switch_map :
  forall c r e a r2 e2 b.
  (a -> Stream r2 e2 b)^c -> ((Stream r e a)^c -> (Stream (r + r2) (e + e2) b)^c)^c
foreign pure switch_map from "@flick-lang/runtime/effect/Stream" "switchMap"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:7e3bfbb90fe6b54b"

/// The elements of each inner stream, one after the other.
flatten : forall c r e r2 e2 a. (Stream r e (Stream r2 e2 a))^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure flatten from "@flick-lang/runtime/effect/Stream" "flatten"
  retention call
  reviewed "effect@4.0.5 sha256:675651dfd106f9ba"

/// The elements of each non-empty list.
flatten_chunks : forall c r e a. (Stream r e (NonEmpty.NonEmpty a))^c -> (Stream r e a)^c
foreign pure flatten_chunks from "@flick-lang/runtime/effect/Stream" "flattenArray"
  retention call
  reviewed "effect@4.0.5 sha256:58abf8be044d2a98"

/// The elements of each list.
flatten_list : forall c r e a. (Stream r e (List a))^c -> (Stream r e a)^c
foreign pure flatten_list from "@flick-lang/runtime/effect/Stream" "flattenIterable"
  retention call
  reviewed "effect@4.0.5 sha256:9a61c35a4c891bb4"

/// Runs the stream for its effects, emitting nothing.
drain : forall c r e a b. (Stream r e a)^c -> (Stream r e b)^c
foreign pure drain from "@flick-lang/runtime/effect/Stream" "drain"
  retention call
  reviewed "effect@4.0.5 sha256:d7224daac84a543b"

/// The elements of the stream while `other` runs alongside it for its
/// effects; it is interrupted when the stream ends.
drain_fork :
  forall c r e a r2 e2 x. (Stream r2 e2 x)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure drain_fork from "@flick-lang/runtime/effect/Stream" "drainFork"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:ecf216ff15a3fe60"

/// The stream again each time the schedule recurs.
repeat :
  forall c r e a r2 e2 o.
  Schedule.Schedule r2 e2 Unit o -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure repeat from "@flick-lang/runtime/effect/Stream" "repeat"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:25433e73eebce393"

/// Each element again as long as the schedule recurs.
repeat_elements :
  forall c r e a r2 e2 o.
  Schedule.Schedule r2 e2 a o -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure repeat_elements from "@flick-lang/runtime/effect/Stream" "repeatElements"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:f3dad084e3cfd50a"

/// The stream again and again, forever.
forever : forall c r e a. (Stream r e a)^c -> (Stream r e a)^c
foreign pure forever from "@flick-lang/runtime/effect/Stream" "forever"
  retention call
  reviewed "effect@4.0.5 sha256:cbb840f784f5d699"

/// Each element delayed by the schedule, which gets the elements; the
/// stream ends when it stops.
schedule :
  forall c r e a r2 e2 o.
  Schedule.Schedule r2 e2 a o -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure schedule from "@flick-lang/runtime/effect/Stream" "schedule"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:00d7ee7b4903e0a9"

/// Ends the stream when the duration passes without an element.
timeout : forall c r e a. Duration.Duration -> (Stream r e a)^c -> (Stream r e a)^c
foreign pure timeout from "@flick-lang/runtime/effect/Stream" "timeout"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:8260378f834741ad"

/// Switches to `fallback` when the duration passes without an element.
timeout_or_else :
  forall c r e a r2 e2.
  Duration.Duration -> (Stream r2 e2 a)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure timeout_or_else from "@flick-lang/runtime/effect/Stream" "flickTimeoutOrElse"
  arity 2
  retention call
  reviewed "effect@4.0.5 sha256:5d94692b2f9e9c3b"

/// The elements of both as they come; the merge ends when both end.
merge :
  forall c r e r2 e2 a. (Stream r2 e2 a)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure merge from "@flick-lang/runtime/effect/Stream" "merge"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:41c2e8e72fa9c35b"

/// `merge`, ending as the strategy says: when the left (this) stream, the
/// right one, both or either end.
merge_with :
  forall c r e r2 e2 a.
  HaltStrategy -> (Stream r2 e2 a)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure merge_with from "@flick-lang/runtime/effect/Stream" "flickMergeWith"
  arity 2
  retention call
  reviewed "effect@4.0.5 sha256:41c2e8e72fa9c35b"

/// The elements of the stream while `task` runs alongside it.
merge_effect :
  forall c r e a r2 e2 x. Eff r2 e2 x -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure merge_effect from "@flick-lang/runtime/effect/Stream" "mergeEffect"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:ce4e9035f18c3883"

/// `merge` telling the sides apart: `Ok` of this stream, `Err` of `other`.
merge_result :
  forall c r e r2 e2 a b.
  (Stream r2 e2 b)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) (Result b a))^c
foreign pure merge_result from "@flick-lang/runtime/effect/Stream" "mergeResult"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:947418c66ea438d0"

/// The elements of this stream, merged with `right` run for its effects.
merge_left :
  forall c r e r2 e2 a b. (Stream r2 e2 b)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure merge_left from "@flick-lang/runtime/effect/Stream" "mergeLeft"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:c7f0335548cd4ce1"

/// The elements of `right`, merged with this stream run for its effects.
merge_right :
  forall c r e r2 e2 a b. (Stream r2 e2 b)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) b)^c
foreign pure merge_right from "@flick-lang/runtime/effect/Stream" "mergeRight"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:332ac6dc42ff5fc1"

/// The elements of all the streams as they come, at most `concurrency` of
/// them at once (`None`: all).
merge_all :
  forall c r e a.
  { concurrency : Option Int; bufferSize : Option Int } ->
  List ((Stream r e a)^c) ->
  (Stream r e a)^c
foreign pure merge_all from "@flick-lang/runtime/effect/Stream" "flickMergeAll"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:e4348b38a0151264"

/// Each element of this stream with each of `right`.
cross :
  forall c r e r2 e2 a b.
  (Stream r2 e2 b)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) (a, b))^c
foreign pure cross from "@flick-lang/runtime/effect/Stream" "cross"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:60d51d13cff240d4"

/// `cross` combined by `f`.
cross_with :
  forall c r e r2 e2 a b x.
  (Stream r2 e2 b)^c -> (a -> b -> x)^c -> ((Stream r e a)^c -> (Stream (r + r2) (e + e2) x)^c)^c
foreign pure cross_with from "@flick-lang/runtime/effect/Stream" "crossWith"
  arity 2
  retention call
  reviewed "effect@4.0.5 sha256:bfc09961b19a6d33"

/// Pairs of the elements of both, until either ends.
zip :
  forall c r e r2 e2 a b.
  (Stream r2 e2 b)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) (a, b))^c
foreign pure zip from "@flick-lang/runtime/effect/Stream" "zip"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:09a0eee6f1080467"

/// `zip` combined by `f`.
zip_with :
  forall c r e r2 e2 a b x.
  (Stream r2 e2 b)^c -> (a -> b -> x)^c -> ((Stream r e a)^c -> (Stream (r + r2) (e + e2) x)^c)^c
foreign pure zip_with from "@flick-lang/runtime/effect/Stream" "zipWith"
  arity 2
  retention call
  reviewed "effect@4.0.5 sha256:2bc5c488c2198b54"

/// Zips chunk by chunk: `f` gives the output and what is left of each side.
zip_with_chunks :
  forall c r e r2 e2 a b x.
  (Stream r2 e2 b)^c ->
  (NonEmpty.NonEmpty a -> NonEmpty.NonEmpty b -> (NonEmpty.NonEmpty x, List a, List b))^c ->
  ((Stream r e a)^c -> (Stream (r + r2) (e + e2) x)^c)^c
foreign pure zip_with_chunks from "@flick-lang/runtime/effect/Stream" "zipWithArray"
  arity 2
  retention call
  reviewed "effect@4.0.5 sha256:fcd6236ecf45bee6"

/// The elements of this stream, zipped with `right` but dropping its own.
zip_left :
  forall c r e r2 e2 a b. (Stream r2 e2 b)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure zip_left from "@flick-lang/runtime/effect/Stream" "zipLeft"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:6b34bfdecb8724d8"

/// The elements of `right`, zipped with this stream but dropping its own.
zip_right :
  forall c r e r2 e2 a b. (Stream r2 e2 b)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) b)^c
foreign pure zip_right from "@flick-lang/runtime/effect/Stream" "zipRight"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:c590f375fb8a3d3d"

/// Pairs zipped with a third stream, as triples.
zip_flatten :
  forall c r e r2 e2 a b x.
  (Stream r2 e2 x)^c -> (Stream r e (a, b))^c -> (Stream (r + r2) (e + e2) (a, b, x))^c
foreign pure zip_flatten from "@flick-lang/runtime/effect/Stream" "zipFlatten"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:0b16e685ace04836"

/// Each element with its index from 0.
zip_with_index : forall c r e a. (Stream r e a)^c -> (Stream r e (a, Int))^c
foreign pure zip_with_index from "@flick-lang/runtime/effect/Stream" "zipWithIndex"
  retention call
  reviewed "effect@4.0.5 sha256:59c03101aa945b3e"

/// Each element with the next one, if any.
zip_with_next : forall c r e a. (Stream r e a)^c -> (Stream r e (a, Option a))^c
foreign pure zip_with_next from "@flick-lang/runtime/effect/Stream" "zipWithNext"
  retention call
  reviewed "effect@4.0.5 sha256:2fb4d54b313da0bb"

/// Each element with the previous one, if any.
zip_with_previous : forall c r e a. (Stream r e a)^c -> (Stream r e (Option a, a))^c
foreign pure zip_with_previous from "@flick-lang/runtime/effect/Stream" "zipWithPrevious"
  retention call
  reviewed "effect@4.0.5 sha256:6ff8175cda1f62bf"

/// Each element with the previous and the next one.
zip_with_previous_and_next :
  forall c r e a. (Stream r e a)^c -> (Stream r e (Option a, a, Option a))^c
foreign pure zip_with_previous_and_next from "@flick-lang/runtime/effect/Stream" "zipWithPreviousAndNext"
  retention call
  reviewed "effect@4.0.5 sha256:9d298764df43c09c"

/// The latest element of each side whenever either emits, once both have.
zip_latest :
  forall c r e r2 e2 a b.
  (Stream r2 e2 b)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) (a, b))^c
foreign pure zip_latest from "@flick-lang/runtime/effect/Stream" "zipLatest"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:4d42cedfc0cc67ad"

/// `zip_latest` combined by `f`.
zip_latest_with :
  forall c r e r2 e2 a b x.
  (Stream r2 e2 b)^c -> (a -> b -> x)^c -> ((Stream r e a)^c -> (Stream (r + r2) (e + e2) x)^c)^c
foreign pure zip_latest_with from "@flick-lang/runtime/effect/Stream" "zipLatestWith"
  arity 2
  retention call
  reviewed "effect@4.0.5 sha256:454b5fa571946964"

/// The latest element of every stream, in their order, whenever one emits.
zip_latest_all : forall c r e a. List ((Stream r e a)^c) -> (Stream r e (List a))^c
foreign pure zip_latest_all from "@flick-lang/runtime/effect/Stream" "zipLatestAll"
  variadic
  retention call
  reviewed "effect@4.0.5 sha256:b39a7167dd1640d3"

/// The stream that emits first; the others are interrupted.
race :
  forall c r e r2 e2 a. (Stream r2 e2 a)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure race from "@flick-lang/runtime/effect/Stream" "race"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:bc4d590b1b27140d"

/// `race` of all the streams.
race_all : forall c r e a. List ((Stream r e a)^c) -> (Stream r e a)^c
foreign pure race_all from "@flick-lang/runtime/effect/Stream" "raceAll"
  variadic
  retention call
  reviewed "effect@4.0.5 sha256:865ea6f87d8861bb"

/// One element of each in turn; the rest of the longer one at the end.
interleave :
  forall c r e r2 e2 a. (Stream r2 e2 a)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure interleave from "@flick-lang/runtime/effect/Stream" "interleave"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:a37ca57cc5151ad3"

/// The next element of this stream for each `true` of `decider`, of
/// `other` for each `false`.
interleave_with :
  forall c r e r2 e2 r3 e3 a.
  (Stream r2 e2 a)^c ->
  (Stream r3 e3 Bool)^c ->
  (Stream r e a)^c ->
  (Stream (r + r2 + r3) (e + e2 + e3) a)^c
foreign pure interleave_with from "@flick-lang/runtime/effect/Stream" "interleaveWith"
  arity 2
  retention call
  reviewed "effect@4.0.5 sha256:7ad40557c12af785"

/// Interrupts the stream when `task` ends; its failure fails the stream.
interrupt_when :
  forall c r e a r2 e2 x. Eff r2 e2 x -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure interrupt_when from "@flick-lang/runtime/effect/Stream" "interruptWhen"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:bffed6bccdb362b8"

/// Ends the stream after the element being pulled when `task` ends.
halt_when :
  forall c r e a r2 e2 x. Eff r2 e2 x -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure halt_when from "@flick-lang/runtime/effect/Stream" "haltWhen"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:c2407941cf2f5d8d"

/// Groups by the key and value `f` gives: each group is a stream of the
/// values of one key.
group_by :
  forall c r e a r2 e2 k v.
  (a ->{r2; e2} (k, v))^c ->
  ((Stream r e a)^c -> (Stream (r + r2) (e + e2) (k, Stream none none v))^c)^c
foreign pure group_by from "@flick-lang/runtime/effect/Stream" "groupBy"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:32fe4c313ba6bcdb"

/// Groups by the key `f` gives (compared by `==`).
group_by_key :
  forall c r e a k. (a -> k)^c -> ((Stream r e a)^c -> (Stream r e (k, Stream none none a))^c)^c
foreign pure group_by_key from "@flick-lang/runtime/effect/Stream" "groupByKey"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:6c9bad407068e0fe"

/// How a split stream buffers for each consumer: `capacity` elements
/// (`None`: no bound) with the strategy for a full buffer (`None`:
/// `Suspend`), and the last `replay` elements for a late one.
type alias Split = {
  capacity : Option Int;
  strategy : Option Queue.Strategy;
  replay : Option Int;
}

/// A stream that consumers in the scope of region `s` may each run: the
/// source runs once, as a child of that scope, and every consumer sees its
/// elements.
broadcast :
  forall s c r e a.
  (Fiber.Outlives c s, Fiber.Provided r s) =>
  Split -> (Stream r e a)^c ->{Scope s | r;} (Stream none e a)^{s}
foreign effect broadcast from "@flick-lang/runtime/effect/Stream" "flickBroadcast"
  arity 1
  retention owner
  reviewed "effect@4.0.5 sha256:45756ec482f4df57"

/// `n` streams that each see every element of the source, which runs once
/// as a child of the scope of region `s`.
broadcast_n :
  forall s c r e a.
  (Fiber.Outlives c s, Fiber.Provided r s) =>
  Int -> Split -> (Stream r e a)^c ->{Scope s | r;} List ((Stream none e a)^{s})
foreign effect broadcast_n from "@flick-lang/runtime/effect/Stream" "flickBroadcastN"
  arity 2
  retention owner
  reviewed "effect@4.0.5 sha256:f02752854171ddfb"

/// `broadcast` that starts the source with its first consumer and stops it
/// `idleTimeToLive` (`None`: at once) after its last one ends.
share :
  forall s c r e a.
  (Fiber.Outlives c s, Fiber.Provided r s) =>
  Split -> Option Duration.Duration -> (Stream r e a)^c ->{Scope s | r;} (Stream none e a)^{s}
foreign effect share from "@flick-lang/runtime/effect/Stream" "flickShare"
  arity 2
  retention owner
  reviewed "effect@4.0.5 sha256:2f0697ec71021660"

/// The values the filter passes and those it refuses, as two streams of
/// the scope of region `s`; the source runs once as a child of it.
partition :
  forall s c r e a p f.
  (Fiber.Outlives c s, Fiber.Provided r s) =>
  Filter.Filter a p f ->
  (Stream r e a)^c ->{Scope s | r;}
  ((Stream none e p)^{s}, (Stream none e f)^{s})
foreign effect partition from "@flick-lang/runtime/effect/Stream" "partition"
  arity 1
  retention owner
  reviewed "effect@4.0.5 sha256:4f65c5bc5b8812e5"

/// `partition` with a task as the filter.
partition_effect :
  forall s c r e a r2 e2 p f.
  (Fiber.Outlives c s, Fiber.Provided r s, Fiber.Provided r2 s) =>
  Filter.FilterEffect r2 e2 a p f ->
  (Stream r e a)^c ->{Scope s | r + r2;}
  ((Stream none (e + e2) p)^{s}, (Stream none (e + e2) f)^{s})
foreign effect partition_effect from "@flick-lang/runtime/effect/Stream" "partitionEffect"
  arity 1
  retention owner
  reviewed "effect@4.0.5 sha256:a144d92820cdfa5f"

/// `partition` into two queues that end when the source does; the source
/// runs as a child of the scope of region `s`, which shuts them down when
/// it closes.
partition_queue :
  forall s c r e a p f.
  (Fiber.Outlives c s, Fiber.Provided r s) =>
  Filter.Filter a p f -> (Stream r e a)^c ->{Scope s | r;} (Queue.Queue e p, Queue.Queue e f)
foreign effect partition_queue from "@flick-lang/runtime/effect/Stream" "partitionQueue"
  arity 1
  retention owner
  reviewed "effect@4.0.5 sha256:a3290b3226b51ff2"
