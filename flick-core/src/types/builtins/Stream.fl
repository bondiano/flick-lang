/// Effect's `Stream`: a `Stream r e a` is a cold description of elements
/// of `a` that needs the services `r` and may fail with `e`; a `run_*`
/// call runs it in the current task. Callbacks stored in a stream are bare,
/// and a stream made from a scoped handle holds its region, so it cannot
/// leave that scope.
module Stream exposing (
  Stream,
  HaltStrategy(..),
  default_chunk_size,
  empty,
  never,
  succeed,
  make,
  from_list,
  from_lists,
  suspend,
