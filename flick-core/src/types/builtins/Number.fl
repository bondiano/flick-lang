/// Operations on numbers beyond the operators. `==` is canonical equality:
/// `NaN == NaN` and `0 == -0`. Integer operations are checked: they fail
/// rather than leave the safe integers.
module Number exposing (..)

/// The error of a checked integer operation.
type error ArithmeticError = ArithmeticError String
  deriving Eq, Show

/// JS `===`: `NaN` differs from itself, `0` equals `-0`.
strict_equal : Number -> Number -> Bool
foreign pure strict_equal from "@flick-lang/runtime" "numberStrictEqual"

/// JS `Object.is`: `NaN` equals itself, `0` differs from `-0`.
same_value : Number -> Number -> Bool
foreign pure same_value from "@flick-lang/runtime" "numberSameValue"

pi : Number
foreign pure pi from global "Math.PI"

infinity : Number
foreign pure infinity from global "Infinity"

nan : Number
foreign pure nan from global "NaN"

is_nan : Number -> Bool
foreign pure is_nan from global "Number.isNaN"

is_finite : Number -> Bool
foreign pure is_finite from global "Number.isFinite"

is_integer : Number -> Bool
foreign pure is_integer from global "Number.isInteger"

is_safe_integer : Number -> Bool
foreign pure is_safe_integer from global "Number.isSafeInteger"

abs : Number -> Number
foreign pure abs from global "Math.abs"

floor : Number -> Number
foreign pure floor from global "Math.floor"

ceil : Number -> Number
foreign pure ceil from global "Math.ceil"

round : Number -> Number
foreign pure round from global "Math.round"

trunc : Number -> Number
foreign pure trunc from global "Math.trunc"

sqrt : Number -> Number
foreign pure sqrt from global "Math.sqrt"

/// The lesser of two numbers by Effect's order, where NaN is least.
min : Number -> Number -> Number
foreign pure min from "@flick-lang/runtime/effect/Number" "min"
  arity 1
  reviewed "effect@4.0.5 sha256:a308f0d3d25f7462"

/// The greater of two numbers by Effect's order, where NaN is least.
max : Number -> Number -> Number
foreign pure max from "@flick-lang/runtime/effect/Number" "max"
  arity 1
  reviewed "effect@4.0.5 sha256:acfad47a78c46b4b"

to_string : Number -> String
foreign pure to_string from "@flick-lang/runtime" "stringFromNumber"

/// The number the string spells in JS syntax, `"NaN"` and the infinities
/// included; blank and malformed text are `None`.
parse : String -> Option Number
foreign pure parse from "@flick-lang/runtime/effect/Number" "parse"
  reviewed "effect@4.0.5 sha256:2c3ff3f04116475d"

/// `self + that`: `x |> Number.sum 1`.
sum : Number -> Number -> Number
foreign pure sum from "@flick-lang/runtime/effect/Number" "sum"
  arity 1
  reviewed "effect@4.0.5 sha256:87ed019662896b16"

/// `self - that`: `10 |> Number.subtract 3` is 7.
subtract : Number -> Number -> Number
foreign pure subtract from "@flick-lang/runtime/effect/Number" "subtract"
  arity 1
  reviewed "effect@4.0.5 sha256:df7d0ef882d7233c"

/// `self * that`.
multiply : Number -> Number -> Number
foreign pure multiply from "@flick-lang/runtime/effect/Number" "multiply"
  arity 1
  reviewed "effect@4.0.5 sha256:30fc2997152666f9"

/// `self / that`; `None` when `that` is 0: `10 |> Number.divide 4` is 2.5.
divide : Number -> Number -> Option Number
foreign pure divide from "@flick-lang/runtime/effect/Number" "divide"
  arity 1
  reviewed "effect@4.0.5 sha256:293fe56192c03b49"

/// The remainder of `self / divisor`, exact on decimals (`0.3 % 0.1` is 0);
/// NaN for a zero or non-finite operand.
remainder : Number -> Number -> Number
foreign pure remainder from "@flick-lang/runtime/effect/Number" "remainder"
  arity 1
  reviewed "effect@4.0.5 sha256:fe7d9b4651bec4d2"

/// `n + 1`.
increment : Number -> Number
foreign pure increment from "@flick-lang/runtime/effect/Number" "increment"
  reviewed "effect@4.0.5 sha256:0702b04d9c0be595"

/// `n - 1`.
decrement : Number -> Number
foreign pure decrement from "@flick-lang/runtime/effect/Number" "decrement"
  reviewed "effect@4.0.5 sha256:8a9a01f7a10ceef0"

/// The sum of the list, 0 when it is empty.
sum_all : List Number -> Number
foreign pure sum_all from "@flick-lang/runtime/effect/Number" "sumAll"
  reviewed "effect@4.0.5 sha256:72f0f5c0ebe9f2e2"

/// The product of the list, 1 when it is empty.
multiply_all : List Number -> Number
foreign pure multiply_all from "@flick-lang/runtime/effect/Number" "multiplyAll"
  reviewed "effect@4.0.5 sha256:568b0e4eebb80af0"

/// `self < that` by Effect's order: `x |> Number.is_less_than 3`.
is_less_than : Number -> Number -> Bool
foreign pure is_less_than from "@flick-lang/runtime/effect/Number" "isLessThan"
  arity 1
  reviewed "effect@4.0.5 sha256:f93dca59da8efce8"

/// `self <= that` by Effect's order.
is_less_than_or_equal_to : Number -> Number -> Bool
foreign pure is_less_than_or_equal_to from "@flick-lang/runtime/effect/Number" "isLessThanOrEqualTo"
  arity 1
  reviewed "effect@4.0.5 sha256:396e72de3afcdd6e"

/// `self > that` by Effect's order.
is_greater_than : Number -> Number -> Bool
foreign pure is_greater_than from "@flick-lang/runtime/effect/Number" "isGreaterThan"
  arity 1
  reviewed "effect@4.0.5 sha256:4b25fdb77a95059a"

/// `self >= that` by Effect's order.
is_greater_than_or_equal_to : Number -> Number -> Bool
foreign pure is_greater_than_or_equal_to from "@flick-lang/runtime/effect/Number" "isGreaterThanOrEqualTo"
  arity 1
  reviewed "effect@4.0.5 sha256:5b6c97534b4f6ed3"

/// Whether `self` lies within `minimum` and `maximum`, both included.
between : { minimum : Number; maximum : Number } -> Number -> Bool
foreign pure between from "@flick-lang/runtime/effect/Number" "between"
  arity 1
  reviewed "effect@4.0.5 sha256:20d59e8f086a60be"

/// `self` kept within `minimum` and `maximum`.
clamp : { minimum : Number; maximum : Number } -> Number -> Number
foreign pure clamp from "@flick-lang/runtime/effect/Number" "clamp"
  arity 1
  reviewed "effect@4.0.5 sha256:9f672d4a6810e097"

/// How `n` compares with 0; NaN is `LT`.
sign : Number -> Ordering
foreign pure sign from "@flick-lang/runtime/effect/Number" "flickSign"
  reviewed "effect@4.0.5 sha256:44055224f974a5bc"

/// The least power of two at least `n`, and at least 2.
next_pow2 : Number -> Number
foreign pure next_pow2 from "@flick-lang/runtime/effect/Number" "nextPow2"
  reviewed "effect@4.0.5 sha256:b4310805857b7079"

/// Rounded to `precision` decimal places: `3.14159 |> Number.round_to 2`.
round_to : Number -> Number -> Number
foreign pure round_to from "@flick-lang/runtime/effect/Number" "round"
  arity 1
  reviewed "effect@4.0.5 sha256:37c5519fadd3a790"

/// `n` itself when it is a safe integer.
safe_integer : Number -> Option Number
foreign pure safe_integer from "@flick-lang/runtime" "numberSafeInteger"

add_int : Number -> Number -> Result ArithmeticError Number
foreign pure add_int from "@flick-lang/runtime" "intAdd"

sub_int : Number -> Number -> Result ArithmeticError Number
foreign pure sub_int from "@flick-lang/runtime" "intSub"

mul_int : Number -> Number -> Result ArithmeticError Number
foreign pure mul_int from "@flick-lang/runtime" "intMul"

/// Integer division rounding toward zero; division by zero is an error.
div_int : Number -> Number -> Result ArithmeticError Number
foreign pure div_int from "@flick-lang/runtime" "intDiv"

rem_int : Number -> Number -> Result ArithmeticError Number
foreign pure rem_int from "@flick-lang/runtime" "intRem"

bit_and : Number -> Number -> Number
foreign pure bit_and from "@flick-lang/runtime" "bitAnd"

bit_or : Number -> Number -> Number
foreign pure bit_or from "@flick-lang/runtime" "bitOr"

bit_xor : Number -> Number -> Number
foreign pure bit_xor from "@flick-lang/runtime" "bitXor"

bit_not : Number -> Number
foreign pure bit_not from "@flick-lang/runtime" "bitNot"

shift_left : Number -> Number -> Number
foreign pure shift_left from "@flick-lang/runtime" "shiftLeft"

shift_right : Number -> Number -> Number
foreign pure shift_right from "@flick-lang/runtime" "shiftRight"

shift_right_unsigned : Number -> Number -> Number
foreign pure shift_right_unsigned from "@flick-lang/runtime" "shiftRightUnsigned"

/// A finite JSON number: `NaN` and the infinities are refused when decoding
/// and when encoding.
json_finite : PureCodec Json Number
foreign pure json_finite from "@flick-lang/runtime" "codecNumberFinite"

/// Every number: non-finite values and `-0` as the strings `"NaN"`,
/// `"Infinity"`, `"-Infinity"` and `"-0"`.
json : PureCodec Json Number
foreign pure json from "@flick-lang/runtime" "codecNumberLossless"
