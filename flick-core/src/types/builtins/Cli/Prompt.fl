/// Interactive prompts of Effect's CLI: a `Prompt a` describes questions
/// that end in an `a`, and `run` asks them on the service `Tty`, one key
/// press at a time. Prompts are ordinary runtime calls inside a handler.
module Cli.Prompt exposing (..)

/// Questions that end in an `a`; building one asks nothing.
type Prompt a

/// The terminal prompts draw on and read key presses from; `node` is the
/// terminal of the process, and a fake one is a `Layer.succeed Tty` record.
service Tty =
  read_key : Unit ->{; Terminal.QuitError} Terminal.UserInput
  display : String ->{} Unit
  columns : Unit ->{} Int
  rows : Unit ->{} Int

node_of : ServiceTag {Tty} -> Layer none none {Tty}
foreign pure node_of from "@flick-lang/runtime/cli" "promptNode"

/// The terminal of the process; Ctrl+C and Ctrl+D quit with `QuitError`.
node : Layer none none {Tty}
let node = node_of Tty

run_of : ServiceTag {Tty} -> Prompt a ->{Tty; Terminal.QuitError} a
foreign effect run_of from "@flick-lang/runtime/cli" "promptRun"
  arity 2
  reviewed "effect@4.0.5 sha256:18008f9b6d24eb7b"

/// Asks the questions on `Tty`; `QuitError` when its input ends or the user quits.
run : Prompt a ->{Tty; Terminal.QuitError} a
let run prompt = run_of Tty prompt

/// The symbols and colors the prompts draw with.
type alias Theme = {
  prefix : String;
  pointer : String;
  pointerSmall : String;
  ellipsis : String;
  tick : String;
  arrowUp : String;
  arrowDown : String;
  checkboxOn : String;
  checkboxOff : String;
  descriptionSeparator : String;
  passwordMask : String;
  toggleSeparator : String;
  primaryColor : String;
  mutedColor : String;
  successColor : String;
  errorColor : String;
  submittedColor : String;
  colors : Bool;
}

/// Effect's theme, with colors when the output supports them.
default_theme : Unit ->{} Theme
foreign sync default_theme from "@flick-lang/runtime/cli" "promptDefaultTheme"
  arity 0
  reviewed "effect@4.0.5 sha256:47c0b93e9a1682bd"

run_themed_of : ServiceTag {Tty} -> Theme -> Prompt a ->{Tty; Terminal.QuitError} a
foreign effect run_themed_of from "@flick-lang/runtime/cli" "promptRunThemed"
  arity 3
  reviewed "effect@4.0.5 sha256:f397581b74a20b3b"

/// `run`, drawing with `theme`.
run_themed : Theme -> Prompt a ->{Tty; Terminal.QuitError} a
let run_themed theme prompt = run_themed_of Tty theme prompt

/// A text question; `validate` refuses a value with the message shown.
type alias TextOptions = {
  message : String;
  default : Option String;
  validate : Option (String -> Result String String);
}

/// A line of text.
text : TextOptions -> Prompt String
foreign pure text from "@flick-lang/runtime/cli" "promptText"
  reviewed "effect@4.0.5 sha256:faa9b5f8f9dbaeb9"

/// A secret typed behind the theme's mask.
password : TextOptions -> Prompt (Redacted String)
foreign pure password from "@flick-lang/runtime/cli" "promptPassword"
  reviewed "effect@4.0.5 sha256:34d1d247c5a52093"

/// A secret typed without echo.
hidden : TextOptions -> Prompt (Redacted String)
foreign pure hidden from "@flick-lang/runtime/cli" "promptHidden"
  reviewed "effect@4.0.5 sha256:e1ad30ce884a96fd"

/// `TextOptions` with the `delimiter` between items (`,` when `None`).
type alias ListOptions = {
  message : String;
  default : Option String;
  validate : Option (String -> Result String String);
  delimiter : Option String;
}

/// Items typed on one line.
list : ListOptions -> Prompt (List String)
foreign pure list from "@flick-lang/runtime/cli" "promptList"
  reviewed "effect@4.0.5 sha256:73e85bc939aafc1c"

/// A number question: bounds, the steps of the arrow keys and a check.
type alias IntOptions = {
  message : String;
  default : Option Int;
  min : Option Int;
  max : Option Int;
  incrementBy : Option Int;
  decrementBy : Option Int;
  validate : Option (Int -> Result String Int);
}

/// An integer.
int : IntOptions -> Prompt Int
foreign pure int from "@flick-lang/runtime/cli" "promptInt"
  reviewed "effect@4.0.5 sha256:85daa1430ff41c31"

/// `IntOptions` with the digits after the point.
type alias NumberOptions = {
  message : String;
  default : Option Float;
  min : Option Float;
  max : Option Float;
  incrementBy : Option Float;
  decrementBy : Option Float;
  validate : Option (Float -> Result String Float);
  precision : Option Int;
}

/// A number with a fractional part.
number : NumberOptions -> Prompt Float
foreign pure number from "@flick-lang/runtime/cli" "promptNumber"
  reviewed "effect@4.0.5 sha256:08a8804170ffcc4a"

/// The words of a yes/no question.
type alias ConfirmLabel = { confirm : String; deny : String }

/// What the question shows after it for each default.
type alias ConfirmPlaceholder = { defaultConfirm : Option String; defaultDeny : Option String }

/// A yes/no question.
type alias ConfirmOptions = {
  message : String;
  initial : Option Bool;
  label : Option ConfirmLabel;
  placeholder : Option ConfirmPlaceholder;
}

/// Yes or no, typed as `y` or `n`.
confirm : ConfirmOptions -> Prompt Bool
foreign pure confirm from "@flick-lang/runtime/cli" "promptConfirm"
  reviewed "effect@4.0.5 sha256:941f4c739c6b6e2c"

/// A switch between two words.
type alias ToggleOptions = {
  message : String;
  initial : Option Bool;
  active : Option String;
  inactive : Option String;
}

/// On or off, moved with the arrow keys.
toggle : ToggleOptions -> Prompt Bool
foreign pure toggle from "@flick-lang/runtime/cli" "promptToggle"
  reviewed "effect@4.0.5 sha256:8e2b9474cf4d4fb2"

/// The names of months and weekdays, long and short.
type alias DateLocales = {
  months : List String;
  monthsShort : List String;
  weekdays : List String;
  weekdaysShort : List String;
}

/// A date question: its mask (`YYYY-MM-DD HH:mm:ss` by default) and a check.
type alias DateOptions = {
  message : String;
  initial : Option DateTime.DateTime;
  dateMask : Option String;
  validate : Option (DateTime.DateTime -> Result String DateTime.DateTime);
  locales : Option DateLocales;
}

/// A date and time, edited part by part.
date : DateOptions -> Prompt DateTime.DateTime
foreign pure date from "@flick-lang/runtime/cli" "promptDate"
  reviewed "effect@4.0.5 sha256:263b01cd88c91dea"

/// What a path names: a file, a directory, or either.
type PathType = FilePath | DirectoryPath | EitherPath
  deriving Eq, Show

/// A path chosen by walking the file system from `startingPath`.
type alias FileOptions = {
  type_ : Option PathType;
  message : Option String;
  startingPath : Option String;
  default : Option String;
  maxPerPage : Option Int;
  filter : Option (String -> Bool);
}

/// A path of the file system of Node.js.
file : FileOptions -> Prompt String
foreign pure file from "@flick-lang/runtime/cli" "promptFile"
  reviewed "effect@4.0.5 sha256:09c4f3321d9eec4b"

/// One choice of a selection.
type alias SelectChoice a = {
  title : String;
  value : a;
  description : Option String;
  disabled : Bool;
  selected : Bool;
}

/// A selection among `choices`, `maxPerPage` at a time.
type alias SelectOptions a = {
  message : Option String;
  choices : List (SelectChoice a);
  maxPerPage : Option Int;
}

/// One of the choices, moved to with the arrow keys.
select : SelectOptions a -> Prompt a
foreign pure select from "@flick-lang/runtime/cli" "promptSelect"
  reviewed "effect@4.0.5 sha256:694d2c3b50601b9f"

/// A selection filtered by what the user types.
type alias AutoCompleteOptions a = {
  message : String;
  choices : List (SelectChoice a);
  maxPerPage : Option Int;
  filterLabel : Option String;
  filterPlaceholder : Option String;
  emptyMessage : Option String;
}

/// One of the choices that match the typed filter.
auto_complete : AutoCompleteOptions a -> Prompt a
foreign pure auto_complete from "@flick-lang/runtime/cli" "promptAutoComplete"
  reviewed "effect@4.0.5 sha256:b33ef84a0308a6bb"

/// The labels of the bulk actions of a multiple selection, and its bounds.
type alias MultiSelectOptions = {
  selectAll : Option String;
  selectNone : Option String;
  inverseSelection : Option String;
  min : Option Int;
  max : Option Int;
}

/// Any of the choices, toggled with space.
multi_select : SelectOptions a -> MultiSelectOptions -> Prompt (List a)
foreign pure multi_select from "@flick-lang/runtime/cli" "promptMultiSelect"
  arity 2
  reviewed "effect@4.0.5 sha256:1bac7838cd4f9fd5"

/// What a step of a custom prompt does: ring the bell, draw the next
/// state, or end with a value.
type Action s a = Beep | NextFrame s | Submit a

/// A key press, or a message of the prompt's queue of events.
type ProcessInput ev = Input Terminal.UserInput | Event ev

/// A custom prompt: the frame of a state, the step of an input, and what
/// erases a frame before the next one.
type alias Handlers s a i = {
  render : s -> Action s a -> String;
  process : i -> s -> Action s a;
  clear : s -> Action s a -> String;
}

/// A prompt of its own, from the first state.
custom : s -> Handlers s a Terminal.UserInput -> Prompt a
foreign pure custom from "@flick-lang/runtime/cli" "promptCustom"
  arity 2
  reviewed "effect@4.0.5 sha256:924998b86604ca75"

/// `custom` that also steps on the messages of `events`.
custom_events : s -> Queue.Queue none ev -> Handlers s a (ProcessInput ev) -> Prompt a
foreign pure custom_events from "@flick-lang/runtime/cli" "promptCustomEvents"
  arity 3
  reviewed "effect@4.0.5 sha256:924998b86604ca75"

/// The prompts one after another, with their answers in order.
all : List (Prompt a) -> Prompt (List a)
foreign pure all from "@flick-lang/runtime/cli" "promptAll"
  reviewed "effect@4.0.5 sha256:b5e5237e5b626c19"

/// The answer passed through `f`.
map : (a -> b) -> Prompt a -> Prompt b
foreign pure map from "@flick-lang/runtime/cli" "promptMap"
  arity 1
  reviewed "effect@4.0.5 sha256:ea6b1cb41ed96080"

/// The prompt `f` makes of the answer, asked next.
flat_map : (a -> Prompt b) -> Prompt a -> Prompt b
foreign pure flat_map from "@flick-lang/runtime/cli" "promptFlatMap"
  arity 1
  reviewed "effect@4.0.5 sha256:3f76f63447d9c83d"

/// The answer `value`, without asking.
succeed : a -> Prompt a
foreign pure succeed from "@flick-lang/runtime/cli" "promptSucceed"
  reviewed "effect@4.0.5 sha256:1006ececc7946365"
