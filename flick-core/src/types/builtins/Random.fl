/// Effect's `Random`: the fiber's source of randomness. It is a default
/// service, so drawing needs no service row; each draw is a runtime call,
/// and `with_seed` makes the draws of a task repeatable.
module Random exposing (..)

/// A number in [0, 1).
next : Unit ->{} Float
foreign effect next from "@flick-lang/runtime/effect/Random" "flickNext"
  arity 0
  reviewed "effect@4.0.5 sha256:139b4a34859dc62b"

/// `true` or `false`.
next_boolean : Unit ->{} Bool
foreign effect next_boolean from "@flick-lang/runtime/effect/Random" "flickNextBoolean"
  arity 0
  reviewed "effect@4.0.5 sha256:a67565a1f6dd2738"

/// A safe integer.
next_int : Unit ->{} Float
foreign effect next_int from "@flick-lang/runtime/effect/Random" "flickNextInt"
  arity 0
  reviewed "effect@4.0.5 sha256:1a7a2fb0fb70f2ba"

/// A number in [min, max).
next_between : Float -> Float ->{} Float
foreign effect next_between from "@flick-lang/runtime/effect/Random" "nextBetween"
  reviewed "effect@4.0.5 sha256:aa6a35c1f1be26d2"

/// An integer in [min, max], or [min, max) with `halfOpen`.
next_int_between : { halfOpen : Option Bool } -> Float -> Float ->{} Float
foreign effect next_int_between from "@flick-lang/runtime/effect/Random" "flickNextIntBetween"
  reviewed "effect@4.0.5 sha256:f366445a68ad45fc"

/// The elements in a random order.
shuffle : List a ->{} List a
foreign effect shuffle from "@flick-lang/runtime/effect/Random" "shuffle"
  reviewed "effect@4.0.5 sha256:0a20473062dfbea9"

/// One of the elements.
choice : NonEmpty.NonEmpty a ->{} a
foreign effect choice from "@flick-lang/runtime/effect/Random" "choice"
  reviewed "effect@4.0.5 sha256:902606ec0b585c36"

/// Runs `task` with a generator seeded by `seed`: the same seed, the same draws.
with_seed : forall c r e a. Float -> (Eff r e a)^c ->{r; e} a
foreign effect with_seed from "@flick-lang/runtime/effect/Random" "withSeed"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:2d13d347f06a3a37"
