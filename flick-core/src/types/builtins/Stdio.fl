/// Effect's `Stdio`: the arguments and standard streams of the process as a
/// service; `node` is those of Node.js. Effect's streams of the standard
/// streams (`stdin`, the `stdout` and `stderr` sinks) are not wrapped yet:
/// `write_stdout` and `write_stderr` write text through those sinks.
module Stdio exposing (..)

/// The operations of Effect's `Stdio`; the functions below call them.
service Stdio =
  args : Unit ->{} List String
  stdin_is_terminal : Unit ->{} Bool
  stdout_is_terminal : Unit ->{} Bool
  stderr_is_terminal : Unit ->{} Bool
  write_stdout : String ->{; PlatformError.PlatformError} Unit
  write_stderr : String ->{; PlatformError.PlatformError} Unit

/// The arguments the program was started with.
args : Unit ->{Stdio;} List String
let args () = Stdio.args ()

/// Whether stdin is a terminal.
stdin_is_terminal : Unit ->{Stdio;} Bool
let stdin_is_terminal () = Stdio.stdin_is_terminal ()

/// Whether stdout is a terminal.
stdout_is_terminal : Unit ->{Stdio;} Bool
let stdout_is_terminal () = Stdio.stdout_is_terminal ()

/// Whether stderr is a terminal.
stderr_is_terminal : Unit ->{Stdio;} Bool
let stderr_is_terminal () = Stdio.stderr_is_terminal ()

/// Writes the text to stdout as it is.
write_stdout : String ->{Stdio; PlatformError.PlatformError} Unit
let write_stdout text = Stdio.write_stdout text

/// Writes the text to stderr as it is.
write_stderr : String ->{Stdio; PlatformError.PlatformError} Unit
let write_stderr text = Stdio.write_stderr text

node_of : ServiceTag {Stdio} -> Layer none none {Stdio}
foreign pure node_of from "@flick-lang/runtime/effect/Stdio" "flickNode"
  reviewed "effect@4.0.5 sha256:92ea6c7dce0e93e7"

/// The arguments and standard streams of the Node.js process.
node : Layer none none {Stdio}
let node = node_of Stdio
