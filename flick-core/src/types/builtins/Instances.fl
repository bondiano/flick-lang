/// Instances of the built-in classes for the built-in types. Records and
/// tuples have theirs from the compiler; every module sees all of them.
module Instances

eq_prim : a -> a -> Bool
foreign pure eq_prim from "@flick-lang/runtime" "equals"

compare_prim : a -> a -> Ordering
foreign pure compare_prim from "@flick-lang/runtime" "compare"

hash_prim : a -> Number
foreign pure hash_prim from "@flick-lang/runtime" "hash"

show_prim : a -> String
foreign pure show_prim from "@flick-lang/runtime" "show"

eq_list : (a -> a -> Bool) -> List a -> List a -> Bool
foreign pure eq_list from "@flick-lang/runtime" "listEquals"

compare_list : (a -> a -> Ordering) -> List a -> List a -> Ordering
foreign pure compare_list from "@flick-lang/runtime" "listCompare"

hash_list : (a -> Number) -> List a -> Number
foreign pure hash_list from "@flick-lang/runtime" "listHash"

show_list : (a -> String) -> List a -> String
foreign pure show_list from "@flick-lang/runtime" "listShow"

instance Eq Number =
  eq : Number -> Number -> Bool
  let eq x y = eq_prim x y

instance Eq BigInt =
  eq : BigInt -> BigInt -> Bool
  let eq x y = eq_prim x y

instance Eq String =
  eq : String -> String -> Bool
  let eq x y = eq_prim x y

instance Eq Bool =
  eq : Bool -> Bool -> Bool
  let eq x y = eq_prim x y

instance Eq Unit =
  eq : Unit -> Unit -> Bool
  let eq x y = true

instance Eq Ordering =
  eq : Ordering -> Ordering -> Bool
  let eq x y = eq_prim x y

instance Eq a => Eq (List a) =
  eq : List a -> List a -> Bool
  let eq xs ys = eq_list eq xs ys

instance Eq a => Eq (Option a) =
  eq : Option a -> Option a -> Bool
  let eq x y =
    match (x, y) with
    | (Some a, Some b) -> eq a b
    | (None, None) -> true
    | _ -> false

instance (Eq e, Eq a) => Eq (Result e a) =
  eq : Result e a -> Result e a -> Bool
  let eq x y =
    match (x, y) with
    | (Ok a, Ok b) -> eq a b
    | (Err a, Err b) -> eq a b
    | _ -> false

instance Ord Number =
  compare : Number -> Number -> Ordering
  let compare x y = compare_prim x y

instance Ord BigInt =
  compare : BigInt -> BigInt -> Ordering
  let compare x y = compare_prim x y

instance Ord String =
  compare : String -> String -> Ordering
  let compare x y = compare_prim x y

instance Ord Bool =
  compare : Bool -> Bool -> Ordering
  let compare x y = compare_prim x y

instance Ord Unit =
  compare : Unit -> Unit -> Ordering
  let compare x y = EQ

instance Ord a => Ord (List a) =
  compare : List a -> List a -> Ordering
  let compare xs ys = compare_list compare xs ys

instance Ord a => Ord (Option a) =
  compare : Option a -> Option a -> Ordering
  let compare x y =
    match (x, y) with
    | (Some a, Some b) -> compare a b
    | (None, None) -> EQ
    | (None, _) -> LT
    | _ -> GT

instance Hash Number =
  hash : Number -> Number
  let hash x = hash_prim x

instance Hash BigInt =
  hash : BigInt -> Number
  let hash x = hash_prim x

instance Hash String =
  hash : String -> Number
  let hash x = hash_prim x

instance Hash Bool =
  hash : Bool -> Number
  let hash x = hash_prim x

instance Hash Unit =
  hash : Unit -> Number
  let hash x = 0

instance Hash a => Hash (List a) =
  hash : List a -> Number
  let hash xs = hash_list hash xs

instance Hash a => Hash (Option a) =
  hash : Option a -> Number
  let hash x =
    match x with
    | Some a -> hash a
    | None -> 0

instance Show Number =
  show : Number -> String
  let show x = show_prim x

instance Show BigInt =
  show : BigInt -> String
  let show x = show_prim x

instance Show String =
  show : String -> String
  let show x = show_prim x

instance Show Bool =
  show : Bool -> String
  let show x = show_prim x

instance Show Unit =
  show : Unit -> String
  let show x = "()"

instance Show Ordering =
  show : Ordering -> String
  let show x = show_prim x

instance Show a => Show (List a) =
  show : List a -> String
  let show xs = show_list show xs

instance Show a => Show (Option a) =
  show : Option a -> String
  let show x =
    match x with
    | Some a -> "Some " ++ show a
    | None -> "None"

instance (Show e, Show a) => Show (Result e a) =
  show : Result e a -> String
  let show x =
    match x with
    | Ok a -> "Ok " ++ show a
    | Err e -> "Err " ++ show e

instance (Ord e, Ord a) => Ord (Result e a) =
  compare : Result e a -> Result e a -> Ordering
  let compare x y =
    match (x, y) with
    | (Err a, Err b) -> compare a b
    | (Ok a, Ok b) -> compare a b
    | (Err _, _) -> LT
    | _ -> GT

instance (Hash e, Hash a) => Hash (Result e a) =
  hash : Result e a -> Number
  let hash x =
    match x with
    | Ok a -> hash a
    | Err e -> 1 + hash e

instance Hash Ordering =
  hash : Ordering -> Number
  let hash x = hash_prim x

instance Ord Ordering =
  compare : Ordering -> Ordering -> Ordering
  let compare x y = compare_prim (rank x) (rank y)

rank : Ordering -> Number
let rank o =
  match o with
  | LT -> 0
  | EQ -> 1
  | GT -> 2

map_list : forall c d a b. (a -> b)^c -> ((List a)^d -> (List b)^(c + d))^c
foreign pure map_list from "@flick-lang/runtime" "listMap"
  arity 2
  retention call

fold_list : forall c a b. (b -> a -> b)^c -> (b -> (List a -> b)^c)^c
foreign pure fold_list from "@flick-lang/runtime" "listFold"
  arity 3
  retention call

traverse_list : forall c a b r e. (a ->{r; e} b)^c -> (List a ->{r; e} List b)^c
foreign effect traverse_list from "@flick-lang/runtime" "listMapEffect"
  retention call

flat_map_list : forall c d a b. (a -> (List b)^d)^c -> ((List a)^d -> (List b)^(c + d))^c
foreign pure flat_map_list from "@flick-lang/runtime" "listFlatMap"
  arity 2
  retention call

pure_eff : a -> Eff r e a
foreign pure pure_eff from "@flick-lang/runtime" "succeed"

flat_map_eff :
  forall c d r e a b. (a -> (Eff r e b)^d)^c -> ((Eff r e a)^d -> (Eff r e b)^(c + d))^c
foreign pure flat_map_eff from "@flick-lang/runtime" "flatMapEff"
  arity 2
  retention call

map_eff : forall c d r e a b. (a -> b)^c -> ((Eff r e a)^d -> (Eff r e b)^(c + d))^c
foreign pure map_eff from "@flick-lang/runtime" "mapEff"
  arity 2
  retention call

instance Functor Option =
  map : forall c d a b. (a -> b)^c -> ((Option a)^d -> (Option b)^(c + d))^c
  let map f value =
    match value with
    | None -> None
    | Some x -> Some (f x)

instance Foldable Option =
  fold : forall c a b. (b -> a -> b)^c -> (b -> (Option a -> b)^c)^c
  let fold f init value =
    match value with
    | None -> init
    | Some x -> f init x

instance Traversable Option =
  traverse : forall c a b r e. (a ->{r; e} b)^c -> (Option a ->{r; e} Option b)^c
  let traverse f value =
    match value with
    | None -> None
    | Some x -> Some (f x)

instance Applicative Option =
  pure : forall a. a -> Option a
  let pure x = Some x

instance Monad Option =
  flat_map : forall c d a b. (a -> (Option b)^d)^c -> ((Option a)^d -> (Option b)^(c + d))^c
  let flat_map f value =
    match value with
    | None -> None
    | Some x -> f x

instance Functor (Result e) =
  map : forall c d a b. (a -> b)^c -> ((Result e a)^d -> (Result e b)^(c + d))^c
  let map f value =
    match value with
    | Err e -> Err e
    | Ok x -> Ok (f x)

instance Foldable (Result e) =
  fold : forall c a b. (b -> a -> b)^c -> (b -> (Result e a -> b)^c)^c
  let fold f init value =
    match value with
    | Err _ -> init
    | Ok x -> f init x

instance Traversable (Result e) =
  traverse : forall c a b r x. (a ->{r; x} b)^c -> (Result e a ->{r; x} Result e b)^c
  let traverse f value =
    match value with
    | Err e -> Err e
    | Ok a -> Ok (f a)

instance Applicative (Result e) =
  pure : forall a. a -> Result e a
  let pure x = Ok x

instance Monad (Result e) =
  flat_map :
    forall c d a b. (a -> (Result e b)^d)^c -> ((Result e a)^d -> (Result e b)^(c + d))^c
  let flat_map f value =
    match value with
    | Err e -> Err e
    | Ok x -> f x

instance Functor List =
  map : forall c d a b. (a -> b)^c -> ((List a)^d -> (List b)^(c + d))^c
  let map f xs = map_list f xs

instance Foldable List =
  fold : forall c a b. (b -> a -> b)^c -> (b -> (List a -> b)^c)^c
  let fold f init xs = fold_list f init xs

instance Traversable List =
  traverse : forall c a b r e. (a ->{r; e} b)^c -> (List a ->{r; e} List b)^c
  let traverse f xs = traverse_list f xs

instance Applicative List =
  pure : forall a. a -> List a
  let pure x = [x]

instance Monad List =
  flat_map : forall c d a b. (a -> (List b)^d)^c -> ((List a)^d -> (List b)^(c + d))^c
  let flat_map f xs = flat_map_list f xs

instance Functor (Eff r e) =
  map : forall c d a b. (a -> b)^c -> ((Eff r e a)^d -> (Eff r e b)^(c + d))^c
  let map f eff = map_eff f eff

instance Applicative (Eff r e) =
  pure : forall a. a -> Eff r e a
  let pure x = pure_eff x

instance Monad (Eff r e) =
  flat_map :
    forall c d a b. (a -> (Eff r e b)^d)^c -> ((Eff r e a)^d -> (Eff r e b)^(c + d))^c
  let flat_map f eff = flat_map_eff f eff
