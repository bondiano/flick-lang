/// Effect's `HttpMiddleware` and `HttpEffect`: a handler is a function from
/// the request to the response, and a middleware a function from a handler
/// to a handler, so `handler |> Http.Middleware.logger |> Http.Middleware.cors
/// Http.Middleware.cors_options` composes them.
module Http.Middleware exposing (..)

import Http.ServerRequest exposing (ServerRequest)
import Http.ServerResponse exposing (ServerResponse)

/// A handler of requests that needs the services `r` and may fail with `e`.
type alias Handler (r : ServiceRow) (e : ErrorRow) = ServerRequest ->{r; e} ServerResponse

/// What `cors` allows: origins, methods and headers (none: any, or those of
/// the request), the headers a browser may read, how long the answer to a
/// preflight request holds, in seconds, and whether credentials are sent.
type alias CorsOptions =
  {
    allowedOrigins : List String;
    allowedMethods : List String;
    allowedHeaders : List String;
    exposedHeaders : List String;
    maxAge : Option Number;
    credentials : Bool
  }

/// `cors` that allows any origin.
cors_options : CorsOptions
let cors_options =
  { allowedOrigins = []; allowedMethods = []; allowedHeaders = []; exposedHeaders = []; maxAge = None; credentials = false }

/// What `compression` does: the algorithms it may use, preferred first
/// (none: the platform's), the smallest body it compresses, and the level of
/// an algorithm.
type alias CompressionOptions =
  { algorithms : List Http.Platform.CompressionAlgorithm; minSize : Option Number; levels : List (Http.Platform.CompressionAlgorithm, Number) }

/// Logs each request with its method, URL and status, and its failure.
logger : Handler r e -> Handler r e
foreign pure logger from "@flick-lang/runtime/effect/http/HttpMiddleware" "flickLogger"
  arity 1
  reviewed "effect@4.0.5 sha256:273dbfddf64ab5b1"

/// The handler with no log of its requests by `logger`.
with_logger_disabled : Handler r e -> Handler r e
foreign pure with_logger_disabled from "@flick-lang/runtime/effect/http/HttpMiddleware" "flickWithLoggerDisabled"
  arity 1
  reviewed "effect@4.0.5 sha256:a23f5ffa75fe52b4"

/// Runs each request in a server span, continuing the trace of its headers.
tracer : Handler r e -> Handler r e
foreign pure tracer from "@flick-lang/runtime/effect/http/HttpMiddleware" "flickTracer"
  arity 1
  reviewed "effect@4.0.5 sha256:35d3acdbc2d9d015"

/// Takes the host and the client address of a request from its
/// `X-Forwarded-*` headers, behind a proxy.
x_forwarded_headers : Handler r e -> Handler r e
foreign pure x_forwarded_headers from "@flick-lang/runtime/effect/http/HttpMiddleware" "flickXForwardedHeaders"
  arity 1
  reviewed "effect@4.0.5 sha256:64a69dc1477e3d49"

/// Parses the query of each request once for the router's decoders.
search_params_parser : Handler r e -> Handler r e
foreign pure search_params_parser from "@flick-lang/runtime/effect/http/HttpMiddleware" "flickSearchParamsParser"
  arity 1
  reviewed "effect@4.0.5 sha256:548fee1527db2edc"

/// Answers CORS preflight requests and adds the CORS headers to responses.
cors : CorsOptions -> Handler r e -> Handler r e
foreign pure cors from "@flick-lang/runtime/effect/http/HttpMiddleware" "flickCors"
  arity 2
  reviewed "effect@4.0.5 sha256:5a9cb34140380122"

/// Compresses response bodies by the `Accept-Encoding` of the request.
compression : CompressionOptions -> Handler r e -> Handler r e
foreign pure compression from "@flick-lang/runtime/effect/http/HttpMiddleware" "flickCompression"
  arity 2
  reviewed "effect@4.0.5 sha256:af22e04d244b96ff"

/// `compression` through the web `CompressionStream`: gzip and deflate,
/// whatever the levels say.
compression_web : CompressionOptions -> Handler r e -> Handler r e
foreign pure compression_web from "@flick-lang/runtime/effect/http/HttpMiddleware" "flickCompressionWeb"
  arity 2
  reviewed "effect@4.0.5 sha256:d1f41e90c6b44cde"

/// Decompresses request bodies by their `Content-Encoding`, refusing one
/// that grows past the size.
decompression : Option ByteSize.ByteSize -> Handler r e -> Handler r e
foreign pure decompression from "@flick-lang/runtime/effect/http/HttpMiddleware" "flickDecompression"
  arity 2
  reviewed "effect@4.0.5 sha256:efe18001f13cf523"

/// Runs `task` with no server span for the requests `f` accepts.
with_tracer_disabled_when : forall c r e a. (ServerRequest -> Bool) -> (Eff r e a)^c ->{r; e} a
foreign effect with_tracer_disabled_when from "@flick-lang/runtime/effect/http/HttpMiddleware" "flickWithTracerDisabledWhen"
  arity 2
  retention call
  reviewed "effect@4.0.5 sha256:ed330b667501bce9"

/// Runs `task` with no server span for requests of the URLs.
with_tracer_disabled_for_urls : forall c r e a. List String -> (Eff r e a)^c ->{r; e} a
foreign effect with_tracer_disabled_for_urls from "@flick-lang/runtime/effect/http/HttpMiddleware" "flickWithTracerDisabledForUrls"
  arity 2
  retention call
  reviewed "effect@4.0.5 sha256:a1edbac479e1c390"

/// Runs `task` naming the server span of a request by `f`.
with_span_name_generator : forall c r e a. (ServerRequest -> String) -> (Eff r e a)^c ->{r; e} a
foreign effect with_span_name_generator from "@flick-lang/runtime/effect/http/HttpMiddleware" "flickWithSpanNameGenerator"
  arity 2
  retention call
  reviewed "effect@4.0.5 sha256:bcf088d4ce6475f2"

/// Runs `task` recording in server spans only the headers `f name phase`
/// accepts; the phase is `"request"` or `"response"`.
with_tracer_header_filter : forall c r e a. (String -> String -> Bool) -> (Eff r e a)^c ->{r; e} a
foreign effect with_tracer_header_filter from "@flick-lang/runtime/effect/http/HttpMiddleware" "flickWithTracerHeaderFilter"
  arity 2
  retention call
  reviewed "effect@4.0.5 sha256:80416986cda2fed8"

/// Registers `f` to change the response to the request just before it is
/// sent, after every middleware.
append_pre_response_handler :
  (ServerRequest -> ServerResponse ->{; Http.ServerError.HttpServerError} ServerResponse) -> ServerRequest ->{} Unit
foreign effect append_pre_response_handler from "@flick-lang/runtime/effect/http/HttpMiddleware" "flickAppendPreResponseHandler"
  arity 2
  reviewed "effect@4.0.5 sha256:8d42b837128a6182"

/// The handler registering `f` with each request before it runs.
with_pre_response_handler :
  (ServerRequest -> ServerResponse ->{; Http.ServerError.HttpServerError} ServerResponse) -> Handler r e -> Handler r e
foreign pure with_pre_response_handler from "@flick-lang/runtime/effect/http/HttpMiddleware" "flickWithPreResponseHandler"
  arity 2
  reviewed "effect@4.0.5 sha256:f11574d6347dcaa0"

/// The handler answering each request and passing the request and its
/// response, or the response of its failure, to `send`: the end of a server.
to_handled :
  (ServerRequest -> ServerResponse ->{r2; e2} Unit) -> Handler r e -> (ServerRequest ->{r + r2;} Unit)
foreign pure to_handled from "@flick-lang/runtime/effect/http/HttpMiddleware" "flickToHandled"
  arity 2
  reviewed "effect@4.0.5 sha256:410e9b7d36d30ce7"
