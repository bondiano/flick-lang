/// Effect's `Multipart`: `multipart/form-data` bodies of server requests.
/// `persisted` reads the whole form, writing its files to temporary files
/// that the scope of region `s` removes; `with_limits` bounds what a form
/// may hold. A form read part by part waits for Flick's streams.
module Http.Multipart exposing (..)

/// A file of a form, written to `path` until the scope closes.
type alias PersistedFile = { key : String; name : String; contentType : String; path : String }

/// A whole form: its text fields and its files.
type Persisted

/// Why a form could not be read.
type MultipartErrorReason =
  | FileTooLarge
  | FieldTooLarge
  | BodyTooLarge
  | TooManyParts
  | InternalError
  | Parse
  deriving Eq, Show

/// A form that could not be read, with the reason; a server answers it
/// with 413 for a limit, 400 for a malformed form, 500 otherwise.
type error MultipartError = MultipartError MultipartErrorReason
  deriving Eq, Show

/// What `with_limits` bounds: the number of parts, the size of a field, of
/// a file and of the whole body, and the media types of parts read as
/// fields (none: the default ones).
type alias Limits =
  {
    maxParts : Option Number;
    maxFieldSize : Option ByteSize.ByteSize;
    maxFileSize : Option ByteSize.ByteSize;
    maxTotalSize : Option ByteSize.ByteSize;
    fieldMimeTypes : List String
  }

/// No bounds besides the defaults.
limits : Limits
let limits = { maxParts = None; maxFieldSize = None; maxFileSize = None; maxTotalSize = None; fieldMimeTypes = [] }

/// Reads the form of the request; its files are removed when the scope of
/// region `s` closes.
persisted : forall s. Http.ServerRequest.ServerRequest ->{Scope s; MultipartError} Persisted
foreign effect persisted from "@flick-lang/runtime/effect/http/Multipart" "flickPersisted"
  reviewed "effect@4.0.5 sha256:7c2d97a9b575ef4e"

/// Each text field with all its values.
fields : Persisted -> List (String, List String)
foreign pure fields from "@flick-lang/runtime/effect/http/Multipart" "flickFields"
  reviewed "effect@4.0.5 sha256:7c2d97a9b575ef4e"

/// Each file field with all its files.
files : Persisted -> List (String, List PersistedFile)
foreign pure files from "@flick-lang/runtime/effect/http/Multipart" "flickFiles"
  reviewed "effect@4.0.5 sha256:4d1c89a92aadd42d"

/// Decodes the form: an object of a string, strings or files (records of
/// `PersistedFile`'s fields) for each key.
schema_persisted : Codec rd re Json a -> Persisted ->{rd; SchemaError} a
foreign effect schema_persisted from "@flick-lang/runtime/effect/http/Multipart" "flickSchemaPersisted"
  arity 2
  reviewed "effect@4.0.5 sha256:947b6de4b7f057ec"

/// Decodes the JSON text of the field of the form.
schema_json : Codec rd re Json a -> String -> Persisted ->{rd; SchemaError} a
foreign effect schema_json from "@flick-lang/runtime/effect/http/Multipart" "flickSchemaJson"
  arity 3
  reviewed "effect@4.0.5 sha256:f56a1dd7a3f2a1c7"

/// Decodes the form of the request, as `schema_persisted` of `persisted`.
schema_body_multipart :
  forall s rd re a.
  Codec rd re Json a -> Http.ServerRequest.ServerRequest ->{Scope s | rd; MultipartError, SchemaError} a
foreign effect schema_body_multipart from "@flick-lang/runtime/effect/http/Multipart" "flickSchemaBodyMultipart"
  arity 2
  reviewed "effect@4.0.5 sha256:19037ac1c9df1f52"

/// Decodes the form of the request: a multipart form as
/// `schema_body_multipart`, any other as URL parameters.
schema_body_form :
  forall s rd re a.
  Codec rd re Json a ->
  Http.ServerRequest.ServerRequest ->{Scope s | rd; Http.ServerError.HttpServerError, MultipartError, SchemaError} a
foreign effect schema_body_form from "@flick-lang/runtime/effect/http/Multipart" "flickSchemaBodyForm"
  arity 2
  reviewed "effect@4.0.5 sha256:bffe6740849fd0ac"

/// Decodes the JSON text of the field of the request's form.
schema_body_form_json :
  forall s rd re a.
  Codec rd re Json a -> String -> Http.ServerRequest.ServerRequest ->{Scope s | rd; MultipartError, SchemaError} a
foreign effect schema_body_form_json from "@flick-lang/runtime/effect/http/Multipart" "flickSchemaBodyFormJson"
  arity 3
  reviewed "effect@4.0.5 sha256:689e48d5b357ade0"

/// Runs `task` with the limits for the forms it reads.
with_limits : forall c r e a. Limits -> (Eff r e a)^c ->{r; e} a
foreign effect with_limits from "@flick-lang/runtime/effect/http/Multipart" "flickWithLimits"
  arity 2
  retention call
  reviewed "effect@4.0.5 sha256:7d736d5d9b8ba138"

/// What the header of a part says: its field name, file name, media type
/// and disposition, with their parameters, and all its headers.
type alias PartInfo =
  {
    name : String;
    filename : Option String;
    contentType : String;
    contentTypeParameters : List (String, String);
    contentDisposition : String;
    contentDispositionParameters : List (String, String);
    headers : List (String, String)
  }

/// Whether the parser reads the part as a file: it has a file name, or a
/// media type that is not text.
default_is_file : PartInfo -> Bool
foreign pure default_is_file from "@flick-lang/runtime/effect/http/Multipart" "flickDefaultIsFile"
  reviewed "effect@4.0.5 sha256:ebe920f8a497dacd"

/// The text of a field's bytes, in the charset of its media type.
decode_field : PartInfo -> List Number -> String
foreign pure decode_field from "@flick-lang/runtime/effect/http/Multipart" "flickDecodeField"
  arity 2
  reviewed "effect@4.0.5 sha256:49be3c553d049561"
