show_cookies : Cookies -> String
foreign pure show_cookies from "@flick-lang/runtime/effect/http/Cookies" "flickShowCookies"
  reviewed "effect@4.0.5 sha256:11fd4e6d22a3d7d7"

instance Show Cookie =
  show : Cookie -> String
  let show x = show_cookie x

instance Show Cookies =
  show : Cookies -> String
  let show x = show_cookies x
