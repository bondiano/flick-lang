/// Effect's `Cookies`: the cookies of a response (`Set-Cookie`) or of a
/// request (`Cookie`). A cookie's value is a `Redacted String`: `show`
/// prints `<redacted>` for it, and reading it back is a runtime call. A
/// name, value, domain or path that a header cannot carry, or an infinite
/// `maxAge`, is a `CookiesError`.
module Http.Cookies exposing (..)

/// One cookie: its name, value and attributes.
type Cookie

/// Cookies by name, an immutable value.
type Cookies

/// Whether the cookie is sent along with requests from other sites.
type SameSite = Lax | Strict | NoSameSite
  deriving Eq, Show

/// How early the browser drops the cookie when it runs out of room.
type Priority = Low | Medium | High
  deriving Eq, Show

/// The attributes of a cookie; `attributes` sets none of them.
type alias Attributes =
  {
    domain : Option String;
    expires : Option DateTime.DateTime;
    maxAge : Option Duration.Duration;
    path : Option String;
    priority : Option Priority;
    httpOnly : Bool;
    secure : Bool;
    partitioned : Bool;
    sameSite : Option SameSite
  }

/// No attribute set: `{ Http.Cookies.attributes with secure = true }`.
attributes : Attributes
let attributes =
  {
    domain = None;
    expires = None;
    maxAge = None;
    path = None;
    priority = None;
    httpOnly = false;
    secure = false;
    partitioned = false;
    sameSite = None
  }

/// What a header cannot carry.
type CookiesErrorReason =
  | InvalidCookieName
  | InvalidCookieValue
  | InvalidCookieDomain
  | InvalidCookiePath
  | CookieInfinityMaxAge
  deriving Eq, Show

/// A cookie that could not be made, with the reason.
type error CookiesError = CookiesError CookiesErrorReason
  deriving Eq, Show

/// No cookies.
empty : Cookies
foreign pure empty from "@flick-lang/runtime/effect/http/Cookies" "empty"
  reviewed "effect@4.0.5 sha256:7380f714940d942d"

/// Whether there are no cookies.
is_empty : Cookies -> Bool
foreign pure is_empty from "@flick-lang/runtime/effect/http/Cookies" "isEmpty"
  arity 1
  reviewed "effect@4.0.5 sha256:bdab5bce94d74c27"

/// The cookies of `Set-Cookie` header values; a value that is no cookie is
/// left out.
from_set_cookie : List String -> Cookies
foreign pure from_set_cookie from "@flick-lang/runtime/effect/http/Cookies" "fromSetCookie"
  arity 1
  reviewed "effect@4.0.5 sha256:0abf1daf451077cf"

/// The cookies, a later one of a name replacing an earlier one.
from_iterable : List Cookie -> Cookies
foreign pure from_iterable from "@flick-lang/runtime/effect/http/Cookies" "fromIterable"
  arity 1
  reviewed "effect@4.0.5 sha256:b382fa08b6105caa"

/// The cookies of the pairs, each under the name it is paired with.
