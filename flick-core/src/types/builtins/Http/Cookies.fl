foreign sync value from "@flick-lang/runtime/effect/http/Cookies" "flickValue"
  reviewed "effect@4.0.5 sha256:0933207c35e90cae"

show_cookie : Cookie -> String
foreign pure show_cookie from "@flick-lang/runtime/effect/http/Cookies" "flickShowCookie"
