/// Effect's `Reducer`: a combiner with a start value, which folds a whole
/// list: `Reducer.combine_all Reducer.number_sum [1, 2, 3]` is 6.
module Reducer exposing (..)

/// Effect's reducer of values of `a`.
type Reducer a

/// The reducer of `combine` starting from `initial`.
make : (a -> a -> a) -> a -> Reducer a
foreign pure make from "@flick-lang/runtime/effect/Reducer" "make"
  arity 2
  reviewed "effect@4.0.5 sha256:ee774290311a23cf"

/// Combines `self` with `that`.
combine : Reducer a -> a -> a -> a
foreign pure combine from "@flick-lang/runtime/effect/Reducer" "flickCombine"

/// The start value: what an empty list reduces to.
initial_value : Reducer a -> a
foreign pure initial_value from "@flick-lang/runtime/effect/Reducer" "flickInitialValue"

/// Folds the list from the start value, first to last.
combine_all : Reducer a -> List a -> a
foreign pure combine_all from "@flick-lang/runtime/effect/Reducer" "flickCombineAll"

/// The reducer's combination without its start value.
to_combiner : Reducer a -> Combiner.Combiner a
foreign pure to_combiner from "@flick-lang/runtime/effect/Reducer" "flickToCombiner"

/// The reducer with the arguments of its combination swapped.
flip : Reducer a -> Reducer a
foreign pure flip from "@flick-lang/runtime/effect/Reducer" "flip"
  reviewed "effect@4.0.5 sha256:f89f57f47aa5dc8a"

/// Sums numbers from 0.
number_sum : Reducer Number
foreign pure number_sum from "@flick-lang/runtime/effect/Number" "ReducerSum"
  reviewed "effect@4.0.5 sha256:6c0fb4b3ca47aa81"

/// Multiplies numbers from 1.
number_multiply : Reducer Number
foreign pure number_multiply from "@flick-lang/runtime/effect/Number" "ReducerMultiply"
  reviewed "effect@4.0.5 sha256:51d34f295c4ba603"

/// The greatest number, from `-Infinity`.
number_max : Reducer Number
foreign pure number_max from "@flick-lang/runtime/effect/Number" "ReducerMax"
  reviewed "effect@4.0.5 sha256:576f6a67af67fdd5"

/// The least number, from `Infinity`.
number_min : Reducer Number
foreign pure number_min from "@flick-lang/runtime/effect/Number" "ReducerMin"
  reviewed "effect@4.0.5 sha256:1c3d89fc958e5de2"

/// Sums BigInts from 0.
bigint_sum : Reducer BigInt
foreign pure bigint_sum from "@flick-lang/runtime/effect/BigInt" "ReducerSum"
  reviewed "effect@4.0.5 sha256:2fb87e39bb66711a"

/// Multiplies BigInts from 1.
bigint_multiply : Reducer BigInt
foreign pure bigint_multiply from "@flick-lang/runtime/effect/BigInt" "ReducerMultiply"
  reviewed "effect@4.0.5 sha256:c43ba632b7583b43"

/// Joins strings from `""`.
string_concat : Reducer String
foreign pure string_concat from "@flick-lang/runtime/effect/String" "ReducerConcat"
  reviewed "effect@4.0.5 sha256:f005936903549672"
