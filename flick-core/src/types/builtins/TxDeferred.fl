/// Effect's `TxDeferred`: a value completed at most once, read inside
/// `Tx.atomically` transactions; awaiting it retries the transaction until
/// it is completed.
module TxDeferred exposing (..)

/// A transactional deferred that completes with an `a` or an error of `e`.
type TxDeferred a (e : ErrorRow)

/// A new deferred, not completed.
make : Unit ->{} TxDeferred a e
foreign effect make from "@flick-lang/runtime/effect/TxDeferred" "make"
  arity 0
  reviewed "effect@4.0.5 sha256:2c9059e16c2bf37d"

/// Its value, or its error as a typed failure; retries the transaction
/// while it is not completed (`await` is a keyword).
await_ : TxDeferred a e ->{Tx.Transaction; e} a
foreign effect await_ from "@flick-lang/runtime/effect/TxDeferred" "await"
  reviewed "effect@4.0.5 sha256:f0edc72d9760c34b"

/// Its outcome, if it is completed.
poll : TxDeferred a e ->{Tx.Transaction;} Option (Result (Errors e) a)
foreign effect poll from "@flick-lang/runtime/effect/TxDeferred" "poll"
  reviewed "effect@4.0.5 sha256:bc55cbe6b4ccce98"

/// Completes it with the outcome; false when it was already completed.
done : Result (Errors e) a -> TxDeferred a e ->{Tx.Transaction;} Bool
foreign effect done from "@flick-lang/runtime/effect/TxDeferred" "done"
  arity 1
  reviewed "effect@4.0.5 sha256:0923eff1e97152a2"

/// Completes it with the value; false when it was already completed.
succeed : a -> TxDeferred a e ->{Tx.Transaction;} Bool
foreign effect succeed from "@flick-lang/runtime/effect/TxDeferred" "succeed"
  arity 1
  reviewed "effect@4.0.5 sha256:fceed9a9fb98e5c7"

/// Completes it with the error; false when it was already completed.
fail : Errors e -> TxDeferred a e ->{Tx.Transaction;} Bool
foreign effect fail from "@flick-lang/runtime/effect/TxDeferred" "fail"
  arity 1
  reviewed "effect@4.0.5 sha256:91c64e09b1cd9a1d"
