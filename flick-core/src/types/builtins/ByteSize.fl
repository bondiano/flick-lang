/// Effect's `ByteSize`: an exact, non-negative number of bytes, made from
/// decimal (`kilobytes`, 1000) or binary (`kibibytes`, 1024) units and
/// formatted back into them. Constructors refuse a negative or inexact size.
module ByteSize exposing (..)

/// A number of bytes, a `BigInt` at run time.
type ByteSize

/// A unit: the byte, the decimal units (`KB` is `kB`) and the binary ones.
type ByteUnit =
  | B | KB | MB | GB | TB | PB | EB | ZB | YB | RB | QB
  | KiB | MiB | GiB | TiB | PiB | EiB | ZiB | YiB

/// How `format` writes a size: the digits after the point (2 by default; cut
/// to an integer from 0 to 20), whether to keep trailing zeros, and either a
/// unit or the largest fitting one of the binary or the decimal units.
type alias FormatOptions =
  {
    precision : Option Float;
    trailingZeros : Option Bool;
    binary : Bool;
    unit : Option ByteUnit;
  }

/// The options of `format` that pick the largest fitting binary unit.
default_format : FormatOptions
let default_format = { precision = None; trailingZeros = None; binary = true; unit = None }

/// No bytes.
zero : ByteSize
foreign pure zero from "@flick-lang/runtime/effect/ByteSize" "zero"
  reviewed "effect@4.0.5 sha256:c8f5ad84568cdd21"

instance Eq ByteSize =
  eq : ByteSize -> ByteSize -> Bool
  let eq x y = equals x y

instance Ord ByteSize =
  compare : ByteSize -> ByteSize -> Ordering
  let compare x y = compare (to_bigint x) (to_bigint y)

instance Hash ByteSize =
  hash : ByteSize -> Float
  let hash x = hash (to_bigint x)

instance Show ByteSize =
  show : ByteSize -> String
  let show x = format default_format x

/// `n` bytes; `None` unless that is a whole, non-negative, safe number of bytes.
bytes : Float -> Option ByteSize
foreign pure bytes from "@flick-lang/runtime/effect/ByteSize" "flickBytes"
