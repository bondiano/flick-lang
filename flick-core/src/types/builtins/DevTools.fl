/// The Effect DevTools: a program that provides `layer` sends its spans,
/// as they start and end, over a WebSocket to the DevTools at `url`, which
/// must already listen. The module is unstable, as Effect marks
/// `effect/devtools`.
module DevTools exposing (..)

/// Spans sent to the DevTools at `url`; Effect's default is
/// `ws://localhost:34437`.
layer : String -> Layer none none none
foreign pure layer from "@flick-lang/runtime/effect/devtools/DevTools" "devToolsLayer"
  reviewed "effect@4.0.5 sha256:8efdbda563d781dc"

/// Where the DevTools listen, and the headers of the WebSocket's handshake:
/// a token a proxy in front of them checks, say.
type alias Options = { url : String; headers : List (String, String) }

/// `layer` with handshake headers, which only Node's WebSocket sends.
/// Node only.
layer_with : Options -> Layer none none none
foreign pure layer_with from "@flick-lang/runtime/effect/devtools/DevToolsNode" "devToolsLayerWith"
  reviewed "effect@4.0.5 sha256:4d3f3adcabe3da54"
