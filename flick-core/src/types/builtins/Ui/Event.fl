/// The policies of event handlers: what happens to an event that comes
/// while the handler's earlier tasks still run. `capacity` and `limit` are
/// positive integers; a constant that is not one is `FLICK-U001`.
module Ui.Event exposing (..)

/// Ignores events while the task of an earlier one runs.
exhaust : forall c s. (s -> (Eff {Atom.Write, Ui.Document} none Unit)^c)^c -> (Ui.Handler s)^c
foreign pure exhaust from "@flick-lang/runtime/ui/react" "eventExhaust"
  retention call

/// Interrupts the running task, waits until it stopped, then runs the
/// last event; one event waits at most.
latest : forall c s. (s -> (Eff {Atom.Write, Ui.Document} none Unit)^c)^c -> (Ui.Handler s)^c
foreign pure latest from "@flick-lang/runtime/ui/react" "eventLatest"
  retention call

/// Runs events one by one, `capacity` of them waiting at most; an event
/// that finds the queue full is rejected and reported to the supervisor.
queue : forall c s. Float ->
  (s -> (Eff {Atom.Write, Ui.Document} none Unit)^c)^c ->
  (Ui.Handler s)^c
foreign pure queue from "@flick-lang/runtime/ui/react" "eventQueue"
  retention call

/// Runs at most `limit` tasks at once; an event beyond that is rejected and
/// reported to the supervisor.
concurrent : forall c s. Float ->
  (s -> (Eff {Atom.Write, Ui.Document} none Unit)^c)^c ->
  (Ui.Handler s)^c
foreign pure concurrent from "@flick-lang/runtime/ui/react" "eventConcurrent"
  retention call

/// Calls `decide` on the snapshot while the browser still waits, and
/// prevents the default action when it says so.
prevent_default :
  forall c s. (s -> Bool)^c -> (Ui.Handler s)^c -> (Ui.Handler s)^c
foreign pure prevent_default from "@flick-lang/runtime/ui/react" "eventPreventDefault"
  retention call
