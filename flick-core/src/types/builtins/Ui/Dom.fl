/// React DOM roots. Keep DOM imports out of `Ui`, so `Ui.mount_with` also
/// works with renderers that do not install `react-dom` or provide a document.
module Ui.Dom exposing (..)

/// The DOM element a root renders into.
type Container

/// The element with this id in the document.
container : String ->{} Option Container
foreign sync container from "@flick-lang/runtime/ui" "uiContainer"
  arity 1
  nullable

/// Renders `ui` into `container` with React. The views in it read atoms
/// from the provided registry, and each renders again only when an atom it
/// read changes. Each event runs a task of its handler, which writes atoms
/// with the `Atom.Write` provided here; a defect goes to `supervisor`, and
/// so does an event a full policy rejects. It runs until the fiber running
/// it is interrupted: then events stop at once, React unmounts, the handler
/// tasks are interrupted and joined, and only then it ends. A failure of `supervisor` itself ends it
/// as a defect. Markup a server rendered into `container` is hydrated.
mount :
  forall c r.
  Container ->
    (Failure none ->{r; none} Unit)^c ->
    Ui^c ->{Atom.Registry, Atom.Write | r; none}
    Never
foreign effect mount from "@flick-lang/runtime/ui" "uiMount"
  retention call
