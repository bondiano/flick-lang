/// Server markup. Keep `react-dom/server` out of `Ui`, so client programs
/// do not load it.
module Ui.Server exposing (..)

/// The markup of `ui`; a client root mounted on it with `Ui.Dom.mount`
/// hydrates it. Its views read atoms from the provided registry: give each
/// request its own with `provide Reactivity.Atom.layer { … }`, so requests
/// rendered at once do not see each other's atoms, and nothing reads that
/// registry once its `provide` ends. Handlers do not run here.
render : forall c r e. (Ui r e)^c ->{Reactivity.Atom.Registry; none} String
foreign effect render from "@flick-lang/runtime/ui/server" "uiServerRender"
  retention call

/// The serializable atoms of the registry as a JSON
/// `<script type="application/json" id="flick-state-…">` for the container
/// with this id, to put in the page after rendering it: `Ui.Dom.mount` on
/// that container writes them into its registry before its first render,
/// so the client starts from the server's values. An atom whose value its
/// codec does not encode is a defect naming its key.
state : String ->{Reactivity.Atom.Registry; none} String
foreign effect state from "@flick-lang/runtime/ui/server" "uiServerState"
  arity 1

/// The HTML of `ui`, without React: a template for mail or any markup no
/// client hydrates. Text and attribute values are escaped as `text` keeps
/// markup in text; views read atoms as a server does, from a registry of
/// this call alone, so the same `ui` always gives the same HTML. Handlers
/// are left out, and a foreign component, which only React renders, is a
/// defect.
to_html : forall r e. Ui r e -> String
foreign pure to_html from "@flick-lang/runtime/ui/html" "uiToHtml"
