/// Lists searched, compared as sets and grouped: the part of `List` over
/// Effect's `Array` that relates elements to each other. The variants
/// without `_with` use `Eq`.
module List.Search exposing (..)

/// The last element that satisfies `p`.
find_last : forall c a. (a -> Bool)^c -> (List a -> Option a)^c
foreign pure find_last from "@flick-lang/runtime/effect/Array" "findLast"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:3e1ffdb3d63e475f"

/// The index of the last element that satisfies `p`.
find_last_index : forall c a. (a -> Bool)^c -> (List a -> Option Int)^c
foreign pure find_last_index from "@flick-lang/runtime/effect/Array" "findLastIndex"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:60671cf447ac27fe"

/// The first element that satisfies `p`, with its index.
find_first_with_index : forall c a. (a -> Bool)^c -> (List a -> Option (a, Int))^c
foreign pure find_first_with_index from "@flick-lang/runtime/effect/Array" "findFirstWithIndex"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:2c3ff7b37d76bcd1"

/// How many elements satisfy `p`.
count_by : forall c a. (a -> Bool)^c -> (List a -> Int)^c
foreign pure count_by from "@flick-lang/runtime/effect/Array" "countBy"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:b2f09cf6564eb521"

/// Whether an element is `same` as `x`.
contains_with : forall c a. (a -> a -> Bool)^c -> (a -> List a -> Bool)^c
foreign pure contains_with from "@flick-lang/runtime/effect/Array" "containsWith"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:a905b752122d8264"

/// The first of each set of elements that are `same`, in order.
dedupe_with : forall c a. (a -> a -> Bool)^c -> (List a -> List a)^c
foreign pure dedupe_with from "@flick-lang/runtime/effect/Array" "dedupeWith"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:844a2faacd8c857f"

/// The first of each set of equal elements, in order.
dedupe : Eq a => List a -> List a
let dedupe xs = dedupe_with eq xs

/// The list without an element `same` as the one before it.
dedupe_adjacent_with : forall c a. (a -> a -> Bool)^c -> (List a -> List a)^c
foreign pure dedupe_adjacent_with from "@flick-lang/runtime/effect/Array" "dedupeAdjacentWith"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:1181d539d087bfa9"

/// The list without an element equal to the one before it.
dedupe_adjacent : Eq a => List a -> List a
let dedupe_adjacent xs = dedupe_adjacent_with eq xs

/// `xs |> difference_with same ys`: the elements of `xs` with none `same` in `ys`.
difference_with : forall c a. (a -> a -> Bool)^c -> (List a -> List a -> List a)^c
foreign pure difference_with from "@flick-lang/runtime/effect/Array" "differenceWith"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:4afcd61244bc46d6"

/// `xs |> difference ys`: the elements of `xs` not in `ys`.
difference : Eq a => List a -> List a -> List a
let difference ys xs = difference_with eq ys xs

/// `xs |> intersection_with same ys`: the elements of `xs` with one `same` in `ys`.
intersection_with : forall c a. (a -> a -> Bool)^c -> (List a -> List a -> List a)^c
foreign pure intersection_with from "@flick-lang/runtime/effect/Array" "intersectionWith"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:77e65f4896025372"

/// `xs |> intersection ys`: the elements of `xs` also in `ys`.
intersection : Eq a => List a -> List a -> List a
let intersection ys xs = intersection_with eq ys xs

/// `xs |> union_with ys same`: `xs`, then the elements of `ys` with none
/// `same` in `xs`, without duplicates.
union_with : forall c a. List a -> (a -> a -> Bool)^c -> (List a -> List a)^c
foreign pure union_with from "@flick-lang/runtime/effect/Array" "unionWith"
  arity 2
  retention call
  reviewed "effect@4.0.5 sha256:a10e448aef35d8ce"

/// `xs |> union ys`: the elements of both, each once.
union : Eq a => List a -> List a -> List a
let union ys xs = union_with ys eq xs

/// Runs of adjacent elements that `same` relates to the first of their run.
group_with : forall c a. (a -> a -> Bool)^c -> (List a -> List (NonEmpty.NonEmpty a))^c
let group_with same xs =
  match NonEmpty.from_list xs with
  | None -> []
  | Some ne -> NonEmpty.to_list (NonEmpty.group_with same ne)

/// Runs of adjacent equal elements.
group : Eq a => List a -> List (NonEmpty.NonEmpty a)
let group xs = group_with eq xs

/// The elements under the key `f` gives each, in order.
group_by : forall c a. (a -> String)^c -> (List a -> Record.ReadonlyRecord (NonEmpty.NonEmpty a))^c
foreign pure group_by from "@flick-lang/runtime/effect/Array" "groupBy"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:e61e2d5be7063971"

/// The strings joined with `separator` between them.
join : String -> List String -> String
foreign pure join from "@flick-lang/runtime/effect/Array" "join"
  arity 1
  reviewed "effect@4.0.5 sha256:2a4c74123b36ad16"
