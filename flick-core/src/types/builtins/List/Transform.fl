/// Lists combined, accumulated and taken apart: the part of `List` over
/// Effect's `Array` that computes new elements.
module List.Transform exposing (..)

/// `xs |> cartesian ys`: every pair of an element of `xs` and one of `ys`.
cartesian : List b -> List a -> List (a, b)
foreign pure cartesian from "@flick-lang/runtime/effect/Array" "cartesian"
  arity 1
  reviewed "effect@4.0.5 sha256:27e8b9b64b93c694"

/// `f` of every pair of an element of `xs` and one of `ys`.
cartesian_with : forall c a b d. List b -> (a -> b -> d)^c -> (List a -> List d)^c
foreign pure cartesian_with from "@flick-lang/runtime/effect/Array" "cartesianWith"
  arity 2
  retention call
  reviewed "effect@4.0.5 sha256:510ebcd5bae393a1"

/// `xs |> zip_with ys f`: `f` of the elements at each index of both, as
/// long as the shorter one.
zip_with : forall c a b d. List b -> (a -> b -> d)^c -> (List a -> List d)^c
foreign pure zip_with from "@flick-lang/runtime/effect/Array" "zipWith"
  arity 2
  retention call
  reviewed "effect@4.0.5 sha256:6c2154874d632092"

/// Maps each element while threading a state from the first: the final
/// state and the mapped list.
map_accum : forall c s a b. s -> (s -> a -> (s, b))^c -> (List a -> (s, List b))^c
foreign pure map_accum from "@flick-lang/runtime/effect/Array" "mapAccum"
  arity 2
  retention call
  reviewed "effect@4.0.5 sha256:9eae82ec484758de"

/// Every intermediate result of `fold_left`, `init` first.
scan : forall c a b. b -> (b -> a -> b)^c -> (List a -> NonEmpty.NonEmpty b)^c
foreign pure scan from "@flick-lang/runtime/effect/Array" "scan"
  arity 2
  retention call
  reviewed "effect@4.0.5 sha256:59c151daea4e9ab8"

/// Every intermediate result of a fold from the last element, `init` last.
scan_right : forall c a b. b -> (b -> a -> b)^c -> (List a -> NonEmpty.NonEmpty b)^c
foreign pure scan_right from "@flick-lang/runtime/effect/Array" "scanRight"
  arity 2
  retention call
  reviewed "effect@4.0.5 sha256:ca9246706cc0e8d7"

/// `f` of each suffix of the list, longest first.
extend : forall c a b. (List a -> b)^c -> (List a -> List b)^c
foreign pure extend from "@flick-lang/runtime/effect/Array" "extend"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:d8cac66dc625bf46"

/// The `Ok` values of `f` over the elements, up to the first `Err`.
filter_map_while : forall c a b e. (a -> Result e b)^c -> (List a -> List b)^c
foreign pure filter_map_while from "@flick-lang/runtime/effect/Iterable" "flickFilterMapWhile"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:7c8202cdac71ced9"

/// The values of the `Some` elements.
get_somes : List (Option a) -> List a
foreign pure get_somes from "@flick-lang/runtime/effect/Array" "getSomes"
  reviewed "effect@4.0.5 sha256:95d6b893bb2bd19d"

/// The errors of the `Err` elements.
get_failures : List (Result e a) -> List e
foreign pure get_failures from "@flick-lang/runtime/effect/Array" "getFailures"
  reviewed "effect@4.0.5 sha256:08ef9c290a6d3033"

/// The values of the `Ok` elements.
get_successes : List (Result e a) -> List a
foreign pure get_successes from "@flick-lang/runtime/effect/Array" "getSuccesses"
  reviewed "effect@4.0.5 sha256:325bb258ee275ed2"

/// The `Ok` values and the `Err` errors.
separate : List (Result e a) -> (List a, List e)
foreign pure separate from "@flick-lang/runtime/effect/Array" "separate"
  reviewed "effect@4.0.5 sha256:64996beb2cefeaff"

/// The `Ok` values and the `Err` errors of `f` over the elements.
partition_map : forall c a f p. (a -> Result f p)^c -> (List a -> (List p, List f))^c
foreign pure partition_map from "@flick-lang/runtime/effect/Array" "partition"
  arity 1
  retention call
  reviewed "effect@4.0.5 sha256:2041b78a35e1a52a"

/// The elements `f` produces from `seed`, until it gives `None`.
unfold : forall c a b. b -> (b -> Option (a, b))^c -> List a
foreign pure unfold from "@flick-lang/runtime/effect/Array" "unfold"
  retention call
  reviewed "effect@4.0.5 sha256:e0d90f7405483233"

/// `f`, its `Some` as a one-element list and `None` as the empty one.
lift_option : (a -> Option b) -> a -> List b
foreign pure lift_option from "@flick-lang/runtime/effect/Array" "liftOption"
  arity 1
  reviewed "effect@4.0.5 sha256:86c050dd9a97f7f1"

/// `[x]` when `p x` holds, `[]` otherwise.
lift_predicate : (a -> Bool) -> a -> List a
foreign pure lift_predicate from "@flick-lang/runtime/effect/Array" "liftPredicate"
  arity 1
  reviewed "effect@4.0.5 sha256:aebb7a8db587bbb8"

/// `f`, its `Ok` as a one-element list and `Err` as the empty one.
lift_result : (a -> Result e b) -> a -> List b
foreign pure lift_result from "@flick-lang/runtime/effect/Array" "liftResult"
  arity 1
  reviewed "effect@4.0.5 sha256:fe629cc51d8ef1d1"

/// Sorts by the `Ord` of the key `f` gives each element, keeping equal
/// ones in their order.
sort_with : Ord b => (a -> b) -> List a -> List a
let sort_with f xs = List.Core.sort_by (fun x y -> compare (f x) (f y)) xs

/// The list repeated `n` times.
repeat_all : Int -> List a -> List a
foreign pure repeat_all from "@flick-lang/runtime/effect/Iterable" "flickRepeat"
  arity 1
  reviewed "effect@4.0.5 sha256:a2eb4643a0757092"

/// `onEmpty ()` for the empty list, `onNonEmpty` of it otherwise.
match_ : { onEmpty : Unit -> b; onNonEmpty : NonEmpty.NonEmpty a -> b } -> List a -> b
foreign pure match_ from "@flick-lang/runtime/effect/Array" "match"
  arity 1
  reviewed "effect@4.0.5 sha256:7ed362fc2b2fed73"

/// `onEmpty ()` for the empty list, `onNonEmpty` of its head and tail otherwise.
match_left : { onEmpty : Unit -> b; onNonEmpty : a -> List a -> b } -> List a -> b
foreign pure match_left from "@flick-lang/runtime/effect/Array" "flickMatchLeft"
  arity 1
  reviewed "effect@4.0.5 sha256:d5567acc2f9dfd5c"

/// `onEmpty ()` for the empty list, `onNonEmpty` of its init and last otherwise.
match_right : { onEmpty : Unit -> b; onNonEmpty : List a -> a -> b } -> List a -> b
foreign pure match_right from "@flick-lang/runtime/effect/Array" "flickMatchRight"
  arity 1
  reviewed "effect@4.0.5 sha256:b16ef029ac9fd1ba"
