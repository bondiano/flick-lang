/// Effect's `TxPubSub`: a hub that hands each published element to every
/// subscriber, inside `Tx.atomically` transactions. A subscription
/// belongs to the `scope` that owns its region and ends when it closes.
module TxPubSub exposing (..)

/// A transactional hub of `a`.
type TxPubSub a

/// The queue of a subscriber of region `s`: what was published since it
/// subscribed, in order.
type Subscription (s : Region) a

/// A new hub that holds at most `capacity` elements a subscriber has not
/// taken; a publish to a full one waits.
bounded : Float ->{} TxPubSub a
foreign effect bounded from "@flick-lang/runtime/effect/TxPubSub" "bounded"
  reviewed "effect@4.0.5 sha256:1a3bc6a2a1facbbf"

/// A new bounded hub that drops what a full one is given.
dropping : Float ->{} TxPubSub a
foreign effect dropping from "@flick-lang/runtime/effect/TxPubSub" "dropping"
  reviewed "effect@4.0.5 sha256:e556246504ee8df7"

/// A new bounded hub that drops the oldest element when it is full.
sliding : Float ->{} TxPubSub a
foreign effect sliding from "@flick-lang/runtime/effect/TxPubSub" "sliding"
  reviewed "effect@4.0.5 sha256:2dbb9dc4eb92256a"

/// A new hub without a bound.
unbounded : Unit ->{} TxPubSub a
foreign effect unbounded from "@flick-lang/runtime/effect/TxPubSub" "unbounded"
  arity 0
  reviewed "effect@4.0.5 sha256:25fdbb53af6e9157"

/// The bound it was made with.
capacity : TxPubSub a -> Float
foreign pure capacity from "@flick-lang/runtime/effect/TxPubSub" "capacity"
  reviewed "effect@4.0.5 sha256:f245cdaa1143da88"

/// The most elements a subscriber has not taken yet.
size : TxPubSub a ->{Tx.Transaction;} Float
foreign effect size from "@flick-lang/runtime/effect/TxPubSub" "size"
  reviewed "effect@4.0.5 sha256:c888a453afec8f90"

/// Whether every subscriber has taken everything.
is_empty : TxPubSub a ->{Tx.Transaction;} Bool
foreign effect is_empty from "@flick-lang/runtime/effect/TxPubSub" "isEmpty"
  reviewed "effect@4.0.5 sha256:177493ac2ce03d85"

/// Whether a subscriber has an element to take.
is_non_empty : TxPubSub a ->{Tx.Transaction;} Bool
foreign effect is_non_empty from "@flick-lang/runtime/effect/TxPubSub" "isNonEmpty"
  reviewed "effect@4.0.5 sha256:03eeeb8180e1981a"

/// Whether a subscriber holds as many elements as the capacity.
is_full : TxPubSub a ->{Tx.Transaction;} Bool
foreign effect is_full from "@flick-lang/runtime/effect/TxPubSub" "isFull"
  reviewed "effect@4.0.5 sha256:278b3ee5ef9fc3e1"

/// Whether it was shut down.
is_shutdown : TxPubSub a ->{Tx.Transaction;} Bool
foreign effect is_shutdown from "@flick-lang/runtime/effect/TxPubSub" "isShutdown"
  reviewed "effect@4.0.5 sha256:8ed3f8e8aab16715"

/// Hands the element to every subscriber; false when it was dropped or
/// the hub is shut down.
publish : a -> TxPubSub a ->{Tx.Transaction;} Bool
foreign effect publish from "@flick-lang/runtime/effect/TxPubSub" "publish"
  arity 1
  reviewed "effect@4.0.5 sha256:63779402c69879d4"

/// Publishes the elements in order; false when one was dropped.
publish_all : List a -> TxPubSub a ->{Tx.Transaction;} Bool
foreign effect publish_all from "@flick-lang/runtime/effect/TxPubSub" "publishAll"
  arity 1
  reviewed "effect@4.0.5 sha256:0f2fc6b1f4a733b6"

/// Subscribes until the scope of region `s` closes.
subscribe : forall s a. TxPubSub a ->{Scope s;} Subscription s a
foreign effect subscribe from "@flick-lang/runtime/effect/TxPubSub" "subscribe"
  reviewed "effect@4.0.5 sha256:c0f21797880736f7"

/// Shuts it down: later publishes are refused and takes from its
/// subscriptions interrupt the fiber.
shutdown : TxPubSub a ->{Tx.Transaction;} Unit
foreign effect shutdown from "@flick-lang/runtime/effect/TxPubSub" "shutdown"
  reviewed "effect@4.0.5 sha256:e8534b436917ff59"

/// Retries the transaction until the hub is shut down.
await_shutdown : TxPubSub a ->{Tx.Transaction;} Unit
foreign effect await_shutdown from "@flick-lang/runtime/effect/TxPubSub" "awaitShutdown"
  reviewed "effect@4.0.5 sha256:2e6d0d63d84a3814"

/// Removes the oldest element of the subscription, waiting for one.
take : forall s a. Subscription s a ->{Tx.Transaction;} a
foreign effect take from "@flick-lang/runtime/effect/TxQueue" "take"
  retention call
  reviewed "effect@4.0.5 sha256:98a03d7d64e0d279"

/// Removes the oldest element of the subscription, if there is one.
poll : forall s a. Subscription s a ->{Tx.Transaction;} Option a
foreign effect poll from "@flick-lang/runtime/effect/TxQueue" "poll"
  retention call
  reviewed "effect@4.0.5 sha256:d90ea7655e719948"

/// Removes every element of the subscription, waiting for at least one.
take_all : forall s a. Subscription s a ->{Tx.Transaction;} NonEmpty.NonEmpty a
foreign effect take_all from "@flick-lang/runtime/effect/TxQueue" "takeAll"
  retention call
  reviewed "effect@4.0.5 sha256:4308b512040656d0"

/// The number of elements waiting in the subscription.
pending : forall s a. Subscription s a ->{Tx.Transaction;} Float
foreign effect pending from "@flick-lang/runtime/effect/TxQueue" "size"
  retention call
  reviewed "effect@4.0.5 sha256:4f107de686c5ad9d"
