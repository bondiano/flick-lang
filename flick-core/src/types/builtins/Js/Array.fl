/// Mutable JS arrays, behind runtime operations; a `List` is copied in and
/// out.
module Js.Array exposing (Array, make, from_list, to_list, push, get, set, length)

type Array a

make : Unit ->{} Array a
foreign sync make from "@flick-lang/runtime" "jsArrayMake"

from_list : List a ->{} Array a
foreign sync from_list from "@flick-lang/runtime" "jsArrayFromList"

to_list : Array a ->{} List a
foreign sync to_list from "@flick-lang/runtime" "jsArrayFromList"

push : Array a -> a ->{} Unit
foreign sync push from "@flick-lang/runtime" "jsArrayPush"

get : Number -> Array a ->{} Option a
foreign sync get from "@flick-lang/runtime" "listGet"

set : Number -> a -> Array a ->{} Unit
foreign sync set from "@flick-lang/runtime" "jsArraySet"

length : Array a ->{} Number
foreign sync length from "@flick-lang/runtime" "listLength"
