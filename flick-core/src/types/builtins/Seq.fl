/// Lazy sequences: every iteration starts over, so a `Seq` is a value like a
/// list. The infinite ones (`from`, `iterate`, `repeat`, `cycle`) end under
/// `take`, `take_while`, `find`, `first`, `any` or `all`; `to_list` and `fold`
/// of one never return.
module Seq exposing (..)

/// The elements of a list, which is a sequence already.
of_list : List a -> Seq a
foreign pure of_list from "@flick-lang/runtime" "seqOfList"

/// `n`, `n + 1`, … without end.
from : Number -> Seq Number
foreign pure from from "@flick-lang/runtime" "seqFrom"

/// `[from, from + 1, …]` below `until`, as `List.range`.
range : Number -> Number -> Seq Number
foreign pure range from "@flick-lang/runtime" "seqRange"
  arity 2

/// From `from` by `step` while short of `until`; nothing when `step` is 0.
range_by : Number -> Number -> Number -> Seq Number
foreign pure range_by from "@flick-lang/runtime" "seqRangeBy"
  arity 3

/// `x`, `f x`, `f (f x)`, … without end.
iterate : forall c a. (a -> a)^c -> (a -> (Seq a)^c)^c
foreign pure iterate from "@flick-lang/runtime" "seqIterate"
  arity 2
  retention call

/// `x` without end.
repeat : a -> Seq a
foreign pure repeat from "@flick-lang/runtime" "seqRepeat"

/// The elements of the list over and over; nothing for an empty list.
cycle : List a -> Seq a
foreign pure cycle from "@flick-lang/runtime" "seqCycle"

/// The values of `f` from the seed until it gives `None`.
unfold : forall c a s. (s -> Option (a, s))^c -> (s -> (Seq a)^c)^c
foreign pure unfold from "@flick-lang/runtime" "seqUnfold"
  arity 2
  retention call

/// The elements of the first, then those of the second.
append : forall d a. (Seq a)^d -> ((Seq a)^d -> (Seq a)^d)^d
foreign pure append from "@flick-lang/runtime" "seqAppend"
  arity 2
  retention call

map : forall c d a b. (a -> b)^c -> ((Seq a)^d -> (Seq b)^(c + d))^c
foreign pure map from "@flick-lang/runtime" "seqMap"
  arity 2
  retention call

filter : forall c d a. (a -> Bool)^c -> ((Seq a)^d -> (Seq a)^(c + d))^c
foreign pure filter from "@flick-lang/runtime" "seqFilter"
  arity 2
  retention call

filter_map : forall c d a b. (a -> Option b)^c -> ((Seq a)^d -> (Seq b)^(c + d))^c
foreign pure filter_map from "@flick-lang/runtime" "seqFilterMap"
  arity 2
  retention call

flat_map : forall c d a b. (a -> (Seq b)^d)^c -> ((Seq a)^d -> (Seq b)^(c + d))^c
foreign pure flat_map from "@flick-lang/runtime" "seqFlatMap"
  arity 2
  retention call

/// At most `n` elements; pulls none after the `n`-th, so it ends an infinite sequence.
take : forall d a. Number -> ((Seq a)^d -> (Seq a)^d)
foreign pure take from "@flick-lang/runtime" "seqTake"
  arity 2
  retention call

take_while : forall c d a. (a -> Bool)^c -> ((Seq a)^d -> (Seq a)^(c + d))^c
foreign pure take_while from "@flick-lang/runtime" "seqTakeWhile"
  arity 2
  retention call

drop : forall d a. Number -> ((Seq a)^d -> (Seq a)^d)
foreign pure drop from "@flick-lang/runtime" "seqDrop"
  arity 2
  retention call

drop_while : forall c d a. (a -> Bool)^c -> ((Seq a)^d -> (Seq a)^(c + d))^c
foreign pure drop_while from "@flick-lang/runtime" "seqDropWhile"
  arity 2
  retention call

/// Pairs in order, as long as the shorter one.
zip : forall d a b. (Seq a)^d -> ((Seq b)^d -> (Seq (a, b))^d)^d
foreign pure zip from "@flick-lang/runtime" "seqZip"
  arity 2
  retention call

zip_with : forall c d a b x. (a -> b -> x)^c ->
  ((Seq a)^d -> ((Seq b)^d -> (Seq x)^(c + d))^(c + d))^c
foreign pure zip_with from "@flick-lang/runtime" "seqZipWith"
  arity 3
  retention call

/// Each element with its index from 0.
enumerate : forall d a. (Seq a)^d -> (Seq (Number, a))^d
foreign pure enumerate from "@flick-lang/runtime" "seqEnumerate"
  retention call

/// `init`, then each running fold: `scan (+) 0 [1, 2]` is `0, 1, 3`.
scan : forall c d a b. (b -> a -> b)^c -> (b -> ((Seq a)^d -> (Seq b)^(c + d))^c)^c
foreign pure scan from "@flick-lang/runtime" "seqScan"
  arity 3
  retention call

/// Lists of `n` elements, the last one shorter; nothing when `n` is not positive.
chunks : forall d a. Number -> ((Seq a)^d -> (Seq (List a))^d)
foreign pure chunks from "@flick-lang/runtime" "seqChunks"
  arity 2
  retention call

/// Every run of `n` neighbouring elements, from the first.
windows : forall d a. Number -> ((Seq a)^d -> (Seq (List a))^d)
foreign pure windows from "@flick-lang/runtime" "seqWindows"
  arity 2
  retention call

/// All the elements: never ends on an infinite sequence.
to_list : Seq a -> List a
foreign pure to_list from "@flick-lang/runtime" "seqToList"

/// Folds from the first element; never ends on an infinite sequence.
fold : forall c a b. (b -> a -> b)^c -> (b -> (Seq a -> b)^c)^c
foreign pure fold from "@flick-lang/runtime" "seqFold"
  arity 3
  retention call

/// Stops at the first element that satisfies `p`.
any : forall c a. (a -> Bool)^c -> (Seq a -> Bool)^c
foreign pure any from "@flick-lang/runtime" "seqAny"
  arity 2
  retention call

/// Stops at the first element that does not satisfy `p`.
all : forall c a. (a -> Bool)^c -> (Seq a -> Bool)^c
foreign pure all from "@flick-lang/runtime" "seqAll"
  arity 2
  retention call

/// The first element that satisfies `p`.
find : forall c a. (a -> Bool)^c -> (Seq a -> Option a)^c
foreign pure find from "@flick-lang/runtime" "seqFind"
  arity 2
  retention call

first : Seq a -> Option a
foreign pure first from "@flick-lang/runtime" "seqFirst"

/// Runs a runtime function on each element in order, for what it does.
each_effect : forall c a r e. (a ->{r; e} Unit)^c -> (Seq a ->{r; e} Unit)^c
foreign effect each_effect from "@flick-lang/runtime" "seqEachEffect"
  retention call

/// Folds from the first element with a runtime function.
fold_effect : forall c a b r e. (b -> a ->{r; e} b)^c -> (b -> (Seq a ->{r; e} b)^c)^c
foreign effect fold_effect from "@flick-lang/runtime" "seqFoldEffect"
  retention call

empty : Seq a
let empty = of_list []

singleton : a -> Seq a
let singleton x = of_list [x]
