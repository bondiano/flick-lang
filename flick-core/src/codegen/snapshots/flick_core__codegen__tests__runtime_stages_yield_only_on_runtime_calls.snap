import { Effect } from "@flick-lang/effect-ts";
import * as $rt from "@flick-lang/effect-ts";
import * as $m_String from "../String.js";

export const NotFound = (_0) => ({ _tag: "NotFound#82397ace53fc", _0 });

export const $s_Users = $rt.service("App.Users.Users");

export const $s_Log = $rt.service("App.Users.Log");

export const normalize_name = (name) => $m_String.trim(name);

export const load_name = (id) => Effect.gen(function* () {
  const user = yield* $rt.operation($s_Users, "get", 1)(id);
  const name = normalize_name(user.name);
  yield* $rt.operation($s_Log, "info", 1)(name);
  return name;
});
