module Main exposing (main, collatz)

collatz : Int -> Int
let collatz n =
  let mut x = n
  let mut steps = 0
  loop {
    if x == 1 then break steps
    x = if x % 2 == 0 then x / 2 else 3 * x + 1
    steps = steps + 1
  }

main : Unit ->{} Unit
let main () = Platform.stdout_line (show (collatz 6))
