module Main exposing (main, total_age)

type error Invalid = Invalid String

parse_age : String ->{; Invalid} Int
let parse_age text =
  match Int.parse text with
  | Some n -> n
  | None -> from_result (Err (Invalid text))

sum_ages : String ->{; Invalid} Int
let sum_ages text =
  let mut total = 0
  for part <- String.split "," text do total = total + parse_age part
  total

total_age : String ->{} Int
let total_age text =
  try sum_ages text with
  | Invalid _ -> -1

main : Unit ->{} Unit
let main () = Platform.stdout_line "\{total_age "36,41"} \{total_age "36,x"}"
