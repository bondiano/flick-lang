module Main exposing (main, roman)

roman : Int -> String
let roman n =
  let values = [
    (1000, "M"),
    (900, "CM"),
    (500, "D"),
    (400, "CD"),
    (100, "C"),
    (90, "XC"),
    (50, "L"),
    (40, "XL"),
    (10, "X"),
    (9, "IX"),
    (5, "V"),
    (4, "IV"),
    (1, "I"),
  ]
  let mut left = n
  let mut text = ""
  for (value, digits) <- values do {
    while left >= value do {
      text = text ++ digits
      left = left - value
    }
  }
  text

main : Unit ->{} Unit
let main () = Platform.stdout_line "\{roman 4} \{roman 9} \{roman 2026}"
