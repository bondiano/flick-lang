---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<StarlightPage
  frontmatter={{
    title: "404 — Page not found",
    description: "The requested page could not be found.",
    template: "splash",
    editUrl: false,
    pagefind: false,
    hero: {
      tagline: "Check the address or use search to find a page.",
      actions: [
        { text: "Documentation", link: `${base}/start/` },
        { text: "Документация на русском", link: `${base}/ru/start/`, variant: "secondary" },
      ],
    },
  }}
/>
