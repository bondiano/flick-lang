---
// The end of the rail: the violet line runs into a yard and each section of the documentation
// leaves it on a track of the sidebar's colour. On a desktop the tracks fan out to a row of
// cards; on narrower screens the cards stand on the rail itself, one colour after another.
import RouteBend from "../RouteBend.astro";
import Icon from "../Icon.astro";
import { lineOf } from "../lines.ts";
import { texts } from "./copy.ts";

interface Props { locale: string; prefix: string; style: string; from: number; to: number }
const { locale, prefix, style, from, to } = Astro.props;
const text = texts(locale);

// In the sidebar's order, so each takes its section's colour.
const lines = [
  { name: text("Tour", "Тур"), href: "/tour/", body: text("Flick one idea at a time, with a program to run beside each one.", "Короткие уроки с программами, которые запускаются прямо в браузере.") },
  { name: text("Course", "Курс"), href: "/course/", body: text("Exercises that check your answer, three or four a lesson.", "Упражнения с проверкой ответа, по три или четыре на урок.") },
  { name: text("Get started", "Начало работы"), href: "/start/", body: text("Install Flick and build a first program, step by step.", "Установите Flick и соберите первую программу, шаг за шагом.") },
  { name: text("Handbook", "Руководство"), href: "/handbook/designing-with-effects/", body: text("Design a program with effects, and write a typed DSL of your own.", "Проектирование с эффектами и свой типизированный DSL.") },
  { name: text("Reference", "Справочник"), href: "/reference/syntax/", body: text("Syntax, types, effects, and every block and command.", "Синтаксис, типы, эффекты, все блоки и команды.") },
];

// Design pixels: a track every `PITCH` across, the branches `GAP` apart where they leave the rail,
// each turning down at 45 degrees with the hero's rounded corners.
const PITCH = 256;
const GAP = 28;
const TURN = 40;
const HEIGHT = 168;
const branch = (k: number) => {
  const y = (lines.length - 1 - k) * GAP;
  const x = k * PITCH;
  return `M0 ${y}H${x - TURN - 16}Q${x - TURN} ${y} ${x - TURN + 11.3} ${y + 11.3}L${x - 11.3} ${y + TURN - 11.3}Q${x} ${y + TURN} ${x} ${y + TURN + 16}V${HEIGHT}`;
};
const width = (lines.length - 1) * PITCH;
---
<section class="stop stop-depot" style={style} aria-labelledby="depot-title">
  <RouteBend from={from} to={to} />
  <div class="depot-head">
    <h2 id="depot-title">{text("End of the line. Change here for the docs", "Конечная. Пересадка на документацию")}</h2>
    <p class="stop-lead">{text("That was the overview. Each line below goes deeper, and you can get off at any station.", "Это был обзор. Каждая линия ниже ведёт глубже, и сойти можно на любой станции.")}</p>
    <p class="stop-text">{text("Flick is young and still growing. New stations open as the language does, so the journey goes on past this page.", "Flick ещё молод и продолжает расти. Новые станции открываются вместе с языком, так что путешествие не заканчивается на этой странице.")}</p>
  </div>
  <svg class="depot-map" style={`--width: ${width}`} viewBox={`-24 -24 ${width + 48} ${HEIGHT + 24}`} aria-hidden="true" focusable="false">
    {lines.map((_, k) => <path style={lineOf(k)} d={k === 0 ? `M0 -24V${HEIGHT}` : branch(k)} />)}
    <rect class="map-station" x="-22" y="-22" width="44" height={(lines.length - 2) * GAP + 44} rx="22" />
  </svg>
  <ul class="depot-cards">
    {lines.map(({ name, href, body }, k) => <li style={lineOf(k)}>
      <a href={`${prefix}${href}`}>
        <span class="depot-name">{name} <Icon name="arrow" size={18} /></span>
        <span class="depot-body">{body}</span>
      </a>
    </li>)}
  </ul>
</section>
