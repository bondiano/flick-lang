<script is:inline>
  // Apply browser preferences before paint; interactive controls are implemented in Flick.
  (() => {
    let theme = "light";
    try {
      theme = localStorage.getItem("starlight-theme") === "dark" ? "dark" : "light";
    } catch { /* Preference storage is optional in private browsing. */ }
    document.documentElement.dataset.theme = theme;
  })();
</script>
