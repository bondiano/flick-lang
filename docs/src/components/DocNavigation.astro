---
import CodeText from "./CodeText.astro";
import { holdsCurrent, lineOf } from "./lines.ts";

interface Entry {
  type: string;
  label: string;
  href?: string;
  isCurrent?: boolean;
  entries?: Entry[];
}
interface Props { entries: Entry[]; nested?: boolean }
const { entries, nested = false } = Astro.props;
const pages = (entry: Entry): number => entry.type === "link" ? 1 : (entry.entries ?? []).reduce((sum, child) => sum + pages(child), 0);
---
<ul class:list={["doc-nav-list", { "doc-nav-nested": nested }]}>
  {entries.map((entry, index) => <li style={nested ? undefined : lineOf(index)}>
    {entry.type === "link"
      ? <a href={entry.href} aria-current={entry.isCurrent ? "page" : undefined}><span><CodeText text={entry.label} /></span></a>
      : <details class="doc-nav-group" open={holdsCurrent(entry)}>
          <summary><span class="doc-nav-token"></span><span><CodeText text={entry.label} /></span><span class="doc-nav-count">{pages(entry)}</span></summary>
          <Astro.self entries={entry.entries ?? []} nested />
        </details>}
  </li>)}
</ul>
