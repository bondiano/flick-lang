---
interface Entry {
  type: string;
  label: string;
  href?: string;
  isCurrent?: boolean;
  entries?: Entry[];
}
interface Props { entries: Entry[]; nested?: boolean }
const { entries, nested = false } = Astro.props;
const pages = (entry: Entry): number => entry.type === "link" ? 1 : (entry.entries ?? []).reduce((sum, child) => sum + pages(child), 0);
const holdsCurrent = (entry: Entry): boolean => entry.isCurrent === true || (entry.entries ?? []).some(holdsCurrent);
---
<ul class:list={["doc-nav-list", { "doc-nav-nested": nested }]}>
  {entries.map((entry) => <li>
    {entry.type === "link"
      ? <a href={entry.href} aria-current={entry.isCurrent ? "page" : undefined}>{entry.label}</a>
      : <details class="doc-nav-group" open={holdsCurrent(entry)}>
          <summary><span class="doc-nav-token"></span>{entry.label}<span class="doc-nav-count">{pages(entry)}</span></summary>
          <Astro.self entries={entry.entries ?? []} nested />
        </details>}
  </li>)}
</ul>
