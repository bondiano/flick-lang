---
import "../styles/custom.css";
import Header from "./Header.astro";
import ThemeInit from "./ThemeInit.astro";
import SignalWave from "./SignalWave.astro";
import Brand from "./Brand.astro";
import Icon from "./Icon.astro";

const { locale = "en" } = Astro.props;
const ru = locale === "ru";
const prefix = ru ? "/ru" : "";
const text = (en: string, russian: string) => ru ? russian : en;
const features = [
  { icon: "code", title: text("Inference that follows you", "Вывод типов, который помогает"), body: text("Model with variants, compose with higher-kinded types, and let inference connect the details. Types work for you, not the other way around.", "Моделируйте данные вариантами, обобщайте с типами высших порядков и оставляйте детали выводу типов. Типы работают на вас, а не наоборот."), href: "/reference/types/" },
  { icon: "effects", title: text("Effects in the signature", "Эффекты видны в сигнатуре"), body: text("Know what a function needs and how it can fail. Write direct calls; the compiler handles the Effect sequencing.", "Знайте, что нужно функции и какие ошибки она возвращает. Пишите обычные вызовы — последовательность Effect построит компилятор."), href: "/reference/effects/" },
  { icon: "layers", title: text("JavaScript, not an island", "В экосистеме JavaScript"), body: text("Compile to ES modules, call JavaScript through typed bindings, and keep Effect as your runtime foundation.", "Компилируйте в ES-модули, вызывайте JavaScript через типизированные привязки и используйте Effect как основу выполнения."), href: "/reference/ffi/" },
];
const sections = [
  { title: "Learn", description: text("From your first program to effects, types, and regions. A path, not a wall of reference pages.", "От первой программы к эффектам, типам и регионам. Последовательный маршрут, а не стена справочных страниц."), href: "/learn/" },
  { title: "Guides", description: text("Build a CLI, handle failures, connect services, or put a Flick widget on a web page.", "Создайте CLI, обработайте ошибки, подключите сервисы или добавьте Flick-виджет на страницу."), href: "/guides/" },
  { title: "API", description: text("Language rules, runtime modules, compiler commands. Find the exact contract you need.", "Правила языка, модули рантайма и команды компилятора. Найдите нужный контракт."), href: "/api/" },
  { title: "Ecosystem", description: text("Effect, JavaScript interop, editor support, and the tools that connect everything.", "Effect, интеграция с JavaScript, поддержка редакторов и инструменты, которые всё связывают."), href: "/ecosystem/" },
];
---
<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{text("Flick — Less ceremony. More effect.", "Flick — Меньше церемоний. Больше эффекта.")}</title>
    <meta name="description" content={text("An ML-family language with higher-kinded types, typed effects and regions, compiled to JavaScript on Effect. Learn Flick and try it in your browser.", "Язык семейства ML с типами высших порядков, типизированными эффектами и регионами. Компилируется в JavaScript на Effect. Изучайте и пробуйте в браузере.")} />
    <link rel="canonical" href={`https://flick-lang.dev${prefix}/`} />
    <link rel="alternate" hreflang="en" href="https://flick-lang.dev/" />
    <link rel="alternate" hreflang="ru" href="https://flick-lang.dev/ru/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={ru ? "/fonts/geist-cyrillic.woff2" : "/fonts/geist-latin.woff2"} as="font" type="font/woff2" crossorigin />
    <ThemeInit />
  </head>
  <body class="flick-home">
    <!-- THESIS: Less language ceremony, with Effect's foundation visible. OWN-WORLD: cool paper, graphite, violet, geometric F and a quietly drifting dot wave. STORY: see real code, understand the language/runtime tradeoff, learn or play. FIRST VIEWPORT: broad 47/49 split, 76px headline left, working code editor right, learning and playground actions below the introduction. FORM: owner-approved Signal composition; explicit reference-grounded brief overrides seed b4336790. FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance -->
    <a class="skip-link" href="#main-content">{text("Skip to content", "Перейти к содержимому")}</a>
    <header class="home-header"><Header locale={locale} /></header>
    <main id="main-content" data-pagefind-body>
      <section class="signal-hero" aria-labelledby="hero-title">
        <div class="signal-hero-inner">
          <div class="hero-copy">
            <h1 id="hero-title">{text("Less ceremony.", "Меньше церемоний.")}<br /><span>{text("More effect.", "Больше эффекта.")}</span></h1>
            <p class="hero-description">{text("An ML language with typed effects, powerful inference, and the JavaScript ecosystem you already know.", "ML-язык с типизированными эффектами, мощным выводом типов и знакомой экосистемой JavaScript.")}</p>
            <div class="hero-actions">
              <a class="flick-button primary" href={`${prefix}/learn/`}>{text("Start learning", "Начать изучение")} <Icon name="arrow" size={18} /></a>
              <a class="flick-button secondary" href={`${prefix}/play/`}>{text("Open playground", "Открыть Play")}</a>
            </div>
            <p class="hero-footnote"><a class="runtime-link" href={`${prefix}/learn/flick-and-effect/`}>{text("A new language. A familiar runtime.", "Новый язык. Знакомый рантайм.")} <Icon name="arrow" size={16} /></a></p>
          </div>
          <div class="hero-demo">
            <SignalWave />
            <div id="flick-hero">
              <div class="hero-editor hero-loading"><pre>{'module Main exposing (main)\n\nmain : Unit ->{; AppError} Unit\nlet main () =\n  Platform.stdout_line "Hello, effects."'}</pre><p>{text("Loading the live example…", "Загружаем живой пример…")}</p></div>
            </div>
          </div>
        </div>
      </section>
      <section class="home-features home-section" aria-labelledby="features-title">
        <h2 id="features-title">{text("Your intent, without the scaffolding.", "Ваша идея — без лишних конструкций.")}</h2>
        <div class="feature-columns">{features.map((feature) => <article><Icon name={feature.icon} size={24} /><h3><a href={`${prefix}${feature.href}`}>{feature.title}</a></h3><p>{feature.body}</p></article>)}</div>
      </section>
      <section class="effect-section home-section" aria-labelledby="effect-title">
        <div class="effect-intro"><h2 id="effect-title">{text("Built on Effect.\nNot a replacement for it.", "Построен на Effect.\nНе вместо него.")}</h2><p>{text("Flick changes how you express a program, not the reason you chose a reliable effect runtime. There are good reasons to use either source language.", "Flick меняет способ выразить программу, а не причины выбрать надёжный рантайм эффектов. У обоих вариантов есть сильные стороны.")}</p><a class="text-link" href={`${prefix}/learn/flick-and-effect/`}>{text("Read the honest comparison", "Прочитать честное сравнение")} <Icon name="arrow" /></a></div>
        <div class="effect-tradeoffs">
          <article><h3>{text("What Flick brings", "Что добавляет Flick")}</h3><ul><li>{text("Direct-style effects, typed failures, and services as language constructs.", "Эффекты, типизированные ошибки и сервисы как конструкции языка.")}</li><li>{text("Higher-kinded types, type classes, and exhaustive pattern matching.", "Типы высших порядков, классы типов и исчерпывающее сопоставление с образцом.")}</li><li>{text("Static region and capture checks for scoped resources.", "Статическая проверка регионов и захватов для ресурсов областей.")}</li></ul></article>
          <article><h3>{text("What Effect gets right", "В чём силён сам Effect")}</h3><ul><li>{text("Adopt it directly in an existing TypeScript project. No new source language.", "Добавьте его прямо в TypeScript-проект. Без нового исходного языка.")}</li><li>{text("Use its ecosystem and installed TypeScript APIs without a binding layer.", "Используйте экосистему и TypeScript API пакетов без слоя привязок.")}</li><li>{text("Keep its established resource, concurrency, and observability tools.", "Сохраните инструменты управления ресурсами, конкурентностью и наблюдаемостью.")}</li></ul></article>
        </div>
      </section>
      <section class="explore-section home-section" aria-labelledby="explore-title">
        <div class="section-intro"><h2 id="explore-title">{text("Find your way in.", "Найдите свой маршрут.")}</h2><p>{text("Read a little. Build a little. Go deeper when you need to.", "Немного чтения. Немного практики. Детали — когда понадобятся.")}</p></div>
        <div class="explore-links">{sections.map((section) => <a href={`${prefix}${section.href}`}><div><h3>{section.title}</h3><p>{section.description}</p></div><Icon name="arrow" size={24} /></a>)}</div>
      </section>
      <section class="try-section home-section" aria-labelledby="try-title"><div><h2 id="try-title">{text("A little less setup.\nA lot more trying.", "Меньше настройки.\nБольше экспериментов.")}</h2><p>{text("The real compiler, in your browser. This site's widgets? Written in Flick, too.", "Настоящий компилятор в вашем браузере. Виджеты этого сайта тоже написаны на Flick.")}</p></div><div class="try-actions"><a class="flick-button primary" href={`${prefix}/play/`}>{text("Write some Flick", "Написать на Flick")} <Icon name="arrow" size={18} /></a><a class="text-link" href={`${prefix}/transpile/`}>{text("See the JavaScript it becomes", "Посмотреть получившийся JavaScript")} <Icon name="arrow" size={18} /></a></div></section>
    </main>
    <footer class="home-footer"><Brand href={`${prefix}/`} /><p>{text("A small language. On a strong foundation.", "Небольшой язык. С крепкой основой.")}</p><a href="https://github.com/bondiano/flick-lang"><Icon name="github" /> GitHub</a><a href="https://effect.website/">Effect <Icon name="northeast" size={16} /></a></footer>
    <script>
      import { runMain } from "@flick-lang/runtime";
      import { main } from "../widgets/Hero.fl";
      void runMain(main as Parameters<typeof runMain>[0]);
    </script>
  </body>
</html>
