---
import "../styles/custom.css";
import Header from "./Header.astro";
import ThemeInit from "./ThemeInit.astro";
import SignalWave from "./SignalWave.astro";
import Brand from "./Brand.astro";
import Icon from "./Icon.astro";
import { Effect } from "@flick-lang/runtime";
import { uiRenderStatic, type Ui } from "@flick-lang/runtime/ui/react";
import { renderToString } from "react-dom/server";
import { initial_view } from "../widgets/Hero.fl";

const { locale = "en" } = Astro.props;
const ru = locale === "ru";
const prefix = ru ? "/ru" : "";
const text = (en: string, russian: string) => ru ? russian : en;
const initialView = initial_view as (ru: boolean) => Effect.Effect<Ui>;
const heroHtml = renderToString(uiRenderStatic(await Effect.runPromise(initialView(ru))));
const features = [
  { icon: "code", title: text("Inference that follows you", "Типы данных и вывод типов"), body: text("Model with variants, compose with higher-kinded types, and let inference connect the details. Types work for you, not the other way around.", "Описывайте данные вариантными типами, а общие операции — через конструкторы типов. Компилятор выводит типы выражений и проверяет их по сигнатурам."), href: "/reference/types/" },
  { icon: "effects", title: text("Effects in the signature", "Эффекты видны в сигнатуре"), body: text("Know what a function needs and how it can fail. Write direct calls; the compiler handles the Effect sequencing.", "Сигнатура показывает, какие сервисы нужны функции и какие ошибки она может вернуть. Вызывайте функции напрямую — компилятор свяжет операции через Effect."), href: "/reference/effects/" },
  { icon: "layers", title: text("JavaScript, not an island", "Работа с JavaScript"), body: text("Compile to ES modules, call JavaScript through typed bindings, and keep Effect as your runtime foundation.", "Flick создаёт ES-модули. Вызывайте библиотеки JavaScript через типизированные привязки; за выполнение эффектов отвечает Effect."), href: "/reference/ffi/" },
];
const sections = [
  { title: text("Learn", "Изучение Flick"), description: text("From your first program to effects, types, and regions. A path, not a wall of reference pages.", "Начните с небольшой программы, затем разберитесь с типами, эффектами и временем жизни ресурсов."), href: "/learn/" },
  { title: text("Guides", "Руководства"), description: text("Build a CLI, handle failures, connect services, or put a Flick widget on a web page.", "Создайте приложение командной строки, подключите сервис или добавьте интерфейс Flick на веб-страницу."), href: "/guides/" },
  { title: text("API", "Справочник"), description: text("Language rules, runtime modules, compiler commands. Find the exact contract you need.", "Синтаксис и правила языка, функции библиотек и команды компилятора."), href: "/api/" },
  { title: text("Ecosystem", "Экосистема"), description: text("Effect, JavaScript interop, editor support, and the tools that connect everything.", "Узнайте, как Flick использует Effect, подключается к JavaScript-проекту и работает в редакторе."), href: "/ecosystem/" },
];
---
<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{text("Flick — Less ceremony. More effect.", "Flick — ML-язык на основе Effect")}</title>
    <meta name="description" content={text("An ML-family language with higher-kinded types, typed effects and regions, compiled to JavaScript on Effect. Learn Flick and try it in your browser.", "Flick — язык семейства ML с типами высших порядков, типизированными эффектами и проверкой времени жизни ресурсов. Компилируется в JavaScript и использует Effect.")} />
    <link rel="canonical" href={`https://flick-lang.dev${prefix}/`} />
    <link rel="alternate" hreflang="en" href="https://flick-lang.dev/" />
    <link rel="alternate" hreflang="ru" href="https://flick-lang.dev/ru/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={ru ? "/fonts/geist-cyrillic.woff2" : "/fonts/geist-latin.woff2"} as="font" type="font/woff2" crossorigin />
    <ThemeInit />
  </head>
  <body class="flick-home">
    <!-- THESIS: Less language ceremony, with Effect's foundation visible. OWN-WORLD: cool paper, graphite, violet, geometric F and a quietly drifting dot wave. STORY: see real code, understand the language/runtime tradeoff, learn or play. FIRST VIEWPORT: broad 47/49 split, 76px headline left, working code editor right, learning and playground actions below the introduction. FORM: owner-approved Signal composition; explicit reference-grounded brief overrides seed b4336790. FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance -->
    <a class="skip-link" href="#main-content">{text("Skip to content", "Перейти к содержимому")}</a>
    <header class="home-header"><Header locale={locale} /></header>
    <main id="main-content" data-pagefind-body>
      <section class="signal-hero" aria-labelledby="hero-title">
        <div class="signal-hero-inner">
          <div class="hero-copy">
            <h1 id="hero-title">{text("Less ceremony.", "ML-синтаксис.")}<br /><span>{text("More effect.", "На базе Effect.")}</span></h1>
            <p class="hero-description">{text("An ML language with typed effects, powerful inference, and the JavaScript ecosystem you already know.", "Описывайте данные вариантными типами, вызывайте эффекты напрямую и используйте библиотеки JavaScript.")}</p>
            <div class="hero-actions">
              <a class="flick-button primary" href={`${prefix}/learn/`}>{text("Start learning", "Начать изучение")} <Icon name="arrow" size={18} /></a>
              <a class="flick-button secondary" href={`${prefix}/play/`}>{text("Open playground", "Открыть Play")}</a>
            </div>
            <p class="hero-footnote"><a class="runtime-link" href={`${prefix}/learn/flick-and-effect/`}>{text("A new language. A familiar runtime.", "Сравнить Flick и TypeScript с Effect")} <Icon name="arrow" size={16} /></a></p>
          </div>
          <div class="hero-demo">
            <SignalWave />
            <div id="flick-hero" data-flick-ssr set:html={heroHtml}></div>
          </div>
        </div>
      </section>
      <section class="home-features home-section" aria-labelledby="features-title">
        <h2 id="features-title">{text("Your intent, without the scaffolding.", "Что умеет Flick")}</h2>
        <div class="feature-columns">{features.map((feature) => <article><Icon name={feature.icon} size={24} /><h3><a href={`${prefix}${feature.href}`}>{feature.title}</a></h3><p>{feature.body}</p></article>)}</div>
      </section>
      <section class="effect-section home-section" aria-labelledby="effect-title">
        <div class="effect-intro"><h2 id="effect-title">{text("Built on Effect.\nNot a replacement for it.", "Flick использует Effect.\nНе заменяет его.")}</h2><p>{text("Flick changes how you express a program, not the reason you chose a reliable effect runtime. There are good reasons to use either source language.", "Flick предлагает другой синтаксис и проверки компилятора. Планирование задач, обработка ошибок и освобождение ресурсов по-прежнему опираются на Effect. Выбор зависит от того, что нужно вашему проекту.")}</p><a class="text-link" href={`${prefix}/learn/flick-and-effect/`}>{text("Read the honest comparison", "Чем отличаются Flick и TypeScript с Effect")} <Icon name="arrow" /></a></div>
        <div class="effect-tradeoffs">
          <article><h3>{text("What Flick brings", "Что добавляет Flick")}</h3><ul><li>{text("Direct-style effects, typed failures, and services as language constructs.", "Прямые вызовы эффектов, типизированные ошибки и сервисы средствами языка.")}</li><li>{text("Higher-kinded types, type classes, and exhaustive pattern matching.", "Типы высших порядков, классы типов и проверка полноты сопоставления с образцом.")}</li><li>{text("Static region and capture checks for scoped resources.", "Проверка того, что ресурсы и ссылки на них не покидают свою область владения.")}</li></ul></article>
          <article><h3>{text("What Effect gets right", "Когда удобнее TypeScript с Effect")}</h3><ul><li>{text("Adopt it directly in an existing TypeScript project. No new source language.", "Можно подключить библиотеку в существующий TypeScript-проект, не меняя язык.")}</li><li>{text("Use its ecosystem and installed TypeScript APIs without a binding layer.", "API Effect и других TypeScript-пакетов доступны напрямую, без внешних привязок.")}</li><li>{text("Keep its established resource, concurrency, and observability tools.", "Уже есть средства управления ресурсами, конкурентного выполнения и наблюдаемости.")}</li></ul></article>
        </div>
      </section>
      <section class="explore-section home-section" aria-labelledby="explore-title">
        <div class="section-intro"><h2 id="explore-title">{text("Find your way in.", "С чего начать")}</h2><p>{text("Read a little. Build a little. Go deeper when you need to.", "Познакомьтесь с языком, решите конкретную задачу или найдите нужную функцию.")}</p></div>
        <div class="explore-links">{sections.map((section) => <a href={`${prefix}${section.href}`}><div><h3>{section.title}</h3><p>{section.description}</p></div><Icon name="arrow" size={24} /></a>)}</div>
      </section>
      <section class="try-section home-section" aria-labelledby="try-title"><div><h2 id="try-title">{text("A little less setup.\nA lot more trying.", "Попробуйте Flick\nбез установки.")}</h2><p>{text("The real compiler, in your browser. This site's widgets? Written in Flick, too.", "Компилятор работает прямо в браузере. Интерфейс редактора и виджеты сайта тоже написаны на Flick.")}</p></div><div class="try-actions"><a class="flick-button primary" href={`${prefix}/play/`}>{text("Write some Flick", "Открыть редактор")} <Icon name="arrow" size={18} /></a><a class="text-link" href={`${prefix}/transpile/`}>{text("See the JavaScript it becomes", "Посмотреть результат компиляции")} <Icon name="arrow" size={18} /></a></div></section>
    </main>
    <footer class="home-footer"><Brand href={`${prefix}/`} /><p>{text("A small language. On a strong foundation.", "Язык семейства ML на основе Effect.")}</p><a href="https://github.com/bondiano/flick-lang"><Icon name="github" /> GitHub</a><a href="https://effect.website/">Effect <Icon name="northeast" size={16} /></a></footer>
    <script>
      import { runMain } from "@flick-lang/runtime";
      import { main } from "../widgets/Hero.fl";
      void runMain(main as Parameters<typeof runMain>[0]);
    </script>
  </body>
</html>
