---
import Brand from "./Brand.astro";
import Icon from "./Icon.astro";
import DocNavigation from "./DocNavigation.astro";
import { runPromise } from "@flick-lang/runtime/rt";
import { uiRenderStatic } from "@flick-lang/runtime/rt/ui/react";
import type { Ui } from "@flick-lang/runtime/ui/react/nodes";
import { renderToString } from "react-dom/server";
import { shell } from "../widgets/Controls.fl";

const route = Astro.props.locale === undefined ? Astro.locals.starlightRoute : undefined;
const ru = Astro.props.locale === "ru" || route?.lang === "ru";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const prefix = `${base}${ru ? "/ru" : ""}`;
const current = Astro.url.pathname.slice(base.length) || "/";
const unlocalized = current.replace(/^\/ru(?=\/|$)/, "") || "/";
const notFound = route?.entry.id === "404";
const english = `${base}${notFound ? "/" : unlocalized}`;
const russian = notFound ? `${base}/ru/` : `${base}/ru${unlocalized === "/" ? "/" : unlocalized}`;
const playground = unlocalized.startsWith("/play/");
const links = [
  { label: ru ? "Документация" : "Docs", href: "/start/", current: unlocalized !== "/" && !playground && !notFound },
  { label: ru ? "Песочница" : "Playground", href: "/play/", current: playground },
];
const install = ru ? "Установить" : "Install";
const installHref = `${prefix}/start/getting-started/#${ru ? "установка" : "install"}`;
const sidebar = route?.hasSidebar ? route.sidebar : undefined;
const controlsHtml = renderToString(uiRenderStatic(await runPromise<Ui>(() => shell(ru))));
---
<div class="site-header" data-pagefind-ignore>
  <Brand href={`${prefix}/`} label={ru ? "Flick — главная" : "Flick home"} />
  <nav class="site-links" aria-label={ru ? "Основная навигация" : "Main navigation"}>
    {links.map(({ label, href, current }) => <a href={`${prefix}${href}`} aria-current={current ? "page" : undefined}>{label}</a>)}
  </nav>
  <div class="site-header-right">
    <div id="flick-site-controls" data-flick-ssr set:html={controlsHtml}></div>
    <div class="locale-switch" aria-label={ru ? "Язык" : "Language"}>
      {ru ? <a href={english} lang="en" aria-label="Switch to English">EN</a> : <span aria-current="true">EN</span>}
      <span class="locale-divider" aria-hidden="true">/</span>
      {ru ? <span aria-current="true">RU</span> : <a href={russian} lang="ru" aria-label="Переключить на русский">RU</a>}
    </div>
    <a class="header-github" href="https://github.com/bondiano/flick-lang" aria-label="GitHub"><Icon name="github" /></a>
    <a class="header-install" href={installHref}>{install}</a>
  </div>
  <nav id="flick-navigation" class="mobile-navigation" popover="auto" aria-label={ru ? "Навигация по сайту" : "Site navigation"}>
    <div class="mobile-primary-links">{links.map(({ label, href }) => <a href={`${prefix}${href}`}>{label}</a>)}<a href={installHref}>{install}</a></div>
    <div class="mobile-languages" aria-label={ru ? "Язык документации" : "Documentation language"}>
      <a href={english} lang="en" aria-current={!ru ? "page" : undefined}>English</a>
      <a href={russian} lang="ru" aria-current={ru ? "page" : undefined}>Русский</a>
    </div>
    {sidebar && <DocNavigation entries={sidebar} />}
    <a class="mobile-repository" href="https://github.com/bondiano/flick-lang">GitHub <Icon name="northeast" size={16} /></a>
  </nav>
  <dialog id="flick-search-dialog" aria-label={ru ? "Поиск по документации" : "Search documentation"}>
    <div id="flick-search-root"></div>
  </dialog>
</div>

<script>
  import { run } from "@flick-lang/runtime/rt/runner/browser";
  import { main as controls } from "../widgets/Controls.fl";
  import { main as search } from "../widgets/Search.fl";
  import { mount } from "../widgets/Copy.fl";

  void run(controls);
  void run(search);

  // Mount Flick controls beside rendered code. The clipboard state and action are Flick.
  document.querySelectorAll<HTMLElement>(".expressive-code").forEach((block, i) => {
    const code = block.querySelector("pre code");
    if (!code) return;
    const lines = Array.from(code.querySelectorAll(".ec-line .code"), (line) => {
      const value = line.textContent ?? "";
      return value === "\n" ? "" : value;
    });
    const source = lines.length > 0 ? lines.join("\n") : code.textContent ?? "";
    const root = document.createElement("div");
    root.id = `flick-code-copy-${i}`;
    root.className = "flick-code-copy";
    block.append(root);
    void run(mount, { id: root.id, source, ru: document.documentElement.lang === "ru" });
  });

  // Native keyboard events invoke the same Flick button as pointer input.
  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      document.getElementById("flick-search-open")?.click();
    }
  });
</script>
