---
const { label = "Flick home" } = Astro.props;
---
<a class="flick-brand" href={Astro.props.href ?? "/"} aria-label={label}>
  <img class="flick-wordmark-light" src="/flick-wordmark.svg" width="724" height="258" alt="" aria-hidden="true" />
  <img class="flick-wordmark-dark" src="/flick-wordmark-dark.svg" width="724" height="258" alt="" aria-hidden="true" />
</a>
