---
const { label = "Flick home" } = Astro.props;
---
<a class="flick-brand" href={Astro.props.href ?? "/"} aria-label={label}>
  <img class="brand-light" src="/flick-wordmark.svg" width="600" height="240" alt="" aria-hidden="true" />
  <img class="brand-dark" src="/flick-wordmark-dark.svg" width="600" height="240" alt="" aria-hidden="true" />
</a>
