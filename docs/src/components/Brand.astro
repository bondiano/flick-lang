---
const { label = "Flick home" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<a class="flick-brand" href={Astro.props.href ?? `${base}/`} aria-label={label}>
  <img class="brand-light" src={`${base}/flick-wordmark.svg`} width="296" height="100" alt="" aria-hidden="true" />
  <img class="brand-dark" src={`${base}/flick-wordmark-dark.svg`} width="296" height="100" alt="" aria-hidden="true" />
</a>
