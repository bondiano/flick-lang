---
import "../styles/playground.css";

interface Props {
  mode: "play" | "transpile";
  locale: "en" | "ru";
}

const { mode, locale } = Astro.props;
---

<div id="flick-playground" class="not-content flick-playground-shell" data-mode={mode} data-locale={locale}>
  <p class="fp-boot" role="status">
    {locale === "ru" ? "Загрузка интерфейса Flick…" : "Loading the Flick interface…"}
  </p>
  <noscript>
    {locale === "ru" ? "Для компиляции и запуска в браузере нужен JavaScript." : "Browser compilation and execution require JavaScript."}
  </noscript>
</div>

<script>
  import { runMain } from "@flick-lang/runtime";
  import { main } from "../playground/Playground.fl";

  void runMain(main as Parameters<typeof runMain>[0]);
</script>
