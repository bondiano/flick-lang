---
import { lessonConfiguration } from "../playground/lesson-config.ts";
import "../styles/playground.css";
import { loadExercise } from "../../exercises/load.ts";
import { runPromise } from "@flick-lang/runtime/rt";
import { uiRenderStatic } from "@flick-lang/runtime/rt/ui/react";
import type { Ui } from "@flick-lang/runtime/ui/react/nodes";
import { renderToString } from "react-dom/server";
import { initial_view } from "../playground/Playground.fl";
import { examples } from "./gallery.ts";

interface Props {
  locale: "en" | "ru";
  /** An exercise, by its directory under `exercises/`. */
  lesson?: string;
  /** One program to show and run, under `id`, which keys its draft apart from the gallery's. */
  source?: string;
  id?: string;
}

const { locale, lesson = "", source, id = "" } = Astro.props;
const exercise = lesson ? loadExercise(lesson) : undefined;
const { starter, ...lessonData } = exercise ?? { starter: "" };
const solution = exercise?.solution ?? "";
const only = (text: string) => [{ id: "lesson", group: "Lesson", group_ru: "Урок", name: "Starter", name_ru: "Начало", source: text }];
const gallery = lesson ? only(starter) : source !== undefined ? only(source) : examples();
const autorun = !lesson && source !== undefined;
const configuration = {
  locale, examples: gallery, lesson: Boolean(exercise), solution, done: false, autorun,
  ...lessonConfiguration(exercise),
};
const markup = renderToString(uiRenderStatic(await runPromise<Ui>(() => initial_view(configuration))));
// the browser reads the same examples back; `<` cannot end the script early
const embedded = JSON.stringify(gallery).replaceAll("<", "\\u003c");
---

<div id="flick-playground" class="not-content flick-playground-shell" data-locale={locale} data-lesson={lesson || id} data-autorun={String(autorun)} data-flick-ssr data-pagefind-ignore set:html={markup}></div>
<script is:inline type="application/json" id="flick-playground-examples" set:html={embedded}></script>
{exercise && <script is:inline type="application/json" id="flick-lesson" set:html={JSON.stringify(lessonData).replaceAll("<", "\\u003c")}></script>}
<noscript>
  <p class="fp-boot">{locale === "ru" ? "Для компиляции и запуска в браузере нужен JavaScript." : "Browser compilation and execution require JavaScript."}</p>
</noscript>

<script>
  import { run } from "@flick-lang/runtime/rt/runner/browser";
  import { main } from "../playground/Playground.fl";
  import { bindSplit } from "../playground/split.ts";

  void run(main);
  const root = document.getElementById("flick-playground");
  if (root !== null) {
    const dispose = bindSplit(root);
    window.addEventListener("pagehide", dispose, { once: true });
    import.meta.hot?.dispose(dispose);
  }
</script>
