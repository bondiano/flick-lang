---
import "../styles/playground.css";
import { loadExercise } from "../../exercises/load.ts";
import { Effect } from "@flick-lang/effect-ts";
import { uiRenderStatic } from "@flick-lang/effect-ts/ui/react";
import { renderToString } from "react-dom/server";
import { initial_view } from "../playground/Playground.fl";
import { examples } from "./gallery.ts";

interface Props {
  locale: "en" | "ru";
  lesson?: string;
}

const { locale, lesson = "" } = Astro.props;
const exercise = lesson ? loadExercise(lesson) : undefined;
const starter = exercise?.starter ?? "";
const solution = exercise?.solution ?? "";
const gallery = lesson ? [{ id: "lesson", group: "Lesson", group_ru: "Урок", name: "Starter", name_ru: "Начало", source: starter }] : examples();
const markup = renderToString(uiRenderStatic(await Effect.runPromise(initial_view({ locale, examples: gallery, lesson: Boolean(exercise), solution, done: false, lesson_title: exercise?.[locale === "ru" ? "title_ru" : "title"] ?? "", lesson_task: exercise?.[locale === "ru" ? "task_ru" : "task"] ?? "", lesson_hint_text: exercise?.[locale === "ru" ? "hint_ru" : "hint"] ?? "" }))));
// the browser reads the same examples back; `<` cannot end the script early
const embedded = JSON.stringify(gallery).replaceAll("<", "\\u003c");
---

<div id="flick-playground" class="not-content flick-playground-shell" data-locale={locale} data-lesson={lesson} data-flick-ssr data-pagefind-ignore set:html={markup}></div>
<script is:inline type="application/json" id="flick-playground-examples" set:html={embedded}></script>
{exercise && <script is:inline type="application/json" id="flick-lesson" set:html={JSON.stringify(exercise).replaceAll("<", "\\u003c")}></script>}
<noscript>
  <p class="fp-boot">{locale === "ru" ? "Для компиляции и запуска в браузере нужен JavaScript." : "Browser compilation and execution require JavaScript."}</p>
</noscript>

<script>
  import { run } from "@flick-lang/effect-ts/runner/browser";
  import { main } from "../playground/Playground.fl";
  import { bindSplit } from "../playground/split.ts";

  void run(main);
  const root = document.getElementById("flick-playground");
  if (root !== null) {
    const dispose = bindSplit(root);
    window.addEventListener("pagehide", dispose, { once: true });
    import.meta.hot?.dispose(dispose);
  }
</script>
