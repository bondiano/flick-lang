module Hero exposing (main, initial_view)

import Elements exposing (attributes, icon)
import JsError exposing (JsError(..))

type alias Line = { stream : String; text : String }
type alias Model = {
  ru : Bool;
  ready : Bool;
  effect : Bool;
  running : Bool;
  output : String;
  failed : Bool;
  copied : Bool;
}
type alias Diagnostic = { code : String; severity : String; message : String; at : String }
type alias Execution = {
  lines : List Line;
  status : String;
  detail : String;
  diagnostics : List Diagnostic;
}

is_russian : Unit ->{} Bool
foreign sync is_russian from "./browser.ts" "isRussian"
  arity 0

execute : String ->{; JsError} Execution
foreign async execute from "./hero-browser.ts" "runDemo"
  arity 1
  cancel signal
  catch JsError.from_js

copy_text : String ->{; JsError} Unit
foreign async copy_text from "./browser.ts" "copyText"
  arity 1
  catch JsError.from_js

notify : String ->{} Unit
foreign sync notify from "../playground/dom.ts" "notify"
  arity 1

source : String
let source =
  "module Main exposing (main)\n\nmain : Unit ->{; AppError} Unit\nlet main () =\n  Platform.stdout_line \"Hello, effects.\"\n"

effect_source : String
let effect_source =
  "import { Console, Effect } from \"effect\"\n\nconst main = Console.log(\"Hello, effects.\")\n\nEffect.runPromise(main)\n"

token : String -> String -> Ui {Atom.Write} none
let token category value = Ui.span { class_name = "token-" ++ category } [Ui.text value]

snippet : Bool -> Ui {Atom.Write} none
let snippet effect =
  ui {
    pre { class_name = "hero-source" }
      (if effect then
          [token "keyword" "import ", text "{ Console, Effect } ", token "keyword" "from ", token "string" "\"effect\"", text "\n\n",
            token
              "keyword"
              "const ", text
              "main = Console.log(", token
              "string"
              "\"Hello, effects.\"", text
              ")\n\nEffect.runPromise(main)"]
        else
          [token "keyword" "module ", text "Main ", token "keyword" "exposing ", text "(main)\n\n",
            text
              "main ", token
              "keyword"
              ": ", token
              "type"
              "Unit", text
              " ->{; ", token
              "type"
              "AppError", text
              "} ", token
              "type"
              "Unit", text
              "\n",
            token
              "keyword"
              "let ", text
              "main () =\n  Platform.stdout_line ", token
              "string"
              "\"Hello, effects.\""])
  }

run_example : Atom.Writable Model ->{Atom.Write;} Unit
let run_example model =
  let m = Atom.current model
  Atom.set model { m with running = true; failed = false; output = "" }
  notify "flick-hero-refresh"
  let executed = try Ok (timeout 10000 (task { execute source })) with
    | JsError _ ->
      Err
        (if m.ru then
          "Не удалось загрузить компилятор. Попробуйте снова."
        else
          "The compiler could not load. Try again.")
    | TimeoutError ->
      Err
        (if m.ru then
          "Выполнение остановлено через 10 секунд."
        else
          "Execution stopped after 10 seconds.")
  let result =
    match executed with
    | Err message -> Err message
    | Ok execution ->
      if execution.status == "exit" && execution.detail == "0" then
        Ok (String.trim (String.join "" (List.map (fun line -> line.text) execution.lines)))
      else if execution.status == "invalid" then
        Err
          (String.join "\n" (List.map (fun diagnostic -> diagnostic.message) execution.diagnostics))
      else if execution.detail != "" then
        Err execution.detail
      else
        Err
          (if m.ru then
            "Не удалось запустить пример. Попробуйте Play."
          else
            "The example could not run. Try Play.")
  let current = Atom.current model
  match result with
  | Ok output -> Atom.set model { current with running = false; output = output; failed = false }
  | Err message -> Atom.set model { current with running = false; output = message; failed = true }

view : Atom.Writable Model -> Model -> Ui {Atom.Write} none
let view model m =
  let status =
    if not m.ready then
      if m.ru then "Загрузка примера…" else "Loading the live example…"
    else if m.running then
      if m.ru then "Компиляция и запуск…" else "Compiling and running…"
    else if m.output != "" then m.output
    else if m.effect then
      if m.ru then "Тот же результат. Другой синтаксис." else "Same result. Different syntax."
    else
      if m.ru then "Нажмите «Запустить Flick», чтобы выполнить пример." else "Real Flick. Right in your browser."
  ui {
    attributes [("aria-busy", if m.ready then "false" else "true")]
      (div { class_name = "hero-editor" }
      [
        div { class_name = "hero-editor-tabs" }
          [span { class_name = if m.effect then "hero-tab" else "hero-tab is-active" }
              [attributes [("aria-pressed", if m.effect then "false" else "true")]
                (button
                  {
                    disabled = not m.ready;
                    on_click =
                      Ui.Event.latest
                        (fun _ ->
                          task {
                            Atom.modify
                              model
                              (fun current -> ((), { current with effect = false; copied = false }))
                          });
                  }
                  [text "Flick"])],
            span { class_name = if m.effect then "hero-tab is-active" else "hero-tab" }
              [attributes [("aria-pressed", if m.effect then "true" else "false")]
                (button
                  {
                    disabled = not m.ready;
                    on_click =
                      Ui.Event.latest
                        (fun _ ->
                          task {
                            Atom.modify
                              model
                              (fun current -> ((), { current with effect = true; copied = false }))
                          });
                  }
                  [text "Effect"])],
            span { class_name = "hero-copy" }
              [attributes [("aria-label", if m.copied then (if m.ru then "Скопировано" else "Copied") else (if m.ru then "Копировать пример" else "Copy example"))]
                (button { disabled = not m.ready; on_click = Ui.Event.latest (fun _ -> task {
                    let copied =
                      try (
                        copy_text (if m.effect then effect_source else source) |> fun _ -> true
                      ) with
                      | JsError _ -> false
                    Atom.modify model (fun current -> ((), { current with copied = copied; failed = not copied; output = if copied then current.output else (if m.ru then "Буфер обмена недоступен. Выделите код вручную." else "Clipboard unavailable. Select the code manually.") }))
                  }) } [icon (if m.copied then "check" else "copy")])]],
        div { class_name = "hero-editor-file" }
          [span { class_name = "hero-filename" } [text (if m.effect then "main.ts" else "main.fl")],
            span
              { class_name = "hero-runtime-note" }
              [text (if m.ru then "На основе Effect" else "On the Effect runtime")],
            span { class_name = "hero-run" }
              [button { disabled = not m.ready || m.running; on_click = Ui.Event.exhaust (fun _ -> task { run_example model }) }
                [
                  text
                    (if m.running then
                      (if m.ru then "Запуск…" else "Running…")
                    else
                      (if m.ru then "Запустить Flick" else "Run Flick")),
                  icon "play",
                ]]],
        div { class_name = "hero-code-body" }
          [attributes [("aria-hidden", "true")] (pre { class_name = "hero-lines" } [text "1\n2\n3\n4\n5"]),
            attributes
              [
                ("tabIndex", if m.ready then "0" else "-1"),
                ("aria-label", if m.effect then "Effect TypeScript example" else "Flick example"),
              ]
              (snippet m.effect)],
        attributes [("role", "status"), ("aria-live", "polite")]
          (div { class_name = if m.failed then "hero-editor-status is-error" else "hero-editor-status" }
            [span { class_name = "status-dot" } [], text status]),
        attributes [("id", "flick-hero-refresh"), ("hidden", "hidden"), ("tabIndex", "-1")]
          (button { disabled = false; on_click = Ui.Event.latest (fun _ -> task { () }) } []),
      ])
  }

initial_model : Bool -> Model
let initial_model ru =
  { ru = ru; ready = false; effect = false; running = false; output = ""; failed = false; copied = false }

initial_view : Bool ->{} Ui {Atom.Write} none
let initial_view ru =
  let initial = initial_model ru
  view (Atom.make initial) initial

report : Failure e ->{} Unit
let report failure = Platform.stderr_line (RawCause.describe (Failure.inspect failure))

main : Unit ->{; AppError} Unit
let main () =
  let initial = initial_model (is_russian ())
  match Ui.Dom.container "flick-hero" with
  | None -> App.fail "Missing homepage example container"
  | Some root ->
    let model = Atom.make initial
    let app = Ui.render (Ui.view (fun () -> view model (Atom.value model))) ()
    provide Atom.layer {
      // the first render, synchronous, shows the server's markup; ready renders again
      ignore (parallel
        (task { ignore (Ui.Dom.mount root report app) })
        (task { Atom.set model { initial with ready = true } }))
    }
