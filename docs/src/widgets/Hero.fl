module Hero exposing (main, initial_view, honest_source, lying_source)

import Elements exposing (attributes)
import JsError exposing (JsError(..))

type alias Diagnostic = { code : String; severity : String; message : String; at : String }

type Answer = Untested | Asking | Holds | Caught Diagnostic | Unavailable

type alias Model = { ru : Bool; ready : Bool; lying : Bool; answer : Answer }

is_russian : Unit ->{} Bool
foreign is_russian from "./browser.ts" "isRussian"
  arity 0

check : String ->{Async; JsError} List Diagnostic
foreign check from "./hero-browser.ts" "check"
  arity 1
  cancel signal
  catch JsError.from_js

show_break : Bool ->{} Unit
foreign show_break from "./hero-browser.ts" "showBreak"
  arity 1

notify : String ->{} Unit
foreign notify from "../playground/dom.ts" "notify"
  arity 1

/// The program the sign stands for, with the signature under test.
program : String -> String
let program signature =
  String.join "\n" [
    "module Main exposing (load_view)",
    "",
    "opaque type alias UserId = String",
    "type alias User = { id : UserId; name : String }",
    "type alias UserView = { id : UserId; title : String }",
    "",
    "to_view : User -> UserView",
    "let to_view user = { id = user.id; title = String.trim user.name }",
    "",
    "type error NotFound = NotFound UserId",
    "",
    "service Users =",
    "  get : UserId ->{; NotFound} User",
    "",
    "service Log =",
    "  info : String ->{} Unit",
    "",
    signature,
    "let load_view id =",
    "  let user = Users.get id",
    "  let view = to_view user",
    "  Log.info (\"Loaded \" ++ view.title)",
    "  view",
    "",
  ]

honest_source : String
let honest_source = program "load_view : UserId ->{Users, Log; NotFound} UserView"

lying_source : String
let lying_source = program "load_view : UserId ->{Users; NotFound} UserView"

/// Only the compiler's answer breaks the line on the map: nothing is shown ahead of it.
press : Atom.Writable Model ->{Async, Atom.Write} Unit
let press model =
  let m = Atom.current model
  let lying = not m.lying
  Atom.set model { m with lying = lying; answer = Asking }
  notify "flick-hero-refresh"
  let answer =
    try
      let diagnostics =
        timeout 30000 (task { check (if lying then lying_source else honest_source) })
      match List.find (fun diagnostic -> diagnostic.severity == "error") diagnostics with
      | Some diagnostic -> Caught diagnostic
      | None -> Holds
    with
    | JsError _ -> Unavailable
    | TimeoutError -> Unavailable
  let current = Atom.current model
  match answer with
  | Caught _ ->
    show_break true
    Atom.set model { current with lying = lying; answer = answer }
  | Unavailable -> Atom.set model { current with lying = m.lying; answer = answer }
  | Untested | Asking | Holds ->
    show_break false
    Atom.set model { current with lying = lying; answer = answer }

part : String -> String -> Ui
let part class_name value = ui { span { class_name = class_name } (text value) }

sign : Bool -> Ui
let sign lying =
  let log =
    if lying then
      []
    else
      [
        ui { text ", " },
        part "sign-log" "Log",
      ]
  let row =
    List.append (List.append [part "sign-punct" "->{", part "sign-users" "Users"] log) [
      ui { text "; " },
      part "sign-fails" "NotFound",
      part "sign-punct" "}",
      ui { text " " },
      part "sign-returns" "UserView",
    ]
  ui {
    div { class_name = "hero-sign" }
      span { class_name = "sign-head" }
        (part "sign-name" "load_view")
        (text " : UserId ")

      span { class_name = "sign-row" } row
  }

status : Model -> Ui
let status m =
  match m.answer with
  | Untested -> ui {
    div { class_name = "status-text" }
      text
        (
          if m.ru then
            "Это настоящий компилятор, он работает прямо в браузере."
          else
            "This is the real compiler, running in your browser."
        )
  }
  | Asking -> ui {
    div { class_name = "status-text" }
      text (if m.ru then "Спрашиваем компилятор…" else "Asking the compiler…")
  }
  | Holds -> ui {
    div { class_name = "status-text" }
      text
        (
          if m.ru then
            "Компилируется. Сигнатура снова говорит правду."
          else
            "It compiles. The signature tells the truth again."
        )
  }
  | Unavailable -> ui {
    div { class_name = "status-text is-error" }
      text
        (
          if m.ru then
            "Компилятор не загрузился. Проверьте соединение и попробуйте ещё раз."
          else
            "The compiler could not load. Check your connection and try again."
        )
  }
  | Caught diagnostic -> ui {
    div { class_name = "status-text is-error" }
      span { class_name = "status-code" } (text diagnostic.code)
      text " "
      span { class_name = "status-message" } (text diagnostic.message)
  }

view : Atom.Writable Model -> Model -> Ui
let view model m =
  let asking =
    match m.answer with
    | Asking -> true
    | Untested | Holds | Caught _ | Unavailable -> false
  let label =
    match (asking, m.lying, m.ru) with
    | (true, _, true) -> "Компиляция…"
    | (true, _, false) -> "Compiling…"
    | (false, true, true) -> "Вернуть как было"
    | (false, true, false) -> "Put it back"
    | (false, false, true) -> "Заставить соврать"
    | (false, false, false) -> "Try to make it lie"
  ui {
    div { class_name = "hero-proof" }
      sign m.lying
      div { class_name = "hero-stem" }
      div { class_name = "hero-press" }
        (attributes
          [("aria-pressed", if m.lying then "true" else "false")]
          (button
            {
              disabled = not m.ready || asking;
              on_click = Ui.Event.exhaust (fun _ -> task { press model });
            }
            (text label)))

      attributes
        [("role", "status"), ("aria-live", "polite")]
        (div { class_name = "hero-status" } (status m))
      attributes
        [("id", "flick-hero-refresh"), ("hidden", "hidden"), ("tabIndex", "-1")]
        (button { disabled = false; on_click = Ui.Event.latest (fun _ -> Effect.void) })
  }

initial_model : Bool -> Model
let initial_model ru = { ru = ru; ready = false; lying = false; answer = Untested }

initial_view : Bool ->{} Ui
let initial_view ru =
  let initial = initial_model ru
  view (Atom.make initial) initial

report : Failure e ->{} Unit
let report failure = Platform.stderr_line (RawCause.describe (Failure.inspect failure))

main : Unit ->{Async; AppError} Unit
let main () =
  let initial = initial_model (is_russian ())
  match Ui.Dom.container "flick-hero" with
  | None -> App.fail "Missing homepage example container"
  | Some root ->
    let model = Atom.make initial
    let app = Ui.render (Ui.view (fun () -> view model (Atom.value model))) ()
    provide Atom.layer {
      // the first render, synchronous, shows the server's markup; ready renders again
      ignore (parallel
        (task { ignore (Ui.Dom.mount root report app) })
        (task { Atom.set model { initial with ready = true } }))
    }
