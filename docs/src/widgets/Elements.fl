module Elements exposing (attributes, icon, route)

attributes : forall c. List (String, String) -> Ui^c -> Ui^c
foreign pure attributes from "./dom.ts" "attributes"
  arity 2
  retention call

icon : String -> Ui
let icon name =
  let path =
    match name with
    | "search" -> "<circle cx='10.5' cy='10.5' r='6.5'/><path d='m16 16 4.5 4.5'/>"
    | "sun" ->
      "<circle cx='12' cy='12' r='4'/><path d='M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5'/>"
    | "moon" -> "<path d='M20.5 14A9 9 0 0 1 10 3.5 9 9 0 1 0 20.5 14Z'/>"
    | "menu" -> "<path d='M4 6h16M4 12h16M4 18h16'/>"
    | "close" -> "<path d='m6 6 12 12M6 18 18 6'/>"
    | "copy" -> "<rect x='8' y='8' width='12' height='13' rx='2'/><path d='M16 8V3H3v13h5'/>"
    | "check" -> "<path d='m5 12 4 4L20 5'/>"
    | "play" -> "<path d='m8 4 12 8-12 8Z'/>"
    | _ -> "<path d='M5 12h14m-6-6 6 6-6 6'/>"
  Ui.html
    (Ui.trusted_html
      ("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' width='20' height='20' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>"
        ++ path
        ++ "</svg>"))

route : String -> String -> Ui
let route href label =
  match Ui.safe_url href with
  | Some url -> Ui.link { href = url } [Ui.text label]
  | None -> Ui.text label
