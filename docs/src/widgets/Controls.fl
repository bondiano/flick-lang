module Controls exposing (main, shell)

import Elements exposing (attributes)

type alias Model = { ru : Bool; dark : Bool }

preferences : Unit ->{} Model
foreign preferences from "./browser.ts" "preferences"
  arity 0

set_dark : Bool ->{} Unit
foreign set_dark from "./browser.ts" "setDark"
  arity 1

open_search : Unit ->{} Unit
foreign open_search from "./browser.ts" "openSearch"
  arity 0

view : Atom.Writable Model -> Model -> Ui
let view model m =
  let search_label = if m.ru then "Поиск" else "Search"
  let theme_label = if m.ru then "Переключить тему" else "Toggle color theme"
  ui {
    div { class_name = "site-controls" }
      span { class_name = "search-control" }
        (attributes
          [("id", "flick-search-open"), ("aria-label", search_label), ("aria-haspopup", "dialog")]
          (button
            { disabled = false; on_click = Ui.Event.latest (fun _ -> task { open_search () }) }
            (Elements.icon "search")
            (span { class_name = "search-word" } (text search_label))
            (span { class_name = "search-shortcut" } (text "⌘ K"))))

      span { class_name = "icon-control theme-control" }
        (attributes
          [("aria-label", theme_label), ("title", theme_label)]
          (button
            {
              disabled = false;
              on_click =
                Ui.Event.latest (fun _ -> task {
                  let dark = not m.dark
                  set_dark dark
                  Atom.set model { m with dark = dark }
                });
            }
            (span { class_name = "theme-light-icon" } (Elements.icon "moon"))
            (span { class_name = "theme-dark-icon" } (Elements.icon "sun"))))

      span { class_name = "icon-control mobile-menu-control" }
        (attributes
          [
            ("aria-label", if m.ru then "Навигация" else "Navigation"),
            ("popoverTarget", "flick-navigation"),
          ]
          (button
            { disabled = false; on_click = Ui.Event.latest (fun _ -> Effect.void) }
            (Elements.icon "menu")))
  }

shell : Bool ->{} Ui
let shell ru =
  let initial = { ru = ru; dark = false }
  let model = Atom.make initial
  view model initial

report : Failure e ->{} Unit
let report failure = Platform.stderr_line (RawCause.describe (Failure.inspect failure))

main : Unit ->{Async; AppError} Unit
let main () =
  let initial = preferences ()
  match Ui.Dom.container "flick-site-controls" with
  | None -> App.fail "Missing site controls container"
  | Some root ->
    let model = Atom.make initial
    provide Atom.layer {
      ignore (Ui.Dom.mount
        root
        report
        (Ui.render (Ui.view (fun () -> view model (Atom.value model))) ()))
    }
