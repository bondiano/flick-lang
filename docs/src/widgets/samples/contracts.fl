module Main exposing (consume, as_port)

// show
consume : Int -> Int -> Int
let consume available used
where
  require (0 <= used && used <= available)
  ensure (fun rest -> 0 <= rest && rest + used == available)
=
  available - used

// show
refined type Port = Int where fun n -> n > 0 && n < 65536

as_port : Int -> Option Port
let as_port n = if n > 0 && n < 65536 then Some (Port.prove n) else None
