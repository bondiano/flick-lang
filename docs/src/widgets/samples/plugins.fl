module Main exposing (greet)

import Cli

// show
greet : Cli.Command {Host.Console} none
let greet = cli "greet" {
  description "Prints a greeting"
  /// Print in capitals
  flag loud : Bool
  /// Who to greet
  arg name : String
  handle fun { loud; name } ->
    let text = "Hello, \{name}"
    Platform.stdout_line (if loud then String.to_upper text else text)
}
