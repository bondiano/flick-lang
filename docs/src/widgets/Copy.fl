module Copy exposing (mount)

import Elements exposing (attributes)
import JsError exposing (JsError(..))

type alias Input = { id : String; source : String; ru : Bool }
type alias Model = { copied : Bool; problem : String }

copy_text : String ->{Async; JsError} Unit
foreign async copy_text from "./browser.ts" "copyText"
  arity 1
  catch JsError.from_js

view : Input -> Atom.Writable Model -> Model -> Ui
let view input model m =
  let label =
    if m.problem != "" then
      (
        if input.ru then
          "Не удалось скопировать. Выделите код вручную."
        else
          "Copy failed. Select the code manually."
      )
        ++ " "
        ++ m.problem
    else if m.copied then
      if input.ru then "Скопировано" else "Copied"
    else
      if input.ru then "Копировать код" else "Copy code"
  ui {
    attributes
      [("aria-label", label), ("title", label), ("aria-live", "polite")]
      (button
        {
          disabled = false;
          on_click =
            Ui.Event.latest (fun _ -> task {
              let problem =
                try (copy_text input.source |> fun _ -> "") with
                | JsError failure -> failure.message
              Atom.set model { copied = problem == ""; problem = problem }
            });
        }
        [
          Elements.icon (if m.copied then "check" else "copy"),
          span { class_name = "sr-only" } [text label],
        ])
  }

report : Failure e ->{} Unit
let report failure = Platform.stderr_line (RawCause.describe (Failure.inspect failure))

mount : Input ->{; AppError} Unit
let mount input =
  match Ui.Dom.container input.id with
  | None -> App.fail "Missing code copy container"
  | Some root ->
    let model = Atom.make { copied = false; problem = "" }
    provide Atom.layer {
      ignore (Ui.Dom.mount
        root
        report
        (Ui.render (Ui.view (fun () -> view input model (Atom.value model))) ()))
    }
