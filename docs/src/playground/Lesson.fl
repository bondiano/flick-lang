module Lesson exposing (view)

import Actions exposing (check_lesson, reset_lesson, reveal_lesson_hint, show_lesson_solution)
import State exposing (Model, tr)

view : Atom.Writable Model -> Model -> Ui
let view model m = ui {
  div { class_name = "fp-lesson" } [
    heading_at H2 [text (tr m.locale "1. Make the signature honest" "1. Исправьте сигнатуру")],
    paragraph [
      text
        (tr
          m.locale
          "The body returns the length of a String. Change the declared result type, then check your answer."
          "Тело возвращает длину строки. Исправьте объявленный тип результата и проверьте ответ."),
    ],
    div { class_name = "fp-lesson-actions" } [
      button
        {
          disabled = m.lesson_checking || m.loading;
          on_click = Ui.Event.exhaust (fun _ -> task { check_lesson model });
        }
        [
          text
            (
              if m.lesson_checking then
                tr m.locale "Checking…" "Проверка…"
              else
                tr m.locale "Check answer" "Проверить"
            ),
        ],
      button
        {
          disabled = false;
          on_click = Ui.Event.exhaust (fun _ -> task { reveal_lesson_hint model });
        }
        [text (tr m.locale "Hint" "Подсказка")],
      button
        {
          disabled = false;
          on_click = Ui.Event.exhaust (fun _ -> task { show_lesson_solution model });
        }
        [text (tr m.locale "Show solution" "Показать решение")],
      button
        { disabled = false; on_click = Ui.Event.exhaust (fun _ -> task { reset_lesson model }) }
        [text (tr m.locale "Reset" "Сбросить")],
    ],
    if m.lesson_hint then
      paragraph [
        text
          (tr
            m.locale
            "String.length returns Int. The last type in the arrow is the result type."
            "String.length возвращает Int. Последний тип после стрелки — тип результата."),
      ]
    else empty,
    if m.lesson_result != "" then
      Ui.with_host
        { Ui.host with role = Some "status"; aria_live = Some Ui.Polite }
        (paragraph [text m.lesson_result])
    else if m.lesson_done then
      paragraph [text (tr m.locale "Lesson completed." "Урок пройден.")]
    else empty,
  ]
}
