module Actions exposing (
  update,
  prepare_highlighting,
  prepare_editor,
  refresh,
  load_compiler,
  edit,
  edited,
  choose,
  format,
  explain,
  focus_editor,
  run_program,
  runtime_messages,
  report,
)

import Dom exposing (notify, source_value, tab_in_address)
import Examples exposing (Example)
import JsError exposing (JsError(..))
import State exposing (
  Diagnostic,
  Execution,
  Generated,
  Model,
  SyntaxToken,
  Tab(..),
  emit_key,
  empty_execution,
  first_source,
  profile_name,
  requested_tab,
  wants_code,
)

load_highlighting : Unit ->{Async; JsError} Unit
foreign load_highlighting from "./highlight.ts" "loadHighlighting"
  arity 0
  catch JsError.from_js

highlight : String -> String ->{; JsError} List SyntaxToken
foreign highlight from "./highlight.ts" "highlight"
  arity 2
  catch JsError.from_js

load : Unit ->{Async; JsError} String
foreign load from "./compiler.ts" "load"
  arity 0
  catch JsError.from_js

check : String ->{Async; JsError} List Diagnostic
foreign check from "./compiler.ts" "check"
  arity 1
  catch JsError.from_js
  cancel signal

compile : String -> String ->{Async; JsError} Generated
foreign compile from "./compiler.ts" "compile"
  arity 2
  catch JsError.from_js
  cancel signal

format_source : String ->{Async; JsError} String
foreign format_source from "./compiler.ts" "formatSource"
  arity 1
  catch JsError.from_js

/// What a diagnostic code means, as Markdown; empty for an unknown code.
explain_code : String ->{Async; JsError} String
foreign explain_code from "./compiler.ts" "explainCode"
  arity 1
  catch JsError.from_js

load_editor : Unit ->{Async; JsError} Unit
foreign load_editor from "./editor.ts" "loadEditor"
  arity 0
  catch JsError.from_js

mount_editor : String -> String ->{; JsError} Unit
foreign mount_editor from "./editor.ts" "mountEditor"
  arity 2
  catch JsError.from_js

editor_text : Unit ->{} String
foreign editor_text from "./editor.ts" "editorText"
  arity 0

set_editor_text : String ->{} Unit
foreign set_editor_text from "./editor.ts" "setEditorText"
  arity 1

mark_diagnostics : String -> List Diagnostic ->{} Unit
foreign mark_diagnostics from "./editor.ts" "markDiagnostics"
  arity 2

/// Focuses the editor; false when it is not open.
focus_editor : Unit ->{} Bool
foreign focus_editor from "./editor.ts" "focusEditor"
  arity 0

/// Removes the preview a run of a program with an interface left open.
close_preview : Unit ->{} Unit
foreign close_preview from "./compiler.ts" "closePreview"
  arity 0

take_preview_messages : Unit ->{} List State.Line
foreign take_preview_messages from "./compiler.ts" "takePreviewMessages"
  arity 0

run_build : String -> String ->{Async; JsError} Execution
foreign run_build from "./compiler.ts" "run"
  arity 2
  catch JsError.from_js
  cancel signal

update : Atom.Writable Model -> (Model -> Model) ->{Atom.Write;} Unit
let update model f = Atom.update model f

syntax_failure : Atom.Writable Model -> String ->{Atom.Write;} Unit
let syntax_failure model message =
  update model (fun m -> {
    m with
    highlighting = false;
    generated_tokens = [];
    syntax_error = message;
  })

paint_generated : Atom.Writable Model ->{Atom.Write;} Unit
let paint_generated model =
  let m = Atom.current model
  if m.highlighting then
    let result =
      try Ok (highlight m.emitted.code "javascript") with
      | JsError failure -> Err failure.message
    match result with
    | Ok tokens -> update model (fun m -> { m with generated_tokens = tokens })
    | Err message -> syntax_failure model message

adopt_source : Atom.Writable Model ->{Atom.Write;} Unit
let adopt_source model =
  let m = Atom.current model
  // A later example selection may not have committed its textarea yet.
  if m.revision == 0 && m.source == first_source m.examples then
    let source = source_value ()
    if source != m.source then update model (fun m -> { m with source = source })

prepare_highlighting : Atom.Writable Model ->{Async, Atom.Write;} Unit
let prepare_highlighting model =
  let result =
    try Ok (load_highlighting ()) with
    | JsError failure -> Err failure.message
  match result with
  | Err message -> syntax_failure model message
  | Ok () ->
    update model (fun m -> { m with highlighting = true; syntax_error = "" })
    paint_generated model

/// Opens CodeMirror on the source; the native field stays when it cannot load.
prepare_editor : Atom.Writable Model -> String ->{Async, Atom.Write;} Unit
let prepare_editor model label =
  let loaded =
    try Ok (load_editor ()) with
    | JsError failure -> Err failure.message
  // what was typed into the field until now is the source the editor opens on
  adopt_source model
  let m = Atom.current model
  let opened =
    match loaded with
    | Err message -> Err message
    | Ok () ->
      try Ok (mount_editor m.source label) with
      | JsError failure -> Err failure.message
  match opened with
  | Err message -> update model (fun m -> { m with syntax_error = message })
  | Ok () ->
    update model (fun m -> { m with editor_open = true })
    mark_diagnostics m.source m.diagnostics

/// Checks the source after an edit, which is quick, and emits it only when a
/// tab shows what the compiler writes and that is not known yet.
refresh : Atom.Writable Model ->{Async, Atom.Write;} Unit
let refresh model =
  let m = Atom.current model
  if m.version == "" then
    ()
  else
    update model (fun m -> { m with checking = true; compile_error = "" })
    let result =
      try Ok (check m.source) with
      | JsError failure -> Err failure.message
    if (Atom.current model).source != m.source then
      ()
    else
      match result with
      | Err message -> update model (fun m -> { m with checking = false; compile_error = message })
      | Ok diagnostics ->
        let failing = List.any (fun d -> d.severity == "error") diagnostics
        let shown = (Atom.current model).tab
        let tab = if failing && shown == Output then Problems else shown
        update model (fun m -> { m with checking = false; diagnostics = diagnostics; tab = tab })
        mark_diagnostics m.source diagnostics
        let current = Atom.current model
        if wants_code current && not failing && current.emitted_key != emit_key current then
          emit model

/// Emits the current source for the current profile.
emit : Atom.Writable Model ->{Async, Atom.Write;} Unit
let emit model =
  let m = Atom.current model
  update model (fun m -> { m with checking = true })
  let result =
    try Ok (compile m.source (profile_name m.profile)) with
    | JsError failure -> Err failure.message
  let current = Atom.current model
  if current.source != m.source || current.profile != m.profile then
    ()
  else
    match result with
    | Err message -> update model (fun m -> { m with checking = false; compile_error = message })
    | Ok emitted ->
      update model (fun m -> {
        m with
        checking = false;
        emitted = emitted;
        emitted_key = emit_key m;
        diagnostics = emitted.diagnostics;
        generated_tokens = [];
      })
      mark_diagnostics m.source emitted.diagnostics
      paint_generated model

load_compiler : Atom.Writable Model ->{Async, Atom.Write;} Unit
let load_compiler model =
  update model (fun m -> {
    m with
    loading = true;
    checking = false;
    load_error = "";
    compile_error = "";
  })
  let result =
    try Ok (load ()) with
    | JsError failure -> Err failure.message
  match result with
  | Err message ->
    update model (fun m -> { m with loading = false; version = ""; load_error = message })
  | Ok version ->
    // a link's `?tab=` takes effect here, after hydration, and its tabs need the compiler
    let tab = requested_tab (tab_in_address ())
    update model (fun m -> { m with loading = false; checking = true; version = version; tab = tab })
    adopt_source model
    notify "fp-compile"

edit : Atom.Writable Model -> String ->{Atom.Write;} Unit
let edit model source =
  update model (fun m -> { m with source = source })
  notify "fp-compile"

/// Takes in what the reader typed into the editor.
edited : Atom.Writable Model ->{Atom.Write;} Unit
let edited model = edit model (editor_text ())

/// Puts `source` in both the editor and the model.
replace : Atom.Writable Model -> String ->{Atom.Write;} Unit
let replace model source =
  set_editor_text source
  edit model source

choose : Atom.Writable Model -> Example ->{Atom.Write;} Unit
let choose model example =
  close_preview ()
  update model (fun m -> {
    m with
    revision = m.revision + 1;
    execution = empty_execution;
    tab = Output;
  })
  replace model example.source

/// Shows what the code of the diagnostic `key` means, or hides it when it is shown.
explain : Atom.Writable Model -> String -> String ->{Async, Atom.Write;} Unit
let explain model key code =
  if (Atom.current model).explained == key then
    update model (fun m -> { m with explained = ""; explain_revision = m.explain_revision + 1 })
  else
    update model (fun m -> {
      m with
      explained = key;
      explanation = "";
      explain_revision = m.explain_revision + 1;
    })
    let request = Atom.current model
    let text =
      try explain_code code with
      | JsError failure -> failure.message
    if (Atom.current model).explain_revision == request.explain_revision then
      update model (fun m -> { m with explanation = text })

/// Formats the source as `flick fmt` does; a source that does not parse stays.
format : Atom.Writable Model ->{Async, Atom.Write;} Unit
let format model =
  let m = Atom.current model
  let result =
    try Ok (format_source m.source) with
    | JsError failure -> Err failure.message
  match result with
  | Ok text ->
    if text != m.source && (Atom.current model).source == m.source then replace model text
  | Err message -> update model (fun m -> { m with compile_error = message })

// `latest` on the same button aborts and joins the worker before this Stop action.
run_program : Atom.Writable Model ->{Async, Atom.Write;} Unit
let run_program model =
  let m = Atom.current model
  if m.running then
    update model (fun m -> {
      m with
      running = false;
      execution = { empty_execution with status = "stopped" };
    })
  else
    update model (fun m -> {
      m with
      running = true;
      tab = Output;
      execution = empty_execution;
      ran_source = m.source;
      ran_profile = m.profile;
    })
    let execution =
      try timeout 10000 (task { run_build m.source (profile_name m.profile) }) with
      | TimeoutError -> { empty_execution with status = "timeout" }
      | JsError failure -> { empty_execution with status = "failure"; detail = failure.message }
    update model (fun m -> { m with running = false; execution = execution })
    runtime_messages model

/// Receives output and failures after a preview has mounted.
runtime_messages : Atom.Writable Model ->{Atom.Write;} Unit
let runtime_messages model =
  if (Atom.current model).execution.status == "preview" then
    let messages = take_preview_messages ()
    let output = List.filter (fun line -> line.stream != "crash") messages
    let crashes = List.filter (fun line -> line.stream == "crash") messages
    update model (fun m ->
      match crashes with
      | [] -> { m with execution = { m.execution with lines = m.execution.lines ++ output } }
      | [first, ..._] -> {
        m with
        execution = {
          m.execution with
          lines = m.execution.lines ++ output;
          status = "failure";
          detail = first.text;
        };
      }
    )
    if crashes != [] then close_preview ()

report : Atom.Writable Model -> Failure e ->{Atom.Write;} Unit
let report model failure =
  let message = RawCause.describe (Failure.inspect failure)
  update model (fun m -> { m with fault = message; running = false; loading = false })
  Platform.stderr_line message
