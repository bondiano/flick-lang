module Playground exposing (main, initial_view)

import Actions exposing (load_compiler, prepare_editor, prepare_highlighting, report)
import Dom exposing (configuration)
import State exposing (Configuration, initial_model, tr)
import View exposing (view)

initial_view : Configuration ->{} Ui
let initial_view config =
  let initial = initial_model config
  view (Atom.make initial) initial

main : Unit ->{Async; AppError} Unit
let main () =
  let initial = initial_model (configuration ())
  match Ui.Dom.container "flick-playground" with
  | None -> App.fail "The page has no element flick-playground"
  | Some root ->
    let model = Atom.make initial
    let app = Ui.render (Ui.view (fun () -> view model (Atom.value model))) ()
    provide Atom.layer {
      ignore (parallel
        (task { Ui.Dom.mount root (report model) app })
        (task {
          let label = tr initial.locale "Flick source code" "Исходный код Flick"
          ignore (parallel
            (task { load_compiler model })
            (task {
              parallel (task { prepare_highlighting model }) (task { prepare_editor model label })
            }))
        }))
    }
