module Playground exposing (main, initial_view)

import Actions exposing (load_compiler, prepare_highlighting, report)
import Dom exposing (configuration)
import State exposing (Configuration, initial_model)
import View exposing (view)

initial_view : Configuration ->{} Ui none none
let initial_view config =
  let initial = initial_model config
  let model = Ref.make initial
  view model initial

main : Unit ->{; AppError} Unit
let main () =
  let initial = initial_model (configuration ())
  match Ui.Dom.container "flick-playground" with
  | None -> App.fail "The page has no element flick-playground"
  | Some root ->
    let model = Ref.make initial
    // Background completions must notify an already-mounted root.
    ignore (parallel
      (task { ignore (Ui.Dom.run root (report model) model (fun m -> view model m)) })
      (task {
        ignore (parallel (task { load_compiler model }) (task { prepare_highlighting model }))
      }))
