module Editor exposing (declarations_pane, generated_pane, source_pane)

import Actions exposing (edit, focus_editor)
import State exposing (Model, SyntaxToken, errors, generated, tr)

/// What the compiler writes for the current profile: `code`, painted with
/// `tokens` when there are any, or why there is nothing to show.
code_pane : Model -> String -> String -> List SyntaxToken -> Ui
let code_pane m label code tokens =
  let hint =
    if m.loading then
      tr m.locale "Loading the WebAssembly compiler…" "Загрузка WebAssembly-компилятора…"
    else if m.checking then
      tr m.locale "Checking source…" "Проверка кода…"
    else if m.version == "" then
      tr
        m.locale
        "Load the compiler to see what it writes."
        "Загрузите компилятор, чтобы увидеть результат."
    else if m.compile_error != "" then
      tr
        m.locale
        "Compilation failed. See the error above."
        "Не удалось скомпилировать код. Сообщение об ошибке — выше."
    else if errors m > 0 then
      tr
        m.locale
        "Fix the diagnostics to see what the compiler writes."
        "Исправьте ошибки, чтобы увидеть, что пишет компилятор."
    else
      tr
        m.locale
        "The compiler writes nothing here for this module."
        "Для этого модуля здесь ничего не пишется."
  let shown = if m.highlighting && tokens != [] then syntax_nodes tokens else [Ui.text code]
  ui {
    Ui.with_host
      { Ui.host with tab_index = Some 0; aria_label = Some label }
      (pre { class_name = "fp-generated-code" } (if code == "" then [text hint] else shown))
  }

generated_pane : Model -> Ui
let generated_pane m =
  code_pane
    m
    (tr m.locale "Generated JavaScript" "Сгенерированный JavaScript")
    (generated m).code
    m.generated_tokens

declarations_pane : Model -> Ui
let declarations_pane m =
  code_pane m (tr m.locale "TypeScript declarations" "Объявления TypeScript") (generated m).dts []

syntax_nodes : List SyntaxToken -> List Ui
let syntax_nodes tokens =
  List.map (fun token -> Ui.span { class_name = token.class_name } [Ui.text token.text]) tokens

type alias Source = { model : Atom.Writable Model; m : Model }

// the file name focuses the editor, as an editor's tab does
component source_pane (props : Source) =
  let field = Ui.element ()
  let edit_here =
    Action.exhaust (fun _ -> task {
      if not (focus_editor ()) then
        try Ui.focus field with
        | Ui.Detached -> ()
    })
  ui {
    let m = props.m
    div { class_name = "fp-source" } [
      div { class_name = "fp-pane-header" } [
        Ui.with_host
          { Ui.host with class_name = Some "fp-file" }
          (button { disabled = false; on_click = edit_here } [text "Main.fl"]),
        span { class_name = "fp-pane-note" } [text (tr m.locale "Flick source" "Код на Flick")],
      ],
      // CodeMirror opens in `#fp-cm` after the page; the native field serves until then
      div { class_name = if m.editor_open then "fp-editor fp-editor-open" else "fp-editor" } [
        Ui.with_host { Ui.host with id = Some "fp-cm" } (div { class_name = "fp-cm" } []),
        keyed
          (show m.revision)
          (Ui.with_host
            {
              Ui.host with
              aria_label = Some (tr m.locale "Flick source code" "Исходный код Flick");
              aria_describedby = Some "fp-source-hint";
              auto_capitalize = Some false;
              auto_correct = Some false;
              wrap = Some false;
            }
            (textarea_at field {
              value = m.source;
              placeholder = "module Main exposing (main)";
              on_input = Ui.Event.latest (fun snapshot -> task { edit props.model snapshot.value });
            })),
      ],
      Ui.with_host
        { Ui.host with id = Some "fp-source-hint" }
        (div { class_name = "fp-pane-footer" } [
          text
            (tr
              m.locale
              "Checked on every edit · compiled locally · Esc, then Tab, leaves the editor"
              "Проверка после каждого изменения · компиляция в браузере · Esc, затем Tab — выйти из редактора"),
        ]),
    ]
  }
