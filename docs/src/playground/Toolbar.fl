module Toolbar exposing (choice, view)

import Actions exposing (choose, format, run_program, update)
import Dom exposing (attributes, notify)
import Examples exposing (Example)
import State exposing (Model, Profile(..), errors, status, tr)

choice : String -> Bool -> Bool -> (Unit ->{Atom.Write;} Unit) -> Ui
let choice label active disabled act =
  Ui.with_host
    {
      Ui.host with
      class_name = Some (if active then "fp-choice fp-on" else "fp-choice");
      aria_pressed = Some (active);
    }
    (Ui.button { disabled = disabled; on_click = Ui.Event.latest (fun _ -> task { act () }) } [
      Ui.text label,
    ])

/// The popover of the gallery; a choice in it closes it.
gallery : String
let gallery = "fp-gallery"

pick : Atom.Writable Model -> Model -> Example -> Ui
let pick model m example =
  Ui.keyed
    example.id
    (attributes
      [("popoverTarget", gallery), ("popoverTargetAction", "hide")]
      (choice
        (tr m.locale example.name example.name_ru)
        (m.source == example.source)
        m.running
        (fun () -> choose model example)))

/// The examples by group, in the order of the gallery.
groups : List Example -> List (List Example)
let groups examples =
  let names =
    List.fold_left
      (fun seen e -> if List.contains e.group seen then seen else seen ++ [e.group])
      []
      examples
  [for name <- names yield [for e <- examples; if e.group == name yield e]]

group_view : Atom.Writable Model -> Model -> List Example -> Ui
let group_view model m examples =
  match examples with
  | [] -> Ui.fragment []
  | [first, ..._] ->
    Ui.keyed
      first.group
      (ui {
        div { class_name = "fp-gallery-group" } [
          paragraph [text (tr m.locale first.group first.group_ru)],
          div { class_name = "fp-example-options" } (List.map (pick model m) examples),
        ]
      })

set_profile : Atom.Writable Model -> Model -> Profile -> Ui
let set_profile model m profile =
  choice
    (if profile == Debug then tr m.locale "Debug" "Отладка" else tr m.locale "Release" "Релиз")
    (m.profile == profile)
    m.running
    (fun () ->
      update model (fun m -> { m with profile = profile })
      notify "fp-compile"
    )

/// The chevron of the gallery's button.
chevron : Ui
let chevron =
  Ui.html
    (Ui.trusted_html
      "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' width='16' height='16' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' aria-hidden='true'><path d='m6 9 6 6 6-6'/></svg>")

/// The gallery: a button with the current example's name opens a native
/// popover of every example, by group.
examples_view : Atom.Writable Model -> Model -> Ui
let examples_view model m =
  let current =
    match List.find (fun e -> e.source == m.source) m.examples with
    | Some e -> tr m.locale e.name e.name_ru
    | None -> tr m.locale "Your code" "Ваш код"
  let examples = tr m.locale "Examples" "Примеры"
  ui {
    div { class_name = "fp-examples" } [
      attributes
        [("popoverTarget", gallery)]
        (Ui.with_host
          {
            Ui.host with
            class_name = Some "fp-gallery-button";
            aria_label = Some (examples ++ ": " ++ current);
          }
          (button { disabled = false; on_click = Ui.Event.latest (fun _ -> task { () }) } [
            text current,
            chevron,
          ])),
      attributes
        [("popover", "auto")]
        (Ui.with_host
          { Ui.host with id = Some gallery; aria_label = Some examples }
          (div { class_name = "fp-gallery" } (List.map (group_view model m) (groups m.examples)))),
    ]
  }

run_button : Atom.Writable Model -> Model -> Ui
let run_button model m =
  Ui.with_host
    { Ui.host with class_name = Some (if m.running then "fp-primary fp-stop" else "fp-primary") }
    (Ui.button
      {
        disabled =
          not m.running
            && (m.loading || m.checking || m.version == "" || m.compile_error != "" || errors m > 0);
        on_click = Ui.Event.latest (fun _ -> task { run_program model });
      }
      [
        Ui.text
          (if m.running then tr m.locale "Stop" "Остановить" else tr m.locale "Run" "Запустить"),
      ])

format_button : Atom.Writable Model -> Model -> Ui
let format_button model m =
  Ui.button
    {
      disabled = m.version == "" || m.running;
      on_click = Ui.Event.exhaust (fun _ -> task { format model });
    }
    [Ui.text (tr m.locale "Format" "Форматировать")]

/// The toolbar: what to edit and run first, then the state, then the build profile.
view : Atom.Writable Model -> Model -> Ui
let view model m = ui {
  div { class_name = "fp-toolbar" } [
    examples_view model m,
    run_button model m,
    format_button model m,
    Ui.with_host
      { Ui.host with role = Some "status"; aria_live = Some Ui.Polite }
      (span
        {
          class_name =
            if m.loading || m.checking then
              "fp-status fp-status-loading"
            else if m.version == "" || m.compile_error != "" || errors m > 0 then
              "fp-status fp-bad"
            else
              "fp-status fp-status-ready";
        }
        [text (status m)]),
    Ui.with_host
      {
        Ui.host with
        role = Some "group";
        aria_label = Some (tr m.locale "Build profile" "Профиль сборки");
      }
      (div { class_name = "fp-profiles" } [set_profile model m Debug, set_profile model m Release]),
  ]
}
