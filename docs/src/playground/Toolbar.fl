module Toolbar exposing (choice, examples_view, view)

import Actions exposing (choose, run_program, update)
import Examples exposing (Example, examples)
import State exposing (Model, Mode(..), Profile(..), Tab(..), errors, generated, status, tr)

choice : String -> Bool -> Bool -> (Unit ->{Atom.Write;} Unit) -> Ui
let choice label active disabled act =
  Ui.with_host
    {
      Ui.host with
      class_name = Some (if active then "fp-choice fp-on" else "fp-choice");
      aria_pressed = Some (active);
    }
    (Ui.button { disabled = disabled; on_click = Ui.Event.latest (fun _ -> task { act () }) } [
      Ui.text label,
    ])

pick : Atom.Writable Model -> Model -> Example -> Ui
let pick model m example =
  Ui.keyed
    example.name
    (choice
      (tr m.locale example.name example.name_ru)
      (m.source == example.source)
      m.running
      (fun () -> choose model example))

set_profile : Atom.Writable Model -> Model -> Profile -> Ui
let set_profile model m profile =
  choice
    (if profile == Debug then tr m.locale "Debug" "Отладка" else tr m.locale "Release" "Релиз")
    (m.profile == profile)
    m.running
    (fun () ->
      update model (fun m ->
        let current = if profile == Debug then m.compiled.debug else m.compiled.release
        { m with profile = profile; tab = if errors current > 0 then Problems else m.tab }
      )
    )

examples_view : Atom.Writable Model -> Model -> Ui
let examples_view model m =
  Ui.with_host
    { Ui.host with role = Some "group"; aria_label = Some (tr m.locale "Examples" "Примеры") }
    (Ui.div { class_name = "fp-examples" } [
      Ui.span { class_name = "fp-control-label" } [Ui.text (tr m.locale "Examples" "Примеры")],
      Ui.div { class_name = "fp-example-options" } (List.map (pick model m) examples),
    ])

view : Atom.Writable Model -> Model -> Ui
let view model m = ui {
  div { class_name = "fp-toolbar" } [
    Ui.with_host
      {
        Ui.host with
        role = Some "group";
        aria_label = Some (tr m.locale "Build profile" "Профиль сборки");
      }
      (div { class_name = "fp-profiles" } [
        span { class_name = "fp-control-label" } [text (tr m.locale "Build" "Сборка")],
        set_profile model m Debug,
        set_profile model m Release,
      ]),
    Ui.with_host
      { Ui.host with role = Some "status"; aria_live = Some Ui.Polite }
      (span
        {
          class_name =
            if m.loading || m.checking then
              "fp-status fp-status-loading"
            else if m.version == "" || m.compile_error != "" || errors (generated m) > 0 then
              "fp-status fp-bad"
            else
              "fp-status fp-status-ready";
        }
        [text (status m)]),
    if m.mode == Play then
      Ui.with_host
        {
          Ui.host with
          class_name = Some (if m.running then "fp-primary fp-stop" else "fp-primary");
        }
        (button
          {
            disabled =
              not m.running
                && (m.loading
                  || m.checking
                  || m.version == ""
                  || m.compile_error != ""
                  || errors (generated m) > 0);
            on_click = Ui.Event.latest (fun _ -> task { run_program model });
          }
          [
            text
              (
                if m.running then tr m.locale "Stop" "Остановить" else tr m.locale "Run" "Запустить"
              ),
          ])
    else empty,
  ]
}
