module View exposing (view)

import Actions exposing (edited, load_compiler, refresh, update)
import Dom exposing (notify)
import Editor exposing (declarations_pane, generated_pane, source_pane)
import Results exposing (current_problems, diagnostic_label, output_pane)
import State exposing (Model, Tab(..), tr)
import Toolbar exposing (choice)

/// The result panel: what a run printed, the diagnostics, and what the
/// compiler writes for the current profile.
result_pane : Atom.Writable Model -> Model -> Ui
let result_pane model m =
  // a tab of the compiler's output asks for an emit, which edits alone no longer make
  let tab name label =
    choice label (m.tab == name) false (fun () ->
      update model (fun m -> { m with tab = name })
      if name == Js || name == Dts then notify "fp-compile"
    )
  let body =
    match m.tab with
    | Output -> output_pane model m
    | Problems -> ui { div { class_name = "fp-problems-panel" } [current_problems model m] }
    | Js -> generated_pane m
    | Dts -> declarations_pane m
  ui {
    div { class_name = "fp-result" } [
      Ui.with_host
        { Ui.host with role = Some "group"; aria_label = Some (tr m.locale "Result" "Результат") }
        (div { class_name = "fp-pane-header fp-tabs" } [
          tab Output (tr m.locale "Output" "Вывод"),
          tab Problems (diagnostic_label m),
          tab Js "JavaScript",
          tab Dts ".d.ts",
        ]),
      body,
    ]
  }

notice : String -> String -> Ui
let notice title detail = ui {
  div { class_name = "fp-notice" } [
    paragraph [text title],
    pre { class_name = "fp-failure-detail" } [text detail],
  ]
}

view : Atom.Writable Model -> Model -> Ui
let view model m = ui {
  div { class_name = "fp" } [
    // a hidden button runs a compile under `latest`: a newer edit interrupts the one before
    Ui.with_host
      {
        Ui.host with
        id = Some "fp-compile";
        class_name = Some "fp-refresh";
        aria_hidden = Some true;
        tab_index = Some (-1);
      }
      (button
        { disabled = false; on_click = Ui.Event.latest (fun _ -> task { refresh model }) }
        []),
    // and another takes in an edit of CodeMirror, which lives outside the view
    Ui.with_host
      {
        Ui.host with
        id = Some "fp-edit";
        class_name = Some "fp-refresh";
        aria_hidden = Some true;
        tab_index = Some (-1);
      }
      (button { disabled = false; on_click = Ui.Event.latest (fun _ -> task { edited model }) } []),
    div { class_name = "fp-workspace" } [
      Toolbar.view model m,
      if m.load_error != "" then
        Ui.with_host
          { Ui.host with role = Some "alert" }
          (div { class_name = "fp-recovery" } [
            notice
              (tr
                m.locale
                "The compiler could not load. Retry, or reload this page after checking your connection."
                "Не удалось загрузить компилятор. Повторите попытку или проверьте соединение и обновите страницу.")
              m.load_error,
            button
              {
                disabled = m.loading;
                on_click = Ui.Event.exhaust (fun _ -> task { load_compiler model });
              }
              [text (tr m.locale "Retry compiler" "Загрузить снова")],
          ])
      else empty,
      if m.compile_error != "" then
        Ui.with_host
          { Ui.host with role = Some "alert" }
          (div { class_name = "fp-recovery" } [
            notice
              (tr
                m.locale
                "The compiler failed while checking this source."
                "Сбой компилятора при проверке кода.")
              m.compile_error,
            button
              {
                disabled = false;
                on_click = Ui.Event.latest (fun _ -> task { notify "fp-compile" });
              }
              [text (tr m.locale "Retry compilation" "Повторить компиляцию")],
          ])
      else empty,
      if m.fault != "" then
        Ui.with_host
          { Ui.host with role = Some "alert" }
          (notice
            (tr
              m.locale
              "The playground encountered an error. Reload the page to recover."
              "В редакторе произошла ошибка. Обновите страницу, чтобы продолжить.")
            m.fault)
      else empty,
      if m.syntax_error != "" then
        Ui.with_host
          { Ui.host with role = Some "status" }
          (div { class_name = "fp-recovery" } [
            notice
              (tr
                m.locale
                "The code editor could not load. Editing and compilation still work."
                "Не удалось загрузить редактор кода. Код по-прежнему можно редактировать и компилировать.")
              m.syntax_error,
          ])
      else empty,
      div { class_name = "fp-panes" } [
        Ui.render source_pane { model = model; m = m },
        // `split.ts` moves it with the pointer and the arrow keys
        Ui.with_host
          {
            Ui.host with
            role = Some "separator";
            tab_index = Some 0;
            aria_label = Some (tr m.locale "Resize the panels" "Изменить ширину панелей");
          }
          (div { class_name = "fp-split" } []),
        result_pane model m,
      ],
    ],
  ]
}
