// A resource opened in a scope is closed when the scope ends, in reverse order.
module Main exposing (main)

open : String -> Eff {Host.Console} none String
let open name = task {
  Platform.stdout_line "open \{name}"
  name
}

main : Unit ->{Host.Console} Unit
let main () =
  let result = scope s {
    let a = Resource.make (open "file") (fun _ _ -> Platform.stdout_line "close file")
    let b = Resource.make (open "socket") (fun _ _ -> Platform.stdout_line "close socket")
    ignore s
    "\{a} and \{b}"
  }
  Platform.stdout_line "used \{result}"
