// A schedule retries a task that fails, up to five times.
module Main exposing (main)

type error Flaky = Flaky Float

flaky : Ref Float ->{Host.Console; Flaky} String
let flaky calls =
  let n = Ref.get calls + 1
  Ref.set calls n
  Platform.stdout_line "attempt \{n}"
  if n < 3 then Fail.fail (Flaky n) else "done after \{n}"

main : Unit ->{Host.Console, Async} Unit
let main () =
  let calls = Ref.make 0
  let result =
    try Effect.retry (Schedule.recurs 5) (flaky calls) with
    | Flaky n -> "gave up at \{n}"
  Platform.stdout_line result
