// A failure is part of the signature: `find` says it may fail with `NotFound`.
module Main exposing (main)

type error NotFound = NotFound String

find : String ->{; NotFound} Float
let find name = if name == "ada" then 36 else Fail.fail (NotFound name)

main : Unit ->{Host.Console} Unit
let main () =
  let age =
    try find "ada" with
    | NotFound _ -> 0
  Platform.stdout_line "ada is \{age}"
  let other =
    try show (find "bob") with
    | NotFound who -> "no \{who}"
  Platform.stdout_line other
