module Dom exposing (attributes, configuration, source_value, notify, tab_in_address)

import State exposing (Configuration)

configuration : Unit ->{} Configuration
foreign configuration from "./dom.ts" "configuration"
  arity 0

source_value : Unit ->{} String
foreign source_value from "./dom.ts" "sourceValue"
  arity 0

notify : String ->{} Unit
foreign notify from "./dom.ts" "notify"
  arity 1

/// The `tab` of the page's query, or `""`.
tab_in_address : Unit ->{} String
foreign tab_in_address from "./dom.ts" "tabInAddress"
  arity 0

/// Host attributes `Ui.Host` does not type, such as `popover`.
attributes : List (String, String) -> Ui^c -> Ui^c
foreign pure attributes from "./dom.ts" "attributes"
  arity 2
  retention call
