module Dom exposing (configuration, source_value, notify)

import State exposing (Configuration)

configuration : Unit ->{} Configuration
foreign configuration from "./dom.ts" "configuration"
  arity 0

source_value : Unit ->{} String
foreign source_value from "./dom.ts" "sourceValue"
  arity 0

notify : String ->{} Unit
foreign notify from "./dom.ts" "notify"
  arity 1
