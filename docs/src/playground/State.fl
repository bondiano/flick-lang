module State exposing (
  Locale(..),
  Profile(..),
  Tab(..),
  Configuration,
  SyntaxToken,
  Diagnostic,
  Generated,
  Line,
  Execution,
  Model,
  empty_generated,
  emit_key,
  wants_code,
  empty_execution,
  first_source,
  tr,
  profile_name,
  generated,
  errors,
  status,
  initial_model,
  requested_tab,
)

import Examples exposing (Example)

type Locale = En | Ru
  deriving Eq

type Profile = Debug | Release
  deriving Eq

/// What the result panel shows: the program's output, the diagnostics, or
/// what the compiler writes, as JavaScript and as TypeScript declarations.
type Tab = Output | Problems | Js | Dts
  deriving Eq

type alias Configuration = {
  locale : String;
  examples : List Example;
  lesson : Bool;
  lesson_title : String;
  lesson_title_ru : String;
  lesson_task : String;
  lesson_task_ru : String;
  lesson_hint_text : String;
  lesson_hint_text_ru : String;
  solution : String;
  done : Bool;
}
type alias SyntaxToken = { text : String; class_name : String }
/// A change a fix makes; `start` and `end` are UTF-16 offsets of the module.
type alias Edit = { start : Int; end : Int; insert : String }
type alias Fix = { message : String; edits : List Edit }
/// `start` and `end` are UTF-16 offsets of the module, or -1 for a place elsewhere.
type alias Diagnostic = {
  code : String;
  severity : String;
  message : String;
  at : String;
  start : Int;
  end : Int;
  fixes : List Fix;
}
type alias Generated = { code : String; dts : String; diagnostics : List Diagnostic }
type alias Line = { stream : String; text : String }
type alias Execution = {
  lines : List Line;
  status : String;
  detail : String;
  diagnostics : List Diagnostic;
}

type alias Model = {
  locale : Locale;
  examples : List Example;
  source : String;
  revision : Float;
  profile : Profile;
  tab : Tab;
  /// What the last check of `source` says.
  diagnostics : List Diagnostic;
  /// What the compiler wrote for `emitted_key`: the profile and the source.
  emitted : Generated;
  emitted_key : String;
  execution : Execution;
  ran_source : String;
  ran_profile : Profile;
  running : Bool;
  loading : Bool;
  checking : Bool;
  highlighting : Bool;
  generated_tokens : List SyntaxToken;
  syntax_error : String;
  /// Whether CodeMirror holds the source in place of the native field.
  editor_open : Bool;
  /// The diagnostic whose explanation is open, by code, place and message, and the text.
  explained : String;
  explanation : String;
  explain_revision : Float;
  version : String;
  load_error : String;
  compile_error : String;
  fault : String;
  storage_notice : String;
  lesson : Bool;
  lesson_title : String;
  lesson_title_ru : String;
  lesson_task : String;
  lesson_task_ru : String;
  lesson_hint_text : String;
  lesson_hint_text_ru : String;
  lesson_solution : String;
  lesson_hint : Bool;
  lesson_result : String;
  lesson_done : Bool;
  lesson_checking : Bool;
}

empty_generated : Generated
let empty_generated = { code = ""; dts = ""; diagnostics = [] }

/// What an emit of the current source and profile is filed under.
emit_key : Model -> String
let emit_key m = profile_name m.profile ++ "\n" ++ m.source

/// Whether the tab shown needs what the compiler writes, not only its check.
wants_code : Model -> Bool
let wants_code m = m.tab == Js || m.tab == Dts

empty_execution : Execution
let empty_execution = { lines = []; status = ""; detail = ""; diagnostics = [] }

/// The source the playground opens with: the first example's.
first_source : List Example -> String
let first_source examples =
  match examples with
  | [first, ..._] -> first.source
  | [] -> ""

tr : Locale -> String -> String -> String
let tr locale english russian = if locale == Ru then russian else english

profile_name : Profile -> String
let profile_name profile = if profile == Debug then "debug" else "release"

generated : Model -> Generated
let generated m = m.emitted

errors : Model -> Int
let errors m = List.length (List.filter (fun d -> d.severity == "error") m.diagnostics)

status : Model -> String
let status m =
  if m.loading then
    tr m.locale "Loading compiler…" "Загрузка компилятора…"
  else if m.checking then
    tr m.locale "Checking source…" "Проверка кода…"
  else if m.version == "" then
    tr m.locale "Compiler unavailable" "Компилятор недоступен"
  else if m.compile_error != "" then
    tr m.locale "Compilation failed" "Сбой компиляции"
  else if errors m > 0 then
    tr m.locale "Errors: " "Ошибок: " ++ show (errors m)
  else if m.running then
    tr m.locale "Running · 10 s limit" "Выполняется · лимит 10 с"
  else
    "Flick " ++ m.version ++ " · " ++ tr m.locale "Type-checked" "Типы проверены"

/// The tab a link asks for with `?tab=`: `js`, `dts` or `problems`; any
/// other value leaves the output.
requested_tab : String -> Tab
let requested_tab name =
  match name with
  | "js" -> Js
  | "dts" -> Dts
  | "problems" -> Problems
  | _ -> Output

initial_model : Configuration -> Model
let initial_model config = {
  locale = if config.locale == "ru" then Ru else En;
  examples = config.examples;
  source = first_source config.examples;
  revision = 0;
  profile = Debug;
  tab = Output;
  diagnostics = [];
  emitted = empty_generated;
  emitted_key = "";
  execution = empty_execution;
  ran_source = "";
  ran_profile = Debug;
  running = false;
  loading = true;
  checking = false;
  highlighting = false;
  generated_tokens = [];
  syntax_error = "";
  editor_open = false;
  explained = "";
  explanation = "";
  explain_revision = 0;
  version = "";
  load_error = "";
  compile_error = "";
  fault = "";
  storage_notice = "";
  lesson = config.lesson;
  lesson_title = config.lesson_title;
  lesson_title_ru = config.lesson_title_ru;
  lesson_task = config.lesson_task;
  lesson_task_ru = config.lesson_task_ru;
  lesson_hint_text = config.lesson_hint_text;
  lesson_hint_text_ru = config.lesson_hint_text_ru;
  lesson_solution = config.solution;
  lesson_hint = false;
  lesson_result = "";
  lesson_done = config.done;
  lesson_checking = false;
}
