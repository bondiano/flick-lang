module Main exposing (main)

open_res : Fiber.Provided {Host.Console} s => String ->{Host.Console, Scope s} String
let open_res name =
  Resource.make
    (task {
      Platform.stdout_line "open \{name}"
      name
    })
    (fun n _ -> Platform.stdout_line "release \{n}")

both : Fiber.Provided {Host.Console} s => Unit ->{Host.Console, Scope s} String
let both () = "\{open_res "config"} + \{open_res "cache"}"

main : Unit ->{Host.Console} Unit
let main () =
  let used = scope { both () }
  Platform.stdout_line "used \{used}"
