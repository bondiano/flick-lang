module Main exposing (main)

type error Invalid = Invalid Int

check : Int ->{; Invalid} Int
let check n = if n < 0 then from_result (Err (Invalid n)) else n

open : String -> Eff none none String
let open name = task {
  Platform.stdout_line ("open " ++ name)
  name
}

main : Unit ->{} Unit
let main () =
  let result =
    try
      scope {
        let file =
          Resource.acquire_release (open "file") (fun _ -> Platform.stdout_line "close file")
        Platform.stdout_line ("reading " ++ file)
        check (-3)
      }
    with
    | Invalid n -> n
  Platform.stdout_line "handled \{result}"
