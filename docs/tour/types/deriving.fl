module Main exposing (main)

type Suit = Hearts | Spades
  deriving Eq, Ord, Show

type Card = Card Suit Int
  deriving Eq, Ord, Show

main : Unit ->{} Unit
let main () =
  let hand = [Card Spades 3, Card Hearts 12, Card Hearts 2]
  Platform.stdout_line (show (List.sort hand))
  Platform.stdout_line (show (Card Hearts 2 == Card Hearts 2))
  Platform.stdout_line (show (Card Hearts 12 < Card Spades 1))
