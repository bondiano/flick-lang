module Main exposing (main)

refined type Port = Int where fun n -> n > 0 && n < 65536

as_port : Int -> Option Port
let as_port n = if n > 0 && n < 65536 then Some (Port.prove n) else None

main : Unit ->{Host.Console} Unit
let main () =
  Platform.stdout_line (show (Option.map Port.value (as_port 8080)))
  Platform.stdout_line (show (Option.map Port.value (as_port 65536)))
