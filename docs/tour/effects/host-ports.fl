module Main exposing (main)

stamp : Unit ->{Host.Clock, Host.Random} String
let stamp () =
  let running = Host.Clock.current_time_millis () > 0
  let draw = Host.Random.next ()
  "clock running: \{show running}, draw in range: \{show (draw >= 0 && draw < 1)}, draw is 0.25: \{show (draw == 0.25)}"

fixed_clock : Layer none none {Host.Clock}
let fixed_clock =
  Layer.succeed Host.Clock {
    current_time_millis = fun () -> 0
    current_time_nanos = fun () -> 0n
    monotonic_time_nanos = fun () -> 0n
  }

fixed_random : Layer none none {Host.Random}
let fixed_random = Layer.succeed Host.Random { next = fun () -> 0.25 }

main : Unit ->{Host.Console, Host.Clock, Host.Random} Unit
let main () =
  Platform.stdout_line ("live: " ++ stamp ())
  let fake = provide (Layer.merge fixed_clock fixed_random) { stamp () }
  Platform.stdout_line ("fake: " ++ fake)
