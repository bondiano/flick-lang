module Main

import Test exposing (expect, to)

type error NotFound = NotFound String
  deriving Eq, Show

find : String ->{; NotFound} String
let find name = Fail.fail (NotFound name)

suite "matchers" {
  test "equal" { expect (1 + 1) |> to.equal 2 }
  test "true" { expect true |> to.be_true }
  test "ordered" { expect 3 |> to.be_greater_than 2 }
  test "contains" { expect ["Ada", "Grace"] |> to.contain "Ada" }
  test "typed failure" { expect (task { find "Bob" }) |> to.fail_with (NotFound "Bob") }
  test "diff (intentionally red)" {
    expect "first\nactual\nlast" |> to.equal "first\nexpected\nlast"
  }
}
