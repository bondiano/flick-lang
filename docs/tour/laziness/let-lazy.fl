module Main exposing (main)

counted : Ref Int -> Int ->{} Int
let counted runs value =
  Ref.update runs (fun n -> n + 1)
  value

main : Unit ->{Host.Console} Unit
let main () =
  let runs = Ref.make 0
  let lazy answer = counted runs 42
  let a = await answer
  let b = await answer
  let lazy mut replaced = counted runs 7
  replaced = 8
  let c = await replaced
  Platform.stdout_line "\{a} \{b} \{c}, runs: \{Ref.get runs}"
