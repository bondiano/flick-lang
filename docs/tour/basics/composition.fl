module Main exposing (main)

shout : String -> String
let shout = String.trim >> String.to_upper

words : String -> Int
let words = List.length << String.split " "

main : Unit ->{} Unit
let main () =
  Platform.stdout_line <| shout "  pipes  "
  Platform.stdout_line <| show <| words "pipes and composition"
  ["a b", "c"]
  |> List.map (String.split " " >> List.length >> show)
  |> String.join ","
  |> Platform.stdout_line
