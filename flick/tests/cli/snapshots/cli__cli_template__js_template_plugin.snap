schema-version = 1

[package]
name = "demo"
version = "0.1.0"
plugin = "plugin.wasm"

[scripts]
plugin = [
  "cargo build --manifest-path plugin/Cargo.toml --features guest --target wasm32-wasip2 --release",
  "cp plugin/target/wasm32-wasip2/release/demo_plugin.wasm plugin.wasm",
]

[project]
kind = "lib"
source-dir = "src"
test-dir = "test"

[build]
out-dir = "dist"
profile = "debug"
target = "js"
