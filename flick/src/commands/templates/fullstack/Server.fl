// The server entry: it serves the calls of `App.Api` on `PORT` (3000 by
// default) until it is stopped.
module App.Server exposing (main)

import App.Api exposing (Session)
import App.Store
import Http.ServerRequest exposing (ServerRequest)
import Http.ServerResponse exposing (ServerResponse)
import Server exposing (plugin server)

/// The session of a `session=<name>` cookie; without one, a guarded call is
/// turned away. Replace it with your own sign-in.
check : Http.Headers.Headers ->{; Server.Unauthorized} Session.Impl
let check headers =
  let prefix = "session="
  match Http.Headers.get "cookie" headers with
  | Some cookie ->
    if String.starts_with prefix cookie then
      let name = String.slice (String.length prefix) (String.length cookie) cookie
      { user = fun () -> name }
    else
      from_result (Err Server.Unauthorized)
  | None -> from_result (Err Server.Unauthorized)

main : Unit ->{; AppError} Unit
let main () =
  let port = Option.with_default 3000 (Option.bind String.to_number (Platform.env "PORT"))
  let store = Layer.succeed App.Store.Store (App.Store.memory ())
  provide (Layer.merge Server.node (Layer.merge store Http.Server.layer_services)) {
    try
      scope s {
        functions : (ServerRequest ->{} ServerResponse)^{s}
        let functions =
          Server.handler
            (Server.authenticated Session check [server App.Api.add] ++ [server App.Api.list])
        app : (ServerRequest ->{Server.Server; Http.ServerError.HttpServerError} ServerResponse)^{s}
        let app =
          Http.Router.router Http.Router.config [
            Http.Router.route (Some Http.Method.POST) Server.path functions,
          ]
        let listening =
          Http.Server.serve { host = "127.0.0.1"; port = port; gracefulShutdownTimeout = None } app
        Platform.stdout_line
          ("listening on " ++ Http.Server.format_address (Http.Server.address listening))
        Deferred.await_ (Deferred.make ())
      }
    with
    | Http.ServerError.ServeError _ -> App.fail ("cannot listen on port " ++ show port)
  }
