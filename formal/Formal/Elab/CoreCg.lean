import Formal.Decomp
import Formal.Closed
import Formal.Elab.Hyp

/-!
# λFlick⁺ as a `Target`: the congruence of a relation on core terms

`Cg B x a b`: `a` and `b` are one term up to base pairs `B` in some places. It is the
congruence generated by `B`, one rule per term former. The index `x` says whether a base pair
may stand here (`false`) or not (`true`). Inside a dictionary record (`drec`) it is `true`
down the spine and through `app` and `rcons`: a pattern inspects the fields of a record
without evaluating them (`matchP` through `Tm.field`), so nothing there may differ by a base
pair at the top. Everywhere else, under a binder and in the other places of a term former,
the index is `false`.

The relation keeps the shape of values when the left side of a base pair is never a value
(`Cg.value`), and it is closed under renaming and substitution when base pairs are closed
(`Cg.rename`, `Cg.subst`).
-/

namespace Flick.Elab

/-- The congruence generated by `B`; `x = true` forbids a base pair at the top. -/
inductive Cg (B : Flick.Tm → Flick.Tm → Prop) : Bool → Flick.Tm → Flick.Tm → Prop
  | var {x i} : Cg B x (.var i) (.var i)
  | lam {x b b'} : Cg B false b b' → Cg B x (.lam b) (.lam b')
  | app {x f f' a a'} : Cg B x f f' → Cg B x a a' → Cg B x (.app f a) (.app f' a')
  | let_ {x e e' b b'} : Cg B false e e' → Cg B false b b' → Cg B x (.let_ e b) (.let_ e' b')
  | letrec {x f f' b b'} : Cg B false f f' → Cg B false b b' →
      Cg B x (.letrec f b) (.letrec f' b')
  | fix {x f f'} : Cg B false f f' → Cg B x (.fix f) (.fix f')
  | lit {x l} : Cg B x (.lit l) (.lit l)
  | loc {x l} : Cg B x (.loc l) (.loc l)
  | const {x c} : Cg B x (.const c) (.const c)
  | ctor {x K} : Cg B x (.ctor K) (.ctor K)
  | rnil {x} : Cg B x .rnil .rnil
  | rcons {x l e e' r r'} : Cg B x e e' → Cg B x r r' → Cg B x (.rcons l e r) (.rcons l e' r')
  | proj {x e e' l} : Cg B false e e' → Cg B x (.proj e l) (.proj e' l)
  | update {x e e' l a a'} : Cg B false e e' → Cg B false a a' →
      Cg B x (.update e l a) (.update e' l a')
  | match_ {x e e' al al'} : Cg B false e e' → Cg B false al al' →
      Cg B x (.match_ e al) (.match_ e' al')
  | anil {x} : Cg B x .anil .anil
  | acons {x p b b' r r'} : Cg B false b b' → Cg B false r r' →
      Cg B x (.acons p b r) (.acons p b' r')
  | aguard {x p g g' b b' r r'} : Cg B false g g' → Cg B false b b' → Cg B false r r' →
      Cg B x (.aguard p g b r) (.aguard p g' b' r')
  | todo {x} : Cg B x .todo .todo
  | task {x e e'} : Cg B false e e' → Cg B x (.task e) (.task e')
  | await {x e e'} : Cg B false e e' → Cg B x (.await e) (.await e')
  | raise {x e e'} : Cg B false e e' → Cg B x (.raise e) (.raise e')
  | try_ {x e e' al al'} : Cg B false e e' → Cg B false al al' →
      Cg B x (.try_ e al) (.try_ e' al')
  | handle {x v v' al al'} : Cg B false v v' → Cg B false al al' →
      Cg B x (.handle v al) (.handle v' al')
  | scope {x e e'} : Cg B false e e' → Cg B x (.scope e) (.scope e')
  | inside {x p e e'} : Cg B false e e' → Cg B x (.inside p e) (.inside p e')
  | cap {x p} : Cg B x (.cap p) (.cap p)
  | own {x p} : Cg B x (.own p) (.own p)
  | drec {x c r r'} : Cg B true r r' → Cg B x (.drec c r) (.drec c r')
  | glob {x g} : Cg B x (.glob g) (.glob g)
  | hdl {x E al al' r r' e e'} : Cg B false al al' → Cg B false r r' → Cg B false e e' →
      Cg B x (.hdl E al r e) (.hdl E al' r' e')
  | hwith {x p ℓ E al al' r r' e e'} : Cg B false al al' → Cg B false r r' → Cg B false e e' →
      Cg B x (.hwith p ℓ E al r e) (.hwith p ℓ E al' r' e')
  | hctl {x p ℓ κ tl E al al' r r' a a' k k'} : Cg B false al al' → Cg B false r r' →
      Cg B false a a' → Cg B false k k' → Cg B x (.hctl p ℓ κ tl E al r a k) (.hctl p ℓ κ tl E al' r' a' k')
  | hres {x p ℓ a a' b b'} : Cg B false a a' → Cg B false b b' → Cg B x (.hres p ℓ a b) (.hres p ℓ a' b')
  | hdone {x p a a'} : Cg B false a a' → Cg B x (.hdone p a) (.hdone p a')
  | unw {x p ℓ a a'} : Cg B false a a' → Cg B x (.unw p ℓ a) (.unw p ℓ a')
  | kont {x p ℓ} : Cg B x (.kont p ℓ) (.kont p ℓ)
  | hole {x p} : Cg B x (.hole p) (.hole p)
  | base {a b} : B a b → Cg B false a b

variable {B : Flick.Tm → Flick.Tm → Prop}

theorem Cg.refl (x : Bool) (a : Flick.Tm) : Cg B x a a := by
  induction a generalizing x <;> constructor <;> apply_assumption

theorem Cg.lower {x : Bool} {a b : Flick.Tm} (h : Cg B x a b) : Cg B false a b := by
  induction h <;> first | exact .base ‹_› | (constructor <;> assumption)

/-- Base pairs are closed. -/
def BClosed (B : Flick.Tm → Flick.Tm → Prop) : Prop := ∀ a b, B a b → a.Closed ∧ b.Closed

theorem Cg.rename (hB : BClosed B) {x : Bool} {a b : Flick.Tm} (h : Cg B x a b) :
    ∀ ξ : Nat → Nat, Cg B x (a.rename ξ) (b.rename ξ) := by
  induction h with
  | base hb =>
    intro ξ; rw [(hB _ _ hb).1.rename, (hB _ _ hb).2.rename]; exact .base hb
  | _ => intro ξ; simp only [Flick.Tm.rename]; constructor <;> apply_assumption

/-- Pointwise related substitutions, at either index. -/
def SubR (B : Flick.Tm → Flick.Tm → Prop) (σ σ' : Nat → Flick.Tm) : Prop :=
  ∀ i x, Cg B x (σ i) (σ' i)

theorem SubR.lift (hB : BClosed B) {σ σ' : Nat → Flick.Tm} (h : SubR B σ σ') (n : Nat) :
    SubR B (liftS n σ) (liftS n σ') := by
  intro i x
  unfold liftS
  split
  · exact .var
  · exact (h _ x).rename hB _

theorem Cg.subst (hB : BClosed B) {x : Bool} {a b : Flick.Tm} (h : Cg B x a b) :
    ∀ σ σ', SubR B σ σ' → Cg B x (a.subst σ) (b.subst σ') := by
  induction h with
  | base hb =>
    intro σ σ' _; rw [(hB _ _ hb).1.subst, (hB _ _ hb).2.subst]; exact .base hb
  | var => intro σ σ' hσ; exact hσ _ _
  | _ =>
    intro σ σ' hσ; simp only [Flick.Tm.subst]
    constructor <;> apply_assumption <;> first | exact hσ | exact hσ.lift hB _

/-- The left side of a base pair is never a value. -/
def BNoVal (B : Flick.Tm → Flick.Tm → Prop) : Prop := ∀ a b, B a b → ¬ Value a

/-- **A value is related only to a value** of the same shape, at either index. -/
theorem Cg.value (hB : BNoVal B) {a : Flick.Tm} (hv : Value a) :
    ∀ {x b}, Cg B x a b → Value b ∧ (∀ K, a.head = .ctor K → b.head = .ctor K) ∧
      ∀ y, Cg B y a b := by
  induction hv with
  | lam => intro x b h; cases h with
    | lam h => exact ⟨.lam, by simp [Flick.Tm.head], fun _ => .lam h⟩
    | base h => exact (hB _ _ h .lam).elim
  | fix => intro x b h; cases h with
    | fix h => exact ⟨.fix, by simp [Flick.Tm.head], fun _ => .fix h⟩
    | base h => exact (hB _ _ h .fix).elim
  | task => intro x b h; cases h with
    | task h => exact ⟨.task, by simp [Flick.Tm.head], fun _ => .task h⟩
    | base h => exact (hB _ _ h .task).elim
  | drec => intro x b h; cases h with
    | drec h => exact ⟨.drec, by simp [Flick.Tm.head], fun _ => .drec h⟩
    | base h => exact (hB _ _ h .drec).elim
  | rcons _ _ ih₁ ih₂ => intro x b h; cases h with
    | rcons h₁ h₂ =>
      exact ⟨.rcons (ih₁ h₁).1 (ih₂ h₂).1, by simp [Flick.Tm.head],
        fun y => .rcons ((ih₁ h₁).2.2 y) ((ih₂ h₂).2.2 y)⟩
    | base h => exact (hB _ _ h (.rcons ‹_› ‹_›)).elim
  | ctorApp hf hK he ihf ihe => intro x b h; cases h with
    | app h₁ h₂ =>
      obtain ⟨vf, kf, yf⟩ := ihf h₁
      have kf' := kf _ hK
      exact ⟨.ctorApp vf kf' (ihe h₂).1, by simpa [Flick.Tm.head] using kf,
        fun y => .app (yf y) ((ihe h₂).2.2 y)⟩
    | base h => exact (hB _ _ h (.ctorApp hf hK he)).elim
  | constApp hc he ihe => intro x b h; cases h with
    | app h₁ h₂ =>
      cases h₁ with
      | const => exact ⟨.constApp hc (ihe h₂).1, by simp [Flick.Tm.head],
          fun y => .app .const ((ihe h₂).2.2 y)⟩
      | base h => exact (hB _ _ h .const).elim
    | base h => exact (hB _ _ h (.constApp hc he)).elim
  | _ => intro x b h; cases h with
    | base h => exact (hB _ _ h (by constructor)).elim
    | _ => exact ⟨by constructor, by simp [Flick.Tm.head], fun _ => by constructor⟩

end Flick.Elab
