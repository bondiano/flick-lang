module App.Hom.Nest exposing (Make)

offset : Int
let offset = 1

module Make(K : App.Hom.Contracts.Input) : App.Hom.Contracts.Output with type Value = K.Item =
  module Built = App.Hom.Make(K)
  type alias Value = K.Item
  value : Value
  let value = Built.value
  answer : Int
  let answer = K.seed + offset
  same : Value -> Value -> Bool
  let same = Built.same
