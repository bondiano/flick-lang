module App.Main exposing (main)

// the model's services and effects have no parameters
type error Missing = Missing
type error Other = Other

effect Select =
  control select : Unit ->{} Int

effect Emit =
  control emit : Int ->{} Unit

effect Choose =
  control choose : Unit ->{} Bool

say : String ->{} Unit
let say line = Platform.stdout_line line

collect : (Unit ->{Emit | r; e} Unit) ->{r; e} List Int
let collect body =
  try body () with
  | Emit.emit x -> [x] ++ resume ()
  | return () -> []

reversed : (Unit ->{Emit | r; e} Unit) ->{r; e} List Int
let reversed body =
  try body () with
  | Emit.emit x ->
    let rest = resume ()
    rest ++ [x]
  | return () -> []

first : (Unit ->{Emit; none} Unit) ->{} Int
let first body =
  try body () with
  | Emit.emit x -> x
  | return () -> 0

three : Unit ->{Emit; none} Unit
let three () =
  Emit.emit 1
  Emit.emit 2
  Emit.emit 3

mutable_control : Unit ->{} (Int, Int)
let mutable_control () =
  let mut value = 0
  let result =
    try
      value = 2
      let chosen = Choose.choose ()
      if chosen then value = value + 1
      value
    with
    | Choose.choose () ->
      let _body = resume true
      7
  (value, result)

control_exit : Unit ->{} (Int, Int)
let control_exit () =
  let mut seen = 0
  let chosen =
    loop {
      try
        seen = 1
        let n = Select.select ()
        seen = n
        break n
      with
      | Select.select () ->
        let again = resume
        try again 7 with
        | Missing -> ()
      | return _ ->
        seen = 99
        ()
    }
  (seen, chosen)

control_normal : Unit ->{} Int
let control_normal () =
  loop {
    let n =
      try Select.select () + 1 with
      | Select.select () ->
        let answer = resume 7
        answer + 1
      | return value -> value * 2
    break n
  }

control_error_exit : Unit ->{} Int
let control_error_exit () =
  loop {
    try
      let _chosen = Select.select ()
      from_result (Err Missing)
    with
    | Select.select () -> resume 7
    | Missing when (if true then break 11 else false) -> ()
    | Missing -> break 12
  }

control_unhandled : Unit ->{} Int
let control_unhandled () =
  try
    loop {
      try
        let _chosen = Select.select ()
        from_result (Err Other)
      with
      | Select.select () -> resume 7
      | Missing -> break 8
    }
  with
  | Other -> 9

control_continue : Unit ->{} (Int, Int)
let control_continue () =
  let mut attempts = 0
  let value =
    loop {
      attempts = attempts + 1
      try
        let n = Select.select ()
        if attempts < 2 then continue
        break n
      with
      | Select.select () -> resume 7
    }
  (attempts, value)

control_local_loops : Unit ->{} (Int, Int)
let control_local_loops () =
  let mut value = 0
  let result =
    try
      while value < 2 do value = value + 1
      for n <- [1, 2] do value = value + n
      if Choose.choose () then value else 0
    with
    | Choose.choose () -> resume true
  (value, result)

keep : a -> a
let keep value = value

keep_after : a -> b -> c -> b
let keep_after first continuation last =
  ignore (first, last)
  continuation

forwarded_exit : Unit ->{} Int
let forwarded_exit () =
  loop {
    try
      let n = Select.select ()
      break n
    with
    | Select.select () ->
      let forward k = k
      let relay = forward
      let again = keep resume
      let traced =
        (scope {
          say "last"
          2
        })
        |> keep_after
          (scope {
            say "first"
            1
          })
          again
      relay traced 19
  }

main : Unit ->{} Unit
let main () =
  say (show (collect three))
  say (show (reversed three))
  let x =
    first (fun () -> scope {
      Scope.add_finalizer (task { say "scope closed" })
      Emit.emit 7
      say "not reached"
    })
  say (show x)
  let chosen =
    collect (fun () ->
      try
        Emit.emit (if Choose.choose () then 1 else 2)
        Emit.emit 3
      with
      | Choose.choose () -> resume true
    )
  say (show chosen)
  say (show (control_exit ()))
  say (show (forwarded_exit ()))
  say (show (control_normal ()))
  say (show (control_error_exit ()))
  say (show (control_unhandled ()))
  say (show (control_continue ()))
  say (show (control_local_loops ()))
  say (show (mutable_control ()))
  let twice =
    try (if Choose.choose () then 1 else 2) with
    | Choose.choose () -> resume true + resume false
  say (show twice)
