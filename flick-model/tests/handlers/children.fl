// A child reaches the handlers around where it started.
module App.Main exposing (main)

service Named =
  name : Unit ->{} String

effect Asker =
  ask : Unit ->{} String

by_record : Unit ->{Async} Unit
let by_record () = provide Named ({ name = fun () -> "record" }) {
  scope s { ignore (Fiber.spawn s (fun _ -> ()) (task { Platform.stdout_line (Named.name ()) })) }
}

by_arm : Unit ->{Async} Unit
let by_arm () =
  try
    scope s { ignore (Fiber.spawn s (fun _ -> ()) (task { Platform.stdout_line (Asker.ask ()) })) }
  with
  | Asker.ask () -> "arm"

main : Unit ->{Async; AppError} Unit
let main () =
  by_record ()
  by_arm ()
