package flick:plugin@0.2.0;

/// The types a declaration or a signature writes, as the compiler parsed
/// them, for a derive to read without parsing tokens again.
interface written {
  /// A type as a declaration or a signature writes it: its nodes, each after
  /// the nodes it refers to by index, the last the type itself.
  type written = list<written-node>;

  /// A node at `start`..`end` of the text that writes it.
  record written-node { kind: written-kind, start: u32, end: u32 }

  variant written-kind {
    /// A named type, maybe qualified, and its arguments.
    con(written-name),
    /// A type variable and its arguments.
    var(written-name),
    /// A record by label, `open` with a row `| r`.
    %record(written-record),
    %tuple(list<u32>),
    unit,
    /// `takes -> gives`, with the row of `->{row}`.
    arrow(written-arrow),
    /// A type with a capture qualifier, `t^c`.
    captured(u32),
    /// `forall a. …` or `C a => …`.
    generic,
    /// A row, a union, a hole: what no derive reads.
    other,
  }

  record written-name { name: string, args: list<u32> }
  record written-record { fields: list<tuple<string, u32>>, open: bool }
  record written-arrow { takes: u32, gives: u32, row: option<written-row> }
  record written-row { services: list<u32>, services-open: bool, errors: list<u32>, errors-open: bool }
}
