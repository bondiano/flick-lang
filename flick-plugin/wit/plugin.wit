package flick:plugin@0.9.0;

/// What a plugin and the compiler exchange.
interface types {
  /// A UTF-8 byte range in the body of a block.
  record span { start: u32, end: u32 }

  enum token-kind { ident, con, number, %string, keyword, punct }

  /// A token of the body, trivia left out.
  record token { kind: token-kind, span: span }

  /// Where a block stands: in an expression, whose code is an expression,
  /// or as a declaration of the module, whose code is declarations.
  enum place { expression, declaration }

  /// A block `head args { body }`, `head args` or, as a declaration, `head
  /// args rest`: the text from its first argument (or from its body, without
  /// arguments) to the closing `}` or its end, where the body starts in it
  /// (its length without one), and the tokens of the arguments, the body and
  /// the rest, `{` left out. `docs` are the `///` lines right above a
  /// declaration, each without `///` and one space, joined by newlines;
  /// `signature` is the signature right above it, and `module` the module
  /// the block is in.
  record block {
    head: string,
    text: string,
    body: u32,
    place: place,
    tokens: list<token>,
    docs: string,
    signature: option<signature-above>,
    module: string,
  }

  /// The signature `name : type` right above a declaration block, its spans
  /// counting from its own start. Code that has a type of it, `signed`,
  /// takes it from the module; without that it stays where it is.
  record signature-above { text: string, tokens: list<token> }

  enum hole-kind { expr, ty, pat, decl }

  /// User code in the body that the compiler parsed: an expression or a type.
  record hole { kind: hole-kind, span: span }

  /// The index of a node in its arena; a node refers only to nodes before it.
  type node-id = u32;

  record field { label: string, value: node-id }
  record apply { function: node-id, arguments: list<node-id> }
  record lambda { params: list<node-id>, body: node-id }
  record get { %record: node-id, label: string }
  record annot { expr: node-id, ty: node-id }
  record arrow { input: node-id, output: node-id }
  record con-pat { name: string, arguments: list<node-id> }

  variant expr {
    name(string),
    number(f64),
    text(string),
    boolean(bool),
    unit,
    apply(apply),
    lambda(lambda),
    %record(list<field>),
    get(get),
    items(list<node-id>),
    %tuple(list<node-id>),
    annot(annot),
    hole(span),
  }

  variant ty {
    name(string),
    apply(apply),
    %record(list<field>),
    function(arrow),
    /// A type-level string, as in `Record.Label "name"`.
    text(string),
    /// `_`: the type the checker infers.
    wildcard,
    hole(span),
    /// `forall a b. body`.
    forall(forall-ty),
    /// A row of types, as the errors `{NotFound, Conflict}`.
    row(list<node-id>),
    /// The user's type at this span of the block's signature.
    signed(span),
    /// `(A, B)`.
    %tuple(list<node-id>),
  }

  record forall-ty { vars: list<string>, body: node-id }

  variant pat {
    var(string),
    wildcard,
    con(con-pat),
    %record(list<field>),
    hole(span),
    /// `(a, b)`.
    %tuple(list<node-id>),
  }

  record let-decl { name: string, params: list<node-id>, ty: option<node-id>, body: node-id, %rec: bool }
  record signature { name: string, ty: node-id }
  record alias { name: string, params: list<string>, ty: node-id }
  /// A constructor of a type and the types of its fields.
  record %case { name: string, fields: list<node-id> }
  record adt { name: string, params: list<string>, cases: list<%case>, deriving: list<string> }
  record instance { context: list<node-id>, head: node-id, members: list<node-id> }
  /// A declaration and its documentation, lines joined by newlines.
  record doc { text: string, decl: node-id }

  /// A declaration of the module.
  variant decl {
    %let(let-decl),
    signature(signature),
    alias(alias),
    adt(adt),
    instance(instance),
    /// Declarations in order: the code of a block that gives several.
    group(list<node-id>),
    /// The user's declaration at this span.
    hole(span),
    doc(doc),
  }

  variant kind { expr(expr), ty(ty), pat(pat), decl(decl) }

  /// A node of generated code and the span of the body it stands for.
  record node { kind: kind, origin: span }

  record arena { nodes: list<node>, root: node-id }

  /// An error in a block; `code` is the plugin's own, such as `L001`, which
  /// the compiler shows under the plugin's package: `std/L001`.
  record diagnostic { message: string, span: span, code: option<string> }

  /// What an editor may insert at an offset of a block.
  record completion {
    label: string,
    detail: option<string>,
    documentation: option<string>,
    snippet: option<string>,
  }

  /// What an editor shows over a span of a block, as Markdown.
  record hover { markdown: string, span: span }

  enum highlight-kind { keyword, parameter }

  /// How an editor colors a span of a block that is not the user's code.
  record highlight { span: span, kind: highlight-kind }

  /// A piece of the layout of a block from its first argument (or its body)
  /// on: the plugin's words, a new line at the current indent, one level in
  /// or out for the lines after, or the user's code at a hole, which the
  /// compiler lays out. The compiler writes the head before it, `{` before
  /// a layout that starts in the body, and `}` after it.
  variant piece { text(string), line, indent, dedent, hole(hole) }

  /// A constructor of a derive's target and the types of its fields.
  record case-target { name: string, fields: list<span> }

  /// A type a class's derive makes an instance for: its declaration as a
  /// block, and what it declares at spans of that block; its name and
  /// constructors are qualified for a type of another module, which is not
  /// `local` and whose spans are no holes.
  record derive-target {
    decl: block,
    name: string,
    params: list<string>,
    cases: list<case-target>,
    alias: option<span>,
    refined: option<span>,
    local: bool,
  }
}

/// What the compiler offers a plugin while it expands a block.
interface compiler {
  use types.{hole, diagnostic};

  /// The longest expression of the body from `start` on, before `end`.
  parse-expr: func(start: u32, end: u32) -> result<hole, diagnostic>;
  /// The longest type of the body from `start` on, before `end`.
  parse-type: func(start: u32, end: u32) -> result<hole, diagnostic>;
  /// The longest pattern of the body from `start` on, before `end`.
  parse-pat: func(start: u32, end: u32) -> result<hole, diagnostic>;
  /// The declaration of the block from `start` on, before `end`.
  parse-decl: func(start: u32, end: u32) -> result<hole, diagnostic>;
  /// The body of the block from `start` on, before `end`, as after the `=`
  /// of a `let`: an expression, or on a line of its own the lines of a
  /// block at its column; its hole is an expression's.
  parse-body: func(start: u32, end: u32) -> result<hole, diagnostic>;
}

world plugin {
  import compiler;
  use types.{block, arena, diagnostic, completion, hover, highlight, piece, derive-target};

  /// What the plugin learns from all its blocks of a group, before any expands.
  export collect: func(blocks: list<block>) -> list<u8>;
  /// The code a block stands for, given what `collect` learned.
  export expand: func(block: block, state: list<u8>) -> result<arena, list<diagnostic>>;
  /// What an editor may insert at `offset` of the block.
  export complete: func(block: block, state: list<u8>, offset: u32) -> list<completion>;
  /// What an editor shows at `offset` of the block.
  export hover: func(block: block, state: list<u8>, offset: u32) -> option<hover>;
  /// How an editor colors the words of the block that are the plugin's.
  export highlight: func(block: block, state: list<u8>) -> list<highlight>;
  /// The layout of the block, the compiler parsing its holes; none keeps it
  /// as written.
  export format: func(block: block, state: list<u8>) -> option<list<piece>>;
  /// The instance of `class` for `target` as declarations; `args` is the
  /// `{ … }` after the class in `deriving`, `module` every type of the
  /// target's module.
  export derive: func(
    target: derive-target,
    class: string,
    args: option<block>,
    module: list<derive-target>,
    state: list<u8>,
  ) -> result<arena, list<diagnostic>>;
}
