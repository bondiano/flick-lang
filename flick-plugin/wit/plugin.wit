package flick:plugin@0.3.0;

/// What a plugin and the compiler exchange.
interface types {
  use written.{written, written-node, written-kind, written-name, written-record, written-arrow, written-row};

  /// A UTF-8 byte range in the body of a block.
  record span { start: u32, end: u32 }

  enum token-kind { ident, con, number, %string, keyword, punct }

  /// A token of the body, trivia left out.
  record token { kind: token-kind, span: span }

  /// Where a block stands: in an expression, whose code is an expression,
  /// or as a declaration of the module, whose code is declarations.
  enum place { expression, declaration }

  /// A block `head args { body }`, `head args` or, as a declaration, `head
  /// args rest`: the text from its first argument (or from its body, without
  /// arguments) to the closing `}` or its end, where the body starts in it
  /// (its length without one), and the tokens of the arguments, the body and
  /// the rest, `{` left out. `docs` are the `///` lines right above a
  /// declaration, each without `///` and one space, joined by newlines;
  /// `signature` is the signature right above it, and `module` the module
  /// the block is in.
  record block {
    head: string,
    text: string,
    body: u32,
    place: place,
    tokens: list<token>,
    docs: string,
    signature: option<signature-above>,
    module: string,
  }

  /// The signature `name : type` right above a declaration block, its spans
  /// counting from its own start. Code that has a type of it, `signed`,
  /// takes it from the module; without that it stays where it is.
  record signature-above { text: string, tokens: list<token>, ty: option<written> }

  enum hole-kind { expr, ty, pat, decl, lines }

  /// User code in the body that the compiler parsed: an expression or a type.
  record hole { kind: hole-kind, span: span }

  /// The index of a node in its arena; a node refers only to nodes before it.
  type node-id = u32;

  record field { label: string, value: node-id }
  record apply { function: node-id, arguments: list<node-id> }
  record lambda { params: list<node-id>, body: node-id }
  record get { %record: node-id, label: string }
  record annot { expr: node-id, ty: node-id }
  record arrow { input: node-id, output: node-id }
  record con-pat { name: string, arguments: list<node-id> }
  /// An arm of a `match`: its pattern, maybe a guard, and its value.
  record arm { pattern: node-id, guard: option<node-id>, body: node-id }
  record match-on { scrutinee: node-id, arms: list<arm> }
  record branches { condition: node-id, then: node-id, otherwise: node-id }
  record statements { items: list<node-id>, %result: node-id }

  record opened { module: string, child: option<string>, through: option<string>, body: node-id }

  variant expr {
    name(string),
    number(f64),
    text(string),
    boolean(bool),
    unit,
    apply(apply),
    lambda(lambda),
    %record(list<field>),
    get(get),
    items(list<node-id>),
    %tuple(list<node-id>),
    annot(annot),
    hole(span),
    /// The user's body, the lines under a call its arguments, one each.
    lines(span),
    /// `(a ++ b ++ …)`: texts or lists joined, at least two.
    concat(list<node-id>),
    /// `match scrutinee with | p when g -> e …`, at least one arm.
    %match(match-on),
    /// `if condition then then else otherwise`.
    %if(branches),
    /// Statements, then the value; only the body of a `fun` or a `let`. A
    /// statement is a local `let`, a signature, a hole of one, or an
    /// expression.
    block(statements),
    /// The body with a module open: its names are in sight there before
    /// the file's own. With `child`, a type, a call there gives a last
    /// parameter that is a list of it element by element; with `through`, a
    /// function, a value of its first parameter's type is applied through
    /// it. No source writes it.
    open(opened),
  }

  variant ty {
    name(string),
    apply(apply),
    %record(list<field>),
    function(arrow),
    /// A type-level string, as in `Record.Label "name"`.
    text(string),
    /// `_`: the type the checker infers.
    wildcard,
    hole(span),
    /// `forall a b. body`.
    forall(forall-ty),
    /// A row of types, as the errors `{NotFound, Conflict}`.
    row(list<node-id>),
    /// The user's type at this span of the block's signature.
    signed(span),
    /// `(A, B)`.
    %tuple(list<node-id>),
  }

  record forall-ty { vars: list<string>, body: node-id }

  variant pat {
    var(string),
    wildcard,
    con(con-pat),
    %record(list<field>),
    hole(span),
    /// `(a, b)`.
    %tuple(list<node-id>),
  }

  record let-decl { name: string, params: list<node-id>, ty: option<node-id>, body: node-id, %rec: bool }
  record signature { name: string, ty: node-id }
  record alias { name: string, params: list<string>, ty: node-id }
  /// A constructor of a type and the types of its fields.
  record %case { name: string, fields: list<node-id> }
  record adt { name: string, params: list<string>, cases: list<%case>, deriving: list<string>, unboxed: bool }
  record instance { context: list<node-id>, head: node-id, members: list<node-id> }
  /// A declaration and its documentation, lines joined by newlines.
  record doc { text: string, decl: node-id }

  record checked { by: string, decl: node-id }

  /// A declaration of the module.
  variant decl {
    %let(let-decl),
    signature(signature),
    alias(alias),
    adt(adt),
    instance(instance),
    /// Declarations in order: the code of a block that gives several.
    group(list<node-id>),
    /// The user's declaration at this span.
    hole(span),
    doc(doc),
    /// A function with the value that reads a constant given to it.
    checked(checked),
  }

  variant kind { expr(expr), ty(ty), pat(pat), decl(decl) }

  /// A node of generated code and the span of the body it stands for.
  record node { kind: kind, origin: span }

  record arena { nodes: list<node>, root: node-id }

  /// A file a build writes: its path in the output directory and its text.
  record artifact { path: string, contents: string }

  /// How bad a diagnostic is: an error fails the build.
  enum severity { error, warning, note }

  /// The text that replaces a span of the block.
  record edit { span: span, replacement: string }

  /// A change an editor offers for a diagnostic; a `safe` one is what
  /// `flick check --fix` applies.
  record fix { message: string, edits: list<edit>, safe: bool }

  /// What is wrong in a block; `code` is the plugin's own, such as `L001`,
  /// which the compiler shows under the plugin's package: `std/L001`. Only
  /// one with a code may be a warning or a note, and carry fixes.
  record diagnostic {
    message: string,
    span: span,
    code: option<string>,
    severity: severity,
    fixes: list<fix>,
  }

  /// What an editor may insert at an offset of a block.
  record completion {
    label: string,
    detail: option<string>,
    documentation: option<string>,
    snippet: option<string>,
  }

  /// What an editor shows over a span of a block, as Markdown.
  record hover { markdown: string, span: span }

  /// A type the checker found, as it shows it and qualified with aliases
  /// expanded; `exact` is none for one with errors or still unknown parts.
  /// `literal-of` is the exact base type of an enum, `String` or `Int`.
  record fact-type { shown: string, exact: option<string>, literal-of: option<string> }
  record fact-field { label: string, ty: fact-type }
  /// Original source structure, with the first nodes beyond the nesting limit.
  record nesting { span: span, depth: u32 }
  record structure { lines: u32, complexity: u32, nesting: list<nesting>, max-lines: u32, max-complexity: u32, max-nesting: u32 }
  /// The type of a `_` of a block's code, at the span its code gave it, and
  /// its fields when it is a closed record.
  record fact { span: span, ty: fact-type, fields: option<list<fact-field>> }

  /// A value the compiler folded where a program writes it: the constant a
  /// watched call is given.
  variant constant { number(f64), text(string), boolean(bool) }

  /// An argument of a watched call: where it is written, the type the
  /// checker found for it, the fields of a closed record, and the constant
  /// it folds to, if any.
  record argument {
    span: span,
    ty: fact-type,
    fields: option<list<fact-field>>,
    constant: option<constant>,
    /// Written as a `fun`, maybe in parentheses.
    lambda: bool,
  }

  record reference-fact { module: string, name: string }
  record unary-fact { op: string, value: u32 }
  record binary-fact { op: string, left: u32, right: u32 }
  record if-fact { condition: u32, then: u32, otherwise: u32 }
  record lambda-fact { parameter: string, body: u32 }
  variant expression-kind {
    constant(constant), big-int(string), reference(reference-fact), variable(string),
    unary(unary-fact), binary(binary-fact), %if(if-fact), lambda(lambda-fact), unknown,
  }
  record expression-fact { nodes: list<expression-kind>, root: u32 }
  /// Read-only syntax; the plugin owns interpretation.
  variant refinement { literals(list<constant>), predicate(expression-fact) }

  /// Read-only facts about the top-level binding enclosing a reference.
  record binding {
    module: string,
    name: option<string>,
    span: span,
    constrained: bool,
    in-function: bool,
    applied: u32,
    /// What the binding's function gives at last, where its signature names
    /// the watched name.
    gives: option<fact-type>,
  }

  /// A function around a place: the services its arrow names, and whether
  /// its row is open to more.
  record enclosing { services: list<string>, open: bool }

  /// A value a tag marks, where a module names it inside a function: the
  /// tag, the value as the module writes it, the value of the library it
  /// is or reaches, and the functions around the place, innermost first,
  /// up to the nearest `task`.
  record tagged { tag: string, named: string, reaches: string, inside: list<enclosing> }

  /// Code that asks for more than the function expected at its place
  /// allows, where that function's row names a watched service: the
  /// function, what is not allowed as the compiler words it, the services
  /// as shown and by qualified name, and the errors. An error of
  /// `check-calls` at the place's span stands for the compiler's own.
  record lacking {
    allowed: enclosing,
    what: string,
    services: list<string>,
    labels: list<string>,
    errors: list<string>,
  }

  /// A place that calls a name the plugin's package watches: the module and
  /// the name as the compiler knows them, where the call is written, its
  /// arguments, and, for a `T$parse`, how `T` checks its value. Every span
  /// is a byte offset in the text of the module's own file, and the
  /// diagnostics of `check-calls` are at spans of it too.
  record call-site {
    module: string,
    name: string,
    span: span,
    arguments: list<argument>,
    refinement: option<refinement>,
    binding: option<binding>,
    /// The call is in code a plugin wrote, not in the module's own text.
    generated: bool,
    /// What marks the value named here, for a tag the package watches.
    tagged: option<tagged>,
    /// What the code here asks for that a function naming the watched
    /// service does not allow.
    lacking: option<lacking>,
  }

  enum highlight-kind { keyword, parameter }

  /// How an editor colors a span of a block that is not the user's code.
  record highlight { span: span, kind: highlight-kind }

  /// A piece of the layout of a block from its first argument (or its body)
  /// on: the plugin's words, a new line at the current indent, one level in
  /// or out for the lines after, or the user's code at a hole, which the
  /// compiler lays out. The compiler writes the head before it, `{` before
  /// a layout that starts in the body, and `}` after it.
  variant piece { text(string), line, indent, dedent, hole(hole) }

  /// Why a plugin does not reach what it asks for: the project grants it
  /// no such thing, the answer is in no snapshot of an offline run, or
  /// reaching it failed.
  variant reach-error { denied(string), offline(string), failed(string) }

  /// The names of values or of types.
  enum namespace { value, %type }
  /// What a plugin tells its blocks of other groups and modules about a
  /// name of the module `module`.
  record published { module: string, name: string, data: list<u8> }
  /// A request over HTTP, and its answer.
  record request { method: string, url: string, headers: list<tuple<string, string>>, body: list<u8> }
  record response { status: u16, body: list<u8> }

  /// A constructor of a derive's target, the types of its fields and the
  /// literal of an enum's constructor; whether, as a constructor of a GADT,
  /// it names the type it builds (`refined`) or holds dictionaries
  /// (`constrained`).
  record case-target {
    name: string,
    fields: list<written>,
    literal: option<span>,
    refined: bool,
    constrained: bool,
  }

  /// A type a class's derive makes an instance for: its declaration as a
  /// block, and what it declares at spans of that block; its name and
  /// constructors are qualified for a type of another module, which is not
  /// `local` and whose spans are no holes.
  record derive-target {
    decl: block,
    name: string,
    params: list<string>,
    /// The kind each parameter is written with, empty without one.
    kinds: list<string>,
    cases: list<case-target>,
    alias: option<written>,
    wraps: option<written>,
    /// The words before its name: `type`, `alias`, `opaque`, `unboxed`, …
    modifiers: list<string>,
    /// The classes its `deriving` names, as written.
    deriving: list<string>,
    local: bool,
  }
}

world plugin {
  import compiler;
  use types.{block, arena, diagnostic, completion, hover, highlight, piece, derive-target, fact, call-site, published, artifact, structure};

  /// What the plugin learns from all its blocks of a group, before any expands.
  export collect: func(blocks: list<block>) -> list<u8>;
  /// What the blocks of other groups and modules may ask of the state of a
  /// group, before any block expands.
  export publish: func(state: list<u8>) -> list<published>;
  /// The module a file at `path` from the project's root stands for, its
  /// contents `bytes`: declarations, at spans of the file. Only a plugin whose
  /// package says `load = ["ext"]` gets the files of that extension.
  export load: func(path: string, bytes: list<u8>) -> result<arena, list<diagnostic>>;
  /// The IR of the project's modules, a `Program` of the compiler's IR as
  /// CBOR, without the built-in modules, after the checks of effects and
  /// before the build optimizes it; the program the build compiles instead,
  /// which it checks for form and nothing else. Only a plugin whose package
  /// says `hooks = ["ir"]` gets it, in `flick build`, `run` and `test`.
  export transform: func(program: list<u8>) -> result<list<u8>, list<diagnostic>>;
  /// The files of `flick build` after it wrote them: their paths and texts,
  /// each `.js` with its `.map` when the build writes maps, and the `.iface`
  /// that sums up the types; what the build writes instead. Only a plugin
  /// whose package says `hooks = ["emit"]` gets them.
  export emit: func(artifacts: list<artifact>) -> result<list<artifact>, list<diagnostic>>;
  /// The code a block stands for, given what `collect` learned.
  export expand: func(block: block, state: list<u8>) -> result<arena, list<diagnostic>>;
  /// What an editor may insert at `offset` of the block; `member` says the
  /// user typed `name.` before `offset`, the `.` not in the block. The
  /// compiler answers `published` and `literal-of` as while it expands.
  export complete: func(block: block, state: list<u8>, offset: u32, member: bool) -> list<completion>;
  /// What an editor shows at `offset` of the block; `facts` are the types
  /// of the `_` of its code, as `check` gets them, once it checked. An
  /// offset past the end of the block is its head, before the block.
  export hover: func(block: block, state: list<u8>, offset: u32, facts: list<fact>) -> option<hover>;
  /// How an editor colors the words of the block that are the plugin's.
  export highlight: func(block: block, state: list<u8>) -> list<highlight>;
  /// The layout of the block, the compiler parsing its holes; none keeps it
  /// as written.
  export format: func(block: block, state: list<u8>) -> option<list<piece>>;
  /// The instance of `class` for `target` as declarations; `args` is the
  /// `{ … }` after the class in `deriving`, `module` every type of the
  /// target's module.
  export derive: func(
    target: derive-target,
    class: string,
    args: option<block>,
    module: list<derive-target>,
    state: list<u8>,
  ) -> result<arena, list<diagnostic>>;
  /// What is wrong with `block` that only the types of its code show, from
  /// the types of the `_` of its code; it only adds diagnostics.
  export check: func(block: block, state: list<u8>, facts: list<fact>) -> list<diagnostic>;
  /// Source structure without generated wrappers, including project thresholds.
  export check-structure: func(block: block, facts: structure) -> list<diagnostic>;
  /// What is wrong with the places of one module that call the names the
  /// plugin's package declares in `watch`, given the types the checker
  /// found there; `state` is what `collect` learned from that module's
  /// blocks, empty where it has none. It only adds diagnostics.
  export check-calls: func(calls: list<call-site>, state: list<u8>) -> list<diagnostic>;
}
