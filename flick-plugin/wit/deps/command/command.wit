package flick:command@0.1.0;

/// Commands a backend or a library plugin adds to `flick`. A command is a
/// pure call: it returns a plan of files, host tool steps and diagnostics,
/// which the host checks and carries out; it never touches the filesystem
/// or starts a process itself.
interface types {
    enum value-kind { flag, text, path }
    /// A positional argument or an option (`--name`) of a command.
    record parameter {
        name: string,
        kind: value-kind,
        /// It may be given more than once, or take the rest of the words.
        multiple: bool,
        required: bool,
        help: string,
    }
    /// A plan command runs once; a session command answers requests on
    /// stdin until it ends, through `open`, `handle` and `close`.
    enum style { plan, session }
    record descriptor {
        /// The words of the command, as `ffi import`.
        name: string,
        summary: string,
        positionals: list<parameter>,
        options: list<parameter>,
        /// The files the host passes in `invocation.inputs`, relative to the
        /// project's root: a path, `$name` for the paths a parameter of kind
        /// `path` gives, or `$sources` for the project's source root. A
        /// directory stands for the regular files under it.
        inputs: list<string>,
        /// What the plan's tool steps may read in place, named as `inputs`.
        reads: list<string>,
        /// What its plan may write, named as `inputs`.
        writes: list<string>,
        style: style,
    }
    record argument { name: string, values: list<string> }
    /// A host tool the project allows the contributor, pinned by the host.
    /// One it allows that the host did not find has an empty version and
    /// digest, and no step may run it.
    record tool { id: string, version: string, sha256: string }
    /// A package of the contributor's ecosystem that the project or a
    /// library of its closure asks for in `[target.<name>.dependencies]`;
    /// `by` names the library, none the project.
    record dependency { name: string, version: string, by: option<string> }
    record file { path: string, bytes: list<u8>, executable: bool }
    record invocation {
        name: string,
        /// Each `path` value relative to the project's root, `/`-separated.
        arguments: list<argument>,
        /// The project's source root, relative to its root.
        sources: string,
        /// The files the descriptor's `inputs` name, as they are now.
        inputs: list<file>,
        tools: list<tool>,
        /// What the closure asks of a backend's ecosystem, for the
        /// dependency commands it implements; empty for any other command.
        dependencies: list<dependency>,
    }
    record variable { name: string, value: string }
    /// A run of a host tool in a directory of its own, holding the plan's
    /// files `inputs` names; it gives back the files `outputs` names, which
    /// the host writes with the plan's, or hands to `resume`.
    ///
    /// An `in-place` step runs in the project's root instead, once the
    /// other steps have run and the files so far are published. It reads
    /// and inputs nothing of the plan; `outputs` names what it changes,
    /// each within the descriptor's `writes`, and nothing is read back. The
    /// host cannot undo what it changes: a failure leaves that as it is.
    record tool-step {
        id: string,
        tool: tool,
        arguments: list<string>,
        environment: list<variable>,
        inputs: list<string>,
        /// Paths of the project the step reads in place, within the
        /// descriptor's `reads`; each appears at the same relative path in
        /// the step's directory, linked rather than copied.
        reads: list<string>,
        outputs: list<string>,
        in-place: bool,
    }
    /// An in-memory Flick source module overlaid on the project's source root
    /// for a `run-flick` step; never written to the project tree.
    record flick-module {
        /// Valid Flick module name, as `FlickSchemaExport` or `DocExample`.
        name: string,
        /// UTF-8 Flick source text.
        source: string,
    }
    /// A Flick program compiled and run on the project's selected backend in
    /// an isolated temporary generation, without writing to the project tree.
    record run-flick-step {
        /// Unique identifier within the plan's steps.
        id: string,
        /// Module whose `main` runs: an overlay in `modules` or an existing
        /// module of the project.
        entry: string,
        /// In-memory `.fl` modules overlaid on `$sources` during compilation.
        modules: list<flick-module>,
        /// Arguments passed to the program (`Platform.args`).
        arguments: list<string>,
        /// Optional output path receiving captured stdout: handed to `resume`
        /// when `resume` is set, otherwise published under `descriptor.writes`.
        output: option<string>,
        /// Optional span in `invocation.inputs` used to anchor compiler or
        /// runtime diagnostics originating inside synthetic overlay `modules`.
        origin: option<span>,
    }
    variant step {
        tool(tool-step),
        run-flick(run-flick-step),
    }
    enum severity { error, warning, note }
    /// Bytes `start` to `end` of the file `path` of `invocation.inputs`.
    record span { path: string, start: u32, end: u32 }
    record diagnostic {
        code: string,
        severity: severity,
        message: string,
        notes: list<string>,
        span: option<span>,
        /// What the user can do about it.
        help: option<string>,
    }
    record plan {
        files: list<file>,
        steps: list<step>,
        diagnostics: list<diagnostic>,
        /// What the command prints.
        stdout: list<u8>,
        /// The state `resume` gets once the steps have run. The host then
        /// hands it their outputs instead of writing them, and writes the
        /// files of every plan together at the end.
        resume: option<list<u8>>,
        /// What `resume` also gets, answered.
        needs: list<need>,
    }
    /// What the host reads for a module: `text` stands for its file, the
    /// file as saved when none. `path` is absolute or relative to the root.
    record source { path: string, text: option<string> }
    /// What a command asks the host to compute before it goes on.
    variant need {
        /// The TypeScript projection of a module, analyzed as the language
        /// server analyzes it. It imports the other modules of its project
        /// as their `.fl` files and the rest from `.flick/projections` of
        /// its project, which the host writes.
        typescript(source),
    }
    /// Bytes `ts-start` to `ts-end` of a projection stand for bytes
    /// `fl-start` to `fl-end` of its source; `exact` when they are the
    /// same name.
    record ts-span { ts-start: u32, ts-end: u32, fl-start: u32, fl-end: u32, exact: bool }
    record typescript-module {
        /// The module's file, absolute.
        path: string,
        /// The text it was analyzed with.
        source: string,
        text: string,
        spans: list<ts-span>,
    }
    /// The host's answer to a need, in the order of the needs.
    variant answer {
        /// None when the file is no module of a project.
        typescript(option<typescript-module>),
    }
    /// The answer to one request of a session and its state after it. With
    /// `needs`, the host calls `handle` again with the same request, this
    /// state and their answers.
    record handled { state: list<u8>, response: option<list<u8>>, needs: list<need> }
    /// How a session command starts: as a session, or as a plan it runs
    /// once instead.
    variant opened { session(list<u8>), plan(plan) }
    /// A project template a backend or plugin contributes for `flick new` and `flick init`.
    record template-descriptor {
        name: string,
        summary: string,
    }
    /// Input for scaffolding a project from a template.
    record template-request {
        /// Template name from `templates`.
        template: string,
        /// Normalized project/package name derived from the target directory.
        name: string,
        /// Version of the `flick` compiler running `new`/`init`.
        compiler: string,
        /// True for `flick init`, false for `flick new`.
        init: bool,
    }
}

interface command {
    use types.{descriptor, invocation, plan, handled, diagnostic, file, answer, opened, template-descriptor, template-request};
    describe: func() -> list<descriptor>;
    run: func(invocation: invocation) -> result<plan, list<diagnostic>>;
    /// The rest of a plan whose steps have run, with their outputs.
    resume: func(state: list<u8>, outputs: list<file>, answers: list<answer>) -> result<plan, list<diagnostic>>;
    /// The state of a new session, or the plan it runs instead.
    open: func(invocation: invocation) -> result<opened, list<diagnostic>>;
    /// A request of the session, as the bytes of one message.
    handle: func(state: list<u8>, request: list<u8>, answers: list<answer>) -> result<handled, string>;
    /// The plan of a session that ends.
    close: func(state: list<u8>) -> plan;
    /// Project templates the contributor provides for `flick new` and `flick init`.
    templates: func() -> list<template-descriptor>;
    /// The plan of files (and optional stdout guidance) for a project from `request`.
    scaffold: func(request: template-request) -> result<plan, list<diagnostic>>;
}
