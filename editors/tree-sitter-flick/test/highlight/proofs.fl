proof same where same_type a a = refl
// <- keyword
//    ^ function

let proof = trans proof h
//  ^ function
//                ^ variable

proof right_identity (v : Option a)
where equal (flat_map pure v) v =
  match v with
  | None -> refl
  | Some x -> refl

class Functor (f : Type -> Type) =
  map : (a -> b) -> f a -> f b
  law identity (v : f a) where equal (map identity v) v
//^ keyword
//    ^ function

dec : Int -> Int
let dec x
where
  require (x > 0)
//^ keyword
  ensure (fun y -> y < x)
//^ keyword
=
  x - 1

inc : Int -> Int
let inc x where ensure (fun y -> y > x) = x + 1
//              ^ keyword

