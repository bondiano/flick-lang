{
  "name": "flick",
  "displayName": "Flick",
  "description": "Flick language support",
  "version": "0.2.0",
  "publisher": "bondiano",
  "license": "MIT",
  "private": true,
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/bondiano/flick-lang"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "flick",
        "aliases": [
          "Flick",
          "flick"
        ],
        "extensions": [
          ".fl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "flick",
        "scopeName": "source.flick",
        "path": "./syntaxes/flick.tmLanguage.json"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "flick.proofGoals",
          "name": "Proof Goals",
          "contextualTitle": "Flick",
          "visibility": "collapsed"
        }
      ]
    },
    "configurationDefaults": {
      "[flick]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.detectIndentation": false,
        "editor.formatOnSave": true,
        "editor.semanticHighlighting.enabled": true,
        "editor.defaultFormatter": "bondiano.flick"
      }
    },
    "commands": [
      {
        "command": "flick.restartServer",
        "title": "Restart Language Server",
        "category": "Flick"
      },
      {
        "command": "flick.showOutput",
        "title": "Show Language Server Output",
        "category": "Flick"
      },
      {
        "command": "flick.searchProof",
        "title": "Find Proof",
        "category": "Flick",
        "enablement": "editorLangId == flick"
      }
    ],
    "configuration": {
      "title": "Flick",
      "properties": {
        "flick.path": {
          "type": "string",
          "default": "flick",
          "scope": "window",
          "description": "The `flick` executable that serves `flick lsp --stdio`."
        },
        "flick.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "Traces the communication between VS Code and the Flick language server."
        }
      }
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:flick"
  ],
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "package": "node scripts/package.mjs",
    "test": "node --test scripts/*.test.mjs",
    "vscode:prepublish": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "11.0.0"
  }
}
