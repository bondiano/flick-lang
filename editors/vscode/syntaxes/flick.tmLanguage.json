{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Flick",
  "scopeName": "source.flick",
  "fileTypes": ["fl"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#cli" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#attributes" },
    { "include": "#effect-row" },
    { "include": "#definitions" },
    { "include": "#keywords" },
    { "include": "#names" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.documentation.flick", "match": "///(?!/).*$" },
        { "name": "comment.line.double-slash.flick", "match": "//.*$" },
        { "include": "#block-comment" }
      ]
    },
    "block-comment": {
      "name": "comment.block.flick",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [{ "include": "#block-comment" }]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.flick",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [{ "include": "#escapes" }]
        },
        {
          "name": "string.quoted.other.raw.flick",
          "begin": "\\br(#*)\"",
          "end": "\"\\1"
        },
        {
          "name": "string.quoted.double.flick",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [{ "include": "#interpolation" }, { "include": "#escapes" }]
        }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.flick",
      "begin": "\\\\\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.flick" } },
      "end": "\\}|$",
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.flick" } },
      "contentName": "meta.embedded.line.flick",
      "patterns": [{ "include": "#interpolation-braces" }, { "include": "$self" }]
    },
    "interpolation-braces": {
      "begin": "\\{",
      "end": "\\}|$",
      "patterns": [{ "include": "#interpolation-braces" }, { "include": "$self" }]
    },
    "escapes": {
      "patterns": [
        { "name": "constant.character.escape.flick", "match": "\\\\(?:[ntr\\\\\"0]|u\\{[0-9a-fA-F]{1,6}\\})" },
        { "name": "invalid.illegal.escape.flick", "match": "\\\\." }
      ]
    },
    "numbers": {
      "name": "constant.numeric.flick",
      "match": "\\b(?:(?:0[xX][0-9a-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+)(?:n|[iu](?:8|16|32|64))?|[0-9][0-9_]*(?:\\.[0-9][0-9_]*(?:[eE][+-]?[0-9_]+)?|[eE][+-]?[0-9_]+)(?:f32)?|[0-9][0-9_]*(?:n|[iu](?:8|16|32|64)|f32)?)\\b"
    },
    "cli": {
      "begin": "(?<![.\\w])(cli)\\b(?=\\s+(?:r#*\"|\"))",
      "beginCaptures": { "1": { "name": "keyword.other.flick" } },
      "end": "(?<=\\})",
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            {
              "match": "(?:^\\s*|(?<=[{;])\\s*)(flag|arg)\\s+([a-z_][A-Za-z0-9_]*)",
              "captures": {
                "1": { "name": "keyword.other.flick" },
                "2": { "name": "variable.parameter.flick" }
              }
            },
            {
              "match": "(?:^\\s*|(?<=[{;])\\s*)(description|subcommand|handle)\\b(?!\\s*[=:])",
              "captures": { "1": { "name": "keyword.other.flick" } }
            },
            { "include": "#braces" },
            { "include": "$self" }
          ]
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [{ "include": "$self" }, { "include": "#braces" }]
    },
    "attributes": {
      "patterns": [
        {
          "match": "(@native)[ \\t]+(global|inline)\\b",
          "captures": {
            "1": { "name": "entity.other.attribute-name.flick" },
            "2": { "name": "keyword.other.flick" }
          }
        },
        {
          "comment": "`@lang int`: an attribute of the declaration that follows",
          "name": "entity.other.attribute-name.flick",
          "match": "@[a-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "effect-row": {
      "begin": "(->)(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.operator.flick" },
        "2": { "name": "punctuation.definition.effect-row.begin.flick" }
      },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.definition.effect-row.end.flick" } },
      "contentName": "meta.effect-row.needs.flick",
      "patterns": [
        {
          "begin": ";",
          "beginCaptures": { "0": { "name": "punctuation.separator.flick" } },
          "end": "(?=\\})",
          "contentName": "meta.effect-row.fails.flick",
          "patterns": [{ "include": "#comments" }, { "include": "#row-item" }]
        },
        { "include": "#comments" },
        { "include": "#row-item" }
      ]
    },
    "row-item": {
      "patterns": [
        { "include": "#effect-row" },
        { "begin": "\\{", "end": "\\}", "patterns": [{ "include": "#row-item" }] },
        { "include": "#names" },
        { "include": "#operators" }
      ]
    },
    "definitions": {
      "patterns": [
        {
          "name": "entity.name.function.flick",
          "match": "(?<![.\\w])await\\b(?=[ \\t]*:(?!:))"
        },
        {
          "match": "(?<![.\\w])(let)\\s+(mut)\\s+([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.flick" },
            "2": { "name": "keyword.other.flick" },
            "3": { "name": "variable.other.flick" }
          }
        },
        {
          "match": "(?<![.\\w])(let)\\s+(?:(rec|assert)\\s+)?([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.flick" },
            "2": { "name": "keyword.other.flick" },
            "3": { "name": "entity.name.function.flick" }
          }
        },
        {
          "match": "^([a-z_][A-Za-z0-9_]*)\\s*(:)(?!:)",
          "captures": {
            "1": { "name": "entity.name.function.flick" },
            "2": { "name": "keyword.operator.flick" }
          }
        },
        {
          "match": "(?<![.\\w])(foreign)[ \\t]+(module)[ \\t]+(inline)\\b",
          "captures": {
            "1": { "name": "keyword.other.flick" },
            "2": { "name": "keyword.other.flick" },
            "3": { "name": "keyword.other.flick" }
          }
        },
        {
          "match": "(?<![.\\w])(foreign)\\s+(?:(pure|effect|blocked|sync|async)\\s+)?([a-z_][A-Za-z0-9_]*)(?=\\s+(?:from\\b|\"))",
          "captures": {
            "1": { "name": "keyword.other.flick" },
            "2": { "name": "keyword.other.flick" },
            "3": { "name": "entity.name.function.flick" }
          }
        },
        {
          "comment": "`plugin head` in the `exposing` of an import",
          "match": "(?<![.\\w])(plugin)\\s+([a-z_][A-Za-z0-9_]*)(?=\\s*[,)])",
          "captures": {
            "1": { "name": "keyword.other.flick" },
            "2": { "name": "entity.name.function.macro.flick" }
          }
        },
        {
          "match": "^[ \\t]*(server)[ \\t]+(fn)\\b",
          "captures": {
            "1": { "name": "keyword.other.flick" },
            "2": { "name": "keyword.other.flick" }
          }
        },
        {
          "comment": "a case of the test DSL with `timeout millis` after its name",
          "match": "^[ \\t]*(suite|test)(?:(\\.)(skip|only))?[ \\t]+(?:(parallel)[ \\t]+)?(\"(?:[^\"\\\\]|\\\\.)*\")[ \\t]+(timeout)\\b",
          "captures": {
            "1": { "name": "keyword.other.flick" },
            "2": { "name": "punctuation.accessor.flick" },
            "3": { "name": "keyword.other.flick" },
            "4": { "name": "keyword.other.flick" },
            "5": { "name": "string.quoted.double.flick" },
            "6": { "name": "keyword.other.flick" }
          }
        },
        {
          "comment": "`before_all`, `before_each`, `after_each` and `after_all { … }` at the start of a line: a hook of a suite of the test DSL",
          "match": "^[ \\t]*(before_all|before_each|after_each|after_all)(?=[ \\t]*\\{)",
          "captures": {
            "1": { "name": "keyword.other.flick" }
          }
        },
        {
          "comment": "`suite \"name\"` and `test \"name\"`, maybe `.skip` or `.only` and `parallel`, at the start of a line: a case of the test DSL",
          "match": "^[ \\t]*(suite|test)(?:(\\.)(skip|only))?(?:[ \\t]+(parallel))?(?=[ \\t]+\")",
          "captures": {
            "1": { "name": "keyword.other.flick" },
            "2": { "name": "punctuation.accessor.flick" },
            "3": { "name": "keyword.other.flick" },
            "4": { "name": "keyword.other.flick" }
          }
        },
        {
          "comment": "`test.each` at the start of a line: the cases of a test's rows",
          "match": "^[ \\t]*(test)(\\.)(each)\\b",
          "captures": {
            "1": { "name": "keyword.other.flick" },
            "2": { "name": "punctuation.accessor.flick" },
            "3": { "name": "keyword.other.flick" }
          }
        },
        {
          "comment": "`fixture name =`, maybe `fixture shared` or `fixture shared concurrent`, at the start of a line: a fixture of a suite of the test DSL",
          "match": "^[ \\t]*(fixture)(?:[ \\t]+(shared))?(?:[ \\t]+(concurrent))?(?=[ \\t]+[a-z_][A-Za-z0-9_]*[ \\t]*=(?!=))",
          "captures": {
            "1": { "name": "keyword.other.flick" },
            "2": { "name": "keyword.other.flick" },
            "3": { "name": "keyword.other.flick" }
          }
        },
        {
          "match": "^[ \\t]*(component)[ \\t]+([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.flick" },
            "2": { "name": "entity.name.function.flick" }
          }
        },
        {
          "comment": "`require (` and `ensure (` at the start of a line, or right after `where`, are entries of a function's contract; elsewhere the words are names",
          "match": "(?:^[ \\t]*|\\bwhere[ \\t]+)(require|ensure)(?=[ \\t]*\\()",
          "captures": {
            "1": { "name": "keyword.other.flick" }
          }
        },
        {
          "comment": "`proof name` at the start of a line declares a proof, `law name` a law of a class; elsewhere the words are names",
          "match": "^[ \\t]*(proof|law)[ \\t]+([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.flick" },
            "2": { "name": "entity.name.function.flick" }
          }
        },
        {
          "match": "(?<![.\\w])(type)[ \\t]+(alias)\\b(?=[ \\t]+[A-Z][A-Za-z0-9_]*\\b)",
          "captures": {
            "1": { "name": "keyword.other.flick" },
            "2": { "name": "keyword.other.flick" }
          }
        },
        {
          "match": "(?<![.\\w])(?:(opaque)[ \\t]+)?(unboxed|untagged)\\b(?=[ \\t]+type\\b)",
          "captures": {
            "1": { "name": "keyword.other.flick" },
            "2": { "name": "keyword.other.flick" }
          }
        },
        {
          "match": "(?<![.\\w])(from)[ \\t]+(global|inline)\\b",
          "captures": {
            "1": { "name": "keyword.other.flick" },
            "2": { "name": "keyword.other.flick" }
          }
        },
        {
          "comment": "foreign metadata `catch mapping` on an indented line",
          "match": "^[ \\t]+(catch)(?=[ \\t]+[A-Za-z_])",
          "captures": {
            "1": { "name": "variable.other.flick" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "constant.language.boolean.flick", "match": "(?<![.\\w])(?:true|false)\\b" },
        { "name": "keyword.control.flick", "match": "(?<![.\\w])(?:(?:loop|defer|errdefer|result)\\b(?=[ \\t]*\\{)|while\\b(?=[^,;\\r\\n]*\\bdo\\b))" },
        {
          "match": "(?<!\\|)(\\|)[ \\t]*(return)\\b(?=[ \\t]+(?!->|when\\b|\\|)[^\\r\\n]*->)",
          "captures": {
            "1": { "name": "keyword.operator.flick" },
            "2": { "name": "keyword.control.flick" }
          }
        },
        { "name": "keyword.control.flick", "match": "(?<![.\\w])catch\\b(?![ \\t]*(?:=(?!=|>)|:(?!:)))" },
        { "name": "keyword.control.flick", "match": "(?<![.\\w])(?:match|with|try|if|then|else|when|await|lazy|in|for|yield|do|break|continue)\\b" },
        { "name": "keyword.operator.word.flick", "match": "(?<![.\\w])(?:not\\b|orelse\\b(?![ \\t]*(?:=(?!=|>)|:(?!:))))" },
        { "name": "keyword.other.flick", "match": "(?<![.\\w])private\\b(?=[ \\t]+module\\b)" },
        { "name": "keyword.other.flick", "match": "(?<![.\\w])and\\b(?=[ \\t]+type\\b|[^;\\r\\n]*<-)" },
        { "name": "keyword.other.flick", "match": "(?<![.\\w])effect\\b(?=[ \\t]+[A-Z][A-Za-z0-9_]*\\b)" },
        { "name": "keyword.other.flick", "match": "^[ \\t]*(?:tail|abort|control)\\b(?=[ \\t]+[a-z_][A-Za-z0-9_]*[ \\t]*:(?!:))" },
        { "name": "keyword.other.flick", "match": "(?<![.\\w])exists\\b(?=[ \\t]+[A-Z][A-Za-z0-9_]*[ \\t]*:(?!:))" },
        { "name": "keyword.other.flick", "match": "(?<![.\\w])pack\\b(?=[ \\t]+[A-Z][A-Za-z0-9_.]*[ \\t]+as\\b)" },
        { "name": "keyword.other.flick", "match": "(?<![.\\w])unpack\\b(?=[^\\r\\n]*[ \\t]+as[ \\t]+[A-Z][A-Za-z0-9_]*\\b)" },
        { "name": "keyword.other.flick", "match": "(?<![.\\w])sql\\b(?=(?:[ \\t]+(?:[A-Za-z_][A-Za-z0-9_.]*|\"[^\"]*\"|\\d+|\\([^()\\r\\n]*\\)))*[ \\t]*\\{)" },
        { "name": "keyword.other.flick", "match": "(?<![.\\w])codec\\b(?=(?:[ \\t]+(?:[A-Za-z_][A-Za-z0-9_.]*|\\([^()\\r\\n]*\\)))+[ \\t]*\\{)" },
        {
          "name": "keyword.other.flick",
          "match": "(?<![.\\w])(?:module|exposing|import|as|let|mut|rec|assert|fun|task|scope|provide|ignore|todo|echo|type|opaque|refined|where|kind|error|service|class|instance|deriving|foreign|from|forall|none|ui)\\b"
        }
      ]
    },
    "names": {
      "patterns": [
        { "name": "entity.name.label.flick", "match": "'[a-z_][A-Za-z0-9_]*\\b" },
        { "name": "entity.name.type.flick", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" },
        { "name": "variable.other.member.flick", "match": "(?<!\\.\\.)(?<=\\.)[a-z_][A-Za-z0-9_]*\\b" },
        { "name": "variable.other.flick", "match": "\\b[a-z_][A-Za-z0-9_]*\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "punctuation.separator.flick", "match": "[,;]" },
        { "name": "keyword.operator.flick", "match": "\\.\\.\\.|\\.\\.<|\\.\\.|->|<-|=>|==|\\|>|<\\||>>|<<|\\|\\||&&|!=|!|<=|>=|\\+\\+|\\*\\*|[:.=|<>+\\-*/%^?]" }
      ]
    }
  }
}
