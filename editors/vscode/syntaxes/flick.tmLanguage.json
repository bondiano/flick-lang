{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Flick",
  "scopeName": "source.flick",
  "fileTypes": ["fl"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#cli" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#attributes" },
    { "include": "#effect-row" },
    { "include": "#definitions" },
    { "include": "#keywords" },
    { "include": "#names" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.documentation.flick", "match": "///(?!/).*$" },
        { "name": "comment.line.double-slash.flick", "match": "//.*$" },
        { "include": "#block-comment" }
      ]
    },
    "block-comment": {
      "name": "comment.block.flick",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [{ "include": "#block-comment" }]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.flick",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [{ "include": "#escapes" }]
        },
        {
          "name": "string.quoted.other.raw.flick",
          "begin": "\\br(#*)\"",
          "end": "\"\\1"
        },
        {
          "name": "string.quoted.double.flick",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [{ "include": "#interpolation" }, { "include": "#escapes" }]
        }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.flick",
      "begin": "\\\\\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.flick" } },
      "end": "\\}|$",
      "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.flick" } },
      "contentName": "source.flick.embedded",
      "patterns": [{ "include": "#interpolation-braces" }, { "include": "$self" }]
    },
    "interpolation-braces": {
      "begin": "\\{",
      "end": "\\}|$",
      "patterns": [{ "include": "#interpolation-braces" }, { "include": "$self" }]
    },
    "escapes": {
      "patterns": [
        { "name": "constant.character.escape.flick", "match": "\\\\(?:[ntr\\\\\"0]|u\\{[0-9a-fA-F]{1,6}\\})" },
        { "name": "invalid.illegal.escape.flick", "match": "\\\\." }
      ]
    },
    "numbers": {
      "name": "constant.numeric.flick",
      "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:[eE][+-]?[0-9_]+)?)n?\\b"
    },
    "cli": {
      "begin": "(?<![.\\w])(cli)\\b(?=\\s+(?:r#*\"|\"))",
      "beginCaptures": { "1": { "name": "keyword.other.flick" } },
      "end": "(?<=\\})",
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            {
              "match": "(?:^\\s*|(?<=[{;])\\s*)(flag|arg)\\s+([a-z_][A-Za-z0-9_]*)",
              "captures": {
                "1": { "name": "keyword.other.flick" },
                "2": { "name": "variable.parameter.flick" }
              }
            },
            {
              "match": "(?:^\\s*|(?<=[{;])\\s*)(description|subcommand|handle)\\b(?!\\s*[=:])",
              "captures": { "1": { "name": "keyword.other.flick" } }
            },
            { "include": "#braces" },
            { "include": "$self" }
          ]
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [{ "include": "$self" }, { "include": "#braces" }]
    },
    "attributes": {
      "comment": "`@lang int`: an attribute of the declaration that follows",
      "name": "entity.other.attribute-name.flick",
      "match": "@[a-z_][A-Za-z0-9_]*"
    },
    "effect-row": {
      "begin": "(->)\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.operator.flick" },
        "2": { "name": "punctuation.definition.effect-row.begin.flick" }
      },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.definition.effect-row.end.flick" } },
      "contentName": "meta.effect-row.needs.flick",
      "patterns": [
        {
          "begin": ";",
          "beginCaptures": { "0": { "name": "punctuation.separator.flick" } },
          "end": "(?=\\})",
          "contentName": "meta.effect-row.fails.flick",
          "patterns": [{ "include": "#comments" }, { "include": "#row-item" }]
        },
        { "include": "#comments" },
        { "include": "#row-item" }
      ]
    },
    "row-item": {
      "patterns": [
        { "include": "#effect-row" },
        { "begin": "\\{", "end": "\\}", "patterns": [{ "include": "#row-item" }] },
        { "include": "#names" },
        { "include": "#operators" }
      ]
    },
    "definitions": {
      "patterns": [
        {
          "match": "(?<![.\\w])(let)\\s+(mut)\\s+([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.flick" },
            "2": { "name": "keyword.other.flick" },
            "3": { "name": "variable.other.flick" }
          }
        },
        {
          "match": "(?<![.\\w])(let)\\s+(?:(rec|assert)\\s+)?([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.flick" },
            "2": { "name": "keyword.other.flick" },
            "3": { "name": "entity.name.function.flick" }
          }
        },
        {
          "match": "^([a-z_][A-Za-z0-9_]*)\\s*(:)(?!:)",
          "captures": {
            "1": { "name": "entity.name.function.flick" },
            "2": { "name": "keyword.operator.flick" }
          }
        },
        {
          "match": "(?<![.\\w])(foreign)\\s+(?:(pure|effect|blocked|sync|async)\\s+)?([a-z_][A-Za-z0-9_]*)(?=\\s+(?:from\\b|\"))",
          "captures": {
            "1": { "name": "keyword.other.flick" },
            "2": { "name": "keyword.other.flick" },
            "3": { "name": "entity.name.function.flick" }
          }
        },
        {
          "comment": "`plugin head` in the `exposing` of an import",
          "match": "(?<![.\\w])(plugin)\\s+([a-z_][A-Za-z0-9_]*)(?=\\s*[,)])",
          "captures": {
            "1": { "name": "keyword.other.flick" },
            "2": { "name": "entity.name.function.macro.flick" }
          }
        },
        {
          "match": "^(server)\\s+(fn)\\b",
          "captures": {
            "1": { "name": "keyword.other.flick" },
            "2": { "name": "keyword.other.flick" }
          }
        },
        {
          "match": "^(component)\\s+([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.flick" },
            "2": { "name": "entity.name.function.flick" }
          }
        },
        {
          "match": "(?<![.\\w])(from)\\s+(global)\\b",
          "captures": {
            "1": { "name": "keyword.other.flick" },
            "2": { "name": "keyword.other.flick" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "constant.language.boolean.flick", "match": "(?<![.\\w])(?:true|false)\\b" },
        { "name": "keyword.control.flick", "match": "(?<![.\\w])(?:match|with|try|if|then|else|when|await|in|for|yield|do)\\b" },
        { "name": "keyword.operator.word.flick", "match": "(?<![.\\w])not\\b" },
        {
          "name": "keyword.other.flick",
          "match": "(?<![.\\w])(?:module|exposing|import|as|let|mut|rec|assert|fun|task|scope|provide|ignore|todo|echo|type|opaque|refined|where|kind|error|service|class|instance|deriving|foreign|from|forall|none|ui)\\b"
        }
      ]
    },
    "names": {
      "patterns": [
        { "name": "entity.name.type.flick", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" },
        { "name": "variable.other.member.flick", "match": "(?<!\\.\\.)(?<=\\.)[a-z_][A-Za-z0-9_]*\\b" },
        { "name": "variable.other.flick", "match": "\\b[a-z_][A-Za-z0-9_]*\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "punctuation.separator.flick", "match": "[,;]" },
        { "name": "keyword.operator.flick", "match": "\\.\\.\\.|\\.\\.<|\\.\\.|->|<-|=>|==|\\|>|\\|\\||&&|!=|<=|>=|\\+\\+|\\*\\*|[:.=|<>+\\-*/%^?]" }
      ]
    }
  }
}
