{
  "name": "@flick-lang/dts-importer",
  "version": "0.1.0",
  "description": "Reads the .d.ts of an installed package for `flick ffi import` and the surface of Effect for the coverage linter",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "flick-dts-importer": "./index.mjs"
  },
  "dependencies": {
    "@flick-lang/runtime": "workspace:*",
    "typescript": "5.9.3",
    "@flick-lang/effect-ts": "workspace:*"
  },
  "devDependencies": {
    "date-fns": "4.4.0",
    "delay": "7.0.0",
    "get-port": "7.2.0",
    "p-map": "7.1.1"
  },
  "scripts": {
    "build": "${FLICK_BIN:-../../target/debug/flick} build src/Main.fl --out-dir dist --color never",
    "test": "pnpm run build && node --test test/*.test.mjs"
  }
}
