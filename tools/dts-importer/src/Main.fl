// The `.d.ts` reader of `flick ffi import` and the surface of Effect for
// the coverage linter, reaching the TypeScript compiler through `Ts`.
module Main exposing (main)

import Bump
import Import
import Surface
import Cli

import_command :
  Cli.Command
    {Host.Console, Async, FileSystem.FileSystem, Path.Path}
    {AppError, PlatformError.PlatformError}
let import_command = cli "import" {
  description "Writes the shapes of the value exports of an installed package to a file, as JSON"
  /// The project whose installed packages to read
  flag root : String = "."
  /// The npm package
  arg package : String
  /// The file to write
  arg out : String
  handle fun { root; package; out } -> Import.run root package out
}

surface_command :
  Cli.Command
    {Host.Console, Async, FileSystem.FileSystem, Path.Path}
    {AppError, PlatformError.PlatformError}
let surface_command = cli "surface" {
  description "Prints the snapshot of an installed Effect's surface, as packages/effect-ts/coverage/snapshot.json holds it"
  /// The directory of the effect package
  arg dir : String = "packages/effect-ts/node_modules/effect"
  handle fun { dir } -> Platform.stdout_write (Surface.render (Surface.snapshot dir))
}

bump_command :
  Cli.Command
    {Host.Console, Async, FileSystem.FileSystem, Path.Path}
    {AppError, PlatformError.PlatformError}
let bump_command = cli "bump" {
  description "Moves the repository to another Effect release: snapshot, report, pins"
  /// The unpacked effect package, instead of downloading it with npm
  flag package_dir : Option String
  /// The repository
  flag root : String = "."
  /// The Effect version
  arg version : String
  handle fun { package_dir; root; version } -> Bump.run version package_dir root
}

tool :
  Cli.Command
    {Host.Console, Async, FileSystem.FileSystem, Path.Path}
    {AppError, PlatformError.PlatformError}
let tool = cli "dts-importer" {
  description "Reads TypeScript declarations for Flick"
  subcommand import_command
  subcommand surface_command
  subcommand bump_command
}

/// Runs the task with the Node.js services, a platform error failing the app.
with_node :
  (Unit ->{Host.Environment, Host.Arguments, Host.Console, Async, FileSystem.FileSystem, Path.Path; AppError, PlatformError.PlatformError}
    Unit) ->
  Unit ->{Host.Environment, Host.Arguments, Host.Console, Async; AppError}
  Unit
let with_node act () =
  try provide FileSystem.node { provide Path.layer { act () } } with
  | PlatformError.PlatformError reason -> App.fail (show reason)

main : Unit ->{Host.Environment, Host.Arguments, Host.Console, Async; AppError} Unit
let main () =
  with_node
    (fun () ->
      try Cli.run tool (Platform.args ()) with
      | Cli.CliError message -> App.fail message
    )
    ()
