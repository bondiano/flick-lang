/// `flick ffi import` reads `{"root": "<project dir>", "package": "<name>"}`
/// on stdin and gets the shapes of the package's value exports as JSON.
module Import exposing (run)

import JsonText exposing (Value(..))
import Shape
import Ts

type alias Request = { root : String; name : String }
  deriving Schema

request_json : PureCodec Json Request
let request_json =
  ignore_extra_fields
    (codec (schema Request) {
      root = field "root" String.json
      name = field "package" String.json
    })

/// Whether the file is a declaration file: `.d.ts`, `.d.mts` or `.d.cts`.
is_declarations : String -> Bool
let is_declarations file = List.any (fun e -> String.ends_with e file) [".d.ts", ".d.mts", ".d.cts"]

/// The JSON of the package's value exports, from its declarations `file`.
surface : Request -> Ts.Resolution -> String ->{Path.Path; AppError} String
let surface request resolved file =
  let program = Ts.program file
  let checker = Ts.checker program
  match Ts.module_of program file with
  | None -> App.fail (file ++ " declares no module")
  | Some module_ ->
    let exports =
      List.map
        (fun e ->
          JObject
            (List.concat
              [
                [("name", JString e.name), ("local", JString e.local)],
                e.body,
                [("fingerprint", JString e.fingerprint)]
              ]))
        (Shape.exports checker module_)
    let id = Ts.resolved_package resolved
    let declarations =
      match id with
      | Some p -> p.name ++ "/" ++ p.subModuleName
      | None -> Path.basename file
    JsonText.render
      (JObject
        [
          ("package", JString (Option.with_default request.name (Option.map (fun p -> p.name) id))),
          ("version", Option.with_default JNull (Option.map (fun p -> JString p.version) id)),
          ("declarations", JString declarations),
          ("exports", JArray exports)
        ])

/// Answers the request on stdin.
run : Unit ->{Stdio.Stdio, Path.Path; AppError, PlatformError.PlatformError} Unit
let run () =
  let text = Stream.mk_string (Stream.decode_text Stream.stdin)
  let request =
    match Json.parse text with
    | Err _ -> App.fail "the request on stdin is not JSON"
    | Ok input ->
      match Codec.decode_result request_json input with
      | Err _ -> App.fail "the request on stdin needs `root` and `package`"
      | Ok r -> r
  let origin = Path.join [request.root, "__flick_ffi_import__.mts"]
  match Ts.resolve request.name origin with
  | None ->
    App.fail ("cannot resolve the declarations of `" ++ request.name ++ "` from " ++ request.root)
  | Some resolved ->
    let file = Ts.resolved_file resolved
    if not (is_declarations file) then
      App.fail
        ("`" ++ request.name ++ "` resolves to " ++ file ++ ", which is not a declaration file")
    else
      Platform.stdout_line (surface request resolved file)
