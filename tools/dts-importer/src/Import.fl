/// The shapes of a package's value exports as JSON, which the `ffi import`
/// command of the JavaScript backend turns into bindings.
module Import exposing (run)

import JsonText exposing (Value(..))
import Shape
import Ts

type alias Request = { root : String; name : String }

/// Whether the file is a declaration file: `.d.ts`, `.d.mts` or `.d.cts`.
is_declarations : String -> Bool
let is_declarations file = List.any (fun e -> String.ends_with e file) [".d.ts", ".d.mts", ".d.cts"]

/// The distinct declarations `name` stands for.
sites_of : List (String, String) -> String -> List String
let sites_of named name =
  List.dedupe (List.filter_map (fun (n, s) -> if n == name then Some s else None) named)

/// The simple names that stand for more than one declaration.
ambiguous : List (String, String) -> List String
let ambiguous named =
  List.filter
    (fun n -> List.length (sites_of named n) > 1)
    (List.dedupe (List.map (fun (n, _) -> n) named))

/// The declarations each export of the module stands for, with its name.
exported_sites : Ts.Checker -> Ts.Symbol -> List (String, String)
let exported_sites c module_ =
  List.flat_map
    (fun exported ->
      let symbol = if Ts.symbol_has "Alias" exported then Ts.aliased c exported else exported
      List.map (fun d -> (Ts.declaration_site d, Ts.symbol_name exported)) (Ts.declarations symbol)
    )
    (Ts.exports_of c module_)

/// How TypeScript names the type `name` declared at `site` outside these
/// declarations: by an export of the package, or by the name the global
/// scope has it by. A type neither names has no entry.
named_type : List (String, String) -> List (String, String) -> (String, String) -> Option Value
let named_type exported globals (name, site) =
  at : List (String, String) -> Option String
  let at sites = Option.map (fun (_, found) -> found) (List.find (fun (s, _) -> s == site) sites)
  match at exported with
  | Some export -> Some (JObject [("name", JString name), ("export", JString export)])
  | None ->
    Option.map
      (fun global -> JObject [("name", JString name), ("global", JString global)])
      (at globals)

/// The JSON of the package's value exports, from its declarations `file`.
surface : Request -> Ts.Resolution -> String ->{Path.Path; AppError} String
let surface request resolved file =
  let program = Ts.program file
  let checker = Ts.checker program
  match Ts.module_of program file with
  | None -> App.fail (file ++ " declares no module")
  | Some module_ ->
    let shapes = Shape.exports checker module_
    let exports =
      List.map
        (fun e ->
          JObject
            (List.concat [
              [("name", JString e.name), ("local", JString e.local)],
              e.body,
              [("fingerprint", JString e.fingerprint)],
            ])
        )
        shapes
    let named = List.dedupe (List.flat_map (fun e -> e.named) shapes)
    let clashes = ambiguous named
    let types =
      List.filter_map
        (named_type (exported_sites checker module_) (List.flat_map (fun e -> e.globals) shapes))
        (List.filter (fun (n, _) -> not (List.contains n clashes)) named)
    let package_id = Ts.resolved_package resolved
    let declarations =
      match package_id with
      | Some p -> p.name ++ "/" ++ p.subModuleName
      | None -> Path.basename file
    JsonText.render
      (JObject
        (List.concat [
          [
            ("package", JString request.name),
            (
              "version",
              Option.with_default JNull (Option.map (fun p -> JString p.version) package_id),
            ),
            ("declarations", JString declarations),
            ("exports", JArray exports),
          ],
          // absent when empty, so the surface of most packages does not change
          if List.is_empty clashes then [] else [("ambiguous", JArray (List.map JString clashes))],
          if List.is_empty types then [] else [("types", JArray types)],
        ]))

/// Writes to `out` the shapes of the value exports of the package `name`,
/// resolved as a module of the project at `root` resolves it.
run :
  String -> String -> String ->{Async, FileSystem.FileSystem, Path.Path; AppError, PlatformError.PlatformError}
  Unit
let run root name out =
  let origin = Path.join [root, "__flick_ffi_import__.mts"]
  match Ts.resolve name origin with
  | None ->
    App.fail ("cannot resolve the declarations of `" ++ name ++ "` from " ++ root)
  | Some resolved ->
    let file = Ts.resolved_file resolved
    if not (is_declarations file) then
      App.fail
        ("`" ++ name ++ "` resolves to " ++ file ++ ", which is not a declaration file")
    else
      FileSystem.write_file_string { flag = None; mode = None } out (surface { root = root; name = name } resolved file ++ "\n")
