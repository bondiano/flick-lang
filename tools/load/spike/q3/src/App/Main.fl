// Q3: Option, Result, Exit, Failure across the boundary: from the signature,
// nested, through a type variable, and through a schema that looks inside.
module App.Main exposing (main)

import HashMap
import Stream exposing (Stream)
import Fail

type alias Row = { name : String; note : Option String; tags : List (Option Int); r : Result String Int }
  deriving Schema

type error Nope = Nope Int
  deriving Show, Eq

say : String ->{} Unit
let say line = Platform.stdout_line line

row_codec : Codec none none Json Row
let row_codec = Codec.general (Codec.json Row.schema)

/// Many elements: enough operations of Effect's fiber to take its turn.
long : Codec none none Json (List Int)
let long = Codec.general (Codec.json (Schema.list Schema.int))

main : Unit ->{Async; AppError} Unit
let main () =
  try body () with
  | SchemaError e -> say "schema error"

body : Unit ->{Async; SchemaError} Unit
let body () =
  // a callback returning Option, a list of Option, through a type variable
  let xs = Stream.run_collect (Stream.from_list [Some 1, None, Some 3] |> Stream.map_effect (fun o -> Option.map (fun x -> x + 1) o))
  say ("callback returning Option: " ++ show xs)
  say ("equal to a literal: " ++ show (xs == [Some 2, None, Some 4]))
  // Effect's own Option, made by Effect's code, read and compared by Flick's
  let m = HashMap.insert "a" 1 (HashMap.empty : HashMap.HashMap EqHash.Canonical String Int)
  let found = HashMap.get "a" m
  say ("Effect's Some: " ++ show found ++ " equal: " ++ show (found == Some 1) ++ " none: " ++ show (HashMap.get "b" m == None))
  // a value only a schema looks inside: the signature says `a`
  let row = { name = "x"; note = Some "n"; tags = [Some 1, None]; r = Ok 2 }
  let encoded = Codec.encode row_codec row
  say ("schema encodes Flick's Option: " ++ Json.stringify encoded)
  let back = Codec.decode row_codec (Json.to_unknown encoded)
  say ("schema decodes to what Flick matches: " ++ show back.note ++ " " ++ show back.tags ++ " " ++ show back.r ++ " equal: " ++ show (back == row))
  // Exit and Failure by the signature
  let _ =
    Stream.run_drain
      (Stream.from_list [1] |> Stream.on_exit (fun e -> say ("Exit given by Effect: " ++ show (Option.is_some (Exit.value e)))))
  let caught =
    Stream.run_collect
      (Stream.from_list [1]
      |> Stream.map_effect (fun x -> if x == 0 then "never" else Fail.fail (Nope x))
      |> Stream.tap_cause (fun f -> say ("Failure given by Effect, primary is some: " ++ show (Option.is_some (Failure.primary f))))
      |> Stream.catch_cause (fun f -> Stream.from_list [show (Option.is_some (Failure.primary f))]))
  say ("after catch_cause: " ++ show caught)
  // Exit of the kernel's, in a value Effect carries
  let exits =
    Stream.run_collect
      (Stream.from_list [1, 2] |> Stream.map_effect (fun x -> Effect.exit (task { if x == 1 then x else Fail.fail (Nope x) })))
  say ("kernel Exits carried by a stream: " ++ show (List.map (fun e -> Option.is_some (Exit.value e)) exits))
  // Effect's turn in a stage that runs at once
  say ("a long decode in a Sync stage: " ++ show (sync_decode 20000))
  say "done"

sync_decode : Int ->{; SchemaError} Int
let sync_decode n =
  let doc = Codec.encode long (List.range 0 n)
  List.length (Codec.decode long (Json.to_unknown doc))
