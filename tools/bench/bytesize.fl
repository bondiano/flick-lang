// Sizes of 100 000 pseudo-random numbers of bytes: made in a unit, written in
// the largest fitting one, read back from that text, compared and summed.
module App.Main exposing (main)

size : Int
let size = 100000

decimal : ByteSize.FormatOptions
let decimal = { precision = Some 3; trailingZeros = None; binary = false; unit = None }

/// A linear congruential sequence; the multiplication wraps in 32 bits.
number : Int -> Float
let number i =
  let n = (i * 1103515245 + 12345) % 1000003
  Int.to_float (if n < 0 then 0 - n else n)

/// What the sizes make of one number.
one : Int -> Int
let one i =
  let n = number i
  let made = Option.with_default ByteSize.zero (ByteSize.kibibytes (n / 8))
  let text = ByteSize.format decimal made
  let read = Option.with_default ByteSize.zero (ByteSize.from_string text)
  let larger = made |> ByteSize.max read |> ByteSize.sum made
  let half = Option.with_default ByteSize.zero (ByteSize.divide 2 larger)
  String.length text
    + String.length (ByteSize.format ByteSize.default_format half)
    + (if half |> ByteSize.is_less_than made then 1 else 0)
    + (if ByteSize.to_unit ByteSize.MiB read > 1 then 2 else 0)

main : Unit ->{; AppError} Unit
let main () =
  Platform.stdout_line (show (List.fold_left (fun acc i -> acc + one i) 0 (List.range 0 size)))
