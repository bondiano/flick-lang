// A persistent binary search tree of records under a constructor: 300 000
// inserts of pseudo-random keys, then a lookup of each.
module App.Main exposing (main)

type Tree = Leaf | Node { left : Tree; key : Int; value : Int; right : Tree }

insert : Int -> Int -> Tree -> Tree
let rec insert key value tree =
  match tree with
  | Leaf -> Node { left = Leaf; key = key; value = value; right = Leaf }
  | Node node ->
    if key < node.key then
      Node { node with left = insert key value node.left }
    else if key > node.key then
      Node { node with right = insert key value node.right }
    else
      Node { node with value = value }

find : Int -> Tree -> Option Int
let rec find key tree =
  match tree with
  | Leaf -> None
  | Node node ->
    if key < node.key then
      find key node.left
    else if key > node.key then
      find key node.right
    else
      Some node.value

next : Int -> Int
let next seed =
  let n = (seed * 1103515245 + 12345) % 1000003
  if n < 0 then 0 - n else n

build : Int -> Int -> Tree -> Tree
let rec build left seed tree =
  if left == 0 then tree else build (left - 1) (next seed) (insert seed left tree)

total : Int -> Int -> Tree -> Int -> Int
let rec total left seed tree sum =
  if left == 0 then
    sum
  else
    total (left - 1) (next seed) tree (sum + Option.with_default 0 (find seed tree))

main : Unit ->{; AppError} Unit
let main () =
  let tree = build 300000 7 Leaf
  Platform.stdout_line (show (total 300000 7 tree 0))
