// Many call sites of accessors: 64 functions, each mapping a path of
// one to three fields over a list of 1 000 records and applying another
// to one record, called 200 rounds.
module App.Main exposing (main)

type alias Address = { zip : Int; street : Int; city : Int; country : Int }

type alias Place = { code : Int; floor : Int; door : Int; address : Address }

type alias Row = { name : Int; place : Place }

sum : List Int -> Int
let sum xs = List.fold_left (fun acc x -> (acc + x) % 1000003) 0 xs

site0 : List Row -> Row -> Int
let site0 rows row = sum (List.map .name rows) + .place.code row + 0

site1 : List Row -> Row -> Int
let site1 rows row = sum (List.map .place.code rows) + .place.address.zip row + 1

site2 : List Row -> Row -> Int
let site2 rows row = sum (List.map .place.floor rows) + .place.address.country row + 2

site3 : List Row -> Row -> Int
let site3 rows row = sum (List.map .place.door rows) + .place.floor row + 3

site4 : List Row -> Row -> Int
let site4 rows row = sum (List.map .place.address.zip rows) + .place.address.street row + 4

site5 : List Row -> Row -> Int
let site5 rows row = sum (List.map .place.address.street rows) + .name row + 5

