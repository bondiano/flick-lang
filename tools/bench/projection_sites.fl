quarter0 : List Row -> Row -> Int
let quarter0 rows row =
  site0 rows row
    + site1 rows row
    + site2 rows row
    + site3 rows row
    + site4 rows row
    + site5 rows row
    + site6 rows row
    + site7 rows row
    + site8 rows row
    + site9 rows row
    + site10 rows row
    + site11 rows row
    + site12 rows row
    + site13 rows row
    + site14 rows row
    + site15 rows row

quarter1 : List Row -> Row -> Int
let quarter1 rows row =
  site16 rows row
    + site17 rows row
    + site18 rows row
    + site19 rows row
    + site20 rows row
    + site21 rows row
    + site22 rows row
    + site23 rows row
    + site24 rows row
    + site25 rows row
    + site26 rows row
    + site27 rows row
    + site28 rows row
    + site29 rows row
    + site30 rows row
    + site31 rows row

quarter2 : List Row -> Row -> Int
let quarter2 rows row =
  site32 rows row
    + site33 rows row
    + site34 rows row
    + site35 rows row
    + site36 rows row
    + site37 rows row
    + site38 rows row
    + site39 rows row
    + site40 rows row
    + site41 rows row
    + site42 rows row
    + site43 rows row
    + site44 rows row
    + site45 rows row
    + site46 rows row
    + site47 rows row

quarter3 : List Row -> Row -> Int
let quarter3 rows row =
  site48 rows row
    + site49 rows row
    + site50 rows row
    + site51 rows row
    + site52 rows row
    + site53 rows row
    + site54 rows row
    + site55 rows row
    + site56 rows row
    + site57 rows row
    + site58 rows row
    + site59 rows row
    + site60 rows row
    + site61 rows row
    + site62 rows row
    + site63 rows row

all : List Row -> Row -> Int
let all rows row =
  (quarter0 rows row + quarter1 rows row + quarter2 rows row + quarter3 rows row) % 1000003

rounds : List Row -> Int -> Int -> Int
let rec rounds rows left acc =
  match List.head rows with
  | None -> acc
  | Some row ->
    if left == 0 then acc else rounds rows (left - 1) ((acc * 31 + all rows row) % 1000003)

make : Int -> Row
let make i =
  let address = { zip = i; street = i + 1; city = i + 2; country = i + 3 }
  { name = i; place = { code = i * 2; floor = i % 7; door = i % 11; address = address } }

main : Unit ->{Host.Console; AppError} Unit
let main () = Platform.stdout_line (show (rounds (List.map make (List.range 0 1000)) 200 0))
