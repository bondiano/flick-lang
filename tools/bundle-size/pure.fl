// The smallest program the bundle budget tracks: an ADT, a match, a pure
// function and one line of output.
module App.Main exposing (main)

type Shape = Circle Number | Rect Number Number

area : Shape -> Number
let area s =
  match s with
  | Circle r -> 3.14 * r * r
  | Rect w h -> w * h

add : Number -> Number -> Number
let add a b = a + b

main : Unit ->{; AppError} Unit
let main () =
  let a = area (Circle 2)
  let b = area (Rect 3 4)
  Platform.stdout_line (show (add a b))
