// A pure arithmetic library with no host dependencies. This is not
// an I/O-equivalent comparison with `pure.fl`; `pure-rt` provides that comparison.
module App.Main exposing (Shape(..), area, result)

type Shape = Circle Float | Rect Float Float

area : Shape -> Float
let area s =
  match s with
  | Circle r -> 3.14 * r * r
  | Rect w h -> w * h

add : Float -> Float -> Float
let add a b = a + b

result : Float
let result =
  let a = area (Circle 2)
  let b = area (Rect 3 4)
  add a b
