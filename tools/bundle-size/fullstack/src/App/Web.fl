// The client entry: the shared module and the call of a server function,
// no `Server` on its way.
module App.Web exposing (main)

import App.Remote
import App.Shared

main : Unit ->{; AppError} Unit
let main () =
  try Console.log (App.Shared.greeting (App.Remote.lookup "1")) with
  | Rpc.ClientError message -> App.fail message
