+
+// Benchmark-only markers. Apply this patch only in an isolated worktree.
+#[cfg(target_arch = "wasm32")]
+mod probe {
+    use wasm_bindgen::prelude::*;
+
+    #[wasm_bindgen]
+    extern "C" {
+        #[wasm_bindgen(js_namespace = globalThis, js_name = __flickBenchMark)]
+        fn mark(stage: u32, enter: bool);
+    }
+
+    pub struct Stage(u32);
+
+    pub fn stage(id: u32) -> Stage {
+        mark(id, true);
+        Stage(id)
+    }
+
+    impl Drop for Stage {
+        fn drop(&mut self) {
+            mark(self.0, false);
+        }
+    }
+}
+
+#[cfg(target_arch = "wasm32")]
+pub use probe::stage;
