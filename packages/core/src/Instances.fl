@lang instances
/// Instances of the built-in classes for the built-in types. Records and
/// tuples have theirs from the compiler; every module sees all of them.
module Instances

eq_prim : a -> a -> Bool
foreign pure eq_prim from "@flick-lang/effect-ts" "equals"

compare_prim : a -> a -> Ordering
foreign pure compare_prim from "@flick-lang/effect-ts" "compare"

hash_prim : a -> Int
foreign pure hash_prim from "@flick-lang/effect-ts" "hash"

show_prim : a -> String
foreign pure show_prim from "@flick-lang/effect-ts" "show"

eq_list : (a -> a -> Bool) -> List a -> List a -> Bool
foreign pure eq_list from "@flick-lang/effect-ts" "listEquals"

compare_list : (a -> a -> Ordering) -> List a -> List a -> Ordering
foreign pure compare_list from "@flick-lang/effect-ts" "listCompare"

hash_list : (a -> Int) -> List a -> Int
foreign pure hash_list from "@flick-lang/effect-ts" "listHash"

show_list : (a -> String) -> List a -> String
foreign pure show_list from "@flick-lang/effect-ts" "listShow"

instance Eq Int =
  let eq x y = eq_prim x y

instance Eq Float =
  let eq x y = eq_prim x y

instance Eq BigInt =
  let eq x y = eq_prim x y

instance Eq String =
  let eq x y = eq_prim x y

instance Eq Bool =
  let eq x y = eq_prim x y

instance Eq Unit =
  let eq _x _y = true

instance Eq Ordering =
  let eq x y = eq_prim x y

instance Eq a => Eq (List a) =
  let eq xs ys = eq_list eq xs ys

instance Eq a => Eq (Option a) =
  let eq x y =
    match (x, y) with
    | (Some a, Some b) -> eq a b
    | (None, None) -> true
    | _ -> false

instance (Eq e, Eq a) => Eq (Result e a) =
  let eq x y =
    match (x, y) with
    | (Ok a, Ok b) -> eq a b
    | (Err a, Err b) -> eq a b
    | _ -> false

@lang ord_lt
/// `x < y` on a type variable with `Ord`: what its comparison operators call.
ord_lt : Ord a => a -> a -> Bool
let ord_lt x y = compare x y == LT

@lang ord_le
ord_le : Ord a => a -> a -> Bool
let ord_le x y = compare x y != GT

@lang ord_gt
ord_gt : Ord a => a -> a -> Bool
let ord_gt x y = compare x y == GT

@lang ord_ge
ord_ge : Ord a => a -> a -> Bool
let ord_ge x y = compare x y != LT

instance Ord Int =
  let compare x y = compare_prim x y

instance Ord Float =
  let compare x y = compare_prim x y

instance Ord BigInt =
  let compare x y = compare_prim x y

instance Ord String =
  let compare x y = compare_prim x y

instance Ord Bool =
  let compare x y = compare_prim x y

instance Ord Unit =
  let compare _x _y = EQ

instance Ord a => Ord (List a) =
  let compare xs ys = compare_list compare xs ys

instance Ord a => Ord (Option a) =
  let compare x y =
    match (x, y) with
    | (Some a, Some b) -> compare a b
    | (None, None) -> EQ
    | (None, _) -> LT
    | _ -> GT

instance Hash Int =
  let hash x = hash_prim x

instance Hash Float =
  let hash x = hash_prim x

instance Hash BigInt =
  let hash x = hash_prim x

instance Hash String =
  let hash x = hash_prim x

instance Hash Bool =
  let hash x = hash_prim x

instance Hash Unit =
  let hash _x = 0

instance Hash a => Hash (List a) =
  let hash xs = hash_list hash xs

instance Hash a => Hash (Option a) =
  let hash x =
    match x with
    | Some a -> hash a
    | None -> 0

instance Show Int =
  let show x = show_prim x

instance Show Float =
  let show x = show_prim x

instance Show BigInt =
  let show x = show_prim x

instance Show String =
  let show x = show_prim x

instance Show Bool =
  let show x = show_prim x

instance Display String =
  let display x = x

instance Display Int =
  let display x = show_prim x

instance Display Float =
  let display x = show_prim x

instance Display Bool =
  let display x = show_prim x

float_of_int : Int -> Float
foreign pure float_of_int from global "Number"

bigint_of_int : Int -> BigInt
foreign pure bigint_of_int from global "BigInt"

instance Into Int Float =
  let into n = float_of_int n

instance Into Int BigInt =
  let into n = bigint_of_int n

instance Show Unit =
  let show _x = "()"

instance Show Ordering =
  let show x = show_prim x

instance Show a => Show (List a) =
  let show xs = show_list show xs

instance Show a => Show (Option a) =
  let show x =
    match x with
    | Some a -> "Some " ++ show a
    | None -> "None"

instance (Show e, Show a) => Show (Result e a) =
  let show x =
    match x with
    | Ok a -> "Ok " ++ show a
    | Err e -> "Err " ++ show e

instance (Ord e, Ord a) => Ord (Result e a) =
  let compare x y =
    match (x, y) with
    | (Err a, Err b) -> compare a b
    | (Ok a, Ok b) -> compare a b
    | (Err _, _) -> LT
    | _ -> GT

instance (Hash e, Hash a) => Hash (Result e a) =
  let hash x =
    match x with
    | Ok a -> hash a
    | Err e -> 1 + hash e

instance Hash Ordering =
  let hash x = hash_prim x

instance Ord Ordering =
  let compare x y = compare_prim (rank x) (rank y)

rank : Ordering -> Int
let rank o =
  match o with
  | LT -> 0
  | EQ -> 1
  | GT -> 2

map_list : (forall v. a^v -> b)^c -> (List a)^d -> (List b)^c
foreign pure map_list from "@flick-lang/effect-ts" "listMap"
  arity 2
  retention call

fold_list : (b -> a -> b)^c -> b^c -> List a -> b
foreign pure fold_list from "@flick-lang/effect-ts" "listFold"
  arity 3
  retention call

traverse_list : (a ->{r; e} b)^c -> List a ->{r; e} List b
foreign effect traverse_list from "@flick-lang/effect-ts" "listMapEffect"
  retention call

flat_map_list : (forall v. a^v -> (List b)^(c + v))^c -> (List a)^d -> (List b)^(c + d)
foreign pure flat_map_list from "@flick-lang/effect-ts" "listFlatMap"
  arity 2
  retention call

pure_eff : a^c -> (Eff r e a)^c
foreign pure pure_eff from "@flick-lang/effect-ts" "succeed"
  retention call

flat_map_eff : (forall v. a^v -> (Eff r e b)^(c + v))^c -> (Eff r e a)^d -> (Eff r e b)^(c + d)
foreign pure flat_map_eff from "@flick-lang/effect-ts" "flatMapEff"
  arity 2
  retention call

map_eff : (forall v. a^v -> b)^c -> (Eff r e a)^d -> (Eff r e b)^(c + d)
foreign pure map_eff from "@flick-lang/effect-ts" "mapEff"
  arity 2
  retention call

map2_option : (forall u v. a^u -> b^v -> x)^c -> (Option a)^d -> (Option b)^d -> (Option x)^(c + d)
foreign pure map2_option from "@flick-lang/effect-ts" "optionMap2"
  arity 3
  retention call

map2_result :
  (forall u v. a^u -> b^v -> x)^c -> (Result e a)^d -> (Result e b)^d -> (Result e x)^(c + d)
foreign pure map2_result from "@flick-lang/effect-ts" "resultMap2"
  arity 3
  retention call

map2_list : (forall u v. a^u -> b^v -> x)^c -> (List a)^d -> (List b)^d -> (List x)^(c + d)
foreign pure map2_list from "@flick-lang/effect-ts" "listMap2"
  arity 3
  retention call

map2_eff : (forall u v. a^u -> b^v -> x)^c -> (Eff r e a)^d -> (Eff r e b)^d -> (Eff r e x)^(c + d)
foreign pure map2_eff from "@flick-lang/effect-ts" "map2Eff"
  arity 3
  retention call

seq_of_list : List a -> Seq a
foreign pure seq_of_list from "@flick-lang/effect-ts" "seqOfList"

seq_of_list_held : (List a)^d -> (Seq a)^d
foreign pure seq_of_list_held from "@flick-lang/effect-ts" "seqOfList"
  retention call

map_seq : (forall v. a^v -> b)^c -> (Seq a)^d -> (Seq b)^(c + d)
foreign pure map_seq from "@flick-lang/effect-ts" "seqMap"
  arity 2
  retention call

flat_map_seq : (forall v. a^v -> (Seq b)^(c + v))^c -> (Seq a)^d -> (Seq b)^(c + d)
foreign pure flat_map_seq from "@flick-lang/effect-ts" "seqFlatMap"
  arity 2
  retention call

fold_seq : (b -> a -> b)^c -> b^c -> Seq a -> b
foreign pure fold_seq from "@flick-lang/effect-ts" "seqFold"
  arity 3
  retention call

map2_seq : (forall u v. a^u -> b^v -> x)^c -> (Seq a)^d -> (Seq b)^d -> (Seq x)^(c + d)
foreign pure map2_seq from "@flick-lang/effect-ts" "seqMap2"
  arity 3
  retention call

append_seq : (Seq a)^d -> (Seq a)^d -> (Seq a)^d
foreign pure append_seq from "@flick-lang/effect-ts" "seqAppend"
  arity 2
  retention call

instance Functor Option =
  let map f value =
    match value with
    | None -> None
    | Some x -> Some (f x)

instance Foldable Option =
  let fold f init value =
    match value with
    | None -> init
    | Some x -> f init x

instance Traversable Option =
  let traverse f value =
    match value with
    | None -> None
    | Some x -> Some (f x)

instance Applicative Option =
  let pure x = Some x
  let map2 f = map2_option f

instance Monad Option =
  let flat_map f value =
    match value with
    | None -> None
    | Some x -> f x

instance Functor (Result e) =
  let map f value =
    match value with
    | Err e -> Err e
    | Ok x -> Ok (f x)

instance Foldable (Result e) =
  let fold f init value =
    match value with
    | Err _ -> init
    | Ok x -> f init x

instance Traversable (Result e) =
  let traverse f value =
    match value with
    | Err e -> Err e
    | Ok a -> Ok (f a)

instance Applicative (Result e) =
  let pure x = Ok x
  let map2 f = map2_result f

instance Monad (Result e) =
  let flat_map f value =
    match value with
    | Err e -> Err e
    | Ok x -> f x

instance Functor List =
  let map f xs = map_list f xs

instance Foldable List =
  let fold f init xs = fold_list f init xs

instance Traversable List =
  let traverse f xs = traverse_list f xs

instance Applicative List =
  let pure x = [x]
  let map2 f = map2_list f

instance Monad List =
  let flat_map f xs = flat_map_list f xs

instance Functor (Eff r e) =
  let map f eff = map_eff f eff

instance Applicative (Eff r e) =
  let pure x = pure_eff x
  let map2 f = map2_eff f

instance Monad (Eff r e) =
  let flat_map f eff = flat_map_eff f eff

instance Alternative Option =
  let nothing = None
  let or_else first second =
    match first with
    | None -> second
    | Some _ -> first

instance Alternative List =
  let nothing = []
  let or_else xs ys = xs ++ ys

instance Semigroup String =
  let combine x y = x ++ y

instance Monoid String =
  let empty = ""

instance Semigroup (List a) =
  let combine xs ys = xs ++ ys

instance Monoid (List a) =
  let empty = []

instance Iterable List =
  let iter xs = seq_of_list_held xs

instance Iterable Seq =
  let iter xs = xs

instance Functor Seq =
  let map f = map_seq f

instance Foldable Seq =
  let fold f = fold_seq f

instance Applicative Seq =
  let pure x = seq_of_list_held [x]
  let map2 f = map2_seq f

instance Monad Seq =
  let flat_map f xs = flat_map_seq f xs

instance Alternative Seq =
  let nothing = seq_of_list []
  let or_else xs ys = append_seq xs ys

instance Eq SchemaError =
  let eq x y =
    match (x, y) with
    | (SchemaError a, SchemaError b) -> eq a b

instance Show SchemaError =
  let show x =
    match x with
    | SchemaError issues -> "SchemaError " ++ show issues
