/// A value, or the errors found while computing it. Where `Result` stops
/// at the first error, `map2` of a `Validation` combines both errors with
/// their `Semigroup`, so an `and` group of `do` reports every one; it is an
/// `Applicative` and no `Monad`, since a later step could not run without
/// the value of an earlier one.
module Validation exposing (..)

/// A `Result` whose `map2` collects errors.
unboxed type Validation e a = Validation (Result e a)

/// The value `x`.
valid : a -> Validation e a
let valid x = Validation (Ok x)

/// The errors `e`.
invalid : e -> Validation e a
let invalid e = Validation (Err e)

from_result : Result e a -> Validation e a
let from_result result = Validation result

to_result : Validation e a -> Result e a
let to_result (Validation result) = result

instance Functor (Validation e) =
  let map f (Validation result) = Validation (Result.map f result)

instance Semigroup e => Applicative (Validation e) =
  let pure x = Validation (Ok x)
  let map2 f = map2_validation combine f

map2_validation :
  (e -> e -> e) ->
  (forall u v. a^u -> (b^v -> x)^(c + u))^c ->
  ((Validation e a)^d -> ((Validation e b)^d -> (Validation e x)^(c + d))^(c + d))^c
foreign pure map2_validation from "@flick-lang/runtime" "validationMap2"
  arity 4
  retention call
