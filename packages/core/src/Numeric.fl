instance Integer Int8 =
  let to_bigint n = int8_to_bigint n

instance Integer Int16 =
  let to_bigint n = int16_to_bigint n

instance Integer Int64 =
  let to_bigint n = int64_to_bigint n

instance Integer UInt8 =
  let to_bigint n = uint8_to_bigint n

instance Integer UInt16 =
  let to_bigint n = uint16_to_bigint n

instance Integer UInt32 =
  let to_bigint n = uint32_to_bigint n

instance Integer UInt64 =
  let to_bigint n = uint64_to_bigint n

instance Floating Float32 =
  let from_float x = float32_from_float x
