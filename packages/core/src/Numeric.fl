/// The numeric types as classes, for functions over any of them: `Numeric`
/// holds `Int`, `Int8`, `Int16`, `Int64`, `UInt8`, `UInt16`, `UInt32`,
/// `UInt64`, `Float`, `Float32` and `BigInt`; `Integer` holds the integers;
/// `Floating` holds `Float` and `Float32`. The classes are closed: this module
/// has every instance, and a program cannot declare another. On a type
/// variable with one of them, the operators and number literals use its
/// methods.
module Numeric exposing (..)

@lang numeric
class Ord a => Numeric a =
  @lang add
  add : a -> a -> a
  @lang sub
  sub : a -> a -> a
  @lang mul
  mul : a -> a -> a
  @lang div
  div : a -> a -> a
  @lang rem
  rem : a -> a -> a
  @lang pow
  pow : a -> a -> a
  @lang negate
  negate : a -> a
  @lang from_int
  from_int : Int -> a
  to_float : a -> Float
  @lang lt
  lt : a -> a -> Bool
  @lang le
  le : a -> a -> Bool
  @lang gt
  gt : a -> a -> Bool
  @lang ge
  ge : a -> a -> Bool

@lang integer
class Numeric a => Integer a =
  to_bigint : a -> BigInt

@lang floating
class Numeric a => Floating a =
  @lang from_float
  from_float : Float -> a

bigint_of : Int -> BigInt
foreign pure bigint_of from global "BigInt"

float_of_bigint : BigInt -> Float
foreign pure float_of_bigint from global "Number"

instance Numeric Int =
  let add a b = a + b
  let sub a b = a - b
  let mul a b = a * b
  let div a b = a / b
  let rem a b = a % b
  let pow a b = a ** b
  let negate a = -a
  let from_int n = n
  let to_float n = Int.to_float n
  let lt a b = a < b
  let le a b = a <= b
  let gt a b = a > b
  let ge a b = a >= b

instance Numeric Float =
  let add a b = a + b
  let sub a b = a - b
  let mul a b = a * b
  let div a b = a / b
  let rem a b = a % b
  let pow a b = a ** b
  let negate a = -a
  let from_int n = Int.to_float n
  let to_float x = x
  let lt a b = a < b
  let le a b = a <= b
  let gt a b = a > b
  let ge a b = a >= b

instance Numeric BigInt =
  let add a b = a + b
  let sub a b = a - b
  let mul a b = a * b
  let div a b = a / b
  let rem a b = a % b
  let pow a b = a ** b
  let negate a = -a
  let from_int n = bigint_of n
  let to_float n = float_of_bigint n
  let lt a b = a < b
  let le a b = a <= b
  let gt a b = a > b
  let ge a b = a >= b

instance Integer Int =
  let to_bigint n = bigint_of n

instance Integer BigInt =
  let to_bigint n = n

instance Floating Float =
  let from_float x = x

int8_from_int : Int -> Int8
foreign pure int8_from_int from "flick:rt" "toInt8"

int8_to_float : Int8 -> Float
foreign pure int8_to_float from "flick:rt" "toFloat64"

int8_to_bigint : Int8 -> BigInt
foreign pure int8_to_bigint from "flick:rt" "toBigInt"

int16_from_int : Int -> Int16
foreign pure int16_from_int from "flick:rt" "toInt16"

int16_to_float : Int16 -> Float
foreign pure int16_to_float from "flick:rt" "toFloat64"

int16_to_bigint : Int16 -> BigInt
foreign pure int16_to_bigint from "flick:rt" "toBigInt"

int64_from_int : Int -> Int64
foreign pure int64_from_int from "flick:rt" "toInt64"

int64_to_float : Int64 -> Float
foreign pure int64_to_float from "flick:rt" "toFloat64"

int64_to_bigint : Int64 -> BigInt
foreign pure int64_to_bigint from "flick:rt" "toBigInt"

uint8_from_int : Int -> UInt8
foreign pure uint8_from_int from "flick:rt" "toUInt8"

uint8_to_float : UInt8 -> Float
foreign pure uint8_to_float from "flick:rt" "toFloat64"

uint8_to_bigint : UInt8 -> BigInt
foreign pure uint8_to_bigint from "flick:rt" "toBigInt"

uint16_from_int : Int -> UInt16
foreign pure uint16_from_int from "flick:rt" "toUInt16"

uint16_to_float : UInt16 -> Float
foreign pure uint16_to_float from "flick:rt" "toFloat64"

uint16_to_bigint : UInt16 -> BigInt
foreign pure uint16_to_bigint from "flick:rt" "toBigInt"

uint32_from_int : Int -> UInt32
foreign pure uint32_from_int from "flick:rt" "toUInt32"

uint32_to_float : UInt32 -> Float
foreign pure uint32_to_float from "flick:rt" "toFloat64"

uint32_to_bigint : UInt32 -> BigInt
foreign pure uint32_to_bigint from "flick:rt" "toBigInt"

uint64_from_int : Int -> UInt64
foreign pure uint64_from_int from "flick:rt" "toUInt64"

uint64_to_float : UInt64 -> Float
foreign pure uint64_to_float from "flick:rt" "toFloat64"

uint64_to_bigint : UInt64 -> BigInt
foreign pure uint64_to_bigint from "flick:rt" "toBigInt"

float32_from_int : Int -> Float32
foreign pure float32_from_int from "flick:rt" "toFloat32"

float32_from_float : Float -> Float32
foreign pure float32_from_float from "flick:rt" "toFloat32"

float32_to_float : Float32 -> Float
foreign pure float32_to_float from "flick:rt" "toFloat64"

instance Numeric Int8 =
  let add a b = a + b
  let sub a b = a - b
  let mul a b = a * b
  let div a b = a / b
  let rem a b = a % b
  let pow a b = a ** b
  let negate a = -a
  let from_int n = int8_from_int n
  let to_float n = int8_to_float n
  let lt a b = a < b
  let le a b = a <= b
  let gt a b = a > b
  let ge a b = a >= b

