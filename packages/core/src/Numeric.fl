/// The numeric types as classes, for functions over any of them: `Numeric`
/// holds `Int`, `Float` and `BigInt`, `Integer` the integers, `Floating`
/// `Float`. The classes are closed: this module has every instance, and a
/// program cannot declare another. On a type variable with one of them, the
/// operators and number literals use its methods.
module Numeric exposing (..)

@lang numeric
class Ord a => Numeric a =
  @lang add
  add : a -> a -> a
  @lang sub
  sub : a -> a -> a
  @lang mul
  mul : a -> a -> a
  @lang div
  div : a -> a -> a
  @lang rem
  rem : a -> a -> a
  @lang pow
  pow : a -> a -> a
  @lang negate
  negate : a -> a
  @lang from_int
  from_int : Int -> a
  to_float : a -> Float
  @lang lt
  lt : a -> a -> Bool
  @lang le
  le : a -> a -> Bool
  @lang gt
  gt : a -> a -> Bool
  @lang ge
  ge : a -> a -> Bool

@lang integer
class Numeric a => Integer a =
  to_bigint : a -> BigInt

@lang floating
class Numeric a => Floating a =
  @lang from_float
  from_float : Float -> a

bigint_of : Int -> BigInt
foreign pure bigint_of from global "BigInt"

float_of_bigint : BigInt -> Float
foreign pure float_of_bigint from global "Number"

instance Numeric Int =
  let add a b = a + b
  let sub a b = a - b
  let mul a b = a * b
  let div a b = a / b
  let rem a b = a % b
  let pow a b = a ** b
  let negate a = -a
  let from_int n = n
  let to_float n = Int.to_float n
  let lt a b = a < b
  let le a b = a <= b
  let gt a b = a > b
  let ge a b = a >= b

instance Numeric Float =
  let add a b = a + b
  let sub a b = a - b
  let mul a b = a * b
  let div a b = a / b
  let rem a b = a % b
  let pow a b = a ** b
  let negate a = -a
  let from_int n = Int.to_float n
  let to_float x = x
  let lt a b = a < b
  let le a b = a <= b
  let gt a b = a > b
  let ge a b = a >= b

instance Numeric BigInt =
  let add a b = a + b
  let sub a b = a - b
  let mul a b = a * b
  let div a b = a / b
  let rem a b = a % b
  let pow a b = a ** b
  let negate a = -a
  let from_int n = bigint_of n
  let to_float n = float_of_bigint n
  let lt a b = a < b
  let le a b = a <= b
  let gt a b = a > b
  let ge a b = a >= b

instance Integer Int =
  let to_bigint n = bigint_of n

instance Integer BigInt =
  let to_bigint n = n

instance Floating Float =
  let from_float x = x
