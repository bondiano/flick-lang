/// Outcomes as data: `Ok value` or `Err error`.
module Result exposing (
  map,
  map_err,
  bind,
  with_default,
  is_ok,
  is_err,
  to_option,
  from_option,
  all,
  fail_void,
  void,
  filter_or_fail,
  flip,
  get_failure,
  lift_predicate,
  map_both,
  match_,
  merge,
  or_else,
  succeed_none,
  succeed_some,
  transpose_option,
  transpose_map_option,
)

/// `Ok (f x)` for `Ok x`.
map : (forall v. a^v -> b)^c -> (Result e a)^d -> (Result e b)^(c + d)
let map f result =
  match result with
  | Err e -> Err e
  | Ok x -> Ok (f x)

/// `Err (f e)` for `Err e`.
map_err : (e -> x)^c -> Result e a -> Result x a
let map_err f result =
  match result with
  | Err e -> Err (f e)
  | Ok x -> Ok x

@lang result_bind
/// `f x` for `Ok x`.
bind : (a -> Result e b)^c -> Result e a -> Result e b
let bind f result =
  match result with
  | Err e -> Err e
  | Ok x -> f x

/// The value of `Ok`, `fallback` for `Err`.
with_default : a -> Result e a -> a
let with_default fallback result =
  match result with
  | Err _ -> fallback
  | Ok x -> x

/// Whether the result is `Ok`.
is_ok : Result e a -> Bool
let is_ok result =
  match result with
  | Err _ -> false
  | Ok _ -> true

/// Whether the result is `Err`.
is_err : Result e a -> Bool
let is_err result = not (is_ok result)

/// `Some x` for `Ok x`, `None` for `Err`.
to_option : Result e a -> Option a
let to_option result =
  match result with
  | Err _ -> None
  | Ok x -> Some x

/// `Ok x` for `Some x`, `Err failure` for `None`.
from_option : e -> Option a -> Result e a
let from_option failure value =
  match value with
  | None -> Err failure
  | Some x -> Ok x

/// `Ok` of the values when every result is `Ok`, the first `Err` otherwise.
all : List (Result e a) -> Result e (List a)
foreign pure all from "flick:Result" "all"

/// `Err ()`.
fail_void : Result Unit a
foreign pure fail_void from "flick:Result" "failVoid"

/// `Ok ()`.
void : Result e Unit
foreign pure void from "flick:Result" "void"

/// `Ok x` kept when `p x` holds, `Err (or_fail_with x)` otherwise.
filter_or_fail : (a -> Bool)^c -> (a -> e)^c -> (Result e a -> Result e a)^c
foreign pure filter_or_fail from "flick:Result" "filterOrFail"
  arity 2
  retention call

/// `Ok` and `Err` swapped.
flip : Result e a -> Result a e
foreign pure flip from "flick:Result" "flip"

/// The error of an `Err`.
get_failure : Result e a -> Option e
foreign pure get_failure from "flick:Result" "getFailure"

/// `Ok x` when `p x` holds, `Err (or_fail_with x)` otherwise.
lift_predicate : (a -> Bool) -> (a -> e) -> a -> Result e a
foreign pure lift_predicate from "flick:Result" "liftPredicate"
  arity 2

/// The error mapped by `onFailure`, the value by `onSuccess`.
map_both : { onFailure : e -> e2; onSuccess : a -> a2 } -> Result e a -> Result e2 a2
foreign pure map_both from "flick:Result" "mapBoth"
  arity 1

/// `onFailure e` for `Err e`, `onSuccess x` for `Ok x`.
match_ : { onFailure : e -> b; onSuccess : a -> b } -> Result e a -> b
foreign pure match_ from "flick:Result" "match"
  arity 1

/// The value of either side.
merge : Result a a -> a
foreign pure merge from "flick:Result" "merge"

/// `Ok x` kept, `Err e` replaced by `that e`.
or_else : (e -> Result e2 a)^c -> Result e a -> Result e2 a
foreign pure or_else from "flick:Result" "orElse"
  arity 1
  retention call

/// `Ok None`.
succeed_none : Result e (Option a)
foreign pure succeed_none from "flick:Result" "succeedNone"

/// `Ok (Some x)`.
succeed_some : a -> Result e (Option a)
foreign pure succeed_some from "flick:Result" "succeedSome"

/// An optional result as a result of an option: `None` is `Ok None`.
transpose_option : Option (Result e a) -> Result e (Option a)
foreign pure transpose_option from "flick:Result" "transposeOption"

/// `f` of the value of an option, the result moved out: `None` is `Ok None`.
transpose_map_option : (a -> Result e b)^c -> Option a -> Result e (Option b)
foreign pure transpose_map_option from "flick:Result" "transposeMapOption"
  arity 1
  retention call
