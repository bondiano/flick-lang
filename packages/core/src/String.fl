/// Operations on strings. Lengths and indices count UTF-16 code units, as
/// in JS; the subject comes last, so `s |> String.take_left 3` reads in
/// order. Regular expressions are in `RegExp`.
module String exposing (..)

import String.Case
import String.Text

/// A Unicode normalization form, as `String.normalize` takes it.
type NormalForm = NFC | NFD | NFKC | NFKD

/// Without the whitespace at both ends.
trim : String -> String
let trim s = trim_end (trim_start s)
  @native "flick:String" "trim" when js || go

/// Without the whitespace at the start.
trim_start : String -> String
let trim_start s =
  // the white space and line terminators of JS, all single code units
  blank : Int -> Bool
  let blank c =
    (c >= 9 && c <= 13)
      || c == 32
      || c == 160
      || c == 5760
      || (c >= 8192 && c <= 8202)
      || c == 8232
      || c == 8233
      || c == 8239
      || c == 8287
      || c == 12288
      || c == 65279
  first : Int -> Int
  let rec first i =
    match char_code_at i s with
    | Some c -> if blank c then first (i + 1) else i
    | None -> i
  slice (first 0) (length s) s
  @native "flick:String" "trimStart" when js || go

/// Without the whitespace at the end.
trim_end : String -> String
let trim_end s =
  // the white space and line terminators of JS, all single code units
  blank : Int -> Bool
  let blank c =
    (c >= 9 && c <= 13)
      || c == 32
      || c == 160
      || c == 5760
      || (c >= 8192 && c <= 8202)
      || c == 8232
      || c == 8233
      || c == 8239
      || c == 8287
      || c == 12288
      || c == 65279
  kept : Int -> Int
  let rec kept n =
    match char_code_at (n - 1) s with
    | Some c -> if blank c then kept (n - 1) else n
    | None -> n
  slice 0 (kept (length s)) s
  @native "flick:String" "trimEnd" when js || go

/// The number of UTF-16 code units, as JS `length`.
length : String -> Int
foreign pure length from "flick:String" "length"

/// Whether the string is `""`.
is_empty : String -> Bool
let is_empty s = s == ""

/// Whether the string has a code unit.
is_non_empty : String -> Bool
let is_non_empty s = length s > 0
  @native "flick:String" "isNonEmpty" when js || go

/// The parts between the separators: `"a,b" |> String.split ","`.
split : String -> String -> List String
let split separator s = String.Text.split separator s
  @native "flick:String" "split" when js || go
    arity 1

/// The parts with the separator between them.
join : String -> List String -> String
let join separator parts =
  rest : String -> List String -> String
  let rec rest text more =
    match more with
    | [part, ...others] -> rest (text ++ separator ++ part) others
    | [] -> text
  match parts with
  | [first, ...others] -> rest first others
  | [] -> ""
  @native "flick:rt" "stringJoin" when js || go

/// Whether `part` occurs in the string.
contains : String -> String -> Bool
let contains part s = index_of part s != None
  @native "flick:String" "includes" when js || go
    arity 1

/// Whether the string starts with `prefix`.
starts_with : String -> String -> Bool
let starts_with prefix s = slice 0 (length prefix) s == prefix
  @native "flick:String" "startsWith" when js || go
    arity 1

/// Whether the string ends with `suffix`.
ends_with : String -> String -> Bool
let ends_with suffix s =
  let n = length s
  let width = length suffix
  width <= n && slice (n - width) n s == suffix
  @native "flick:String" "endsWith" when js || go
    arity 1

/// The position of the first occurrence of `part`.
index_of : String -> String -> Option Int
foreign pure index_of from "flick:String" "indexOf"
  arity 1

/// The position of the last occurrence of `part`.
last_index_of : String -> String -> Option Int
foreign pure last_index_of from "flick:String" "lastIndexOf"
  arity 1

/// Upper case, by the default Unicode rules.
to_upper : String -> String
let to_upper s = String.Case.upper s
  @native "flick:String" "toUpperCase" when js || go

/// Lower case, by the default Unicode rules.
to_lower : String -> String
let to_lower s = String.Case.lower s
  @native "flick:String" "toLowerCase" when js || go

/// Upper case by the rules of the locale `locale` (a BCP 47 tag; an invalid
/// one is a defect).
to_locale_upper : String -> String -> String
foreign pure to_locale_upper from "flick:String" "toLocaleUpperCase"
  arity 1

/// Lower case by the rules of the locale `locale`.
to_locale_lower : String -> String -> String
foreign pure to_locale_lower from "flick:String" "toLocaleLowerCase"
  arity 1

/// The first character in upper case.
capitalize : String -> String
let capitalize s = String.Case.upper (slice 0 1 s) ++ slice 1 (length s) s
  @native "flick:String" "capitalize" when js || go

/// The first character in lower case.
uncapitalize : String -> String
let uncapitalize s = String.Case.lower (slice 0 1 s) ++ slice 1 (length s) s
  @native "flick:String" "uncapitalize" when js || go

/// The code units from `start` up to `end`, as JS `slice`: negative
/// positions count from the end.
slice : Int -> Int -> String -> String
foreign pure slice from "flick:String" "slice"
  arity 2

/// The code units between `start` and `end`, as JS `substring`: negative
/// positions are 0, and the two may come in either order.
substring : Int -> Int -> String -> String
let substring start end s =
  let n = length s
  let clamp i = if i < 0 then 0 else if i > n then n else i
  let (a, b) = (clamp start, clamp end)
  if a <= b then slice a b s else slice b a s
  @native "flick:String" "substring" when js || go
    arity 2

/// The first `n` code units.
take_left : Int -> String -> String
let take_left n s = slice 0 (if n > 0 then n else 0) s
  @native "flick:String" "takeLeft" when js || go
    arity 1

/// The last `n` code units.
take_right : Int -> String -> String
let take_right n s =
  let count = length s
  let k = if n <= 0 then 0 else if n > count then count else n
  slice (count - k) count s
  @native "flick:String" "takeRight" when js || go
    arity 1

/// The code unit at `index`; a negative one counts from the end.
at : Int -> String -> Option String
let at index s =
  let n = length s
  let i = if index < 0 then n + index else index
  if i >= 0 && i < n then Some (slice i (i + 1) s) else None
  @native "flick:String" "at" when js || go
    arity 1

/// The code unit at `index`, which must be in range.
char_at : Int -> String -> Option String
let char_at index s =
  if index >= 0 && index < length s then Some (slice index (index + 1) s) else None
  @native "flick:String" "charAt" when js || go
    arity 1

/// The UTF-16 code unit at `index`, as a number.
char_code_at : Int -> String -> Option Int
foreign pure char_code_at from "flick:String" "charCodeAt"
  arity 1

/// The code point starting at `index`.
code_point_at : Int -> String -> Option Int
let code_point_at index s =
  if index >= 0 && index < length s then
    let (cp, _) = String.Text.point_at s index
    Some cp
  else
    None
  @native "flick:String" "codePointAt" when js || go
    arity 1

/// Compares by the collation of the locale `locale`: `self |>
/// String.locale_compare "de" that`.
locale_compare : String -> String -> String -> Ordering
foreign pure locale_compare from "flick:String" "flickLocaleCompare"

/// The string in the Unicode normalization form.
normalize : NormalForm -> String -> String
foreign pure normalize from "flick:String" "flickNormalize"

/// Padded at the start with `fill`, repeated and cut, up to `length`.
pad_start : Int -> String -> String -> String
let pad_start target fill s = String.Text.padding target fill s ++ s
  @native "flick:String" "padStart" when js || go
    arity 2

/// Padded at the end with `fill`, repeated and cut, up to `length`.
pad_end : Int -> String -> String -> String
let pad_end target fill s = s ++ String.Text.padding target fill s
  @native "flick:String" "padEnd" when js || go
    arity 2

/// The string `n` times; a negative `n` counts as 0, a fraction is cut.
repeat : Int -> String -> String
let repeat n s = String.Text.repeat n s
  @native "flick:String" "repeat" when js || go
    arity 1

/// Every occurrence of `pattern` replaced by `replacement`, taken as it is.
replace_all : String -> String -> String -> String
let replace_all pattern replacement s = String.Text.replace_all pattern replacement s
  @native "flick:rt" "stringReplaceAll" when js || go

/// The lines, without their line breaks (`\n` or `\r\n`).
lines : String -> List String
let lines text =
  let count = length text
  // a line ends at `\n`, `\r` or `\r\n`; the text's end ends no empty one
  split : Int -> Int -> List String -> List String
  let rec split start i out =
    if i >= count then
      if start < count then out ++ [slice start count text] else out
    else
      match char_code_at i text with
      | Some 10 -> split (i + 1) (i + 1) (out ++ [slice start i text])
      | Some 13 ->
        let next = if char_code_at (i + 1) text == Some 10 then i + 2 else i + 1
        split next next (out ++ [slice start i text])
      | _ -> split start (i + 1) out
  split 0 0 []
  @native "flick:String" "flickLines" when js || go

/// The lines, each with its line break.
lines_with_separators : String -> List String
foreign pure lines_with_separators from "flick:String" "flickLinesWithSeparators"

/// Each line without its leading blanks and the `|` after them.
strip_margin : String -> String
foreign pure strip_margin from "flick:String" "stripMargin"

/// Each line without its leading blanks and the margin character after them.
strip_margin_with : String -> String -> String
foreign pure strip_margin_with from "flick:String" "stripMarginWith"
  arity 1

/// `snake_case` to `camelCase`.
snake_to_camel : String -> String
foreign pure snake_to_camel from "flick:String" "snakeToCamel"

/// `snake_case` to `PascalCase`.
snake_to_pascal : String -> String
foreign pure snake_to_pascal from "flick:String" "snakeToPascal"

/// `snake_case` to `kebab-case`.
snake_to_kebab : String -> String
foreign pure snake_to_kebab from "flick:String" "snakeToKebab"

/// `camelCase` to `snake_case`.
camel_to_snake : String -> String
foreign pure camel_to_snake from "flick:String" "camelToSnake"

/// `PascalCase` to `snake_case`.
pascal_to_snake : String -> String
foreign pure pascal_to_snake from "flick:String" "pascalToSnake"

/// `kebab-case` to `snake_case`.
kebab_to_snake : String -> String
foreign pure kebab_to_snake from "flick:String" "kebabToSnake"

/// The words in lower case, separated by spaces: `"fooBar"` is `"foo bar"`.
no_case : String -> String
foreign pure no_case from "flick:String" "noCase"

/// The words as `PascalCase`.
pascal_case : String -> String
foreign pure pascal_case from "flick:String" "pascalCase"

/// The words as `camelCase`.
camel_case : String -> String
foreign pure camel_case from "flick:String" "camelCase"

/// The words as `CONSTANT_CASE`.
constant_case : String -> String
foreign pure constant_case from "flick:String" "constantCase"

/// The words as a configuration key, `CONFIG_CASE`, keeping digits apart.
config_case : String -> String
foreign pure config_case from "flick:String" "configCase"

/// The words as `kebab-case`.
kebab_case : String -> String
foreign pure kebab_case from "flick:String" "kebabCase"

/// The words as `snake_case`.
snake_case : String -> String
foreign pure snake_case from "flick:String" "snakeCase"

/// The code points, each as a string.
chars : String -> List String
let chars s = String.Text.chars s
  @native "flick:rt" "stringChars" when js || go

/// The number in JS syntax; `-0` is `"-0"`.
from_number : Float -> String
foreign pure from_number from "flick:rt" "stringFromNumber"

/// The number a whole string spells in JS syntax, if any.
to_number : String -> Option Float
foreign pure to_number from "flick:rt" "stringToNumber"

/// A JSON string.
json : PureCodec Json String
foreign pure json from "flick:rt" "codecString"
