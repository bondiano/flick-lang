/// The core of `List`: folds, searches and access by index.
private module List.Core exposing (..)

/// `map` with each element's index.
map_indexed : (Int -> a -> b)^c -> List a -> List b
foreign pure map_indexed from "flick:rt" "listMapIndexed"
  arity 2
  retention call

/// Runs a runtime function on each element in order, for what it does.
each_effect : (a ->{r; e} Unit)^c -> List a ->{r; e} Unit
foreign effect each_effect from "flick:rt" "listEachEffect"
  retention call

/// Folds from the first element: `fold_left f init [a, b]` is `f (f init a) b`.
fold_left : (b -> a -> b)^c -> b -> (List a -> b)^c
let fold_left f init xs =
  let n = length xs
  step : Int -> b -> b
  let rec step i acc =
    if i >= n then
      acc
    else
      match get i xs with
      | Some x -> step (i + 1) (f acc x)
      | None -> acc
  step 0 init
  @native "flick:rt" "listFold" when js || go
    arity 3
    retention call

/// Folds from the last element: `fold_right f init [a, b]` is `f a (f b init)`.
fold_right : (a -> b -> b)^c -> b -> (List a -> b)^c
foreign pure fold_right from "flick:rt" "listFoldRight"
  arity 3
  retention call

/// `fold_left` with a runtime step, run in order.
fold_effect : (b -> a ->{r; e} b)^c -> b -> (List a ->{r; e} b)^c
foreign effect fold_effect from "flick:rt" "listFoldEffect"
  retention call

@lang list_filter
/// The elements that satisfy `p`, in order.
filter : (a -> Bool)^c -> List a -> List a
foreign pure filter from "flick:rt" "listFilter"
  arity 2
  retention call

/// The values of the `Some` results of `f`, in order.
filter_map : (a -> Option b)^c -> List a -> List b
foreign pure filter_map from "flick:rt" "listFilterMap"
  arity 2
  retention call

/// The lists `f` gives each element, joined.
flat_map : (a -> List b)^c -> List a -> List b
foreign pure flat_map from "flick:rt" "listFlatMap"
  arity 2
  retention call

/// The first element that satisfies `p`.
find : (a -> Bool)^c -> List a -> Option a
let find p xs =
  match find_index p xs with
  | Some i -> get i xs
  | None -> None
  @native "flick:rt" "listFind" when js || go
    arity 2
    retention call

/// The index of the first element that satisfies `p`.
find_index : (a -> Bool)^c -> List a -> Option Int
let find_index p xs =
  let n = length xs
  search : Int -> Option Int
  let rec search i =
    if i >= n then
      None
    else
      match get i xs with
      | Some x -> if p x then Some i else search (i + 1)
      | None -> None
  search 0
  @native "flick:rt" "listFindIndex" when js || go
    arity 2
    retention call

/// Whether some element satisfies `p`.
any : (a -> Bool)^c -> List a -> Bool
let any p xs =
  match find_index p xs with
  | Some _ -> true
  | None -> false
  @native "flick:rt" "listAny" when js || go
    arity 2
    retention call

/// Whether every element satisfies `p`.
all : (a -> Bool)^c -> List a -> Bool
let all p xs =
  match find_index (fun x -> not (p x)) xs with
  | Some _ -> false
  | None -> true
  @native "flick:rt" "listAll" when js || go
    arity 2
    retention call

/// The elements that satisfy `p`, and the others.
partition : (a -> Bool)^c -> List a -> (List a, List a)
foreign pure partition from "flick:rt" "listPartition"
  arity 2
  retention call

/// Sorts by `compare`, keeping equal elements in their order.
sort_by : (a -> a -> Ordering)^c -> List a -> List a
let sort_by order xs =
  let n = length xs
  // each pass merges every two neighbouring sorted runs of `width`
  pass : Int -> List a -> List a
  let rec pass width ys =
    if width >= n then
      ys
    else
      below : Int -> Int -> Bool
      let below p q =
        match (get p ys, get q ys) with
        | (Some x, Some y) -> order x y == LT
        | _ -> false
      // where the `k`th merged element is in `ys`: of the first `k - base`
      // of a merge, `i` from the first run, found by bisection
      source : Int -> Int
      let source k =
        let base = k - k % (2 * width)
        let off = k - base
        let first_count = if n - base < width then n - base else width
        let rest = n - base - width
        let second_count = if rest < 0 then 0 else if rest < width then rest else width
        split : Int -> Int -> Int
        let rec split lo hi =
          if lo >= hi then
            lo
          else
            let i = (lo + hi) / 2
            if below (base + width + off - i - 1) (base + i) then split lo i else split (i + 1) hi
        let low = if off > second_count then off - second_count else 0
        let i = split low (if off < first_count then off else first_count)
        let j = off - i
        if i < first_count && (j >= second_count || not (below (base + width + j) (base + i))) then
          base + i
        else
          base + width + j
      pass (2 * width) (picked n source ys)
  pass 1 xs
  @native "flick:rt" "listSortBy" when js || go
    arity 2
    retention call

/// Sorts by the total order of `Ord`, keeping equal elements in their order:
/// numbers ascend with NaN last.
sort : Ord a => List a -> List a
let sort xs = sort_by compare xs

/// Whether an element equals `x`.
contains : Eq a => a -> List a -> Bool
let contains x xs = any (fun y -> eq x y) xs

/// The greatest element by `Ord`.
maximum : Ord a => List a -> Option a
let maximum xs =
  fold_left
    (fun best x ->
      match best with
      | None -> Some x
      | Some b -> if compare x b == GT then Some x else best
    )
    None
    xs

/// The least element by `Ord`.
minimum : Ord a => List a -> Option a
let minimum xs =
  fold_left
    (fun best x ->
      match best with
      | None -> Some x
      | Some b -> if compare x b == LT then Some x else best
    )
    None
    xs

/// How many elements the list has.
length : List a -> Int
foreign pure length from "flick:rt" "listLength"

/// Whether the list has no element.
is_empty : List a -> Bool
let is_empty xs = length xs == 0

/// The element at `index`, counting from 0.
get : Int -> List a -> Option a
foreign pure get from "flick:rt" "listGet"

/// The list with the element at `index` replaced; out of range, unchanged.
set : Int -> a -> List a -> List a
let set i x xs =
  initialize (length xs) (fun j ->
    match get j xs with
    | Some y -> if j == i then x else y
    | None -> x
  )
  @native "flick:rt" "listSet" when js || go

/// The first element.
head : List a -> Option a
let head xs = get 0 xs

/// The last element.
last : List a -> Option a
let last xs = get (length xs - 1) xs

/// The list of one element.
singleton : a -> List a
let singleton x = [x]

/// `n` copies of `x`.
repeat : Int -> a -> List a
foreign pure repeat from "flick:rt" "listRepeat"

/// `[from, from + 1, …]` below `until`.
range : Int -> Int -> List Int
let range start until =
  if until <= start then [] else initialize (until - start) (fun i -> start + i)
  @native "flick:rt" "listRange" when js || go

/// The list of `f 0`, …, `f (n - 1)`.
initialize : Int -> (Int -> a)^c -> List a
foreign pure initialize from "flick:rt" "listInitialize"
  retention call

/// The elements in reverse order.
reverse : List a -> List a
let reverse xs =
  let n = length xs
  picked n (fun i -> n - 1 - i) xs
  @native "flick:rt" "listReverse" when js || go

/// `append xs ys` is `xs ++ ys`: `ys |> append xs` puts `xs` in front.
append : List a -> List a -> List a
let append xs ys = xs ++ ys

/// The lists joined.
concat : List (List a) -> List a
foreign pure concat from "flick:rt" "listConcat"

/// The first `n` elements.
take : Int -> List a -> List a
let take n xs = picked (within n xs) (fun i -> i) xs
  @native "flick:rt" "listTake" when js || go

/// Every element but the first `n`.
drop : Int -> List a -> List a
let drop n xs =
  let k = within n xs
  picked (length xs - k) (fun i -> i + k) xs
  @native "flick:rt" "listDrop" when js || go

/// `n` clamped into `0..length xs`.
within : Int -> List a -> Int
let within n xs =
  let count = length xs
  if n < 0 then 0 else if n > count then count else n

/// `[xs[at 0], …, xs[at (n - 1)]]`, each index one of `xs`: the Flick body
/// of the functions that copy elements by their position.
picked : Int -> (Int -> Int) -> List a -> List a
let picked n at xs =
  match xs with
  | [] -> []
  | [first, ..._] ->
    initialize n (fun i ->
      match get (at i) xs with
      | Some x -> x
      | None -> first
    )

/// The elements from `start` up to `end`, as JS `slice`: it copies only them.
slice : Int -> Int -> List a -> List a
foreign pure slice from "flick:rt" "listSlice"

/// The pairs of the elements at each index of both, as long as the shorter.
zip : List a -> List b -> List (a, b)
foreign pure zip from "flick:rt" "listZip"

/// The firsts and the seconds of the pairs.
unzip : List (a, b) -> (List a, List b)
foreign pure unzip from "flick:rt" "listUnzip"

/// The sum of the numbers.
sum : Numeric.Numeric a => List a -> a
let sum xs = fold_left (fun total x -> total + x) 0 xs

/// The product of the numbers.
product : Numeric.Numeric a => List a -> a
let product xs = fold_left (fun total x -> total * x) 1 xs
