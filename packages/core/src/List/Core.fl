/// The core of `List`: folds, searches and access by index.
private module List.Core exposing (..)

/// `map` with each element's index.
map_indexed : (Int -> a -> b)^c -> List a -> List b
foreign pure map_indexed from "@flick-lang/effect-ts" "listMapIndexed"
  arity 2
  retention call

/// Runs a runtime function on each element in order, for what it does.
each_effect : (a ->{r; e} Unit)^c -> List a ->{r; e} Unit
foreign effect each_effect from "@flick-lang/effect-ts" "listEachEffect"
  reviewed "effect@4.1.2 sha256:b1c62c32136cf403"
  retention call

/// Folds from the first element: `fold_left f init [a, b]` is `f (f init a) b`.
fold_left : (b -> a -> b)^c -> b -> (List a -> b)^c
foreign pure fold_left from "@flick-lang/effect-ts" "listFold"
  reviewed "effect@4.1.2 sha256:f9f3cb8097473b9a"
  arity 3
  retention call

/// Folds from the last element: `fold_right f init [a, b]` is `f a (f b init)`.
fold_right : (a -> b -> b)^c -> b -> (List a -> b)^c
foreign pure fold_right from "@flick-lang/effect-ts" "listFoldRight"
  reviewed "effect@4.1.2 sha256:f4b0f812b7a90bf5"
  arity 3
  retention call

/// `fold_left` with a runtime step, run in order.
fold_effect : (b -> a ->{r; e} b)^c -> b -> (List a ->{r; e} b)^c
foreign effect fold_effect from "@flick-lang/effect-ts" "listFoldEffect"
  retention call

@lang list_filter
/// The elements that satisfy `p`, in order.
filter : (a -> Bool)^c -> List a -> List a
foreign pure filter from "@flick-lang/effect-ts" "listFilter"
  reviewed "effect@4.1.2 sha256:0d0d5816fea5fabe"
  arity 2
  retention call

/// The values of the `Some` results of `f`, in order.
filter_map : (a -> Option b)^c -> List a -> List b
foreign pure filter_map from "@flick-lang/effect-ts" "listFilterMap"
  reviewed "effect@4.1.2 sha256:71ace19b419814b2"
  arity 2
  retention call

/// The lists `f` gives each element, joined.
flat_map : (a -> List b)^c -> List a -> List b
foreign pure flat_map from "@flick-lang/effect-ts" "listFlatMap"
  reviewed "effect@4.1.2 sha256:37e174dd96bf5c77"
  arity 2
  retention call

/// The first element that satisfies `p`.
find : (a -> Bool)^c -> List a -> Option a
foreign pure find from "@flick-lang/effect-ts" "listFind"
  reviewed "effect@4.1.2 sha256:67b59648cd02439d"
  arity 2
  retention call

/// The index of the first element that satisfies `p`.
find_index : (a -> Bool)^c -> List a -> Option Int
foreign pure find_index from "@flick-lang/effect-ts" "listFindIndex"
  reviewed "effect@4.1.2 sha256:74e1ef30d4775390"
  arity 2
  retention call

/// Whether some element satisfies `p`.
any : (a -> Bool)^c -> List a -> Bool
foreign pure any from "@flick-lang/effect-ts" "listAny"
  reviewed "effect@4.1.2 sha256:42b6945cc2f397cd"
  arity 2
  retention call

/// Whether every element satisfies `p`.
all : (a -> Bool)^c -> List a -> Bool
foreign pure all from "@flick-lang/effect-ts" "listAll"
  reviewed "effect@4.1.2 sha256:8ca3b291bb5f5933"
  arity 2
  retention call

/// The elements that satisfy `p`, and the others.
partition : (a -> Bool)^c -> List a -> (List a, List a)
foreign pure partition from "@flick-lang/effect-ts" "listPartition"
  arity 2
  retention call

/// Sorts by `compare`, keeping equal elements in their order.
sort_by : (a -> a -> Ordering)^c -> List a -> List a
foreign pure sort_by from "@flick-lang/effect-ts" "listSortBy"
  reviewed "effect@4.1.2 sha256:26b8439a0f86a059"
  arity 2
  retention call

/// Sorts by the total order of `Ord`, keeping equal elements in their order:
/// numbers ascend with NaN last.
sort : Ord a => List a -> List a
let sort xs = sort_by compare xs

/// Whether an element equals `x`.
contains : Eq a => a -> List a -> Bool
let contains x xs = any (fun y -> eq x y) xs

/// The greatest element by `Ord`.
maximum : Ord a => List a -> Option a
let maximum xs =
  fold_left
    (fun best x ->
      match best with
      | None -> Some x
      | Some b -> if compare x b == GT then Some x else best
    )
    None
    xs

/// The least element by `Ord`.
minimum : Ord a => List a -> Option a
let minimum xs =
  fold_left
    (fun best x ->
      match best with
      | None -> Some x
      | Some b -> if compare x b == LT then Some x else best
    )
    None
    xs

/// How many elements the list has.
length : List a -> Int
foreign pure length from "@flick-lang/effect-ts" "listLength"
  reviewed "effect@4.1.2 sha256:e3bc0aabe62baf6c"

/// Whether the list has no element.
is_empty : List a -> Bool
let is_empty xs = length xs == 0

/// The element at `index`, counting from 0.
get : Int -> List a -> Option a
foreign pure get from "@flick-lang/effect-ts" "listGet"
  reviewed "effect@4.1.2 sha256:2c896b5ea54dbe9a"

/// The list with the element at `index` replaced; out of range, unchanged.
set : Int -> a -> List a -> List a
foreign pure set from "@flick-lang/effect-ts" "listSet"

/// The first element.
head : List a -> Option a
let head xs = get 0 xs

/// The last element.
last : List a -> Option a
let last xs = get (length xs - 1) xs

/// The list of one element.
singleton : a -> List a
let singleton x = [x]

/// `n` copies of `x`.
repeat : Int -> a -> List a
foreign pure repeat from "@flick-lang/effect-ts" "listRepeat"
  reviewed "effect@4.1.2 sha256:163da23fbce2ffe9"

/// `[from, from + 1, …]` below `until`.
range : Int -> Int -> List Int
foreign pure range from "@flick-lang/effect-ts" "listRange"

/// The list of `f 0`, …, `f (n - 1)`.
initialize : Int -> (Int -> a)^c -> List a
foreign pure initialize from "@flick-lang/effect-ts" "listInitialize"
  reviewed "effect@4.1.2 sha256:e33643fd5390dc62"
  retention call

/// The elements in reverse order.
reverse : List a -> List a
foreign pure reverse from "@flick-lang/effect-ts" "listReverse"
  reviewed "effect@4.1.2 sha256:e969bf75834545fd"

/// `append xs ys` is `xs ++ ys`: `ys |> append xs` puts `xs` in front.
append : List a -> List a -> List a
let append xs ys = xs ++ ys

/// The lists joined.
concat : List (List a) -> List a
foreign pure concat from "@flick-lang/effect-ts" "listConcat"
  reviewed "effect@4.1.2 sha256:79a7557ec647ea64"

/// The first `n` elements.
take : Int -> List a -> List a
foreign pure take from "@flick-lang/effect-ts" "listTake"
  reviewed "effect@4.1.2 sha256:12fb0eb32a21c379"

/// Every element but the first `n`.
drop : Int -> List a -> List a
foreign pure drop from "@flick-lang/effect-ts" "listDrop"
  reviewed "effect@4.1.2 sha256:1e7b70fa9118de64"

/// The elements from `start` up to `end`, as JS `slice`: it copies only them.
slice : Int -> Int -> List a -> List a
foreign pure slice from "@flick-lang/effect-ts" "listSlice"

/// The pairs of the elements at each index of both, as long as the shorter.
zip : List a -> List b -> List (a, b)
foreign pure zip from "@flick-lang/effect-ts" "listZip"
  reviewed "effect@4.1.2 sha256:acfd4eb64d599b89"

/// The firsts and the seconds of the pairs.
unzip : List (a, b) -> (List a, List b)
foreign pure unzip from "@flick-lang/effect-ts" "listUnzip"
  reviewed "effect@4.1.2 sha256:fc08e4a943b8119d"

/// The sum of the numbers.
sum : Numeric.Numeric a => List a -> a
let sum xs = fold_left (fun total x -> total + x) 0 xs

/// The product of the numbers.
product : Numeric.Numeric a => List a -> a
let product xs = fold_left (fun total x -> total * x) 1 xs
