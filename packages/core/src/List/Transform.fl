/// Lists combined, accumulated and taken apart: the part of `List` that
/// computes new elements.
private module List.Transform exposing (..)

import List.Core

/// `xs |> cartesian ys`: every pair of an element of `xs` and one of `ys`.
cartesian : List b -> List a -> List (a, b)
foreign pure cartesian from "flick:Array" "cartesian"
  arity 1

/// `f` of every pair of an element of `xs` and one of `ys`.
cartesian_with : List b -> (a -> b -> d)^c -> (List a -> List d)^c
foreign pure cartesian_with from "flick:Array" "cartesianWith"
  arity 2
  retention call

/// `xs |> zip_with ys f`: `f` of the elements at each index of both, as
/// long as the shorter one.
zip_with : List b -> (a -> b -> d)^c -> (List a -> List d)^c
foreign pure zip_with from "flick:Array" "zipWith"
  arity 2
  retention call

/// Maps each element while threading a state from the first: the final
/// state and the mapped list.
map_accum : s -> (s -> a -> (s, b))^c -> (List a -> (s, List b))^c
foreign pure map_accum from "flick:Array" "mapAccum"
  arity 2
  retention call

/// Every intermediate result of `fold_left`, `init` first.
scan : b -> (b -> a -> b)^c -> (List a -> NonEmpty.NonEmpty b)^c
foreign pure scan from "flick:Array" "scan"
  arity 2
  retention call

/// Every intermediate result of a fold from the last element, `init` last.
scan_right : b -> (b -> a -> b)^c -> (List a -> NonEmpty.NonEmpty b)^c
foreign pure scan_right from "flick:Array" "scanRight"
  arity 2
  retention call

/// `f` of each suffix of the list, longest first.
extend : (List a -> b)^c -> List a -> List b
foreign pure extend from "flick:Array" "extend"
  arity 1
  retention call

/// The `Ok` values of `f` over the elements, up to the first `Err`.
filter_map_while : (a -> Result e b)^c -> List a -> List b
foreign pure filter_map_while from "flick:Iterable" "flickFilterMapWhile"
  arity 1
  retention call

/// The values of the `Some` elements.
get_somes : List (Option a) -> List a
foreign pure get_somes from "flick:Array" "getSomes"

/// The errors of the `Err` elements.
get_failures : List (Result e a) -> List e
foreign pure get_failures from "flick:Array" "getFailures"

/// The values of the `Ok` elements.
get_successes : List (Result e a) -> List a
foreign pure get_successes from "flick:Array" "getSuccesses"

/// The `Ok` values and the `Err` errors.
separate : List (Result e a) -> (List a, List e)
foreign pure separate from "flick:Array" "separate"

/// The `Ok` values and the `Err` errors of `f` over the elements.
partition_map : (a -> Result f p)^c -> List a -> (List p, List f)
foreign pure partition_map from "flick:Array" "partition"
  arity 1
  retention call

/// The elements `f` produces from `seed`, until it gives `None`.
unfold : b -> (b -> Option (a, b))^c -> List a
foreign pure unfold from "flick:Array" "unfold"
  retention call

/// `f`, its `Some` as a one-element list and `None` as the empty one.
lift_option : (a -> Option b) -> a -> List b
foreign pure lift_option from "flick:Array" "liftOption"
  arity 1

/// `[x]` when `p x` holds, `[]` otherwise.
lift_predicate : (a -> Bool) -> a -> List a
foreign pure lift_predicate from "flick:Array" "liftPredicate"
  arity 1

/// `f`, its `Ok` as a one-element list and `Err` as the empty one.
lift_result : (a -> Result e b) -> a -> List b
foreign pure lift_result from "flick:Array" "liftResult"
  arity 1

/// Sorts by the `Ord` of the key `f` gives each element, keeping equal
/// ones in their order.
sort_with : Ord b => (a -> b) -> List a -> List a
let sort_with f xs = List.Core.sort_by (fun x y -> compare (f x) (f y)) xs

/// The list repeated `n` times.
repeat_all : Int -> List a -> List a
foreign pure repeat_all from "flick:Iterable" "flickRepeat"
  arity 1

/// `onEmpty ()` for the empty list, `onNonEmpty` of it otherwise.
match_ : { onEmpty : Unit -> b; onNonEmpty : NonEmpty.NonEmpty a -> b } -> List a -> b
foreign pure match_ from "flick:Array" "match"
  arity 1

/// `onEmpty ()` for the empty list, `onNonEmpty` of its head and tail otherwise.
match_left : { onEmpty : Unit -> b; onNonEmpty : a -> List a -> b } -> List a -> b
foreign pure match_left from "flick:Array" "flickMatchLeft"
  arity 1

/// `onEmpty ()` for the empty list, `onNonEmpty` of its init and last otherwise.
match_right : { onEmpty : Unit -> b; onNonEmpty : List a -> a -> b } -> List a -> b
foreign pure match_right from "flick:Array" "flickMatchRight"
  arity 1
