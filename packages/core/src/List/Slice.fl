/// Lists cut, padded and edited by position: the part of `List` that keeps
/// the elements as they are.
private module List.Slice exposing (..)

/// The empty list.
empty : List a
let empty = []

/// The last `n` elements.
take_right : Int -> List a -> List a
foreign pure take_right from "flick:Array" "takeRight"
  arity 1

/// Every element but the last `n`.
drop_right : Int -> List a -> List a
foreign pure drop_right from "flick:Array" "dropRight"
  arity 1

/// The longest prefix whose elements satisfy `p`.
take_while : (a -> Bool)^c -> List a -> List a
foreign pure take_while from "flick:Array" "takeWhile"
  arity 1
  retention call

/// The list without its longest prefix whose elements satisfy `p`.
drop_while : (a -> Bool)^c -> List a -> List a
foreign pure drop_while from "flick:Array" "dropWhile"
  arity 1
  retention call

/// The `Ok` values of `f` over the elements, up to the first `Err`.
take_while_filter : (a -> Result e b)^c -> List a -> List b
foreign pure take_while_filter from "flick:Array" "takeWhileFilter"
  arity 1
  retention call

/// The list from the first element for which `f` gives an `Err`.
drop_while_filter : (a -> Result e b)^c -> List a -> List a
foreign pure drop_while_filter from "flick:Array" "dropWhileFilter"
  arity 1
  retention call

/// The longest prefix whose elements satisfy `p`, and the rest.
span : (a -> Bool)^c -> List a -> (List a, List a)
foreign pure span from "flick:Array" "span"
  arity 1
  retention call

/// The first `n` elements, and the rest.
split_at : Int -> List a -> (List a, List a)
foreign pure split_at from "flick:Array" "splitAt"
  arity 1

/// The list cut into `n` runs of about the same length.
split : Int -> List a -> List (List a)
foreign pure split from "flick:Array" "split"
  arity 1

/// The elements before the first one that satisfies `p`, and the rest.
split_where : (a -> Bool)^c -> List a -> (List a, List a)
foreign pure split_where from "flick:Array" "splitWhere"
  arity 1
  retention call

/// Runs of `n` elements; the last one may be shorter.
chunks_of : Int -> List a -> List (NonEmpty.NonEmpty a)
foreign pure chunks_of from "flick:Array" "chunksOf"
  arity 1

/// Every run of `n` adjacent elements, in order: a sliding window.
window : Int -> List a -> List (List a)
foreign pure window from "flick:Array" "window"
  arity 1

/// Repeatedly takes a value and the rest from what is left, until nothing is.
chop : (NonEmpty.NonEmpty a -> (b, List a))^c -> List a -> List b
foreign pure chop from "flick:Array" "chop"
  arity 1
  retention call

/// Every element after the first; `None` for the empty list.
tail : List a -> Option (List a)
foreign pure tail from "flick:Array" "tail"

/// Every element before the last; `None` for the empty list.
init : List a -> Option (List a)
foreign pure init from "flick:Array" "init"

/// Exactly `n` elements: cut, or filled up with `fill`.
pad : Int -> a -> List a -> List a
foreign pure pad from "flick:Array" "pad"
  arity 2

/// The elements rotated `n` places to the right; a negative `n` rotates left.
rotate : Int -> List a -> List a
foreign pure rotate from "flick:Array" "rotate"
  arity 1

/// `x` inserted before the element at index `i` (`i` may be the length);
/// `None` out of range.
insert_at : Int -> a -> List a -> Option (NonEmpty.NonEmpty a)
foreign pure insert_at from "flick:Array" "insertAt"
  arity 2

/// The list without the element at index `i`; out of range, unchanged.
remove : Int -> List a -> List a
foreign pure remove from "flick:Array" "remove"
  arity 1

/// The element at index `i` replaced by `f` of it; `None` out of range.
modify : Int -> (a -> a)^c -> List a -> Option (List a)
foreign pure modify from "flick:Array" "modify"
  arity 2
  retention call

/// The element at index `i` replaced by `x`; `None` out of range.
replace : Int -> a -> List a -> Option (List a)
foreign pure replace from "flick:Array" "replace"
  arity 2

/// `middle` between each two adjacent elements.
intersperse : a -> List a -> List a
foreign pure intersperse from "flick:Array" "intersperse"
  arity 1

/// `xs |> append_all ys` is `xs ++ ys`.
append_all : List a -> List a -> List a
foreign pure append_all from "flick:Array" "appendAll"
  arity 1
