/// Lists searched, compared as sets and grouped: the part of `List` that
/// relates elements to each other. The variants without `_with` use `Eq`.
private module List.Search exposing (..)

/// The last element that satisfies `p`.
find_last : (a -> Bool)^c -> List a -> Option a
foreign pure find_last from "flick:Array" "findLast"
  arity 1
  retention call

/// The index of the last element that satisfies `p`.
find_last_index : (a -> Bool)^c -> List a -> Option Int
foreign pure find_last_index from "flick:Array" "findLastIndex"
  arity 1
  retention call

/// The first element that satisfies `p`, with its index.
find_first_with_index : (a -> Bool)^c -> List a -> Option (a, Int)
foreign pure find_first_with_index from "flick:Array" "findFirstWithIndex"
  arity 1
  retention call

/// How many elements satisfy `p`.
count_by : (a -> Bool)^c -> List a -> Int
foreign pure count_by from "flick:Array" "countBy"
  arity 1
  retention call

/// Whether an element is `same` as `x`.
contains_with : (a -> a -> Bool)^c -> a -> List a -> Bool
foreign pure contains_with from "flick:Array" "containsWith"
  arity 1
  retention call

/// The first of each set of elements that are `same`, in order.
dedupe_with : (a -> a -> Bool)^c -> List a -> List a
foreign pure dedupe_with from "flick:Array" "dedupeWith"
  arity 1
  retention call

/// The first of each set of equal elements, in order.
dedupe : Eq a => List a -> List a
let dedupe xs = dedupe_with eq xs

/// The list without an element `same` as the one before it.
dedupe_adjacent_with : (a -> a -> Bool)^c -> List a -> List a
foreign pure dedupe_adjacent_with from "flick:Array" "dedupeAdjacentWith"
  arity 1
  retention call

/// The list without an element equal to the one before it.
dedupe_adjacent : Eq a => List a -> List a
let dedupe_adjacent xs = dedupe_adjacent_with eq xs

/// `xs |> difference_with same ys`: the elements of `xs` with none `same` in `ys`.
difference_with : (a -> a -> Bool)^c -> List a -> List a -> List a
foreign pure difference_with from "flick:Array" "differenceWith"
  arity 1
  retention call

/// `xs |> difference ys`: the elements of `xs` not in `ys`.
difference : Eq a => List a -> List a -> List a
let difference ys xs = difference_with eq ys xs

/// `xs |> intersection_with same ys`: the elements of `xs` with one `same` in `ys`.
intersection_with : (a -> a -> Bool)^c -> List a -> List a -> List a
foreign pure intersection_with from "flick:Array" "intersectionWith"
  arity 1
  retention call

/// `xs |> intersection ys`: the elements of `xs` also in `ys`.
intersection : Eq a => List a -> List a -> List a
let intersection ys xs = intersection_with eq ys xs

/// `xs |> union_with ys same`: `xs`, then the elements of `ys` with none
/// `same` in `xs`, without duplicates.
union_with : List a -> (a -> a -> Bool)^c -> (List a -> List a)^c
foreign pure union_with from "flick:Array" "unionWith"
  arity 2
  retention call

/// `xs |> union ys`: the elements of both, each once.
union : Eq a => List a -> List a -> List a
let union ys xs = union_with ys eq xs

/// Runs of adjacent elements that `same` relates to the first of their run.
group_with : (a -> a -> Bool)^c -> List a -> List (NonEmpty.NonEmpty a)
let group_with same xs =
  match NonEmpty.from_list xs with
  | None -> []
  | Some ne -> NonEmpty.to_list (NonEmpty.group_with same ne)

/// Runs of adjacent equal elements.
group : Eq a => List a -> List (NonEmpty.NonEmpty a)
let group xs = group_with eq xs

/// The elements under the key `f` gives each, in order.
group_by : (a -> String)^c -> List a -> Record.ReadonlyRecord (NonEmpty.NonEmpty a)
foreign pure group_by from "flick:Array" "groupBy"
  arity 1
  retention call

/// The strings joined with `separator` between them.
join : String -> List String -> String
foreign pure join from "flick:Array" "join"
  arity 1
