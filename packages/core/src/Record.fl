/// Row primitives: relations between records that the compiler solves from
/// their fields. A program cannot declare instances of them.
module Record exposing (..)

@lang label
/// A label as a value: `(Record.label : Label "name")`.
type Label (l : Symbol)

@lang field
/// `Field "x" T` is `{ x : T }`.
type Field (l : Symbol) a

@lang has_field
/// The record `r` has field `l` of type `a`.
class HasField (l : Symbol) r a | l r -> a

@lang lacks
/// The record `r` has no field `l`.
class Lacks (l : Symbol) r

@lang remove
/// `out` is `r` without its field `l`.
class Remove (l : Symbol) r out | l r -> out

@lang project
/// Every field of `out` is a field of `r` of the same type.
class Project r out

@lang union_disjoint
/// `a` and `b` have no label in common, and `out` has the fields of both.
class UnionDisjoint a b out | a b -> out

@lang map_fields
/// `out` has the labels of `r`, each field of type `t` becoming `f t`.
class Map (f : Type -> Type) r out | f r -> out

@lang labels
/// The labels of `r` are known: `labels` lists them in canonical order.
class Labels r

@lang record_label
label : Label l
foreign pure label from "flick:rt" "recordLabel"

get : HasField l r a => Label l -> r -> a
foreign pure get from "flick:rt" "recordGet"

extend : (Lacks l r, UnionDisjoint r (Field l a) out) => Label l -> a -> r -> out
foreign pure extend from "flick:rt" "recordExtend"

remove : Remove l r out => Label l -> r -> out
foreign pure remove from "flick:rt" "recordRemove"

/// The record with only the fields of `out`.
project : Project r out => r -> out
foreign pure project from "flick:rt" "recordProject"

merge_disjoint : UnionDisjoint a b out => a -> b -> out
foreign pure merge_disjoint from "flick:rt" "recordMergeDisjoint"

/// The labels of the record, in canonical order.
labels : Labels r => r -> List String
foreign pure labels from "flick:rt" "recordLabels"

/// A dictionary from string keys to values of one type, kept as a plain JS
/// object. Unlike a record, its keys are data.
type ReadonlyRecord a

instance Eq a => Eq (ReadonlyRecord a) =
  let eq x y = make_equivalence eq x y

instance Show a => Show (ReadonlyRecord a) =
  let show x = "Record " ++ show (to_entries x)

/// The dictionary without keys.
empty : Unit -> ReadonlyRecord a
foreign pure empty from "flick:Record" "empty"
  arity 0

/// Whether the dictionary has no key.
is_empty : ReadonlyRecord a -> Bool
foreign pure is_empty from "flick:Record" "isEmptyReadonlyRecord"

/// The dictionary of the pairs; a later key wins.
from_entries : List (String, a) -> ReadonlyRecord a
foreign pure from_entries from "flick:Record" "fromEntries"

/// The dictionary of the key and value `f` gives each element; a later key wins.
from_iterable_with : (a -> (String, b))^c -> List a -> ReadonlyRecord b
foreign pure from_iterable_with from "flick:Record" "fromIterableWith"
  arity 1
  retention call

/// The elements under the key `f` gives each; a later key wins.
from_iterable_by : (a -> String)^c -> List a -> ReadonlyRecord a
foreign pure from_iterable_by from "flick:Record" "fromIterableBy"
  arity 1
  retention call

/// The dictionary with `value` under each key.
from_keys : List String -> a -> ReadonlyRecord a
foreign pure from_keys from "flick:Struct" "Record"

/// The dictionary with the one key.
singleton : String -> a -> ReadonlyRecord a
foreign pure singleton from "flick:Record" "singleton"

/// `f` of each key and value, in key order.
collect : (String -> a -> b)^c -> ReadonlyRecord a -> List b
foreign pure collect from "flick:Record" "collect"
  arity 1
  retention call

/// The key and value pairs, in key order.
to_entries : ReadonlyRecord a -> List (String, a)
foreign pure to_entries from "flick:Record" "toEntries"

/// The keys, in order.
keys : ReadonlyRecord a -> List String
foreign pure keys from "flick:Record" "keys"

/// The values, in key order.
values : ReadonlyRecord a -> List a
foreign pure values from "flick:Record" "values"

/// How many keys the dictionary has.
size : ReadonlyRecord a -> Int
foreign pure size from "flick:Record" "size"

/// Whether the key is in the dictionary.
has : String -> ReadonlyRecord a -> Bool
foreign pure has from "flick:Record" "has"
  arity 1

/// The value under the key.
get_key : String -> ReadonlyRecord a -> Option a
foreign pure get_key from "flick:Record" "get"
  arity 1

/// The value under the key replaced by `f` of it; `None` without the key.
modify : String -> (a -> a)^c -> ReadonlyRecord a -> Option (ReadonlyRecord a)
foreign pure modify from "flick:Record" "modify"
  arity 2
  retention call

/// The value under the key replaced; `None` without the key.
replace : String -> a -> ReadonlyRecord a -> Option (ReadonlyRecord a)
foreign pure replace from "flick:Record" "replace"
  arity 2

/// The dictionary with `value` under the key, added or replaced.
set : String -> a -> ReadonlyRecord a -> ReadonlyRecord a
foreign pure set from "flick:Record" "set"
  arity 2

/// The dictionary without the key.
remove_key : String -> ReadonlyRecord a -> ReadonlyRecord a
foreign pure remove_key from "flick:Record" "remove"
  arity 1

/// The value under the key and the dictionary without it; `None` without the key.
pop : String -> ReadonlyRecord a -> Option (a, ReadonlyRecord a)
foreign pure pop from "flick:Record" "pop"
  arity 1

/// Each value replaced by `f` of it and its key.
map : (a -> String -> b)^c -> ReadonlyRecord a -> ReadonlyRecord b
foreign pure map from "flick:Record" "map"
  arity 1
  retention call

/// Each key replaced by `f` of it and its value; a later key wins.
map_keys : (String -> a -> String)^c -> ReadonlyRecord a -> ReadonlyRecord a
foreign pure map_keys from "flick:Record" "mapKeys"
  arity 1
  retention call

/// Each entry replaced by the key and value `f` gives of its value and key.
map_entries : (a -> String -> (String, b))^c -> ReadonlyRecord a -> ReadonlyRecord b
foreign pure map_entries from "flick:Record" "mapEntries"
  arity 1
  retention call

/// The entries whose value and key satisfy `p`.
filter : (a -> String -> Bool)^c -> ReadonlyRecord a -> ReadonlyRecord a
foreign pure filter from "flick:Record" "filter"
  arity 1
  retention call

/// The `Ok` values of `f` over each value and key.
filter_map : (a -> String -> Result e b)^c -> ReadonlyRecord a -> ReadonlyRecord b
foreign pure filter_map from "flick:Record" "filterMap"
  arity 1
  retention call

/// The `Ok` values and the `Err` errors of `f` over each value and key.
partition :
  (a -> String -> Result f p)^c -> ReadonlyRecord a -> (ReadonlyRecord p, ReadonlyRecord f)
foreign pure partition from "flick:Record" "partition"
  arity 1
  retention call

/// The values of the `Some` entries.
get_somes : ReadonlyRecord (Option a) -> ReadonlyRecord a
foreign pure get_somes from "flick:Record" "getSomes"

/// The errors of the `Err` entries.
get_failures : ReadonlyRecord (Result e a) -> ReadonlyRecord e
foreign pure get_failures from "flick:Record" "getFailures"

/// The values of the `Ok` entries.
get_successes : ReadonlyRecord (Result e a) -> ReadonlyRecord a
foreign pure get_successes from "flick:Record" "getSuccesses"

/// The `Ok` values and the `Err` errors.
separate : ReadonlyRecord (Result e a) -> (ReadonlyRecord a, ReadonlyRecord e)
foreign pure separate from "flick:Record" "separate"

/// Folds the values in key order, `f` seeing each value and key.
reduce : b -> (b -> a -> String -> b)^c -> (ReadonlyRecord a -> b)^c
foreign pure reduce from "flick:Record" "reduce"
  arity 2
  retention call

/// Whether every value and key satisfy `p`.
every : (a -> String -> Bool)^c -> ReadonlyRecord a -> Bool
foreign pure every from "flick:Record" "every"
  arity 1
  retention call

/// Whether some value and key satisfy `p`.
some : (a -> String -> Bool)^c -> ReadonlyRecord a -> Bool
foreign pure some from "flick:Record" "some"
  arity 1
  retention call

/// The first key and value, in key order, that satisfy `p`.
find_first : (a -> String -> Bool)^c -> ReadonlyRecord a -> Option (String, a)
foreign pure find_first from "flick:Record" "findFirst"
  arity 1
  retention call

/// `self |> union that combine`: the keys of both, `combine` of the two
/// values under a shared key.
union : ReadonlyRecord a -> (a -> a -> a)^c -> (ReadonlyRecord a -> ReadonlyRecord a)^c
foreign pure union from "flick:Record" "union"
  arity 2
  retention call

/// `self |> intersection that combine`: the shared keys, with `combine` of
/// the two values.
intersection : ReadonlyRecord b -> (a -> b -> d)^c -> (ReadonlyRecord a -> ReadonlyRecord d)^c
foreign pure intersection from "flick:Record" "intersection"
  arity 2
  retention call

/// `self |> difference that`: the entries whose key only one of the two has.
difference : ReadonlyRecord a -> ReadonlyRecord a -> ReadonlyRecord a
foreign pure difference from "flick:Record" "difference"
  arity 1

/// `self |> is_subrecord_by same that`: every entry of `self` is in `that`,
/// its value `same` as the one there.
is_subrecord_by : (a -> a -> Bool)^c -> ReadonlyRecord a -> ReadonlyRecord a -> Bool
foreign pure is_subrecord_by from "flick:Record" "isSubrecordBy"
  arity 1
  retention call

/// `self |> is_subrecord that`: every entry of `self` is in `that`, by `Eq`.
is_subrecord : Eq a => ReadonlyRecord a -> ReadonlyRecord a -> Bool
let is_subrecord that self = is_subrecord_by eq that self

/// Whether both have the same keys, with values `same` under each.
make_equivalence : (a -> a -> Bool)^c -> ReadonlyRecord a -> ReadonlyRecord a -> Bool
foreign pure make_equivalence from "flick:Record" "flickMakeEquivalence"
  arity 1
  retention call
