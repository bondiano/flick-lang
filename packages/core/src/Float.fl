/// Operations on binary64 floating-point numbers beyond the operators. `==`
/// is canonical equality: `NaN == NaN` and `0 == -0`.
module Float exposing (..)

/// JS `===`: `NaN` differs from itself, `0` equals `-0`.
strict_equal : Float -> Float -> Bool
foreign pure strict_equal from "flick:rt" "numberStrictEqual"

/// JS `Object.is`: `NaN` equals itself, `0` differs from `-0`.
same_value : Float -> Float -> Bool
foreign pure same_value from "flick:rt" "numberSameValue"

pi : Float
foreign pure pi from global "Math.PI"

@lang float_infinity
infinity : Float
foreign pure infinity from global "Infinity"

@lang float_nan
nan : Float
foreign pure nan from global "NaN"

is_nan : Float -> Bool
foreign pure is_nan from global "Number.isNaN"

is_finite : Float -> Bool
foreign pure is_finite from global "Number.isFinite"

is_integer : Float -> Bool
foreign pure is_integer from global "Number.isInteger"

is_safe_integer : Float -> Bool
foreign pure is_safe_integer from global "Number.isSafeInteger"

abs : Float -> Float
foreign pure abs from global "Math.abs"

floor : Float -> Float
foreign pure floor from global "Math.floor"

ceil : Float -> Float
foreign pure ceil from global "Math.ceil"

round : Float -> Float
foreign pure round from global "Math.round"

trunc : Float -> Float
foreign pure trunc from global "Math.trunc"

sqrt : Float -> Float
foreign pure sqrt from global "Math.sqrt"

/// The lesser of two numbers by the order where NaN is least.
min : Float -> Float -> Float
foreign pure min from "flick:Number" "min"
  arity 1

/// The greater of two numbers by the order where NaN is least.
max : Float -> Float -> Float
foreign pure max from "flick:Number" "max"
  arity 1

to_string : Float -> String
foreign pure to_string from "flick:rt" "stringFromNumber"

/// The number the string spells in JS syntax, `"NaN"` and the infinities
/// included; blank and malformed text are `None`.
parse : String -> Option Float
foreign pure parse from "flick:Number" "parse"

/// `self + that`: `x |> Float.sum 1`.
sum : Float -> Float -> Float
foreign pure sum from "flick:Number" "sum"
  arity 1

/// `self - that`: `10 |> Float.subtract 3` is 7.
subtract : Float -> Float -> Float
foreign pure subtract from "flick:Number" "subtract"
  arity 1

/// `self * that`.
multiply : Float -> Float -> Float
foreign pure multiply from "flick:Number" "multiply"
  arity 1

/// `self / that`; `None` when `that` is 0: `10 |> Float.divide 4` is 2.5.
divide : Float -> Float -> Option Float
foreign pure divide from "flick:Number" "divide"
  arity 1

/// The remainder of `self / divisor`, exact on decimals (`0.3 % 0.1` is 0);
/// NaN for a zero or non-finite operand.
remainder : Float -> Float -> Float
foreign pure remainder from "flick:Number" "remainder"
  arity 1

/// `n + 1`.
increment : Float -> Float
foreign pure increment from "flick:Number" "increment"

/// `n - 1`.
decrement : Float -> Float
foreign pure decrement from "flick:Number" "decrement"

/// The sum of the list, 0 when it is empty.
sum_all : List Float -> Float
foreign pure sum_all from "flick:Number" "sumAll"

/// The product of the list, 1 when it is empty.
multiply_all : List Float -> Float
foreign pure multiply_all from "flick:Number" "multiplyAll"

/// `self < that` by the order where NaN is least:
/// `x |> Float.is_less_than 3`.
is_less_than : Float -> Float -> Bool
foreign pure is_less_than from "flick:Number" "isLessThan"
  arity 1

/// `self <= that` by the order where NaN is least.
is_less_than_or_equal_to : Float -> Float -> Bool
foreign pure is_less_than_or_equal_to from "flick:Number" "isLessThanOrEqualTo"
  arity 1

/// `self > that` by the order where NaN is least.
is_greater_than : Float -> Float -> Bool
foreign pure is_greater_than from "flick:Number" "isGreaterThan"
  arity 1

/// `self >= that` by the order where NaN is least.
is_greater_than_or_equal_to : Float -> Float -> Bool
foreign pure is_greater_than_or_equal_to from "flick:Number" "isGreaterThanOrEqualTo"
  arity 1

/// Whether `self` lies within `minimum` and `maximum`, both included.
between : { minimum : Float; maximum : Float } -> Float -> Bool
foreign pure between from "flick:Number" "between"
  arity 1

/// `self` kept within `minimum` and `maximum`.
clamp : { minimum : Float; maximum : Float } -> Float -> Float
foreign pure clamp from "flick:Number" "clamp"
  arity 1

/// How `n` compares with 0; NaN is `LT`.
sign : Float -> Ordering
foreign pure sign from "flick:Number" "flickSign"

/// The least power of two at least `n`, and at least 2.
next_pow2 : Float -> Float
foreign pure next_pow2 from "flick:Number" "nextPow2"

/// Rounded to `precision` decimal places: `3.14159 |> Float.round_to 2`.
round_to : Float -> Float -> Float
foreign pure round_to from "flick:Number" "round"
  arity 1

/// `n` itself when it is a safe integer.
safe_integer : Float -> Option Float
foreign pure safe_integer from "flick:rt" "numberSafeInteger"

/// A finite JSON number: `NaN` and the infinities are refused when decoding
/// and when encoding.
json_finite : PureCodec Json Float
foreign pure json_finite from "flick:rt" "codecNumberFinite"

/// Every number: non-finite values and `-0` as the strings `"NaN"`,
/// `"Infinity"`, `"-Infinity"` and `"-0"`.
json : PureCodec Json Float
foreign pure json from "flick:rt" "codecNumberLossless"
