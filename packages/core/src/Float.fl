/// Operations on binary64 floating-point numbers beyond the operators. `==`
/// is canonical equality: `NaN == NaN` and `0 == -0`.
module Float exposing (
  strict_equal,
  same_value,
  pi,
  infinity,
  nan,
  is_nan,
  is_finite,
  is_integer,
  is_safe_integer,
  abs,
  floor,
  ceil,
  round,
  trunc,
  sqrt,
  log,
  min,
  max,
  to_string,
  parse,
  sum,
  subtract,
  multiply,
  divide,
  remainder,
  increment,
  decrement,
  sum_all,
  multiply_all,
  is_less_than,
  is_less_than_or_equal_to,
  is_greater_than,
  is_greater_than_or_equal_to,
  between,
  clamp,
  sign,
  next_pow2,
  round_to,
  safe_integer,
  json_finite,
  json,
)

/// JS `===`: `NaN` differs from itself, `0` equals `-0`.
strict_equal : Float -> Float -> Bool
let strict_equal a b = a <= b && a >= b
  @native "flick:rt" "numberStrictEqual" when js || go

/// JS `Object.is`: `NaN` equals itself, `0` differs from `-0`.
same_value : Float -> Float -> Bool
let same_value a b = if a == b then a != 0.0 || 1.0 / a == 1.0 / b else false
  @native "flick:rt" "numberSameValue" when js || go

pi : Float
let pi = 3.141592653589793
  @native "Math.PI" when js || go

@lang float_infinity
infinity : Float
let infinity = 1.0 / 0.0
  @native "Infinity" when js || go

@lang float_nan
nan : Float
let nan = 0.0 / 0.0
  @native "NaN" when js || go

/// The element at `i`, for the folds below: `List` comes after `Float`.
element_at : Int -> List a -> Option a
foreign pure element_at from "flick:rt" "listGet"

/// A whole number exactly, for `remainder`: `BigInt` comes after `Float`.
whole_of : Float -> Option BigInt
foreign pure whole_of from "flick:rt" "bigintFromNumber"

/// `trunc` of a whole `Float` as an `Int`, for the exponents `remainder`
/// reads.
to_int : Float -> Int
foreign pure to_int from "flick:rt" "intTruncate"

is_nan : Float -> Bool
let is_nan x = not (x <= x)
  @native "Number.isNaN" when js || go

is_finite : Float -> Bool
let is_finite x = x - x == 0.0
  @native "Number.isFinite" when js || go

is_integer : Float -> Bool
let is_integer x = is_finite x && floor x == x
  @native "Number.isInteger" when js || go

is_safe_integer : Float -> Bool
let is_safe_integer x = is_integer x && abs x <= 9007199254740991.0
  @native "Number.isSafeInteger" when js || go

abs : Float -> Float
let abs x = if x < 0.0 then -x else if x == 0.0 then 0.0 else x
  @native "Math.abs" when js || go

floor : Float -> Float
foreign pure floor from global "Math.floor"

ceil : Float -> Float
let ceil x = -(floor (-x))
  @native "Math.ceil" when js || go

round : Float -> Float
let round x =
  let f = floor x
  // the nearest integer, a tie toward +Infinity; `x - f` is exact where it decides
  if f == x then x else if x - f < 0.5 then f else if f + 1.0 == 0.0 then x * 0.0 else f + 1.0
  @native "Math.round" when js || go

trunc : Float -> Float
let trunc x = if x < 0.0 then ceil x else floor x
  @native "Math.trunc" when js || go

sqrt : Float -> Float
foreign pure sqrt from global "Math.sqrt"

/// The natural logarithm, as JS's `Math.log` gives it: fdlibm's, the same
/// bits on every target; `log 0.0` is `-Infinity` and a negative number
/// gives NaN.
log : Float -> Float
foreign pure log from global "Math.log"

/// The lesser of two numbers by the order where NaN is least.
min : Float -> Float -> Float
let min that self =
  if self == that || is_nan self then
    self
  else if is_nan that then
    that
  else if self < that then
    self
  else
    that
  @native "flick:Number" "min" when js || go
    arity 1

/// The greater of two numbers by the order where NaN is least.
max : Float -> Float -> Float
let max that self =
  if self == that || is_nan that then
    self
  else if is_nan self then
    that
  else if self > that then
    self
  else
    that
  @native "flick:Number" "max" when js || go
    arity 1

to_string : Float -> String
foreign pure to_string from "flick:rt" "stringFromNumber"

/// The number the string spells in JS syntax, `"NaN"` and the infinities
/// included; blank and malformed text are `None`.
parse : String -> Option Float
let parse s =
  if s == "NaN" then
    Some (0.0 / 0.0)
  else if s == "Infinity" then
    Some (1.0 / 0.0)
  else if s == "-Infinity" then
    Some (-1.0 / 0.0)
  else
    match String.to_number s with
    | Some n -> if is_nan n then None else Some n
    | None -> None
  @native "flick:Number" "parse" when js || go

/// `self + that`: `x |> Float.sum 1`.
sum : Float -> Float -> Float
let sum that self = self + that
  @native "flick:Number" "sum" when js || go
    arity 1

/// `self - that`: `10 |> Float.subtract 3` is 7.
subtract : Float -> Float -> Float
let subtract that self = self - that
  @native "flick:Number" "subtract" when js || go
    arity 1

/// `self * that`.
multiply : Float -> Float -> Float
let multiply that self = self * that
  @native "flick:Number" "multiply" when js || go
    arity 1

/// `self / that`; `None` when `that` is 0: `10 |> Float.divide 4` is 2.5.
divide : Float -> Float -> Option Float
let divide that self = if that == 0.0 then None else Some (self / that)
  @native "flick:Number" "divide" when js || go
    arity 1

/// The remainder of `self / divisor`, exact on decimals (`0.3 % 0.1` is 0);
/// NaN for a zero or non-finite operand.
remainder : Float -> Float -> Float
let remainder divisor self =
  // `n` as `c × 10^e` with the digits JS writes `n` with: `toExponential`'s,
  // which `show` writes too, of a number that is not whole, and the number
  // itself of a whole one
  scientific : Float -> (BigInt, Int)
  let scientific n =
    match whole_of n with
    | Some whole -> (whole, 0)
    | None ->
      let text = show (abs n)
      let e = String.index_of "e" text
      let mantissa =
        match e with
        | Some at -> String.slice 0 at text
        | None -> text
      let point = String.index_of "." mantissa
      let whole =
        match point with
        | Some at -> String.slice 0 at mantissa
        | None -> mantissa
      let fraction =
        match point with
        | Some at -> String.slice (at + 1) (String.length mantissa) mantissa
        | None -> ""
      zeros : Int -> Int
      let rec zeros i =
        match String.char_code_at i fraction with
        | Some 48 -> zeros (i + 1)
        | _ -> i
      // the decimal exponent of the first significant digit
      let first =
        match e with
        | Some at ->
          match String.to_number (String.slice (at + 1) (String.length text) text) with
          | Some x -> to_int x
          | None -> 0
        | None -> if whole == "0" then -1 - zeros 0 else String.length whole - 1
      let digits =
        if whole == "0" then
          String.slice (zeros 0) (String.length fraction) fraction
        else
          whole ++ fraction
      value : BigInt -> Int -> BigInt
      let rec value acc i =
        match String.char_code_at i digits with
        | Some c -> value (acc * 10n + into (c - 48)) (i + 1)
        | None -> acc
      let coefficient = value 0n 0
      (if n < 0.0 then -coefficient else coefficient, first - String.length digits + 1)
  if not (is_finite self) || not (is_finite divisor) || divisor == 0.0 then
    0.0 / 0.0
  else if is_integer self && is_integer divisor then
    self % divisor
  else
    let (sc, se) = scientific self
    let (dc, de) = scientific divisor
    let e = if se < de then se else de
    let out = (sc * 10n ** into (se - e)) % (dc * 10n ** into (de - e))
    if out == 0n then
      if self < 0.0 || same_value self (-0.0) then -0.0 else 0.0
    else
      // `5e-324` is the least positive number: a remainder below it is not 0
      // `show` writes a `BigInt` with its suffix `n`
      let digits = show out
      match
        String.to_number (String.slice 0 (String.length digits - 1) digits ++ "e" ++ show e)
      with
      | Some r -> if r == 0.0 then (if self < 0.0 then -5e-324 else 5e-324) else r
      | None -> 0.0 / 0.0
  @native "flick:Number" "remainder" when js || go
    arity 1

/// `n + 1`.
increment : Float -> Float
let increment n = n + 1.0
  @native "flick:Number" "increment" when js || go

/// `n - 1`.
decrement : Float -> Float
let decrement n = n - 1.0
  @native "flick:Number" "decrement" when js || go

/// The sum of the list, 0 when it is empty.
sum_all : List Float -> Float
let sum_all xs =
  total : Float -> Int -> Float
  let rec total out i =
    match element_at i xs with
    | Some n -> total (out + n) (i + 1)
    | None -> out
  total 0.0 0
  @native "flick:Number" "sumAll" when js || go

/// The product of the list, 1 when it is empty.
multiply_all : List Float -> Float
let multiply_all xs =
  // a zero ends the product, so an infinity after it gives no NaN
  product : Float -> Int -> Float
  let rec product out i =
    match element_at i xs with
    | Some n -> if n == 0.0 then 0.0 else product (out * n) (i + 1)
    | None -> out
  product 1.0 0
  @native "flick:Number" "multiplyAll" when js || go

/// `self < that` by the order where NaN is least:
/// `x |> Float.is_less_than 3`.
is_less_than : Float -> Float -> Bool
let is_less_than that self =
  if is_nan self then not (is_nan that) else not (is_nan that) && self < that
  @native "flick:Number" "isLessThan" when js || go
    arity 1

/// `self <= that` by the order where NaN is least.
is_less_than_or_equal_to : Float -> Float -> Bool
let is_less_than_or_equal_to that self =
  if is_nan self then true else if is_nan that then false else self <= that
  @native "flick:Number" "isLessThanOrEqualTo" when js || go
    arity 1

/// `self > that` by the order where NaN is least.
is_greater_than : Float -> Float -> Bool
let is_greater_than that self = is_less_than self that
  @native "flick:Number" "isGreaterThan" when js || go
    arity 1

/// `self >= that` by the order where NaN is least.
is_greater_than_or_equal_to : Float -> Float -> Bool
let is_greater_than_or_equal_to that self = is_less_than_or_equal_to self that
  @native "flick:Number" "isGreaterThanOrEqualTo" when js || go
    arity 1

/// Whether `self` lies within `minimum` and `maximum`, both included.
between : { minimum : Float; maximum : Float } -> Float -> Bool
let between bounds self =
  is_greater_than_or_equal_to bounds.minimum self && is_less_than_or_equal_to bounds.maximum self
  @native "flick:Number" "between" when js || go
    arity 1

/// `self` kept within `minimum` and `maximum`.
clamp : { minimum : Float; maximum : Float } -> Float -> Float
let clamp bounds self = min (max self bounds.minimum) bounds.maximum
  @native "flick:Number" "clamp" when js || go
    arity 1

/// How `n` compares with 0; NaN is `LT`.
sign : Float -> Ordering
let sign n = if n > 0.0 then GT else if n == 0.0 then EQ else LT
  @native "flick:Number" "flickSign" when js || go

/// The least power of two at least `n`, and at least 2; NaN for NaN or a
/// negative `n`.
next_pow2 : Float -> Float
let next_pow2 n =
  up : Float -> Float
  let rec up p = if p < n then up (p * 2.0) else p
  if is_nan n || n < 0.0 then 0.0 / 0.0 else up 2.0
  @native "flick:Number" "nextPow2" when js || go

/// Rounded to `precision` decimal places: `3.14159 |> Float.round_to 2`.
round_to : Float -> Float -> Float
let round_to precision x =
  let factor = 10.0 ** precision
  round (x * factor) / factor
  @native "flick:Number" "round" when js || go
    arity 1

/// `n` itself when it is a safe integer.
safe_integer : Float -> Option Float
let safe_integer n = if is_safe_integer n then Some n else None
  @native "flick:rt" "numberSafeInteger" when js || go

/// A finite JSON number: `NaN` and the infinities are refused when decoding
/// and when encoding.
json_finite : PureCodec Json Float
foreign pure json_finite from "flick:rt" "codecNumberFinite"

/// Every number: non-finite values and `-0` as the strings `"NaN"`,
/// `"Infinity"`, `"-Infinity"` and `"-0"`.
json : PureCodec Json Float
foreign pure json from "flick:rt" "codecNumberLossless"
