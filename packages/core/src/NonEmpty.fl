/// Lists with at least one element.
module NonEmpty exposing (
  NonEmpty,
  from_list,
  singleton,
  cons,
  head,
  to_list,
  length,
  map,
  append,
  make_by,
  range,
  replicate,
  last,
  tail,
  init,
  modify_head,
  set_head,
  modify_last,
  set_last,
  split_at,
  unappend,
  unprepend,
  group_with,
  group,
  max,
  min,
)

/// A list with at least one element, represented as the list.
type NonEmpty a

/// The list as a non-empty one, `None` when it is empty.
from_list : List a -> Option (NonEmpty a)
foreign pure from_list from "flick:rt" "nonEmptyFromList"

/// The non-empty list of one element.
singleton : a -> NonEmpty a
foreign pure singleton from "flick:rt" "listSingleton"

/// `x` in front of `rest`.
cons : a -> List a -> NonEmpty a
foreign pure cons from "flick:rt" "nonEmptyCons"

/// The first element.
head : NonEmpty a -> a
foreign pure head from "flick:rt" "nonEmptyHead"

/// The non-empty list as a list.
to_list : NonEmpty a -> List a
foreign pure to_list from "flick:rt" "identity"

/// How many elements the list has.
length : NonEmpty a -> Int
foreign pure length from "flick:rt" "listLength"

/// Applies a pure function to each element.
map : (a -> b)^c -> NonEmpty a -> NonEmpty b
foreign pure map from "flick:rt" "listMap"
  arity 2
  retention call

instance Eq a => Eq (NonEmpty a) =
  let eq x y = eq (to_list x) (to_list y)

instance Show a => Show (NonEmpty a) =
  let show x = "NonEmpty " ++ show (to_list x)

/// The list with `x` added at the end.
append : a -> List a -> NonEmpty a
foreign pure append from "flick:Array" "append"
  arity 1

/// `f 0`, …, `f (n - 1)`, with at least `f 0`: `n` is taken as at least 1.
make_by : Int -> (Int -> a)^c -> NonEmpty a
foreign pure make_by from "flick:Array" "makeBy"
  retention call

/// `[start, start + 1, …, end]`, end included; `[start]` when `end < start`.
range : Int -> Int -> NonEmpty Int
foreign pure range from "flick:Array" "range"

/// `n` copies of `x`, at least one.
replicate : Int -> a -> NonEmpty a
foreign pure replicate from "flick:Array" "replicate"
  arity 1

/// The last element.
last : NonEmpty a -> a
foreign pure last from "flick:Array" "lastNonEmpty"

/// Every element after the first.
tail : NonEmpty a -> List a
foreign pure tail from "flick:Array" "tailNonEmpty"

/// Every element before the last.
init : NonEmpty a -> List a
foreign pure init from "flick:Array" "initNonEmpty"

/// The first element replaced by `f` of it.
modify_head : (a -> a)^c -> NonEmpty a -> NonEmpty a
foreign pure modify_head from "flick:Array" "modifyHeadNonEmpty"
  arity 1
  retention call

/// The first element replaced by `x`.
set_head : a -> NonEmpty a -> NonEmpty a
foreign pure set_head from "flick:Array" "setHeadNonEmpty"
  arity 1

/// The last element replaced by `f` of it.
modify_last : (a -> a)^c -> NonEmpty a -> NonEmpty a
foreign pure modify_last from "flick:Array" "modifyLastNonEmpty"
  arity 1
  retention call

/// The last element replaced by `x`.
set_last : a -> NonEmpty a -> NonEmpty a
foreign pure set_last from "flick:Array" "setLastNonEmpty"
  arity 1

/// The first `n` elements, at least one, and the rest.
split_at : Int -> NonEmpty a -> (NonEmpty a, List a)
foreign pure split_at from "flick:Array" "splitAtNonEmpty"
  arity 1

/// The elements before the last, and the last.
unappend : NonEmpty a -> (List a, a)
foreign pure unappend from "flick:Array" "unappend"

/// The first element, and the rest.
unprepend : NonEmpty a -> (a, List a)
foreign pure unprepend from "flick:Array" "unprepend"

/// Runs of adjacent elements that `same` relates to the first of their run.
group_with : (a -> a -> Bool)^c -> NonEmpty a -> NonEmpty (NonEmpty a)
foreign pure group_with from "flick:Array" "groupWith"
  arity 1
  retention call

/// Runs of adjacent equal elements.
group : Eq a => NonEmpty a -> NonEmpty (NonEmpty a)
let group xs = group_with eq xs

max_by : (a -> a -> Ordering)^c -> NonEmpty a -> a
foreign pure max_by from "flick:Array" "flickMax"
  arity 1
  retention call

min_by : (a -> a -> Ordering)^c -> NonEmpty a -> a
foreign pure min_by from "flick:Array" "flickMin"
  arity 1
  retention call

/// The greatest element by `Ord`.
max : Ord a => NonEmpty a -> a
let max xs = max_by compare xs

/// The least element by `Ord`.
min : Ord a => NonEmpty a -> a
let min xs = min_by compare xs
