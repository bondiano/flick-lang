/// Wrappers that choose how values combine through `Semigroup` and
/// `Monoid`: `Sum` adds, `Product` multiplies, `First` and `Last` keep the
/// first or the last value present, `Min` and `Max` keep the least or the
/// greatest. A `Float` has no instance of its own, since adding and
/// multiplying would both claim it: `fold_map Sum xs` says which.
module Monoids exposing (..)

/// Numbers combined by `+`, from `0`.
unboxed type Sum = Sum Float
  deriving Eq, Show

instance Semigroup Sum =
  let combine (Sum a) (Sum b) = Sum (a + b)

instance Monoid Sum =
  let empty = Sum 0

/// Numbers combined by `*`, from `1`.
unboxed type Product = Product Float
  deriving Eq, Show

instance Semigroup Product =
  let combine (Product a) (Product b) = Product (a * b)

instance Monoid Product =
  let empty = Product 1

/// The first value present, from none.
unboxed type First a = First (Option a)
  deriving Eq, Show

instance Semigroup (First a) =
  let combine first other =
    match first with
    | First (Some _) -> first
    | First None -> other

instance Monoid (First a) =
  let empty = First None

/// The last value present, from none.
unboxed type Last a = Last (Option a)
  deriving Eq, Show

instance Semigroup (Last a) =
  let combine other last =
    match last with
    | Last (Some _) -> last
    | Last None -> other

instance Monoid (Last a) =
  let empty = Last None

/// The least value; there is no empty one, so wrap a `First` or an
/// `Option` around it to fold from nothing.
unboxed type Min a = Min a
  deriving Eq, Show

instance Ord a => Semigroup (Min a) =
  let combine (Min a) (Min b) = if compare b a == LT then Min b else Min a

/// The greatest value; there is no empty one.
unboxed type Max a = Max a
  deriving Eq, Show

instance Ord a => Semigroup (Max a) =
  let combine (Max a) (Max b) = if compare b a == GT then Max b else Max a
