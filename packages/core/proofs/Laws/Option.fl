/// The laws of the `Functor`, `Applicative` and `Monad` instances of
/// `Option`, proved of their definitions in `Instances`: every law holds for
/// every payload and every total function, each stated as its class states
/// it, so `option` certifies them all as the bundle of `Monad Option`.
/// `flick prove` checks them; no import of `Option` reads this module.
module Laws.Option exposing (..)

/// F1
proof map_identity (v : Option a)
where equal (map identity v) v =
  match v with
  | None -> refl
  | Some x -> refl

/// F2
proof map_composition (g : b -> c) (f : a -> b) (v : Option a)
where equal (map (fun x -> g (f x)) v) (map g (map f v)) =
  match v with
  | None -> refl
  | Some x -> refl

/// A1
proof ap_identity (v : Option a)
where equal (map2 (fun g x -> g x) (pure identity) v) v =
  match v with
  | None -> refl
  | Some x -> refl

/// A2
proof ap_composition (fs : Option (b -> c)) (gs : Option (a -> b)) (xs : Option a)
where equal
  (map2
    (fun g x -> g x)
    (map2 (fun g x -> g x) (map2 (fun g x -> g x) (pure (fun u v x -> u (v x))) fs) gs)
    xs)
  (map2 (fun g x -> g x) fs (map2 (fun g x -> g x) gs xs)) =
  match fs with
  | None -> refl
  | Some f ->
    match gs with
    | None -> refl
    | Some g ->
      match xs with
      | None -> refl
      | Some x -> refl

/// A3
proof ap_homomorphism (f : a -> b) (x : a)
where equal (map2 (fun g x -> g x) (pure f) (pure x)) (pure (f x) : Option b) = refl

/// A4
proof ap_interchange (fs : Option (a -> b)) (x : a)
where equal (map2 (fun g x -> g x) fs (pure x)) (map2 (fun g x -> g x) (pure (fun u -> u x)) fs) =
  match fs with
  | None -> refl
  | Some f -> refl

/// A5
proof map_is_ap (f : a -> b) (v : Option a)
where equal (map f v) (map2 (fun g x -> g x) (pure f) v) =
  match v with
  | None -> refl
  | Some x -> refl

/// M1
proof left_identity (f : a -> Option b) (x : a) where equal (flat_map f (pure x)) (f x) = refl

/// M2
proof right_identity (v : Option a)
where equal (flat_map pure v) v =
  match v with
  | None -> refl
  | Some x -> refl

/// M3
proof associativity (g : b -> Option c) (f : a -> Option b) (v : Option a)
where equal (flat_map g (flat_map f v)) (flat_map (fun x -> flat_map g (f x)) v) =
  match v with
  | None -> refl
  | Some x -> refl

/// C1
proof map_is_flat_map (f : a -> b) (v : Option a)
where equal (map f v) (flat_map (fun x -> pure (f x)) v) =
  match v with
  | None -> refl
  | Some x -> refl

/// C2
proof map2_is_flat_map (h : a -> b -> c) (va : Option a) (vb : Option b)
where equal (map2 h va vb) (flat_map (fun a -> map (fun b -> h a b) vb) va) =
  match va with
  | None -> refl
  | Some a ->
    match vb with
    | None -> refl
    | Some b -> refl

/// Every law of `Monad`, `Applicative` and `Functor` at the instances of
/// `Option`, by the lemmas above.
proof option
where lawful Monad Option = {
  Applicative = {
    Functor = {
      identity = map_identity
      composition = map_composition
    }
    identity = ap_identity
    composition = ap_composition
    homomorphism = ap_homomorphism
    interchange = ap_interchange
    map_is_applied = map_is_ap
  }
  left_identity = left_identity
  right_identity = right_identity
  associativity = associativity
  map_is_flat_map = map_is_flat_map
  map2_is_flat_map = map2_is_flat_map
}
