/// The fiber's source of randomness. It is a default service, so drawing
/// needs no service row; each draw is a runtime call, and `with_seed` makes
/// the draws of a task repeatable.
module Random exposing (..)

/// A number in [0, 1).
next : Unit ->{} Float
foreign effect next from "flick:Random" "flickNext"
  arity 0

/// `true` or `false`.
next_boolean : Unit ->{} Bool
foreign effect next_boolean from "flick:Random" "flickNextBoolean"
  arity 0

/// An `Int`, over its whole 32-bit range.
next_int : Unit ->{} Int
foreign effect next_int from "flick:Random" "flickNextInt"
  arity 0

/// A number in [min, max).
next_between : Float -> Float ->{} Float
foreign effect next_between from "flick:Random" "nextBetween"

/// An integer in [min, max], or [min, max) with `halfOpen`.
next_int_between : { halfOpen : Option Bool } -> Int -> Int ->{} Int
foreign effect next_int_between from "flick:Random" "flickNextIntBetween"

/// The elements in a random order.
shuffle : List a ->{} List a
foreign effect shuffle from "flick:Random" "shuffle"

/// One of the elements.
choice : NonEmpty.NonEmpty a ->{} a
foreign effect choice from "flick:Random" "choice"

/// Runs `task` with a generator seeded by `seed`: the same seed, the same draws.
with_seed : Float -> (Eff r e a)^c ->{r; e} a
foreign effect with_seed from "flick:Random" "withSeed"
  arity 1
  retention call
