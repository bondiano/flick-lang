/// A handler of the files below a directory on Node's file system,
/// answering `GET` and `HEAD` with each file, its media type, `ETag` and
/// ranges; a path outside the directory is not found.
module Http.StaticServer exposing (..)

import Http.Method
import Http.Router
import Http.ServerError exposing (HttpServerError)
import Http.ServerRequest exposing (ServerRequest)
import Http.ServerResponse exposing (ServerResponse)
import PlatformError

/// The directory, the file a directory's path answers with (`index.html`
/// unless given), whether a path of no file answers with that index (a
/// single-page app), the `Cache-Control` header, and media types by
/// extension besides the built-in ones.
type alias StaticOptions = {
  root : String;
  index : Option String;
  spa : Bool;
  cacheControl : Option String;
  mimeTypes : List (String, String);
}

/// The files below the directory, with the defaults.
static_options : String -> StaticOptions
let static_options root = {
  root = root;
  index = None;
  spa = false;
  cacheControl = None;
  mimeTypes = [];
}

/// The handler of the files; fails if the directory cannot be read.
make :
  StaticOptions ->{Async; PlatformError.PlatformError}
  (ServerRequest ->{Async; HttpServerError} ServerResponse)
foreign effect make from "flick:http/HttpStaticServer" "flickMake"
  reviewed "effect@4.1.2 sha256:e59cebe7d680fe43"

/// A route of `GET` below the prefix to the handler of the files.
route :
  StaticOptions ->
  String ->{Async; PlatformError.PlatformError}
  Http.Router.Route {Async | r} {HttpServerError | e}
let route options prefix =
  handler : ServerRequest ->{Async; HttpServerError} ServerResponse
  let handler = make options
  Http.Router.prefix_route
    prefix
    (Http.Router.route (Some Http.Method.GET) "/*" (fun request -> handler request))
