/// The `multipart/form-data` bodies of server requests. `persisted` reads
/// the whole form, writing its files to temporary files that the scope of
/// region `s` removes; `with_limits` bounds what a form may hold. `parts`
/// reads a form part by part, as a stream.
module Http.Multipart exposing (..)

import ByteSize
import Channel exposing (Channel)
import Http.ServerError
import Http.ServerRequest
import Stream.Core exposing (Stream)

/// A file of a form, written to `path` until the scope closes.
type alias PersistedFile = { key : String; name : String; contentType : String; path : String }

/// A whole form: its text fields and its files.
type Persisted

/// Why a form could not be read.
type MultipartErrorReason =
  | FileTooLarge
  | FieldTooLarge
  | BodyTooLarge
  | TooManyParts
  | InternalError
  | Parse
  deriving Eq, Show

/// A form that could not be read, with the reason; a server answers it
/// with 413 for a limit, 400 for a malformed form, 500 otherwise.
type error MultipartError = MultipartError MultipartErrorReason
  deriving Eq, Show

/// What `with_limits` bounds: the number of parts, the size of a field, of
/// a file and of the whole body, and the media types of parts read as
/// fields (none: the default ones).
type alias Limits = {
  maxParts : Option Int;
  maxFieldSize : Option ByteSize.ByteSize;
  maxFileSize : Option ByteSize.ByteSize;
  maxTotalSize : Option ByteSize.ByteSize;
  fieldMimeTypes : List String;
}

/// No bounds besides the defaults.
limits : Limits
let limits = {
  maxParts = None;
  maxFieldSize = None;
  maxFileSize = None;
  maxTotalSize = None;
  fieldMimeTypes = [];
}

/// Reads the form of the request; its files are removed when the scope of
/// region `s` closes.
persisted : Http.ServerRequest.ServerRequest ->{Async, Scope s; MultipartError} Persisted
foreign effect persisted from "flick:http/Multipart" "flickPersisted"

/// Each text field with all its values.
fields : Persisted -> List (String, List String)
foreign pure fields from "flick:http/Multipart" "flickFields"

/// Each file field with all its files.
files : Persisted -> List (String, List PersistedFile)
foreign pure files from "flick:http/Multipart" "flickFiles"

/// Decodes the form: an object of a string, strings or files (records of
/// `PersistedFile`'s fields) for each key.
schema_persisted : Codec rd re Json a -> Persisted ->{rd; SchemaError} a
foreign effect schema_persisted from "flick:http/Multipart" "flickSchemaPersisted"
  arity 2

/// Decodes the JSON text of the field of the form.
schema_json : Codec rd re Json a -> String -> Persisted ->{rd; SchemaError} a
foreign effect schema_json from "flick:http/Multipart" "flickSchemaJson"
  arity 3

/// Decodes the form of the request, as `schema_persisted` of `persisted`.
schema_body_multipart :
  Codec rd re Json a ->
  Http.ServerRequest.ServerRequest ->{Async, Scope s | rd; MultipartError, SchemaError}
  a
foreign effect schema_body_multipart from "flick:http/Multipart" "flickSchemaBodyMultipart"
  arity 2

/// Decodes the form of the request: a multipart form as
/// `schema_body_multipart`, any other as URL parameters.
schema_body_form :
  Codec rd re Json a ->
  Http.ServerRequest.ServerRequest ->{Async, Scope s | rd; Http.ServerError.HttpServerError, MultipartError, SchemaError}
  a
foreign effect schema_body_form from "flick:http/Multipart" "flickSchemaBodyForm"
  arity 2

/// Decodes the JSON text of the field of the request's form.
schema_body_form_json :
  Codec rd re Json a ->
  String ->
  Http.ServerRequest.ServerRequest ->{Async, Scope s | rd; MultipartError, SchemaError}
  a
foreign effect schema_body_form_json from "flick:http/Multipart" "flickSchemaBodyFormJson"
  arity 3

/// Runs `task` with the limits for the forms it reads.
with_limits : Limits -> (Eff r e a)^c ->{r; e} a
foreign effect with_limits from "flick:http/Multipart" "flickWithLimits"
  arity 2
  retention call

/// What the header of a part says: its field name, file name, media type
/// and disposition, with their parameters, and all its headers.
type alias PartInfo = {
  name : String;
  filename : Option String;
  contentType : String;
  contentTypeParameters : List (String, String);
  contentDisposition : String;
  contentDispositionParameters : List (String, String);
  headers : List (String, String);
}

/// Whether the parser reads the part as a file: it has a file name, or a
/// media type that is not text.
default_is_file : PartInfo -> Bool
foreign pure default_is_file from "flick:http/Multipart" "flickDefaultIsFile"

/// The text of a field's bytes, in the charset of its media type.
decode_field : PartInfo -> List Int -> String
foreign pure decode_field from "flick:http/Multipart" "flickDecodeField"
  arity 2

/// A part of a form read part by part: a text field, or a file whose bytes
/// stream as the form is read. A file must be read before the next part.
type Part =
  | Field { key : String; contentType : String; value : String }
  | File {
    key : String;
    name : String;
    contentType : String;
    content : Stream {Async} {MultipartError} (List Int);
  }

/// The parts of the request's form, in order.
parts : Http.ServerRequest.ServerRequest -> Stream {Async} {MultipartError} Part
foreign pure parts from "flick:http/Multipart" "flickParts"

/// Parses chunks of bytes of a form into its parts; `headers` are those of
/// the form's message, its `content-type` naming the boundary. It reads the
/// limits of `with_limits` when it runs.
make_channel :
  List (String, String) ->
  Channel
    none
    {MultipartError | e}
    (NonEmpty.NonEmpty (List Int))
    (NonEmpty.NonEmpty Part)
    Unit
    e
    Unit
foreign pure make_channel from "flick:http/Multipart" "flickMakeChannel"

/// The whole form of the parts, as `persisted` reads it: files are written
/// to temporary files that the scope of region `s` removes.
to_persisted : Stream r {MultipartError} Part ->{Async, Scope s | r; MultipartError} Persisted
foreign effect to_persisted from "flick:http/Multipart" "flickToPersisted"
