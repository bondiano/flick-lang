/// Effect's `HttpRouter`: routes of a method and a path pattern (`/users/:id`,
/// `/files/*`) to handlers; `router` makes one handler of them that answers
/// a request no route matches with `RouteNotFound`. A route's handler reads
/// the parameters of its path through the service `RouteContext`.
module Http.Router exposing (..)

import Codec
import Http.Method
import Http.ServerError exposing (HttpServerError)
import Http.ServerRequest exposing (ServerRequest)
import Http.ServerResponse exposing (ServerResponse)

/// A route to a handler that needs the services `r` and may fail with `e`.
type Route (r : ServiceRow) (e : ErrorRow)

/// How paths match; `None` keeps Effect's default: trailing slashes count,
/// duplicate slashes do not, case counts, parameters up to 100 characters.
type alias RouterConfig = {
  ignoreTrailingSlash : Option Bool;
  ignoreDuplicateSlashes : Option Bool;
  caseSensitive : Option Bool;
  maxParamLength : Option Int;
}

/// Effect's defaults.
config : RouterConfig
let config = {
  ignoreTrailingSlash = None;
  ignoreDuplicateSlashes = None;
  caseSensitive = None;
  maxParamLength = None;
}

/// What a route's handler knows of the match.
service RouteContext =
  params : Unit ->{} List (String, String)

/// The parameters of the matched path: `[("id", "7")]` for `/users/7` of
/// `/users/:id`.
params : Unit ->{RouteContext;} List (String, String)
let params () = RouteContext.params ()

/// The parameter of the matched path.
param : String ->{RouteContext;} Option String
let param name =
  match List.find (fun (key, _) -> key == name) (params ()) with
  | Some (_, value) -> Some value
  | None -> None

/// A route of the method (`None`: every method) and the path pattern; it
/// holds what its handler holds, such as the region of `Rpc.handler`.
route :
  Option Http.Method.Method ->
  String ->
  (ServerRequest ->{RouteContext | r; e} ServerResponse)^c ->
  (Route r e)^c
foreign pure route from "@flick-lang/runtime/effect/http/HttpRouter" "flickRoute"
  arity 3
  retention call
  reviewed "effect@4.1.2 sha256:525d5607645939c4"

/// The path below the prefix: `prefix_path "/api" "/users"` is `/api/users`.
prefix_path : String -> String -> String
foreign pure prefix_path from "@flick-lang/runtime/effect/http/HttpRouter" "prefixPath"
  arity 1
  reviewed "effect@4.1.2 sha256:d18943285f673c79"

/// The route below the prefix.
prefix_route : String -> (Route r e)^c -> (Route r e)^c
foreign pure prefix_route from "@flick-lang/runtime/effect/http/HttpRouter" "prefixRoute"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:e43d9750bb7c2c0e"

/// One handler of the routes: the first route that matches a request
/// answers it, and a request none matches fails with `RouteNotFound`.
router :
  RouterConfig ->
  List ((Route r e)^c) ->{}
  (ServerRequest ->{r; HttpServerError | e} ServerResponse)^c
foreign effect router from "@flick-lang/runtime/effect/http/HttpRouter" "flickRouter"
  arity 2
  retention call
  reviewed "effect@4.1.2 sha256:4631e316834ea1e9"

/// The parameters of the matched path as an object, for a codec.
params_unknown : List (String, String) -> Unknown
foreign pure params_unknown from "@flick-lang/runtime/effect/http/HttpRouter" "flickParamsUnknown"

/// Decodes the parameters of the matched path.
schema_path_params : Codec rd re Json a ->{RouteContext | rd; SchemaError} a
let schema_path_params coder = Codec.decode coder (params_unknown (params ()))

/// Decodes the parameters of the matched path and of the query together.
schema_params : Codec rd re Json a -> ServerRequest ->{RouteContext | rd; SchemaError} a
foreign effect schema_params from "@flick-lang/runtime/effect/http/HttpRouter" "flickSchemaParams"
  arity 2
  reviewed "effect@4.1.2 sha256:f234a03b74635f46"

/// Decodes `{ method, url, cookies, headers, pathParams, searchParams }`
/// of the request.
schema_no_body : Codec rd re Json a -> ServerRequest ->{RouteContext | rd; SchemaError} a
foreign effect schema_no_body from "@flick-lang/runtime/effect/http/HttpRouter" "flickSchemaNoBody"
  arity 2
  reviewed "effect@4.1.2 sha256:a4db36817d7f5101"

/// `schema_no_body` with the JSON body as `body`.
schema_json :
  Codec rd re Json a -> ServerRequest ->{RouteContext | rd; HttpServerError, SchemaError} a
foreign effect schema_json from "@flick-lang/runtime/effect/http/HttpRouter" "flickSchemaJson"
  arity 2
  reviewed "effect@4.1.2 sha256:57fcc073d84e485e"
