/// An HTTP client sends requests and gives responses. The service
/// `HttpClient` holds the program's client (`Http.FetchClient.layer`
/// provides one over `fetch`); `get`, `post`, … send through it. A
/// `Client r e` is a client as a value, needing the services `r` and
/// failing with the errors `e`: the combinators below change what it does
/// around each request.
module Http.Client exposing (..)

import Http.ClientError exposing (HttpClientError)
import Http.ClientRequest exposing (ClientRequest)
import Http.ClientResponse exposing (ClientResponse)
import Http.Cookies
import Http.Url
import Schedule

/// A client as a value.
type Client (r : ServiceRow) (e : ErrorRow)

/// When `retry_transient` retries: after a failed request, after a
/// response of status 408, 429, 500, 502, 503 or 504, or after both.
type RetryOn = ErrorsOnly | ResponseOnly | ErrorsAndResponses
  deriving Eq, Show

/// The program's client.
service HttpClient =
  client : Unit ->{} Client none {HttpClientError}

/// The client the service holds.
current : Unit ->{HttpClient} Client none {HttpClientError}
let current () = HttpClient.client ()

/// Sends the request with the client.
execute_with : Client r e -> ClientRequest ->{Async | r; e} ClientResponse
foreign effect execute_with from "flick:http/HttpClient" "flickExecute"
  arity 2

/// Sends the request with the service's client.
execute : ClientRequest ->{Async, HttpClient; HttpClientError} ClientResponse
let execute request = execute_with (current ()) request

/// Sends a `GET` of the URL.
get : String ->{Async, HttpClient; HttpClientError} ClientResponse
let get url = execute (Http.ClientRequest.get url)

/// Sends a `QUERY` of the URL.
query : String ->{Async, HttpClient; HttpClientError} ClientResponse
let query url = execute (Http.ClientRequest.query url)

/// Sends a `HEAD` of the URL.
head : String ->{Async, HttpClient; HttpClientError} ClientResponse
let head url = execute (Http.ClientRequest.head url)

/// Sends a `POST` to the URL, without a body.
post : String ->{Async, HttpClient; HttpClientError} ClientResponse
let post url = execute (Http.ClientRequest.post url)

/// Sends a `PATCH` of the URL, without a body.
patch : String ->{Async, HttpClient; HttpClientError} ClientResponse
let patch url = execute (Http.ClientRequest.patch url)

/// Sends a `PUT` to the URL, without a body.
put : String ->{Async, HttpClient; HttpClientError} ClientResponse
let put url = execute (Http.ClientRequest.put url)

/// Sends a `DELETE` of the URL.
del : String ->{Async, HttpClient; HttpClientError} ClientResponse
let del url = execute (Http.ClientRequest.delete url)

/// Sends an `OPTIONS` of the URL.
options : String ->{Async, HttpClient; HttpClientError} ClientResponse
let options url = execute (Http.ClientRequest.options url)

/// A client of a function from the request and its URL to the response:
/// a test double, or a transport of its own.
make :
  (ClientRequest -> Http.Url.Url ->{; HttpClientError} ClientResponse) ->
  Client none {HttpClientError}
foreign pure make from "flick:http/HttpClient" "make"
  arity 1

/// A client of a function sending the prepared request, and of the
/// preparation of each request.
make_with :
  (Eff r2 e2 ClientRequest ->{r; e} ClientResponse) ->
  (ClientRequest ->{r2; e2} ClientRequest) ->
  Client r e
foreign pure make_with from "flick:http/HttpClient" "makeWith"
  arity 2

/// The client with each response computed by `f`, from the computation
/// that sends the request and the request.
transform :
  (Eff r e ClientResponse -> ClientRequest ->{r2; e2} ClientResponse) -> Client r e -> Client r2 e2
foreign pure transform from "flick:http/HttpClient" "transform"
  arity 1

/// The client with each response computed by `f` from the computation that
/// sends the request.
transform_response :
  (Eff r e ClientResponse ->{r2; e2} ClientResponse) -> Client r e -> Client r2 e2
foreign pure transform_response from "flick:http/HttpClient" "transformResponse"
  arity 1

/// The client with a failure answered by `f`.
catch : (Errors e ->{r2; e2} ClientResponse) -> Client r e -> Client (r + r2) e2
foreign pure catch from "flick:http/HttpClient" "catch"
  arity 1

/// The client with a response `f` refuses replaced by `or_else` of it.
filter_or_else :
  (ClientResponse -> Bool) ->
  (ClientResponse ->{r2; e2} ClientResponse) ->
  Client r e ->
  Client (r + r2) (e + e2)
foreign pure filter_or_else from "flick:http/HttpClient" "filterOrElse"
  arity 2

/// The client failing with `or_fail` of a response `f` refuses.
filter_or_fail :
  (ClientResponse -> Bool) -> (ClientResponse -> Errors e2) -> Client r e -> Client r (e + e2)
foreign pure filter_or_fail from "flick:http/HttpClient" "filterOrFail"
  arity 2

/// The client failing with a `StatusCodeError` for a status `f` refuses.
filter_status : (Int -> Bool) -> Client r e -> Client r (e + {HttpClientError})
foreign pure filter_status from "flick:http/HttpClient" "flickFilterStatus"
  arity 2

/// The client failing with a `StatusCodeError` for a status other than 2xx.
filter_status_ok : Client r e -> Client r (e + {HttpClientError})
foreign pure filter_status_ok from "flick:http/HttpClient" "flickFilterStatusOk"

/// The client with each request changed by `f` before it is sent.
map_request : (ClientRequest -> ClientRequest) -> Client r e -> Client r e
foreign pure map_request from "flick:http/HttpClient" "mapRequest"
  arity 1

/// `map_request` with a runtime `f`.
map_request_effect :
  (ClientRequest ->{r2; e2} ClientRequest) -> Client r e -> Client (r + r2) (e + e2)
foreign pure map_request_effect from "flick:http/HttpClient" "mapRequestEffect"
  arity 1

/// The client with each request changed by `f` before the client's own
/// preparation of it.
map_request_input : (ClientRequest -> ClientRequest) -> Client r e -> Client r e
foreign pure map_request_input from "flick:http/HttpClient" "mapRequestInput"
  arity 1

/// `map_request_input` with a runtime `f`.
map_request_input_effect :
  (ClientRequest ->{r2; e2} ClientRequest) -> Client r e -> Client (r + r2) (e + e2)
foreign pure map_request_input_effect from "flick:http/HttpClient" "mapRequestInputEffect"
  arity 1

/// The client sending a request again after a failure, as long as the
/// schedule, which gets the error, recurs.
retry : Schedule.Schedule r2 e2 (Errors e) o -> Client r e -> Client (r + r2) (e + e2)
foreign pure retry from "flick:http/HttpClient" "retry"
  arity 1

/// The client sending a request again, at most `times` more times, after a
/// transport failure or a response of a transient status; a `Retry-After`
/// header delays the next try.
retry_transient : RetryOn -> Int -> Client r e -> Client r e
foreign pure retry_transient from "flick:http/HttpClient" "flickRetryTransient"
  arity 3

/// The client running `f` on each response.
tap : (ClientResponse ->{r2; e2} x) -> Client r e -> Client (r + r2) (e + e2)
foreign pure tap from "flick:http/HttpClient" "tap"
  arity 1

/// The client running `f` on each failure, which it keeps.
tap_error : (Errors e ->{r2; e2} x) -> Client r e -> Client (r + r2) (e + e2)
foreign pure tap_error from "flick:http/HttpClient" "tapError"
  arity 1

/// The client running `f` on each request before it is sent.
tap_request : (ClientRequest ->{r2; e2} x) -> Client r e -> Client (r + r2) (e + e2)
foreign pure tap_request from "flick:http/HttpClient" "tapRequest"
  arity 1

/// The client sending the cookies of the cell with each request and
/// keeping those of each response in it.
with_cookies_ref : Ref Http.Cookies.Cookies -> Client r e -> Client r e
foreign pure with_cookies_ref from "flick:http/HttpClient" "flickWithCookiesRef"
  arity 2

/// The client whose responses stay open until the scope of region `s`
/// closes, instead of until their body is read.
with_scope : Client r e -> Client {Scope s | r} e
foreign pure with_scope from "flick:http/HttpClient" "withScope"
  arity 1

/// The client following redirects, at most the number or 10 times.
follow_redirects : Option Int -> Client r e -> Client r e
foreign pure follow_redirects from "flick:http/HttpClient" "followRedirects"
  arity 1
  optional 0

/// Runs `task` with no client span for the requests `f` accepts.
with_tracer_disabled_when : (ClientRequest -> Bool) -> (Eff r e a)^c ->{r; e} a
foreign effect with_tracer_disabled_when from "flick:http/HttpClient" "flickWithTracerDisabledWhen"
  arity 2
  retention call

/// Runs `task` recording in client spans only the headers `f name phase`
/// accepts; the phase is `"request"` or `"response"`.
with_tracer_header_filter : (String -> String -> Bool) -> (Eff r e a)^c ->{r; e} a
foreign effect with_tracer_header_filter from "flick:http/HttpClient" "flickWithTracerHeaderFilter"
  arity 2
  retention call

/// Runs `task` sending trace context headers with requests, or not.
with_tracer_propagation : Bool -> (Eff r e a)^c ->{r; e} a
foreign effect with_tracer_propagation from "flick:http/HttpClient" "flickWithTracerPropagation"
  arity 2
  retention call

/// Runs `task` naming the span of a request by `f`.
with_span_name_generator : (ClientRequest -> String) -> (Eff r e a)^c ->{r; e} a
foreign effect with_span_name_generator from "flick:http/HttpClient" "flickWithSpanNameGenerator"
  arity 2
  retention call

layer_of :
  ServiceTag {HttpClient} -> Eff r e (Client none {HttpClientError}) -> Layer r e {HttpClient}
foreign pure layer_of from "flick:http/HttpClient" "flickLayer"
  arity 2

/// The service holding the client that `task` makes.
layer : Eff r e (Client none {HttpClientError}) -> Layer r e {HttpClient}
let layer build = layer_of HttpClient build
