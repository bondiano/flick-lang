/// Codecs of HTTP values in their JSON forms, and codecs that decode
/// parameters, cookies, query strings and forms with a codec of the
/// program. Their decoding may refuse a wire value of the right JSON type,
/// so strict JSON Schema export refuses them.
module Http.Codecs exposing (..)

import Http.Cookies
import Http.Headers
import Http.Url
import Http.UrlParams

/// Headers as a JSON object of strings; names are read in lower case.
headers : PureCodec Json Http.Headers.Headers
foreign pure headers from "flick:SchemaHttp" "flickHeaders"

/// URL parameters as a JSON array of name and value pairs.
url_params : PureCodec Json Http.UrlParams.UrlParams
foreign pure url_params from "flick:SchemaHttp" "flickUrlParams"

/// A cookie as its `Set-Cookie` header text, which shows its value.
cookie : PureCodec Json Http.Cookies.Cookie
foreign pure cookie from "flick:SchemaHttp" "flickCookie"

/// Cookies as a JSON array of their `Set-Cookie` header texts.
cookies : PureCodec Json Http.Cookies.Cookies
foreign pure cookies from "flick:SchemaHttp" "flickCookies"

/// A URL as its text; text that is no URL is an error.
url : PureCodec Json Http.Url.Url
foreign pure url from "flick:SchemaHttp" "flickUrl"

/// URL parameters, as `url_params`, decoded by `codec` from an object of a
/// string for a name given once and an array for a repeated one.
from_url_params : PureCodec Json a -> PureCodec Json a
foreign pure from_url_params from "flick:SchemaHttp" "flickFromUrlParams"

/// Cookies, as `cookies`, decoded by `codec` from an object of their values.
from_cookies : PureCodec Json a -> PureCodec Json a
foreign pure from_cookies from "flick:SchemaHttp" "flickFromCookies"

/// URL parameters, as `url_params`, whose first `field` holds JSON text
/// decoded by `codec`; a missing field is an error.
json_url_params_field : String -> PureCodec Json a -> PureCodec Json a
foreign pure json_url_params_field from "flick:SchemaHttp" "flickJsonUrlParamsField"
  arity 2

/// A query string (`a=1&b[c]=2`) whose bracket paths form a tree of
/// strings, objects and arrays decoded by `codec`.
from_url_search_params : PureCodec Json a -> PureCodec Json a
foreign pure from_url_search_params from "flick:SchemaHttp" "flickFromUrlSearchParams"

/// Form fields as a JSON array of name and value pairs, their bracket paths
/// forming a tree decoded by `codec`, as `from_url_search_params`.
from_form_data : PureCodec Json a -> PureCodec Json a
foreign pure from_form_data from "flick:SchemaHttp" "flickFromFormData"
