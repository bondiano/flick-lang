/// The cookies of a response (`Set-Cookie`) or of a request (`Cookie`). A
/// cookie's value is a `Redacted String`: `show` prints `<redacted>` for
/// it, and reading it back is a runtime call. A name, value, domain or path
/// that a header cannot carry, or an infinite `maxAge`, is a
/// `CookiesError`.
module Http.Cookies exposing (..)

import DateTime
import Duration

/// One cookie: its name, value and attributes.
type Cookie

/// Cookies by name, an immutable value.
type Cookies

/// Whether the cookie is sent along with requests from other sites.
type SameSite = Lax | Strict | NoSameSite
  deriving Eq, Show

/// How early the browser drops the cookie when it runs out of room.
type Priority = Low | Medium | High
  deriving Eq, Show

/// The attributes of a cookie; `attributes` sets none of them.
type alias Attributes = {
  domain : Option String;
  expires : Option DateTime.DateTime;
  maxAge : Option Duration.Duration;
  path : Option String;
  priority : Option Priority;
  httpOnly : Bool;
  secure : Bool;
  partitioned : Bool;
  sameSite : Option SameSite;
}

/// No attribute set: `{ Http.Cookies.attributes with secure = true }`.
attributes : Attributes
let attributes = {
  domain = None;
  expires = None;
  maxAge = None;
  path = None;
  priority = None;
  httpOnly = false;
  secure = false;
  partitioned = false;
  sameSite = None;
}

/// What a header cannot carry.
type CookiesErrorReason =
  | InvalidCookieName
  | InvalidCookieValue
  | InvalidCookieDomain
  | InvalidCookiePath
  | CookieInfinityMaxAge
  deriving Eq, Show

/// A cookie that could not be made, with the reason.
type error CookiesError = CookiesError CookiesErrorReason
  deriving Eq, Show

/// No cookies.
empty : Cookies
foreign pure empty from "flick:http/Cookies" "empty"

/// Whether there are no cookies.
is_empty : Cookies -> Bool
foreign pure is_empty from "flick:http/Cookies" "isEmpty"
  arity 1

/// The cookies of `Set-Cookie` header values; a value that is no cookie is
/// left out.
from_set_cookie : List String -> Cookies
foreign pure from_set_cookie from "flick:http/Cookies" "fromSetCookie"
  arity 1

/// The cookies, a later one of a name replacing an earlier one.
from_iterable : List Cookie -> Cookies
foreign pure from_iterable from "flick:http/Cookies" "fromIterable"
  arity 1

/// The cookies of the pairs, each under the name it is paired with.
from_readonly_record : List (String, Cookie) -> Cookies
foreign pure from_readonly_record from "flick:http/Cookies" "flickFromReadonlyRecord"

/// A cookie of the name, value and attributes.
make_cookie : String -> Redacted String -> Attributes ->{; CookiesError} Cookie
foreign effect make_cookie from "flick:http/Cookies" "flickMakeCookie"
  arity 3

/// Adds the cookie, replacing one of its name.
set_cookie : Cookie -> Cookies -> Cookies
foreign pure set_cookie from "flick:http/Cookies" "setCookie"
  arity 1

/// Adds each of the cookies.
set_all_cookie : List Cookie -> Cookies -> Cookies
foreign pure set_all_cookie from "flick:http/Cookies" "setAllCookie"
  arity 1

/// The cookies with those of the first argument set over them.
merge : Cookies -> Cookies -> Cookies
foreign pure merge from "flick:http/Cookies" "merge"
  arity 1

/// Removes the cookie of the name.
remove : String -> Cookies -> Cookies
foreign pure remove from "flick:http/Cookies" "remove"
  arity 1

/// The cookie of the name.
get : String -> Cookies -> Option Cookie
foreign pure get from "flick:http/Cookies" "get"
  arity 1

/// The value of the cookie of the name.
get_value : String -> Cookies ->{} Option (Redacted String)
foreign get_value from "flick:http/Cookies" "flickGetValue"
  arity 2

/// Sets a cookie: `set name value attributes cookies`.
set : String -> Redacted String -> Attributes -> Cookies ->{; CookiesError} Cookies
foreign effect set from "flick:http/Cookies" "flickSet"
  arity 4

/// Sets each cookie of name, value and attributes.
set_all : List (String, Redacted String, Attributes) -> Cookies ->{; CookiesError} Cookies
foreign effect set_all from "flick:http/Cookies" "flickSetAll"
  arity 2

/// Sets an empty cookie of the name that has expired, so that a browser
/// drops it; `expires` and `maxAge` of the attributes are ignored.
expire_cookie : String -> Attributes -> Cookies ->{; CookiesError} Cookies
foreign effect expire_cookie from "flick:http/Cookies" "flickExpireCookie"
  arity 3

/// The `Set-Cookie` header value of the cookie.
serialize_cookie : Cookie -> String
foreign pure serialize_cookie from "flick:http/Cookies" "serializeCookie"
  arity 1

/// The `Cookie` header value of the cookies: `a=1; b=2`.
to_cookie_header : Cookies -> String
foreign pure to_cookie_header from "flick:http/Cookies" "toCookieHeader"
  arity 1

/// Each cookie's name and value.
to_record : Cookies ->{} List (String, Redacted String)
foreign to_record from "flick:http/Cookies" "flickToRecord"

/// The `Set-Cookie` header values of the cookies.
to_set_cookie_headers : Cookies -> List String
foreign pure to_set_cookie_headers from "flick:http/Cookies" "toSetCookieHeaders"
  arity 1

/// The names and values of a `Cookie` header.
parse_header : String ->{} List (String, Redacted String)
foreign parse_header from "flick:http/Cookies" "flickParseHeader"

/// The cookie's name.
name : Cookie -> String
foreign pure name from "flick:http/Cookies" "flickName"

/// The cookie's value.
value : Cookie ->{} Redacted String
foreign value from "flick:http/Cookies" "flickValue"

show_cookie : Cookie -> String
foreign pure show_cookie from "flick:http/Cookies" "flickShowCookie"

show_cookies : Cookies -> String
foreign pure show_cookies from "flick:http/Cookies" "flickShowCookies"

instance Show Cookie =
  let show x = show_cookie x

instance Show Cookies =
  let show x = show_cookies x
