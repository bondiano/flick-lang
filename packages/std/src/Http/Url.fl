/// Parsed absolute URLs as immutable values; each `set_*` gives a changed
/// copy. `show` is the URL with its password masked.
module Http.Url exposing (..)

import Http.UrlParams

/// An absolute URL.
type Url

/// A text that is not a URL, with the parser's message.
type error UrlError = UrlError String
  deriving Eq, Show

/// The URL of the text.
from_string : String -> Result UrlError Url
foreign pure from_string from "flick:http/Url" "flickFromString"

/// The URL of the text, its query replaced by the parameters and its
/// fragment by the hash, if given.
make : String -> Http.UrlParams.UrlParams -> Option String -> Result UrlError Url
foreign pure make from "flick:http/Url" "flickMake"
  arity 3

/// The whole URL as text.
href : Url -> String
foreign pure href from "flick:http/Url" "flickHref"

/// The fragment, `#top`.
set_hash : String -> Url -> Url
foreign pure set_hash from "flick:http/Url" "setHash"
  arity 1

/// The host with its port, `example.com:8080`.
set_host : String -> Url -> Url
foreign pure set_host from "flick:http/Url" "setHost"
  arity 1

/// The host name, without the port.
set_hostname : String -> Url -> Url
foreign pure set_hostname from "flick:http/Url" "setHostname"
  arity 1

/// The whole URL; a text that is no URL leaves it as it was.
set_href : String -> Url -> Url
foreign pure set_href from "flick:http/Url" "flickSetHref"
  arity 2

/// The password, a secret kept out of `show`.
set_password : Redacted String -> Url -> Url
foreign pure set_password from "flick:http/Url" "setPassword"
  arity 1

/// The path, `/a/b`.
set_pathname : String -> Url -> Url
foreign pure set_pathname from "flick:http/Url" "setPathname"
  arity 1

/// The port.
set_port : Float -> Url -> Url
foreign pure set_port from "flick:http/Url" "setPort"
  arity 1

/// The scheme, `https:`.
set_protocol : String -> Url -> Url
foreign pure set_protocol from "flick:http/Url" "setProtocol"
  arity 1

/// The query string, `?a=1`.
set_search : String -> Url -> Url
foreign pure set_search from "flick:http/Url" "setSearch"
  arity 1

/// The user name.
set_username : String -> Url -> Url
foreign pure set_username from "flick:http/Url" "setUsername"
  arity 1

/// The query, from the parameters.
set_url_params : Http.UrlParams.UrlParams -> Url -> Url
foreign pure set_url_params from "flick:http/Url" "setUrlParams"
  arity 1

/// The parameters of the query.
url_params : Url -> Http.UrlParams.UrlParams
foreign pure url_params from "flick:http/Url" "urlParams"
  arity 1

/// The query, changed by `f`.
modify_url_params : (Http.UrlParams.UrlParams -> Http.UrlParams.UrlParams) -> Url -> Url
foreign pure modify_url_params from "flick:http/Url" "modifyUrlParams"
  arity 1

instance Eq Url =
  let eq x y = href x == href y

instance Show Url =
  let show x = show_url x

show_url : Url -> String
foreign pure show_url from "flick:http/Url" "flickShow"
