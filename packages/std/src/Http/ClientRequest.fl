/// A request for `Http.Client`, an immutable value built by a constructor
/// and the `set_*` functions; `show` masks secret headers.
module Http.ClientRequest exposing (..)

import FileSystem
import Http.Body
import Http.Headers
import Http.Method
import Http.Url
import Http.UrlParams
import PlatformError
import Stream.Core exposing (Stream)

/// A request.
type ClientRequest

/// How a body is compressed by `compress_body`.
type CompressionAlgorithm = Gzip | Deflate
  deriving Eq, Show

/// What `make` and `modify` set besides the method and the URL; `defaults`
/// sets nothing.
type alias Options = {
  urlParams : Option Http.UrlParams.Input;
  hash : Option String;
  headers : Option Http.Headers.Input;
  body : Option Http.Body.Body;
  accept : Option String;
  acceptJson : Bool;
}

/// Options that set nothing: `{ Http.ClientRequest.defaults with acceptJson = true }`.
defaults : Options
let defaults = {
  urlParams = None;
  hash = None;
  headers = None;
  body = None;
  accept = None;
  acceptJson = false;
}

/// A `GET` of no URL.
empty : ClientRequest
foreign pure empty from "flick:http/HttpClientRequest" "empty"

/// A request of every part: method, URL, parameters, hash, headers, body.
make_with :
  Http.Method.Method ->
  String ->
  Http.UrlParams.UrlParams ->
  Option String ->
  Http.Headers.Headers ->
  Http.Body.Body ->
  ClientRequest
foreign pure make_with from "flick:http/HttpClientRequest" "flickMakeWith"
  arity 6

/// A request of the method to the URL, with the options.
make : Http.Method.Method -> String -> Options -> ClientRequest
foreign pure make from "flick:http/HttpClientRequest" "flickMake"
  arity 3

/// A `GET` of the URL.
get : String -> ClientRequest
foreign pure get from "flick:http/HttpClientRequest" "get"
  arity 1

/// A `QUERY` of the URL.
query : String -> ClientRequest
foreign pure query from "flick:http/HttpClientRequest" "query"
  arity 1

/// A `POST` to the URL.
post : String -> ClientRequest
foreign pure post from "flick:http/HttpClientRequest" "post"
  arity 1

/// A `PATCH` of the URL.
patch : String -> ClientRequest
foreign pure patch from "flick:http/HttpClientRequest" "patch"
  arity 1

/// A `PUT` to the URL.
put : String -> ClientRequest
foreign pure put from "flick:http/HttpClientRequest" "put"
  arity 1

/// A `DELETE` of the URL.
delete : String -> ClientRequest
foreign pure delete from "flick:http/HttpClientRequest" "delete"
  arity 1

/// A `HEAD` of the URL.
head : String -> ClientRequest
foreign pure head from "flick:http/HttpClientRequest" "head"
  arity 1

/// An `OPTIONS` of the URL.
options : String -> ClientRequest
foreign pure options from "flick:http/HttpClientRequest" "options"
  arity 1

/// A `TRACE` of the URL.
trace : String -> ClientRequest
foreign pure trace from "flick:http/HttpClientRequest" "trace"
  arity 1

/// The request with what the options set.
modify : Options -> ClientRequest -> ClientRequest
foreign pure modify from "flick:http/HttpClientRequest" "flickModify"
  arity 2

/// The method.
set_method : Http.Method.Method -> ClientRequest -> ClientRequest
foreign pure set_method from "flick:http/HttpClientRequest" "flickSetMethod"
  arity 2

/// Sets a header: `set_header name value request`.
set_header : String -> String -> ClientRequest -> ClientRequest
foreign pure set_header from "flick:http/HttpClientRequest" "setHeader"
  arity 2

/// Sets each of the headers.
set_headers : Http.Headers.Input -> ClientRequest -> ClientRequest
foreign pure set_headers from "flick:http/HttpClientRequest" "setHeaders"
  arity 1

/// The headers, changed by `f`.
update_headers : (Http.Headers.Headers -> Http.Headers.Headers) -> ClientRequest -> ClientRequest
foreign pure update_headers from "flick:http/HttpClientRequest" "updateHeaders"
  arity 1

/// Removes a header.
remove_header : String -> ClientRequest -> ClientRequest
foreign pure remove_header from "flick:http/HttpClientRequest" "removeHeader"
  arity 1

/// `Authorization: Basic …` of the user name and the password.
basic_auth : String -> Redacted String -> ClientRequest -> ClientRequest
foreign pure basic_auth from "flick:http/HttpClientRequest" "basicAuth"
  arity 2

/// `Authorization: Bearer …` of the token.
bearer_token : Redacted String -> ClientRequest -> ClientRequest
foreign pure bearer_token from "flick:http/HttpClientRequest" "bearerToken"
  arity 1

/// The `Accept` header.
accept : String -> ClientRequest -> ClientRequest
foreign pure accept from "flick:http/HttpClientRequest" "accept"
  arity 1

/// `Accept: application/json`.
accept_json : ClientRequest -> ClientRequest
foreign pure accept_json from "flick:http/HttpClientRequest" "acceptJson"
  arity 1

/// The URL; its query becomes the parameters.
set_url : String -> ClientRequest -> ClientRequest
foreign pure set_url from "flick:http/HttpClientRequest" "setUrl"
  arity 1

/// Puts the text before the URL, with one `/` between them.
prepend_url : String -> ClientRequest -> ClientRequest
foreign pure prepend_url from "flick:http/HttpClientRequest" "prependUrl"
  arity 1

/// Puts the path after the URL, with one `/` between them.
append_url : String -> ClientRequest -> ClientRequest
foreign pure append_url from "flick:http/HttpClientRequest" "appendUrl"
  arity 1

/// The URL, changed by `f`.
update_url : (String -> String) -> ClientRequest -> ClientRequest
foreign pure update_url from "flick:http/HttpClientRequest" "updateUrl"
  arity 1

/// Replaces the values of a query parameter by the one.
set_url_param : String -> String -> ClientRequest -> ClientRequest
foreign pure set_url_param from "flick:http/HttpClientRequest" "setUrlParam"
  arity 2

/// `set_url_param` of each pair.
set_url_params : Http.UrlParams.Input -> ClientRequest -> ClientRequest
foreign pure set_url_params from "flick:http/HttpClientRequest" "setUrlParams"
  arity 1

/// Adds a value of a query parameter.
append_url_param : String -> String -> ClientRequest -> ClientRequest
foreign pure append_url_param from "flick:http/HttpClientRequest" "appendUrlParam"
  arity 2

/// `append_url_param` of each pair.
append_url_params : Http.UrlParams.Input -> ClientRequest -> ClientRequest
foreign pure append_url_params from "flick:http/HttpClientRequest" "appendUrlParams"
  arity 1

/// The fragment of the URL.
set_hash : String -> ClientRequest -> ClientRequest
foreign pure set_hash from "flick:http/HttpClientRequest" "setHash"
  arity 1

/// No fragment.
remove_hash : ClientRequest -> ClientRequest
foreign pure remove_hash from "flick:http/HttpClientRequest" "removeHash"
  arity 1

/// The body.
set_body : Http.Body.Body -> ClientRequest -> ClientRequest
foreign pure set_body from "flick:http/HttpClientRequest" "setBody"
  arity 1

/// Compresses the body with the algorithm if it has at least `minSize`
/// bytes (by default any), setting `Content-Encoding`.
compress_body : CompressionAlgorithm -> Option Float -> ClientRequest ->{Async} ClientRequest
foreign effect compress_body from "flick:http/HttpClientRequest" "flickCompressBody"
  arity 3

/// A body of the bytes, of the content type or `application/octet-stream`.
body_uint8_array : List Int -> Option String -> ClientRequest -> ClientRequest
foreign pure body_uint8_array from "flick:http/HttpClientRequest" "flickBodyUint8Array"
  arity 3

/// A body of the text, of the content type or `text/plain`.
body_text : String -> Option String -> ClientRequest -> ClientRequest
foreign pure body_text from "flick:http/HttpClientRequest" "bodyText"
  arity 2
  optional 1

/// A JSON body of the value.
body_json : Json -> ClientRequest ->{; Http.Body.HttpBodyError} ClientRequest
foreign effect body_json from "flick:http/HttpClientRequest" "flickBodyJson"
  arity 2

/// A JSON body of the value as the codec encodes it.
schema_body_json :
  Codec rd re Json a ->
  a ->
  ClientRequest ->{re; SchemaError, Http.Body.HttpBodyError}
  ClientRequest
foreign effect schema_body_json from "flick:http/HttpClientRequest" "flickSchemaBodyJson"
  arity 3

/// A form body of the parameters.
body_url_params : Http.UrlParams.Input -> ClientRequest -> ClientRequest
foreign pure body_url_params from "flick:http/HttpClientRequest" "bodyUrlParams"
  arity 1

/// A `multipart/form-data` body of the fields.
body_form_data : Http.Body.FormDataInput -> ClientRequest -> ClientRequest
foreign pure body_form_data from "flick:http/HttpClientRequest" "flickBodyFormData"
  arity 2

/// A body of the stream's chunks of bytes, of the content type or
/// `application/octet-stream`, and of the length if it is known.
body_stream :
  Stream none e (List Int) -> Option String -> Option Float -> ClientRequest -> ClientRequest
foreign pure body_stream from "flick:http/HttpClientRequest" "flickBodyStream"
  arity 4

/// A body of the file at the path, as `Http.Body.file`.
body_file :
  Http.Body.FileOptions ->
  String ->
  ClientRequest ->{Async, FileSystem.FileSystem; PlatformError.PlatformError}
  ClientRequest
let body_file options path request = set_body (Http.Body.file options path) request

/// The URL with its parameters and hash, if it is a valid URL.
to_url : ClientRequest -> Option Http.Url.Url
foreign pure to_url from "flick:http/HttpClientRequest" "toUrl"
  arity 1

/// The method.
method : ClientRequest -> Http.Method.Method
foreign pure method from "flick:http/HttpClientRequest" "flickMethod"

/// The URL without its parameters.
url : ClientRequest -> String
foreign pure url from "flick:http/HttpClientRequest" "flickUrl"

/// The query parameters.
url_params : ClientRequest -> Http.UrlParams.UrlParams
foreign pure url_params from "flick:http/HttpClientRequest" "flickUrlParams"

/// The fragment.
hash : ClientRequest -> Option String
foreign pure hash from "flick:http/HttpClientRequest" "flickHash"

/// The headers.
headers : ClientRequest -> Http.Headers.Headers
foreign pure headers from "flick:http/HttpClientRequest" "flickHeaders"

/// The body.
body : ClientRequest -> Http.Body.Body
foreign pure body from "flick:http/HttpClientRequest" "flickBody"

instance Show ClientRequest =
  let show x =
    "ClientRequest "
      ++ show (method x)
      ++ " "
      ++ show (Http.UrlParams.redact_url Http.UrlParams.default_redacted_names (url x))
      ++ " "
      ++ show (headers x)
