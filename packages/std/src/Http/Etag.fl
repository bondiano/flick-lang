/// Effect's `Etag`: entity tags of files, made by a `Generator` service;
/// `layer` makes strong tags, `layer_weak` weak ones.
module Http.Etag exposing (..)

import FileSystem

/// An entity tag.
type Etag = Weak String | Strong String
  deriving Eq, Show

/// The header form of the tag: `W/"v"` or `"v"`.
to_string : Etag -> String
let to_string etag =
  match etag with
  | Weak v -> "W/\"" ++ v ++ "\""
  | Strong v -> "\"" ++ v ++ "\""

/// Makes the tag of a file from what `FileSystem.stat` tells of it.
service Generator =
  from_file_info : FileSystem.Info ->{} Etag

/// The tag of the file, from its size and modification time.
from_file_info : FileSystem.Info ->{Generator} Etag
let from_file_info info = Generator.from_file_info info

layer_of : ServiceTag {Generator} -> Layer none none {Generator}
foreign pure layer_of from "flick:http/Etag" "flickLayer"
  reviewed "effect@4.1.2 sha256:616074a7cc92d3ab"

weak_of : ServiceTag {Generator} -> Layer none none {Generator}
foreign pure weak_of from "flick:http/Etag" "flickLayerWeak"
  reviewed "effect@4.1.2 sha256:db322aab894772b2"

/// Strong tags.
layer : Layer none none {Generator}
let layer = layer_of Generator

/// Weak tags.
layer_weak : Layer none none {Generator}
let layer_weak = weak_of Generator
