/// A request a server handles. Its body is read once, by one of `text`,
/// `json`, `url_params_body` or `bytes`, or as a multipart form by
/// `Http.Multipart.persisted`; reading fails with `HttpServerError`. Cookie
/// values are secrets. Streamed bodies and WebSocket upgrades wait for
/// Flick's streams.
module Http.ServerRequest exposing (..)

import ByteSize
import Http.ClientRequest
import Http.Headers
import Http.Method
import Http.ServerError exposing (HttpServerError)
import Http.Url
import Http.UrlParams

/// A request.
type ServerRequest

/// The method.
method : ServerRequest -> Http.Method.Method
foreign pure method from "flick:http/HttpServerRequest" "flickMethod"

/// The URL as the request line gives it, a path with its query: `/a?x=1`.
url : ServerRequest -> String
foreign pure url from "flick:http/HttpServerRequest" "flickUrl"

/// The URL before a router took a prefix from it.
original_url : ServerRequest -> String
foreign pure original_url from "flick:http/HttpServerRequest" "flickOriginalUrl"

/// The headers.
headers : ServerRequest -> Http.Headers.Headers
foreign pure headers from "flick:http/HttpServerRequest" "flickHeaders"

/// The address of the client, if the platform knows it.
remote_address : ServerRequest -> Option String
foreign pure remote_address from "flick:http/HttpServerRequest" "flickRemoteAddress"

/// The cookies of the `Cookie` header.
cookies : ServerRequest ->{} List (String, Redacted String)
foreign cookies from "flick:http/HttpServerRequest" "flickCookies"

/// The parameters of the URL's query.
search_params : ServerRequest -> Http.UrlParams.UrlParams
foreign pure search_params from "flick:http/HttpServerRequest" "flickSearchParams"

/// Each key of the URL's query with all its values.
search_params_from_url : Http.Url.Url -> List (String, List String)
foreign pure search_params_from_url from "flick:http/HttpServerRequest" "flickSearchParamsFromUrl"

/// The body as text.
text : ServerRequest ->{Async; HttpServerError} String
foreign effect text from "flick:http/HttpServerRequest" "flickText"

/// The body as JSON.
json : ServerRequest ->{Async; HttpServerError} Json
foreign effect json from "flick:http/HttpServerRequest" "flickJson"

/// The body as URL parameters (`application/x-www-form-urlencoded`).
url_params_body : ServerRequest ->{Async; HttpServerError} Http.UrlParams.UrlParams
foreign effect url_params_body from "flick:http/HttpServerRequest" "flickUrlParamsBody"

/// The bytes of the body.
bytes : ServerRequest ->{Async; HttpServerError} List Int
foreign effect bytes from "flick:http/HttpServerRequest" "flickBytes"

/// Runs `task` with the largest body a request may have.
with_max_body_size : ByteSize.ByteSize -> (Eff r e a)^c ->{r; e} a
foreign effect with_max_body_size from "flick:http/HttpServerRequest" "flickWithMaxBodySize"
  arity 2
  retention call

/// The request a client would send: method, URL, headers and body.
to_client_request : ServerRequest -> Http.ClientRequest.ClientRequest
foreign pure to_client_request from "flick:http/HttpServerRequest" "toClientRequest"
  arity 1

/// The request a server would get from the client request: a test input.
from_client_request : Http.ClientRequest.ClientRequest -> ServerRequest
foreign pure from_client_request from "flick:http/HttpServerRequest" "fromClientRequest"
  arity 1

/// The full URL of the request, from its `Host` header.
to_url : ServerRequest -> Option Http.Url.Url
foreign pure to_url from "flick:http/HttpServerRequest" "toURL"
  arity 1

/// Decodes the cookies, an object of names and values.
schema_cookies : Codec rd re Json a -> ServerRequest ->{rd; SchemaError} a
foreign effect schema_cookies from "flick:http/HttpServerRequest" "flickSchemaCookies"
  arity 2

/// Decodes the headers.
schema_headers : Codec rd re Json a -> ServerRequest ->{rd; SchemaError} a
foreign effect schema_headers from "flick:http/HttpServerRequest" "flickSchemaHeaders"
  arity 2

/// Decodes the query parameters.
schema_search_params : Codec rd re Json a -> ServerRequest ->{rd; SchemaError} a
foreign effect schema_search_params from "flick:http/HttpServerRequest" "flickSchemaSearchParams"
  arity 2

/// Decodes the JSON body.
schema_body_json :
  Codec rd re Json a -> ServerRequest ->{Async | rd; HttpServerError, SchemaError} a
foreign effect schema_body_json from "flick:http/HttpServerRequest" "flickSchemaBodyJson"
  arity 2

/// Decodes the URL parameters of the body.
schema_body_url_params :
  Codec rd re Json a -> ServerRequest ->{Async | rd; HttpServerError, SchemaError} a
foreign effect schema_body_url_params from "flick:http/HttpServerRequest" "flickSchemaBodyUrlParams"
  arity 2

instance Show ServerRequest =
  let show x =
    "ServerRequest "
      ++ show (method x)
      ++ " "
      ++ show (Http.UrlParams.redact_url Http.UrlParams.default_redacted_names (url x))
      ++ " "
      ++ show (headers x)
