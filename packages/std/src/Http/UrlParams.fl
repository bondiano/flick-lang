/// Effect's `UrlParams`: the parameters of a query string or of a form body,
/// in order, a key possibly given more than once. `show` masks the values
/// of signature parameters (`Signature`, `sig`, …, or the names
/// `with_redacted_names` sets).
module Http.UrlParams exposing (..)

import Http.Headers

/// Parameters, an immutable value.
type UrlParams

/// Parameters given as pairs of key and value.
type alias Input = List (String, String)

/// The parameters of the pairs, in order.
make : Input -> UrlParams
foreign pure make from "@flick-lang/runtime/effect/http/UrlParams" "make"
  arity 1
  reviewed "effect@4.1.2 sha256:89f59bdb49c50212"

/// `make`, as Effect's `fromInput` reads pairs.
from_input : Input -> UrlParams
foreign pure from_input from "@flick-lang/runtime/effect/http/UrlParams" "fromInput"
  arity 1
  reviewed "effect@4.1.2 sha256:012cd12ce82455eb"

/// No parameters.
empty : UrlParams
foreign pure empty from "@flick-lang/runtime/effect/http/UrlParams" "empty"
  reviewed "effect@4.1.2 sha256:767df32d480be42b"

/// Every value of the key, in order.
get_all : String -> UrlParams -> List String
foreign pure get_all from "@flick-lang/runtime/effect/http/UrlParams" "getAll"
  arity 1
  reviewed "effect@4.1.2 sha256:03ab4597392b8a39"

/// The first value of the key.
get_first : String -> UrlParams -> Option String
foreign pure get_first from "@flick-lang/runtime/effect/http/UrlParams" "getFirst"
  arity 1
  reviewed "effect@4.1.2 sha256:35a5671d85ccd879"

/// The last value of the key.
get_last : String -> UrlParams -> Option String
foreign pure get_last from "@flick-lang/runtime/effect/http/UrlParams" "getLast"
  arity 1
  reviewed "effect@4.1.2 sha256:9b0be1a031acdabd"

/// Replaces every value of the key by the one: `set key value params`.
set : String -> String -> UrlParams -> UrlParams
foreign pure set from "@flick-lang/runtime/effect/http/UrlParams" "set"
  arity 2
  reviewed "effect@4.1.2 sha256:e810026311449631"

/// The parameters with their list of pairs changed by `f`.
transform : (Input -> Input) -> UrlParams -> UrlParams
foreign pure transform from "@flick-lang/runtime/effect/http/UrlParams" "transform"
  arity 1
  reviewed "effect@4.1.2 sha256:4f655923d4026b08"

/// `set` for each key of the pairs.
set_all : Input -> UrlParams -> UrlParams
foreign pure set_all from "@flick-lang/runtime/effect/http/UrlParams" "setAll"
  arity 1
  reviewed "effect@4.1.2 sha256:df30bb71b92102d0"

/// Adds a value of the key after the others.
append : String -> String -> UrlParams -> UrlParams
foreign pure append from "@flick-lang/runtime/effect/http/UrlParams" "append"
  arity 2
  reviewed "effect@4.1.2 sha256:86f39b659019c7e8"

/// Adds the pairs after the others.
append_all : Input -> UrlParams -> UrlParams
foreign pure append_all from "@flick-lang/runtime/effect/http/UrlParams" "appendAll"
  arity 1
  reviewed "effect@4.1.2 sha256:8ee9193358a40ea7"

/// Removes every value of the key.
remove : String -> UrlParams -> UrlParams
foreign pure remove from "@flick-lang/runtime/effect/http/UrlParams" "remove"
  arity 1
  reviewed "effect@4.1.2 sha256:2d52793caf887ee7"

/// The query string, `a=1&b=x+y`, without `?`.
to_string : UrlParams -> String
foreign pure to_string from "@flick-lang/runtime/effect/http/UrlParams" "toString"
  arity 1
  reviewed "effect@4.1.2 sha256:7ce2dde888e63199"

/// Each key with all its values, keys in the order of their first value.
to_record : UrlParams -> List (String, List String)
foreign pure to_record from "@flick-lang/runtime/effect/http/UrlParams" "flickToRecord"
  reviewed "effect@4.1.2 sha256:fd5c8dba631f5db3"

/// The pairs, the values of the named keys turned into secrets.
redact : List String -> UrlParams -> List (String, Http.Headers.Redaction)
foreign pure redact from "@flick-lang/runtime/effect/http/UrlParams" "flickRedact"
  arity 2
  reviewed "effect@4.1.2 sha256:9d2ddd13dbcef2f5"

/// Whether the key is among the names, ignoring case.
is_redacted_name : String -> List String -> Bool
foreign pure is_redacted_name from "@flick-lang/runtime/effect/http/UrlParams" "isRedactedName"
  arity 2
  reviewed "effect@4.1.2 sha256:446af9f2160ae36a"

/// The URL with the values of the named query parameters, and a password,
/// replaced by `<redacted>`: `redact_url names url`.
redact_url : List String -> String -> String
foreign pure redact_url from "@flick-lang/runtime/effect/http/UrlParams" "flickRedactUrl"
  arity 2
  reviewed "effect@4.1.2 sha256:19d5a6f80ca683fc"

/// The names of the parameters that logs and `show` mask by default.
default_redacted_names : List String
foreign pure default_redacted_names from "@flick-lang/runtime/effect/http/UrlParams" "flickDefaultRedactedNames"
  reviewed "effect@4.1.2 sha256:c7a7b9cf63e3925a"

/// Runs `task` with the names of the parameters that logs and `show` mask.
with_redacted_names : List String -> (Eff r e a)^c ->{r; e} a
foreign effect with_redacted_names from "@flick-lang/runtime/effect/http/UrlParams" "flickWithRedactedNames"
  arity 2
  retention call
  reviewed "effect@4.1.2 sha256:c7a7b9cf63e3925a"

/// The pairs of key and value, in order.
to_list : UrlParams -> Input
foreign pure to_list from "@flick-lang/runtime/effect/http/UrlParams" "flickToList"

/// The parameters as an object for a codec to decode: a key's value is a
/// string, or an array of strings for a key given more than once.
to_unknown : UrlParams -> Unknown
foreign pure to_unknown from "@flick-lang/runtime/effect/http/UrlParams" "flickToUnknown"
  reviewed "effect@4.1.2 sha256:8f4c3ae49efdad9f"

equivalent : UrlParams -> UrlParams -> Bool
foreign pure equivalent from "@flick-lang/runtime/effect/http/UrlParams" "Equivalence"
  arity 2
  reviewed "effect@4.1.2 sha256:a86b9d2e4bf3cbde"

show_params : UrlParams -> String
foreign pure show_params from "@flick-lang/runtime/effect/http/UrlParams" "flickShow"
  reviewed "effect@4.1.2 sha256:071fcc57ba7aec7c"

instance Eq UrlParams =
  let eq x y = equivalent x y

instance Show UrlParams =
  let show x = show_params x
