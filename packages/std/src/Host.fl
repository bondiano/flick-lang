/// Explicit dependencies on the process and its environment. Provide only the
/// live layers an application needs at its entry boundary, or substitute records
/// in tests. No service here has an implicit default inside a program: only the
/// runner of an entry provides the live ones, to `main`, as its root.
module Host exposing (..)

import Layer
import PlatformError

service Console =
  stdout_line : String ->{} Unit
  stderr_line : String ->{} Unit
  stdout_write : String ->{} Unit

service Clock =
  current_time_millis : Unit ->{} Float
  current_time_nanos : Unit ->{} BigInt
  monotonic_time_nanos : Unit ->{} BigInt

/// A draw in [0, 1). Implementations may hold their own seeded state.
service Random =
  next : Unit ->{} Float

service Environment =
  env : String ->{} Option String

service Arguments =
  args : Unit ->{} List String

/// A program to run, as `ChildProcess.make` describes it.
type Command

/// A running child process of region `s`.
type Child (s : Region)

/// Starts child processes; `ChildProcess` runs its commands through it.
service Process =
  spawn : forall s. Command ->{Scope s; PlatformError.PlatformError} Child s

raw_stdout_line : String ->{} Unit
foreign raw_stdout_line from "flick:rt" "stdoutLine"

raw_stderr_line : String ->{} Unit
foreign raw_stderr_line from "flick:rt" "stderrLine"

raw_stdout_write : String ->{} Unit
foreign raw_stdout_write from "flick:rt" "stdoutWrite"

raw_current_time_millis : Unit ->{} Float
foreign effect raw_current_time_millis from "flick:Clock" "flickCurrentTimeMillis"
  arity 0

raw_current_time_nanos : Unit ->{} BigInt
foreign effect raw_current_time_nanos from "flick:Clock" "flickCurrentTimeNanos"
  arity 0

raw_monotonic_time_nanos : Unit ->{} BigInt
foreign effect raw_monotonic_time_nanos from "flick:Clock" "flickMonotonicTimeNanos"
  arity 0

raw_next : Unit ->{} Float
foreign effect raw_next from "flick:Random" "flickNext"
  arity 0

raw_env : String ->{} Option String
foreign raw_env from "flick:rt" "platformEnv"

raw_args : Unit ->{} List String
foreign raw_args from "flick:rt" "platformArgs"
  arity 0

raw_spawn : Command ->{Scope s; PlatformError.PlatformError} Child s
foreign effect raw_spawn from "flick:rt" "processSpawn"

/// Trusted adapters to ambient host APIs; constructing a layer performs no I/O.
console : Layer none none {Console}
let console =
  Layer.succeed Console {
    stdout_line = raw_stdout_line
    stderr_line = raw_stderr_line
    stdout_write = raw_stdout_write
  }

clock : Layer none none {Clock}
let clock =
  Layer.succeed Clock {
    current_time_millis = raw_current_time_millis
    current_time_nanos = raw_current_time_nanos
    monotonic_time_nanos = raw_monotonic_time_nanos
  }

random : Layer none none {Random}
let random = Layer.succeed Random { next = raw_next }

environment : Layer none none {Environment}
let environment = Layer.succeed Environment { env = raw_env }

arguments : Layer none none {Arguments}
let arguments = Layer.succeed Arguments { args = raw_args }

process : Layer none none {Process}
let process = Layer.succeed Process { spawn = raw_spawn }

/// The six host services of an app running on a host with a process and files.
type alias Live = {Console, Clock, Random, Environment, Arguments, Process}

/// The three host services available in a browser environment.
type alias BrowserLive = {Console, Clock, Random}

/// The live browser services: console, clock, and random.
browser_live : Layer none none BrowserLive
let browser_live = Layer.merge console (Layer.merge clock random)

/// All six live services. Prefer individual layers for narrower boundaries.
live : Layer none none Live
let live =
  Layer.merge
    console
    (Layer.merge
      clock
      (Layer.merge random (Layer.merge environment (Layer.merge arguments process))))
