/// Child processes: a `Command` describes a program to run, its arguments,
/// directory, environment and standard streams; `spawn` starts it as a
/// `Process` of a scope, whose closing stops what still runs, and `string`,
/// `lines` and `exit_code` run it to its end. A process starts in a process
/// group of its own, which stopping it signals.
module ChildProcess exposing (..)

import Duration
import PlatformError
import Stream.Core exposing (Stream)

/// A program to run, with its arguments and how it runs.
type Command

/// A running process of region `s`.
type Process (s : Region)

/// A signal by its name, as `"SIGTERM"`.
type alias Signal = String

/// How `kill_with` stops a process: the signal, and how long to wait for
/// it to end before `SIGKILL`.
type alias KillOptions = { signal : Signal; force_after : Option Duration.Duration }

/// The program with its arguments, without a shell.
make : String -> List String -> Command
foreign pure make from "flick:ChildProcess" "flickMake"
  arity 2

/// Runs the command in the directory.
set_cwd : String -> Command -> Command
foreign pure set_cwd from "flick:ChildProcess" "setCwd"
  arity 1

/// Adds the variables to the environment the command inherits.
set_env : List (String, String) -> Command -> Command
foreign pure set_env from "flick:ChildProcess" "flickSetEnv"
  arity 2

/// Runs the command through the program and its arguments, as `sudo` or
/// `env`.
prefix : String -> List String -> Command -> Command
foreign pure prefix from "flick:ChildProcess" "flickPrefix"
  arity 3

/// `a |> pipe_to b`: the stdout of `a` is the stdin of `b`; the pipeline's
/// output is that of `b`.
pipe_to : Command -> Command -> Command
foreign pure pipe_to from "flick:ChildProcess" "pipeTo"
  arity 1

/// Writes the text to the command's stdin, then closes it.
set_stdin : String -> Command -> Command
foreign pure set_stdin from "flick:ChildProcess" "flickSetStdin"
  arity 2

/// Lets the command write to the program's own stdout and stderr instead
/// of pipes.
inherit_output : Command -> Command
foreign pure inherit_output from "flick:ChildProcess" "flickInheritOutput"

/// Starts the command; the scope of region `s` stops it if it still runs.
spawn : Command ->{Scope s; PlatformError.PlatformError} Process s
foreign effect spawn from "flick:ChildProcess" "flickSpawn"

/// The process's ID.
pid : Process s -> Int
foreign pure pid from "flick:ChildProcess" "flickPid"
  retention call

/// Waits for the process to end: its exit code. A process a signal ended
/// fails.
wait : Process s ->{Async; PlatformError.PlatformError} Int
foreign effect wait from "flick:ChildProcess" "flickWait"
  retention call

/// Whether the process still runs.
is_running : Process s ->{; PlatformError.PlatformError} Bool
foreign effect is_running from "flick:ChildProcess" "flickIsRunning"
  retention call

/// Stops the process with `SIGTERM`, waits for it to end and gives the rest
/// of its process group a second more.
kill : Process s ->{Async; PlatformError.PlatformError} Unit
foreign effect kill from "flick:ChildProcess" "flickKill"
  retention call

/// Stops the process with the signal, then `SIGKILL` after `force_after`.
kill_with : KillOptions -> Process s ->{Async; PlatformError.PlatformError} Unit
foreign effect kill_with from "flick:ChildProcess" "flickKillWith"
  arity 2
  retention call

/// The bytes the process writes to stdout; the stream cannot leave the
/// process's scope.
stdout : Process s -> (Stream {Async} {PlatformError.PlatformError} (List Int))^{s}
foreign pure stdout from "flick:ChildProcess" "flickStdout"
  retention call

/// The bytes the process writes to stderr.
stderr : Process s -> (Stream {Async} {PlatformError.PlatformError} (List Int))^{s}
foreign pure stderr from "flick:ChildProcess" "flickStderr"
  retention call

/// What the command writes to stdout, as text; it runs to its end.
string : Command ->{Async; PlatformError.PlatformError} String
foreign effect string from "flick:ChildProcess" "flickString"

/// The lines the command writes to stdout.
lines : Command ->{Async; PlatformError.PlatformError} List String
foreign effect lines from "flick:ChildProcess" "flickLines"

/// Runs the command to its end: its exit code.
exit_code : Command ->{Async; PlatformError.PlatformError} Int
foreign effect exit_code from "flick:ChildProcess" "flickExitCode"
