/// The type `Channel` and the channels made from values, effects, queues,
/// hubs, schedules and JS streams: the part of `Channel` that starts a
/// pipeline.
module Channel.Core exposing (..)

import Chunk
import PubSub
import Queue
import Schedule

/// A pull-based pipeline stage: it reads elements of `i` from upstream,
/// which may fail with `ie` and end with `id`, and emits elements of `o`,
/// may fail with `e`, and ends with `d`; running it needs `r`. A channel
/// is a description, built purely and run by `Channel.run_*`.
type Channel (r : ServiceRow) (e : ErrorRow) i o d (ie : ErrorRow) id

/// Which side ends a `merge`: `halt_left`, `halt_right`, `halt_both` or
/// `halt_either`.
opaque unboxed type HaltStrategy = HaltStrategy String

/// The merge ends when the left channel does.
halt_left : HaltStrategy
let halt_left = HaltStrategy "left"

/// The merge ends when the right channel does.
halt_right : HaltStrategy
let halt_right = HaltStrategy "right"

/// The merge ends when both channels have.
halt_both : HaltStrategy
let halt_both = HaltStrategy "both"

/// The merge ends when either channel does.
halt_either : HaltStrategy
let halt_either = HaltStrategy "either"

/// A web `ReadableStream` of `a`, as JS code gives it.
type ReadableStream a

/// A web `WritableStream` of `a`, as JS code gives it.
type WritableStream a

/// A web `TransformStream` from `a` to `b`, as JS code gives it.
type TransformStream a b

/// A JS `AsyncIterable` of `a` whose iterator returns `d`.
type AsyncIterable a d

/// How many elements go in one chunk by default.
default_chunk_size : Int
foreign pure default_chunk_size from "flick:Channel" "DefaultChunkSize"

/// Emits the elements of the list, then ends.
from_list : List o -> Channel none none i o Unit ie id
foreign pure from_list from "flick:Channel" "fromArray"

/// Emits the list in chunks of at most `size` elements.
from_list_chunked : Int -> List o -> Channel none none i (NonEmpty.NonEmpty o) Unit ie id
foreign pure from_list_chunked from "flick:Channel" "flickFromListChunked"
  arity 1

/// Emits the elements of the chunk, then ends.
from_chunk : Chunk.Chunk o -> Channel none none i o Unit ie id
foreign pure from_chunk from "flick:Channel" "fromChunk"

/// Emits one element.
succeed : o -> Channel none none i o Unit ie id
foreign pure succeed from "flick:Channel" "succeed"

/// Emits the element `f` computes when the channel runs.
sync : (Unit -> o) -> Channel none none i o Unit ie id
foreign pure sync from "flick:Channel" "sync"

/// Ends at once with the done value.
end : d -> Channel none none i o d ie id
foreign pure end from "flick:Channel" "end"

/// Ends at once with the done value `f` computes when the channel runs.
end_sync : (Unit -> d) -> Channel none none i o d ie id
foreign pure end_sync from "flick:Channel" "endSync"

/// Emits nothing and ends.
empty : Channel none none i o Unit ie id
foreign pure empty from "flick:Channel" "empty"

/// Emits nothing and never ends.
never : Channel none none i o d ie id
foreign pure never from "flick:Channel" "never"

/// Fails with the error.
fail : Errors e -> Channel none e i o d ie id
foreign pure fail from "flick:Channel" "fail"

/// Fails with the error `f` computes when the channel runs.
fail_sync : (Unit -> Errors e) -> Channel none e i o d ie id
foreign pure fail_sync from "flick:Channel" "failSync"

/// Fails with the whole cause of `failure`.
fail_cause : Failure e -> Channel none e i o d ie id
foreign pure fail_cause from "flick:Channel" "flickFailCause"

/// Fails with the cause of the failure `f` computes when the channel runs.
fail_cause_sync : (Unit -> Failure e) -> Channel none e i o d ie id
foreign pure fail_cause_sync from "flick:Channel" "flickFailCauseSync"

/// Emits what the task gives, then ends.
from_effect : Eff r e o -> Channel r e i o Unit ie id
foreign pure from_effect from "flick:Channel" "fromEffect"

/// Runs the task and ends with what it gives, emitting nothing.
from_effect_done : Eff r e d -> Channel r e i o d ie id
foreign pure from_effect_done from "flick:Channel" "fromEffectDone"

/// Runs the task for its effects, emitting nothing.
from_effect_drain : Eff r e a -> Channel r e i o Unit ie id
foreign pure from_effect_drain from "flick:Channel" "fromEffectDrain"

/// Emits the messages of the queue until it ends, failing when it fails.
from_queue : Queue.Queue e o -> Channel none e i o Unit ie id
foreign pure from_queue from "flick:Channel" "fromQueue"

/// `from_queue`, a chunk of the messages there are at a time.
from_queue_array : Queue.Queue e o -> Channel none e i (NonEmpty.NonEmpty o) Unit ie id
foreign pure from_queue_array from "flick:Channel" "fromQueueArray"

/// Emits the messages of a subscription; the channel holds its region, so
/// it cannot leave the subscription's `scope`.
from_subscription : PubSub.Subscription s a -> (Channel none none i a Unit ie id)^{s}
foreign pure from_subscription from "flick:Channel" "fromSubscription"
  retention owner

/// `from_subscription`, a chunk of the messages there are at a time.
from_subscription_array :
  PubSub.Subscription s a -> (Channel none none i (NonEmpty.NonEmpty a) Unit ie id)^{s}
foreign pure from_subscription_array from "flick:Channel" "fromSubscriptionArray"
  retention owner

/// Subscribes to the hub when it runs and emits what is published after.
from_pubsub : PubSub.PubSub o -> Channel none none i o Unit ie id
foreign pure from_pubsub from "flick:Channel" "fromPubSub"

/// `from_pubsub`, a chunk of the messages there are at a time.
from_pubsub_array : PubSub.PubSub o -> Channel none none i (NonEmpty.NonEmpty o) Unit ie id
foreign pure from_pubsub_array from "flick:Channel" "fromPubSubArray"

/// Emits each output of the schedule after its delay, and ends with the
/// last one.
from_schedule : Schedule.Schedule r e Unit o -> Channel r e i o o ie id
foreign pure from_schedule from "flick:Channel" "fromSchedule"

/// The channel `f` builds each time it runs.
suspend : (Unit -> Channel r e i o d ie id) -> Channel r e i o d ie id
foreign pure suspend from "flick:Channel" "suspend"

/// The channel the task builds when it runs.
unwrap : Eff r1 e1 (Channel r e i o d ie id) -> Channel {Async | r + r1} (e + e1) i o d ie id
foreign pure unwrap from "flick:Channel" "unwrap"

/// Passes its input through unchanged.
identity : Unit -> Channel none e a a d e d
foreign pure identity from "flick:Channel" "identity"
  arity 0

/// A queue's options: `capacity` messages (`None`: unbounded) and what a
/// full queue does (`None`: `Suspend`).
type alias Buffer = { capacity : Option Int; strategy : Option Queue.Strategy }

/// Emits what `f` offers to the queue it gets, until `f` ends or fails
/// the queue; `f` runs as long as the channel does.
callback :
  { bufferSize : Option Int; strategy : Option Queue.Strategy } ->
  (Queue.Queue e o ->{r; e} x) ->
  Channel r e i o Unit ie id
foreign pure callback from "flick:Channel" "flickCallback"
  arity 2

/// `callback`, a chunk of the messages there are at a time.
callback_array :
  { bufferSize : Option Int; strategy : Option Queue.Strategy } ->
  (Queue.Queue e o ->{r; e} x) ->
  Channel r e i (NonEmpty.NonEmpty o) Unit ie id
foreign pure callback_array from "flick:Channel" "flickCallbackArray"
  arity 2

/// Acquires a value and emits it; `release` runs when the channel ends.
acquire_release : (a ->{} x) -> Eff r e a -> Channel {Async | r} e i a Unit ie id
foreign pure acquire_release from "flick:Channel" "flickAcquireRelease"
  arity 1

/// Acquires a value, runs the channel `use` builds of it, and releases it
/// with how that channel ended.
acquire_use_release :
  Eff r e a ->
  (a -> Channel r2 e2 i o d ie id) ->
  (a -> Exit e2 d ->{} x) ->
  Channel (r + r2) (e + e2) i o d ie id
foreign pure acquire_use_release from "flick:Channel" "flickAcquireUseRelease"
  arity 3

/// Emits the chunks of a web stream; `onError` makes the typed error of
/// what the stream throws.
from_readable_stream :
  { evaluate : Unit -> ReadableStream a; onError : JsValue -> Errors e; releaseLockOnEnd : Bool } ->
  Channel {Async} e i (NonEmpty.NonEmpty a) Unit ie id
foreign pure from_readable_stream from "flick:Channel" "fromReadableStream"

/// Writes its input chunks to a web stream, closing it at the end when
/// `closeOnDone`.
from_writable_stream :
  { evaluate : Unit -> WritableStream a; onError : JsValue -> Errors e; closeOnDone : Bool } ->
  Channel {Async} (e + ie) (NonEmpty.NonEmpty a) o Unit ie id
foreign pure from_writable_stream from "flick:Channel" "fromWritableStream"

/// Sends its input chunks through a web transform stream and emits what
/// comes out.
from_transform_stream :
  {
    evaluate : Unit -> TransformStream a b;
    onError : JsValue -> Errors e;
    closeOnDone : Bool;
    releaseLockOnEnd : Bool;
  } ->
  Channel {Async} (e + ie) (NonEmpty.NonEmpty a) (NonEmpty.NonEmpty b) Unit ie id
foreign pure from_transform_stream from "flick:Channel" "fromTransformStream"

/// Emits the values of a JS async iterable and ends with what its
/// iterator returns.
from_async_iterable : AsyncIterable a d -> (JsValue -> Errors e) -> Channel {Async} e i a d ie id
foreign pure from_async_iterable from "flick:Channel" "fromAsyncIterable"
  arity 2

/// `from_async_iterable`, in chunks.
from_async_iterable_array :
  AsyncIterable a d -> (JsValue -> Errors e) -> Channel {Async} e i (NonEmpty.NonEmpty a) d ie id
foreign pure from_async_iterable_array from "flick:Channel" "fromAsyncIterableArray"
  arity 2
