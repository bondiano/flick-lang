/// What a channel emits, changed: mapping, filtering, flattening,
/// concatenation, accumulation, buffering and text.
module Channel.Transform exposing (..)

import Channel.Core exposing (..)
import Filter

/// Each element mapped by `f`.
map : (o -> b) -> Channel r e i o d ie id -> Channel r e i b d ie id
foreign pure map from "flick:Channel" "map"
  arity 1

/// Each element mapped by the task `f` gives, one at a time.
map_effect : (o ->{r2; e2} b) -> Channel r e i o d ie id -> Channel (r + r2) (e + e2) i b d ie id
foreign pure map_effect from "flick:Channel" "mapEffect"
  arity 1

/// Runs `f` on each element, emitting the elements unchanged.
tap : (o ->{r2; e2} x) -> Channel r e i o d ie id -> Channel (r + r2) (e + e2) i o d ie id
foreign pure tap from "flick:Channel" "tap"
  arity 1

/// The done value mapped by `f`.
map_done : (d -> d2) -> Channel r e i o d ie id -> Channel r e i o d2 ie id
foreign pure map_done from "flick:Channel" "mapDone"
  arity 1

/// The done value mapped by the task `f` gives.
map_done_effect :
  (d ->{r2; e2} d2) -> Channel r e i o d ie id -> Channel (r + r2) (e + e2) i o d2 ie id
foreign pure map_done_effect from "flick:Channel" "mapDoneEffect"
  arity 1

/// Each upstream element mapped by `f` before the channel reads it.
map_input : (i2 ->{r2; ie} i) -> Channel r e i o d ie id -> Channel (r + r2) e i2 o d ie id
foreign pure map_input from "flick:Channel" "mapInput"
  arity 1

/// Each upstream error mapped by `f` before the channel sees it.
map_input_error :
  (Errors ie2 ->{r2; ie} Errors ie) -> Channel r e i o d ie id -> Channel (r + r2) e i o d ie2 id
foreign pure map_input_error from "flick:Channel" "mapInputError"
  arity 1

/// The elements of the channel `f` builds of each element, one after the
/// other.
flat_map :
  (o -> Channel r2 e2 i o2 d2 ie id) ->
  Channel r e i o d ie id ->
  Channel (r + r2) (e + e2) i o2 d ie id
foreign pure flat_map from "flick:Channel" "flatMap"
  arity 1

/// `flat_map`, dropping the channel of an element when the next one comes.
switch_map :
  (o -> Channel r2 e2 i o2 d2 ie id) ->
  Channel r e i o d ie id ->
  Channel (r + r2) (e + e2) i o2 d ie id
foreign pure switch_map from "flick:Channel" "switchMap"
  arity 1

/// The elements of the channels the channel emits, one channel after the
/// other.
flatten :
  Channel r e i (Channel r2 e2 i o d2 ie id) d ie id -> Channel (r + r2) (e + e2) i o d ie id
foreign pure flatten from "flick:Channel" "flatten"

/// The elements of the lists the channel emits.
flatten_array : Channel r e i (List o) d ie id -> Channel r e i o d ie id
foreign pure flatten_array from "flick:Channel" "flattenArray"

/// How `merge_all` runs the inner channels: at most `concurrency` at once
/// (`None`: all), buffering `bufferSize` elements (`None`: the default);
/// with `switch`, a new channel beyond the limit interrupts the oldest.
type alias MergeOptions = { concurrency : Option Int; bufferSize : Option Int; switch : Bool }

/// The elements of the channels the channel emits, run concurrently.
merge_all :
  MergeOptions ->
  Channel r e i (Channel r2 e2 i o d2 ie id) d ie id ->
  Channel {Async | r + r2} (e + e2) i o d ie id
foreign pure merge_all from "flick:Channel" "flickMergeAll"
  arity 1

/// `self |> concat next`: the elements of `self`, then those of `next`,
/// ending as `next` does.
concat :
  Channel r2 e2 i o d2 ie id -> Channel r e i o d ie id -> Channel (r + r2) (e + e2) i o d2 ie id
foreign pure concat from "flick:Channel" "concat"
  arity 1

/// The elements of the channel, then those of the channel `f` builds of
/// its done value.
concat_with :
  (d -> Channel r2 e2 i o d2 ie id) ->
  Channel r e i o d ie id ->
  Channel (r + r2) (e + e2) i o d2 ie id
foreign pure concat_with from "flick:Channel" "concatWith"
  arity 1

/// The channel, or the one `f` builds of its done value when it emitted
/// nothing.
or_else_if_empty :
  (d -> Channel r2 e2 i o d ie id) ->
  Channel r e i o d ie id ->
  Channel (r + r2) (e + e2) i o d ie id
foreign pure or_else_if_empty from "flick:Channel" "orElseIfEmpty"
  arity 1

/// Runs the channel for its effects, emitting nothing.
drain : Channel r e i o d ie id -> Channel r e i o2 d ie id
foreign pure drain from "flick:Channel" "drain"

/// Runs the channel again each time it ends.
forever : Channel r e i o d ie id -> Channel r e i o d2 ie id
foreign pure forever from "flick:Channel" "forever"

/// The elements for which `f` holds.
filter : (o -> Bool) -> Channel r e i o d ie id -> Channel r e i o d ie id
foreign pure filter from "flick:Channel" "filter"
  arity 1

/// The elements the filter passes, as it maps them.
filter_map : Filter.Filter o b x -> Channel r e i o d ie id -> Channel r e i b d ie id
foreign pure filter_map from "flick:Channel" "filterMap"
  arity 1

/// The elements for which the task `f` gives `True`.
filter_effect :
  (o ->{r2; e2} Bool) -> Channel r e i o d ie id -> Channel (r + r2) (e + e2) i o d ie id
foreign pure filter_effect from "flick:Channel" "filterEffect"
  arity 1

/// The elements the effectful filter passes, as it maps them.
filter_map_effect :
  Filter.FilterEffect r2 e2 o b x ->
  Channel r e i o d ie id ->
  Channel (r + r2) (e + e2) i b d ie id
foreign pure filter_map_effect from "flick:Channel" "filterMapEffect"
  arity 1

/// In each chunk, the elements for which `f` holds; empty chunks are
/// dropped.
filter_array :
  (o -> Bool) ->
  Channel r e i (NonEmpty.NonEmpty o) d ie id ->
  Channel r e i (NonEmpty.NonEmpty o) d ie id
foreign pure filter_array from "flick:Channel" "filterArray"
  arity 1

/// In each chunk, the elements the filter passes, as it maps them.
filter_map_array :
  Filter.Filter o b x ->
  Channel r e i (NonEmpty.NonEmpty o) d ie id ->
  Channel r e i (NonEmpty.NonEmpty b) d ie id
foreign pure filter_map_array from "flick:Channel" "filterMapArray"
  arity 1

/// In each chunk, the elements for which the task `f` gives `True`.
filter_array_effect :
  (o ->{r2; e2} Bool) ->
  Channel r e i (NonEmpty.NonEmpty o) d ie id ->
  Channel (r + r2) (e + e2) i (NonEmpty.NonEmpty o) d ie id
foreign pure filter_array_effect from "flick:Channel" "filterArrayEffect"
  arity 1

/// In each chunk, the elements the effectful filter passes.
filter_map_array_effect :
  Filter.FilterEffect r2 e2 o b x ->
  Channel r e i (NonEmpty.NonEmpty o) d ie id ->
  Channel (r + r2) (e + e2) i (NonEmpty.NonEmpty b) d ie id
foreign pure filter_map_array_effect from "flick:Channel" "filterMapArrayEffect"
  arity 1

/// Threads a state from `initial` through the elements; `f` gives the
/// next state and the elements to emit.
map_accum :
  (Unit -> s) ->
  (s -> o ->{r2; e2} (s, List b)) ->
  Channel r e i o d ie id ->
  Channel (r + r2) (e + e2) i b d ie id
foreign pure map_accum from "flick:Channel" "mapAccum"
  arity 2

/// Emits `initial` and each state `f` folds from the elements.
scan : s -> (s -> o -> s) -> Channel r e i o d ie id -> Channel r e i s d ie id
foreign pure scan from "flick:Channel" "scan"
  arity 2

/// `scan` with a task for each step.
scan_effect :
  s -> (s -> o ->{r2; e2} s) -> Channel r e i o d ie id -> Channel (r + r2) (e + e2) i s d ie id
foreign pure scan_effect from "flick:Channel" "scanEffect"
  arity 2

/// Runs the channel ahead of its reader, keeping what it emits in a queue
/// with the options.
buffer : Buffer -> Channel r e i o d ie id -> Channel {Async | r} e i o d ie id
foreign pure buffer from "flick:Channel" "flickBuffer"
  arity 1

/// `buffer` counting elements of the chunks.
buffer_array :
  Buffer ->
  Channel r e i (NonEmpty.NonEmpty o) d ie id ->
  Channel {Async | r} e i (NonEmpty.NonEmpty o) d ie id
foreign pure buffer_array from "flick:Channel" "flickBufferArray"
  arity 1

/// Splits chunks of text into chunks of lines, across chunk borders.
split_lines : Unit -> Channel none e (NonEmpty.NonEmpty String) (NonEmpty.NonEmpty String) d e d
foreign pure split_lines from "flick:Channel" "splitLines"
  arity 0

/// Decodes chunks of bytes (numbers from 0 to 255) as text in the
/// encoding, such as `"utf-8"`.
decode_text :
  String -> Channel none e (NonEmpty.NonEmpty (List Int)) (NonEmpty.NonEmpty String) d e d
foreign pure decode_text from "flick:Channel" "flickDecodeText"

/// Encodes chunks of text as UTF-8 bytes.
encode_text : Unit -> Channel none e (NonEmpty.NonEmpty String) (NonEmpty.NonEmpty (List Int)) d e d
foreign pure encode_text from "flick:Channel" "flickEncodeText"
  arity 0

/// `self |> pipe_to next`: `next` reads what `self` emits, its errors and
/// its done value.
pipe_to : Channel r2 e2 o o2 d2 e d -> Channel r e i o d ie id -> Channel (r + r2) e2 i o2 d2 ie id
foreign pure pipe_to from "flick:Channel" "pipeTo"
  arity 1

/// `pipe_to` a channel that expects no upstream errors: an error of `self`
/// fails the result directly.
pipe_to_or_fail :
  Channel r2 e2 o o2 d2 none d -> Channel r e i o d ie id -> Channel (r + r2) (e + e2) i o2 d2 ie id
foreign pure pipe_to_or_fail from "flick:Channel" "pipeToOrFail"
  arity 1
