/// Running a channel that reads no upstream: collecting, folding, or
/// feeding a queue or hub. A runner needs the channel's services and fails
/// with its errors.
module Channel.Run exposing (..)

import Channel.Core exposing (..)
import PubSub
import Queue

/// Every element, in order.
run_collect : (Channel r e i o d none Unit)^c ->{r; e} List o
foreign effect run_collect from "flick:Channel" "runCollect"
  retention call

/// The number of elements.
run_count : (Channel r e i o d none Unit)^c ->{r; e} Int
foreign effect run_count from "flick:Channel" "runCount"
  retention call

/// Runs the channel for its effects; its done value.
run_drain : (Channel r e i o d none Unit)^c ->{r; e} d
foreign effect run_drain from "flick:Channel" "runDrain"
  retention call

/// The first element, if any; the rest is not pulled.
run_head : (Channel r e i o d none Unit)^c ->{r; e} Option o
foreign effect run_head from "flick:Channel" "runHead"
  retention call

/// The last element, if any.
run_last : (Channel r e i o d none Unit)^c ->{r; e} Option o
foreign effect run_last from "flick:Channel" "runLast"
  retention call

/// Folds the elements from `initial` with `f`.
run_fold : (Unit -> z) -> (z -> o -> z) -> (Channel r e i o d none Unit)^c ->{r; e} z
foreign effect run_fold from "flick:Channel" "runFold"
  arity 2
  retention call

/// `run_fold` with a task for each step.
run_fold_effect :
  (Unit -> z) -> (z -> o ->{r2; e2} z) -> (Channel r e i o d none Unit)^c ->{r + r2; e + e2} z
foreign effect run_fold_effect from "flick:Channel" "runFoldEffect"
  arity 2
  retention call

/// Runs `f` on each element; the done value.
run_for_each : (o ->{r2; e2} Unit) -> (Channel r e i o d none Unit)^c ->{r + r2; e + e2} d
foreign effect run_for_each from "flick:Channel" "runForEach"
  arity 1
  retention call

/// Runs `f` on each element while it gives `True`.
run_for_each_while : (o ->{r2; e2} Bool) -> (Channel r e i o d none Unit)^c ->{r + r2; e + e2} Unit
foreign effect run_for_each_while from "flick:Channel" "runForEachWhile"
  arity 1
  retention call

/// The bytes of all the chunks, concatenated.
mk_uint8_array : (Channel r e i (NonEmpty.NonEmpty (List Int)) d none Unit)^c ->{r; e} List Int
foreign effect mk_uint8_array from "flick:Channel" "flickMkUint8Array"
  retention call

/// Offers every element to the queue, then ends it, or fails it with the
/// channel's failure.
run_into_queue : Queue.Queue e o -> (Channel r e i o d none Unit)^c ->{r} Unit
foreign effect run_into_queue from "flick:Channel" "runIntoQueue"
  arity 1
  retention call

/// `run_into_queue` of the elements of each chunk.
run_into_queue_array :
  Queue.Queue e o -> (Channel r e i (NonEmpty.NonEmpty o) d none Unit)^c ->{r} Unit
foreign effect run_into_queue_array from "flick:Channel" "runIntoQueueArray"
  arity 1
  retention call

/// Runs the channel in the background of the innermost `scope` (or the
/// one of region `s`) into a queue with the options; the queue ends, or
/// fails, as the channel does, and is shut down when the scope closes.
to_queue : Buffer -> (Channel r e i o d none Unit)^c ->{Scope s | r} Queue.Queue e o
foreign effect to_queue from "flick:Channel" "flickToQueue"
  arity 1
  retention owner

/// `to_queue` of the elements of each chunk.
to_queue_array :
  Buffer -> (Channel r e i (NonEmpty.NonEmpty o) d none Unit)^c ->{Scope s | r} Queue.Queue e o
foreign effect to_queue_array from "flick:Channel" "flickToQueueArray"
  arity 1
  retention owner

/// A hub's options for `to_pubsub`: its `capacity` (`None`: unbounded)
/// and strategy, the last `replay` messages for a new subscriber, and
/// whether the hub shuts down when the channel ends.
type alias HubOptions = {
  capacity : Option Int;
  strategy : Option Queue.Strategy;
  replay : Option Int;
  shutdownOnEnd : Bool;
}

/// Runs the channel in the background of the innermost `scope` (or the
/// one of region `s`), publishing its elements to a new hub.
to_pubsub : HubOptions -> (Channel r e i o d none Unit)^c ->{Scope s | r} PubSub.PubSub o
foreign effect to_pubsub from "flick:Channel" "flickToPubSub"
  arity 1
  retention owner

/// `to_pubsub` of the elements of each chunk.
to_pubsub_array :
  HubOptions -> (Channel r e i (NonEmpty.NonEmpty o) d none Unit)^c ->{Scope s | r} PubSub.PubSub o
foreign effect to_pubsub_array from "flick:Channel" "flickToPubSubArray"
  arity 1
  retention owner

/// Publishes every element to the hub, shutting it down at the end when
/// `shutdownOnEnd`.
run_into_pubsub :
  { shutdownOnEnd : Bool } -> PubSub.PubSub o -> (Channel r e i o d none Unit)^c ->{r; e} Unit
foreign effect run_into_pubsub from "flick:Channel" "flickRunIntoPubSub"
  arity 2
  retention call

/// `run_into_pubsub` of the elements of each chunk; the done value.
run_into_pubsub_array :
  { shutdownOnEnd : Bool } ->
  PubSub.PubSub o ->
  (Channel r e i (NonEmpty.NonEmpty o) d none Unit)^c ->{r; e}
  d
foreign effect run_into_pubsub_array from "flick:Channel" "flickRunIntoPubSubArray"
  arity 2
  retention call
