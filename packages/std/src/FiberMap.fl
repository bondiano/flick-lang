/// A map of children, at most one per key, owned by a `scope` and
/// interrupted when it closes; running a key again interrupts its child.
/// `join` waits for the first failure, so the map supervises its children.
module FiberMap exposing (..)

import Fiber

/// Children of region `s` by keys of `k`, failing with `e` or giving `a`.
type FiberMap (s : Region) k (e : ErrorRow) a

/// How `set` keeps a child: `onlyIfMissing` leaves a running one of the
/// key; `propagateInterruption` makes an interruption fail `join`.
type alias SetOptions = { onlyIfMissing : Bool; propagateInterruption : Bool }

/// `SetOptions` for `run`; `startImmediately` runs the child before `run`
/// returns.
type alias RunOptions = {
  onlyIfMissing : Bool;
  propagateInterruption : Bool;
  startImmediately : Bool;
}

/// An empty map owned by the innermost `scope` (or the one of region `s`).
make : Unit ->{Scope s} FiberMap s k e a
foreign effect make from "flick:FiberMap" "flickMake"
  arity 0

/// Runs `task` as the child of `key`; it may hold only what outlives the
/// map's region.
run :
  Fiber.Outlives c s =>
  RunOptions -> k -> (Eff {Scope s | r} e a)^c -> FiberMap s k e a ->{r} Fiber.Fiber e a
foreign effect run from "flick:FiberMap" "flickRun"
  arity 1
  retention owner

/// Keeps a child spawned elsewhere as the one of `key`.
set : SetOptions -> k -> Fiber.Fiber e a -> FiberMap s k e a ->{Async} Unit
foreign effect set from "flick:FiberMap" "flickSet"
  arity 1
  retention call

/// The child of `key`, if one is running.
get : k -> FiberMap s k e a ->{} Option (Fiber.Fiber e a)
foreign effect get from "flick:FiberMap" "flickGet"
  arity 1
  retention call

/// Whether a child of `key` is running.
has : k -> FiberMap s k e a ->{} Bool
foreign effect has from "flick:FiberMap" "has"
  arity 1
  retention call

/// Interrupts the child of `key` and removes it.
remove : k -> FiberMap s k e a ->{Async} Unit
foreign effect remove from "flick:FiberMap" "remove"
  arity 1
  retention call

/// Interrupts every child and empties the map.
clear : FiberMap s k e a ->{Async} Unit
foreign effect clear from "flick:FiberMap" "clear"
  retention call

/// How many children are running.
size : FiberMap s k e a ->{} Int
foreign effect size from "flick:FiberMap" "size"
  retention call

/// Waits until the scope closes or a child fails, and fails as it did.
join : FiberMap s k e a ->{Async; e} Unit
foreign effect join from "flick:FiberMap" "join"
  retention call

/// Waits until no child is running, or fails as the first failed one did.
await_empty : FiberMap s k e a ->{Async; e} Unit
foreign effect await_empty from "flick:FiberMap" "awaitEmpty"
  retention call
