/// Reads of the time, through the `Host.Clock` service. The live clock is
/// the fiber's, which `Test.clock_test` replaces with virtual time.
module Clock exposing (..)

import Host

/// The milliseconds since 1970-01-01 UTC.
current_time_millis : Unit ->{Host.Clock} Float
let current_time_millis () = Host.Clock.current_time_millis ()

/// The nanoseconds since 1970-01-01 UTC.
current_time_nanos : Unit ->{Host.Clock} BigInt
let current_time_nanos () = Host.Clock.current_time_nanos ()

/// Monotonic nanoseconds: never go back, for measuring elapsed time.
monotonic_time_nanos : Unit ->{Host.Clock} BigInt
let monotonic_time_nanos () = Host.Clock.monotonic_time_nanos ()
