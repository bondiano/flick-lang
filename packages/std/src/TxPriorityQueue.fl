/// Effect's `TxPriorityQueue`: a queue that hands out its least element
/// by `Ord` first, inside `Tx.atomically` transactions; a take from an
/// empty one retries the transaction until it holds an element.
module TxPriorityQueue exposing (..)

import Tx

/// A transactional priority queue of `a`.
type TxPriorityQueue a

/// A new empty queue.
empty : Ord a => Unit ->{} TxPriorityQueue a
foreign effect empty from "flick:TxPriorityQueue" "flickEmpty"
  arity 0
  reviewed "effect@4.1.2 sha256:35599b1cfa875064"

/// A new queue of the elements of the list.
from_iterable : Ord a => List a ->{} TxPriorityQueue a
foreign effect from_iterable from "flick:TxPriorityQueue" "flickFromIterable"
  reviewed "effect@4.1.2 sha256:e291c2b06043a8a9"

/// A new queue of the elements, as `from_iterable`.
make : Ord a => List a ->{} TxPriorityQueue a
foreign effect make from "flick:TxPriorityQueue" "flickMake"
  reviewed "effect@4.1.2 sha256:8ef1b1f2f253a7e1"

/// The number of elements.
size : TxPriorityQueue a ->{Tx.Transaction} Int
foreign effect size from "flick:TxPriorityQueue" "size"
  reviewed "effect@4.1.2 sha256:9234fe546b322b3a"

/// Whether it has no elements.
is_empty : TxPriorityQueue a ->{Tx.Transaction} Bool
foreign effect is_empty from "flick:TxPriorityQueue" "isEmpty"
  reviewed "effect@4.1.2 sha256:4b513c9574de2188"

/// Whether it has an element.
is_non_empty : TxPriorityQueue a ->{Tx.Transaction} Bool
foreign effect is_non_empty from "flick:TxPriorityQueue" "isNonEmpty"
  reviewed "effect@4.1.2 sha256:475b56d1f07c9681"

/// The least element, kept in the queue, waiting for one.
peek : TxPriorityQueue a ->{Tx.Transaction} a
foreign effect peek from "flick:TxPriorityQueue" "peek"
  reviewed "effect@4.1.2 sha256:985eff68699a41f3"

/// The least element, kept in the queue, if there is one.
peek_option : TxPriorityQueue a ->{Tx.Transaction} Option a
foreign effect peek_option from "flick:TxPriorityQueue" "peekOption"
  reviewed "effect@4.1.2 sha256:774e3ba6e6fee773"

/// Adds the element.
offer : a -> TxPriorityQueue a ->{Tx.Transaction} Unit
foreign effect offer from "flick:TxPriorityQueue" "offer"
  arity 1
  reviewed "effect@4.1.2 sha256:e7d66e51c8ee6848"

/// Adds the elements.
offer_all : List a -> TxPriorityQueue a ->{Tx.Transaction} Unit
foreign effect offer_all from "flick:TxPriorityQueue" "offerAll"
  arity 1
  reviewed "effect@4.1.2 sha256:74be140ae520bd4a"

/// Removes the least element, waiting for one.
take : TxPriorityQueue a ->{Async, Tx.Transaction} a
foreign effect take from "flick:TxPriorityQueue" "take"
  reviewed "effect@4.1.2 sha256:7f082437c530d85a"

/// Removes every element, least first.
take_all : TxPriorityQueue a ->{Async, Tx.Transaction} List a
foreign effect take_all from "flick:TxPriorityQueue" "takeAll"
  reviewed "effect@4.1.2 sha256:504363044f11f4aa"

/// Removes the least element, if there is one.
take_option : TxPriorityQueue a ->{Async, Tx.Transaction} Option a
foreign effect take_option from "flick:TxPriorityQueue" "takeOption"
  reviewed "effect@4.1.2 sha256:435c4930b49ef6ae"

/// Removes at most `n` elements, least first.
take_up_to : Int -> TxPriorityQueue a ->{Tx.Transaction} List a
foreign effect take_up_to from "flick:TxPriorityQueue" "takeUpTo"
  arity 1
  reviewed "effect@4.1.2 sha256:022d31005067b046"

/// Removes the elements the predicate accepts.
remove_if : (a -> Bool)^c -> TxPriorityQueue a ->{Tx.Transaction} Unit
foreign effect remove_if from "flick:TxPriorityQueue" "removeIf"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:d1190553201205ed"

/// Keeps only the elements the predicate accepts.
retain_if : (a -> Bool)^c -> TxPriorityQueue a ->{Tx.Transaction} Unit
foreign effect retain_if from "flick:TxPriorityQueue" "retainIf"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:a8de5abb9e02524f"

/// The elements, least first, kept in the queue.
to_array : TxPriorityQueue a ->{Tx.Transaction} List a
foreign effect to_array from "flick:TxPriorityQueue" "toArray"
  reviewed "effect@4.1.2 sha256:fa51c722a9f6901c"
