/// An exact, non-negative number of bytes, made from decimal (`kilobytes`,
/// 1000) or binary (`kibibytes`, 1024) units and formatted back into them.
/// Constructors refuse a negative or inexact size.
module ByteSize exposing (
  ByteSize,
  ByteUnit(..),
  FormatOptions,
  default_format,
  zero,
  bytes,
  kilobytes,
  megabytes,
  gigabytes,
  terabytes,
  petabytes,
  exabytes,
  zettabytes,
  yottabytes,
  ronnabytes,
  quettabytes,
  kibibytes,
  mebibytes,
  gibibytes,
  tebibytes,
  pebibytes,
  exbibytes,
  zebibytes,
  yobibytes,
  from_string,
  is_zero,
  to_bigint,
  to_number,
  to_unit,
  equals,
  between,
  clamp,
  min,
  max,
  is_less_than,
  is_less_than_or_equal_to,
  is_greater_than,
  is_greater_than_or_equal_to,
  sum,
  subtract,
  times,
  divide,
  format,
  reducer_sum,
  combiner_max,
  combiner_min,
  json,
  json_number,
  json_bigint,
)

import BigInt
import Combiner
import Reducer

/// A number of bytes, a `BigInt` at run time.
opaque unboxed type ByteSize = ByteSize BigInt

/// A unit: the byte, the decimal units (`KB` is `kB`) and the binary ones.
type ByteUnit =
  | B
  | KB
  | MB
  | GB
  | TB
  | PB
  | EB
  | ZB
  | YB
  | RB
  | QB
  | KiB
  | MiB
  | GiB
  | TiB
  | PiB
  | EiB
  | ZiB
  | YiB

/// How `format` writes a size: the digits after the point (2 by default; cut
/// to an integer from 0 to 20), whether to keep trailing zeros, and either a
/// unit or the largest fitting one of the binary or the decimal units.
type alias FormatOptions = {
  precision : Option Int;
  trailingZeros : Option Bool;
  binary : Bool;
  unit : Option ByteUnit;
}

/// The options of `format` that pick the largest fitting binary unit.
default_format : FormatOptions
let default_format = { precision = None; trailingZeros = None; binary = true; unit = None }

/// The most bytes a `Float` counts exactly.
safe : BigInt
let safe = 9007199254740991n

/// The place of a binary unit above the byte after the decimal units, 11 for `KiB`.
binary_place : ByteUnit -> Int
let binary_place unit =
  match unit with
  | KiB -> 11
  | MiB -> 12
  | GiB -> 13
  | TiB -> 14
  | PiB -> 15
  | EiB -> 16
  | ZiB -> 17
  | YiB -> 18
  | B | KB | MB | GB | TB | PB | EB | ZB | YB | RB | QB -> 0

/// The place of a unit: 0 for the byte, 1 to 10 for the decimal units.
place : ByteUnit -> Int
let place unit =
  match unit with
  | B -> 0
  | KB -> 1
  | MB -> 2
  | GB -> 3
  | TB -> 4
  | PB -> 5
  | EB -> 6
  | ZB -> 7
  | YB -> 8
  | RB | QB | KiB | MiB | GiB | TiB | PiB | EiB | ZiB | YiB -> later_place unit

/// The places past `YB`.
later_place : ByteUnit -> Int
let later_place unit =
  match unit with
  | RB -> 9
  | QB -> 10
  | KiB | MiB | GiB | TiB | PiB | EiB | ZiB | YiB -> binary_place unit
  | B | KB | MB | GB | TB | PB | EB | ZB | YB -> 0

symbols : List String
let symbols = [
  "B",
  "kB",
  "MB",
  "GB",
  "TB",
  "PB",
  "EB",
  "ZB",
  "YB",
  "RB",
  "QB",
  "KiB",
  "MiB",
  "GiB",
  "TiB",
  "PiB",
  "EiB",
  "ZiB",
  "YiB",
]

words : List String
let words = [
  "byte",
  "kilobyte",
  "megabyte",
  "gigabyte",
  "terabyte",
  "petabyte",
  "exabyte",
  "zettabyte",
  "yottabyte",
  "ronnabyte",
  "quettabyte",
  "kibibyte",
  "mebibyte",
  "gibibyte",
  "tebibyte",
  "pebibyte",
  "exbibyte",
  "zebibyte",
  "yobibyte",
]

/// The bytes of the unit at each place.
factors : List BigInt
let factors =
  List.map
    (fun at ->
      if at <= 10 then 1000n ** Numeric.bigint_of at else 1024n ** Numeric.bigint_of (at - 10)
    )
    (List.range 0 19)

/// The bytes of the unit at a place.
factor_at : Int -> BigInt
let factor_at at = Option.with_default 1n (List.get at factors)

/// The bytes of a unit.
factor : ByteUnit -> BigInt
let factor unit = factor_at (place unit)

/// How the unit at a place is written after a number.
symbol_at : Int -> String
let symbol_at at = Option.with_default "B" (List.get at symbols)

/// Each way to name a unit in text, with its bytes: its symbol, its word and
/// the plural of the word.
named : List (String, BigInt)
let named =
  List.flat_map
    (fun at ->
      let word = Option.with_default "byte" (List.get at words)
      [(symbol_at at, factor_at at), (word, factor_at at), (word ++ "s", factor_at at)]
    )
    (List.range 0 19)

/// Whether `text` is one decimal digit or more.
digits : String -> Bool
let digits text =
  not (String.is_empty text) && List.all (fun c -> c >= "0" && c <= "9") (String.chars text)

/// `10` to the power `n`.
/// Ten to each power up to thirty, made once: a size is scaled and rounded
/// by one of these in nearly every call.
tens : List BigInt
let tens = List.map (fun n -> 10n ** Numeric.bigint_of n) (List.range 0 31)

ten_to : Int -> BigInt
let ten_to n =
  match List.get n tens with
  | Some power -> power
  | None -> 10n ** Numeric.bigint_of n

/// The bytes of `quantity` units of `by` bytes, when that is whole: `quantity`
/// is digits, with a fraction or an exponent as a `Float` is written.
scaled : String -> BigInt -> Option BigInt
let scaled quantity by =
  let (mantissa, exponent) =
    match String.split "e" quantity with
    | [m, e] -> (
      m,
      Int.parse (if String.starts_with "+" e then String.slice 1 (String.length e) e else e),
    )
    | _ -> (quantity, Some 0)
  let (whole, fraction, pointed) =
    match String.split "." mantissa with
    | [w, f] -> (w, f, true)
    | _ -> (mantissa, "", false)
  match (exponent, BigInt.parse (whole ++ fraction)) with
  | (Some power, Some number) when digits whole && (not pointed || digits fraction) ->
    let shift = power - String.length fraction
    if shift >= 0 then
      Some (ten_to shift * number * by)
    else if 1n * number * by % ten_to (0 - shift) == 0n then
      Some (1n * number * by / ten_to (0 - shift))
    else
      None
  | _ -> None

/// `n` units as a size, when that is a whole, non-negative, safe number of bytes.
counted : ByteUnit -> Float -> Option ByteSize
let counted unit n =
  if not (Float.is_finite n) || n < 0 then
    None
  else if Float.is_safe_integer n then
    match BigInt.from_number n with
    | Some count when count * factor unit <= safe -> Some (ByteSize (count * factor unit))
    | _ -> None
  else
    match scaled (Float.to_string n) (factor unit) with
    | Some count when count <= safe -> Some (ByteSize count)
    | _ -> None

/// `value` in units of `by` bytes times `scale`, rounded half up.
rounded : BigInt -> BigInt -> BigInt -> BigInt
let rounded value by scale = (2n * value * scale + by) / (2n * by)

/// `text` without the zeros it ends with.
unpadded : String -> String
let rec unpadded text =
  if String.ends_with "0" text then
    unpadded (String.slice 0 (String.length text - 1) text)
  else
    text

/// `value` bytes written in the unit at `at` with `precision` digits after the point.
written : BigInt -> Int -> Int -> Bool -> String
let written value at precision zeros =
  let scale = ten_to precision
  let amount = rounded value (factor_at at) scale
  let whole = BigInt.to_string (amount / scale)
  let padded = String.pad_start precision "0" (BigInt.to_string (amount % scale))
  let fraction = if zeros then padded else unpadded padded
  if precision == 0 || String.is_empty fraction then
    whole ++ " " ++ symbol_at at
  else
    whole ++ "." ++ fraction ++ " " ++ symbol_at at

/// The place, from `at` down to `least`, of the largest unit `value` reaches.
reached : BigInt -> Int -> Int -> Int
let rec reached value least at =
  if at > least && value < factor_at at then reached value least (at - 1) else at

/// No bytes.
zero : ByteSize
let zero = ByteSize 0n

instance Eq ByteSize =
  let eq x y = equals x y

instance Ord ByteSize =
  let compare x y = compare (to_bigint x) (to_bigint y)

instance Hash ByteSize =
  let hash x = hash (to_bigint x)

instance Show ByteSize =
  let show x = format default_format x

/// `n` bytes; `None` unless that is a whole, non-negative, safe number of bytes.
bytes : Float -> Option ByteSize
let bytes n = counted B n

/// `n` kB (1000 bytes); `None` unless that is a whole, non-negative, safe number of bytes.
kilobytes : Float -> Option ByteSize
let kilobytes n = counted KB n

/// `n` MB; `None` unless that is a whole, non-negative, safe number of bytes.
megabytes : Float -> Option ByteSize
let megabytes n = counted MB n

/// `n` GB; `None` unless that is a whole, non-negative, safe number of bytes.
gigabytes : Float -> Option ByteSize
let gigabytes n = counted GB n

/// `n` TB; `None` unless that is a whole, non-negative, safe number of bytes.
terabytes : Float -> Option ByteSize
let terabytes n = counted TB n

/// `n` PB; `None` unless that is a whole, non-negative, safe number of bytes.
petabytes : Float -> Option ByteSize
let petabytes n = counted PB n

/// `n` EB; `None` unless that is a whole, non-negative, safe number of bytes.
exabytes : Float -> Option ByteSize
let exabytes n = counted EB n

/// `n` ZB; `None` unless that is a whole, non-negative, safe number of bytes.
zettabytes : Float -> Option ByteSize
let zettabytes n = counted ZB n

/// `n` YB; `None` unless that is a whole, non-negative, safe number of bytes.
yottabytes : Float -> Option ByteSize
let yottabytes n = counted YB n

/// `n` RB; `None` unless that is a whole, non-negative, safe number of bytes.
ronnabytes : Float -> Option ByteSize
let ronnabytes n = counted RB n

/// `n` QB; `None` unless that is a whole, non-negative, safe number of bytes.
quettabytes : Float -> Option ByteSize
let quettabytes n = counted QB n

/// `n` KiB (1024 bytes); `None` unless that is a whole, non-negative, safe number of bytes.
kibibytes : Float -> Option ByteSize
let kibibytes n = counted KiB n

/// `n` MiB; `None` unless that is a whole, non-negative, safe number of bytes.
mebibytes : Float -> Option ByteSize
let mebibytes n = counted MiB n

/// `n` GiB; `None` unless that is a whole, non-negative, safe number of bytes.
gibibytes : Float -> Option ByteSize
let gibibytes n = counted GiB n

/// `n` TiB; `None` unless that is a whole, non-negative, safe number of bytes.
tebibytes : Float -> Option ByteSize
let tebibytes n = counted TiB n

/// `n` PiB; `None` unless that is a whole, non-negative, safe number of bytes.
pebibytes : Float -> Option ByteSize
let pebibytes n = counted PiB n

/// `n` EiB; `None` unless that is a whole, non-negative, safe number of bytes.
exbibytes : Float -> Option ByteSize
let exbibytes n = counted EiB n

/// `n` ZiB; `None` unless that is a whole, non-negative, safe number of bytes.
zebibytes : Float -> Option ByteSize
let zebibytes n = counted ZiB n

/// `n` YiB; `None` unless that is a whole, non-negative, safe number of bytes.
yobibytes : Float -> Option ByteSize
let yobibytes n = counted YiB n

/// The size a string spells, as `"1.5 kB"` or `"2 mebibytes"`.
from_string : String -> Option ByteSize
let from_string text =
  let trimmed = String.trim text
  let quantity =
    String.join "" (List.take_while (fun c -> c == "." || digits c) (String.chars trimmed))
  let unit = String.trim (String.slice (String.length quantity) (String.length trimmed) trimmed)
  match List.find (fun (name, _) -> name == unit) named with
  | Some (_, by) -> Option.map ByteSize (scaled quantity by)
  | None -> None

/// Whether the size is no bytes.
is_zero : ByteSize -> Bool
let is_zero (ByteSize bytes) = bytes == 0n

/// The number of bytes.
to_bigint : ByteSize -> BigInt
let to_bigint (ByteSize bytes) = bytes

/// The number of bytes, when it is a safe integer.
to_number : ByteSize -> Option Float
let to_number (ByteSize bytes) = if bytes <= safe then Some (BigInt.to_number bytes) else None

/// The size in a unit, as a number that may be fractional.
to_unit : ByteUnit -> ByteSize -> Float
let to_unit unit (ByteSize bytes) = BigInt.to_number bytes / BigInt.to_number (factor unit)

/// Whether both are the same number of bytes.
equals : ByteSize -> ByteSize -> Bool
let equals (ByteSize that) (ByteSize self) = self == that

/// Whether `self` lies within `minimum` and `maximum`, both included.
between : { minimum : ByteSize; maximum : ByteSize } -> ByteSize -> Bool
let between bounds self =
  to_bigint self >= to_bigint bounds.minimum && to_bigint self <= to_bigint bounds.maximum

/// `self` kept within `minimum` and `maximum`.
clamp : { minimum : ByteSize; maximum : ByteSize } -> ByteSize -> ByteSize
let clamp bounds self =
  if to_bigint self < to_bigint bounds.minimum then
    bounds.minimum
  else if to_bigint self > to_bigint bounds.maximum then
    bounds.maximum
  else
    self

/// The smaller of the two.
min : ByteSize -> ByteSize -> ByteSize
let min that self = if to_bigint self < to_bigint that then self else that

/// The larger of the two.
max : ByteSize -> ByteSize -> ByteSize
let max that self = if to_bigint self > to_bigint that then self else that

/// `self < that`: `size |> ByteSize.is_less_than limit`.
is_less_than : ByteSize -> ByteSize -> Bool
let is_less_than (ByteSize that) (ByteSize self) = self < that

/// `self <= that`.
is_less_than_or_equal_to : ByteSize -> ByteSize -> Bool
let is_less_than_or_equal_to (ByteSize that) (ByteSize self) = self <= that

/// `self > that`.
is_greater_than : ByteSize -> ByteSize -> Bool
let is_greater_than (ByteSize that) (ByteSize self) = self > that

/// `self >= that`.
is_greater_than_or_equal_to : ByteSize -> ByteSize -> Bool
let is_greater_than_or_equal_to (ByteSize that) (ByteSize self) = self >= that

/// Both sizes together.
sum : ByteSize -> ByteSize -> ByteSize
let sum (ByteSize that) (ByteSize self) = ByteSize (self + that)

/// `self - that`; `None` when `that` is larger.
subtract : ByteSize -> ByteSize -> Option ByteSize
let subtract (ByteSize that) (ByteSize self) =
  if self < that then None else Some (ByteSize (self - that))

/// `self` times a whole, non-negative, safe number; `None` otherwise.
times : Float -> ByteSize -> Option ByteSize
let times multiplier (ByteSize self) =
  if Float.is_safe_integer multiplier && multiplier >= 0 then
    Option.map (fun by -> ByteSize (self * by)) (BigInt.from_number multiplier)
  else
    None

/// `self` divided by a whole, positive, safe number, rounded down; `None`
/// otherwise.
divide : Float -> ByteSize -> Option ByteSize
let divide divisor (ByteSize self) =
  if Float.is_safe_integer divisor && divisor >= 1 then
    Option.map (fun by -> ByteSize (self / by)) (BigInt.from_number divisor)
  else
    None

/// The size as text in a unit: `"1.5 KiB"`.
format : FormatOptions -> ByteSize -> String
let format options (ByteSize value) =
  let wanted = Option.with_default 2 options.precision
  let precision = if wanted < 0 then 0 else if wanted > 20 then 20 else wanted
  let zeros = Option.with_default false options.trailingZeros
  match options.unit with
  | Some unit -> written value (place unit) precision zeros
  | None ->
    if value == 0n then
      "0 B"
    else
      // the binary units above the byte are the places 11 to 18, the decimal ones 1 to 10
      let (first, last, step) = if options.binary then (10, 18, 1024n) else (0, 10, 1000n)
      let at = reached value first last
      let by = if at == first then 1n else factor_at at
      let next = at < last && rounded value by (ten_to precision) >= step * ten_to precision
      let shown = if next then at + 1 else at
      written value (if shown == first then 0 else shown) precision zeros

/// Sums sizes from `zero`.
reducer_sum : Reducer.Reducer ByteSize
let reducer_sum = Reducer.make (fun a b -> sum b a) zero

/// The larger of two sizes.
combiner_max : Combiner.Combiner ByteSize
let combiner_max = Combiner.make (fun a b -> max b a)

/// The smaller of two sizes.
combiner_min : Combiner.Combiner ByteSize
let combiner_min = Combiner.make (fun a b -> min b a)

/// A size as JSON text such as `"1.5 KiB"` or `"10 MB"`; encodes as
/// `"1536 bytes"`. Other text is a `SchemaError`.
json : PureCodec Json ByteSize
foreign pure json from "flick:ByteSize" "flickJson"
  reviewed "effect@4.1.2 sha256:1f0a1d398ef2056f"

/// A size as a whole, non-negative JSON number of bytes.
json_number : PureCodec Json ByteSize
foreign pure json_number from "flick:ByteSize" "flickJsonNumber"
  reviewed "effect@4.1.2 sha256:1e94e27386d2573e"

/// A size as a JSON string of digits, for sizes past the safe numbers.
json_bigint : PureCodec Json ByteSize
foreign pure json_bigint from "flick:ByteSize" "flickJsonBigint"
  reviewed "effect@4.1.2 sha256:863e6b8c413aa5c9"
