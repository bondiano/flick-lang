/// Command-line applications: a `Command r e` is a pure description of
/// flags, positional arguments, subcommands and a handler that needs `r`
/// and fails with `e`. `cli "name" { … }` is sugar for the combinators
/// below; both build the same value. `Cli.run` parses the arguments and
/// only then runs the handler.
module Cli exposing (..)

import BigInt
import Cli.Prompt
import Config
import DateTime
import Redacted

/// A command ready to run.
type Command (r : ServiceRow) (e : ErrorRow)

/// A command being described, whose options so far form the record `o`.
type Spec (r : ServiceRow) (e : ErrorRow) o

/// How the values of one parameter make its field: `Multi a t` reads
/// values of `a` into a field of type `t`.
type Multi a t

/// Invalid input on the command line: the text shown for it.
type error CliError = CliError String
  deriving Eq, Show

/// Parsing a parameter's text into a value; the error is shown to the user.
/// `deriving Cli.Value` makes one for a choice among constructors without
/// fields, by their names in kebab case, and for a refined type.
@derive
class Value a =
  parse : String ->{} Result String a

/// The `Value` of a choice: the value whose name is the text.
choice : List (String, a) -> String ->{} Result String a
let choice choices text =
  match List.find (fun (name, _) -> name == text) choices with
  | Some (_, value) -> Ok value
  | None ->
    let names = String.join ", " (List.map (fun (name, _) -> name) choices)
    Err ("expected one of " ++ names ++ ", got " ++ text)

/// The `Value` of the refined type `name`: its base parsed, then checked by
/// `check`, the type's `parse`.
refined : Value b => String -> (b -> Result e a) -> String ->{} Result String a
let refined name check text =
  match parse text with
  | Ok base ->
    match check base with
    | Ok value -> Ok value
    | Err _ -> Err ("not a valid " ++ name ++ ": " ++ text)
  | Err why -> Err why

instance Value String =
  let parse text = Ok text

instance Value Bool =
  let parse text =
    match text with
    | "true" -> Ok true
    | "false" -> Ok false
    | _ -> Err ("not true or false: " ++ text)

instance Value Int =
  let parse text =
    match Int.parse text with
    | Some n -> Ok n
    | None -> Err ("not an Int: " ++ text)

instance Value Float =
  let parse text =
    match Float.parse text with
    | Some n -> if Float.is_nan n then Err ("not a number: " ++ text) else Ok n
    | None -> Err ("not a number: " ++ text)

instance Value BigInt =
  let parse text =
    match BigInt.parse text with
    | Some n -> Ok n
    | None -> Err ("not an integer: " ++ text)

instance Value (Redacted String) =
  let parse text = Ok (Redacted.make text)

/// An ISO 8601 date and time, `2026-10-23T10:00:00Z`.
instance Value DateTime.DateTime =
  let parse text =
    match DateTime.make text with
    | Ok date -> Ok date
    | Err _ -> Err ("not a date: " ++ text)

/// `key=value`, split at the first `=`; a `List` of them is a map of options.
instance Value (String, String) =
  let parse text =
    match String.index_of "=" text with
    | Some at -> Ok (String.slice 0 at text, String.slice (at + 1) (String.length text) text)
    | None -> Err ("not key=value: " ++ text)

/// A flag without a value: present is `true`, absent `false`.
switch : Multi Bool Bool
foreign pure switch from "flick:cli" "multiSwitch"

/// One value, required.
required : Multi a a
foreign pure required from "flick:cli" "multiRequired"

/// One value, `value` when absent.
default : a -> Multi a a
foreign pure default from "flick:cli" "multiDefault"

/// One value, or `None`.
optional : Multi a (Option a)
foreign pure optional from "flick:cli" "multiOptional"

/// Any number of values: a repeated flag, or the rest of the arguments.
many : Multi a (List a)
foreign pure many from "flick:cli" "multiMany"

/// At least one value.
some : Multi a (NonEmpty.NonEmpty a)
foreign pure some from "flick:cli" "multiSome"

/// At least `min` values.
at_least : Int -> Multi a (List a)
foreign pure at_least from "flick:cli" "multiAtLeast"

/// At most `max` values.
at_most : Int -> Multi a (List a)
foreign pure at_most from "flick:cli" "multiAtMost"

/// From `min` to `max` values.
between : Int -> Int -> Multi a (List a)
foreign pure between from "flick:cli" "multiBetween"
  arity 2

/// One value, read from `config` when absent; a config that does not read
/// is `CliError`.
from_config : Config.Config a -> Multi a a
foreign pure from_config from "flick:cli" "multiConfig"

/// One value, asked with `prompt` on the terminal of the process when
/// absent; without an answer the value is missing.
from_prompt : Cli.Prompt.Prompt a -> Multi a a
foreign pure from_prompt from "flick:cli" "multiPrompt"

/// The parameter is left out of help and completions.
hidden : Multi a t -> Multi a t
foreign pure hidden from "flick:cli" "multiHidden"

/// The name help shows for the parameter's value, `<file>` for `string`.
metavar : String -> Multi a t -> Multi a t
foreign pure metavar from "flick:cli" "multiMetavar"
  arity 2

/// A flag written without a value takes `text`: `--color` as `--color=auto`.
optional_value : String -> Multi a t -> Multi a t
foreign pure optional_value from "flick:cli" "multiOptionalValue"
  arity 2

/// The value names a file, which must exist when `must_exist`.
file : Bool -> Multi a t -> Multi a t
foreign pure file from "flick:cli" "multiFile"
  arity 2

/// The value names a directory, which must exist when `must_exist`.
directory : Bool -> Multi a t -> Multi a t
foreign pure directory from "flick:cli" "multiDirectory"
  arity 2

/// The value names a file or a directory, which must exist when `must_exist`.
path : Bool -> Multi a t -> Multi a t
foreign pure path from "flick:cli" "multiPath"
  arity 2

/// `Cli.Value` parses the text of the file the value names.
file_text : Multi a t -> Multi a t
foreign pure file_text from "flick:cli" "multiFileText"

/// The formats `file_parse` reads.
type FileFormat = Ini | Json | Toml | Yaml
  deriving Eq, Show

/// `Cli.Value` parses the JSON text of the data of the file the value
/// names, read in `format` (`None`: by its extension).
file_parse : Option FileFormat -> Multi a t -> Multi a t
foreign pure file_parse from "flick:cli" "multiFileParse"
  arity 2

/// A command named `name` with no options yet.
command : String -> Spec none none {}
foreign pure command from "flick:cli" "specCommand"

/// The help text of the command. Like every combinator here, it keeps the
/// captures `c` of what it is given, so a command whose handler holds a
/// resource of a scope cannot leave that scope.
description : String -> ((Spec r e o)^c -> (Spec r e o)^c)^c
foreign pure description from "flick:cli" "specDescription"
  arity 2
  retention call

/// The line that lists the command among its parent's subcommands.
short_description : String -> ((Spec r e o)^c -> (Spec r e o)^c)^c
foreign pure short_description from "flick:cli" "specShortDescription"
  arity 2
  retention call

/// Another name of the command as a subcommand.
alias : String -> ((Spec r e o)^c -> (Spec r e o)^c)^c
foreign pure alias from "flick:cli" "specAlias"
  arity 2
  retention call

/// The command is left out of its parent's help; it still runs.
unlisted : (Spec r e o)^c -> (Spec r e o)^c
foreign pure unlisted from "flick:cli" "specUnlisted"
  retention call

/// An example command line for help, with what it does (`""`: nothing).
example : String -> String -> ((Spec r e o)^c -> (Spec r e o)^c)^c
foreign pure example from "flick:cli" "specExample"
  arity 3
  retention call

/// What an action sees: the names of the command line's commands and the version.
type alias ActionContext = { commandPath : List String; version : String }

/// The switch `--<name>` of this command and its subcommands, with its help
/// text: given, it runs `act` instead of any handler, like `--version`.
action : String -> String -> (ActionContext ->{} Unit)^c -> (Spec r e o)^c -> (Spec r e o)^c
foreign pure action from "flick:cli" "specAction"
  arity 4
  retention call

/// The flag `--<label>` (underscores become dashes), with more names
/// (`"n"` is `-n`), its help text and how its values make field `l`.
flag :
  (Value a, Record.Lacks l o, Record.UnionDisjoint o (Record.Field l t) out) =>
  Record.Label l -> List String -> String -> Multi a t -> ((Spec r e o)^c -> (Spec r e out)^c)^c
foreign pure flag from "flick:cli" "specFlag"
  arity 5
  retention call

/// The next positional argument, with its help text.
arg :
  (Value a, Record.Lacks l o, Record.UnionDisjoint o (Record.Field l t) out) =>
  Record.Label l -> String -> Multi a t -> ((Spec r e o)^c -> (Spec r e out)^c)^c
foreign pure arg from "flick:cli" "specArg"
  arity 4
  retention call

/// A nested command, with its help text.
subcommand : (Command r2 e2)^c -> String -> ((Spec r e o)^c -> (Spec (r + r2) (e + e2) o)^c)^c
foreign pure subcommand from "flick:cli" "specSubcommand"
  arity 3
  retention call

/// The command, running `handler` with the parsed options.
handle : (o ->{r2; e2} Unit)^c -> (Spec r e o)^c -> (Command (r + r2) (e + e2))^c
foreign pure handle from "flick:cli" "specHandle"
  arity 2
  retention call

/// [`handle`] with the spec first, so the handler is checked against the
/// options the spec makes: what the block `cli "name" { … }` stands for.
handled : (Spec r e o)^c -> (o ->{r2; e2} Unit)^c -> (Command (r + r2) (e + e2))^c
let handled spec handler = handle handler spec

/// The command without a handler of its own: it needs subcommands, and run
/// without one it prints its help and fails with `CliError`.
group : (Spec r e o)^c -> (Command r e)^c
foreign pure group from "flick:cli" "specGroup"
  retention call

/// A flag in help: `type_` names its value, empty for a switch.
type alias FlagDoc = {
  name : String;
  aliases : List String;
  type_ : String;
  description : Option String;
  required : Bool;
}

/// A positional argument in help.
type alias ArgDoc = {
  name : String;
  type_ : String;
  description : Option String;
  required : Bool;
  variadic : Bool;
}

/// A subcommand in its parent's help.
type alias SubcommandDoc = {
  name : String;
  alias : Option String;
  shortDescription : Option String;
  description : String;
}

/// Subcommands listed together, under `group` if it has a name.
type alias SubcommandGroupDoc = {
  group : Option String;
  commands : NonEmpty.NonEmpty SubcommandDoc;
}

/// An example command line in help.
type alias ExampleDoc = { command : String; description : Option String }

/// What `--help` shows of a command, before a `Formatter` renders it.
type alias HelpDoc = {
  description : String;
  usage : String;
  flags : List FlagDoc;
  inheritedFlags : List FlagDoc;
  globalFlags : List FlagDoc;
  args : List ArgDoc;
  subcommands : List SubcommandGroupDoc;
  examples : List ExampleDoc;
}

/// How `--help` and `--version` (the command's name, then the version) print.
type alias Formatter = {
  formatHelpDoc : HelpDoc -> String;
  formatVersion : String -> String -> String;
}

/// The default formatter, with ANSI colors when `colors`.
default_formatter : Bool -> Formatter
foreign pure default_formatter from "flick:cli" "cliDefaultFormatter"

/// The columns `text` takes in a terminal, without its ANSI escapes.
display_width : String -> Int
foreign pure display_width from "flick:cli" "cliDisplayWidth"

/// The help document `--help` gives after the subcommand names `path`.
help_doc : List String -> (Command r e)^c ->{} HelpDoc
foreign effect help_doc from "flick:cli" "cliHelpDoc"
  arity 2
  retention call

/// The text of `help_doc`, without colors.
help : List String -> (Command r e)^c ->{} String
let help path command = (default_formatter false).formatHelpDoc (help_doc path command)

/// The shells `completions` writes scripts for.
type Shell = Bash | Zsh | Fish | PowerShell
  deriving Eq, Show

/// The script that completes the command line of `command` in `shell`.
completions : Shell -> (Command r e)^c ->{} String
foreign effect completions from "flick:cli" "cliCompletions"
  arity 2
  retention call

/// The flags every command line has unless `Settings` leave them out:
/// `--help`, `--version`, `--wizard` (asks for each value on the terminal),
/// `--completions <shell>`, `--log-level <level>` (the handler's minimum)
/// and `--trace`: the handler runs as a span named after its command, and
/// its spans, logs and metrics go over OTLP to `OTEL_EXPORTER_OTLP_ENDPOINT`
/// (`http://localhost:4318` by default) as service `OTEL_SERVICE_NAME`
/// (the command's name by default).
type BuiltIn = HelpFlag | VersionFlag | WizardFlag | CompletionsFlag | LogLevelFlag | TraceFlag
  deriving Eq, Show

/// Every built-in flag, in the order `BuiltIn` lists them.
builtins : List BuiltIn
let builtins = [HelpFlag, VersionFlag, WizardFlag, CompletionsFlag, LogLevelFlag, TraceFlag]

/// How `run_with` runs: the text of `--version`, the built-in flags, and
/// the formatter of help (`None`: the default one, colored on a terminal).
type alias Settings = { version : String; builtIns : List BuiltIn; formatter : Option Formatter }

/// Version `0.0.0`, every built-in flag, the default formatter.
settings : Settings
let settings = { version = "0.0.0"; builtIns = builtins; formatter = None }

/// Parses `args` and runs the handler of the command they name, in the
/// current fiber, after the whole line parsed. The built-in flags print to
/// stdout and run no handler; invalid input is `CliError` with the text
/// shown for it.
run_with : Settings -> (Command r e)^c -> List String ->{Async | r; CliError | e} Unit
foreign effect run_with from "flick:cli" "cliRunWith"
  arity 3
  retention call

/// `run_with` the `settings` with `version`.
run_version : String -> (Command r e)^c -> List String ->{Async | r; CliError | e} Unit
foreign effect run_version from "flick:cli" "cliRunVersion"
  arity 3
  retention call

/// `run_version "0.0.0"`.
run : (Command r e)^c -> List String ->{Async | r; CliError | e} Unit
let run command args = run_version "0.0.0" command args
