/// Checks of decoded values: filters as values, applied to a codec by
/// `apply`: `String.json |> Check.apply (Check.min_length 3)`. The strict
/// JSON Schema exporter states a check only when its keywords are exact,
/// and refuses it otherwise.
module Check exposing (..)

import BigDecimal
import HashSet

/// A check of values of type `a`.
type Check a

/// The codec, accepting only values that pass the check both ways.
apply : Check a -> PureCodec i a -> PureCodec i a
foreign pure apply from "flick:Schema" "flickCheck"

/// All of the checks, reported together.
all : NonEmpty.NonEmpty (Check a) -> Check a
foreign pure all from "flick:Schema" "makeFilterGroup"

/// A check by a pure predicate, failing with `message`; it has no JSON
/// Schema form.
predicate : (a -> Bool) -> String -> Check a
foreign pure predicate from "flick:Schema" "flickMakeFilter"

/// At least `n` UTF-16 code units.
min_length : Int -> Check String
foreign pure min_length from "flick:Schema" "isMinLength"

/// At most `n` UTF-16 code units.
max_length : Int -> Check String
foreign pure max_length from "flick:Schema" "isMaxLength"

/// Between `low` and `high` UTF-16 code units, inclusive.
length_between : Int -> Int -> Check String
foreign pure length_between from "flick:Schema" "isBetweenLength"

/// Not the empty string.
non_empty : Check String
foreign pure non_empty from "flick:Schema" "flickIsNonEmpty"

/// At least `n` code points.
min_code_points : Int -> Check String
foreign pure min_code_points from "flick:Schema" "isMinCodePoints"

/// At most `n` code points.
max_code_points : Int -> Check String
foreign pure max_code_points from "flick:Schema" "isMaxCodePoints"

/// Between `low` and `high` code points, inclusive.
code_points_between : Int -> Int -> Check String
foreign pure code_points_between from "flick:Schema" "isBetweenCodePoints"

/// Matches the regular expression `source` (no flags); a malformed one is
/// a defect.
pattern : String -> Check String
foreign pure pattern from "flick:Schema" "flickIsPattern"

/// Begins with the prefix.
starts_with : String -> Check String
foreign pure starts_with from "flick:Schema" "isStartingWith"

/// Ends with the suffix.
ends_with : String -> Check String
foreign pure ends_with from "flick:Schema" "isEndingWith"

/// Contains the text.
includes : String -> Check String
foreign pure includes from "flick:Schema" "isIncluding"

/// No leading or trailing whitespace.
trimmed : Check String
foreign pure trimmed from "flick:Schema" "flickIsTrimmed"

/// No uppercase letter.
lowercased : Check String
foreign pure lowercased from "flick:Schema" "flickIsLowercased"

/// No lowercase letter.
uppercased : Check String
foreign pure uppercased from "flick:Schema" "flickIsUppercased"

/// The first character is not lowercase.
capitalized : Check String
foreign pure capitalized from "flick:Schema" "flickIsCapitalized"

/// The first character is not uppercase.
uncapitalized : Check String
foreign pure uncapitalized from "flick:Schema" "flickIsUncapitalized"

/// A UUID, of the version given or of any.
uuid : Option Int -> Check String
foreign pure uuid from "flick:Schema" "isUUID"
  optional 0

/// A ULID: 26 characters of Crockford base32.
ulid : Check String
foreign pure ulid from "flick:Schema" "flickIsULID"

/// A GUID: a UUID of any version, or the nil or max one.
guid : Check String
foreign pure guid from "flick:Schema" "flickIsGUID"

/// Base64 text, padded.
base64 : Check String
foreign pure base64 from "flick:Schema" "flickIsBase64"

/// URL-safe base64 text, without padding.
base64url : Check String
foreign pure base64url from "flick:Schema" "flickIsBase64Url"

/// The text of a finite number.
string_finite : Check String
foreign pure string_finite from "flick:Schema" "flickIsStringFinite"

/// The text of an integer, as `BigInt` reads it.
string_bigint : Check String
foreign pure string_bigint from "flick:Schema" "flickIsStringBigInt"

/// Greater than the bound.
greater_than : Float -> Check Float
foreign pure greater_than from "flick:Schema" "isGreaterThan"

/// At least the bound.
greater_than_or_equal_to : Float -> Check Float
foreign pure greater_than_or_equal_to from "flick:Schema" "isGreaterThanOrEqualTo"

/// Less than the bound.
less_than : Float -> Check Float
foreign pure less_than from "flick:Schema" "isLessThan"

/// At most the bound.
less_than_or_equal_to : Float -> Check Float
foreign pure less_than_or_equal_to from "flick:Schema" "isLessThanOrEqualTo"

/// Between the bounds; each excluded when its flag is set.
between :
  {
    /// The lower bound.
    minimum : Float;
    /// The upper bound.
    maximum : Float;
    /// Whether the lower bound itself is excluded.
    exclusiveMinimum : Bool;
    /// Whether the upper bound itself is excluded.
    exclusiveMaximum : Bool;
  } ->
  Check Float
foreign pure between from "flick:Schema" "isBetween"

/// A multiple of the divisor.
multiple_of : Float -> Check Float
foreign pure multiple_of from "flick:Schema" "isMultipleOf"

/// A safe integer.
int : Check Float
foreign pure int from "flick:Schema" "flickIsInt"

/// An integer that fits in 32 signed bits.
int32 : Check Float
foreign pure int32 from "flick:Schema" "flickIsInt32"

/// An integer that fits in 32 unsigned bits.
uint32 : Check Float
foreign pure uint32 from "flick:Schema" "flickIsUint32"

/// Neither `NaN` nor an infinity.
finite : Check Float
foreign pure finite from "flick:Schema" "flickIsFinite"

/// Greater than the bound.
greater_than_bigint : BigInt -> Check BigInt
foreign pure greater_than_bigint from "flick:Schema" "isGreaterThanBigInt"

/// At least the bound.
greater_than_or_equal_to_bigint : BigInt -> Check BigInt
foreign pure greater_than_or_equal_to_bigint from "flick:Schema" "isGreaterThanOrEqualToBigInt"

/// Less than the bound.
less_than_bigint : BigInt -> Check BigInt
foreign pure less_than_bigint from "flick:Schema" "isLessThanBigInt"

/// At most the bound.
less_than_or_equal_to_bigint : BigInt -> Check BigInt
foreign pure less_than_or_equal_to_bigint from "flick:Schema" "isLessThanOrEqualToBigInt"

/// Between the bounds; each excluded when its flag is set.
between_bigint :
  {
    /// The lower bound.
    minimum : BigInt;
    /// The upper bound.
    maximum : BigInt;
    /// Whether the lower bound itself is excluded.
    exclusiveMinimum : Bool;
    /// Whether the upper bound itself is excluded.
    exclusiveMaximum : Bool;
  } ->
  Check BigInt
foreign pure between_bigint from "flick:Schema" "isBetweenBigInt"

/// Greater than the bound.
greater_than_decimal : BigDecimal.BigDecimal -> Check BigDecimal.BigDecimal
foreign pure greater_than_decimal from "flick:Schema" "isGreaterThanBigDecimal"

/// At least the bound.
greater_than_or_equal_to_decimal : BigDecimal.BigDecimal -> Check BigDecimal.BigDecimal
foreign pure greater_than_or_equal_to_decimal from "flick:Schema" "isGreaterThanOrEqualToBigDecimal"

/// Less than the bound.
less_than_decimal : BigDecimal.BigDecimal -> Check BigDecimal.BigDecimal
foreign pure less_than_decimal from "flick:Schema" "isLessThanBigDecimal"

/// At most the bound.
less_than_or_equal_to_decimal : BigDecimal.BigDecimal -> Check BigDecimal.BigDecimal
foreign pure less_than_or_equal_to_decimal from "flick:Schema" "isLessThanOrEqualToBigDecimal"

/// Between the bounds; each excluded when its flag is set.
between_decimal :
  {
    /// The lower bound.
    minimum : BigDecimal.BigDecimal;
    /// The upper bound.
    maximum : BigDecimal.BigDecimal;
    /// Whether the lower bound itself is excluded.
    exclusiveMinimum : Bool;
    /// Whether the upper bound itself is excluded.
    exclusiveMaximum : Bool;
  } ->
  Check BigDecimal.BigDecimal
foreign pure between_decimal from "flick:Schema" "isBetweenBigDecimal"

/// Greater than the bound by the type's `Ord`.
greater_than_by : Ord a => a -> Check a
foreign pure greater_than_by from "flick:Schema" "flickMakeIsGreaterThan"

/// At least the bound by the type's `Ord`.
greater_than_or_equal_to_by : Ord a => a -> Check a
foreign pure greater_than_or_equal_to_by from "flick:Schema" "flickMakeIsGreaterThanOrEqualTo"

/// Less than the bound by the type's `Ord`.
less_than_by : Ord a => a -> Check a
foreign pure less_than_by from "flick:Schema" "flickMakeIsLessThan"

/// At most the bound by the type's `Ord`.
less_than_or_equal_to_by : Ord a => a -> Check a
foreign pure less_than_or_equal_to_by from "flick:Schema" "flickMakeIsLessThanOrEqualTo"

/// Between the bounds, inclusive, by the type's `Ord`.
between_by : Ord a => a -> a -> Check a
foreign pure between_by from "flick:Schema" "flickMakeIsBetween"

/// `remainder value divisor` is `zero` (compared with JS `===`, so for
/// primitive types).
multiple_of_by : (a -> a -> a) -> a -> a -> Check a
foreign pure multiple_of_by from "flick:Schema" "flickMakeIsMultipleOf"

/// At least `n` elements.
min_items : Int -> Check (List a)
foreign pure min_items from "flick:Schema" "isMinLength"

/// At most `n` elements.
max_items : Int -> Check (List a)
foreign pure max_items from "flick:Schema" "isMaxLength"

/// No two elements equal by structural equality.
unique : Check (List a)
foreign pure unique from "flick:Schema" "flickIsUnique"

/// No two pairs with equal keys.
unique_keys : Check (List (k, v))
foreign pure unique_keys from "flick:Schema" "flickIsUniqueKey"

/// A set of at least `n` elements.
min_size : Int -> Check (HashSet.HashSet w a)
foreign pure min_size from "flick:Schema" "flickIsMinSize"

/// A set of at most `n` elements.
max_size : Int -> Check (HashSet.HashSet w a)
foreign pure max_size from "flick:Schema" "flickIsMaxSize"

/// A set of `low` to `high` elements, inclusive.
size_between : Int -> Int -> Check (HashSet.HashSet w a)
foreign pure size_between from "flick:Schema" "flickIsBetweenSize"

/// At least `n` keys in the object of a `Codec.entries` codec.
min_properties : Int -> PureCodec Json (List (String, v)) -> PureCodec Json (List (String, v))
foreign pure min_properties from "flick:Schema" "flickIsMinProperties"

/// At most `n` keys in the object of a `Codec.entries` codec.
max_properties : Int -> PureCodec Json (List (String, v)) -> PureCodec Json (List (String, v))
foreign pure max_properties from "flick:Schema" "flickIsMaxProperties"

/// `low` to `high` keys in the object of a `Codec.entries` codec.
properties_between :
  Int -> Int -> PureCodec Json (List (String, v)) -> PureCodec Json (List (String, v))
foreign pure properties_between from "flick:Schema" "flickIsBetweenProperties"

/// Every key of the object of a `Codec.entries` codec decodes with `key`.
property_names :
  PureCodec Json String -> PureCodec Json (List (String, v)) -> PureCodec Json (List (String, v))
foreign pure property_names from "flick:Schema" "flickIsPropertyNames"
