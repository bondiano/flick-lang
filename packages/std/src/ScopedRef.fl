/// A reference to a resource that `set` replaces. Its value is used only
/// inside `use`, which holds it: the previous resource is released once no
/// `use` holds it, and the last one when the `scope` owning the reference's
/// region closes.
module ScopedRef exposing (..)

/// A reference of region `s` to a resource of `a`.
type ScopedRef (s : Region) a

/// A reference owned by the innermost `scope` (or the one of region `s`),
/// holding the resource `acquire` gives. `acquire` acquires into a region
/// `t` of its own, which ends when the resource is released: a value of a
/// type that names its region, such as `File t`, cannot be kept here.
from_acquire : (forall t. Eff {Scope t | r} e a^{t})^c ->{Scope s | r; e} ScopedRef s a
foreign effect from_acquire from "@flick-lang/effect-ts/effect/ScopedRef" "flickFromAcquire"
  retention call

/// A reference holding `f ()`, which needs no release.
make : (Unit -> a)^c ->{Scope s;} ScopedRef s a
foreign effect make from "@flick-lang/effect-ts/effect/ScopedRef" "flickMake"
  retention call

/// Runs `f` with the current resource, which stays acquired until `f`
/// ends; what `f` gives cannot hold the resource.
use : ScopedRef s a -> (forall t. a^{t} ->{r; e} b)^c ->{r; e} b
foreign effect use from "@flick-lang/effect-ts/effect/ScopedRef" "flickUse"
  retention call

/// Acquires a new resource with `acquire`; the previous one is released
/// once no `use` holds it. If `acquire` fails, the previous one stays.
set : (forall t. Eff {Scope t | r} e a^{t})^c -> ScopedRef s a ->{r; e} Unit
foreign effect set from "@flick-lang/effect-ts/effect/ScopedRef" "flickSet"
  arity 1
  retention call
