/// A description of configuration to read, by name, from the current
/// `ConfigProvider` (the environment by default). `get` reads it; a missing
/// or malformed value is a `ConfigError`.
module Config exposing (..)

import ConfigProvider
import Duration
import LogLevel
import Server

/// Configuration that reads to an `a`.
type Config a

/// A value that is missing or does not parse, with the message of the
/// failure.
type error ConfigError = ConfigError String
  deriving Eq, Show

/// How `array` splits a single value: by `separator`, `,` by default.
type alias ArrayOptions = { separator : Option String }

/// How `record` splits a single value into pairs.
type alias RecordOptions = { separator : Option String; keyValueSeparator : Option String }

/// Reads the configuration from the current provider.
get : Config a ->{; ConfigError} a
foreign effect get from "flick:Config" "flickGet"

/// Reads the configuration from `provider`.
parse : ConfigProvider.ConfigProvider -> Config a ->{; ConfigError} a
foreign effect parse from "flick:Config" "flickParse"
  arity 2

map : (a -> b) -> Config a -> Config b
foreign pure map from "flick:Config" "map"
  arity 1

/// The configuration `f` picks by the value read.
flat_map : (a -> Config b) -> Config a -> Config b
foreign pure flat_map from "flick:Config" "flatMap"
  arity 1

/// The value checked or converted by `f`, which may fail with a `ConfigError`.
map_effect : (a ->{; ConfigError} b) -> Config a -> Config b
foreign pure map_effect from "flick:Config" "mapEffect"
  arity 1

/// When reading fails, the configuration `f` picks by the error.
or_else : (ConfigError -> Config a) -> Config a -> Config a
foreign pure or_else from "flick:Config" "flickOrElse"
  arity 1

/// The values of all of them, in order.
all : List (Config a) -> Config (List a)
foreign pure all from "flick:Config" "all"

/// The default when the value is missing; a malformed value still fails.
with_default : a -> Config a -> Config a
foreign pure with_default from "flick:Config" "withDefault"
  arity 1

/// `None` when the value is missing.
option : Config a -> Config (Option a)
foreign pure option from "flick:Config" "option"

/// The value at the path decoded by the schema; a record schema reads a
/// record of the provider.
schema : Schema a -> String -> Config a
foreign pure schema from "flick:Config" "schema"
  arity 2

/// Fails with the message.
fail : String -> Config a
foreign pure fail from "flick:Config" "flickFail"

/// Reads to the value, whatever the provider has.
succeed : a -> Config a
foreign pure succeed from "flick:Config" "succeed"

/// The value at the name, as text.
string : String -> Config String
foreign pure string from "flick:Config" "String"

/// `string`, refusing an empty one.
non_empty_string : String -> Config String
foreign pure non_empty_string from "flick:Config" "NonEmptyString"

/// A number, `NaN` and the infinities included.
number : String -> Config Float
foreign pure number from "flick:Config" "Number"

/// A finite number.
finite : String -> Config Float
foreign pure finite from "flick:Config" "Finite"

/// An integer.
int : String -> Config Int
foreign pure int from "flick:Config" "flickInt"

/// `true`, `false`, `yes`, `no`, `on`, `off`, `1` or `0`.
boolean : String -> Config Bool
foreign pure boolean from "flick:Config" "Boolean"

/// An integer port from 1 to 65535.
port : String -> Config Float
foreign pure port from "flick:Config" "Port"

/// A secret: text kept out of logs and output. Only a server reads one, so
/// it needs `Server.Server`: a client entry that reaches it is
/// `FLICK-E009`, and neither the secret's name nor its value is in a
/// browser's bundle.
redacted : String ->{Server.Server} Config (Redacted String)
foreign effect redacted from "flick:Config" "flickRedacted"

/// A duration written as a number and a unit: `10 seconds`, `5 millis`.
duration : String -> Config Duration.Duration
foreign pure duration from "flick:Config" "Duration"

/// A size in bytes, as `512` or `10 MiB`.
byte_size : String -> Config BigInt
foreign pure byte_size from "flick:Config" "ByteSize"

/// A log level by its name, as `Info`.
log_level : String -> Config LogLevel.LogLevel
foreign pure log_level from "flick:Config" "LogLevel"

/// An absolute URL, normalized.
url : String -> Config String
foreign pure url from "flick:Config" "flickUrl"

/// A date, as milliseconds since the epoch.
date : String -> Config Float
foreign pure date from "flick:Config" "flickDate"

/// `literal "prod" "MODE"`: exactly that text.
literal : String -> String -> Config String
foreign pure literal from "flick:Config" "Literal"
  arity 2

/// One of the texts.
literals : List String -> String -> Config String
foreign pure literals from "flick:Config" "Literals"
  arity 2

/// An array of the provider, or a single value split by the separator,
/// each element decoded by the schema.
array : ArrayOptions -> Schema a -> String -> Config (List a)
foreign pure array from "flick:Config" "flickArray"
  arity 3

/// A record of the provider, or a single value of `key=value` pairs, as
/// pairs of a key and its value decoded by the schema.
record : RecordOptions -> Schema v -> String -> Config (List (String, v))
foreign pure record from "flick:Config" "flickRecord"
  arity 3

/// The configuration read under the name: `nested "DB" (string "HOST")`
/// reads `DB_HOST` from the environment.
nested : String -> Config a -> Config a
foreign pure nested from "flick:Config" "nested"
  arity 1
