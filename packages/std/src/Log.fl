/// Logging as a service; `console` writes to the standard streams.
module Log exposing (..)

import Layer

service Log =
  write : String -> String ->{} Unit

info : String ->{Log} Unit
let info message = Log.write "info" message

warn : String ->{Log} Unit
let warn message = Log.write "warn" message

error : String ->{Log} Unit
let error message = Log.write "error" message

debug : String ->{Log} Unit
let debug message = Log.write "debug" message

write_console : String -> String ->{} Unit
foreign write_console from "@flick-lang/effect-ts" "logConsole"

/// Info and debug to stdout, warnings and errors to stderr, with the level.
console : Layer none none {Log}
let console = Layer.succeed Log { write = write_console }
