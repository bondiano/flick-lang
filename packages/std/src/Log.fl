/// Logging as a service; `console` writes to the standard streams.
module Log exposing (..)

import Context
import Host
import Layer

service Log =
  write : String -> String ->{} Unit

info : String ->{Log} Unit
let info message = Log.write "info" message

warn : String ->{Log} Unit
let warn message = Log.write "warn" message

error : String ->{Log} Unit
let error message = Log.write "error" message

debug : String ->{Log} Unit
let debug message = Log.write "debug" message

write_console : String -> String ->{} Unit
foreign write_console from "flick:rt" "logConsole"

/// Info and debug to stdout, warnings and errors to stderr, with the level.
console : Layer none none {Log}
let console = Layer.succeed Log { write = write_console }

/// Adapts a `Host.Console` layer into a `Log` layer: info and debug to stdout,
/// warnings and errors to stderr, prefixed with the level.
from_console : Layer none none {Host.Console} -> Layer none none {Log}
let from_console layer =
  Layer.flat_map
    (fun ctx ->
      let c = Context.get Host.Console ctx
      Layer.succeed Log {
        write = fun level message ->
          let text = level ++ ": " ++ message
          if level == "warn" || level == "error" then c.stderr_line text else c.stdout_line text;
      }
    )
    layer
