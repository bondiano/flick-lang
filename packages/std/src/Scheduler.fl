/// How fibers take turns. A task runs with the scheduler and the yield
/// policy its caller sets; Flick code never hands raw JS tasks to a
/// dispatcher.
module Scheduler exposing (..)

/// A scheduler of fibers.
type Scheduler

/// A fresh scheduler of the default kind: microtasks, then `setImmediate`,
/// yielding by priority.
make_mixed : Unit ->{} Scheduler
foreign make_mixed from "flick:Scheduler" "flickMakeMixed"
  arity 0

/// The scheduler of the current fiber.
current : Unit ->{} Scheduler
foreign effect current from "flick:Scheduler" "flickCurrent"
  arity 0

/// Runs `task` with the scheduler.
with_scheduler : Scheduler -> (Eff r e a)^c ->{r; e} a
foreign effect with_scheduler from "flick:Scheduler" "flickWithScheduler"
  arity 1
  retention call

/// The number of steps a fiber of the current task runs before it yields.
max_ops_before_yield : Unit ->{} Int
foreign effect max_ops_before_yield from "flick:Scheduler" "flickMaxOpsBeforeYield"
  arity 0

/// Runs `task` with fibers yielding after that many steps.
with_max_ops_before_yield : Int -> (Eff r e a)^c ->{r; e} a
foreign effect with_max_ops_before_yield from "flick:Scheduler" "flickWithMaxOpsBeforeYield"
  arity 1
  retention call

/// Runs `task` with fibers that, if `prevent`, never yield to the scheduler.
with_prevent_scheduler_yield : Bool -> (Eff r e a)^c ->{r; e} a
foreign effect with_prevent_scheduler_yield from "flick:Scheduler" "flickWithPreventSchedulerYield"
  arity 1
  retention call
