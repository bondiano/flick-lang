/// Hashing beyond the class `Hash`: mixing hashes, for writing `hash` of an
/// instance from the hashes of its parts.
module Hash exposing (..)

/// Mixes the hash `b` into `self`: `hash x |> Hash.combine (hash y)`.
combine : Int -> Int -> Int
foreign pure combine from "flick:Hash" "combine"
  arity 1

/// Spreads the bits of a hash into a 32-bit integer.
optimize : Int -> Int
foreign pure optimize from "flick:Hash" "optimize"
