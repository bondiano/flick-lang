/// A hub that hands each published element to every subscriber, inside
/// `Tx.atomically` transactions. A subscription belongs to the `scope` that
/// owns its region and ends when it closes.
module TxPubSub exposing (..)

import Tx

/// A transactional hub of `a`.
type TxPubSub a

/// The queue of a subscriber of region `s`: what was published since it
/// subscribed, in order.
type Subscription (s : Region) a

/// A new hub that holds at most `capacity` elements a subscriber has not
/// taken; a publish to a full one waits.
bounded : Int ->{} TxPubSub a
foreign effect bounded from "flick:TxPubSub" "bounded"

/// A new bounded hub that drops what a full one is given.
dropping : Int ->{} TxPubSub a
foreign effect dropping from "flick:TxPubSub" "dropping"

/// A new bounded hub that drops the oldest element when it is full.
sliding : Int ->{} TxPubSub a
foreign effect sliding from "flick:TxPubSub" "sliding"

/// A new hub without a bound.
unbounded : Unit ->{} TxPubSub a
foreign effect unbounded from "flick:TxPubSub" "unbounded"
  arity 0

/// The bound it was made with.
capacity : TxPubSub a -> Int
foreign pure capacity from "flick:TxPubSub" "capacity"

/// The most elements a subscriber has not taken yet.
size : TxPubSub a ->{Tx.Transaction} Int
foreign effect size from "flick:TxPubSub" "size"

/// Whether every subscriber has taken everything.
is_empty : TxPubSub a ->{Tx.Transaction} Bool
foreign effect is_empty from "flick:TxPubSub" "isEmpty"

/// Whether a subscriber has an element to take.
is_non_empty : TxPubSub a ->{Tx.Transaction} Bool
foreign effect is_non_empty from "flick:TxPubSub" "isNonEmpty"

/// Whether a subscriber holds as many elements as the capacity.
is_full : TxPubSub a ->{Tx.Transaction} Bool
foreign effect is_full from "flick:TxPubSub" "isFull"

/// Whether it was shut down.
is_shutdown : TxPubSub a ->{Tx.Transaction} Bool
foreign effect is_shutdown from "flick:TxPubSub" "isShutdown"

/// Hands the element to every subscriber; false when it was dropped or
/// the hub is shut down.
publish : a -> TxPubSub a ->{Async, Tx.Transaction} Bool
foreign effect publish from "flick:TxPubSub" "publish"
  arity 1

/// Publishes the elements in order; false when one was dropped.
publish_all : List a -> TxPubSub a ->{Async, Tx.Transaction} Bool
foreign effect publish_all from "flick:TxPubSub" "publishAll"
  arity 1

/// Subscribes until the scope of region `s` closes.
subscribe : TxPubSub a ->{Scope s} Subscription s a
foreign effect subscribe from "flick:TxPubSub" "subscribe"

/// Shuts it down: later publishes are refused and takes from its
/// subscriptions interrupt the fiber.
shutdown : TxPubSub a ->{Tx.Transaction} Unit
foreign effect shutdown from "flick:TxPubSub" "shutdown"

/// Retries the transaction until the hub is shut down.
await_shutdown : TxPubSub a ->{Async, Tx.Transaction} Unit
foreign effect await_shutdown from "flick:TxPubSub" "awaitShutdown"

/// Removes the oldest element of the subscription, waiting for one.
take : Subscription s a ->{Tx.Transaction} a
foreign effect take from "flick:TxQueue" "take"
  retention call

/// Removes the oldest element of the subscription, if there is one.
poll : Subscription s a ->{Tx.Transaction} Option a
foreign effect poll from "flick:TxQueue" "poll"
  retention call

/// Removes every element of the subscription, waiting for at least one.
take_all : Subscription s a ->{Tx.Transaction} NonEmpty.NonEmpty a
foreign effect take_all from "flick:TxQueue" "takeAll"
  retention call

/// The number of elements waiting in the subscription.
pending : Subscription s a ->{Tx.Transaction} Int
foreign effect pending from "flick:TxQueue" "size"
  retention call
