/// Cryptographic randomness and digests as a service, over Effect's
/// `Crypto`; `Crypto.system` provides it from the platform's Web Crypto.
/// Bytes are lists of numbers from 0 to 255.
module Crypto exposing (
  CryptoError(..),
  DigestAlgorithm(..),
  Crypto,
  random_bytes,
  digest,
  hmac,
  pbkdf2,
  hash_password,
  verify_password,
  random,
  random_boolean,
  random_int,
  random_between,
  random_int_between,
  random_shuffle,
  random_uuid_v4,
  random_uuid_v7,
  random_ulid,
  system,
)

/// What the platform refused: a bad size or a failed digest.
type error CryptoError = CryptoError String
  deriving Eq, Show

/// The hash functions of `digest`.
type DigestAlgorithm = Sha1 | Sha256 | Sha384 | Sha512

/// Cryptographically strong randomness and digests.
service Crypto =
  random_bytes : Int ->{; CryptoError} List Int
  digest : DigestAlgorithm -> List Int ->{Async; CryptoError} List Int
  random : Unit ->{} Float
  random_boolean : Unit ->{} Bool
  random_int : Unit ->{} Int
  random_between : Float -> Float ->{} Float
  random_int_between : Int -> Int ->{} Int
  random_shuffle : forall a. List a ->{} List a
  random_uuid_v4 : Unit ->{; CryptoError} String
  random_uuid_v7 : Unit ->{; CryptoError} String
  random_ulid : Unit ->{; CryptoError} String

/// `size` random bytes; the size must not be negative.
random_bytes : Int ->{Crypto; CryptoError} List Int
let random_bytes size = Crypto.random_bytes size

/// The digest of the bytes by the algorithm.
digest : DigestAlgorithm -> List Int ->{Async, Crypto; CryptoError} List Int
let digest algorithm data = Crypto.digest algorithm data

/// The HMAC of the message under the key (RFC 2104), over `digest`.
hmac : DigestAlgorithm -> List Int -> List Int ->{Async, Crypto; CryptoError} List Int
let hmac algorithm key message =
  let block =
    match algorithm with
    | Sha384 -> 128
    | Sha512 -> 128
    | _ -> 64
  let short = if List.length key > block then Crypto.digest algorithm key else key
  let padded = short ++ List.repeat (block - List.length short) 0
  let inner = Crypto.digest algorithm (List.map (Int.bit_xor 54) padded ++ message)
  Crypto.digest algorithm (List.map (Int.bit_xor 92) padded ++ inner)

/// PBKDF2 (RFC 8018) with HMAC over the digest: `length` bytes derived from
/// the salt and the password in `iterations` rounds. Both counts must be
/// positive.
pbkdf2 : DigestAlgorithm -> Int -> Int -> List Int -> List Int ->{Async; CryptoError} List Int
foreign effect pbkdf2 from "@flick-lang/runtime/effect/Crypto" "flickPbkdf2"

/// A hash of the password to store: PBKDF2-HMAC-SHA256 with 600000 rounds
/// and a random 16-byte salt, written
/// `$pbkdf2-sha256$i=600000$<salt>$<hash>` in URL-safe base64.
hash_password : String ->{Async, Crypto; CryptoError} String
let hash_password password =
  let salt = Crypto.random_bytes 16
  let hash = pbkdf2 Sha256 600000 32 salt (Bytes.from_string password)
  String.join "$" [
    "",
    "pbkdf2-sha256",
    "i=600000",
    Bytes.to_base64url salt,
    Bytes.to_base64url hash,
  ]

/// Whether the password is the one `hash_password` hashed into `stored`, in
/// its rounds, compared in constant time. A stored text of another form is a
/// `CryptoError`.
verify_password : String -> String ->{Async; CryptoError} Bool
let verify_password password stored =
  let parts = String.split "$" stored
  let rounds = Option.with_default "" (List.get 2 parts)
  let count =
    if String.starts_with "i=" rounds then
      Int.parse (String.slice 2 (String.length rounds) rounds)
    else
      None
  let salt = Option.bind Bytes.from_base64url (List.get 3 parts)
  let hash = Option.bind Bytes.from_base64url (List.get 4 parts)
  let shape =
    List.length parts == 5
      && List.get 0 parts == Some ""
      && List.get 1 parts == Some "pbkdf2-sha256"
  match (count, salt, hash) with
  | (Some n, Some s, Some h) ->
    if shape && n > 0 && not (List.is_empty h) then
      Bytes.equal (pbkdf2 Sha256 n (List.length h) s (Bytes.from_string password)) h
    else
      malformed_hash ()
  | _ -> malformed_hash ()

malformed_hash : Unit ->{; CryptoError} Bool
let malformed_hash () =
  from_result (Err (CryptoError "not a password hash written by hash_password"))

/// A random number from 0 up to 1.
random : Unit ->{Crypto;} Float
let random () = Crypto.random ()

/// A random `Bool`.
random_boolean : Unit ->{Crypto;} Bool
let random_boolean () = Crypto.random_boolean ()

/// A random `Int`, over its whole 32-bit range.
random_int : Unit ->{Crypto;} Int
let random_int () = Crypto.random_int ()

/// A random number from `min` up to `max`.
random_between : Float -> Float ->{Crypto;} Float
let random_between min max = Crypto.random_between min max

/// A random integer from `min` to `max`, both included.
random_int_between : Int -> Int ->{Crypto;} Int
let random_int_between min max = Crypto.random_int_between min max

/// The list in a random order.
random_shuffle : List a ->{Crypto;} List a
let random_shuffle xs = Crypto.random_shuffle xs

/// A random version 4 UUID, in lower-case hex with dashes.
random_uuid_v4 : Unit ->{Crypto; CryptoError} String
let random_uuid_v4 () = Crypto.random_uuid_v4 ()

/// A version 7 UUID: the current time, then random bits.
random_uuid_v7 : Unit ->{Crypto; CryptoError} String
let random_uuid_v7 () = Crypto.random_uuid_v7 ()

/// A ULID: the current time, then random bits, in Crockford's base 32.
random_ulid : Unit ->{Crypto; CryptoError} String
let random_ulid () = Crypto.random_ulid ()

system_random_bytes : Int ->{; CryptoError} List Int
foreign effect system_random_bytes from "@flick-lang/runtime/effect/Crypto" "flickRandomBytes"

system_digest : DigestAlgorithm -> List Int ->{Async; CryptoError} List Int
foreign effect system_digest from "@flick-lang/runtime/effect/Crypto" "flickDigest"

system_random : Unit ->{} Float
foreign effect system_random from "@flick-lang/runtime/effect/Crypto" "flickRandom"
  arity 0

system_random_boolean : Unit ->{} Bool
foreign effect system_random_boolean from "@flick-lang/runtime/effect/Crypto" "flickRandomBoolean"
  arity 0

system_random_int : Unit ->{} Int
foreign effect system_random_int from "@flick-lang/runtime/effect/Crypto" "flickRandomInt"
  arity 0

system_random_between : Float -> Float ->{} Float
foreign effect system_random_between from "@flick-lang/runtime/effect/Crypto" "flickRandomBetween"

system_random_int_between : Int -> Int ->{} Int
foreign effect system_random_int_between from "@flick-lang/runtime/effect/Crypto" "flickRandomIntBetween"

system_random_shuffle : List a ->{} List a
foreign effect system_random_shuffle from "@flick-lang/runtime/effect/Crypto" "flickRandomShuffle"

system_random_uuid_v4 : Unit ->{; CryptoError} String
foreign effect system_random_uuid_v4 from "@flick-lang/runtime/effect/Crypto" "flickRandomUuidV4"
  arity 0

system_random_uuid_v7 : Unit ->{; CryptoError} String
foreign effect system_random_uuid_v7 from "@flick-lang/runtime/effect/Crypto" "flickRandomUuidV7"
  arity 0

system_random_ulid : Unit ->{; CryptoError} String
foreign effect system_random_ulid from "@flick-lang/runtime/effect/Crypto" "flickRandomUlid"
  arity 0

/// Effect's `Crypto` over the platform's Web Crypto (`globalThis.crypto`).
system : Layer none none {Crypto}
let system =
  Layer.succeed Crypto {
    random_bytes = system_random_bytes;
    digest = system_digest;
    random = system_random;
    random_boolean = system_random_boolean;
    random_int = system_random_int;
    random_between = system_random_between;
    random_int_between = system_random_int_between;
    random_shuffle = system_random_shuffle;
    random_uuid_v4 = system_random_uuid_v4;
    random_uuid_v7 = system_random_uuid_v7;
    random_ulid = system_random_ulid;
  }
