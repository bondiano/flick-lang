/// Operations and explicit conversions on `UInt32`, the 32-bit unsigned
/// integers (`0..=4294967295`).
module UInt32 exposing (..)

import BigInt
import Int32

min_value : UInt32
let min_value = 0u32

max_value : UInt32
let max_value = 4294967295u32

max_bigint : BigInt
let max_bigint = 4294967295n

to_string : UInt32 -> String
let to_string n = display n

parse : String -> Option UInt32
let parse s = Option.bind from_bigint (BigInt.parse s)

to_float : UInt32 -> Float
foreign pure to_float from "flick:rt" "toFloat64"

to_float32 : UInt32 -> Float32
foreign pure to_float32 from "flick:rt" "toFloat32"

to_bigint : UInt32 -> BigInt
foreign pure to_bigint from "flick:rt" "toBigInt"

from_uint8 : UInt8 -> UInt32
let from_uint8 n = into n

from_uint16 : UInt16 -> UInt32
let from_uint16 n = into n

wrapping_from_int8 : Int8 -> UInt32
foreign pure wrapping_from_int8 from "flick:rt" "toUInt32"

wrapping_from_int16 : Int16 -> UInt32
foreign pure wrapping_from_int16 from "flick:rt" "toUInt32"

wrapping_from_int : Int -> UInt32
foreign pure wrapping_from_int from "flick:rt" "toUInt32"

wrapping_from_int32 : Int32 -> UInt32
let wrapping_from_int32 n = wrapping_from_int n

wrapping_from_int64 : Int64 -> UInt32
foreign pure wrapping_from_int64 from "flick:rt" "toUInt32"

wrapping_from_uint64 : UInt64 -> UInt32
foreign pure wrapping_from_uint64 from "flick:rt" "toUInt32"

wrapping_from_bigint : BigInt -> UInt32
foreign pure wrapping_from_bigint from "flick:rt" "toUInt32"

from_bigint : BigInt -> Option UInt32
let from_bigint n = if n < 0n || n > max_bigint then None else Some (wrapping_from_bigint n)

from_int8 : Int8 -> Option UInt32
let from_int8 n = if n < 0i8 then None else Some (wrapping_from_int8 n)

from_int16 : Int16 -> Option UInt32
let from_int16 n = if n < 0i16 then None else Some (wrapping_from_int16 n)

from_int : Int -> Option UInt32
let from_int n = if n < 0 then None else Some (wrapping_from_int n)

from_int32 : Int32 -> Option UInt32
let from_int32 n = from_int n

from_int64 : Int64 -> Option UInt32
let from_int64 n = if n < 0i64 || n > 4294967295i64 then None else Some (wrapping_from_int64 n)

from_uint64 : UInt64 -> Option UInt32
let from_uint64 n = if n > 4294967295u64 then None else Some (wrapping_from_uint64 n)

from_float : Float -> Option UInt32
let from_float x = Option.bind from_bigint (BigInt.from_number x)

from_float32 : Float32 -> Option UInt32
let from_float32 x = from_float (into x)

saturating_from_bigint : BigInt -> UInt32
let saturating_from_bigint n =
  if n < 0n then min_value else if n > max_bigint then max_value else wrapping_from_bigint n

saturating_from_int8 : Int8 -> UInt32
let saturating_from_int8 n = if n < 0i8 then min_value else wrapping_from_int8 n

saturating_from_int16 : Int16 -> UInt32
let saturating_from_int16 n = if n < 0i16 then min_value else wrapping_from_int16 n

saturating_from_int : Int -> UInt32
let saturating_from_int n = if n < 0 then min_value else wrapping_from_int n

saturating_from_int32 : Int32 -> UInt32
let saturating_from_int32 n = saturating_from_int n

saturating_from_int64 : Int64 -> UInt32
let saturating_from_int64 n =
  if n < 0i64 then min_value else if n > 4294967295i64 then max_value else wrapping_from_int64 n

saturating_from_uint64 : UInt64 -> UInt32
let saturating_from_uint64 n = if n > 4294967295u64 then max_value else wrapping_from_uint64 n

saturating_from_float : Float -> UInt32
let saturating_from_float x =
  if Float.is_nan x || x <= 0.0 then
    0u32
  else if x >= 4294967295.0 then
    max_value
  else
    match BigInt.from_number (Float.trunc x) with
    | Some n -> saturating_from_bigint n
    | None -> 0u32

saturating_from_float32 : Float32 -> UInt32
let saturating_from_float32 x = saturating_from_float (into x)

truncate : Float -> UInt32
let truncate x =
  if not (Float.is_finite x) then
    0u32
  else
    match BigInt.from_number (Float.trunc x) with
    | Some n -> wrapping_from_bigint n
    | None -> 0u32

min : UInt32 -> UInt32 -> UInt32
let min a b = if a <= b then a else b

max : UInt32 -> UInt32 -> UInt32
let max a b = if a >= b then a else b

checked_add : UInt32 -> UInt32 -> Result Int.ArithmeticError UInt32
let checked_add a b =
  let r = a + b
  if r < a then Err (Int.ArithmeticError "UInt32.checked_add: overflow") else Ok r

checked_sub : UInt32 -> UInt32 -> Result Int.ArithmeticError UInt32
let checked_sub a b =
  if a < b then Err (Int.ArithmeticError "UInt32.checked_sub: underflow") else Ok (a - b)

checked_mul : UInt32 -> UInt32 -> Result Int.ArithmeticError UInt32
let checked_mul a b =
  let p = to_bigint a * to_bigint b
  if p > max_bigint then Err (Int.ArithmeticError "UInt32.checked_mul: overflow") else Ok (a * b)

checked_div : UInt32 -> UInt32 -> Result Int.ArithmeticError UInt32
let checked_div a b =
  if b == 0u32 then Err (Int.ArithmeticError "UInt32.checked_div: division by zero") else Ok (a / b)

checked_rem : UInt32 -> UInt32 -> Result Int.ArithmeticError UInt32
let checked_rem a b =
  if b == 0u32 then Err (Int.ArithmeticError "UInt32.checked_rem: division by zero") else Ok (a % b)

divide : UInt32 -> UInt32 -> Result Int.ArithmeticError UInt32
let divide a b = checked_div a b

remainder : UInt32 -> UInt32 -> Result Int.ArithmeticError UInt32
let remainder a b = checked_rem a b

unsafe_div : UInt32 -> UInt32 -> UInt32
let unsafe_div a b =
  if b == 0u32 then
    let _ = Int.unsafe_div 1 0
    0u32
  else
    a / b

unsafe_rem : UInt32 -> UInt32 -> UInt32
let unsafe_rem a b =
  if b == 0u32 then
    let _ = Int.unsafe_rem 1 0
    0u32
  else
    a % b

bit_and : UInt32 -> UInt32 -> UInt32
let bit_and a b =
  wrapping_from_int (Int.bit_and (Int32.wrapping_from_uint32 a) (Int32.wrapping_from_uint32 b))

bit_or : UInt32 -> UInt32 -> UInt32
let bit_or a b =
  wrapping_from_int (Int.bit_or (Int32.wrapping_from_uint32 a) (Int32.wrapping_from_uint32 b))

bit_xor : UInt32 -> UInt32 -> UInt32
let bit_xor a b =
  wrapping_from_int (Int.bit_xor (Int32.wrapping_from_uint32 a) (Int32.wrapping_from_uint32 b))

bit_not : UInt32 -> UInt32
let bit_not a = wrapping_from_int (Int.bit_not (Int32.wrapping_from_uint32 a))

shift_left : UInt32 -> Int -> UInt32
let shift_left a n = wrapping_from_int (Int.shift_left (Int32.wrapping_from_uint32 a) n)

shift_right : UInt32 -> Int -> UInt32
let shift_right a n = wrapping_from_int (Int.shift_right_unsigned (Int32.wrapping_from_uint32 a) n)
