/// Text for inert data (`Unknown`), as the runtime writes it in its
/// messages. A formatter of a Flick type is a function `a -> String`, as
/// `show`.
module Formatter exposing (..)

/// The data as text: strings quoted, `BigInt`s with `n`.
format : Unknown -> String
foreign pure format from "flick:Formatter" "format"

/// The data as JSON text, indented by `indent` spaces (0 for one line).
format_json : Int -> Unknown -> String
foreign pure format_json from "flick:Formatter" "flickFormatJson"
