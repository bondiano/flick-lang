/// Effect's `Formatter`: text for inert data (`Unknown`), as Effect writes
/// it in its messages. A formatter of a Flick type is a function `a ->
/// String`, as `show`.
module Formatter exposing (..)

/// The data as Effect shows it: strings quoted, `BigInt`s with `n`.
format : Unknown -> String
foreign pure format from "@flick-lang/effect-ts/effect/Formatter" "format"
  reviewed "effect@4.1.2 sha256:e11f1775ecc1e146"

/// The data as JSON text, indented by `indent` spaces (0 for one line).
format_json : Int -> Unknown -> String
foreign pure format_json from "@flick-lang/effect-ts/effect/Formatter" "flickFormatJson"
  reviewed "effect@4.1.2 sha256:a883240b23b23332"
