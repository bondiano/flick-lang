/// Effect's `TxHashMap`: a hash map in a transactional cell, read and
/// changed inside `Tx.atomically` transactions. Like `HashMap`, each map
/// keeps the witness of its keys.
module TxHashMap exposing (..)

import EqHash
import HashMap
import Tx

/// A transactional hash map from `k` to `v` under the witness `w`.
type TxHashMap w k v

/// A new empty map under the witness.
empty : EqHash.EqHash w k ->{} TxHashMap w k v
foreign effect empty from "@flick-lang/runtime/effect/TxHashMap" "flickEmpty"
  reviewed "effect@4.1.2 sha256:53b731b352b246c1"

/// A new map of the entries under the witness; a later entry wins.
make : EqHash.EqHash w k -> List (k, v) ->{} TxHashMap w k v
foreign effect make from "@flick-lang/runtime/effect/TxHashMap" "flickMake"
  reviewed "effect@4.1.2 sha256:037aefb04d62b017"

/// A new map of the entries under the witness, as `make`.
from_iterable : EqHash.EqHash w k -> List (k, v) ->{} TxHashMap w k v
foreign effect from_iterable from "@flick-lang/runtime/effect/TxHashMap" "flickFromIterable"
  reviewed "effect@4.1.2 sha256:d7d4ea783a68e734"

/// The value of the key, if any.
get : k -> TxHashMap w k v ->{Tx.Transaction;} Option v
foreign effect get from "@flick-lang/runtime/effect/TxHashMap" "flickGet"
  reviewed "effect@4.1.2 sha256:eb0c924c72728810"

/// Sets the value of the key.
set : k -> v -> TxHashMap w k v ->{Tx.Transaction;} Unit
foreign effect set from "@flick-lang/runtime/effect/TxHashMap" "flickSet"
  reviewed "effect@4.1.2 sha256:4eb264ca51c347a5"

/// Whether the key has a value.
has : k -> TxHashMap w k v ->{Tx.Transaction;} Bool
foreign effect has from "@flick-lang/runtime/effect/TxHashMap" "flickHas"
  reviewed "effect@4.1.2 sha256:917f3d20e24bee5d"

/// Removes the key; whether it had a value.
remove : k -> TxHashMap w k v ->{Tx.Transaction;} Bool
foreign effect remove from "@flick-lang/runtime/effect/TxHashMap" "flickRemove"
  reviewed "effect@4.1.2 sha256:5eed0b53204b2dbc"

/// Removes every entry.
clear : TxHashMap w k v ->{Tx.Transaction;} Unit
foreign effect clear from "@flick-lang/runtime/effect/TxHashMap" "flickClear"
  reviewed "effect@4.1.2 sha256:4ba6b0ec9b7a0b72"

/// The number of entries.
size : TxHashMap w k v ->{Tx.Transaction;} Int
foreign effect size from "@flick-lang/runtime/effect/TxHashMap" "flickSize"
  reviewed "effect@4.1.2 sha256:ec154c2738f70495"

/// Whether it has no entries.
is_empty : TxHashMap w k v ->{Tx.Transaction;} Bool
foreign effect is_empty from "@flick-lang/runtime/effect/TxHashMap" "flickIsEmpty"
  reviewed "effect@4.1.2 sha256:e6751a60fbc116f9"

/// Whether it has an entry.
is_non_empty : TxHashMap w k v ->{Tx.Transaction;} Bool
foreign effect is_non_empty from "@flick-lang/runtime/effect/TxHashMap" "flickIsNonEmpty"
  reviewed "effect@4.1.2 sha256:98bd88f910b5fcd5"

/// Replaces the value of the key, if it has one, with `f` of it; the old
/// value.
modify : forall c w k v. k -> (v -> v)^c -> (TxHashMap w k v ->{Tx.Transaction;} Option v)^c
foreign effect modify from "@flick-lang/runtime/effect/TxHashMap" "flickModify"
  retention call
  reviewed "effect@4.1.2 sha256:56732f6408593818"

/// Sets or removes the key by `f` of its value.
modify_at :
  forall c w k v. k -> (Option v -> Option v)^c -> (TxHashMap w k v ->{Tx.Transaction;} Unit)^c
foreign effect modify_at from "@flick-lang/runtime/effect/TxHashMap" "flickModifyAt"
  retention call
  reviewed "effect@4.1.2 sha256:705c17efddeaf801"

/// The keys, in no particular order.
keys : TxHashMap w k v ->{Tx.Transaction;} List k
foreign effect keys from "@flick-lang/runtime/effect/TxHashMap" "flickKeys"
  reviewed "effect@4.1.2 sha256:777af1e47db5786f"

/// The values, in no particular order.
values : TxHashMap w k v ->{Tx.Transaction;} List v
foreign effect values from "@flick-lang/runtime/effect/TxHashMap" "flickValues"
  reviewed "effect@4.1.2 sha256:7b483d53accccb90"

/// The entries, in no particular order.
entries : TxHashMap w k v ->{Tx.Transaction;} List (k, v)
foreign effect entries from "@flick-lang/runtime/effect/TxHashMap" "flickEntries"
  reviewed "effect@4.1.2 sha256:15a2bba90aa16de5"

/// The entries, as `entries`.
to_entries : TxHashMap w k v ->{Tx.Transaction;} List (k, v)
foreign effect to_entries from "@flick-lang/runtime/effect/TxHashMap" "flickToEntries"
  reviewed "effect@4.1.2 sha256:ef0c7fc27c9de462"

/// The values, as `values`.
to_values : TxHashMap w k v ->{Tx.Transaction;} List v
foreign effect to_values from "@flick-lang/runtime/effect/TxHashMap" "flickToValues"
  reviewed "effect@4.1.2 sha256:80db30932f946361"

/// The immutable map the transaction sees.
snapshot : TxHashMap w k v ->{Tx.Transaction;} HashMap.HashMap w k v
foreign effect snapshot from "@flick-lang/runtime/effect/TxHashMap" "flickSnapshot"
  reviewed "effect@4.1.2 sha256:7ddf31d84c172557"

/// Sets the entries of the immutable map.
union : HashMap.HashMap w k v -> TxHashMap w k v ->{Tx.Transaction;} Unit
foreign effect union from "@flick-lang/runtime/effect/TxHashMap" "flickUnion"
  reviewed "effect@4.1.2 sha256:7c36f7469be80486"

/// Removes the keys.
remove_many : List k -> TxHashMap w k v ->{Tx.Transaction;} Unit
foreign effect remove_many from "@flick-lang/runtime/effect/TxHashMap" "flickRemoveMany"
  reviewed "effect@4.1.2 sha256:9a3acb3e98105d51"

/// Sets the entries.
set_many : List (k, v) -> TxHashMap w k v ->{Tx.Transaction;} Unit
foreign effect set_many from "@flick-lang/runtime/effect/TxHashMap" "flickSetMany"
  reviewed "effect@4.1.2 sha256:f331295e244ffdff"

/// `get` with the key's hash, which must be the witness's hash of it.
get_hash : k -> Int -> TxHashMap w k v ->{Tx.Transaction;} Option v
foreign effect get_hash from "@flick-lang/runtime/effect/TxHashMap" "flickGetHash"
  reviewed "effect@4.1.2 sha256:2c9f09e061f628d3"

/// `has` with the key's hash, which must be the witness's hash of it.
has_hash : k -> Int -> TxHashMap w k v ->{Tx.Transaction;} Bool
foreign effect has_hash from "@flick-lang/runtime/effect/TxHashMap" "flickHasHash"
  reviewed "effect@4.1.2 sha256:8c5c148986f01cae"

/// A new map of `f value key` for each entry.
map : forall c w k v b. (v -> k -> b)^c -> (TxHashMap w k v ->{Tx.Transaction;} TxHashMap w k b)^c
foreign effect map from "@flick-lang/runtime/effect/TxHashMap" "flickMap"
  retention call
  reviewed "effect@4.1.2 sha256:4b2559c8279dc48c"

/// A new map of the entries the predicate accepts.
filter :
  forall c w k v. (v -> k -> Bool)^c -> (TxHashMap w k v ->{Tx.Transaction;} TxHashMap w k v)^c
foreign effect filter from "@flick-lang/runtime/effect/TxHashMap" "flickFilter"
  retention call
  reviewed "effect@4.1.2 sha256:366c0b297ddce515"

/// A new map of the `Ok` values of `f value key`.
filter_map :
  forall c w k v x b.
  (v -> k -> Result x b)^c -> (TxHashMap w k v ->{Tx.Transaction;} TxHashMap w k b)^c
foreign effect filter_map from "@flick-lang/runtime/effect/TxHashMap" "flickFilterMap"
  retention call
  reviewed "effect@4.1.2 sha256:1347f1c7adc3b7f1"

/// A new map of the `Some` values.
compact : TxHashMap w k (Option a) ->{Tx.Transaction;} TxHashMap w k a
foreign effect compact from "@flick-lang/runtime/effect/TxHashMap" "flickCompact"
  reviewed "effect@4.1.2 sha256:03a1b73a2b794da9"

/// A new map of the entries of the maps `f value key` makes.
flat_map :
  forall c w k v b.
  (v -> k ->{Tx.Transaction;} TxHashMap w k b)^c ->
  (TxHashMap w k v ->{Tx.Transaction;} TxHashMap w k b)^c
foreign effect flat_map from "@flick-lang/runtime/effect/TxHashMap" "flickFlatMap"
  retention call
  reviewed "effect@4.1.2 sha256:47018e4a5b37b24d"

/// Folds the entries, in no particular order, from `zero`.
reduce : forall c w k v a. a -> (a -> v -> k -> a)^c -> (TxHashMap w k v ->{Tx.Transaction;} a)^c
foreign effect reduce from "@flick-lang/runtime/effect/TxHashMap" "flickReduce"
  retention call
  reviewed "effect@4.1.2 sha256:717f3dea2004f2e5"

/// Whether the predicate accepts an entry.
has_by : forall c w k v. (v -> k -> Bool)^c -> (TxHashMap w k v ->{Tx.Transaction;} Bool)^c
foreign effect has_by from "@flick-lang/runtime/effect/TxHashMap" "flickHasBy"
  retention call
  reviewed "effect@4.1.2 sha256:b0a6982a29a3e53f"

/// Whether the predicate accepts an entry, as `has_by`.
some : forall c w k v. (v -> k -> Bool)^c -> (TxHashMap w k v ->{Tx.Transaction;} Bool)^c
foreign effect some from "@flick-lang/runtime/effect/TxHashMap" "flickSome"
  retention call
  reviewed "effect@4.1.2 sha256:9096620e98bc2c47"

/// Whether the predicate accepts every entry.
every : forall c w k v. (v -> k -> Bool)^c -> (TxHashMap w k v ->{Tx.Transaction;} Bool)^c
foreign effect every from "@flick-lang/runtime/effect/TxHashMap" "flickEvery"
  retention call
  reviewed "effect@4.1.2 sha256:4a0f88e8415cee3c"

/// An entry the predicate accepts, if any.
find_first :
  forall c w k v. (v -> k -> Bool)^c -> (TxHashMap w k v ->{Tx.Transaction;} Option (k, v))^c
foreign effect find_first from "@flick-lang/runtime/effect/TxHashMap" "flickFindFirst"
  retention call
  reviewed "effect@4.1.2 sha256:e05c71daca04194e"

/// Runs `f value key` for each entry, in no particular order.
for_each :
  forall c w k v r e. (v -> k ->{r; e} Unit)^c -> (TxHashMap w k v ->{Tx.Transaction | r; e} Unit)^c
foreign effect for_each from "@flick-lang/runtime/effect/TxHashMap" "flickForEach"
  retention call
  reviewed "effect@4.1.2 sha256:286e8a090d429313"
