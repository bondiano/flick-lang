/// A hash map in a transactional cell, read and changed inside
/// `Tx.atomically` transactions. Like `HashMap`, each map keeps the witness
/// of its keys.
module TxHashMap exposing (..)

import EqHash
import HashMap
import Tx

/// A transactional hash map from `k` to `v` under the witness `w`.
type TxHashMap w k v

/// A new empty map under the witness.
empty : EqHash.EqHash w k ->{} TxHashMap w k v
foreign effect empty from "flick:TxHashMap" "flickEmpty"

/// A new map of the entries under the witness; a later entry wins.
make : EqHash.EqHash w k -> List (k, v) ->{} TxHashMap w k v
foreign effect make from "flick:TxHashMap" "flickMake"

/// A new map of the entries under the witness, as `make`.
from_iterable : EqHash.EqHash w k -> List (k, v) ->{} TxHashMap w k v
foreign effect from_iterable from "flick:TxHashMap" "flickFromIterable"

/// The value of the key, if any.
get : k -> TxHashMap w k v ->{Tx.Transaction} Option v
foreign effect get from "flick:TxHashMap" "flickGet"

/// Sets the value of the key.
set : k -> v -> TxHashMap w k v ->{Tx.Transaction} Unit
foreign effect set from "flick:TxHashMap" "flickSet"

/// Whether the key has a value.
has : k -> TxHashMap w k v ->{Tx.Transaction} Bool
foreign effect has from "flick:TxHashMap" "flickHas"

/// Removes the key; whether it had a value.
remove : k -> TxHashMap w k v ->{Tx.Transaction} Bool
foreign effect remove from "flick:TxHashMap" "flickRemove"

/// Removes every entry.
clear : TxHashMap w k v ->{Tx.Transaction} Unit
foreign effect clear from "flick:TxHashMap" "flickClear"

/// The number of entries.
size : TxHashMap w k v ->{Tx.Transaction} Int
foreign effect size from "flick:TxHashMap" "flickSize"

/// Whether it has no entries.
is_empty : TxHashMap w k v ->{Tx.Transaction} Bool
foreign effect is_empty from "flick:TxHashMap" "flickIsEmpty"

/// Whether it has an entry.
is_non_empty : TxHashMap w k v ->{Tx.Transaction} Bool
foreign effect is_non_empty from "flick:TxHashMap" "flickIsNonEmpty"

/// Replaces the value of the key, if it has one, with `f` of it; the old
/// value.
modify : k -> (v -> v)^c -> (TxHashMap w k v ->{Tx.Transaction} Option v)^c
foreign effect modify from "flick:TxHashMap" "flickModify"
  retention call

/// Sets or removes the key by `f` of its value.
modify_at : k -> (Option v -> Option v)^c -> (TxHashMap w k v ->{Tx.Transaction} Unit)^c
foreign effect modify_at from "flick:TxHashMap" "flickModifyAt"
  retention call

/// The keys, in no particular order.
keys : TxHashMap w k v ->{Tx.Transaction} List k
foreign effect keys from "flick:TxHashMap" "flickKeys"

/// The values, in no particular order.
values : TxHashMap w k v ->{Tx.Transaction} List v
foreign effect values from "flick:TxHashMap" "flickValues"

/// The entries, in no particular order.
entries : TxHashMap w k v ->{Tx.Transaction} List (k, v)
foreign effect entries from "flick:TxHashMap" "flickEntries"

/// The entries, as `entries`.
to_entries : TxHashMap w k v ->{Tx.Transaction} List (k, v)
foreign effect to_entries from "flick:TxHashMap" "flickToEntries"

/// The values, as `values`.
to_values : TxHashMap w k v ->{Tx.Transaction} List v
foreign effect to_values from "flick:TxHashMap" "flickToValues"

/// The immutable map the transaction sees.
snapshot : TxHashMap w k v ->{Tx.Transaction} HashMap.HashMap w k v
foreign effect snapshot from "flick:TxHashMap" "flickSnapshot"

/// Sets the entries of the immutable map.
union : HashMap.HashMap w k v -> TxHashMap w k v ->{Tx.Transaction} Unit
foreign effect union from "flick:TxHashMap" "flickUnion"

/// Removes the keys.
remove_many : List k -> TxHashMap w k v ->{Tx.Transaction} Unit
foreign effect remove_many from "flick:TxHashMap" "flickRemoveMany"

/// Sets the entries.
set_many : List (k, v) -> TxHashMap w k v ->{Tx.Transaction} Unit
foreign effect set_many from "flick:TxHashMap" "flickSetMany"

/// `get` with the key's hash, which must be the witness's hash of it.
get_hash : k -> Int -> TxHashMap w k v ->{Tx.Transaction} Option v
foreign effect get_hash from "flick:TxHashMap" "flickGetHash"

/// `has` with the key's hash, which must be the witness's hash of it.
has_hash : k -> Int -> TxHashMap w k v ->{Tx.Transaction} Bool
foreign effect has_hash from "flick:TxHashMap" "flickHasHash"

/// A new map of `f value key` for each entry.
map : (v -> k -> b)^c -> TxHashMap w k v ->{Tx.Transaction} TxHashMap w k b
foreign effect map from "flick:TxHashMap" "flickMap"
  retention call

/// A new map of the entries the predicate accepts.
filter : (v -> k -> Bool)^c -> TxHashMap w k v ->{Tx.Transaction} TxHashMap w k v
foreign effect filter from "flick:TxHashMap" "flickFilter"
  retention call

/// A new map of the `Ok` values of `f value key`.
filter_map : (v -> k -> Result x b)^c -> TxHashMap w k v ->{Tx.Transaction} TxHashMap w k b
foreign effect filter_map from "flick:TxHashMap" "flickFilterMap"
  retention call

/// A new map of the `Some` values.
compact : TxHashMap w k (Option a) ->{Tx.Transaction} TxHashMap w k a
foreign effect compact from "flick:TxHashMap" "flickCompact"

/// A new map of the entries of the maps `f value key` makes.
flat_map :
  (v -> k ->{Tx.Transaction} TxHashMap w k b)^c ->
  TxHashMap w k v ->{Tx.Transaction}
  TxHashMap w k b
foreign effect flat_map from "flick:TxHashMap" "flickFlatMap"
  retention call

/// Folds the entries, in no particular order, from `zero`.
reduce : a -> (a -> v -> k -> a)^c -> (TxHashMap w k v ->{Tx.Transaction} a)^c
foreign effect reduce from "flick:TxHashMap" "flickReduce"
  retention call

/// Whether the predicate accepts an entry.
has_by : (v -> k -> Bool)^c -> TxHashMap w k v ->{Tx.Transaction} Bool
foreign effect has_by from "flick:TxHashMap" "flickHasBy"
  retention call

/// Whether the predicate accepts an entry, as `has_by`.
some : (v -> k -> Bool)^c -> TxHashMap w k v ->{Tx.Transaction} Bool
foreign effect some from "flick:TxHashMap" "flickSome"
  retention call

/// Whether the predicate accepts every entry.
every : (v -> k -> Bool)^c -> TxHashMap w k v ->{Tx.Transaction} Bool
foreign effect every from "flick:TxHashMap" "flickEvery"
  retention call

/// An entry the predicate accepts, if any.
find_first : (v -> k -> Bool)^c -> TxHashMap w k v ->{Tx.Transaction} Option (k, v)
foreign effect find_first from "flick:TxHashMap" "flickFindFirst"
  retention call

/// Runs `f value key` for each entry, in no particular order.
for_each : (v -> k ->{r; e} Unit)^c -> TxHashMap w k v ->{Tx.Transaction | r; e} Unit
foreign effect for_each from "flick:TxHashMap" "flickForEach"
  retention call
