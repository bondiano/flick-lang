/// A queue whose offers and takes take part in the enclosing
/// `Tx.atomically` transaction. A take from an empty queue, or an offer to
/// a full bounded one, retries the transaction until it can go on. Once
/// failed, takes fail with the queue's error; once shut down or
/// interrupted, they interrupt the fiber.
module TxQueue exposing (..)

import Tx

/// A transactional queue of `a` that may end with an error of `e`.
type TxQueue a (e : ErrorRow)

/// A new queue of at most `capacity` elements; an offer to a full one
/// waits.
bounded : Int ->{} TxQueue a e
foreign effect bounded from "flick:TxQueue" "bounded"

/// A new queue without a bound.
unbounded : Unit ->{} TxQueue a e
foreign effect unbounded from "flick:TxQueue" "unbounded"
  arity 0

/// A new queue of at most `capacity` elements; an offer to a full one
/// drops the new element.
dropping : Int ->{} TxQueue a e
foreign effect dropping from "flick:TxQueue" "dropping"

/// A new queue of at most `capacity` elements; an offer to a full one
/// drops the oldest element.
sliding : Int ->{} TxQueue a e
foreign effect sliding from "flick:TxQueue" "sliding"

/// Adds the element, waiting while a bounded queue is full; false when
/// a dropping queue dropped it or the queue is closed.
offer : a -> TxQueue a e ->{Async, Tx.Transaction} Bool
foreign effect offer from "flick:TxQueue" "offer"
  arity 1

/// Adds the elements, waiting while a bounded queue is full; the ones a
/// dropping or closed queue did not take.
offer_all : List a -> TxQueue a e ->{Async, Tx.Transaction} List a
foreign effect offer_all from "flick:TxQueue" "offerAll"
  arity 1

/// Removes the oldest element, waiting for one.
take : TxQueue a e ->{Async, Tx.Transaction; e} a
foreign effect take from "flick:TxQueue" "take"

/// Removes the oldest element, if there is one.
poll : TxQueue a e ->{Tx.Transaction} Option a
foreign effect poll from "flick:TxQueue" "poll"

/// Removes every element, waiting for at least one.
take_all : TxQueue a e ->{Tx.Transaction; e} NonEmpty.NonEmpty a
foreign effect take_all from "flick:TxQueue" "takeAll"

/// Removes `n` elements, waiting for them.
take_n : Int -> TxQueue a e ->{Async, Tx.Transaction; e} List a
foreign effect take_n from "flick:TxQueue" "takeN"
  arity 1

/// Removes at least `min` and at most `max` elements, waiting for `min`.
take_between : Int -> Int -> TxQueue a e ->{Async, Tx.Transaction; e} List a
foreign effect take_between from "flick:TxQueue" "takeBetween"
  arity 2

/// The oldest element, kept in the queue, waiting for one.
peek : TxQueue a e ->{Tx.Transaction; e} a
foreign effect peek from "flick:TxQueue" "peek"

/// The number of elements.
size : TxQueue a e ->{Tx.Transaction} Int
foreign effect size from "flick:TxQueue" "size"

/// Whether it has no elements.
is_empty : TxQueue a e ->{Tx.Transaction} Bool
foreign effect is_empty from "flick:TxQueue" "isEmpty"

/// Whether it has an element.
is_non_empty : TxQueue a e ->{Tx.Transaction} Bool
foreign effect is_non_empty from "flick:TxQueue" "isNonEmpty"

/// Whether it holds as many elements as its capacity.
is_full : TxQueue a e ->{Tx.Transaction} Bool
foreign effect is_full from "flick:TxQueue" "isFull"

/// Closes it: takes drain the elements left, then interrupt the fiber;
/// false when it was already closed.
interrupt : TxQueue a e ->{Tx.Transaction} Bool
foreign effect interrupt from "flick:TxQueue" "interrupt"

/// Closes it with the error, dropping its elements: takes fail with it;
/// false when it was already closed.
fail : Errors e -> TxQueue a e ->{Tx.Transaction} Bool
foreign effect fail from "flick:TxQueue" "fail"
  arity 1

/// Closes it with the whole failure, as `fail` does with one error.
fail_cause : Failure e -> TxQueue a e ->{Tx.Transaction} Bool
foreign effect fail_cause from "flick:TxQueue" "flickFailCause"

/// Removes every element; fails with the queue's error when it failed.
clear : TxQueue a e ->{Tx.Transaction; e} List a
foreign effect clear from "flick:TxQueue" "clear"

/// Drops its elements and closes it, as `interrupt` does.
shutdown : TxQueue a e ->{Tx.Transaction} Bool
foreign effect shutdown from "flick:TxQueue" "shutdown"

/// Whether it takes offers.
is_open : TxQueue a e ->{Tx.Transaction} Bool
foreign effect is_open from "flick:TxQueue" "isOpen"

/// Whether it is closed but still holds elements to take.
is_closing : TxQueue a e ->{Tx.Transaction} Bool
foreign effect is_closing from "flick:TxQueue" "isClosing"

/// Whether it is closed and empty.
is_done : TxQueue a e ->{Tx.Transaction} Bool
foreign effect is_done from "flick:TxQueue" "isDone"

/// Whether it is closed and empty, as `is_done`.
is_shutdown : TxQueue a e ->{Tx.Transaction} Bool
foreign effect is_shutdown from "flick:TxQueue" "isShutdown"

/// Retries the transaction until the queue is done.
await_completion : TxQueue a e ->{Tx.Transaction} Unit
foreign effect await_completion from "flick:TxQueue" "awaitCompletion"
