/// Effect's `Inspectable`: the debugging text and JSON form Effect gives a
/// value. Over inert data (`Unknown`), so no getter or method runs.
module Inspectable exposing (..)

/// The data as Effect prints it for debugging, indented by `indent` spaces
/// (0 for one line).
to_string_unknown : Int -> Unknown -> String
foreign pure to_string_unknown from "@flick-lang/effect-ts/effect/Inspectable" "flickToStringUnknown"
  reviewed "effect@4.1.2 sha256:ea5d81bca700957a"

/// The data in the JSON form Effect logs it in.
to_json : Unknown -> Unknown
foreign pure to_json from "@flick-lang/effect-ts/effect/Inspectable" "toJson"
