/// Effect's `RcMap`: resources by key, each shared by reference count as
/// an `RcRef` is. Keys are compared by `==`.
module RcMap exposing (..)

import Duration

/// Resources of `a` by keys of `k`, of region `s`, whose lookup fails with
/// `e`.
type RcMap (s : Region) k (e : ErrorRow) a

/// A `get` of a new key found the map at its capacity.
type error ExceededCapacity = ExceededCapacity String
  deriving Eq, Show

/// A map owned by the innermost `scope` (or the one of region `s`);
/// `lookup` runs with the services of this call. A resource stays for
/// `idleTimeToLive key` after its last holder (`None`: no time), and the map
/// holds at most `capacity` keys (`None`: no bound).
make :
  {
    lookup : k ->{r; e} a;
    idleTimeToLive : Option (k -> Duration.Duration);
    capacity : Option Int;
  } ->{Scope s | r}
  RcMap s k e a
foreign effect make from "flick:RcMap" "flickMake"
  reviewed "effect@4.1.2 sha256:a1751cbe903120cf"

/// The resource of `key`, looking it up if no one holds it; the innermost
/// `scope` (or the one of region `t`) holds it until it closes.
get : k -> RcMap s k e a ->{Scope t; ExceededCapacity | e} a^{t}
foreign effect get from "flick:RcMap" "flickGet"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:361e3835af8b8aab"

/// The resource of `key` if it is held now, holding it as `get` does.
get_option : k -> RcMap s k e a ->{Scope t; e} (Option a)^{t}
foreign effect get_option from "flick:RcMap" "getOption"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:1f853b27223bed36"

/// The keys with a resource.
keys : RcMap s k e a ->{} List k
foreign effect keys from "flick:RcMap" "flickKeys"
  retention call
  reviewed "effect@4.1.2 sha256:415be2871c1c1181"

/// Releases the resource of `key` once its holders are done.
invalidate : k -> RcMap s k e a ->{Async} Unit
foreign effect invalidate from "flick:RcMap" "invalidate"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:7bef59e4b2678f52"

/// Whether `key` has a resource.
has : k -> RcMap s k e a ->{} Bool
foreign effect has from "flick:RcMap" "has"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:c83c9f79b2b36805"

/// Starts the idle time of `key`'s resource anew.
touch : k -> RcMap s k e a ->{} Unit
foreign effect touch from "flick:RcMap" "touch"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:292a9ca3a7723ca2"
