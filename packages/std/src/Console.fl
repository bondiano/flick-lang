/// Messages by level, through the `Host.Console` service: `log`, `info` and
/// `debug` write a line to stdout, `warn` and `error` to stderr.
module Console exposing (log, info, debug, warn, error)

import Host

/// Writes the message to stdout.
log : String ->{Host.Console} Unit
let log message = Host.Console.stdout_line message

/// Writes the message to stdout.
info : String ->{Host.Console} Unit
let info message = Host.Console.stdout_line message

/// Writes the message to stdout.
debug : String ->{Host.Console} Unit
let debug message = Host.Console.stdout_line message

/// Writes the message to stderr.
warn : String ->{Host.Console} Unit
let warn message = Host.Console.stderr_line message

/// Writes the message to stderr.
error : String ->{Host.Console} Unit
let error message = Host.Console.stderr_line message
