/// The JS console of the current fiber, which a program may replace for a
/// task with `with_console`. It needs no service row: the global console is
/// the default.
module Console exposing (..)

/// A JS console.
type Console

/// The console of the current fiber.
current : Unit ->{} Console
foreign effect current from "flick:Console" "flickCurrent"
  arity 0
  reviewed "effect@4.1.2 sha256:2f4fb053b0d4b28f"

/// Runs `task` with `console` as its console.
with_console : Console -> (Eff r e a)^c ->{r; e} a
foreign effect with_console from "flick:Console" "flickWithConsole"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:3345981d2ef15a19"

/// A console of Node.js that writes everything to stderr.
to_stderr : Unit ->{} Console
foreign to_stderr from "flick:Console" "flickToStderr"
  arity 0

/// Writes the message to stdout.
log : String ->{} Unit
foreign effect log from "flick:Console" "log"
  reviewed "effect@4.1.2 sha256:1408b75890bf104c"

info : String ->{} Unit
foreign effect info from "flick:Console" "info"
  reviewed "effect@4.1.2 sha256:c76d7ed281b33d8d"

debug : String ->{} Unit
foreign effect debug from "flick:Console" "debug"
  reviewed "effect@4.1.2 sha256:0c38ab8aaac10804"

/// Writes the message to stderr.
warn : String ->{} Unit
foreign effect warn from "flick:Console" "warn"
  reviewed "effect@4.1.2 sha256:36267abc1fe794e0"

/// Writes the message to stderr.
error : String ->{} Unit
foreign effect error from "flick:Console" "error"
  reviewed "effect@4.1.2 sha256:b175efdcdcf2086a"

/// Writes `Trace: message` and the JS stack to stderr.
trace : String ->{} Unit
foreign effect trace from "flick:Console" "trace"
  reviewed "effect@4.1.2 sha256:8b8eaea960699247"

/// Writes `Assertion failed: message` to stderr unless the condition holds.
assert : Bool -> String ->{} Unit
foreign effect assert from "flick:Console" "assert"
  arity 2
  reviewed "effect@4.1.2 sha256:f5386f4582b3a37d"

/// Clears the terminal, when stdout is one.
clear : Unit ->{} Unit
foreign effect clear from "flick:Console" "flickClear"
  arity 0
  reviewed "effect@4.1.2 sha256:2be2fad90e91cf33"

/// Counts the calls with the label and writes `label: n`.
count : String ->{} Unit
foreign effect count from "flick:Console" "count"
  reviewed "effect@4.1.2 sha256:ca22653431fb5c3f"

/// Restarts the count of the label.
count_reset : String ->{} Unit
foreign effect count_reset from "flick:Console" "countReset"
  reviewed "effect@4.1.2 sha256:593bd2e21392d345"

/// Writes the value as the JS console inspects it.
dir : a ->{} Unit
foreign effect dir from "flick:Console" "dir"
  reviewed "effect@4.1.2 sha256:ea8b715f44567bea"

/// `dir`, as XML where the console knows how.
dirxml : a ->{} Unit
foreign effect dirxml from "flick:Console" "dirxml"
  reviewed "effect@4.1.2 sha256:72284f08f2844c4a"

/// Writes the list of records as a table, with only the given columns.
table : Option (List String) -> List a ->{} Unit
foreign effect table from "flick:Console" "flickTable"
  arity 2
  reviewed "effect@4.1.2 sha256:867e596d96cae736"

/// Options of a group: its label and whether it starts collapsed.
type alias GroupOptions = { label : Option String; collapsed : Bool }

/// Indents what the console writes until the scope of region `s` closes.
group : GroupOptions ->{Scope s} Unit
foreign effect group from "flick:Console" "flickGroup"
  reviewed "effect@4.1.2 sha256:7a1e604473cf5f21"

/// Runs `task` in a group.
with_group : GroupOptions -> (Eff r e a)^c ->{r; e} a
foreign effect with_group from "flick:Console" "flickWithGroup"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:5d344934fb46954f"

/// Starts the timer of the label; the scope of region `s` ends it, writing
/// `label: <elapsed>`.
time : String ->{Scope s} Unit
foreign effect time from "flick:Console" "time"
  reviewed "effect@4.1.2 sha256:98ff0a1f2599c827"

/// Writes `label: <elapsed> message` for a running timer.
time_log : String -> String ->{} Unit
foreign effect time_log from "flick:Console" "timeLog"
  arity 2
  reviewed "effect@4.1.2 sha256:74bd15e1b169e4c4"

/// Runs `task` under the timer of the label.
with_time : String -> (Eff r e a)^c ->{r; e} a
foreign effect with_time from "flick:Console" "withTime"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:2458e104c9bcca10"
