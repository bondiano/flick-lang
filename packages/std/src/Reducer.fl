/// A combiner with a start value, which folds a whole list:
/// `Reducer.combine_all Reducer.number_sum [1, 2, 3]` is 6.
module Reducer exposing (..)

import Combiner

/// A reducer of values of `a`.
type Reducer a

/// The reducer of `combine` starting from `initial`.
make : (a -> a -> a) -> a -> Reducer a
foreign pure make from "flick:Reducer" "make"
  arity 2

/// Combines `self` with `that`.
combine : Reducer a -> a -> a -> a
foreign pure combine from "flick:Reducer" "flickCombine"

/// The start value: what an empty list reduces to.
initial_value : Reducer a -> a
foreign pure initial_value from "flick:Reducer" "flickInitialValue"

/// Folds the list from the start value, first to last.
combine_all : Reducer a -> List a -> a
foreign pure combine_all from "flick:Reducer" "flickCombineAll"

/// The reducer's combination without its start value.
to_combiner : Reducer a -> Combiner.Combiner a
foreign pure to_combiner from "flick:Reducer" "flickToCombiner"

/// The reducer with the arguments of its combination swapped.
flip : Reducer a -> Reducer a
foreign pure flip from "flick:Reducer" "flip"

/// Sums numbers from 0.
number_sum : Reducer Float
foreign pure number_sum from "flick:Number" "ReducerSum"

/// Multiplies numbers from 1.
number_multiply : Reducer Float
foreign pure number_multiply from "flick:Number" "ReducerMultiply"

/// The greatest number, from `-Infinity`.
number_max : Reducer Float
foreign pure number_max from "flick:Number" "ReducerMax"

/// The least number, from `Infinity`.
number_min : Reducer Float
foreign pure number_min from "flick:Number" "ReducerMin"

/// Sums BigInts from 0.
bigint_sum : Reducer BigInt
foreign pure bigint_sum from "flick:BigInt" "ReducerSum"

/// Multiplies BigInts from 1.
bigint_multiply : Reducer BigInt
foreign pure bigint_multiply from "flick:BigInt" "ReducerMultiply"

/// Joins strings from `""`.
string_concat : Reducer String
foreign pure string_concat from "flick:String" "ReducerConcat"

/// Joins lists from `[]`.
list_concat : Unit -> Reducer (List a)
foreign pure list_concat from "flick:Array" "getReadonlyReducerConcat"
  arity 0

/// Combines the `Some`s with the combiner, skipping `None`s, from `None`.
option : Combiner.Combiner a -> Reducer (Option a)
foreign pure option from "flick:Option" "makeReducer"

/// Combines `Some`s with the reducer from `Some` of its start value; a
/// `None` anywhere makes the result `None`.
option_fail_fast : Reducer a -> Reducer (Option a)
foreign pure option_fail_fast from "flick:Option" "makeReducerFailFast"

/// Merges dictionaries from the empty one, keeping every key; the values of
/// a key in both are combined.
record_union : Combiner.Combiner a -> Reducer (Record.ReadonlyRecord a)
foreign pure record_union from "flick:Record" "makeReducerUnion"

/// Merges dictionaries keeping only the keys in both, their values combined.
record_intersection : Combiner.Combiner a -> Reducer (Record.ReadonlyRecord a)
foreign pure record_intersection from "flick:Record" "makeReducerIntersection"

/// Reduces records field by field, each field with its own reducer; the
/// start value is the record of their start values.
struct : Record.Map Reducer r rs => rs -> Reducer r
foreign pure struct from "flick:Struct" "flickMakeReducer"

/// Reduces pairs element by element.
tuple2 : (Reducer a, Reducer b) -> Reducer (a, b)
foreign pure tuple2 from "flick:Tuple" "makeReducer"

/// Reduces triples element by element.
tuple3 : (Reducer a, Reducer b, Reducer c) -> Reducer (a, b, c)
foreign pure tuple3 from "flick:Tuple" "makeReducer"
