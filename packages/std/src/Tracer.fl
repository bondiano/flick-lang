/// Spans around tasks, with their attributes, links and parents.
/// `with_span` runs a task in a new span of the current tracer (the native
/// one by default); `parent_span` is the span a task runs in.
module Tracer exposing (..)

import LogLevel

/// A span of the tracer, or an external one from another process.
type Span

/// A tracer: what makes the spans.
type Tracer

/// The role of a span, as OpenTelemetry names it.
opaque unboxed type SpanKind = SpanKind String

internal : SpanKind
let internal = SpanKind "internal"

server : SpanKind
let server = SpanKind "server"

client : SpanKind
let client = SpanKind "client"

producer : SpanKind
let producer = SpanKind "producer"

consumer : SpanKind
let consumer = SpanKind "consumer"

instance Eq SpanKind =
  let eq x y =
    match (x, y) with
    | (SpanKind a, SpanKind b) -> a == b

instance Show SpanKind =
  let show k =
    match k with
    | SpanKind name -> name

/// A running span with its start, or an ended one with its start and end,
/// in nanoseconds.
type SpanStatus = Started BigInt | Ended BigInt BigInt
  deriving Eq, Show

/// A span linked to another, with attributes of the link.
type alias SpanLink = { span : Span; attributes : List (String, String) }

/// How `with_span` makes its span: `parent` (by default the current span)
/// unless `root`; `level` is checked against `with_minimum_trace_level`;
/// `disablePropagation` makes a span that is not traced and that the spans
/// inside skip when they look for their parent.
type alias SpanOptions = {
  attributes : List (String, String);
  links : List SpanLink;
  parent : Option Span;
  root : Bool;
  kind_ : SpanKind;
  sampled : Option Bool;
  level : Option LogLevel.LogLevel;
  captureStackTrace : Bool;
  disablePropagation : Bool;
}

/// Runs `task` in a new span with the name, which ends with the task.
with_span : String -> SpanOptions -> (Eff r e a)^c ->{r; e} a
foreign effect with_span from "flick:Tracer" "flickWithSpan"
  arity 2
  retention call

/// The span the current task runs in.
parent_span : Unit ->{} Option Span
foreign effect parent_span from "flick:Tracer" "flickParentSpan"
  arity 0

/// A span of another process, to use as a parent or a link.
external_span : { spanId : String; traceId : String; sampled : Bool } -> Span
foreign pure external_span from "flick:Tracer" "flickExternalSpan"

span_id : Span -> String
foreign pure span_id from "flick:Tracer" "flickSpanId"

trace_id : Span -> String
foreign pure trace_id from "flick:Tracer" "flickTraceId"

sampled : Span -> Bool
foreign pure sampled from "flick:Tracer" "flickSampled"

/// The name of a span of the tracer; `None` for an external one.
span_name : Span -> Option String
foreign pure span_name from "flick:Tracer" "flickSpanName"

/// The kind of a span of the tracer; `None` for an external one.
span_kind : Span -> Option SpanKind
foreign pure span_kind from "flick:Tracer" "flickSpanKind"

/// The parent of a span of the tracer.
parent : Span -> Option Span
foreign pure parent from "flick:Tracer" "flickParent"

/// The links of a span of the tracer.
links : Span -> List SpanLink
foreign pure links from "flick:Tracer" "flickLinks"

/// Whether the span still runs; it changes when it ends.
status : Span ->{} SpanStatus
foreign status from "flick:Tracer" "flickStatus"

/// The attributes of the span so far, as text.
attributes : Span ->{} List (String, String)
foreign attributes from "flick:Tracer" "flickAttributes"

/// The native tracer, which keeps spans in memory only.
native_tracer : Tracer
foreign pure native_tracer from "flick:Tracer" "nativeTracer"

/// Runs `task` with the tracer making its spans; a tracer of a scope, such
/// as `Otlp.tracer`'s, only inside it.
with_tracer : Tracer^d -> (Eff r e a)^c ->{r; e} a
foreign effect with_tracer from "flick:Tracer" "flickWithTracer"
  arity 1
  retention call

/// Runs `task` with the level its spans get when they name none.
with_trace_level : LogLevel.LogLevel -> (Eff r e a)^c ->{r; e} a
foreign effect with_trace_level from "flick:Tracer" "flickWithTraceLevel"
  arity 1
  retention call

/// Runs `task` tracing only the spans of at least the level.
with_minimum_trace_level : LogLevel.LogLevel -> (Eff r e a)^c ->{r; e} a
foreign effect with_minimum_trace_level from "flick:Tracer" "flickWithMinimumTraceLevel"
  arity 1
  retention call
