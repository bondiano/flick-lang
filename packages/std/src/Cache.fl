/// A cache of values looked up by key on demand, at most once at a time per
/// key, kept up to a capacity and for a time to live. Keys are compared by
/// `==`.
module Cache exposing (..)

import Duration

/// A cache from keys of `k` to values of `a`, whose lookup fails with `e`.
type Cache k (e : ErrorRow) a

/// A cache whose `lookup` runs with the services of the call that made
/// it; entries live for `timeToLive` (`None`: until evicted).
make :
  { lookup : k ->{r; e} a; capacity : Int; timeToLive : Option Duration.Duration } ->{r} Cache k e a
foreign effect make from "flick:Cache" "flickMake"

/// `make`, the time to live of each entry computed from how its lookup
/// ended and its key.
make_with :
  (k ->{r; e} a) ->
  { capacity : Int; timeToLive : Option (Exit e a -> k -> Duration.Duration) } ->{r}
  Cache k e a
foreign effect make_with from "flick:Cache" "flickMakeWith"

/// The value of `key`, looking it up once if it is missing or expired;
/// a failed lookup is cached too.
get : k -> Cache k e a ->{Async; e} a
foreign effect get from "flick:Cache" "get"
  arity 1

/// The value of `key` if it is cached, waiting for a lookup under way,
/// without a new one; fails as the cached lookup did.
get_option : k -> Cache k e a ->{Async; e} Option a
foreign effect get_option from "flick:Cache" "getOption"
  arity 1

/// The value of `key` if a lookup of it has succeeded and not expired.
get_success : k -> Cache k e a ->{Async} Option a
foreign effect get_success from "flick:Cache" "getSuccess"
  arity 1

/// Caches `value` for `key`.
set : k -> a -> Cache k e a ->{} Unit
foreign effect set from "flick:Cache" "set"
  arity 2

/// Whether `key` is cached.
has : k -> Cache k e a ->{} Bool
foreign effect has from "flick:Cache" "has"
  arity 1

/// Drops `key`.
invalidate : k -> Cache k e a ->{} Unit
foreign effect invalidate from "flick:Cache" "invalidate"
  arity 1

/// Drops `key` if its value satisfies `f`; whether it did.
invalidate_when : k -> (a -> Bool)^c -> (Cache k e a ->{} Bool)^c
foreign effect invalidate_when from "flick:Cache" "invalidateWhen"
  arity 2
  retention call

/// Looks `key` up again, cached or not, starting its time to live anew.
refresh : k -> Cache k e a ->{Async; e} a
foreign effect refresh from "flick:Cache" "refresh"
  arity 1

/// Drops every key.
invalidate_all : Cache k e a ->{} Unit
foreign effect invalidate_all from "flick:Cache" "invalidateAll"

/// The number of cached keys.
size : Cache k e a ->{} Int
foreign effect size from "flick:Cache" "size"

/// The cached keys.
keys : Cache k e a ->{} List k
foreign effect keys from "flick:Cache" "flickKeys"

/// The values of successful lookups.
values : Cache k e a ->{} List a
foreign effect values from "flick:Cache" "flickValues"

/// The keys and values of successful lookups.
entries : Cache k e a ->{} List (k, a)
foreign effect entries from "flick:Cache" "flickEntries"
