/// Mutable JS arrays, behind runtime operations; a `List` is copied in and
/// out.
module Js.Array exposing (Array, make, from_list, to_list, push, get, set, length)

type Array a

make : Unit ->{} Array a
foreign make from "flick:rt" "jsArrayMake"

from_list : List a ->{} Array a
foreign from_list from "flick:rt" "jsArrayFromList"

to_list : Array a ->{} List a
foreign to_list from "flick:rt" "jsArrayFromList"

push : Array a -> a ->{} Unit
foreign push from "flick:rt" "jsArrayPush"

get : Int -> Array a ->{} Option a
foreign get from "flick:rt" "listGet"

set : Int -> a -> Array a ->{} Unit
foreign set from "flick:rt" "jsArraySet"

length : Array a ->{} Int
foreign length from "flick:rt" "listLength"
