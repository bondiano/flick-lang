/// Effect's `FiberHandle`: at most one child at a time, owned by a `scope`
/// and interrupted when it closes; running another interrupts the last.
/// `join` waits for its failure, so the handle supervises its child.
module FiberHandle exposing (..)

import Fiber

/// A child of region `s` that fails with an error of `e` or gives `a`.
type FiberHandle (s : Region) (e : ErrorRow) a

/// How `set` keeps a child: `onlyIfMissing` leaves a running one;
/// `propagateInterruption` makes an interruption fail `join`.
type alias SetOptions = { onlyIfMissing : Bool; propagateInterruption : Bool }

/// `SetOptions` for `run`; `startImmediately` runs the child before `run`
/// returns.
type alias RunOptions = {
  onlyIfMissing : Bool;
  propagateInterruption : Bool;
  startImmediately : Bool;
}

/// An empty handle owned by the innermost `scope` (or the one of region `s`).
make : Unit ->{Scope s} FiberHandle s e a
foreign effect make from "flick:FiberHandle" "flickMake"
  arity 0
  reviewed "effect@4.1.2 sha256:c6550d9883ffb295"

/// Runs `task` as the child of the handle; it may hold only what outlives
/// the handle's region.
run :
  Fiber.Outlives c s =>
  RunOptions -> (Eff {Scope s | r} e a)^c -> FiberHandle s e a ->{r} Fiber.Fiber e a
foreign effect run from "flick:FiberHandle" "flickRun"
  arity 1
  retention owner
  reviewed "effect@4.1.2 sha256:aca7b90ef702a788"

/// Keeps a child spawned elsewhere as the one of the handle.
set : SetOptions -> Fiber.Fiber e a -> FiberHandle s e a ->{Async} Unit
foreign effect set from "flick:FiberHandle" "flickSet"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:f4cc4630ffda7eae"

/// The child, if one is running.
get : FiberHandle s e a ->{} Option (Fiber.Fiber e a)
foreign effect get from "flick:FiberHandle" "flickGet"
  retention call
  reviewed "effect@4.1.2 sha256:a7a0c777d9a6de40"

/// Interrupts the child and empties the handle.
clear : FiberHandle s e a ->{Async} Unit
foreign effect clear from "flick:FiberHandle" "clear"
  retention call
  reviewed "effect@4.1.2 sha256:7fe537025eeec2f4"

/// Waits until the scope closes or the child fails, and fails as it did.
join : FiberHandle s e a ->{Async; e} Unit
foreign effect join from "flick:FiberHandle" "join"
  retention call
  reviewed "effect@4.1.2 sha256:caaa432c5d4304c0"

/// Waits until no child is running.
await_empty : FiberHandle s e a ->{Async} Unit
foreign effect await_empty from "flick:FiberHandle" "awaitEmpty"
  retention call
  reviewed "effect@4.1.2 sha256:7328e8a70fedd0b0"
