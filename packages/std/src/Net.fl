instance Eq DomainName =
  eq : DomainName -> DomainName -> Bool
  let eq x y = format_domain x == format_domain y

instance Show DomainName =
  show : DomainName -> String
  let show x = format_domain x

/// An IPv6 address with a zone: `fe80::1%eth0`.
type ScopedIpv6Literal

/// The canonical text of the address.
