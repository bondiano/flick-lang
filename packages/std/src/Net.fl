/// An IP socket address or a Unix socket path.
type SocketAddress

/// The canonical text of the address.
format_socket : SocketAddress -> String
foreign pure format_socket from "flick:Net" "flickFormatSocket"

/// The address written in `text`, or why it is not one.
parse_socket : String -> Result SchemaError SocketAddress
