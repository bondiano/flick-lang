/// Network addresses and DNS records, with their JSON codecs. Each kind of
/// address is its own type, holding a parsed value: decoding validates and
/// normalizes the text (`"2001:DB8:0::1"` becomes an address written
/// `2001:db8::1`), and text of another form is a `SchemaError`. Two
/// addresses are equal when their canonical texts are.
module Net exposing (..)

/// A DNS record of any type; `format_record` writes it.
type DnsRecord

/// An IPv4 or IPv6 address: `2001:db8::1`.
type IpAddress

/// The canonical text of the address.
format_ip : IpAddress -> String
foreign pure format_ip from "flick:Net" "flickFormatIp"

/// The address written in `text`, or why it is not one.
parse_ip : String -> Result SchemaError IpAddress
foreign pure parse_ip from "flick:Net" "flickParseIp"

instance Eq IpAddress =
  let eq x y = format_ip x == format_ip y

instance Show IpAddress =
  let show x = format_ip x

/// An IP address with its prefix length: `10.1.2.3/8`.
type IpInterface

/// The canonical text of the address.
format_interface : IpInterface -> String
foreign pure format_interface from "flick:Net" "flickFormatInterface"

/// The address written in `text`, or why it is not one.
parse_interface : String -> Result SchemaError IpInterface
foreign pure parse_interface from "flick:Net" "flickParseInterface"

instance Eq IpInterface =
  let eq x y = format_interface x == format_interface y

instance Show IpInterface =
  let show x = format_interface x

/// An IP network without host bits: `10.0.0.0/8`.
type IpNetwork

/// The canonical text of the address.
format_network : IpNetwork -> String
foreign pure format_network from "flick:Net" "flickFormatNetwork"

/// The address written in `text`, or why it is not one.
parse_network : String -> Result SchemaError IpNetwork
foreign pure parse_network from "flick:Net" "flickParseNetwork"

instance Eq IpNetwork =
  let eq x y = format_network x == format_network y

instance Show IpNetwork =
  let show x = format_network x

/// A MAC address: `aa:bb:cc:dd:ee:ff`.
type MacAddress

/// The canonical text of the address.
format_mac : MacAddress -> String
foreign pure format_mac from "flick:Net" "flickFormatMac"

/// The address written in `text`, or why it is not one.
parse_mac : String -> Result SchemaError MacAddress
foreign pure parse_mac from "flick:Net" "flickParseMac"

instance Eq MacAddress =
  let eq x y = format_mac x == format_mac y

instance Show MacAddress =
  let show x = format_mac x

/// A lowercased domain name: `example.com`.
type DomainName

/// The canonical text of the address.
format_domain : DomainName -> String
foreign pure format_domain from "flick:Net" "flickFormatDomain"

/// The address written in `text`, or why it is not one.
