/// A host and a port: `"example.com:8080"`, `"[::1]:80"`.
host_port : PureCodec Json HostPort
foreign pure host_port from "flick:Net" "flickHostPort"

/// An IP socket address: `"127.0.0.1:80"`, `"[::1]:80"`.
inet_address : PureCodec Json InetAddress
foreign pure inet_address from "flick:Net" "flickInetAddress"

/// An IPv4 socket address: `"127.0.0.1:80"`.
