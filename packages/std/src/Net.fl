foreign pure parse_domain from "flick:Net" "flickParseDomain"

instance Eq DomainName =
  let eq x y = format_domain x == format_domain y

instance Show DomainName =
  let show x = format_domain x

/// An IPv6 address with a zone: `fe80::1%eth0`.
type ScopedIpv6Literal

/// The canonical text of the address.
format_scoped : ScopedIpv6Literal -> String
foreign pure format_scoped from "flick:Net" "flickFormatScoped"

/// The address written in `text`, or why it is not one.
parse_scoped : String -> Result SchemaError ScopedIpv6Literal
foreign pure parse_scoped from "flick:Net" "flickParseScoped"

instance Eq ScopedIpv6Literal =
  let eq x y = format_scoped x == format_scoped y

instance Show ScopedIpv6Literal =
  let show x = format_scoped x

/// An IP address, a scoped IPv6 literal or a domain name.
type Host

/// The canonical text of the address.
format_host : Host -> String
foreign pure format_host from "flick:Net" "flickFormatHost"

/// The address written in `text`, or why it is not one.
