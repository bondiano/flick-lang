/// An IP socket address: `127.0.0.1:80`, `[::1]:80`.
type InetAddress

/// The canonical text of the address.
format_inet : InetAddress -> String
foreign pure format_inet from "flick:Net" "flickFormatInet"

/// The address written in `text`, or why it is not one.
