/// The runner of a program in a browser or a worker:
/// `[project] runner = "Runner.Browser"`. It runs `main` with `()` under the
/// root owner and reports a failure on the console.
module Runner.Browser exposing (Main, run)

/// What `main` of an entry is.
type alias Main = Unit ->{Async; AppError} Unit

/// Starts `main`; the runner of the entry exports what it returns.
run : Main -> Unknown
foreign pure run from "@flick-lang/runtime/runner/browser" "run"
