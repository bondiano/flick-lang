/// Typed SQL for PostgreSQL. A `sql table` block describes a table; a
/// `sql params { … }` block is a checked `Template` whose parameters and
/// result row the compiler infers. Building and binding a query is pure:
/// only `Database.query` talks to the database.
module Sql exposing (..)

import BigDecimal exposing (BigDecimal)

/// The PostgreSQL dialect.
type Pg

/// Whether a column or an expression may be SQL `NULL`.
kind Nullability = NonNull | Nullable

/// What an `INSERT` must give a column: a value, nothing when it has a
/// default, and never a value when the database generates it.
kind Write = Required | Defaulted | Generated

/// A column holding values of `t`.
type Column t (n : Nullability) (w : Write)

/// The table `name` whose columns are the record `cols` of `Column`s.
type Table (name : Symbol) cols

/// The shape of a query with named parameters `p` not yet bound, giving
/// rows `r`.
type Template d p r

/// A query with its parameters bound, giving rows `r`.
type Query d r

/// A parameter its codec could not encode.
type error EncodeError = EncodeError { parameter : String; message : String }
  deriving Eq, Show

/// A response that does not match the query: a column of another SQL
/// type, a value its codec refuses.
type error DecodeError = DecodeError { column : String; message : String }
  deriving Eq, Show

/// What the database or the driver refused, as inert data: the SQLSTATE
/// `code` (empty for a driver failure), the message and the violated
/// constraint, if any.
type error DbError = DbError { code : String; message : String; constraint : Option String }
  deriving Eq, Show

/// The codec of a column whose type is not its SQL type's: `decode` reads
/// a value of the SQL type and may refuse it, `encode` gives one back.
codec : (a -> Result SchemaError b)^c -> (b -> a)^c -> (PureCodec a b)^c
foreign pure codec from "@flick-lang/effect-ts/sql" "sqlCodec"
  arity 2
  retention call

/// Binds the parameters: no I/O.
bind : Template d p r -> p -> Query d r
foreign pure bind from "@flick-lang/effect-ts/sql" "sqlBind"

/// The SQL text of a query, with `$n` placeholders for its parameters.
text : Query d r -> String
foreign pure text from "@flick-lang/effect-ts/sql" "sqlText"

/// The SQL text of a template: the same as of any query bound from it.
template_text : Template d p r -> String
foreign pure template_text from "@flick-lang/effect-ts/sql" "sqlTemplateText"

/// How many parameters a query passes beside its text.
parameter_count : Query d r -> Int
foreign pure parameter_count from "@flick-lang/effect-ts/sql" "sqlParameterCount"

/// A checked SQL identifier: letters, digits and `_`, not starting with a
/// digit, at most 63 bytes. Only an `Identifier` names a table or column in
/// raw SQL; a `String` never does.
type Identifier

identifier : String -> Option Identifier
foreign pure identifier from "@flick-lang/effect-ts/sql" "sqlIdentifier"
  nullable

/// A piece of raw SQL.
type Raw

/// SQL text as written: nothing checks it.
unsafe_text : String -> Raw
foreign pure unsafe_text from "@flick-lang/effect-ts/sql" "sqlRawText"

/// A quoted identifier.
ident : Identifier -> Raw
foreign pure ident from "@flick-lang/effect-ts/sql" "sqlRawIdent"

/// A value passed as a placeholder, encoded to JSON by its codec.
param : PureCodec Json a -> a -> Raw
foreign pure param from "@flick-lang/effect-ts/sql" "sqlRawParam"

/// Raw SQL outside the checked subset, its rows decoded by `decoder`:
/// `int2`, `int4` and floats as numbers, `bool` as booleans, `json` parsed,
/// anything else as its text.
unsafe_query : List Raw -> PureCodec Json a -> Query Pg a
foreign pure unsafe_query from "@flick-lang/effect-ts/sql" "sqlRawQuery"

/// What a `sql table` block compiles to.
make_table : a -> b
foreign pure make_table from "@flick-lang/effect-ts/sql" "sqlTable"

/// What a `sql { … }` block compiles to.
make_template : a -> b
foreign pure make_template from "@flick-lang/effect-ts/sql" "sqlTemplate"

/// A type named without a value: what the methods of `Param` and `Numeric`
/// take, so the code of a query asks them of a type alone.
type Proxy a = Proxy Unit

/// A type a placeholder of a query carries: `a` as the program holds it,
/// `t` as the query compares it. An `Option t` is a `t` that may be
/// `NULL`, cast to its SQL type, as PostgreSQL cannot type `$1 IS NULL`
/// alone. A type of a column with a codec has no instance: a capture of it
/// stands beside its column.
class Param a t | a -> t =
  /// How the runtime passes a value: `number`, `bigint`, `text`, ….
  kind_of : Proxy a -> String
  /// Whether a value may be `NULL`.
  nullable_of : Proxy a -> Bool
  /// What comes before the placeholder: `CAST(` for a value that may be
  /// `NULL`.
  cast_open : Proxy a -> String
  /// What comes after it: ` AS text)`.
  cast_close : Proxy a -> String

instance Param Int Int =
  let kind_of p =
    match p with
    | Proxy _ -> "number"
  let nullable_of p =
    match p with
    | Proxy _ -> false
  let cast_open p =
    match p with
    | Proxy _ -> ""
  let cast_close p =
    match p with
    | Proxy _ -> ""

instance Param (Option Int) Int =
  let kind_of p =
    match p with
    | Proxy _ -> "number"
  let nullable_of p =
    match p with
    | Proxy _ -> true
  let cast_open p =
    match p with
    | Proxy _ -> "CAST("
  let cast_close p =
    match p with
    | Proxy _ -> " AS integer)"

instance Param Float Float =
  let kind_of p =
    match p with
    | Proxy _ -> "number"
  let nullable_of p =
    match p with
    | Proxy _ -> false
  let cast_open p =
    match p with
    | Proxy _ -> ""
  let cast_close p =
    match p with
    | Proxy _ -> ""

instance Param (Option Float) Float =
  let kind_of p =
    match p with
    | Proxy _ -> "number"
  let nullable_of p =
    match p with
    | Proxy _ -> true
  let cast_open p =
    match p with
    | Proxy _ -> "CAST("
  let cast_close p =
    match p with
    | Proxy _ -> " AS double precision)"

instance Param BigInt BigInt =
  let kind_of p =
    match p with
    | Proxy _ -> "bigint"
  let nullable_of p =
    match p with
    | Proxy _ -> false
  let cast_open p =
    match p with
    | Proxy _ -> ""
  let cast_close p =
    match p with
    | Proxy _ -> ""

