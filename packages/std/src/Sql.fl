/// A type `sum` and `avg` of a query take, `s` and `v` the types of their
/// results, each with the cast that gives it.
class Numeric a s v | a -> s v =
  sum_cast : Proxy a -> String
  avg_cast : Proxy a -> String

instance Numeric Int Int Int =
  let sum_cast p =
    match p with
    | Proxy _ -> "::double precision"
  let avg_cast p =
    match p with
    | Proxy _ -> "::double precision"

instance Numeric Float Float Float =
  let sum_cast p =
    match p with
    | Proxy _ -> "::double precision"
  let avg_cast p =
    match p with
    | Proxy _ -> "::double precision"

instance Numeric BigInt BigInt BigDecimal =
  let sum_cast p =
    match p with
    | Proxy _ -> "::bigint"
  let avg_cast p =
    match p with
    | Proxy _ -> "::numeric"

instance Numeric BigDecimal BigDecimal BigDecimal =
  let sum_cast p =
    match p with
    | Proxy _ -> "::numeric"
  let avg_cast p =
    match p with
    | Proxy _ -> "::numeric"
