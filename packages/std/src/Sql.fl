/// Typed SQL for PostgreSQL. A `sql table` block describes a table; a
/// `sql params { … }` block is a checked `Template` whose parameters and
/// result row the compiler infers. Building and binding a query is pure:
/// only `Database.query` talks to the database.
module Sql exposing (..)

/// The PostgreSQL dialect.
type Pg

/// Whether a column or an expression may be SQL `NULL`.
kind Nullability = NonNull | Nullable

/// What an `INSERT` must give a column: a value, nothing when it has a
/// default, and never a value when the database generates it.
kind Write = Required | Defaulted | Generated

/// A column holding values of `t`.
type Column t (n : Nullability) (w : Write)

/// The table `name` whose columns are the record `cols` of `Column`s.
type Table (name : Symbol) cols

/// The shape of a query with named parameters `p` not yet bound, giving
/// rows `r`.
type Template d p r

/// A query with its parameters bound, giving rows `r`.
type Query d r

/// A parameter its codec could not encode.
type error EncodeError = EncodeError { parameter : String; message : String }
  deriving Eq, Show

/// A response that does not match the query: a column of another SQL
/// type, a value its codec refuses.
type error DecodeError = DecodeError { column : String; message : String }
  deriving Eq, Show

/// What the database or the driver refused, as inert data: the SQLSTATE
/// `code` (empty for a driver failure), the message and the violated
/// constraint, if any.
type error DbError = DbError { code : String; message : String; constraint : Option String }
  deriving Eq, Show

/// The codec of a column whose type is not its SQL type's: `decode` reads
/// a value of the SQL type and may refuse it, `encode` gives one back.
codec : forall c a b. (a -> Result SchemaError b)^c -> (b -> a)^c -> (PureCodec a b)^c
foreign pure codec from "@flick-lang/runtime/sql" "sqlCodec"
  arity 2
  retention call

/// Binds the parameters: no I/O.
bind : forall d p r. Template d p r -> p -> Query d r
foreign pure bind from "@flick-lang/runtime/sql" "sqlBind"

/// The SQL text of a query, with `$n` placeholders for its parameters.
text : forall d r. Query d r -> String
foreign pure text from "@flick-lang/runtime/sql" "sqlText"

/// The SQL text of a template: the same as of any query bound from it.
template_text : forall d p r. Template d p r -> String
foreign pure template_text from "@flick-lang/runtime/sql" "sqlTemplateText"

/// How many parameters a query passes beside its text.
parameter_count : forall d r. Query d r -> Int
foreign pure parameter_count from "@flick-lang/runtime/sql" "sqlParameterCount"

/// A checked SQL identifier: letters, digits and `_`, not starting with a
/// digit, at most 63 bytes. Only an `Identifier` names a table or column in
/// raw SQL; a `String` never does.
type Identifier

identifier : String -> Option Identifier
foreign pure identifier from "@flick-lang/runtime/sql" "sqlIdentifier"
  nullable

/// A piece of raw SQL.
type Raw

/// SQL text as written: nothing checks it.
unsafe_text : String -> Raw
foreign pure unsafe_text from "@flick-lang/runtime/sql" "sqlRawText"

/// A quoted identifier.
ident : Identifier -> Raw
foreign pure ident from "@flick-lang/runtime/sql" "sqlRawIdent"

/// A value passed as a placeholder, encoded to JSON by its codec.
param : forall a. PureCodec Json a -> a -> Raw
foreign pure param from "@flick-lang/runtime/sql" "sqlRawParam"

/// Raw SQL outside the checked subset, its rows decoded by `decoder`:
/// `int2`, `int4` and floats as numbers, `bool` as booleans, `json` parsed,
/// anything else as its text.
unsafe_query : forall a. List Raw -> PureCodec Json a -> Query Pg a
foreign pure unsafe_query from "@flick-lang/runtime/sql" "sqlRawQuery"

/// What a `sql table` block compiles to.
make_table : forall a b. a -> b
foreign pure make_table from "@flick-lang/runtime/sql" "sqlTable"

/// What a `sql { … }` block compiles to.
make_template : forall a b. a -> b
foreign pure make_template from "@flick-lang/runtime/sql" "sqlTemplate"
