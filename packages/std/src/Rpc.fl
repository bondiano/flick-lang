/// Typed remote procedure calls, served over HTTP with NDJSON. A procedure
/// is described with codecs, procedures form a group, and the type of the
/// group is the record of handlers it needs, so `listen` takes exactly one
/// handler per procedure and a missing or extra one is a type error naming
/// the procedure. `call` and `call_stream` call a procedure from the same
/// value. The module is experimental.
module Rpc exposing (..)

import Fiber
import Http.Headers
import Http.ServerRequest exposing (ServerRequest)
import Http.ServerResponse exposing (ServerResponse)
import Stdio
import Stream.Core exposing (Stream)

/// A procedure named `l`, whose handler has the type `f`: `p ->{r; e} s`.
/// The handler's errors `e` are those `with_errors` gives a codec: none
/// until then.
type Rpc (l : Symbol) f

/// The typed errors `e` of a procedure, each with its JSON codec:
/// `errors |> error_case (Codec.json NotFound.schema)`.
type ErrorCases (e : ErrorRow)

/// A group whose handlers form the record `hs`; `r` is what the handlers
/// need, together, which serving the group needs.
type Group (r : ServiceRow) hs

/// A running server of region `s`; it stops when the scope that started it
/// closes, after the calls it is serving.
type Server (s : Region)

/// How messages are written on the wire.
type Serialization

/// JSON, one message a line: a stream's elements come as they are sent.
/// The default.
ndjson : Serialization
foreign pure ndjson from "flick:rpc/Rpc" "rpcNdjson"
  reviewed "effect@4.1.2 sha256:c72ee8574fb6c140"

/// One JSON document: over HTTP the messages of a call come together, so a
/// stream's elements come once it ends.
json : Serialization
foreign pure json from "flick:rpc/Rpc" "rpcJson"
  reviewed "effect@4.1.2 sha256:868b3e8b899a14b1"

/// JSON-RPC 2.0 documents, for clients that speak it.
json_rpc : Serialization
foreign pure json_rpc from "flick:rpc/Rpc" "rpcJsonRpc"
  reviewed "effect@4.1.2 sha256:8442484c92ce8133"

/// JSON-RPC 2.0, one message a line.
ndjson_rpc : Serialization
foreign pure ndjson_rpc from "flick:rpc/Rpc" "rpcNdjsonRpc"
  reviewed "effect@4.1.2 sha256:8e90c634696879c6"

/// Binary frames, laid out by the codecs: smaller than JSON, but the other
/// end must be this module or a peer built with the Effect library, and it
/// adds to a bundle.
binary : Serialization
foreign pure binary from "flick:rpc/Rpc" "rpcBinary"
  reviewed "effect@4.1.2 sha256:5d78f3975991bfc4"

/// Where the server listens, the path of its procedures and how it writes
/// its messages.
type alias ServeOptions = {
  host : String;
  port : Float;
  path : String;
  serialization : Serialization;
}

/// `127.0.0.1`, a port the system chooses, `/rpc` and `ndjson`.
defaults : ServeOptions
let defaults = { host = "127.0.0.1"; port = 0; path = "/rpc"; serialization = ndjson }

/// How a client reaches a server.
type Transport

/// A POST per call over fetch: a server of `listen`.
http : Transport
foreign pure http from "flick:rpc/Rpc" "rpcHttp"
  reviewed "effect@4.1.2 sha256:227f4e7f4b1f1c65"

/// The messages of calls over the global WebSocket: a server of
/// `listen_websocket`. Only a program that names it bundles it.
websocket : Transport
foreign pure websocket from "flick:rpc/Rpc" "rpcWebsocket"
  reviewed "effect@4.1.2 sha256:c3de3399064bf5e6"

/// The messages of calls over a TCP connection to `tcp://host:port`, opened
/// on the first call: a server of `listen_tcp`. Node only.
tcp : Transport
foreign pure tcp from "flick:rpc/RpcNode" "rpcTcp"
  reviewed "effect@4.1.2 sha256:c3de3399064bf5e6"

/// How a client writes its messages, as its server does, and how it
/// reaches the server.
type alias CallOptions = { serialization : Serialization; transport : Transport }

/// `ndjson` over `http`.
call_defaults : CallOptions
let call_defaults = { serialization = ndjson; transport = http }

/// The server could not start.
type error ServeError = ServeError String
  deriving Eq, Show

/// A call that could not be sent or whose answer did not decode.
type error ClientError = ClientError String
  deriving Eq, Show

/// A procedure named `l` with no parts yet: its handler takes `Unit` and
/// answers `Unit`.
make : Record.Label l -> Rpc l (Unit ->{r} Unit)
foreign pure make from "flick:rpc/Rpc" "rpcMake"
  reviewed "effect@4.1.2 sha256:04f66df479054dbe"

/// The payload, coded as JSON.
with_payload : PureCodec Json p2 -> Rpc l (p ->{r; e} s) -> Rpc l (p2 ->{r; e} s)
foreign pure with_payload from "flick:rpc/Rpc" "rpcWithPayload"
  arity 2
  reviewed "effect@4.1.2 sha256:04f66df479054dbe"

/// The success, coded as JSON.
with_success : PureCodec Json s2 -> Rpc l (p ->{r; e} s) -> Rpc l (p ->{r; e} s2)
foreign pure with_success from "flick:rpc/Rpc" "rpcWithSuccess"
  arity 2
  reviewed "effect@4.1.2 sha256:04f66df479054dbe"

/// The success as a stream of elements, each coded as JSON and sent as it
/// comes; a failure of the handler fails the stream.
with_stream : PureCodec Json a -> Rpc l (p ->{r; e} s) -> Rpc l (p ->{r; e} Stream none none a)
foreign pure with_stream from "flick:rpc/Rpc" "rpcWithStream"
  arity 2
  reviewed "effect@4.1.2 sha256:60a7d20a9e48db21"

/// No typed error.
errors : ErrorCases none
foreign pure errors from "flick:rpc/Rpc" "rpcErrors"

/// The cases and the error `t`, coded with this codec.
error_case : PureCodec Json t -> ErrorCases e -> ErrorCases {t | e}
foreign pure error_case from "flick:rpc/Rpc" "rpcErrorCase"
  arity 2
  reviewed "effect@4.1.2 sha256:04f66df479054dbe"

/// More typed errors of the handler, each coded as its case says: a
/// handler failing with an error no case has is a type error, not a defect.
with_errors : ErrorCases e2 -> Rpc l (p ->{r; e} s) -> Rpc l (p ->{r; e + e2} s)
foreign pure with_errors from "flick:rpc/Rpc" "rpcWithErrors"
  arity 2
  reviewed "effect@4.1.2 sha256:04f66df479054dbe"

/// What a hook of `with_middleware` gets: the decoded payload and the
/// headers of the call, those of its HTTP request or WebSocket with those
/// `with_headers` added (names in lower case).
type alias Call p = { payload : p; headers : Http.Headers.Headers }

/// Runs `hook` on each call before the handler, after the hooks the
/// procedure has, with the services of `listen`; a typed failure of the hook
/// is answered as one of the handler would be, so it is one of the
/// procedure's errors.
with_middleware : (Call p ->{r; e} Unit) -> Rpc l (p ->{r; e} s) -> Rpc l (p ->{r; e} s)
foreign pure with_middleware from "flick:rpc/Rpc" "rpcWithMiddleware"
  arity 2
  reviewed "effect@4.1.2 sha256:93976e18ef904486"

/// Runs the handler with the service `tag` that `check` makes from each
/// call, after the hooks of `with_middleware`: from its `authorization`
/// header, say. A typed failure of `check` is answered as one of the
/// handler would be, and the handler does not run. Each call has its own,
/// so concurrent callers do not see each other's; over a WebSocket the
/// headers are the connection's. `authenticated` takes the service off
/// what serving the group needs.
with_auth :
  ServiceTag a ->
  (Call p ->{r; e} ServiceImpl a) ->
  Rpc l (p ->{a + r; e} s) ->
  Rpc l (p ->{a + r; e} s)
foreign pure with_auth from "flick:rpc/Rpc" "rpcWithAuth"
  arity 3

/// The server runs the handler to its end even when the client goes away
/// or interrupts the call: for a write that must not stop halfway.
uninterruptible : Rpc l f -> Rpc l f
foreign pure uninterruptible from "flick:rpc/Rpc" "rpcUninterruptible"
  reviewed "effect@4.1.2 sha256:1a4870136a854e0f"

/// A group with no procedures yet.
group : Group r {}
foreign pure group from "flick:rpc/Rpc" "rpcGroup"
  reviewed "effect@4.1.2 sha256:2778a7f9eb6fd7f5"

/// The group, served without the service `tag`: each of its procedures
/// makes it per call with `with_auth`. A procedure without one is a defect
/// when the group is made.
authenticated : ServiceTag a -> Group (a + r) hs -> Group r hs
foreign pure authenticated from "flick:rpc/Rpc" "rpcAuthenticated"
  arity 2

/// The group with the procedure: its handler becomes a field of the group.
add :
  (Record.Lacks l hs, Record.UnionDisjoint hs (Record.Field l (p ->{r; e} s)) out) =>
  Rpc l (p ->{r; e} s) -> Group r hs -> Group r out
foreign pure add from "flick:rpc/Rpc" "rpcAdd"
  arity 2
  reviewed "effect@4.1.2 sha256:2778a7f9eb6fd7f5"

/// Serves the group with these handlers, one per procedure, at `path`,
/// until the scope owning region `s` closes: then it stops accepting, lets
/// the calls it serves finish and runs their finalizers. The handlers run
/// with the services here.
listen :
  Fiber.Provided r s =>
  ServeOptions -> Group r hs -> (hs^c ->{Async, Scope s | r; ServeError} Server s)^c
foreign effect listen from "flick:rpc/RpcNode" "rpcListen"
  arity 3
  retention owner
  reviewed "effect@4.1.2 sha256:96a035f63aca976f"

/// As `listen`, each client a WebSocket at `path` whose messages carry its
/// calls: `ws://127.0.0.1:8080/rpc`. Every serialization streams over it.
listen_websocket :
  Fiber.Provided r s =>
  ServeOptions -> Group r hs -> (hs^c ->{Async, Scope s | r; ServeError} Server s)^c
foreign effect listen_websocket from "flick:rpc/RpcNode" "rpcListenWebsocket"
  arity 3
  retention owner
  reviewed "effect@4.1.2 sha256:95596588ccbf7076"

/// As `listen`, each client a TCP connection to `host` and `port` whose
/// messages carry its calls: `tcp://127.0.0.1:8080`. Only a serialization
/// that frames its messages (`ndjson`, `ndjson_rpc`, `binary`) fits a byte
/// stream; another is `ServeError`. Node only.
listen_tcp :
  Fiber.Provided r s =>
  ServeOptions -> Group r hs -> (hs^c ->{Async, Scope s | r; ServeError} Server s)^c
foreign effect listen_tcp from "flick:rpc/RpcNode" "rpcListenTcp"
  arity 3
  retention owner
  reviewed "effect@4.1.2 sha256:32acbc4cf74e10ac"

/// The port the server listens on: the one asked for, or the one the system
/// chose for port 0.
port : Server s -> Float
foreign pure port from "flick:rpc/RpcNode" "rpcPort"
  retention call
  reviewed "effect@4.1.2 sha256:96a035f63aca976f"

/// The group with these handlers as an HTTP handler, a POST per call, for a
/// route of `Http.Router` beside others: `Http.Router.route (Some POST)
/// "/rpc" (fun request -> rpc request)`. It holds region `s`: when the scope
/// owning it closes, the calls it serves finish and run their finalizers.
handler :
  Fiber.Provided r s =>
  Serialization ->
  Group r hs ->
  (hs^c ->{Scope s | r} (ServerRequest ->{Async} ServerResponse)^{s})^c
foreign effect handler from "flick:rpc/RpcNode" "rpcHandler"
  arity 3
  retention owner
  reviewed "effect@4.1.2 sha256:96a035f63aca976f"

/// As `handler`, each client a WebSocket whose messages carry its calls,
/// for a `GET` route.
handler_websocket :
  Fiber.Provided r s =>
  Serialization ->
  Group r hs ->
  (hs^c ->{Scope s | r} (ServerRequest ->{Async} ServerResponse)^{s})^c
foreign effect handler_websocket from "flick:rpc/RpcNode" "rpcHandlerWebsocket"
  arity 3
  retention owner
  reviewed "effect@4.1.2 sha256:95596588ccbf7076"

/// Calls the procedure at `url` (`http://127.0.0.1:8080/rpc`, or
/// `ws://…` over `websocket`) as `options` says: the success, a declared
/// error as the typed failure, or `ClientError`.
call_with : CallOptions -> String -> Rpc l (p ->{r; e} s) -> p ->{Async; ClientError | e} s
foreign effect call_with from "flick:rpc/Rpc" "rpcCall"
  arity 4
  reviewed "effect@4.1.2 sha256:9e1b2aef57533a72"

/// `call_with call_defaults`.
call : String -> Rpc l (p ->{r; e} s) -> p ->{Async; ClientError | e} s
foreign effect call from "flick:rpc/Rpc" "rpcCallNdjson"
  arity 3
  reviewed "effect@4.1.2 sha256:9e1b2aef57533a72"

/// Calls the stream procedure at `url` writing as `options` says: its
/// elements as they come, a declared error as the stream's failure, or
/// `ClientError`.
call_stream_with :
  CallOptions ->
  String ->
  Rpc l (p ->{r; e} Stream none none a) ->
  p ->
  Stream none {ClientError | e} a
foreign pure call_stream_with from "flick:rpc/Rpc" "rpcCallStream"
  arity 4
  reviewed "effect@4.1.2 sha256:9e1b2aef57533a72"

/// `call_stream_with call_defaults`.
call_stream :
  String -> Rpc l (p ->{r; e} Stream none none a) -> p -> Stream none {ClientError | e} a
foreign pure call_stream from "flick:rpc/Rpc" "rpcCallStreamNdjson"
  arity 3
  reviewed "effect@4.1.2 sha256:9e1b2aef57533a72"

/// A connection to a server that calls share until the scope owning region
/// `s` closes.
type Client (s : Region)

/// Connects to the server at `url` as `options` says, as `call_with` would
/// for one call: a WebSocket stays open, and HTTP keeps its connections
/// alive.
connect : CallOptions -> String ->{Async, Scope s; ClientError} Client s
foreign effect connect from "flick:rpc/Rpc" "rpcConnect"
  arity 2
  reviewed "effect@4.1.2 sha256:c3de3399064bf5e6"

/// Calls the procedure over the connection.
call_on : Client s -> Rpc l (p ->{r; e} x) -> p ->{Async; ClientError | e} x
foreign effect call_on from "flick:rpc/Rpc" "rpcCallOn"
  arity 3
  retention call
  reviewed "effect@4.1.2 sha256:9e1b2aef57533a72"

/// Calls the stream procedure over the connection.
call_stream_on :
  Client s -> Rpc l (p ->{r; e} Stream none none a) -> p -> (Stream none {ClientError | e} a)^{s}
foreign pure call_stream_on from "flick:rpc/Rpc" "rpcCallStreamOn"
  arity 3
  retention owner
  reviewed "effect@4.1.2 sha256:9e1b2aef57533a72"

/// Answers the calls of the messages on stdin on stdout until stdin ends:
/// a program another starts with `spawn`, as editors start language
/// servers. Nothing else may write to stdout meanwhile. Node only.
serve_stdio : Serialization -> Group r hs -> (hs^c ->{Async, Stdio.Stdio | r} Unit)^c
foreign effect serve_stdio from "flick:rpc/RpcNode" "rpcServeStdio"
  arity 3
  retention call
  reviewed "effect@4.1.2 sha256:8aea91f3d781cae8"

/// Starts `command` with `args` and connects to it over its stdin and
/// stdout, which its `serve_stdio` answers; its stderr is the program's.
/// The end of the scope stops it. Node only.
spawn : Serialization -> String -> List String ->{Scope s; ClientError} Client s
foreign effect spawn from "flick:rpc/RpcNode" "rpcSpawn"
  arity 3
  reviewed "effect@4.1.2 sha256:c3de3399064bf5e6"

/// Answers the calls of the page that started this Web Worker until it
/// closes the worker: the program of the module `worker` starts. Messages
/// travel by structured clone, so it takes no serialization.
serve_worker : Group r hs -> (hs^c ->{Async | r} Unit)^c
foreign effect serve_worker from "flick:rpc/Rpc" "rpcServeWorker"
  arity 2
  retention call
  reviewed "effect@4.1.2 sha256:a3c91b37d4a12a3f"

/// Starts a module Web Worker from `url` and connects to it; its
/// `serve_worker` answers. The end of the scope closes it. Browsers only.
worker : String ->{Scope s; ClientError} Client s
foreign effect worker from "flick:rpc/Rpc" "rpcWorker"
  arity 1
  reviewed "effect@4.1.2 sha256:5a2bb17815a939f5"

/// Answers the calls of the thread that started this worker thread until it
/// closes it, as `serve_worker` in a browser. Node only.
serve_node_worker : Group r hs -> (hs^c ->{Async | r} Unit)^c
foreign effect serve_node_worker from "flick:rpc/RpcNode" "rpcServeNodeWorker"
  arity 2
  retention call
  reviewed "effect@4.1.2 sha256:a3c91b37d4a12a3f"

/// Starts a worker thread running the script at `path` with `args` and
/// connects to it; its `serve_node_worker` answers. The end of the scope
/// closes it. Node only.
node_worker : String -> List String ->{Scope s; ClientError} Client s
foreign effect node_worker from "flick:rpc/RpcNode" "rpcNodeWorker"
  arity 2
  reviewed "effect@4.1.2 sha256:5a2bb17815a939f5"

/// Runs `task` with its calls carrying the headers too, which the hooks of
/// `with_middleware` read: `authorization`, say.
with_headers : Http.Headers.Input -> (Eff r e a)^c ->{r; e} a
foreign effect with_headers from "flick:rpc/Rpc" "rpcWithHeaders"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:dcacf8ec37486efd"

/// Calls the procedure of the group in memory, client and server joined
/// without a transport: for tests of the handlers. The codecs do not run,
/// so this does not test them; the hooks of `with_middleware` see no
/// headers.
call_local : Group r hs -> hs^c -> Rpc l (p ->{r; e} s) -> p ->{r; e} s
foreign effect call_local from "flick:rpc/Rpc" "rpcCallLocal"
  arity 4
  retention call
  reviewed "effect@4.1.2 sha256:e7f8fc6a44cc917c"

/// Calls the stream procedure of the group in memory, as `call_local`.
call_stream_local :
  Group r hs -> hs^c -> Rpc l (p ->{r; e} Stream none none a) -> p -> (Stream r e a)^c
foreign pure call_stream_local from "flick:rpc/Rpc" "rpcCallStreamLocal"
  arity 4
  retention owner
  reviewed "effect@4.1.2 sha256:e7f8fc6a44cc917c"
