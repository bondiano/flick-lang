/// A differ gives the difference of two values as a patch `p`, and applies
/// a patch to a value. `json_patch` makes one from a codec.
module Differ exposing (..)

/// Computes, combines and applies patches `p` of values `a`.
type Differ a p

/// The patches of the values' JSON form, as an RFC 6902 JSON Patch.
json_patch : PureCodec Json a -> Differ a Json
foreign pure json_patch from "flick:Schema" "toDifferJsonPatch"

/// The patch that changes nothing.
empty : Differ a p -> p
foreign pure empty from "flick:Differ" "flickEmpty"

/// The patch from `old` to `new`.
diff : a -> a -> Differ a p -> p
foreign pure diff from "flick:Differ" "flickDiff"

/// The first patch, then the second.
combine : p -> p -> Differ a p -> p
foreign pure combine from "flick:Differ" "flickCombine"

/// The value with the patch applied; a patch that does not fit is a defect.
patch : a -> p -> Differ a p -> a
foreign pure patch from "flick:Differ" "flickPatch"
