/// An asynchronous queue of messages between tasks. `Queue e a` carries
/// messages of `a` and may be failed with an error of `e`; once it is
/// ended, takes drain what is left and then give `None`.
module Queue exposing (..)

/// A queue of messages of `a` that may fail with an error of `e`.
type Queue (e : ErrorRow) a

/// What `offer` does when a bounded queue is full: wait for room, drop the
/// new message, or drop the oldest one.
type Strategy = Suspend | Dropping | Sliding

/// A queue of `capacity` messages (`None`: unbounded) with the strategy
/// for a full queue (`None`: `Suspend`).
make : { capacity : Option Int; strategy : Option Strategy } ->{} Queue e a
foreign effect make from "flick:Queue" "flickMake"

/// A queue of `capacity` messages whose `offer` waits for room.
bounded : Int ->{} Queue e a
foreign effect bounded from "flick:Queue" "bounded"

/// A queue of `capacity` messages that drops the oldest to make room.
sliding : Int ->{} Queue e a
foreign effect sliding from "flick:Queue" "sliding"

/// A queue of `capacity` messages that drops new ones while full.
dropping : Int ->{} Queue e a
foreign effect dropping from "flick:Queue" "dropping"

/// A queue without a bound.
unbounded : Unit ->{} Queue e a
foreign effect unbounded from "flick:Queue" "unbounded"
  arity 0

/// Adds `message`, waiting for room in a full `Suspend` queue; whether it
/// was added.
offer : a -> Queue e a ->{Async} Bool
foreign effect offer from "flick:Queue" "offer"
  arity 1

/// Adds the messages in order; the ones that were not added.
offer_all : List a -> Queue e a ->{Async} List a
foreign effect offer_all from "flick:Queue" "offerAll"
  arity 1

/// Fails the queue with `error`: takes drain what is left, then fail with
/// it. Whether this call ended the queue.
fail : Errors e -> Queue e a ->{} Bool
foreign effect fail from "flick:Queue" "fail"
  arity 1

/// Fails the queue with the whole cause of `failure`.
fail_cause : Failure e -> Queue e a ->{} Bool
foreign effect fail_cause from "flick:Queue" "flickFailCause"
  arity 1

/// Ends the queue: takes drain what is left, then give `None`. Whether
/// this call ended it.
end : Queue e a ->{} Bool
foreign effect end from "flick:Queue" "end"

/// Stops taking offers; once what is left is drained, the queue ends with
/// an interruption.
interrupt : Queue e a ->{} Bool
foreign effect interrupt from "flick:Queue" "interrupt"

/// Ends the queue at once, dropping what is left and interrupting the
/// tasks that wait on it.
shutdown : Queue e a ->{} Bool
foreign effect shutdown from "flick:Queue" "shutdown"

/// Takes every message there is, without waiting.
clear : Queue e a ->{; e} List a
foreign effect clear from "flick:Queue" "clear"

/// Takes every message there is, waiting for at least one; `None` once the
/// queue has ended.
take_all : Queue e a ->{Async; e} Option (NonEmpty.NonEmpty a)
foreign effect take_all from "flick:Queue" "flickTakeAll"

/// Takes messages until the queue ends.
collect : Queue e a ->{Async; e} List a
foreign effect collect from "flick:Queue" "collect"

/// Takes `n` messages, waiting for them, or what is left of an ended
/// queue; `None` once it is empty.
take_n : Int -> Queue e a ->{Async; e} Option (List a)
foreign effect take_n from "flick:Queue" "flickTakeN"
  arity 1

/// Takes at least `min` and at most `max` messages, as `take_n` does.
take_between : Int -> Int -> Queue e a ->{Async; e} Option (List a)
foreign effect take_between from "flick:Queue" "flickTakeBetween"
  arity 2

/// Takes the next message, waiting for one; `None` once the queue has
/// ended.
take : Queue e a ->{Async; e} Option a
foreign effect take from "flick:Queue" "flickTake"

/// Takes the next message if there is one, without waiting.
poll : Queue e a ->{} Option a
foreign effect poll from "flick:Queue" "poll"

/// The next message without taking it, waiting for one; `None` once the
/// queue has ended.
peek : Queue e a ->{Async; e} Option a
foreign effect peek from "flick:Queue" "flickPeek"

/// Wakes the tasks waiting to take now, instead of at the queue's next
/// scheduled release.
flush : Queue e a ->{} Unit
foreign effect flush from "flick:Queue" "flush"

/// Waits until the queue has ended; fails if it was failed.
await_ : Queue e a ->{Async; e} Unit
foreign effect await_ from "flick:Queue" "await"

/// The number of messages in the queue.
size : Queue e a ->{} Int
foreign effect size from "flick:Queue" "size"

/// Whether the queue is at its capacity.
is_full : Queue e a ->{} Bool
foreign effect is_full from "flick:Queue" "isFull"

/// Runs `task` and then ends `queue`, or fails it as the task failed:
/// `task |> Queue.into queue`.
into : Queue e a -> (Eff r e x)^c ->{r} Bool
foreign effect into from "flick:Queue" "into"
  arity 1
  retention call
