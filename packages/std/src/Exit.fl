/// How a computation ended, as `parallel_exits` and `Effect.exit` give it:
/// its value or a `Failure`. A typed failure, a defect and an interruption
/// stay apart; a defect is read only as inert text.
module Exit exposing (..)

/// The value of a success.
value : Exit e a -> Option a
foreign pure value from "flick:rt" "exitValue"

/// The failure of an exit that did not succeed.
failure : Exit e a -> Option (Failure e)
foreign pure failure from "flick:rt" "exitFailure"

/// A success with the value.
succeed : a -> Exit e a
foreign pure succeed from "flick:Exit" "flickSucceed"

/// A typed failure with `error`.
fail : Errors e -> Exit e a
foreign pure fail from "flick:Exit" "flickFail"

/// A failure with the whole cause of `failure`.
fail_cause : Failure e -> Exit e a
foreign pure fail_cause from "flick:Exit" "flickFailCause"

/// A defect with the message.
die : String -> Exit e a
foreign pure die from "flick:Exit" "flickDie"

/// An interruption, by the fiber of the id if one is given.
interrupt : Option Float -> Exit e a
foreign pure interrupt from "flick:Exit" "flickInterrupt"

/// A success with `()`.
void : Exit e Unit
foreign pure void from "flick:Exit" "flickVoid"

/// Whether it succeeded.
is_success : Exit e a -> Bool
foreign pure is_success from "flick:Exit" "flickIsSuccess"

/// Whether it failed, however.
is_failure : Exit e a -> Bool
foreign pure is_failure from "flick:Exit" "flickIsFailure"

/// Whether its failure holds a typed failure.
has_fails : Exit e a -> Bool
foreign pure has_fails from "flick:Exit" "flickHasFails"

/// Whether its failure holds a defect.
has_dies : Exit e a -> Bool
foreign pure has_dies from "flick:Exit" "flickHasDies"

/// Whether its failure holds an interruption.
has_interrupts : Exit e a -> Bool
foreign pure has_interrupts from "flick:Exit" "flickHasInterrupts"

/// `Ok` of a success, `Err` of a failed exit.
filter_success : Exit e a -> Result (Exit e a) (Exit e a)
foreign pure filter_success from "flick:Exit" "flickFilterSuccess"

/// The value of a success, or the failed exit.
filter_value : Exit e a -> Result (Exit e a) a
foreign pure filter_value from "flick:Exit" "flickFilterValue"

/// `Ok` of a failed exit, `Err` of a success.
filter_failure : Exit e a -> Result (Exit e a) (Exit e a)
foreign pure filter_failure from "flick:Exit" "flickFilterFailure"

/// The failure of a failed exit, or the success.
filter_cause : Exit e a -> Result (Exit e a) (Failure e)
foreign pure filter_cause from "flick:Exit" "flickFilterCause"

/// The first typed error, or the exit without one.
find_error : Exit e a -> Result (Exit e a) (Errors e)
foreign pure find_error from "flick:Exit" "flickFindError"

/// The first typed error, if any.
find_error_option : Exit e a -> Option (Errors e)
foreign pure find_error_option from "flick:Exit" "flickFindErrorOption"

/// The first defect as inert text, or the exit without one.
find_defect : Exit e a -> Result (Exit e a) String
foreign pure find_defect from "flick:Exit" "flickFindDefect"

/// `on_success` of the value or `on_failure` of the failure.
match_ : (a -> b)^c -> (Failure e -> b)^c -> (Exit e a -> b)^c
foreign pure match_ from "flick:Exit" "flickMatch"
  arity 2
  retention call

/// The value of a success changed by `f`.
map : (a -> b)^c -> Exit e a -> Exit e b
foreign pure map from "flick:Exit" "flickMap"
  arity 1
  retention call

/// The typed errors changed by `f`.
map_error : (Errors e -> Errors e2)^c -> Exit e a -> Exit e2 a
foreign pure map_error from "flick:Exit" "flickMapError"
  arity 1
  retention call

/// The typed errors changed by `on_failure`, the value by `on_success`.
map_both : (Errors e -> Errors e2)^c -> (a -> b)^c -> (Exit e a -> Exit e2 b)^c
foreign pure map_both from "flick:Exit" "flickMapBoth"
  arity 2
  retention call

/// The exit with `()` for its value.
as_void : Exit e a -> Exit e Unit
foreign pure as_void from "flick:Exit" "flickAsVoid"

/// A success if every exit succeeded, else the failures of all of them.
as_void_all : List (Exit e a) -> Exit e Unit
foreign pure as_void_all from "flick:Exit" "flickAsVoidAll"
