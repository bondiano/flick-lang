/// When an effect is repeated or retried, with what delay, and what each
/// step outputs. `Schedule r e i o` takes inputs `i` (the values of a
/// repeat, the errors of a retry), outputs `o`, and its callbacks need `r`
/// and fail with `e`. `Effect.repeat` and `Effect.retry` run a task by a
/// schedule.
module Schedule exposing (..)

import Cron
import Duration

type Schedule (r : ServiceRow) (e : ErrorRow) i o

/// What a callback of a schedule sees of the step it decides.
type alias InputMetadata i = {
  input : i;
  attempt : Int;
  start : Float;
  now : Float;
  elapsed : Float;
  elapsedSincePrevious : Float;
}

/// A step's metadata with its output and the delay chosen.
type alias Metadata o i = {
  input : i;
  output : o;
  duration : Duration.Duration;
  attempt : Int;
  start : Float;
  now : Float;
  elapsed : Float;
  elapsedSincePrevious : Float;
}

/// Recurs forever, `n` counting the recurrences from 0, without a delay.
forever : Schedule none none i Int
foreign pure forever from "flick:Schedule" "forever"

/// Recurs once, without a delay.
once : Schedule none none i Unit
foreign pure once from "flick:Schedule" "once"

/// Recurs forever, outputting its input.
identity : Unit -> Schedule none none a a
foreign pure identity from "flick:Schedule" "identity"
  arity 0

/// Recurs `times` times, outputting the count.
recurs : Int -> Schedule none none i Int
foreign pure recurs from "flick:Schedule" "recurs"

/// Recurs forever, each step the duration after the previous one ended.
spaced : Duration.Duration -> Schedule none none i Int
foreign pure spaced from "flick:Schedule" "spaced"

/// Recurs on a fixed interval from the start, whatever each step took.
fixed : Duration.Duration -> Schedule none none i Int
foreign pure fixed from "flick:Schedule" "fixed"

/// Recurs at the ends of consecutive windows of the interval.
windowed : Duration.Duration -> Schedule none none i Int
foreign pure windowed from "flick:Schedule" "windowed"

/// Recurs once after the duration, outputting it.
duration : Duration.Duration -> Schedule none none i Duration.Duration
foreign pure duration from "flick:Schedule" "duration"

/// Recurs without a delay while less than the duration has passed,
/// outputting the time elapsed.
during : Duration.Duration -> Schedule none none i Duration.Duration
foreign pure during from "flick:Schedule" "during"

/// Delays `base * factor ^ n`, outputting the delay.
exponential : Duration.Duration -> Float -> Schedule none none i Duration.Duration
foreign pure exponential from "flick:Schedule" "exponential"
  arity 2

/// Delays that sum the two before them, starting from `one`.
fibonacci : Duration.Duration -> Schedule none none i Duration.Duration
foreign pure fibonacci from "flick:Schedule" "fibonacci"

/// Each delay of the schedule scaled by a random factor in [0.8, 1.2].
jittered : Schedule r e i o -> Schedule r e i o
foreign pure jittered from "flick:Schedule" "jittered"

/// The schedule's steps, outputting the inputs.
passthrough : Schedule r e i o -> Schedule r e i i
foreign pure passthrough from "flick:Schedule" "passthrough"

/// `concat second first` runs `first` to completion, then `second`.
concat : Schedule r2 e2 i o -> Schedule r1 e1 i o -> Schedule (r1 + r2) (e1 + e2) i o
foreign pure concat from "flick:Schedule" "concat"
  arity 1

/// `concat`, telling the outputs apart: `Err` of the first, `Ok` of the second.
concat_result :
  Schedule r2 e2 i o2 -> Schedule r1 e1 i o1 -> Schedule (r1 + r2) (e1 + e2) i (Result o1 o2)
foreign pure concat_result from "flick:Schedule" "concatResult"
  arity 1

/// Recurs while all of them do, with the longest of their delays.
max : NonEmpty.NonEmpty (Schedule r e i o) -> Schedule r e i Duration.Duration
foreign pure max from "flick:Schedule" "max"

/// Recurs while any of them does, with the shortest of their delays.
min : NonEmpty.NonEmpty (Schedule r e i o) -> Schedule r e i Duration.Duration
foreign pure min from "flick:Schedule" "min"

/// Stops after the duration has elapsed or the number of outputs, whichever
/// comes first; `None` leaves that bound out.
up_to :
  { duration : Option Duration.Duration; times : Option Int } ->
  Schedule r e i o ->
  Schedule r e i o
foreign pure up_to from "flick:Schedule" "flickUpTo"
  arity 1

/// Each output mapped by `f`, which sees the step's metadata.
map : (Metadata o i ->{r2; e2} o2) -> Schedule r e i o -> Schedule (r + r2) (e + e2) i o2
foreign pure map from "flick:Schedule" "map"
  arity 1

/// Runs `f` on each step, keeping inputs and outputs.
tap : (Metadata o i ->{r2; e2} x) -> Schedule r e i o -> Schedule (r + r2) (e + e2) i o
foreign pure tap from "flick:Schedule" "tap"
  arity 1

/// Recurs only while `f` holds for the step.
while : (Metadata o i ->{r2; e2} Bool) -> Schedule r e i o -> Schedule (r + r2) (e + e2) i o
foreign pure while from "flick:Schedule" "while"
  arity 1

/// Adds the duration `f` computes to each delay.
add_delay :
  (Metadata o i ->{r2; e2} Duration.Duration) -> Schedule r e i o -> Schedule (r + r2) (e + e2) i o
foreign pure add_delay from "flick:Schedule" "addDelay"
  arity 1

/// Replaces each delay by the duration `f` computes.
modify_delay :
  (Metadata o i ->{r2; e2} Duration.Duration) -> Schedule r e i o -> Schedule (r + r2) (e + e2) i o
foreign pure modify_delay from "flick:Schedule" "modifyDelay"
  arity 1

/// Inside an effect a schedule repeats: the metadata of the current step.
current_metadata : Unit ->{} Metadata JsValue JsValue
foreign effect current_metadata from "flick:Schedule" "flickCurrentMetadata"
  arity 0

/// Recurs at each date-time the cron matches, outputting the delay until it.
cron : Cron.Cron -> Schedule none none i Duration.Duration
foreign pure cron from "flick:Schedule" "cron"
