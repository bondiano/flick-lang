/// Traversals of graphs as walkers, read with `indices`, `values` and
/// `entries`. A start node that is missing or an invalid radius is a
/// `GraphError`.
private module Graph.Walk exposing (..)

import Graph.Types exposing (..)

/// Depth-first from `start` (default: nothing), along `direction` (default
/// outgoing), at most `radius` steps.
dfs : SearchConfig -> Graph n e k -> Result GraphError (NodeWalker n)
foreign pure dfs from "flick:Graph" "flickDfs"

/// Breadth-first, as `dfs` is depth-first.
bfs : SearchConfig -> Graph n e k -> Result GraphError (NodeWalker n)
foreign pure bfs from "flick:Graph" "flickBfs"

/// Depth-first, each node after the nodes it leads to.
dfs_post_order : SearchConfig -> Graph n e k -> Result GraphError (NodeWalker n)
foreign pure dfs_post_order from "flick:Graph" "flickDfsPostOrder"

/// Each node before the nodes it leads to, from `initials` (default: the
/// nodes without incoming edges); a cycle, or an initial node with incoming
/// edges, is an error.
topo : TopoConfig -> Graph n e Directed -> Result GraphError (NodeWalker n)
foreign pure topo from "flick:Graph" "flickTopo"

/// Every node, in index order.
nodes : Graph n e k -> NodeWalker n
foreign pure nodes from "flick:Graph" "nodes"

/// Every edge, in index order.
edges : Graph n e k -> EdgeWalker e
foreign pure edges from "flick:Graph" "edges"

/// The nodes without edges in the direction (default outgoing).
externals : ExternalsConfig -> Graph n e k -> NodeWalker n
foreign pure externals from "flick:Graph" "flickExternals"

/// The indices a walker visits, in order.
indices : Walker t a -> List t
foreign pure indices from "flick:Graph" "flickIndices"

/// The data a walker visits, in order.
values : Walker t a -> List a
foreign pure values from "flick:Graph" "flickValues"

/// The index and data of each visit, in order.
entries : Walker t a -> List (t, a)
foreign pure entries from "flick:Graph" "flickEntries"
