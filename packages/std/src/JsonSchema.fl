/// JSON Schema documents of other dialects read into draft 2020-12 and
/// written back. A schema is a `Json` value: decode the text of
/// `Codec.json_schema` with `Json.json` to get one.
module JsonSchema exposing (..)

/// A JSON Schema, a JSON value.
type alias JsonSchema = Json

/// The named schemas a document refers to, a JSON object.
type alias Definitions = Json

/// A schema, `root` (`schema` in the JS object), and its definitions in a
/// dialect: `"draft-2020-12"`, `"draft-07"`, `"draft-04"`, `"openapi-3.1"`
/// or `"openapi-3.0"`.
type alias Document = { dialect : String; root : JsonSchema; definitions : Definitions }

/// Several schemas sharing their definitions.
type alias MultiDocument = {
  dialect : String;
  schemas : NonEmpty.NonEmpty JsonSchema;
  definitions : Definitions;
}

/// The `$schema` URI of draft-04.
meta_schema_uri_draft_04 : String
foreign pure meta_schema_uri_draft_04 from "flick:JsonSchema" "META_SCHEMA_URI_DRAFT_04"
  reviewed "effect@4.1.2 sha256:fd4f94453a0d822f"

