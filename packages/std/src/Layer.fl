/// Layers build services from their dependencies: `Layer inputs errors outputs`.
/// `provide layer { body }` builds one for a body; the functions here make,
/// combine and build layers as values. The span layers are in `Layer.Trace`.
module Layer exposing (..)

/// Built services: the implementations of the services of `r`, as a layer
/// builds them (`build`) or as `Context` puts them together.
type Context (r : ServiceRow)

/// What a build shares: each layer built through one memo map is built
/// once, and its services are shared by every layer that needs them.
type MemoMap

/// The service of `tag` implemented by `impl`.
succeed : ServiceTag r -> ServiceImpl r -> Layer none none r
foreign pure succeed from "flick:rt" "layerSucceed"

@lang layer_merge
/// Both layers' services; they must not build the same service.
merge : Layer i1 e1 o1 -> Layer i2 e2 o2 -> Layer (i1 + i2) (e1 + e2) (o1 + o2)
foreign pure merge from "flick:rt" "layerMerge"

/// Both layers' services; the second replaces what the first builds too.
override : Layer i1 e1 o1 -> Layer i2 e2 o2 -> Layer (i1 + i2) (e1 + e2) (o1 + o2)
foreign pure override from "flick:rt" "layerOverride"

/// A layer that builds nothing.
empty : Layer none none none
foreign pure empty from "flick:Layer" "empty"

/// The services of a `Context`, as they are.
succeed_context : Context r -> Layer none none r
foreign pure succeed_context from "flick:Layer" "succeedContext"

/// The service `make` returns, called when the layer is built.
sync : ServiceTag r -> (Unit -> ServiceImpl r) -> Layer none none r
foreign pure sync from "flick:Layer" "sync"
  arity 1

/// The services of the `Context` that `make` returns when the layer is built.
sync_context : (Unit -> Context r) -> Layer none none r
foreign pure sync_context from "flick:Layer" "syncContext"

/// The service `make` computes when the layer is built; what it acquires
/// is released with the owner of the `provide`.
effect : ServiceTag r -> Eff ri e (ServiceImpl r) -> Layer ri e r
foreign pure effect from "flick:Layer" "effect"
  arity 1

/// The services of the `Context` that `make` computes when the layer is built.
effect_context : Eff ri e (Context r) -> Layer ri e r
foreign pure effect_context from "flick:Layer" "effectContext"

/// Runs `task` when the layer is built, and builds no service.
effect_discard : Eff ri e a -> Layer ri e none
foreign pure effect_discard from "flick:Layer" "effectDiscard"

/// The layer `make` returns, made when it is built.
suspend : (Unit -> Layer ri e ro) -> Layer ri e ro
foreign pure suspend from "flick:Layer" "suspend"

/// The layer `task` computes when it is built.
unwrap : Eff r e (Layer ri e2 ro) -> Layer (r + ri) (e + e2) ro
foreign pure unwrap from "flick:Layer" "unwrap"

/// The services of `first` and every layer of `rest`; a later one replaces
/// what an earlier one builds too.
merge_all : Layer ri e ro -> List (Layer ri e ro) -> Layer ri e ro
foreign pure merge_all from "flick:Layer" "flickMergeAll"

@lang layer_run
/// Runs `body` with the services `layer` builds, which last until it ends;
/// `provide layer { body }` stands for it. `layer` is built once for the run.
run : Layer ri e ro -> (Unit ->{ro + r; e2} a) ->{ri + r; e + e2} a
foreign effect run from "flick:rt" "layerRun"

/// `layer` with the services `deps` builds given to it: `layer` needs all
/// of them, and the result needs the rest of its inputs and those of `deps`.
provide_ : Layer ri2 e2 ro2 -> Layer (ro2 + ri) e ro -> Layer (ri + ri2) (e + e2) ro
foreign pure provide_ from "flick:Layer" "provide"
  arity 1

/// `provide_`, keeping the services of `deps` in the output too.
provide_merge : Layer ri2 e2 ro2 -> Layer (ro2 + ri) e ro -> Layer (ri + ri2) (e + e2) (ro + ro2)
foreign pure provide_merge from "flick:Layer" "provideMerge"
  arity 1

/// The layer `f` makes from the services `layer` built.
flat_map : (Context ro -> Layer ri2 e2 ro2) -> Layer ri e ro -> Layer (ri + ri2) (e + e2) ro2
foreign pure flat_map from "flick:Layer" "flatMap"
  arity 1

/// Runs `f` on the services once `layer` built them.
tap : (Context ro ->{ri2; e2} a) -> Layer ri e ro -> Layer (ri + ri2) (e + e2) ro
foreign pure tap from "flick:Layer" "tap"
  arity 1

/// Runs `f` on the error when the build of `layer` fails, which still fails.
tap_error : (Errors e ->{ri2; e2} a) -> Layer ri e ro -> Layer (ri + ri2) (e + e2) ro
foreign pure tap_error from "flick:Layer" "tapError"
  arity 1

/// Runs `f` on how the build of `layer` failed, defects included.
tap_cause : (Failure e ->{ri2; e2} a) -> Layer ri e ro -> Layer (ri + ri2) (e + e2) ro
foreign pure tap_cause from "flick:Layer" "flickTapCause"
  arity 1

/// The failures of `layer`'s build as defects.
or_die : Layer ri e ro -> Layer ri none ro
foreign pure or_die from "flick:Layer" "orDie"

/// When the build of `layer` fails, the layer `f` makes from the error.
catch : (Errors e -> Layer ri2 e2 ro) -> Layer ri e ro -> Layer (ri + ri2) e2 ro
foreign pure catch from "flick:Layer" "catch"
  arity 1

/// When the build of `layer` fails or dies, the layer `f` makes from how.
catch_cause : (Failure e -> Layer ri2 e2 ro) -> Layer ri e ro -> Layer (ri + ri2) e2 ro
foreign pure catch_cause from "flick:Layer" "flickCatchCause"
  arity 1

/// `layer` built with the service of `tag` changed by `f`, which the result
/// needs.
update_service :
  ServiceTag r -> (ServiceImpl r -> ServiceImpl r) -> Layer ri e ro -> Layer (r + ri) e ro
foreign pure update_service from "flick:Layer" "updateService"
  arity 2

/// `layer`, built anew each time instead of shared with other uses.
fresh : Layer ri e ro -> Layer ri e ro
foreign pure fresh from "flick:Layer" "fresh"

/// Builds `layer` and keeps its services until the call is interrupted:
/// an application made of layers, such as a server.
launch : Layer ri e ro ->{Async | ri; e} Never
foreign effect launch from "flick:Layer" "launch"

/// Builds `layer` into the owner of region `s`, which releases what it
/// acquired when it closes.
build : Layer ri e ro ->{Scope s | ri; e} Context ro
foreign effect build from "flick:Layer" "build"

/// `build` sharing what `memo` already built.
build_with_memo_map : MemoMap -> Layer ri e ro ->{Scope s | ri; e} Context ro
foreign effect build_with_memo_map from "flick:Layer" "flickBuildWithMemoMap"
  arity 1

/// A new, empty memo map.
make_memo_map : Unit ->{} MemoMap
foreign effect make_memo_map from "flick:Layer" "flickMakeMemoMap"

/// A memo map that sees what `parent` built; what it builds itself stays
/// its own.
fork_memo_map : MemoMap ->{} MemoMap
foreign effect fork_memo_map from "flick:Layer" "forkMemoMap"

/// The memo map of the layer being built, forked, or a new one.
current_memo_map : Unit ->{} MemoMap
foreign effect current_memo_map from "flick:Layer" "flickCurrentMemoMap"

/// A layer whose build is `f`: it gets the memo map of the build and runs
/// in the owner the services are built into.
from_build : (forall s. MemoMap ->{Scope s | ri; e} Context ro) -> Layer ri e ro
foreign pure from_build from "flick:Layer" "flickFromBuild"

/// `from_build`, built once per memo map like any other layer.
from_build_memo : (forall s. MemoMap ->{Scope s | ri; e} Context ro) -> Layer ri e ro
foreign pure from_build_memo from "flick:Layer" "flickFromBuildMemo"
