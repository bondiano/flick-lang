foreign pure json_utc_millis from "@flick-lang/runtime/effect/DateTime" "flickJsonUtcMillis"
  reviewed "effect@4.1.2 sha256:051d69ddbcb03e32"

/// A zoned date-time as JSON text: `"2024-01-01T09:00:00.000+01:00[Europe/Paris]"`.
