/// Instants with an optional time zone: Effect's `DateTime`. A date-time is
/// UTC or zoned; constructors and zone changes are checked and fail with
/// `DateTimeError`, never with a raw Effect error.
module DateTime exposing (..)

import Duration
import Layer

/// An instant, in UTC or in a time zone.
type DateTime

/// A named zone (`Europe/Paris`) or a fixed offset from UTC.
type TimeZone

/// Why a date-time or a zone could not be made, placed or formatted.
type error DateTimeError = DateTimeError String
  deriving Eq, Show

/// Which instant a wall-clock time means when a zone skips or repeats it.
type Disambiguation = Compatible | Earlier | Later | Reject

/// The units of `add`, `start_of` and the others.
type TimeUnit = Millisecond | Second | Minute | Hour | Day | Week | Month | Year

/// The parts of a date-time; `weekDay` counts from Sunday, 0.
type alias Parts = {
  millisecond : Int;
  second : Int;
  minute : Int;
  hour : Int;
  day : Int;
  weekDay : Int;
  month : Int;
  year : Int;
}

/// Some of the parts; `None` keeps a part as it is.
type alias PartialParts = {
  millisecond : Option Int;
  second : Option Int;
  minute : Option Int;
  hour : Option Int;
  day : Option Int;
  weekDay : Option Int;
  month : Option Int;
  year : Option Int;
}

/// How to place a date-time in a zone: keep the instant (the default) or,
/// with `adjustForTimeZone`, keep the wall-clock time.
type alias ZoneOptions = { adjustForTimeZone : Option Bool; disambiguation : Option Disambiguation }

/// `Intl.DateTimeFormat` options: a locale, and `"full"`, `"long"`,
/// `"medium"` or `"short"` styles.
type alias FormatOptions = {
  locale : Option String;
  dateStyle : Option String;
  timeStyle : Option String;
}

/// No part at all, to update: `{ DateTime.no_parts with hour = Some 9 }`.
no_parts : PartialParts
let no_parts = {
  millisecond = None;
  second = None;
  minute = None;
  hour = None;
  day = None;
  weekDay = None;
  month = None;
  year = None;
}

/// The time zone a program runs in; `layer_current_zone` provides it.
service CurrentTimeZone =
  current_zone : Unit ->{} TimeZone

/// Parses an ISO date-time; a string without an offset is read as UTC.
make : String -> Result DateTimeError DateTime
foreign pure make from "@flick-lang/runtime/effect/DateTime" "flickMake"
  reviewed "effect@4.1.2 sha256:0f92e12e08d886ef"

/// The UTC date-time of the given parts, the others from 1970-01-01.
from_parts : PartialParts -> Result DateTimeError DateTime
foreign pure from_parts from "@flick-lang/runtime/effect/DateTime" "flickFromParts"
  reviewed "effect@4.1.2 sha256:0f92e12e08d886ef"

/// The UTC date-time `n` seconds after 1970-01-01.
from_epoch_seconds : Float -> Result DateTimeError DateTime
foreign pure from_epoch_seconds from "@flick-lang/runtime/effect/DateTime" "flickFromEpochSeconds"
  reviewed "effect@4.1.2 sha256:9efb17052ac67760"

/// The date-time placed in the zone.
make_zoned : ZoneOptions -> TimeZone -> DateTime -> Result DateTimeError DateTime
foreign pure make_zoned from "@flick-lang/runtime/effect/DateTime" "flickMakeZoned"
  reviewed "effect@4.1.2 sha256:02098c7c6d38ba3f"

/// Parses `2024-03-10T09:00:00.000+01:00[Europe/Paris]` or an ISO string
/// with an offset.
make_zoned_from_string : String -> Result DateTimeError DateTime
foreign pure make_zoned_from_string from "@flick-lang/runtime/effect/DateTime" "flickMakeZonedFromString"
  reviewed "effect@4.1.2 sha256:f2bc7607bedcf499"

/// The current instant, in UTC, from the fiber's clock.
now : Unit ->{} DateTime
foreign effect now from "@flick-lang/runtime/effect/DateTime" "flickNow"
  arity 0
  reviewed "effect@4.1.2 sha256:048cf7652fb67b8d"

/// The current instant in the current time zone.
now_in_current_zone : Unit ->{CurrentTimeZone;} DateTime
let now_in_current_zone () = set_zone_current (now ())

/// Whether the date-time is UTC.
is_utc : DateTime -> Bool
foreign pure is_utc from "@flick-lang/runtime/effect/DateTime" "isUtc"
  reviewed "effect@4.1.2 sha256:8a95dad64bba2f7f"

/// Whether the date-time has a zone.
is_zoned : DateTime -> Bool
foreign pure is_zoned from "@flick-lang/runtime/effect/DateTime" "isZoned"
  reviewed "effect@4.1.2 sha256:e3e60b7cff44c3a2"

/// By kind: `onUtc` for a UTC date-time, `onZoned` for a zoned one.
match_ : { onUtc : DateTime -> a; onZoned : DateTime -> a } -> DateTime -> a
foreign pure match_ from "@flick-lang/runtime/effect/DateTime" "match"
  arity 1
  reviewed "effect@4.1.2 sha256:411148ed137d0c6c"

/// The same instant in UTC.
to_utc : DateTime -> DateTime
foreign pure to_utc from "@flick-lang/runtime/effect/DateTime" "toUtc"
  reviewed "effect@4.1.2 sha256:345fb07a0571a40f"

/// The date-time in the zone.
set_zone : ZoneOptions -> TimeZone -> DateTime -> Result DateTimeError DateTime
foreign pure set_zone from "@flick-lang/runtime/effect/DateTime" "flickSetZone"
  reviewed "effect@4.1.2 sha256:b89bb06b303864e7"

/// The date-time at the offset, in milliseconds.
set_zone_offset : ZoneOptions -> Float -> DateTime -> Result DateTimeError DateTime
foreign pure set_zone_offset from "@flick-lang/runtime/effect/DateTime" "flickSetZoneOffset"
  reviewed "effect@4.1.2 sha256:3fbaa0c1ee44dca8"

/// The date-time in the zone of that IANA id.
set_zone_named : ZoneOptions -> String -> DateTime -> Result DateTimeError DateTime
foreign pure set_zone_named from "@flick-lang/runtime/effect/DateTime" "flickSetZoneNamed"
  reviewed "effect@4.1.2 sha256:6d4acf510368f1c9"

/// The date-time in the current time zone, keeping the instant.
set_zone_current : DateTime ->{CurrentTimeZone;} DateTime
let set_zone_current t =
  let zone = CurrentTimeZone.current_zone ()
  match set_zone { adjustForTimeZone = None; disambiguation = None } zone t with
  | Ok zoned -> zoned
  // unreachable: without adjustForTimeZone the instant is kept, which never fails
  | Err _ -> t

/// The zone at a fixed offset from UTC, in milliseconds.
zone_make_offset : Float -> TimeZone
foreign pure zone_make_offset from "@flick-lang/runtime/effect/DateTime" "zoneMakeOffset"
  reviewed "effect@4.1.2 sha256:60aeb3e0972bf05f"

/// The zone of an IANA id such as `Europe/Paris`.
zone_make_named : String -> Result DateTimeError TimeZone
foreign pure zone_make_named from "@flick-lang/runtime/effect/DateTime" "flickZoneMakeNamed"
  reviewed "effect@4.1.2 sha256:d18521a306aca24a"

/// `zone_make_named` as a runtime call failing with `DateTimeError`.
zone_make_named_effect : String ->{; DateTimeError} TimeZone
let zone_make_named_effect id = from_result (zone_make_named id)

/// The zone of the machine the program runs on.
zone_make_local : Unit ->{} TimeZone
foreign zone_make_local from "@flick-lang/runtime/effect/DateTime" "zoneMakeLocal"
  arity 0
  reviewed "effect@4.1.2 sha256:63133ecf5695a43a"

/// An IANA id or an offset such as `+01:00`.
zone_from_string : String -> Result DateTimeError TimeZone
foreign pure zone_from_string from "@flick-lang/runtime/effect/DateTime" "flickZoneFromString"
  reviewed "effect@4.1.2 sha256:3aa8f4bee027c2b2"

/// The IANA id, or the offset as `+01:00`.
zone_to_string : TimeZone -> String
foreign pure zone_to_string from "@flick-lang/runtime/effect/DateTime" "zoneToString"
  reviewed "effect@4.1.2 sha256:6d063395d7a573a9"

/// Provides the zone as the current time zone.
layer_current_zone : TimeZone -> Layer none none {CurrentTimeZone}
let layer_current_zone zone = Layer.succeed CurrentTimeZone { current_zone = fun () -> zone }

/// Provides the zone at the offset, in milliseconds.
layer_current_zone_offset : Float -> Layer none none {CurrentTimeZone}
let layer_current_zone_offset offset = layer_current_zone (zone_make_offset offset)

/// Provides the zone of the IANA id, when it is one.
layer_current_zone_named : String -> Result DateTimeError (Layer none none {CurrentTimeZone})
let layer_current_zone_named id = Result.map layer_current_zone (zone_make_named id)

/// Provides the zone of the machine the program runs on.
layer_current_zone_local : Layer none none {CurrentTimeZone}
let layer_current_zone_local = Layer.succeed CurrentTimeZone { current_zone = zone_make_local }

/// The milliseconds since 1970-01-01 UTC.
to_epoch_millis : DateTime -> Float
foreign pure to_epoch_millis from "@flick-lang/runtime/effect/DateTime" "toEpochMillis"
  reviewed "effect@4.1.2 sha256:e5ba4e1f4f6368a4"

/// The whole seconds since 1970-01-01 UTC.
to_epoch_seconds : DateTime -> Float
foreign pure to_epoch_seconds from "@flick-lang/runtime/effect/DateTime" "toEpochSeconds"
  reviewed "effect@4.1.2 sha256:9014f104b325355a"

/// The epoch milliseconds mapped by `f`, keeping the zone.
map_epoch_millis : (Float -> Float) -> DateTime -> DateTime
foreign pure map_epoch_millis from "@flick-lang/runtime/effect/DateTime" "mapEpochMillis"
  arity 1
  reviewed "effect@4.1.2 sha256:6d92a84dbde1f3ba"

