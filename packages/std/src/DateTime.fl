  reviewed "effect@4.1.2 sha256:5856af1808f786c6"

/// Formats with an `Intl.DateTimeFormat` made of the options.
format_intl : FormatOptions -> DateTime -> Result DateTimeError String
foreign pure format_intl from "@flick-lang/runtime/effect/DateTime" "flickFormatIntl"
  reviewed "effect@4.1.2 sha256:e186b67ad4dd5555"

/// ISO 8601 in UTC: `2024-03-10T08:00:00.000Z`.
format_iso : DateTime -> String
foreign pure format_iso from "@flick-lang/runtime/effect/DateTime" "formatIso"
  reviewed "effect@4.1.2 sha256:addfe5ed384325a3"

/// The ISO date in the date-time's zone: `2024-03-10`.
