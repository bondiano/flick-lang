/// Instants with an optional time zone. A date-time is UTC or zoned;
/// constructors and zone changes are checked and fail with `DateTimeError`,
/// never with a raw error of the runtime.
module DateTime exposing (..)

import Duration
import Layer

/// An instant, in UTC or in a time zone.
type DateTime

/// A named zone (`Europe/Paris`) or a fixed offset from UTC.
type TimeZone

/// Why a date-time or a zone could not be made, placed or formatted.
type error DateTimeError = DateTimeError String
  deriving Eq, Show

/// Which instant a wall-clock time means when a zone skips or repeats it.
type Disambiguation = Compatible | Earlier | Later | Reject

/// The units of `add`, `start_of` and the others.
type TimeUnit = Millisecond | Second | Minute | Hour | Day | Week | Month | Year

/// The parts of a date-time; `weekDay` counts from Sunday, 0.
type alias Parts = {
  millisecond : Int;
  second : Int;
  minute : Int;
  hour : Int;
  day : Int;
  weekDay : Int;
  month : Int;
  year : Int;
}

/// Some of the parts; `None` keeps a part as it is.
type alias PartialParts = {
  millisecond : Option Int;
  second : Option Int;
  minute : Option Int;
  hour : Option Int;
  day : Option Int;
  weekDay : Option Int;
  month : Option Int;
  year : Option Int;
}

/// How to place a date-time in a zone: keep the instant (the default) or,
/// with `adjustForTimeZone`, keep the wall-clock time.
type alias ZoneOptions = { adjustForTimeZone : Option Bool; disambiguation : Option Disambiguation }

/// `Intl.DateTimeFormat` options: a locale, and `"full"`, `"long"`,
/// `"medium"` or `"short"` styles.
type alias FormatOptions = {
  locale : Option String;
  dateStyle : Option String;
  timeStyle : Option String;
}

/// No part at all, to update: `{ DateTime.no_parts with hour = Some 9 }`.
no_parts : PartialParts
let no_parts = {
  millisecond = None;
  second = None;
  minute = None;
  hour = None;
  day = None;
  weekDay = None;
  month = None;
  year = None;
}

/// The time zone a program runs in; `layer_current_zone` provides it.
service CurrentTimeZone =
  current_zone : Unit ->{} TimeZone

/// Parses an ISO date-time; a string without an offset is read as UTC.
make : String -> Result DateTimeError DateTime
foreign pure make from "flick:DateTime" "flickMake"

/// The UTC date-time of the given parts, the others from 1970-01-01.
from_parts : PartialParts -> Result DateTimeError DateTime
foreign pure from_parts from "flick:DateTime" "flickFromParts"

/// The UTC date-time `n` seconds after 1970-01-01.
from_epoch_seconds : Float -> Result DateTimeError DateTime
foreign pure from_epoch_seconds from "flick:DateTime" "flickFromEpochSeconds"

/// The date-time placed in the zone.
make_zoned : ZoneOptions -> TimeZone -> DateTime -> Result DateTimeError DateTime
foreign pure make_zoned from "flick:DateTime" "flickMakeZoned"

/// Parses `2024-03-10T09:00:00.000+01:00[Europe/Paris]` or an ISO string
/// with an offset.
make_zoned_from_string : String -> Result DateTimeError DateTime
foreign pure make_zoned_from_string from "flick:DateTime" "flickMakeZonedFromString"

/// The current instant, in UTC, from the fiber's clock.
now : Unit ->{} DateTime
foreign effect now from "flick:DateTime" "flickNow"
  arity 0

/// The current instant in the current time zone.
now_in_current_zone : Unit ->{CurrentTimeZone} DateTime
let now_in_current_zone () = set_zone_current (now ())

/// Whether the date-time is UTC.
is_utc : DateTime -> Bool
foreign pure is_utc from "flick:DateTime" "isUtc"

/// Whether the date-time has a zone.
is_zoned : DateTime -> Bool
foreign pure is_zoned from "flick:DateTime" "isZoned"

/// By kind: `onUtc` for a UTC date-time, `onZoned` for a zoned one.
match_ : { onUtc : DateTime -> a; onZoned : DateTime -> a } -> DateTime -> a
foreign pure match_ from "flick:DateTime" "match"
  arity 1

/// The same instant in UTC.
to_utc : DateTime -> DateTime
foreign pure to_utc from "flick:DateTime" "toUtc"

/// The date-time in the zone.
set_zone : ZoneOptions -> TimeZone -> DateTime -> Result DateTimeError DateTime
foreign pure set_zone from "flick:DateTime" "flickSetZone"

/// The date-time at the offset, in milliseconds.
set_zone_offset : ZoneOptions -> Float -> DateTime -> Result DateTimeError DateTime
foreign pure set_zone_offset from "flick:DateTime" "flickSetZoneOffset"

/// The date-time in the zone of that IANA id.
set_zone_named : ZoneOptions -> String -> DateTime -> Result DateTimeError DateTime
foreign pure set_zone_named from "flick:DateTime" "flickSetZoneNamed"

/// The date-time in the current time zone, keeping the instant.
set_zone_current : DateTime ->{CurrentTimeZone} DateTime
let set_zone_current t =
  let zone = CurrentTimeZone.current_zone ()
  match set_zone { adjustForTimeZone = None; disambiguation = None } zone t with
  | Ok zoned -> zoned
  // unreachable: without adjustForTimeZone the instant is kept, which never fails
  | Err _ -> t

/// The zone at a fixed offset from UTC, in milliseconds.
zone_make_offset : Float -> TimeZone
foreign pure zone_make_offset from "flick:DateTime" "zoneMakeOffset"

/// The zone of an IANA id such as `Europe/Paris`.
zone_make_named : String -> Result DateTimeError TimeZone
foreign pure zone_make_named from "flick:DateTime" "flickZoneMakeNamed"

/// `zone_make_named` as a runtime call failing with `DateTimeError`.
zone_make_named_effect : String ->{; DateTimeError} TimeZone
let zone_make_named_effect id = from_result (zone_make_named id)

/// The zone of the machine the program runs on.
zone_make_local : Unit ->{} TimeZone
foreign zone_make_local from "flick:DateTime" "zoneMakeLocal"
  arity 0

/// An IANA id or an offset such as `+01:00`.
zone_from_string : String -> Result DateTimeError TimeZone
foreign pure zone_from_string from "flick:DateTime" "flickZoneFromString"

/// The IANA id, or the offset as `+01:00`.
zone_to_string : TimeZone -> String
foreign pure zone_to_string from "flick:DateTime" "zoneToString"

/// Provides the zone as the current time zone.
layer_current_zone : TimeZone -> Layer none none {CurrentTimeZone}
let layer_current_zone zone = Layer.succeed CurrentTimeZone { current_zone = fun () -> zone }

/// Provides the zone at the offset, in milliseconds.
layer_current_zone_offset : Float -> Layer none none {CurrentTimeZone}
let layer_current_zone_offset offset = layer_current_zone (zone_make_offset offset)

/// Provides the zone of the IANA id, when it is one.
layer_current_zone_named : String -> Result DateTimeError (Layer none none {CurrentTimeZone})
let layer_current_zone_named id = Result.map layer_current_zone (zone_make_named id)

/// Provides the zone of the machine the program runs on.
layer_current_zone_local : Layer none none {CurrentTimeZone}
let layer_current_zone_local = Layer.succeed CurrentTimeZone { current_zone = zone_make_local }

/// The milliseconds since 1970-01-01 UTC.
to_epoch_millis : DateTime -> Float
foreign pure to_epoch_millis from "flick:DateTime" "toEpochMillis"

/// The whole seconds since 1970-01-01 UTC.
to_epoch_seconds : DateTime -> Float
foreign pure to_epoch_seconds from "flick:DateTime" "toEpochSeconds"

/// The epoch milliseconds mapped by `f`, keeping the zone.
map_epoch_millis : (Float -> Float) -> DateTime -> DateTime
foreign pure map_epoch_millis from "flick:DateTime" "mapEpochMillis"
  arity 1

/// The parts in the date-time's zone.
to_parts : DateTime -> Parts
foreign pure to_parts from "flick:DateTime" "toParts"

/// The parts in UTC.
to_parts_utc : DateTime -> Parts
foreign pure to_parts_utc from "flick:DateTime" "toPartsUtc"

/// The given parts replaced, in the date-time's zone.
set_parts : PartialParts -> DateTime -> DateTime
foreign pure set_parts from "flick:DateTime" "flickSetParts"

/// The given parts replaced, in UTC.
set_parts_utc : PartialParts -> DateTime -> DateTime
foreign pure set_parts_utc from "flick:DateTime" "flickSetPartsUtc"

/// The UTC midnight of the date-time's UTC day.
remove_time : DateTime -> DateTime
foreign pure remove_time from "flick:DateTime" "removeTime"

/// The offset of a zoned date-time, in milliseconds; `None` for UTC.
zoned_offset : DateTime -> Option Float
foreign pure zoned_offset from "flick:DateTime" "flickZonedOffset"

/// The offset of a zoned date-time as `+01:00`; `None` for UTC.
zoned_offset_iso : DateTime -> Option String
foreign pure zoned_offset_iso from "flick:DateTime" "flickZonedOffsetIso"

/// `t |> add Day 3`: time units move the instant, calendar units the wall clock.
add : TimeUnit -> Float -> DateTime -> DateTime
foreign pure add from "flick:DateTime" "flickAdd"

/// `t |> subtract Month 1`, as `add` does.
subtract : TimeUnit -> Float -> DateTime -> DateTime
foreign pure subtract from "flick:DateTime" "flickSubtract"

/// The date-time the duration later.
add_duration : Duration.Duration -> DateTime -> DateTime
foreign pure add_duration from "flick:DateTime" "addDuration"
  arity 1

/// The date-time the duration earlier.
subtract_duration : Duration.Duration -> DateTime -> DateTime
foreign pure subtract_duration from "flick:DateTime" "subtractDuration"
  arity 1

/// The start of the unit the date-time is in; weeks start on
/// `weekStartsOn` (0 for Sunday, the default).
start_of : { weekStartsOn : Option Int } -> TimeUnit -> DateTime -> DateTime
foreign pure start_of from "flick:DateTime" "flickStartOf"

/// The last millisecond of the unit the date-time is in.
end_of : { weekStartsOn : Option Int } -> TimeUnit -> DateTime -> DateTime
foreign pure end_of from "flick:DateTime" "flickEndOf"

/// The nearer of the start of the unit and the start of the next one.
nearest : { weekStartsOn : Option Int } -> TimeUnit -> DateTime -> DateTime
foreign pure nearest from "flick:DateTime" "flickNearest"

/// The time between the two, whichever comes first.
distance : DateTime -> DateTime -> Duration.Duration
foreign pure distance from "flick:DateTime" "flickDistance"

/// The order of instants, earliest first; zones do not matter.
compare_date_time : DateTime -> DateTime -> Ordering
foreign pure compare_date_time from "flick:DateTime" "flickCompare"

/// The earlier of the two.
min : DateTime -> DateTime -> DateTime
foreign pure min from "flick:DateTime" "min"
  arity 1

/// The later of the two.
max : DateTime -> DateTime -> DateTime
foreign pure max from "flick:DateTime" "max"
  arity 1

/// The date-time, moved into the bounds.
clamp : { minimum : DateTime; maximum : DateTime } -> DateTime -> DateTime
foreign pure clamp from "flick:DateTime" "clamp"
  arity 1

/// Whether the date-time lies within the bounds, both included.
between : { minimum : DateTime; maximum : DateTime } -> DateTime -> Bool
foreign pure between from "flick:DateTime" "between"
  arity 1

/// `t |> is_less_than u`: `t` is earlier.
is_less_than : DateTime -> DateTime -> Bool
foreign pure is_less_than from "flick:DateTime" "isLessThan"
  arity 1

/// `t |> is_less_than_or_equal_to u`: `t` is not later.
is_less_than_or_equal_to : DateTime -> DateTime -> Bool
foreign pure is_less_than_or_equal_to from "flick:DateTime" "isLessThanOrEqualTo"
  arity 1

/// `t |> is_greater_than u`: `t` is later.
is_greater_than : DateTime -> DateTime -> Bool
foreign pure is_greater_than from "flick:DateTime" "isGreaterThan"
  arity 1

/// `t |> is_greater_than_or_equal_to u`: `t` is not earlier.
is_greater_than_or_equal_to : DateTime -> DateTime -> Bool
foreign pure is_greater_than_or_equal_to from "flick:DateTime" "isGreaterThanOrEqualTo"
  arity 1

/// Whether the date-time is after the clock's now.
is_future : DateTime ->{} Bool
foreign effect is_future from "flick:DateTime" "isFuture"

/// Whether the date-time is before the clock's now.
is_past : DateTime ->{} Bool
foreign effect is_past from "flick:DateTime" "isPast"

/// Formats in the date-time's zone (UTC for a UTC one).
format : FormatOptions -> DateTime -> Result DateTimeError String
foreign pure format from "flick:DateTime" "flickFormat"

/// Formats in the zone of the machine the program runs on.
format_local : FormatOptions -> DateTime -> Result DateTimeError String
foreign pure format_local from "flick:DateTime" "flickFormatLocal"

/// Formats in UTC.
format_utc : FormatOptions -> DateTime -> Result DateTimeError String
foreign pure format_utc from "flick:DateTime" "flickFormatUtc"

/// Formats with an `Intl.DateTimeFormat` made of the options.
format_intl : FormatOptions -> DateTime -> Result DateTimeError String
foreign pure format_intl from "flick:DateTime" "flickFormatIntl"

/// ISO 8601 in UTC: `2024-03-10T08:00:00.000Z`.
format_iso : DateTime -> String
foreign pure format_iso from "flick:DateTime" "formatIso"

/// The ISO date in the date-time's zone: `2024-03-10`.
format_iso_date : DateTime -> String
foreign pure format_iso_date from "flick:DateTime" "formatIsoDate"

/// The ISO date in UTC.
format_iso_date_utc : DateTime -> String
foreign pure format_iso_date_utc from "flick:DateTime" "formatIsoDateUtc"

/// ISO 8601 with the zone's offset: `2024-03-10T09:00:00.000+01:00`.
format_iso_offset : DateTime -> String
foreign pure format_iso_offset from "flick:DateTime" "formatIsoOffset"

/// ISO 8601 with the offset and a named zone's id in brackets; `None` for UTC.
format_iso_zoned : DateTime -> Option String
foreign pure format_iso_zoned from "flick:DateTime" "flickFormatIsoZoned"

instance Eq DateTime =
  let eq x y = compare_date_time x y == EQ

instance Ord DateTime =
  let compare x y = compare_date_time x y

/// A date-time as JSON ISO 8601 text, decoded to UTC; encodes only UTC ones.
json_utc : PureCodec Json DateTime
foreign pure json_utc from "flick:DateTime" "flickJsonUtc"

/// A UTC date-time as a whole JSON number of milliseconds since the epoch.
json_utc_millis : PureCodec Json DateTime
foreign pure json_utc_millis from "flick:DateTime" "flickJsonUtcMillis"

/// A zoned date-time as JSON text: `"2024-01-01T09:00:00.000+01:00[Europe/Paris]"`.
json_zoned : PureCodec Json DateTime
foreign pure json_zoned from "flick:DateTime" "flickJsonZoned"

/// A zone as JSON text: an IANA name or an offset such as `"+02:00"`.
json_zone : PureCodec Json TimeZone
foreign pure json_zone from "flick:DateTime" "flickJsonZone"

/// A named zone as JSON text; an offset or unknown name is a `SchemaError`.
json_zone_named : PureCodec Json TimeZone
foreign pure json_zone_named from "flick:DateTime" "flickJsonZoneNamed"

/// A fixed-offset zone as a JSON number of milliseconds east of UTC.
json_zone_offset : PureCodec Json TimeZone
foreign pure json_zone_offset from "flick:DateTime" "flickJsonZoneOffset"
