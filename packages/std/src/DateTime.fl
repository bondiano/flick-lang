  reviewed "effect@4.1.2 sha256:f0c127e081a324b9"

/// Formats in the zone of the machine the program runs on.
format_local : FormatOptions -> DateTime -> Result DateTimeError String
foreign pure format_local from "@flick-lang/runtime/effect/DateTime" "flickFormatLocal"
  reviewed "effect@4.1.2 sha256:133b7dd6017c3a6d"

