/// URLs of a route type. A type that derives `Url` (and `Schema`) maps each
/// constructor to a path: its name in kebab case is the first segment
/// (`Home` and `Index` are `/`), its fields of type `String`, `Float`,
/// `Bool` or a refined type over them the segments after it, a field of a
/// type whose constructors have no fields a segment of the constructor's
/// name in kebab case, the last segment an `Option` that may be missing, and
/// a final record field the query, where an `Option` field may be missing.
///
/// ```flick
/// type Page = Home | User Float | Search { q : String; page : Option Float }
///   deriving (Schema, Url)
///
/// Route.print Page$url (User 42)           -- "/user/42"
/// Route.parse Page$url "/search?q=atoms"   -- Some (Search { q = "atoms"; page = None })
/// ```
module Route exposing (..)

/// The path and query of a value. Text is percent-encoded as UTF-8; a
/// lone surrogate, which has no UTF-8 form, prints as U+FFFD.
print : Url a -> a -> String
foreign pure print from "flick:rt" "routePrint"

/// The value whose URL is `text`, ignoring its origin and fragment; `None`
/// when no constructor matches or a field is not valid.
parse : Url a -> String -> Option a
foreign pure parse from "flick:rt" "routeParse"
  nullable

/// A constructor of a route type as `deriving Url` writes it: the
/// constructor, its path segment (`""` for `/`), its segments, its query and
/// whether its last segment may be missing.
type Path

path : c -> String -> List Segment -> Option (List Query) -> Bool -> Path
foreign pure path from "flick:rt" "routePath"

/// A segment of a path after the constructor's.
type Segment

/// A segment of a field's value.
segment : Schema a -> Segment
foreign pure segment from "flick:rt" "routeSegment"

/// A segment of a field of a type whose constructors have no fields: each
/// word with its constructor.
words : List (String, c) -> Segment
foreign pure words from "flick:rt" "routeWordsOf"

/// The last segment, another route type's: the rest of the path.
nested : (Unit -> Url a) -> Segment
foreign pure nested from "flick:rt" "routeNestedOf"

/// A query parameter: its label, its schema, and whether it may be missing.
type Query

query : String -> Schema a -> Bool -> Query
foreign pure query from "flick:rt" "routeQuery"

/// The URLs of the type of `schema`, a path for each constructor.
codec : Schema a -> List Path -> Url a
foreign pure codec from "flick:rt" "routeCodec"
