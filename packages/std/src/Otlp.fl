/// Exporters of OpenTelemetry's protocol over HTTP: a program provides one,
/// and its spans, log records or metrics are sent to the collector in
/// batches, the rest when the layer's scope closes. `Options` sends JSON
/// with the defaults; `Settings` and the `_with` layers say the rest. The
/// module is experimental.
module Otlp exposing (..)

import Duration
import Tracer

/// Where the exporter sends and the service it names in what it sends.
type alias Options = { url : String; service_name : String }

/// Traces, logs and metrics, sent under `url` (`http://localhost:4318`) to
/// `/v1/traces`, `/v1/logs` and `/v1/metrics`.
layer : Options -> Layer none none none
foreign pure layer from "flick:observability/Otlp" "otlpLayer"
  reviewed "effect@4.1.2 sha256:540123a8e341e149"

/// Spans, sent to `url` (`http://localhost:4318/v1/traces`).
traces : Options -> Layer none none none
foreign pure traces from "flick:observability/Otlp" "otlpTraces"
  reviewed "effect@4.1.2 sha256:b9be076a3b681501"

/// Log records, sent to `url` (`http://localhost:4318/v1/logs`).
logs : Options -> Layer none none none
foreign pure logs from "flick:observability/Otlp" "otlpLogs"
  reviewed "effect@4.1.2 sha256:84bff042d5561fc1"

/// Metrics, sent to `url` (`http://localhost:4318/v1/metrics`).
metrics : Options -> Layer none none none
foreign pure metrics from "flick:observability/Otlp" "otlpMetrics"
  reviewed "effect@4.1.2 sha256:03304a237d1ab870"

/// How the exporters write what they send.
type Serialization

/// OTLP's JSON, the default.
json : Serialization
foreign pure json from "flick:observability/Otlp" "otlpJson"
  reviewed "effect@4.1.2 sha256:83cbfbfb44846be1"

/// OTLP's protobuf: smaller, and only a program that names it bundles it.
protobuf : Serialization
foreign pure protobuf from "flick:observability/Otlp" "otlpProtobuf"
  reviewed "effect@4.1.2 sha256:926974a98b1e4f51"

/// Everything an exporter can be told: the service's version and resource
/// attributes, headers of each request (an API key, say), gzip for bodies
/// of 1 KB or more, the serialization, how often a batch is sent, how many
/// records a batch holds, and how long the end of the scope waits for the
/// last one.
type alias Settings = {
  url : String;
  service_name : String;
  service_version : Option String;
  attributes : List (String, String);
  headers : List (String, String);
  gzip : Bool;
  serialization : Serialization;
  export_interval : Option Duration.Duration;
  max_batch_size : Option Int;
  shutdown_timeout : Option Duration.Duration;
}

/// The settings of `url` and `service_name`, everything else the default:
/// JSON, no gzip, no headers or attributes.
settings : String -> String -> Settings
let settings url service_name = {
  url = url;
  service_name = service_name;
  service_version = None;
  attributes = [];
  headers = [];
  gzip = false;
  serialization = json;
  export_interval = None;
  max_batch_size = None;
  shutdown_timeout = None;
}

/// `layer` as `settings` say.
layer_with : Settings -> Layer none none none
foreign pure layer_with from "flick:observability/Otlp" "otlpLayerWith"
  reviewed "effect@4.1.2 sha256:540123a8e341e149"

/// `traces` as `settings` say.
traces_with : Settings -> Layer none none none
foreign pure traces_with from "flick:observability/Otlp" "otlpTracesWith"
  reviewed "effect@4.1.2 sha256:b9be076a3b681501"

/// `logs` as `settings` say.
logs_with : Settings -> Layer none none none
foreign pure logs_with from "flick:observability/Otlp" "otlpLogsWith"
  reviewed "effect@4.1.2 sha256:84bff042d5561fc1"

/// `metrics` as `settings` say; `max_batch_size` does not apply.
metrics_with : Settings -> Layer none none none
foreign pure metrics_with from "flick:observability/Otlp" "otlpMetricsWith"
  reviewed "effect@4.1.2 sha256:03304a237d1ab870"

/// A tracer sending spans to `url` (`http://localhost:4318/v1/traces`) in
/// batches, for `Tracer.with_tracer`: unlike `traces`, only the tasks given
/// it trace there. It holds region `s`, and the spans left are sent when
/// the scope owning it closes.
tracer : Options ->{Scope s} Tracer.Tracer^{s}
foreign effect tracer from "flick:observability/Otlp" "otlpTracer"
  reviewed "effect@4.1.2 sha256:d1c64b3295e045bb"

/// Traces, logs and metrics as the current configuration says, in JSON:
/// a signal is exported only when `OTEL_TRACES_EXPORTER`,
/// `OTEL_LOGS_EXPORTER` or `OTEL_METRICS_EXPORTER` names `otlp`; then
/// `OTEL_EXPORTER_OTLP_ENDPOINT` (or `OTEL_EXPORTER_OTLP_<SIGNAL>_ENDPOINT`),
/// `_HEADERS`, `_COMPRESSION` and `_TIMEOUT`, the batch settings
/// `OTEL_BSP_*`, `OTEL_BLRP_*` and `OTEL_METRIC_EXPORT_*`, and the resource
/// `OTEL_SERVICE_NAME`, `OTEL_SERVICE_VERSION` and `OTEL_RESOURCE_ATTRIBUTES`
/// apply. `service`, when given, names the service instead. The
/// configuration is the provided `ConfigProvider`, the process's
/// environment by default.
from_config : Option String -> Layer none none none
foreign pure from_config from "flick:observability/Otlp" "otlpFromConfig"
  reviewed "effect@4.1.2 sha256:fdb3406c244d1111"
