/// A `SynchronizedRef` that publishes each new value to its subscribers.
module SubscriptionRef exposing (..)

/// A reference to a value of `a` that publishes its changes.
type SubscriptionRef a

/// A fresh reference holding `value`.
make : a ->{} SubscriptionRef a
foreign effect make from "flick:SubscriptionRef" "make"

/// The current value.
get : SubscriptionRef a ->{Async} a
foreign effect get from "flick:SubscriptionRef" "get"

/// Sets the value, giving the previous one.
get_and_set : a -> SubscriptionRef a ->{Async} a
foreign effect get_and_set from "flick:SubscriptionRef" "getAndSet"
  arity 1

/// Applies `f`, giving the previous value.
get_and_update : (a -> a)^c -> SubscriptionRef a ->{Async} a
foreign effect get_and_update from "flick:SubscriptionRef" "getAndUpdate"
  arity 1
  retention call

/// Runs `f` on the value and keeps its result, giving the previous value;
/// other updates wait for it.
get_and_update_effect : (a ->{r; e} a)^c -> SubscriptionRef a ->{r; e} a
foreign effect get_and_update_effect from "flick:SubscriptionRef" "getAndUpdateEffect"
  arity 1
  retention call

/// Applies `f` where it gives `Some`, giving the previous value.
get_and_update_some : (a -> Option a)^c -> SubscriptionRef a ->{Async} a
foreign effect get_and_update_some from "flick:SubscriptionRef" "getAndUpdateSome"
  arity 1
  retention call

/// `get_and_update_effect` where `f` may keep the value with `None`.
get_and_update_some_effect : (a ->{r; e} Option a)^c -> SubscriptionRef a ->{r; e} a
foreign effect get_and_update_some_effect from "flick:SubscriptionRef" "getAndUpdateSomeEffect"
  arity 1
  retention call

/// `f` gives the result and the new value, in one step.
modify : (a -> (b, a))^c -> SubscriptionRef a ->{Async} b
foreign effect modify from "flick:SubscriptionRef" "modify"
  arity 1
  retention call

/// Runs `f`, which gives the result and the new value; other updates wait
/// for it.
modify_effect : (a ->{r; e} (b, a))^c -> SubscriptionRef a ->{r; e} b
foreign effect modify_effect from "flick:SubscriptionRef" "modifyEffect"
  arity 1
  retention call

/// `modify` where `f` may keep the value with `None`.
modify_some : (a -> (b, Option a))^c -> SubscriptionRef a ->{Async} b
foreign effect modify_some from "flick:SubscriptionRef" "modifySome"
  arity 1
  retention call

/// `modify_effect` where `f` may keep the value with `None`.
modify_some_effect : (a ->{r; e} (b, Option a))^c -> SubscriptionRef a ->{r; e} b
foreign effect modify_some_effect from "flick:SubscriptionRef" "modifySomeEffect"
  arity 1
  retention call

/// Sets the value.
set : a -> SubscriptionRef a ->{Async} Unit
foreign effect set from "flick:SubscriptionRef" "set"
  arity 1

/// Sets the value, giving it.
set_and_get : a -> SubscriptionRef a ->{Async} a
foreign effect set_and_get from "flick:SubscriptionRef" "setAndGet"
  arity 1

/// Applies `f` to the value.
update : (a -> a)^c -> SubscriptionRef a ->{Async} Unit
foreign effect update from "flick:SubscriptionRef" "update"
  arity 1
  retention call

/// Runs `f` on the value and keeps its result; other updates wait for it.
update_effect : (a ->{r; e} a)^c -> SubscriptionRef a ->{r; e} Unit
foreign effect update_effect from "flick:SubscriptionRef" "updateEffect"
  arity 1
  retention call

/// Applies `f`, giving the new value.
update_and_get : (a -> a)^c -> SubscriptionRef a ->{Async} a
foreign effect update_and_get from "flick:SubscriptionRef" "updateAndGet"
  arity 1
  retention call

/// `update_effect`, giving the new value.
update_and_get_effect : (a ->{r; e} a)^c -> SubscriptionRef a ->{r; e} a
foreign effect update_and_get_effect from "flick:SubscriptionRef" "updateAndGetEffect"
  arity 1
  retention call

/// Applies `f` where it gives `Some`.
update_some : (a -> Option a)^c -> SubscriptionRef a ->{Async} Unit
foreign effect update_some from "flick:SubscriptionRef" "updateSome"
  arity 1
  retention call

/// `update_effect` where `f` may keep the value with `None`.
update_some_effect : (a ->{r; e} Option a)^c -> SubscriptionRef a ->{r; e} Unit
foreign effect update_some_effect from "flick:SubscriptionRef" "updateSomeEffect"
  arity 1
  retention call

/// Applies `f` where it gives `Some`, giving the value after.
update_some_and_get : (a -> Option a)^c -> SubscriptionRef a ->{} a
foreign effect update_some_and_get from "flick:SubscriptionRef" "updateSomeAndGet"
  arity 1
  retention call

/// `update_some_effect`, giving the value after.
update_some_and_get_effect : (a ->{r; e} Option a)^c -> SubscriptionRef a ->{r; e} a
foreign effect update_some_and_get_effect from "flick:SubscriptionRef" "updateSomeAndGetEffect"
  arity 1
  retention call
