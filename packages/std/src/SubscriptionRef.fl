/// Effect's `SubscriptionRef`: a `SynchronizedRef` that publishes each
/// new value to its subscribers.
module SubscriptionRef exposing (..)

/// A reference to a value of `a` that publishes its changes.
type SubscriptionRef a

/// A fresh reference holding `value`.
make : a ->{} SubscriptionRef a
foreign effect make from "@flick-lang/effect-ts/effect/SubscriptionRef" "make"
  reviewed "effect@4.1.2 sha256:f3f6e5a550530038"

/// The current value.
get : SubscriptionRef a ->{Async;} a
foreign effect get from "@flick-lang/effect-ts/effect/SubscriptionRef" "get"
  reviewed "effect@4.1.2 sha256:53991aa417733785"

/// Sets the value, giving the previous one.
get_and_set : a -> SubscriptionRef a ->{Async;} a
foreign effect get_and_set from "@flick-lang/effect-ts/effect/SubscriptionRef" "getAndSet"
  arity 1
  reviewed "effect@4.1.2 sha256:42ce243743e1369c"

/// Applies `f`, giving the previous value.
get_and_update : (a -> a)^c -> SubscriptionRef a ->{Async;} a
foreign effect get_and_update from "@flick-lang/effect-ts/effect/SubscriptionRef" "getAndUpdate"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:7ec665d69abe08d3"

/// Runs `f` on the value and keeps its result, giving the previous value;
/// other updates wait for it.
get_and_update_effect : (a ->{r; e} a)^c -> SubscriptionRef a ->{r; e} a
foreign effect get_and_update_effect from "@flick-lang/effect-ts/effect/SubscriptionRef" "getAndUpdateEffect"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:bb18e47f40a343d7"

/// Applies `f` where it gives `Some`, giving the previous value.
get_and_update_some : (a -> Option a)^c -> SubscriptionRef a ->{Async;} a
foreign effect get_and_update_some from "@flick-lang/effect-ts/effect/SubscriptionRef" "getAndUpdateSome"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:d9c8ddf2000fff61"

/// `get_and_update_effect` where `f` may keep the value with `None`.
get_and_update_some_effect : (a ->{r; e} Option a)^c -> SubscriptionRef a ->{r; e} a
foreign effect get_and_update_some_effect from "@flick-lang/effect-ts/effect/SubscriptionRef" "getAndUpdateSomeEffect"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:96778e681a82e6f9"

/// `f` gives the result and the new value, in one step.
modify : (a -> (b, a))^c -> SubscriptionRef a ->{Async;} b
foreign effect modify from "@flick-lang/effect-ts/effect/SubscriptionRef" "modify"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:0f5ab6b64e5ceb4d"

/// Runs `f`, which gives the result and the new value; other updates wait
/// for it.
modify_effect : (a ->{r; e} (b, a))^c -> SubscriptionRef a ->{r; e} b
foreign effect modify_effect from "@flick-lang/effect-ts/effect/SubscriptionRef" "modifyEffect"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:fb7b51e93e085576"

/// `modify` where `f` may keep the value with `None`.
modify_some : (a -> (b, Option a))^c -> SubscriptionRef a ->{Async;} b
foreign effect modify_some from "@flick-lang/effect-ts/effect/SubscriptionRef" "modifySome"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:444fc5c7fa921ebf"

