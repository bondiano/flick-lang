/// The tokens of an RFC 6901 JSON Pointer, as the paths of `JsonPatch` use
/// them.
module JsonPointer exposing (..)

/// A key as a pointer token: `~` as `~0`, `/` as `~1`.
escape_token : String -> String
foreign pure escape_token from "flick:JsonPointer" "escapeToken"

/// The key of a pointer token.
unescape_token : String -> String
foreign pure unescape_token from "flick:JsonPointer" "unescapeToken"

/// The keys of a URI fragment pointer (`#/a/b`); `None` when it is not one.
parse_uri_fragment : String -> Option (List String)
foreign pure parse_uri_fragment from "flick:JsonPointer" "parseUriFragment"
  nullable

/// The URI fragment pointer of the keys.
format_uri_fragment : List String -> String
foreign pure format_uri_fragment from "flick:JsonPointer" "formatUriFragment"
