/// The process the program runs in: its arguments, environment and
/// standard streams, through the `Host` services.
module Platform exposing (stdout_line, stderr_line, stdout_write, args, env)

import Host

/// Writes `text` and a line break to stdout.
stdout_line : String ->{Host.Console} Unit
let stdout_line text = Host.Console.stdout_line text

/// Writes `text` and a line break to stderr.
stderr_line : String ->{Host.Console} Unit
let stderr_line text = Host.Console.stderr_line text

/// Writes `text` to stdout without a line break.
stdout_write : String ->{Host.Console} Unit
let stdout_write text = Host.Console.stdout_write text

/// The arguments after `--` of `flick run`, or after the script name.
args : Unit ->{Host.Arguments} List String
let args () = Host.Arguments.args ()

/// The environment variable `name`, if set.
env : String ->{Host.Environment} Option String
let env name = Host.Environment.env name
