/// A read/write lock over transactional state. Many fibers may hold the
/// read lock, one the write lock, and a fiber may take a lock it already
/// holds again.
module TxReentrantLock exposing (..)

import Tx

/// A transactional read/write lock.
type TxReentrantLock

/// A new lock, not held.
make : Unit ->{} TxReentrantLock
foreign effect make from "flick:TxReentrantLock" "make"
  arity 0

/// Takes the read lock once more, waiting while another fiber writes; the
/// fiber's read count.
acquire_read : TxReentrantLock ->{Async, Tx.Transaction} Int
foreign effect acquire_read from "flick:TxReentrantLock" "acquireRead"

/// Takes the write lock once more, waiting while another fiber holds the
/// lock; the fiber's write count.
acquire_write : TxReentrantLock ->{Async, Tx.Transaction} Int
foreign effect acquire_write from "flick:TxReentrantLock" "acquireWrite"

/// Gives back one read of the fiber; its read count left.
release_read : TxReentrantLock ->{Tx.Transaction} Int
foreign effect release_read from "flick:TxReentrantLock" "releaseRead"

/// Gives back one write of the fiber; its write count left.
release_write : TxReentrantLock ->{Tx.Transaction} Int
foreign effect release_write from "flick:TxReentrantLock" "releaseWrite"

/// Holds the read lock until the scope of region `s` closes.
read_lock : TxReentrantLock ->{Async, Scope s} Int
foreign effect read_lock from "flick:TxReentrantLock" "readLock"

/// Holds the write lock until the scope of region `s` closes.
write_lock : TxReentrantLock ->{Async, Scope s} Int
foreign effect write_lock from "flick:TxReentrantLock" "writeLock"

/// Runs `body` holding the read lock.
with_read_lock : (Eff r e a)^c -> TxReentrantLock ->{r; e} a
foreign effect with_read_lock from "flick:TxReentrantLock" "withReadLock"
  arity 1
  retention call

/// Runs `body` holding the write lock.
with_write_lock : (Eff r e a)^c -> TxReentrantLock ->{r; e} a
foreign effect with_write_lock from "flick:TxReentrantLock" "withWriteLock"
  arity 1
  retention call

/// Runs `body` holding the write lock, as `with_write_lock`.
with_lock : (Eff r e a)^c -> TxReentrantLock ->{r; e} a
foreign effect with_lock from "flick:TxReentrantLock" "withLock"
  arity 1
  retention call

/// The number of reads held, by every fiber.
read_locks : TxReentrantLock ->{Tx.Transaction} Int
foreign effect read_locks from "flick:TxReentrantLock" "readLocks"

/// The number of writes held.
write_locks : TxReentrantLock ->{Tx.Transaction} Int
foreign effect write_locks from "flick:TxReentrantLock" "writeLocks"

/// Whether a fiber holds the lock, to read or to write.
locked : TxReentrantLock ->{Tx.Transaction} Bool
foreign effect locked from "flick:TxReentrantLock" "locked"

/// Whether a fiber holds the read lock.
read_locked : TxReentrantLock ->{Tx.Transaction} Bool
foreign effect read_locked from "flick:TxReentrantLock" "readLocked"

/// Whether a fiber holds the write lock.
write_locked : TxReentrantLock ->{Tx.Transaction} Bool
foreign effect write_locked from "flick:TxReentrantLock" "writeLocked"
