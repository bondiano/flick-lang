/// Tests. A module of the test root exports `tests : List Test`, which its
/// `suite` and `test` blocks declare, or which it builds by hand with this
/// module; `flick test` runs each test in a scope of its own and reports
/// assertions, typed failures, defects and failed cleanup apart.
module Test exposing (..)

import Duration
import Fiber
import Gen
import Host

type Test

/// The outcome of a check.
type Assertion = Pass | Failed String

/// An assertion that failed inside an effectful test.
type error AssertionFailed = AssertionFailed String
  deriving Eq, Show

equal : (Eq a, Show a) => a -> a -> Assertion
let equal expected actual =
  if eq expected actual then
    Pass
  else
    Failed ("expected " ++ show expected ++ ", got " ++ show actual)

/// `Pass` when `condition` holds, otherwise `Failed message`.
is_true : String -> Bool -> Assertion
let is_true message condition = if condition then Pass else Failed message

/// The first failed assertion, or `Pass`.
all : List Assertion -> Assertion
let all assertions =
  List.fold_left
    (fun outcome a ->
      match outcome with
      | Pass -> a
      | Failed _ -> outcome
    )
    Pass
    assertions

/// Fails the effectful test when the assertion failed.
expect : Assertion ->{; AssertionFailed} Unit
let expect assertion =
  match assertion with
  | Pass -> ()
  | Failed message -> Fail.fail (AssertionFailed message)

/// A pure test.
test : String -> (Unit -> Assertion) -> Test
foreign pure test from "flick:rt" "testPure"

/// An effectful test: it passes when the task succeeds and its scope, which
/// owns what the task acquires, closes cleanly. It runs with the live host
/// services, as a `main` of `Runner.Node` does; they outlive its scope, so
/// what it acquires may use them when it is released.
effect_test :
  forall e.
  String ->
  (forall s. Fiber.Provided {...Host.Live} s => Eff {Async, Scope s, ...Host.Live} e Unit) ->
  Test
foreign pure effect_test from "flick:rt" "testEffect"

/// A test reported as skipped and never run; of a group or a suite, each
/// test in it.
skip : Test -> Test
foreign pure skip from "flick:rt" "testSkip"

/// A test marked for a run of only the marked tests, as is each test in a
/// marked group or suite: while a test of the run is marked, the others are
/// reported as skipped. `flick test --forbid-only` fails a run with one.
only : Test -> Test
foreign pure only from "flick:rt" "testOnly"

/// Virtual time: the clock a `clock_test` runs on, which moves only when
/// the test moves it.
service VirtualTime

/// An effectful test on a clock of its own that starts at 0 and moves only
/// by `adjust` and `set_time`: a sleep, a timeout or a retry schedule waits
/// for virtual time, not real time. Each test has its own clock.
clock_test :
  forall e.
  String ->
  (forall s. Fiber.Provided {VirtualTime, ...Host.Live} s => Eff
    {Async, Scope s, VirtualTime, ...Host.Live}
    e
    Unit) ->
  Test
foreign pure clock_test from "flick:rt" "testClock"

/// Moves the clock forward by `duration`, running what was waiting for it.
adjust : Duration.Duration ->{Async, VirtualTime} Unit
foreign effect adjust from "flick:rt" "testAdjust"

/// Sets the clock to `millis` since the epoch, running what was waiting
/// until then.
set_time : Float ->{Async, VirtualTime} Unit
foreign effect set_time from "flick:rt" "testSetTime"

/// Checks `check` on 100 values of `gen`, from the run's seed.
property : String -> Gen.Gen a -> (a -> Assertion) -> Test
foreign pure property from "flick:rt" "testProperty"

/// Tests under a common name prefix. The hooks among them run around those
/// that a run selects: see `before_all`.
group : String -> List Test -> Test
foreign pure group from "flick:rt" "testGroup"

/// A hook of the group, or the module, whose list it is in: it runs once
/// before the first of the group's tests that the run selects, after the
/// `before_all` hooks of the groups around it. A group none of whose tests
/// the run selects runs no hooks, and a skipped or filtered test runs none.
/// When it fails, each selected test of the group is reported as a `setup`
/// failure and not run, and the group's `after_all` hooks, and those of the
/// groups around it, still run. It runs in the group's scope, which closes
/// after the group's last selected test, within the group's `timeout`, if it
/// has one: out of time, it fails the setup of the group's tests.
before_all :
  forall e.
  (forall s. Fiber.Provided {...Host.Live} s => Eff {Async, Scope s, ...Host.Live} e Unit) -> Test
foreign pure before_all from "flick:rt" "testBeforeAll"

/// A hook that runs before each selected test of its group, in the test's
/// scope, after the `before_all` hooks and the `before_each` hooks of the
/// groups around it, and under the test's `timeout`. When it fails, the
/// test is reported as a `setup` failure and its body does not run.
before_each :
  forall e.
  (forall s. Fiber.Provided {...Host.Live} s => Eff {Async, Scope s, ...Host.Live} e Unit) -> Test
foreign pure before_each from "flick:rt" "testBeforeEach"

/// A hook that runs after each selected test of its group, as a finalizer
/// of the test's scope: also when the test or a `before_each` hook failed,
/// timed out or was interrupted, before the `after_each` hooks of the groups
/// around it, within its group's `timeout`, if it has one. When it fails or
/// runs out of time, the test reports its cleanup failed.
after_each :
  forall e.
  (forall s. Fiber.Provided {...Host.Live} s => Eff {Async, Scope s, ...Host.Live} e Unit) -> Test
foreign pure after_each from "flick:rt" "testAfterEach"

/// A hook that runs once after the last selected test of its group, as a
/// finalizer of the group's scope, before the `after_all` hooks of the
/// groups around it: also when a `before_all` hook failed or the run was
/// interrupted, within the group's `timeout`, if it has one. When it fails or
/// runs out of time, the test that ended the group reports its cleanup
/// failed.
after_all :
  forall e.
  (forall s. Fiber.Provided {...Host.Live} s => Eff {Async, Scope s, ...Host.Live} e Unit) -> Test
foreign pure after_all from "flick:rt" "testAfterAll"

/// The test, and each test in it that has no timeout of its own, given
/// `millis` milliseconds for its `before_each` hooks and its body; when they
/// run out, the test is interrupted, its scope closes and it is reported as
/// `timeout`. The hooks of a group have its time too. `flick test --timeout`
/// gives the other tests and groups theirs.
timeout : Float -> Test -> Test
foreign pure timeout from "flick:rt" "testTimeout"

/// A test of a suite, which gets the services `o` of its layer.
type Spec (o : ServiceRow)

/// Tests that share what `layer` makes: it is built once, before the first
/// of them that runs, and released after the last, the `beforeAll` and
/// `afterAll` of the suite. A failed build fails each of its tests.
suite : String -> Layer {Async, ...Host.Live} e o -> List (Spec o) -> Test
foreign pure suite from "flick:rt" "testSuite"

/// An effectful test of a suite: `effect_test` with the suite's services,
/// which outlive its scope too.
it :
  forall o e.
  String ->
  (forall s. Fiber.Provided {...Host.Live | o} s => Eff {Async, Scope s, ...Host.Live | o} e Unit) ->
  Spec o
foreign pure it from "flick:rt" "testEffect"
