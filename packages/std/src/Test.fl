/// Tests. A module of the test root exports `tests : List Test`; `flick test`
/// runs each test in a scope of its own and reports assertions, typed
/// failures, defects and failed cleanup apart.
module Test exposing (..)

type Test

/// The outcome of a check.
type Assertion = Pass | Failed String

/// An assertion that failed inside an effectful test.
type error AssertionFailed = AssertionFailed String
  deriving Eq, Show

equal : (Eq a, Show a) => a -> a -> Assertion
let equal expected actual =
  if eq expected actual then
    Pass
  else
    Failed ("expected " ++ show expected ++ ", got " ++ show actual)

/// `Pass` when `condition` holds, otherwise `Failed message`.
is_true : String -> Bool -> Assertion
let is_true message condition = if condition then Pass else Failed message

/// The first failed assertion, or `Pass`.
all : List Assertion -> Assertion
let all assertions =
  List.fold_left
    (fun outcome a ->
      match outcome with
      | Pass -> a
      | Failed _ -> outcome
    )
    Pass
    assertions

/// Fails the effectful test when the assertion failed.
expect : Assertion ->{; AssertionFailed} Unit
let expect assertion =
  match assertion with
  | Pass -> ()
  | Failed message -> from_result (Err (AssertionFailed message))

/// A pure test.
test : String -> (Unit -> Assertion) -> Test
foreign pure test from "@flick-lang/runtime" "testPure"

/// An effectful test: it passes when the task succeeds and its scope, which
/// owns what the task acquires, closes cleanly.
effect_test : forall e. String -> (forall s. Eff {Async, Scope s} e Unit) -> Test
foreign pure effect_test from "@flick-lang/runtime" "testEffect"

/// Virtual time: the clock a `clock_test` runs on, which moves only when
/// the test moves it.
service VirtualTime

/// An effectful test on a clock of its own that starts at 0 and moves only
/// by `adjust` and `set_time`: a sleep, a timeout or a retry schedule waits
/// for virtual time, not real time. Each test has its own clock.
clock_test : forall e. String -> (forall s. Eff {Async, Scope s, VirtualTime} e Unit) -> Test
foreign pure clock_test from "@flick-lang/runtime" "testClock"

/// Moves the clock forward by `duration`, running what was waiting for it.
adjust : Duration.Duration ->{VirtualTime;} Unit
foreign effect adjust from "@flick-lang/runtime" "testAdjust"

/// Sets the clock to `millis` since the epoch, running what was waiting
/// until then.
set_time : Float ->{VirtualTime;} Unit
foreign effect set_time from "@flick-lang/runtime" "testSetTime"

/// Checks `check` on 100 values of `gen`, from the run's seed.
property : String -> Gen.Gen a -> (a -> Assertion) -> Test
foreign pure property from "@flick-lang/runtime" "testProperty"

/// Tests under a common name prefix.
group : String -> List Test -> Test
foreign pure group from "@flick-lang/runtime" "testGroup"

/// A test of a suite, which gets the services `o` of its layer.
type Spec (o : ServiceRow)

/// Tests that share what `layer` makes: it is built once, before the first
/// of them that runs, and released after the last, the `beforeAll` and
/// `afterAll` of the suite. A failed build fails each of its tests.
suite : forall e o. String -> Layer none e o -> List (Spec o) -> Test
foreign pure suite from "@flick-lang/runtime" "testSuite"

/// An effectful test of a suite: `effect_test` with the suite's services.
it : forall o e. String -> (forall s. Eff {Scope s | o} e Unit) -> Spec o
foreign pure it from "@flick-lang/runtime" "testEffect"
