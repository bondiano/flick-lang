/// Tests. A module of the test root exports `tests : List Test`, which its
/// `suite` and `test` blocks declare, or which it builds by hand with this
/// module; `flick test` runs each test in a scope of its own and reports
/// assertions, typed failures, defects and failed cleanup apart.
module Test exposing (..)

import Duration
import Exit
import Fiber
import Gen
import Host

type Test

/// The outcome of a check.
type Assertion = Pass | Failed String

/// An assertion that failed inside an effectful test.
type error AssertionFailed = AssertionFailed String
  deriving Eq, Show

equal : (Eq a, Show a) => a -> a -> Assertion
let equal expected actual =
  if eq expected actual then Pass else Failed (differ (show expected) (show actual))

/// Why `expected` and `actual`, as `show` writes them, differ: `expected X,
/// got Y` when both are short lines, otherwise a diff of their lines, where
/// the lines both start and end with are as they are, and those between
/// them are each of `expected` after `- ` and each of `actual` after `+ `.
differ : String -> String -> String
let differ expected actual =
  let before = String.lines expected
  let after = String.lines actual
  if List.length before == 1
    && List.length after == 1
    && String.length expected + String.length actual <= 80 then
    "expected " ++ expected ++ ", got " ++ actual
  else
    let start = alike before after
    let rest_before = List.drop start before
    let rest_after = List.drop start after
    let last = alike (List.reverse rest_before) (List.reverse rest_after)
    let kept = fun lines -> List.map (fun line -> "  " ++ line) lines
    let changed = fun mark lines -> List.map (fun line -> mark ++ line) (List.drop_right last lines)
    // shortcut: one changed hunk between the shared start and end, not a minimal diff; enough for values `show` writes
    let lines =
      kept (List.take start before)
        ++ changed "- " rest_before
        ++ changed "+ " rest_after
        ++ kept (List.take_right last rest_before)
    "expected (-) and got (+) differ:\n" ++ String.join "\n" lines

/// How many lines `a` and `b` start with alike.
alike : List String -> List String -> Int
let rec alike a b =
  match (a, b) with
  | ([x, ...xs], [y, ...ys]) -> if x == y then 1 + alike xs ys else 0
  | _ -> 0

/// `Pass` when `condition` holds, otherwise `Failed message`.
is_true : String -> Bool -> Assertion
let is_true message condition = if condition then Pass else Failed message

/// The first failed assertion, or `Pass`.
all : List Assertion -> Assertion
let all assertions =
  List.fold_left
    (fun outcome a ->
      match outcome with
      | Pass -> a
      | Failed _ -> outcome
    )
    Pass
    assertions

/// The value a matcher of `to` checks: `expect actual |> to.equal
/// expected`.
type Subject a = Subject a

/// `actual`, for a matcher of `to`.
expect : a -> Subject a
let expect actual = Subject actual

/// What a matcher fails the effectful test with when its subject does not
/// match: `message`.
mismatch : String ->{; AssertionFailed} Unit
let mismatch message = Fail.fail (AssertionFailed message)

/// The matchers of a subject, each of which fails the test with
/// `AssertionFailed` when the subject does not match.
type alias Matchers = {
  equal : forall a. (Eq a, Show a) => a -> Subject a ->{; AssertionFailed} Unit
  be_true : Subject Bool ->{; AssertionFailed} Unit
  be_greater_than : forall a. (Ord a, Show a) => a -> Subject a ->{; AssertionFailed} Unit
  contain : forall a. (Eq a, Show a) => a -> Subject (List a) ->{; AssertionFailed} Unit
  fail_with : forall r e a. (Eq (Errors e), Show (Errors e)) => Errors e ->
    Subject (Eff r e a) ->{r; AssertionFailed}
    Unit
  match_snapshot : forall a. Show a => String -> Subject a ->{; AssertionFailed} Unit
}

/// The matchers: `to.equal expected`, `to.be_true`, `to.be_greater_than
/// bound`, `to.contain item` of a list, `to.fail_with error` of a task,
/// which runs it and expects it to fail with `error`, and
/// `to.match_snapshot name`, which compares the value, as `show` writes it,
/// with the test's snapshot `name`.
to : Matchers
let to = {
  equal = to_equal
  be_true = to_be_true
  be_greater_than = to_be_greater_than
  contain = to_contain
  fail_with = to_fail_with
  match_snapshot = to_match_snapshot
}

to_equal : (Eq a, Show a) => a -> Subject a ->{; AssertionFailed} Unit
let to_equal expected (Subject actual) =
  if eq expected actual then () else mismatch (differ (show expected) (show actual))

to_be_true : Subject Bool ->{; AssertionFailed} Unit
let to_be_true (Subject actual) = if actual then () else mismatch "expected true, got false"

to_be_greater_than : (Ord a, Show a) => a -> Subject a ->{; AssertionFailed} Unit
let to_be_greater_than bound (Subject actual) =
  if actual > bound then
    ()
  else
    mismatch ("expected a value greater than " ++ show bound ++ ", got " ++ show actual)

to_contain : (Eq a, Show a) => a -> Subject (List a) ->{; AssertionFailed} Unit
let to_contain item (Subject items) =
  if List.contains item items then
    ()
  else
    mismatch ("expected a list that contains " ++ show item ++ ", got " ++ show items)

to_fail_with :
  (Eq (Errors e), Show (Errors e)) => Errors e -> Subject (Eff r e a) ->{r; AssertionFailed} Unit
let to_fail_with expected (Subject run) =
  let ended = exit_of run
  let wanted = "expected the task to fail with " ++ show expected
  match Exit.find_error_option ended with
  | Some actual ->
    if actual == expected then () else mismatch (wanted ++ ", it failed with " ++ show actual)
  | None ->
    mismatch
      (wanted
        ++ (if Exit.is_success ended then ", it succeeded" else ", it died or was interrupted"))

to_match_snapshot : Show a => String -> Subject a ->{; AssertionFailed} Unit
let to_match_snapshot name (Subject actual) =
  let text = show actual
  match snapshot name text with
  | None -> ()
  | Some None ->
    mismatch ("no snapshot " ++ show name ++ " of this test; `flick test --update-snapshots` writes it")
  | Some (Some stored) ->
    mismatch
      ("snapshot " ++ show name ++ ": " ++ differ stored text
        ++ "\n`flick test --update-snapshots` writes the new one")

/// What the snapshot `name` of the running test holds for `text`: `None`
/// when it holds `text` or the run wrote it, `Some None` when there is none,
/// `Some (Some stored)` when it holds another text. The snapshots of a test
/// module are in `__snapshots__/<File>.snap` beside it, which only
/// `flick test --update-snapshots` writes.
snapshot : String -> String ->{} Option (Option String)
foreign effect snapshot from "flick:rt" "testSnapshot"

/// `Effect.exit`, which comes after this module among the built-in ones:
/// how `task` ends.
exit_of : ~(Eff r e a)^c ->{r} Exit e a
foreign effect exit_of from "flick:Effect" "flickExit"
  retention call

/// Fails the effectful test when the assertion failed.
check : Assertion ->{; AssertionFailed} Unit
let check assertion =
  match assertion with
  | Pass -> ()
  | Failed message -> Fail.fail (AssertionFailed message)

/// A pure test.
test : String -> (Unit -> Assertion) -> Test
foreign pure test from "flick:rt" "testPure"

/// An effectful test: it passes when the task succeeds and its scope, which
/// owns what the task acquires, closes cleanly. It runs with the live host
/// services, as a `main` of `Runner.Node` does; they outlive its scope, so
/// what it acquires may use them when it is released.
effect_test :
  forall e.
  String ->
  (forall s. Fiber.Provided {...Host.Live} s => Eff {Async, Scope s, ...Host.Live} e Unit) ->
  Test
foreign pure effect_test from "flick:rt" "testEffect"

/// A test reported as skipped and never run; of a group or a suite, each
/// test in it.
skip : Test -> Test
foreign pure skip from "flick:rt" "testSkip"

/// A test marked for a run of only the marked tests, as is each test in a
/// marked group or suite: while a test of the run is marked, the others are
/// reported as skipped. `flick test --forbid-only` fails a run with one.
only : Test -> Test
foreign pure only from "flick:rt" "testOnly"

/// Virtual time: the clock a `clock_test` runs on, which moves only when
/// the test moves it.
service VirtualTime

/// An effectful test on a clock of its own that starts at 0 and moves only
/// by `adjust` and `set_time`: a sleep, a timeout or a retry schedule waits
/// for virtual time, not real time. Each test has its own clock.
clock_test :
  forall e.
  String ->
  (forall s. Fiber.Provided {VirtualTime, ...Host.Live} s => Eff
    {Async, Scope s, VirtualTime, ...Host.Live}
    e
    Unit) ->
  Test
foreign pure clock_test from "flick:rt" "testClock"

/// Moves the clock forward by `duration`, running what was waiting for it.
adjust : Duration.Duration ->{Async, VirtualTime} Unit
foreign effect adjust from "flick:rt" "testAdjust"

/// Sets the clock to `millis` since the epoch, running what was waiting
/// until then.
set_time : Float ->{Async, VirtualTime} Unit
foreign effect set_time from "flick:rt" "testSetTime"

/// Checks `check` on 100 values of `gen`, from the run's seed.
property : String -> Gen.Gen a -> (a -> Assertion) -> Test
foreign pure property from "flick:rt" "testProperty"

/// Tests under a common name prefix. The hooks among them run around those
/// that a run selects: see `before_all`.
group : String -> List Test -> Test
foreign pure group from "flick:rt" "testGroup"

/// A hook of the group, or the module, whose list it is in: it runs once
/// before the first of the group's tests that the run selects, after the
/// `before_all` hooks of the groups around it. A group none of whose tests
/// the run selects runs no hooks, and a skipped or filtered test runs none.
/// When it fails, each selected test of the group is reported as a `setup`
/// failure and not run, and the group's `after_all` hooks, and those of the
/// groups around it, still run. It runs in the group's scope, which closes
/// after the group's last selected test, within the group's `timeout`, if it
/// has one: out of time, it fails the setup of the group's tests.
before_all :
  forall e.
  (forall s. Fiber.Provided {...Host.Live} s => Eff {Async, Scope s, ...Host.Live} e Unit) -> Test
foreign pure before_all from "flick:rt" "testBeforeAll"

/// A hook that runs before each selected test of its group, in the test's
/// scope, after the `before_all` hooks and the `before_each` hooks of the
/// groups around it, and under the test's `timeout`. When it fails, the
/// test is reported as a `setup` failure and its body does not run.
before_each :
  forall e.
  (forall s. Fiber.Provided {...Host.Live} s => Eff {Async, Scope s, ...Host.Live} e Unit) -> Test
foreign pure before_each from "flick:rt" "testBeforeEach"

/// A hook that runs after each selected test of its group, as a finalizer
/// of the test's scope: also when the test or a `before_each` hook failed,
/// timed out or was interrupted, before the `after_each` hooks of the groups
/// around it, within its group's `timeout`, if it has one. When it fails or
/// runs out of time, the test reports its cleanup failed.
after_each :
  forall e.
  (forall s. Fiber.Provided {...Host.Live} s => Eff {Async, Scope s, ...Host.Live} e Unit) -> Test
foreign pure after_each from "flick:rt" "testAfterEach"

/// A hook that runs once after the last selected test of its group, as a
/// finalizer of the group's scope, before the `after_all` hooks of the
/// groups around it: also when a `before_all` hook failed or the run was
/// interrupted, within the group's `timeout`, if it has one. When it fails or
/// runs out of time, the test that ended the group reports its cleanup
/// failed.
after_all :
  forall e.
  (forall s. Fiber.Provided {...Host.Live} s => Eff {Async, Scope s, ...Host.Live} e Unit) -> Test
foreign pure after_all from "flick:rt" "testAfterAll"

/// A fixture of the tests of a suite, which their code awaits: made by its
/// initializer the first time code of one of them asks for it, for each
/// test or, shared, once for each run of its suite.
type Fixture (e : ErrorRow) a

/// What a `fixture name = expression` of a suite stands for: a fixture
/// that `init` makes for each test that uses it, in a scope of the test's
/// own. That scope owns what `init` acquires, the value `Resource.own`s
/// included, which holds its region `t`, and closes after the test's
/// `after_each` hooks, releasing it in the reverse order it was acquired.
fixture :
  String ->
  (forall t. Fiber.Provided {...Host.Live} t => Eff {Async, Scope t, ...Host.Live} e a^{t}) ->
  Fixture e a
foreign pure fixture from "flick:rt" "testFixture"

/// What a `fixture shared name = expression` stands for: a fixture that
/// `init` makes once for each run of the suite whose list `share`s it, in
/// a scope of that run's own, which closes after the suite's `after_all`
/// hooks, once its last selected test has ended.
shared :
  String ->
  (forall t. Fiber.Provided {...Host.Live} t => Eff {Async, Scope t, ...Host.Live} e a^{t}) ->
  Fixture e a
foreign pure shared from "flick:rt" "testShared"

/// The item of a group's list that makes the group the owner of the shared
/// fixture `fixture`.
share : Fixture e a -> Test
foreign pure share from "flick:rt" "testShare"

/// The `Lazy` of `fixture` for the test, or the run of the suite, this code
/// runs for. Its value holds no region: code that keeps it past the test,
/// or the suite's last test for a shared one, keeps what may be released.
use : Fixture e a ->{} Lazy {...Host.Live} e a
foreign effect use from "flick:rt" "testUse"

/// The test, and each test in it, run one at a time, also under
/// `flick test --jobs`, while the tests of other groups run beside them: a
/// group whose tests share a fixture is so.
serial : Test -> Test
foreign pure serial from "flick:rt" "testSerial"

/// The test, and each test in it that has no timeout of its own, given
/// `millis` milliseconds for its `before_each` hooks and its body; when they
/// run out, the test is interrupted, its scope closes and it is reported as
/// `timeout`. The hooks of a group have its time too. `flick test --timeout`
/// gives the other tests and groups theirs.
timeout : Float -> Test -> Test
foreign pure timeout from "flick:rt" "testTimeout"

/// A test of a suite, which gets the services `o` of its layer.
type Spec (o : ServiceRow)

/// Tests that share what `layer` makes: it is built once, before the first
/// of them that runs, and released after the last, the `beforeAll` and
/// `afterAll` of the suite. A failed build fails each of its tests.
suite : String -> Layer {Async, ...Host.Live} e o -> List (Spec o) -> Test
foreign pure suite from "flick:rt" "testSuite"

/// An effectful test of a suite: `effect_test` with the suite's services,
/// which outlive its scope too.
it :
  forall o e.
  String ->
  (forall s. Fiber.Provided {...Host.Live | o} s => Eff {Async, Scope s, ...Host.Live | o} e Unit) ->
  Spec o
foreign pure it from "flick:rt" "testEffect"
