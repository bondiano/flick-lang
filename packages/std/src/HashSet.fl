/// Immutable hash sets; each set keeps its witness.
module HashSet exposing (..)

import EqHash

/// A set of elements `a` under the witness `w`.
type HashSet w a

/// The empty set of the witness.
with : EqHash.EqHash w a -> HashSet w a
foreign pure with from "flick:rt" "hashSetWith"

/// The empty set of the canonical instances.
empty : Hash a => HashSet EqHash.Canonical a
foreign pure empty from "flick:rt" "hashSetEmpty"

/// The set of the elements under the witness.
from_list : EqHash.EqHash w a -> List a -> HashSet w a
foreign pure from_list from "flick:rt" "hashSetFromList"

/// The set of the elements of a sequence, such as a `for`.
from_seq : EqHash.EqHash w a -> (Seq a)^d -> HashSet w a
let from_seq witness elements = from_list witness (Seq.to_list elements)

/// The elements as a sequence, in no particular order.
to_seq : HashSet w a -> Seq a
let to_seq set = Seq.of_list (to_list set)

/// The set with the element.
insert : a -> HashSet w a -> HashSet w a
foreign pure insert from "flick:rt" "hashSetInsert"

/// The set without the element.
remove : a -> HashSet w a -> HashSet w a
foreign pure remove from "flick:rt" "hashSetRemove"

/// Whether the set has the element.
member : a -> HashSet w a -> Bool
foreign pure member from "flick:rt" "hashSetMember"

/// The number of elements.
size : HashSet w a -> Int
foreign pure size from "flick:rt" "hashSetSize"

/// The elements, in no particular order.
to_list : HashSet w a -> List a
foreign pure to_list from "flick:rt" "hashSetToList"

/// Both sets: their witness must be the same.
union : HashSet w a -> HashSet w a -> HashSet w a
foreign pure union from "flick:rt" "hashSetUnion"

/// The same elements under another witness.
rehash : EqHash.EqHash v a -> HashSet w a -> HashSet v a
foreign pure rehash from "flick:rt" "hashSetRehash"

/// Whether the set has no elements.
is_empty : HashSet w a -> Bool
foreign pure is_empty from "flick:HashSet" "flickIsEmpty"

/// `intersection that set`: the elements of `set` that `that` has too.
intersection : HashSet w a -> HashSet w a -> HashSet w a
foreign pure intersection from "flick:HashSet" "flickIntersection"

/// `difference that set`: the elements of `set` that `that` lacks.
difference : HashSet w a -> HashSet w a -> HashSet w a
foreign pure difference from "flick:HashSet" "flickDifference"

/// `is_subset that set`: whether `that` has every element of `set`.
is_subset : HashSet w a -> HashSet w a -> Bool
foreign pure is_subset from "flick:HashSet" "flickIsSubset"

/// Each element mapped by `f`, into a set of the witness given.
map : EqHash.EqHash v b -> (a -> b)^c -> (HashSet w a -> HashSet v b)^c
foreign pure map from "flick:HashSet" "flickMap"
  arity 3
  retention call

/// The elements for which `f` holds.
filter : (a -> Bool)^c -> HashSet w a -> HashSet w a
foreign pure filter from "flick:HashSet" "flickFilter"
  arity 2
  retention call

/// Whether `f` holds for some element.
some : (a -> Bool)^c -> HashSet w a -> Bool
foreign pure some from "flick:HashSet" "flickSome"
  arity 2
  retention call

/// Whether `f` holds for every element.
every : (a -> Bool)^c -> HashSet w a -> Bool
foreign pure every from "flick:HashSet" "flickEvery"
  arity 2
  retention call

/// Folds the elements in no particular order.
reduce : z -> (z -> a -> z)^c -> (HashSet w a -> z)^c
foreign pure reduce from "flick:HashSet" "flickReduce"
  arity 3
  retention call

/// A set as a JSON array of its elements, rebuilt with the canonical
/// instances; a repeated element is kept once.
json : Hash a => PureCodec Json a -> PureCodec Json (HashSet EqHash.Canonical a)
foreign pure json from "flick:Schema" "flickHashSetJson"
