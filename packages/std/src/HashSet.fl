/// Immutable hash sets; each set keeps its witness.
module HashSet exposing (..)

import EqHash
import HashMap.Trie as Trie

/// A set of elements `a` under the witness `w`.
type HashSet w a = SetTrie (EqHash.EqHash w a) (Trie.Node a Unit) Int
  @native when js || go || vm

/// The empty set of the witness.
with : EqHash.EqHash w a -> HashSet w a
let with witness = SetTrie witness Trie.Empty 0
  @native "flick:rt" "hashSetWith" when js || go || vm

/// The empty set of the canonical instances.
empty : Hash a => HashSet EqHash.Canonical a
let empty = SetTrie EqHash.canonical Trie.Empty 0
  @native "flick:rt" "hashSetEmpty" when js || go || vm

/// The set of the elements under the witness.
from_list : EqHash.EqHash w a -> List a -> HashSet w a
let from_list witness values =
  match witness with
  | EqHash.Witness eq hash ->
    let (root, size) =
      List.fold_left
        (fun acc value -> Trie.add eq true (hash value) value () acc)
        (Trie.Empty, 0)
        values
    SetTrie witness root size
  @native "flick:rt" "hashSetFromList" when js || go || vm

/// The set of the elements of a sequence, such as a `for`, consumed once in
/// order without a temporary list.
from_seq : EqHash.EqHash w a -> (Seq a)^d -> HashSet w a
foreign pure from_seq from "flick:rt" "hashSetFromSeq"
  retention call

/// The elements as a lazy, restartable sequence in traversal order: a source of `for`.
to_seq : HashSet w a -> Seq a
foreign pure to_seq from "flick:rt" "hashSetToSeq"

/// The set with the element.
insert : a -> HashSet w a -> HashSet w a
let insert value set =
  match set with
  | SetTrie witness root size ->
    match witness with
    | EqHash.Witness eq hash ->
      let (next, n) = Trie.add eq true (hash value) value () (root, size)
      SetTrie witness next n
  @native "flick:rt" "hashSetInsert" when js || go || vm

/// The set without the element.
remove : a -> HashSet w a -> HashSet w a
let remove value set =
  match set with
  | SetTrie witness root size ->
    match witness with
    | EqHash.Witness eq hash ->
      let (next, n) = Trie.delete eq value (hash value) (root, size)
      SetTrie witness next n
  @native "flick:rt" "hashSetRemove" when js || go || vm

/// Whether the set has the element.
member : a -> HashSet w a -> Bool
let member value set =
  match set with
  | SetTrie witness root _ ->
    match witness with
    | EqHash.Witness eq hash ->
      match Trie.find eq value (hash value) root with
      | Some _ -> true
      | None -> false
  @native "flick:rt" "hashSetMember" when js || go || vm

/// The number of elements.
size : HashSet w a -> Int
let size set =
  match set with
  | SetTrie _ _ size -> size
  @native "flick:rt" "hashSetSize" when js || go || vm

/// The elements, in no particular order.
to_list : HashSet w a -> List a
let to_list set =
  match set with
  | SetTrie _ root _ -> List.map (fun (value, _) -> value) (Trie.entries root)
  @native "flick:rt" "hashSetToList" when js || go || vm

/// Both sets: their witness must be the same.
union : HashSet w a -> HashSet w a -> HashSet w a
let union left right =
  match left with
  | SetTrie witness root size ->
    match witness with
    | EqHash.Witness eq hash ->
      match right with
      | SetTrie _ other_root _ ->
        let (next, n) =
          Trie.fold
            (fun acc value _ -> Trie.add eq true (hash value) value () acc)
            (root, size)
            other_root
        SetTrie witness next n
  @native "flick:rt" "hashSetUnion" when js || go || vm

/// The same elements under another witness.
rehash : EqHash.EqHash v a -> HashSet w a -> HashSet v a
let rehash witness set =
  match witness with
  | EqHash.Witness eq hash ->
    match set with
    | SetTrie _ other_root _ ->
      let (next, n) =
        Trie.fold
          (fun acc value _ -> Trie.add eq true (hash value) value () acc)
          (Trie.Empty, 0)
          other_root
      SetTrie witness next n
  @native "flick:rt" "hashSetRehash" when js || go || vm

/// Whether the set has no elements.
is_empty : HashSet w a -> Bool
let is_empty set =
  match set with
  | SetTrie _ _ size -> size == 0
  @native "flick:HashSet" "flickIsEmpty" when js || go || vm

/// `intersection that set`: the elements of `set` that `that` has too.
intersection : HashSet w a -> HashSet w a -> HashSet w a
let intersection that set =
  match set with
  | SetTrie witness root _ ->
    match witness with
    | EqHash.Witness eq hash ->
      match that with
      | SetTrie other_witness other_root _ ->
        match other_witness with
        | EqHash.Witness other_eq other_hash ->
          let keep acc value _ =
            match Trie.find other_eq value (other_hash value) other_root with
            | Some _ -> Trie.add eq true (hash value) value () acc
            | None -> acc
          let (next, n) = Trie.fold keep (Trie.Empty, 0) root
          SetTrie witness next n
  @native "flick:HashSet" "flickIntersection" when js || go || vm

/// `difference that set`: the elements of `set` that `that` lacks.
difference : HashSet w a -> HashSet w a -> HashSet w a
let difference that set =
  match set with
  | SetTrie witness root _ ->
    match witness with
    | EqHash.Witness eq hash ->
      match that with
      | SetTrie other_witness other_root _ ->
        match other_witness with
        | EqHash.Witness other_eq other_hash ->
          let keep acc value _ =
            match Trie.find other_eq value (other_hash value) other_root with
            | Some _ -> acc
            | None -> Trie.add eq true (hash value) value () acc
          let (next, n) = Trie.fold keep (Trie.Empty, 0) root
          SetTrie witness next n
  @native "flick:HashSet" "flickDifference" when js || go || vm

/// `is_subset that set`: whether `that` has every element of `set`.
is_subset : HashSet w a -> HashSet w a -> Bool
let is_subset that set =
  match set with
  | SetTrie _ root _ ->
    match that with
    | SetTrie other_witness other_root _ ->
      match other_witness with
      | EqHash.Witness other_eq other_hash ->
        let missing value _ =
          match Trie.find other_eq value (other_hash value) other_root with
          | Some _ -> false
          | None -> true
        match Trie.first missing root with
        | Some _ -> false
        | None -> true
  @native "flick:HashSet" "flickIsSubset" when js || go || vm

/// Each element mapped by `f`, into a set of the witness given.
map : EqHash.EqHash v b -> (a -> b)^c -> (HashSet w a -> HashSet v b)^c
let map witness f set =
  match witness with
  | EqHash.Witness eq hash ->
    match set with
    | SetTrie _ other_root _ ->
      let add acc value _ =
        let mapped = f value
        Trie.add eq true (hash mapped) mapped () acc
      let (next, n) = Trie.fold add (Trie.Empty, 0) other_root
      SetTrie witness next n
  @native "flick:HashSet" "flickMap" when js || go || vm
    arity 3
    retention call

/// The elements for which `f` holds.
filter : (a -> Bool)^c -> HashSet w a -> HashSet w a
let filter f set =
  match set with
  | SetTrie witness root _ ->
    match witness with
    | EqHash.Witness eq hash ->
      let (next, n) =
        Trie.fold
          (fun acc value _ -> if f value then Trie.add eq true (hash value) value () acc else acc)
          (Trie.Empty, 0)
          root
      SetTrie witness next n
  @native "flick:HashSet" "flickFilter" when js || go || vm
    arity 2
    retention call

/// Whether `f` holds for some element.
some : (a -> Bool)^c -> HashSet w a -> Bool
let some f set =
  match set with
  | SetTrie _ root _ ->
    match Trie.first (fun value _ -> f value) root with
    | Some _ -> true
    | None -> false
  @native "flick:HashSet" "flickSome" when js || go || vm
    arity 2
    retention call

/// Whether `f` holds for every element.
every : (a -> Bool)^c -> HashSet w a -> Bool
let every f set =
  match set with
  | SetTrie _ root _ ->
    match Trie.first (fun value _ -> not (f value)) root with
    | Some _ -> false
    | None -> true
  @native "flick:HashSet" "flickEvery" when js || go || vm
    arity 2
    retention call

/// Folds the elements in no particular order.
reduce : z -> (z -> a -> z)^c -> (HashSet w a -> z)^c
let reduce zero f set =
  match set with
  | SetTrie _ root _ -> Trie.fold (fun acc value _ -> f acc value) zero root
  @native "flick:HashSet" "flickReduce" when js || go || vm
    arity 3
    retention call

/// A set as a JSON array of its elements, rebuilt with the canonical
/// instances; a repeated element is kept once.
json : Hash a => PureCodec Json a -> PureCodec Json (HashSet EqHash.Canonical a)
foreign pure json from "flick:Schema" "flickHashSetJson"

to_seq_held : (HashSet w a)^d -> (Seq a)^d
foreign pure to_seq_held from "flick:rt" "hashSetToSeq"
  retention call

instance Eq (HashSet w a) =
  let eq left right = size left == size right && is_subset right left

instance Foldable (HashSet w) =
  let fold f init set = reduce init f set

instance Semigroup (HashSet w a) =
  let combine left right = union left right

instance Hash a => Monoid (HashSet EqHash.Canonical a) =
  let empty = empty

instance Collections.ToSeq (HashSet w a) a =
  let to_seq set = to_seq_held set

instance Collections.Sized (HashSet w a) =
  let size set = size set
  let is_empty set = is_empty set

instance Collections.Member (HashSet w a) a =
  let member value set = member value set
