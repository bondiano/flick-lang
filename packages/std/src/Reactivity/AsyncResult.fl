/// The value of an atom an effect computes. It is not there yet, it
/// succeeded, or it failed, and each case may be waiting for a run that has
/// started again. The module is experimental.
module Reactivity.AsyncResult exposing (..)

/// The state of an effect's result: initial, a success of `a` or a failure
/// with the cause of `e`, waiting or not.
type AsyncResult a (e : ErrorRow)

/// `initial` when nothing has finished, else `success` of the value or
/// `failure` of what went wrong.
fold : b -> (a -> b) -> (Failure e -> b) -> AsyncResult a e -> b
foreign pure fold from "flick:reactivity/AsyncResult" "flickFold"

/// The value of a success, the last one kept by a failure, else `None`.
value : AsyncResult a e -> Option a
foreign pure value from "flick:reactivity/AsyncResult" "value"

/// Whether a run is under way.
is_waiting : AsyncResult a e -> Bool
foreign pure is_waiting from "flick:reactivity/AsyncResult" "isWaiting"
