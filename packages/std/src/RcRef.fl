/// A resource shared by reference count. It is acquired on the first `get`,
/// kept while some `scope` holds it, and released when the last one closes
/// (after an idle time) or when the `scope` owning the reference does.
module RcRef exposing (..)

import Duration

/// A shared resource of `a` of region `s`, whose acquisition fails with `e`.
type RcRef (s : Region) (e : ErrorRow) a

/// A reference owned by the innermost `scope` (or the one of region `s`);
/// `acquire` runs with the services of this call, and the resource stays
/// for `idleTimeToLive` after its last holder (`None`: no time).
make :
  { acquire : Eff r e a; idleTimeToLive : Option Duration.Duration } ->{Scope s | r} RcRef s e a
foreign effect make from "flick:RcRef" "flickMake"
  reviewed "effect@4.1.2 sha256:e19931a575c79b4b"

/// The resource, acquiring it if no one holds it; the innermost `scope`
/// (or the one of region `t`) holds it until it closes.
get : RcRef s e a ->{Scope t; e} a^{t}
foreign effect get from "flick:RcRef" "get"
  retention call
  reviewed "effect@4.1.2 sha256:bd017d10758c36d1"

/// Releases the resource once its holders are done; the next `get`
/// acquires it again.
invalidate : RcRef s e a ->{Async} Unit
foreign effect invalidate from "flick:RcRef" "invalidate"
  retention call
  reviewed "effect@4.1.2 sha256:1c1dccd0aab9e2c0"
