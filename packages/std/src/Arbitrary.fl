/// Generators of values with shrinking, made from a schema or combined, and
/// property checks over them. The seed of the options makes a run
/// reproducible; a failed check carries a replay.
module Arbitrary exposing (..)

/// A generator of values of type `a`.
type Arbitrary a

/// The text that replays a failed check exactly.
type alias Replay = String

/// The bounds of a generated list; `None` leaves one out.
type alias ArrayOptions = { minLength : Option Int; maxLength : Option Int }

/// How a value of a schema shrinks; `None` uses the default shrinking.
type alias SchemaOptions a = { shrink : Option (a -> List a) }

/// How many values to draw, how large, how many discards to allow, and
/// the seed.
type alias SampleOptions = {
  count : Option Int;
  size : Option Int;
  maxDiscards : Option Int;
  seed : Option Float;
}

/// The runs of a check, the sizes, the limits of discards and shrinks, the
/// seed, and a replay of an earlier failure.
type alias CheckOptions = {
  runs : Option Int;
  size : Option Int;
  maxDiscards : Option Int;
  maxShrinks : Option Int;
  seed : Option Float;
  replay : Option Replay;
}

/// Sampling stopped: the filters discarded too many values.
type error SampleError = SampleError { generated : Int; discards : Int; seed : String }
  deriving Eq, Show

/// Why a property failed: it returned `false`, or it failed with an error.
type PropertyFailure (e : ErrorRow) = ReturnedFalse | PropertyError (Errors e)

/// The outcome of a check.
type CheckResult (e : ErrorRow) a =
  | Passed { runs : Int; discards : Int }
  | Falsified {
    initialInput : a;
    shrunkInput : a;
    failure : PropertyFailure e;
    runs : Int;
    discards : Int;
    shrinks : Int;
    replay : Replay;
  }
  | Exhausted { runs : Int; discards : Int; seed : String }
  | ReplayMismatch String

/// Values of the schema.
from_schema : Schema a -> Arbitrary a
foreign pure from_schema from "flick:Arbitrary" "schema"

/// Values of the schema, shrinking by the options.
from_schema_with : SchemaOptions a -> Schema a -> Arbitrary a
foreign pure from_schema_with from "flick:Arbitrary" "flickSchema"

/// Always `value`.
constant : a -> Arbitrary a
foreign pure constant from "flick:Arbitrary" "Constant"

/// Lists of the item's values, within the bounds.
list : ArrayOptions -> Arbitrary a -> Arbitrary (List a)
foreign pure list from "flick:Arbitrary" "flickArray"

/// One value of each generator, in order.
all : List (Arbitrary a) -> Arbitrary (List a)
foreign pure all from "flick:Arbitrary" "all"

/// Two values, one of each generator, drawn and shrunk independently.
zip2 : Arbitrary a -> Arbitrary b -> Arbitrary (a, b)
foreign pure zip2 from "flick:Arbitrary" "flickZip2"

/// Three values, one of each generator, drawn and shrunk independently.
zip3 : Arbitrary a -> Arbitrary b -> Arbitrary c -> Arbitrary (a, b, c)
foreign pure zip3 from "flick:Arbitrary" "flickZip3"

/// Four values, one of each generator, drawn and shrunk independently.
zip4 : Arbitrary a -> Arbitrary b -> Arbitrary c -> Arbitrary d -> Arbitrary (a, b, c, d)
foreign pure zip4 from "flick:Arbitrary" "flickZip4"

/// Each value mapped by `f`.
map : (a -> b) -> Arbitrary a -> Arbitrary b
foreign pure map from "flick:Arbitrary" "map"
  arity 1

/// The values for which `f` holds; the others are discarded.
filter : (a -> Bool) -> Arbitrary a -> Arbitrary a
foreign pure filter from "flick:Arbitrary" "filter"
  arity 1

/// The `Ok` values of `f`; an `Err` discards the value.
filter_map : (a -> Result x b) -> Arbitrary a -> Arbitrary b
foreign pure filter_map from "flick:Arbitrary" "filterMap"
  arity 1

/// A value of the generator `f` gives for each value.
flat_map : (a -> Arbitrary b) -> Arbitrary a -> Arbitrary b
foreign pure flat_map from "flick:Arbitrary" "flatMap"
  arity 1

/// Draws values; drawing from the system's randomness without a seed.
sample : SampleOptions -> Arbitrary a ->{; SampleError} List a
foreign effect sample from "flick:Arbitrary" "flickSampleEffect"

/// Runs the property on generated values and shrinks the first failure.
check : CheckOptions -> (a ->{r; e} Bool)^c -> Arbitrary a ->{r} CheckResult e a
foreign effect check from "flick:Arbitrary" "flickCheckEffect"
  retention call

/// The report of a failed check: inputs, failure and replay; `None` when
/// it passed.
format_check_failure : CheckResult e a -> Option String
foreign pure format_check_failure from "flick:Arbitrary" "flickFormatCheckFailure"
