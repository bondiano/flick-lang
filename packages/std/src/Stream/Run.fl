/// Running a stream: each `run_*` call runs it once in the current task,
/// with the services of its row. A callback a run calls may hold scoped
/// values (`^c`), since nothing keeps it past the call.
module Stream.Run exposing (..)

import PubSub
import Queue
import Stream.Core exposing (Stream)

/// The elements, once the stream ends.
run_collect : (Stream r e a)^c ->{r; e} List a
foreign effect run_collect from "flick:Stream" "runCollect"
  retention call

/// The number of elements.
run_count : (Stream r e a)^c ->{r; e} Int
foreign effect run_count from "flick:Stream" "runCount"
  retention call

/// The sum of the elements.
run_sum : (Stream r e Float)^c ->{r; e} Float
foreign effect run_sum from "flick:Stream" "runSum"
  retention call

/// Runs the stream for its effects.
run_drain : (Stream r e a)^c ->{r; e} Unit
foreign effect run_drain from "flick:Stream" "runDrain"
  retention call

/// The first element, if any; the rest is not run.
run_head : (Stream r e a)^c ->{r; e} Option a
foreign effect run_head from "flick:Stream" "runHead"
  retention call

/// The last element, if any.
run_last : (Stream r e a)^c ->{r; e} Option a
foreign effect run_last from "flick:Stream" "runLast"
  retention call

/// The elements folded by `f` from `initial`.
run_fold : z -> (z -> a -> z)^c -> ((Stream r e a)^c ->{r; e} z)^c
foreign effect run_fold from "flick:Stream" "flickRunFold"
  arity 2
  retention call

/// `run_fold` with a task as the step.
run_fold_effect : z -> (z -> a ->{r2; e2} z)^c -> ((Stream r e a)^c ->{r + r2; e + e2} z)^c
foreign effect run_fold_effect from "flick:Stream" "flickRunFoldEffect"
  arity 2
  retention call

/// Runs `f` on each element.
run_for_each : (a ->{r2; e2} x)^c -> (Stream r e a)^c ->{r + r2; e + e2} Unit
foreign effect run_for_each from "flick:Stream" "runForEach"
  arity 1
  retention call

/// Runs `f` on each element while it gives `true`.
run_for_each_while : (a ->{r2; e2} Bool)^c -> (Stream r e a)^c ->{r + r2; e + e2} Unit
foreign effect run_for_each_while from "flick:Stream" "runForEachWhile"
  arity 1
  retention call

/// Runs `f` on each chunk.
run_for_each_chunk :
  (NonEmpty.NonEmpty a ->{r2; e2} x)^c -> (Stream r e a)^c ->{r + r2; e + e2} Unit
foreign effect run_for_each_chunk from "flick:Stream" "runForEachArray"
  arity 1
  retention call

/// The strings joined.
mk_string : (Stream r e String)^c ->{r; e} String
foreign effect mk_string from "flick:Stream" "mkString"
  retention call

/// The chunks of bytes joined.
mk_bytes : (Stream r e (List Int))^c ->{r; e} List Int
foreign effect mk_bytes from "flick:Stream" "flickMkBytes"
  retention call

/// Publishes each element to the hub.
run_into_pubsub : PubSub.PubSub a -> (Stream r e a)^c ->{r; e} Unit
foreign effect run_into_pubsub from "flick:Stream" "runIntoPubSub"
  arity 1
  retention call

/// Offers each element to the queue, then ends it, or fails it with the
/// stream's failure.
run_into_queue : Queue.Queue e a -> (Stream r e a)^c ->{r} Unit
foreign effect run_into_queue from "flick:Stream" "runIntoQueue"
  arity 1
  retention call

/// A hub the stream publishes to, run as a child of the scope of region
/// `s`, which shuts the hub down when it closes: `capacity` messages
/// (`None`: no bound), the strategy for a full hub, the last `replay` for a
/// new subscriber.
to_pubsub :
  { capacity : Option Int; strategy : Option Queue.Strategy; replay : Option Int } ->
  (Stream r e a)^c ->{Scope s | r}
  PubSub.PubSub a
foreign effect to_pubsub from "flick:Stream" "flickToPubSub"
  arity 1
  retention owner

/// A queue the stream fills, run as a child of the scope of region `s`,
/// which shuts the queue down when it closes; the queue ends or fails as
/// the stream does.
to_queue :
  { capacity : Option Int; strategy : Option Queue.Strategy } ->
  (Stream r e a)^c ->{Scope s | r}
  Queue.Queue e a
foreign effect to_queue from "flick:Stream" "flickToQueue"
  arity 1
  retention owner
