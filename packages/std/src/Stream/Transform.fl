/// Streams changed element by element: mapped, filtered, cut, chunked,
/// accumulated and paced. A callback is stored in the stream, so the stream
/// holds what the callback holds (`^c`): a closure over a scoped value
/// makes a stream that cannot leave that scope, and may be used inside it.
module Stream.Transform exposing (..)

import Duration
import Filter
import Queue
import Stream.Core exposing (Stream)

/// What `throttle` does with a chunk over the budget: drop it, or delay it.
type ThrottleStrategy = Enforce | Shape

/// Each element mapped by `f`.
map : (a -> b)^c -> (Stream r e a)^c -> (Stream r e b)^c
foreign pure map from "flick:Stream" "map"
  arity 1
  retention call

/// Each element replaced by `value`.
as_ : b -> (Stream r e a)^c -> (Stream r e b)^c
foreign pure as_ from "flick:Stream" "as"
  arity 1
  retention call

/// The elements mapped by `onElement` and the error by `onError`.
map_both :
  { onElement : (a -> b)^c; onError : (Errors e -> Errors e2)^c } ->
  (Stream r e a)^c ->
  (Stream r e2 b)^c
foreign pure map_both from "flick:Stream" "mapBoth"
  arity 1
  retention call

/// The error mapped by `f`.
map_error : (Errors e -> Errors e2)^c -> (Stream r e a)^c -> (Stream r e2 a)^c
foreign pure map_error from "flick:Stream" "mapError"
  arity 1
  retention call

/// Each chunk of elements mapped by `f`.
map_chunks : (NonEmpty.NonEmpty a -> NonEmpty.NonEmpty b)^c -> (Stream r e a)^c -> (Stream r e b)^c
foreign pure map_chunks from "flick:Stream" "mapArray"
  arity 1
  retention call

/// Each element mapped by the task `f` gives, one at a time.
map_effect : (a ->{r2; e2} b)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) b)^c
foreign pure map_effect from "flick:Stream" "mapEffect"
  arity 1
  retention call

/// `map_effect` running at most `concurrency` tasks at once (`None`: no
/// bound) as children of the stream's run; `unordered` emits each result
/// as soon as it is ready.
map_effect_par :
  { concurrency : Option Int; unordered : Bool } ->
  (a ->{r2; e2} b)^c ->
  (Stream r e a)^c ->
  (Stream {Async | r + r2} (e + e2) b)^c
foreign pure map_effect_par from "flick:Stream" "flickMapEffectPar"
  arity 2
  retention call

/// Each chunk mapped by the task `f` gives.
map_chunks_effect :
  (NonEmpty.NonEmpty a ->{r2; e2} NonEmpty.NonEmpty b)^c ->
  (Stream r e a)^c ->
  (Stream (r + r2) (e + e2) b)^c
foreign pure map_chunks_effect from "flick:Stream" "mapArrayEffect"
  arity 1
  retention call

/// Runs each task element, emitting its value.
flatten_effect : (Stream r e (Eff r2 e2 a))^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure flatten_effect from "flick:Stream" "flattenEffect"
  retention call

/// The elements as `Ok` and the error, which ends the stream, as `Err`.
result : (Stream r e a)^c -> (Stream r none (Result (Errors e) a))^c
foreign pure result from "flick:Stream" "result"
  retention call

/// Runs `f` on each element, keeping it.
tap : (a ->{r2; e2} x)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure tap from "flick:Stream" "tap"
  arity 1
  retention call

/// Runs `onElement` on each element and `onError` on the error.
tap_both :
  {
    onElement : (a ->{r2; e2} x)^c;
    onError : (Errors e ->{r3; e3} y)^c;
  } ->
  (Stream r e a)^c ->
  (Stream (r + r2 + r3) (e + e2 + e3) a)^c
foreign pure tap_both from "flick:Stream" "tapBoth"
  arity 1
  retention call

/// The elements `p` keeps.
filter : (a -> Bool)^c -> (Stream r e a)^c -> (Stream r e a)^c
foreign pure filter from "flick:Stream" "filter"
  arity 1
  retention call

/// The values the filter passes.
filter_map : Filter.Filter a b x -> (Stream r e a)^c -> (Stream r e b)^c
foreign pure filter_map from "flick:Stream" "filterMap"
  arity 1
  retention call

/// The elements the task `p` keeps.
filter_effect : (a ->{r2; e2} Bool)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure filter_effect from "flick:Stream" "filterEffect"
  arity 1
  retention call

/// The values the effectful filter passes.
filter_map_effect :
  Filter.FilterEffect r2 e2 a b x -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) b)^c
foreign pure filter_map_effect from "flick:Stream" "filterMapEffect"
  arity 1
  retention call

/// The first `n` elements.
take : Int -> (Stream r e a)^c -> (Stream r e a)^c
foreign pure take from "flick:Stream" "take"
  arity 1
  retention call

/// The last `n` elements, once the stream ends.
take_right : Int -> (Stream r e a)^c -> (Stream r e a)^c
foreign pure take_right from "flick:Stream" "takeRight"
  arity 1
  retention call

/// The elements up to and including the first that `p` holds for.
take_until : (a -> Bool)^c -> (Stream r e a)^c -> (Stream r e a)^c
foreign pure take_until from "flick:Stream" "takeUntil"
  arity 1
  retention call

/// `take_until` with a task as the test.
take_until_effect : (a ->{r2; e2} Bool)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure take_until_effect from "flick:Stream" "takeUntilEffect"
  arity 1
  retention call

/// The elements while `p` holds.
take_while : (a -> Bool)^c -> (Stream r e a)^c -> (Stream r e a)^c
foreign pure take_while from "flick:Stream" "takeWhile"
  arity 1
  retention call

/// The values while the filter passes them.
take_while_filter : Filter.Filter a b x -> (Stream r e a)^c -> (Stream r e b)^c
foreign pure take_while_filter from "flick:Stream" "takeWhileFilter"
  arity 1
  retention call

/// `take_while` with a task as the test.
take_while_effect : (a ->{r2; e2} Bool)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure take_while_effect from "flick:Stream" "takeWhileEffect"
  arity 1
  retention call

/// All but the first `n` elements.
drop : Int -> (Stream r e a)^c -> (Stream r e a)^c
foreign pure drop from "flick:Stream" "drop"
  arity 1
  retention call

/// All but the last `n` elements.
drop_right : Int -> (Stream r e a)^c -> (Stream r e a)^c
foreign pure drop_right from "flick:Stream" "dropRight"
  arity 1
  retention call

/// The elements after the first that `p` holds for.
drop_until : (a -> Bool)^c -> (Stream r e a)^c -> (Stream r e a)^c
foreign pure drop_until from "flick:Stream" "dropUntil"
  arity 1
  retention call

/// `drop_until` with a task as the test.
drop_until_effect : (a ->{r2; e2} Bool)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure drop_until_effect from "flick:Stream" "dropUntilEffect"
  arity 1
  retention call

/// The elements from the first that `p` does not hold for.
drop_while : (a -> Bool)^c -> (Stream r e a)^c -> (Stream r e a)^c
foreign pure drop_while from "flick:Stream" "dropWhile"
  arity 1
  retention call

/// The elements from the first the filter refuses.
drop_while_filter : Filter.Filter a b x -> (Stream r e a)^c -> (Stream r e a)^c
foreign pure drop_while_filter from "flick:Stream" "dropWhileFilter"
  arity 1
  retention call

/// `drop_while` with a task as the test.
drop_while_effect : (a ->{r2; e2} Bool)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure drop_while_effect from "flick:Stream" "dropWhileEffect"
  arity 1
  retention call

/// The stream if `test` gives true when it starts, else no elements.
when_ : Eff r2 e2 Bool -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure when_ from "flick:Stream" "when"
  arity 1
  retention call

/// The chunks of the stream as elements.
chunks : (Stream r e a)^c -> (Stream r e (NonEmpty.NonEmpty a))^c
foreign pure chunks from "flick:Stream" "chunks"
  retention call

/// The same elements in chunks of `size`.
rechunk : Int -> (Stream r e a)^c -> (Stream r e a)^c
foreign pure rechunk from "flick:Stream" "rechunk"
  arity 1
  retention call

/// The windows of `size` consecutive elements, one step apart.
sliding : Int -> (Stream r e a)^c -> (Stream r e (NonEmpty.NonEmpty a))^c
foreign pure sliding from "flick:Stream" "sliding"
  arity 1
  retention call

/// The windows of `size` elements, `step` apart.
sliding_size : Int -> Int -> (Stream r e a)^c -> (Stream r e (NonEmpty.NonEmpty a))^c
foreign pure sliding_size from "flick:Stream" "slidingSize"
  arity 2
  retention call

/// The runs of elements between those `p` holds for, which are dropped.
split : (a -> Bool)^c -> (Stream r e a)^c -> (Stream r e (NonEmpty.NonEmpty a))^c
foreign pure split from "flick:Stream" "split"
  arity 1
  retention call

/// Groups of `n` elements; the last may be shorter.
grouped : Int -> (Stream r e a)^c -> (Stream r e (NonEmpty.NonEmpty a))^c
foreign pure grouped from "flick:Stream" "grouped"
  arity 1
  retention call

/// Groups of at most `n` elements, each emitted at the latest after the
/// duration.
grouped_within : Int -> Duration.Duration -> (Stream r e a)^c -> (Stream r e (List a))^c
foreign pure grouped_within from "flick:Stream" "groupedWithin"
  arity 2
  retention call

/// Runs of consecutive elements with the same key.
group_adjacent_by : (a -> k)^c -> (Stream r e a)^c -> (Stream r e (k, NonEmpty.NonEmpty a))^c
foreign pure group_adjacent_by from "flick:Stream" "groupAdjacentBy"
  arity 1
  retention call

/// `f` maps each element to a state and the elements to emit, from
/// `initial`.
map_accum : s -> (s -> a -> (s, List b))^c -> ((Stream r e a)^c -> (Stream r e b)^c)^c
foreign pure map_accum from "flick:Stream" "flickMapAccum"
  arity 2
  retention call

/// `map_accum` over the chunks.
map_accum_chunks :
  s -> (s -> NonEmpty.NonEmpty a -> (s, List b))^c -> ((Stream r e a)^c -> (Stream r e b)^c)^c
foreign pure map_accum_chunks from "flick:Stream" "flickMapAccumArray"
  arity 2
  retention call

/// `map_accum` with a task as the step.
map_accum_effect :
  s -> (s -> a ->{r2; e2} (s, List b))^c -> ((Stream r e a)^c -> (Stream (r + r2) (e + e2) b)^c)^c
foreign pure map_accum_effect from "flick:Stream" "flickMapAccumEffect"
  arity 2
  retention call

/// `map_accum_chunks` with a task as the step.
map_accum_chunks_effect :
  s ->
  (s -> NonEmpty.NonEmpty a ->{r2; e2} (s, List b))^c ->
  ((Stream r e a)^c -> (Stream (r + r2) (e + e2) b)^c)^c
foreign pure map_accum_chunks_effect from "flick:Stream" "flickMapAccumArrayEffect"
  arity 2
  retention call

/// `initial`, then each state `f` folds from the previous one and an element.
scan : s -> (s -> a -> s)^c -> ((Stream r e a)^c -> (Stream r e s)^c)^c
foreign pure scan from "flick:Stream" "flickScan"
  arity 2
  retention call

/// `scan` with a task as the step.
scan_effect : s -> (s -> a ->{r2; e2} s)^c -> ((Stream r e a)^c -> (Stream (r + r2) (e + e2) s)^c)^c
foreign pure scan_effect from "flick:Stream" "flickScanEffect"
  arity 2
  retention call

/// One list of all the elements, once the stream ends.
collect : (Stream r e a)^c -> (Stream r e (List a))^c
foreign pure collect from "flick:Stream" "collect"
  retention call

/// The elements so far, after each chunk.
accumulate : (Stream r e a)^c -> (Stream r e (NonEmpty.NonEmpty a))^c
foreign pure accumulate from "flick:Stream" "accumulate"
  retention call

/// The elements that differ (`==`) from the one before.
changes : (Stream r e a)^c -> (Stream r e a)^c
foreign pure changes from "flick:Stream" "changes"
  retention call

/// The elements that `same` tells apart from the one before.
changes_with : (a -> a -> Bool)^c -> (Stream r e a)^c -> (Stream r e a)^c
foreign pure changes_with from "flick:Stream" "changesWith"
  arity 1
  retention call

/// `changes_with` with a task as the test.
changes_with_effect :
  (a -> a ->{r2; e2} Bool)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure changes_with_effect from "flick:Stream" "changesWithEffect"
  arity 1
  retention call

/// `separator` between the elements.
intersperse : a -> (Stream r e a)^c -> (Stream r e a)^c
foreign pure intersperse from "flick:Stream" "intersperse"
  arity 1
  retention call

/// `start`, the elements with `middle` between them, and `end`.
intersperse_affixes : { start : a; middle : a; end : a } -> (Stream r e a)^c -> (Stream r e a)^c
foreign pure intersperse_affixes from "flick:Stream" "intersperseAffixes"
  arity 1
  retention call

/// The last element of each burst, once the duration passes without one.
debounce : Duration.Duration -> (Stream r e a)^c -> (Stream r e a)^c
foreign pure debounce from "flick:Stream" "debounce"
  arity 1
  retention call

/// The chunks paced to `units` of `cost` per `duration`, with `burst`
/// units more at once (`None`: 0); `Shape` delays a chunk over the budget,
/// `Enforce` (the default) drops it. Costs and units are Floats: a budget
/// can be fractional.
throttle :
  {
    cost : (NonEmpty.NonEmpty a -> Float)^c;
    units : Float;
    duration : Duration.Duration;
    burst : Option Float;
    strategy : Option ThrottleStrategy;
  } ->
  (Stream r e a)^c ->
  (Stream r e a)^c
foreign pure throttle from "flick:Stream" "flickThrottle"
  arity 1
  retention call

/// `throttle` with a task as the cost.
throttle_effect :
  {
    cost : (NonEmpty.NonEmpty a ->{r2; e2} Float)^c;
    units : Float;
    duration : Duration.Duration;
    burst : Option Float;
    strategy : Option ThrottleStrategy;
  } ->
  (Stream r e a)^c ->
  (Stream (r + r2) (e + e2) a)^c
foreign pure throttle_effect from "flick:Stream" "flickThrottleEffect"
  arity 1
  retention call

/// Elements read ahead into a buffer of `capacity` (`None`: no bound),
/// with the strategy for a full one (`None`: `Suspend`).
buffer :
  { capacity : Option Int; strategy : Option Queue.Strategy } ->
  (Stream r e a)^c ->
  (Stream r e a)^c
foreign pure buffer from "flick:Stream" "flickBuffer"
  arity 1
  retention call

/// `buffer` counting chunks instead of elements.
buffer_chunks :
  { capacity : Option Int; strategy : Option Queue.Strategy } ->
  (Stream r e a)^c ->
  (Stream r e a)^c
foreign pure buffer_chunks from "flick:Stream" "flickBufferArray"
  arity 1
  retention call
