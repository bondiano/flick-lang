/// Streams combined: one after another, nested, merged, zipped, raced,
/// repeated and split. What runs concurrently runs as children of the
/// stream's run, interrupted when it ends; a stream split for consumers in
/// a `scope` (`broadcast`, `share`, `partition`) belongs to that scope.
module Stream.Combine exposing (..)

import Duration
import Fiber
import Filter
import Queue
import Schedule
import Stream.Core exposing (Stream, HaltStrategy)

/// `first` and then `second`: `first |> Stream.concat second`.
concat : (Stream r2 e2 a)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure concat from "flick:Stream" "concat"
  arity 1
  retention call

/// The values before the elements of the stream.
prepend : List a -> (Stream r e a)^c -> (Stream r e a)^c
foreign pure prepend from "flick:Stream" "prepend"
  arity 1
  retention call

/// The elements of the stream `f` gives for each element, one stream after
/// the other.
flat_map : (a -> Stream r2 e2 b)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) b)^c
foreign pure flat_map from "flick:Stream" "flatMap"
  arity 1
  retention call

/// `flat_map` running at most `concurrency` inner streams at once (`None`:
/// no bound), with a buffer of `bufferSize` elements of each.
flat_map_par :
  {
    concurrency : Option Int;
    bufferSize : Option Int;
  } ->
  (a -> Stream r2 e2 b)^c ->
  (Stream r e a)^c ->
  (Stream {Async | r + r2} (e + e2) b)^c
foreign pure flat_map_par from "flick:Stream" "flickFlatMapPar"
  arity 2
  retention call

/// `flat_map` where a new element interrupts the inner stream of the
/// previous one.
switch_map : (a -> Stream r2 e2 b)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) b)^c
foreign pure switch_map from "flick:Stream" "switchMap"
  arity 1
  retention call

/// The elements of each inner stream, one after the other.
flatten : (Stream r e (Stream r2 e2 a))^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure flatten from "flick:Stream" "flatten"
  retention call

/// The elements of each non-empty list.
flatten_chunks : (Stream r e (NonEmpty.NonEmpty a))^c -> (Stream r e a)^c
foreign pure flatten_chunks from "flick:Stream" "flattenArray"
  retention call

/// The elements of each list.
flatten_list : (Stream r e (List a))^c -> (Stream r e a)^c
foreign pure flatten_list from "flick:Stream" "flattenIterable"
  retention call

/// Runs the stream for its effects, emitting nothing.
drain : (Stream r e a)^c -> (Stream r e b)^c
foreign pure drain from "flick:Stream" "drain"
  retention call

/// The elements of the stream while `other` runs alongside it for its
/// effects; it is interrupted when the stream ends.
drain_fork : (Stream r2 e2 x)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure drain_fork from "flick:Stream" "drainFork"
  arity 1
  retention call

/// The stream again each time the schedule recurs.
repeat : Schedule.Schedule r2 e2 Unit o -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure repeat from "flick:Stream" "repeat"
  arity 1
  retention call

/// Each element again as long as the schedule recurs.
repeat_elements : Schedule.Schedule r2 e2 a o -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure repeat_elements from "flick:Stream" "repeatElements"
  arity 1
  retention call

/// The stream again and again, forever.
forever : (Stream r e a)^c -> (Stream r e a)^c
foreign pure forever from "flick:Stream" "forever"
  retention call

/// Each element delayed by the schedule, which gets the elements; the
/// stream ends when it stops.
schedule : Schedule.Schedule r2 e2 a o -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure schedule from "flick:Stream" "schedule"
  arity 1
  retention call

/// Ends the stream when the duration passes without an element.
timeout : Duration.Duration -> (Stream r e a)^c -> (Stream r e a)^c
foreign pure timeout from "flick:Stream" "timeout"
  arity 1
  retention call

/// Switches to `fallback` when the duration passes without an element.
timeout_or_else :
  Duration.Duration -> (Stream r2 e2 a)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure timeout_or_else from "flick:Stream" "flickTimeoutOrElse"
  arity 2
  retention call

/// The elements of both as they come; the merge ends when both end.
merge : (Stream r2 e2 a)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure merge from "flick:Stream" "merge"
  arity 1
  retention call

/// `merge`, ending as the strategy says: when the left (this) stream, the
/// right one, both or either end.
merge_with :
  HaltStrategy -> (Stream r2 e2 a)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure merge_with from "flick:Stream" "flickMergeWith"
  arity 2
  retention call

/// The elements of the stream while `task` runs alongside it.
merge_effect : Eff r2 e2 x -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure merge_effect from "flick:Stream" "mergeEffect"
  arity 1
  retention call

/// `merge` telling the sides apart: `Ok` of this stream, `Err` of `other`.
merge_result : (Stream r2 e2 b)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) (Result b a))^c
foreign pure merge_result from "flick:Stream" "mergeResult"
  arity 1
  retention call

/// The elements of this stream, merged with `right` run for its effects.
merge_left : (Stream r2 e2 b)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure merge_left from "flick:Stream" "mergeLeft"
  arity 1
  retention call

/// The elements of `right`, merged with this stream run for its effects.
merge_right : (Stream r2 e2 b)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) b)^c
foreign pure merge_right from "flick:Stream" "mergeRight"
  arity 1
  retention call

/// The elements of all the streams as they come, at most `concurrency` of
/// them at once (`None`: all).
merge_all :
  { concurrency : Option Int; bufferSize : Option Int } ->
  List ((Stream r e a)^c) ->
  (Stream r e a)^c
foreign pure merge_all from "flick:Stream" "flickMergeAll"
  arity 1
  retention call

/// Each element of this stream with each of `right`.
cross : (Stream r2 e2 b)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) (a, b))^c
foreign pure cross from "flick:Stream" "cross"
  arity 1
  retention call

/// `cross` combined by `f`.
cross_with :
  (Stream r2 e2 b)^c -> (a -> b -> x)^c -> ((Stream r e a)^c -> (Stream (r + r2) (e + e2) x)^c)^c
foreign pure cross_with from "flick:Stream" "crossWith"
  arity 2
  retention call

/// Pairs of the elements of both, until either ends.
zip : (Stream r2 e2 b)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) (a, b))^c
foreign pure zip from "flick:Stream" "zip"
  arity 1
  retention call

/// `zip` combined by `f`.
zip_with :
  (Stream r2 e2 b)^c -> (a -> b -> x)^c -> ((Stream r e a)^c -> (Stream (r + r2) (e + e2) x)^c)^c
foreign pure zip_with from "flick:Stream" "zipWith"
  arity 2
  retention call

/// Zips chunk by chunk: `f` gives the output and what is left of each side.
zip_with_chunks :
  (Stream r2 e2 b)^c ->
  (NonEmpty.NonEmpty a -> NonEmpty.NonEmpty b -> (NonEmpty.NonEmpty x, List a, List b))^c ->
  ((Stream r e a)^c -> (Stream (r + r2) (e + e2) x)^c)^c
foreign pure zip_with_chunks from "flick:Stream" "zipWithArray"
  arity 2
  retention call

/// The elements of this stream, zipped with `right` but dropping its own.
zip_left : (Stream r2 e2 b)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure zip_left from "flick:Stream" "zipLeft"
  arity 1
  retention call

/// The elements of `right`, zipped with this stream but dropping its own.
zip_right : (Stream r2 e2 b)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) b)^c
foreign pure zip_right from "flick:Stream" "zipRight"
  arity 1
  retention call

/// Pairs zipped with a third stream, as triples.
zip_flatten : (Stream r2 e2 x)^c -> (Stream r e (a, b))^c -> (Stream (r + r2) (e + e2) (a, b, x))^c
foreign pure zip_flatten from "flick:Stream" "zipFlatten"
  arity 1
  retention call

/// Each element with its index from 0.
zip_with_index : (Stream r e a)^c -> (Stream r e (a, Int))^c
foreign pure zip_with_index from "flick:Stream" "zipWithIndex"
  retention call

/// Each element with the next one, if any.
zip_with_next : (Stream r e a)^c -> (Stream r e (a, Option a))^c
foreign pure zip_with_next from "flick:Stream" "zipWithNext"
  retention call

/// Each element with the previous one, if any.
zip_with_previous : (Stream r e a)^c -> (Stream r e (Option a, a))^c
foreign pure zip_with_previous from "flick:Stream" "zipWithPrevious"
  retention call

/// Each element with the previous and the next one.
zip_with_previous_and_next : (Stream r e a)^c -> (Stream r e (Option a, a, Option a))^c
foreign pure zip_with_previous_and_next from "flick:Stream" "zipWithPreviousAndNext"
  retention call

/// The latest element of each side whenever either emits, once both have.
zip_latest : (Stream r2 e2 b)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) (a, b))^c
foreign pure zip_latest from "flick:Stream" "zipLatest"
  arity 1
  retention call

/// `zip_latest` combined by `f`.
zip_latest_with :
  (Stream r2 e2 b)^c -> (a -> b -> x)^c -> ((Stream r e a)^c -> (Stream (r + r2) (e + e2) x)^c)^c
foreign pure zip_latest_with from "flick:Stream" "zipLatestWith"
  arity 2
  retention call

/// The latest element of every stream, in their order, whenever one emits.
zip_latest_all : List ((Stream r e a)^c) -> (Stream r e (List a))^c
foreign pure zip_latest_all from "flick:Stream" "zipLatestAll"
  variadic
  retention call

/// The stream that emits first; the others are interrupted.
race : (Stream r2 e2 a)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure race from "flick:Stream" "race"
  arity 1
  retention call

/// `race` of all the streams.
race_all : List ((Stream r e a)^c) -> (Stream r e a)^c
foreign pure race_all from "flick:Stream" "raceAll"
  variadic
  retention call

/// One element of each in turn; the rest of the longer one at the end.
interleave : (Stream r2 e2 a)^c -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure interleave from "flick:Stream" "interleave"
  arity 1
  retention call

/// The next element of this stream for each `true` of `decider`, of
/// `other` for each `false`.
interleave_with :
  (Stream r2 e2 a)^c ->
  (Stream r3 e3 Bool)^c ->
  (Stream r e a)^c ->
  (Stream (r + r2 + r3) (e + e2 + e3) a)^c
foreign pure interleave_with from "flick:Stream" "interleaveWith"
  arity 2
  retention call

/// Interrupts the stream when `task` ends; its failure fails the stream.
interrupt_when : Eff r2 e2 x -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure interrupt_when from "flick:Stream" "interruptWhen"
  arity 1
  retention call

/// Ends the stream after the element being pulled when `task` ends.
halt_when : Eff r2 e2 x -> (Stream r e a)^c -> (Stream (r + r2) (e + e2) a)^c
foreign pure halt_when from "flick:Stream" "haltWhen"
  arity 1
  retention call

/// Groups by the key and value `f` gives: each group is a stream of the
/// values of one key.
group_by :
  (a ->{r2; e2} (k, v))^c ->
  (Stream r e a)^c ->
  (Stream (r + r2) (e + e2) (k, Stream none none v))^c
foreign pure group_by from "flick:Stream" "groupBy"
  arity 1
  retention call

/// Groups by the key `f` gives (compared by `==`).
group_by_key : (a -> k)^c -> (Stream r e a)^c -> (Stream r e (k, Stream none none a))^c
foreign pure group_by_key from "flick:Stream" "groupByKey"
  arity 1
  retention call

/// How a split stream buffers for each consumer: `capacity` elements
/// (`None`: no bound) with the strategy for a full buffer (`None`:
/// `Suspend`), and the last `replay` elements for a late one.
type alias Split = {
  capacity : Option Int;
  strategy : Option Queue.Strategy;
  replay : Option Int;
}

/// A stream that consumers in the scope of region `s` may each run: the
/// source runs once, as a child of that scope, and every consumer sees its
/// elements.
broadcast : Split -> (Stream r e a)^c ->{Scope s | r} (Stream none e a)^{s}
foreign effect broadcast from "flick:Stream" "flickBroadcast"
  arity 1
  retention owner

/// `n` streams that each see every element of the source, which runs once
/// as a child of the scope of region `s`.
broadcast_n : Int -> Split -> (Stream r e a)^c ->{Scope s | r} List ((Stream none e a)^{s})
foreign effect broadcast_n from "flick:Stream" "flickBroadcastN"
  arity 2
  retention owner

/// `broadcast` that starts the source with its first consumer and stops it
/// `idleTimeToLive` (`None`: at once) after its last one ends.
share : Split -> Option Duration.Duration -> (Stream r e a)^c ->{Scope s | r} (Stream none e a)^{s}
foreign effect share from "flick:Stream" "flickShare"
  arity 2
  retention owner

/// The values the filter passes and those it refuses, as two streams of
/// the scope of region `s`; the source runs once as a child of it.
partition :
  Filter.Filter a p f ->
  (Stream r e a)^c ->{Scope s | r}
  ((Stream none e p)^{s}, (Stream none e f)^{s})
foreign effect partition from "flick:Stream" "partition"
  arity 1
  retention owner

/// `partition` with a task as the filter.
partition_effect :
  Fiber.Provided r2 s =>
  Filter.FilterEffect r2 e2 a p f ->
  (Stream r e a)^c ->{Scope s | r + r2}
  ((Stream none (e + e2) p)^{s}, (Stream none (e + e2) f)^{s})
foreign effect partition_effect from "flick:Stream" "partitionEffect"
  arity 1
  retention owner

/// `partition` into two queues that end when the source does; the source
/// runs as a child of the scope of region `s`, which shuts them down when
/// it closes.
partition_queue :
  Filter.Filter a p f -> (Stream r e a)^c ->{Scope s | r} (Queue.Queue e p, Queue.Queue e f)
foreign effect partition_queue from "flick:Stream" "partitionQueue"
  arity 1
  retention owner
