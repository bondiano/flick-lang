/// Forms of a record type that derives `Form` (and `Schema`): a text input
/// per field, checked as the record's type when the form is sent.
///
/// ```flick
/// type alias Signup = { name : String; age : Option Float }
///   deriving Schema, Form
///
/// signup : Form.Draft Signup
/// let signup = Form.draft Signup.form
///
/// name_input : Ui
/// let name_input = Form.input signup Signup.fields.name "Name" None
/// ```
///
/// `Form.validate signup` reads the texts as the field types (an empty
/// `Option` field is `None`), checks the record with its schema, refined
/// types included, and puts the first issue of each field in its error;
/// the first invalid input gets the focus. A check that needs the server,
/// such as a taken name, runs on input with `Ui.Event.latest`, which
/// interrupts it when the user types again, and gives its verdict with
/// `report`.
module Form exposing (
  Field,
  Draft,
  InputProps,
  Spec,
  draft,
  text,
  problem,
  id,
  validate,
  report,
  input,
  spec,
  make,
  unsafe_field,
)

/// A field of a form's record: `Signup.fields.name`.
type Field

/// A form being filled in: the text and the error of each field.
type Draft a

/// Empty texts and no errors. Its atoms live as long as the program, so a
/// draft is defined with a top-level `let`.
draft : Form a -> Draft a
foreign pure draft from "@flick-lang/runtime" "formDraft"

/// The text of `field`, which its input shows and writes.
text : Draft a -> Field -> Atom.Writable String
foreign pure text from "@flick-lang/runtime" "formText"

/// The problem shown under `field`, its error.
problem : Draft a -> Field -> Atom.Writable (Option String)
foreign pure problem from "@flick-lang/runtime" "formError"

/// The id of the input of `field`; its error's is this with `-error`.
id : Draft a -> Field -> String
foreign pure id from "@flick-lang/runtime" "formId"

/// The record of the texts, or `None` when a field is not valid: then each
/// field's error is its first issue, and the first invalid input has the
/// focus.
validate : Draft a ->{Atom.Write;} Option a
foreign effect validate from "@flick-lang/runtime" "formValidate"

/// Sets the error of `field`: the verdict of a check of its own.
report : Draft a -> Field -> Option String ->{Atom.Write;} Unit
let report form field message = Atom.set (problem form field) message

/// The props of `input`'s view.
type alias InputProps = {
  text : Atom.Writable String;
  problem : Atom.Writable (Option String);
  id : String;
  label : String;
  on_input : Option (Ui.Handler Ui.InputSnapshot);
}

/// A field's label, input and error: the input is named by the label,
/// described by the error, and invalid while it has one; the error is an
/// alert, announced when it appears.
input_view : Ui.View InputProps
let input_view =
  Ui.view (fun props ->
    let message = Atom.value props.problem
    let error_id = props.id ++ "-error"
    let field = Ui.field { bind = props.text; placeholder = ""; on_input = props.on_input }
    Ui.div { class_name = "flick-field" } [
      Ui.span { class_name = "flick-field-label" } [Ui.text props.label],
      Ui.with_host
        {
          Ui.host with
          id = Some props.id;
          aria_label = Some props.label;
          aria_describedby = Some error_id;
          aria_invalid = Some (Option.is_some message);
        }
        field,
      Ui.with_host
        { Ui.host with id = Some error_id; role = Some "alert" }
        (Ui.span { class_name = "flick-field-error" } [Ui.text (Option.with_default "" message)]),
    ]
  )

/// The labelled input of `field`; `on_input` runs after each edit.
input : Draft a -> Field -> String -> Option (Ui.Handler Ui.InputSnapshot) -> Ui
let input form field label on_input =
  Ui.render input_view {
    text = text form field;
    problem = problem form field;
    id = id form field;
    label = label;
    on_input = on_input;
  }

/// A field of a form as `deriving Form` writes it: its label, its schema and
/// whether it may be empty.
type Spec

spec : String -> Schema a -> Bool -> Spec
foreign pure spec from "@flick-lang/runtime" "formFieldSpec"

/// The form of the record type `name`, of `fields`.
make : Schema a -> String -> List Spec -> Form a
foreign pure make from "@flick-lang/runtime" "formSpec"

/// The field labeled `label`, unchecked: `deriving Form` writes one for
/// each field of the record.
unsafe_field : String -> Field
foreign pure unsafe_field from "@flick-lang/runtime" "formUnsafeField"
