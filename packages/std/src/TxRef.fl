/// Effect's `TxRef`: a cell whose reads and writes take part in the
/// enclosing `Tx.atomically` transaction.
module TxRef exposing (..)

import Tx

/// A transactional cell holding an `a`.
type TxRef a

/// A new cell holding `initial`.
make : a ->{} TxRef a
foreign effect make from "@flick-lang/runtime/effect/TxRef" "make"
  reviewed "effect@4.1.2 sha256:b759a9ff75590599"

/// The value the transaction sees.
get : TxRef a ->{Tx.Transaction;} a
foreign effect get from "@flick-lang/runtime/effect/TxRef" "get"
  reviewed "effect@4.1.2 sha256:c7903e0d0c832052"

/// Replaces the value.
set : a -> TxRef a ->{Tx.Transaction;} Unit
foreign effect set from "@flick-lang/runtime/effect/TxRef" "set"
  arity 1
  reviewed "effect@4.1.2 sha256:cc7dc9d082f8540d"

/// Replaces the value with `f` of it.
update : (a -> a)^c -> (TxRef a ->{Tx.Transaction;} Unit)^c
foreign effect update from "@flick-lang/runtime/effect/TxRef" "update"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:65fa1fa830be5d12"

/// Replaces the value with the second of `f` of it; returns the first.
modify : (a -> (b, a))^c -> (TxRef a ->{Tx.Transaction;} b)^c
foreign effect modify from "@flick-lang/runtime/effect/TxRef" "modify"
  arity 1
  retention call
  reviewed "effect@4.1.2 sha256:526c2831c92131de"
