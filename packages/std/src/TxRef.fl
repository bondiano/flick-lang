/// A cell whose reads and writes take part in the enclosing `Tx.atomically`
/// transaction.
module TxRef exposing (..)

import Tx

/// A transactional cell holding an `a`.
type TxRef a

/// A new cell holding `initial`.
make : a ->{} TxRef a
foreign effect make from "flick:TxRef" "make"

/// The value the transaction sees.
get : TxRef a ->{Tx.Transaction} a
foreign effect get from "flick:TxRef" "get"

/// Replaces the value.
set : a -> TxRef a ->{Tx.Transaction} Unit
foreign effect set from "flick:TxRef" "set"
  arity 1

/// Replaces the value with `f` of it.
update : (a -> a)^c -> TxRef a ->{Tx.Transaction} Unit
foreign effect update from "flick:TxRef" "update"
  arity 1
  retention call

/// Replaces the value with the second of `f` of it; returns the first.
modify : (a -> (b, a))^c -> TxRef a ->{Tx.Transaction} b
foreign effect modify from "flick:TxRef" "modify"
  arity 1
  retention call
