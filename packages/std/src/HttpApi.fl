/// Typed HTTP APIs. An endpoint is described with codecs, endpoints form
/// groups and groups an API; the type of the API is the record of handlers
/// it needs, so `listen` takes exactly one handler per endpoint and a
/// missing or extra one is a type error naming the group and the endpoint.
/// `call` requests an endpoint from the same value, and `openapi` writes
/// the API as strict OpenAPI 3.1.
module HttpApi exposing (..)

import Codec
import Fiber
import Http.Multipart
import Http.Router
import Schema
import Stream.Core exposing (Stream)

type Method = Get | Post | Put | Patch | Delete | Head | Options | Query
  deriving Eq, Show

/// What a handler gets: the decoded path parameters, query, headers and
/// body; `Unit` for a part the endpoint does not declare.
type alias Request p q h b = { path : p; query : q; headers : h; payload : b }

/// An endpoint named `l`, whose handler has the type `f`:
/// `Request p q h b ->{r; e} s`. The handler's errors `e` are those
/// `with_errors` gives a status and a codec: none until then.
type Endpoint (l : Symbol) f

/// The typed errors `e` of an endpoint, each with its status and its JSON
/// codec: `errors |> error_case 404 (Codec.json NotFound.schema)`.
type ErrorCases (e : ErrorRow)

/// An error that carries its own status: sent as `{ message }` with it.
/// `http_error` declares it with a status for the document and the client;
/// a handler fails with it only where an endpoint declares it.
type error HttpError = HttpError { status : Int; message : String }
  deriving Eq, Show, Schema

/// How a client proves who it is: a scheme of the OpenAPI document, which
/// the server requires (401 without its credentials).
type Security

/// Where an API key is sent.
type KeyLocation = InHeader | InQuery | InCookie
  deriving Eq, Show

/// The document's version, description and servers.
type alias Info = { version : String; description : String; servers : List String }

/// A group named `n` whose handlers form the record `hs`; `r` is what the
/// handlers need, together.
type Group (n : Symbol) (r : ServiceRow) hs

/// An API whose groups form the record `gs` of their handler records; `r`
/// is what their handlers need, which serving it needs.
type Api (r : ServiceRow) gs

/// A running server of region `s`; it stops when the scope that started it
/// closes, after the requests it is serving.
type Server (s : Region)

/// Where the server listens, and where it serves its OpenAPI document,
/// Swagger UI and Scalar, if anywhere.
type alias ServeOptions = {
  host : String;
  port : Float;
  openapi : Option String;
  swagger : Option String;
  scalar : Option String;
}

/// The server could not start, or the document it should serve has no
/// strict form.
type error ServeError = ServeError String
  deriving Eq, Show

/// A request that could not be sent or a response that is neither the
/// success nor a declared error; `status` is 0 when nothing came back.
type error ClientError = ClientError { status : Int; message : String }
  deriving Eq, Show

/// An endpoint at `path` (`/users/:id`) with no parts yet: its handler takes
/// a request of `Unit`s and answers 204 without a body.
endpoint : Method -> String -> Record.Label l -> Endpoint l (Request Unit Unit Unit Unit ->{r} Unit)
foreign pure endpoint from "flick:http-api/HttpApi" "httpApiEndpoint"
  arity 3

/// The path parameters, decoded by a record codec from their texts.
with_path :
  PureCodec Json p2 ->
  Endpoint l (Request p q h b ->{r; e} s) ->
  Endpoint l (Request p2 q h b ->{r; e} s)
foreign pure with_path from "flick:http-api/HttpApi" "httpApiWithPath"
  arity 2

/// The query, decoded by a record codec from the texts of its parameters.
with_query :
  PureCodec Json q2 ->
  Endpoint l (Request p q h b ->{r; e} s) ->
  Endpoint l (Request p q2 h b ->{r; e} s)
foreign pure with_query from "flick:http-api/HttpApi" "httpApiWithQuery"
  arity 2

/// The headers, decoded by a record codec (names in lower case).
with_headers :
  PureCodec Json h2 ->
  Endpoint l (Request p q h b ->{r; e} s) ->
  Endpoint l (Request p q h2 b ->{r; e} s)
foreign pure with_headers from "flick:http-api/HttpApi" "httpApiWithHeaders"
  arity 2

/// The JSON body.
with_payload :
  PureCodec Json b2 ->
  Endpoint l (Request p q h b ->{r; e} s) ->
  Endpoint l (Request p q h b2 ->{r; e} s)
foreign pure with_payload from "flick:http-api/HttpApi" "httpApiWithPayload"
  arity 2

text_payload :
  PureCodec Json String ->
  Endpoint l (Request p q h b ->{r; e} s) ->
  Endpoint l (Request p q h String ->{r; e} s)
foreign pure text_payload from "flick:http-api/HttpApi" "httpApiWithTextPayload"
  arity 2

/// The body as plain text.
with_text_payload :
  Endpoint l (Request p q h b ->{r; e} s) -> Endpoint l (Request p q h String ->{r; e} s)
let with_text_payload endpoint = text_payload (Codec.json Schema.string) endpoint

/// The body as a URL-encoded form, decoded by a record codec from the
/// texts of its fields.
with_form_payload :
  PureCodec Json b2 ->
  Endpoint l (Request p q h b ->{r; e} s) ->
  Endpoint l (Request p q h b2 ->{r; e} s)
foreign pure with_form_payload from "flick:http-api/HttpApi" "httpApiWithFormPayload"
  arity 2

text_success :
  Int ->
  PureCodec Json String ->
  Endpoint l (Request p q h b ->{r; e} s) ->
  Endpoint l (Request p q h b ->{r; e} String)
foreign pure text_success from "flick:http-api/HttpApi" "httpApiWithTextSuccess"
  arity 3

/// The success as plain text, with its status.
with_text_success :
  Int -> Endpoint l (Request p q h b ->{r; e} s) -> Endpoint l (Request p q h b ->{r; e} String)
let with_text_success status endpoint = text_success status (Codec.json Schema.string) endpoint

/// The success: its status and its JSON body.
with_success :
  Int ->
  PureCodec Json s2 ->
  Endpoint l (Request p q h b ->{r; e} s) ->
  Endpoint l (Request p q h b ->{r; e} s2)
foreign pure with_success from "flick:http-api/HttpApi" "httpApiWithSuccess"
  arity 3

/// No typed error.
errors : ErrorCases none
foreign pure errors from "flick:http-api/HttpApi" "httpApiErrors"

/// The cases and the error `t`, sent with this status and codec.
error_case : Int -> PureCodec Json t -> ErrorCases e -> ErrorCases {t | e}
foreign pure error_case from "flick:http-api/HttpApi" "httpApiErrorCase"
  arity 3

/// More typed errors of the handler, each sent as its case says: a handler
/// failing with an error no case has is a type error, not a 500.
with_errors :
  ErrorCases e2 ->
  Endpoint l (Request p q h b ->{r; e} s) ->
  Endpoint l (Request p q h b ->{r; e + e2} s)
foreign pure with_errors from "flick:http-api/HttpApi" "httpApiWithErrors"
  arity 2

/// The cases and `HttpError`s of this status, for the document and the client.
http_error : Int -> ErrorCases e -> ErrorCases {HttpError | e}
let http_error status cases = error_case status (Codec.json HttpError.schema) cases

/// A bearer token in `Authorization`, under the scheme name `name`.
bearer : String -> Security
foreign pure bearer from "flick:http-api/HttpApi" "httpApiBearer"

/// A user and password in `Authorization`.
basic : String -> Security
foreign pure basic from "flick:http-api/HttpApi" "httpApiBasic"

/// A key named `key` in a header, the query or a cookie.
api_key : String -> { key : String; location : KeyLocation } -> Security
foreign pure api_key from "flick:http-api/HttpApi" "httpApiKey"
  arity 2

/// The endpoint requires one of its security schemes; the handler reads the
/// credentials from the headers it declares.
with_security : Security -> Endpoint l f -> Endpoint l f
foreign pure with_security from "flick:http-api/HttpApi" "httpApiWithSecurity"
  arity 2

/// Runs `hook` on the decoded request before the handler, with its services;
/// a typed failure of the hook is answered as one of the handler would be.
with_middleware :
  (Request p q h b ->{r; e} Unit) ->
  Endpoint l (Request p q h b ->{r; e} s) ->
  Endpoint l (Request p q h b ->{r; e} s)
foreign pure with_middleware from "flick:http-api/HttpApi" "httpApiWithMiddleware"
  arity 2

/// The service `a` for the handler, made per request by `check` from the
/// declared headers; its typed failure is answered as the handler's would
/// be, and no 401 is sent by itself. The document lists `security`.
with_auth :
  Security ->
  ServiceTag a ->
  (Request p q h b ->{r; e} ServiceImpl a) ->
  Endpoint l (Request p q h b ->{a + r; e} s) ->
  Endpoint l (Request p q h b ->{a + r; e} s)
foreign pure with_auth from "flick:http-api/HttpApi" "httpApiWithAuth"
  arity 4

/// `with_auth` that also serves anonymous requests: `security` is optional.
with_optional_auth :
  Security ->
  ServiceTag a ->
  (Request p q h b ->{r; e} ServiceImpl a) ->
  Endpoint l (Request p q h b ->{a + r; e} s) ->
  Endpoint l (Request p q h b ->{a + r; e} s)
foreign pure with_optional_auth from "flick:http-api/HttpApi" "httpApiWithOptionalAuth"
  arity 4

/// The endpoint is marked deprecated in the document.
deprecate : Endpoint l f -> Endpoint l f
foreign pure deprecate from "flick:http-api/HttpApi" "httpApiDeprecate"

/// The endpoint is served but left out of the document.
hide : Endpoint l f -> Endpoint l f
foreign pure hide from "flick:http-api/HttpApi" "httpApiHide"

/// The summary in the OpenAPI document.
describe : String -> Endpoint l f -> Endpoint l f
foreign pure describe from "flick:http-api/HttpApi" "httpApiDescribe"
  arity 2

/// A group with no endpoints yet.
group : Record.Label n -> Group n r {}
foreign pure group from "flick:http-api/HttpApi" "httpApiGroup"

/// The group with the endpoint: its handler becomes a field of the group.
add :
  (
    Record.Lacks l hs,
    Record.UnionDisjoint hs (Record.Field l (Request p q h b ->{r; e} s)) out,
  ) =>
  Endpoint l (Request p q h b ->{r; e} s) -> Group n r hs -> Group n r out
foreign pure add from "flick:http-api/HttpApi" "httpApiAdd"
  arity 2

/// The group without the service `a` its endpoints make with `with_auth`
/// (a defect when one does not).
authenticated : ServiceTag a -> Group n (a + r) hs -> Group n r hs
foreign pure authenticated from "flick:http-api/HttpApi" "httpApiAuthenticated"
  arity 2

/// An API with no groups yet; `name` is the title of its document.
api : String -> Api r {}
foreign pure api from "flick:http-api/HttpApi" "httpApiMake"

/// The document's version, description and servers.
info : Info -> Api r gs -> Api r gs
foreign pure info from "flick:http-api/HttpApi" "httpApiInfo"
  arity 2

/// The API with the group: its handlers become a field of the API.
add_group :
  (Record.Lacks n gs, Record.UnionDisjoint gs (Record.Field n hs) out) =>
  Group n r hs -> Api r gs -> Api r out
foreign pure add_group from "flick:http-api/HttpApi" "httpApiAddGroup"
  arity 2

/// Serves the API with these handlers, one per endpoint, until the scope
/// owning region `s` closes: then it stops accepting, lets the requests it
/// serves finish and runs their finalizers. A request that does not decode
/// is 400 with the issues; the handlers run with the services here.
listen :
  Fiber.Provided r s =>
  ServeOptions -> Api r gs -> (gs^c ->{Async, Scope s | r; ServeError} Server s)^c
foreign effect listen from "flick:http-api/HttpApi" "httpApiListen"
  arity 3
  retention owner

/// One route of `Http.Router` at the path pattern (`/api/*`) that serves
/// the API with these handlers: the API shares a server and an origin with
/// the pages and the RPC. It decodes and answers as `listen` does, a
/// request no endpoint takes is 404, and the handlers run with the
/// services here.
route : String -> Api r gs -> (gs^c ->{r} (Http.Router.Route {Async | q} f)^c)^c
foreign effect route from "flick:http-api/HttpApi" "httpApiRoute"
  arity 3
  retention call

/// The port the server listens on: the one asked for, or the one the system
/// chose for port 0.
port : Server s -> Float
foreign pure port from "flick:http-api/HttpApi" "httpApiPort"
  retention call

/// Requests the endpoint of the server at `base` (`http://127.0.0.1:8080`):
/// the success, a declared error as the typed failure, or `ClientError`.
call :
  String -> Endpoint l (Request p q h b ->{r; e} s) -> Request p q h b ->{Async; ClientError | e} s
foreign effect call from "flick:http-api/HttpApi" "httpApiCall"
  arity 3

/// The URL `call` would request with these path parameters and query.
url : String -> Endpoint l (Request p q h b ->{r; e} s) -> p -> q -> Result ClientError String
foreign pure url from "flick:http-api/HttpApi" "httpApiUrl"
  arity 4

/// The API as OpenAPI 3.1 JSON, every schema written by the strict
/// exporter, or the error naming `group.endpoint.part -> field`.
openapi : Api r gs -> Result Codec.ExportError String
foreign pure openapi from "flick:http-api/HttpApi" "httpApiOpenApi"

/// The body as bytes, `application/octet-stream`.
with_bytes_payload :
  Endpoint l (Request p q h b ->{r; e} s) -> Endpoint l (Request p q h (List Int) ->{r; e} s)
foreign pure with_bytes_payload from "flick:http-api/HttpApi" "httpApiWithBytesPayload"

/// The body as a `multipart/form-data` form, decoded as
/// `Http.Multipart.schema_persisted` decodes; its files are removed after
/// the request. A client sends the text fields of the encoded record.
with_multipart_payload :
  PureCodec Json b2 ->
  Endpoint l (Request p q h b ->{r; e} s) ->
  Endpoint l (Request p q h b2 ->{r; e} s)
foreign pure with_multipart_payload from "flick:http-api/HttpApi" "httpApiWithMultipartPayload"
  arity 2

/// The body as the parts of a form, read as the handler streams them; a
/// client sends the parts of its stream. The handler may fail with the
/// stream's `MultipartError`, sent with the status it names.
with_multipart_stream_payload :
  Endpoint l (Request p q h b ->{r; e} s) ->
  Endpoint
    l
    (Request p q h (Stream {Async} {Http.Multipart.MultipartError} Http.Multipart.Part) ->{Async | r; Http.Multipart.MultipartError | e}
      s)
foreign pure with_multipart_stream_payload from "flick:http-api/HttpApi" "httpApiWithMultipartStreamPayload"

/// The success as bytes, with its status.
with_bytes_success :
  Int -> Endpoint l (Request p q h b ->{r; e} s) -> Endpoint l (Request p q h b ->{r; e} List Int)
foreign pure with_bytes_success from "flick:http-api/HttpApi" "httpApiWithBytesSuccess"
  arity 2

/// The success as a stream of bytes, sent as it comes; a client gets the
/// whole body as one chunk.
with_stream_success :
  Int ->
  Endpoint l (Request p q h b ->{r; e} s) ->
  Endpoint l (Request p q h b ->{r; e} Stream none none (List Int))
foreign pure with_stream_success from "flick:http-api/HttpApi" "httpApiWithStreamSuccess"
  arity 2

/// The success as Server-Sent Events, each element the JSON data of one; a
/// client reads the events of the whole body.
with_sse_success :
  Int ->
  PureCodec Json a ->
  Endpoint l (Request p q h b ->{r; e} s) ->
  Endpoint l (Request p q h b ->{r; e} Stream none none a)
foreign pure with_sse_success from "flick:http-api/HttpApi" "httpApiWithSseSuccess"
  arity 3

/// A Server-Sent Event: its id, name and data.
type alias SseEvent = { id : Option String; event : String; data : String }

/// The success as Server-Sent Events of the elements.
with_sse_events_success :
  Int ->
  Endpoint l (Request p q h b ->{r; e} s) ->
  Endpoint l (Request p q h b ->{r; e} Stream none none SseEvent)
foreign pure with_sse_events_success from "flick:http-api/HttpApi" "httpApiWithSseEventsSuccess"
  arity 2

/// The success with response headers: the handler answers the value and a
/// record the codec encodes as headers (names in lower case).
with_success_headers :
  PureCodec Json hs ->
  Endpoint l (Request p q h b ->{r; e} s) ->
  Endpoint l (Request p q h b ->{r; e} (s, hs))
foreign pure with_success_headers from "flick:http-api/HttpApi" "httpApiWithSuccessHeaders"
  arity 2

/// The success with the value of the cookie of the security, an `api_key`
/// `InCookie`, set `Secure` and `HttpOnly` when the handler gives one. A
/// client gets the value only where the response shows `Set-Cookie`: a
/// browser keeps an `HttpOnly` cookie from scripts, so `call` there succeeds
/// with `None` and the browser sends the cookie on later requests.
security_set_cookie :
  Security ->
  Endpoint l (Request p q h b ->{r; e} s) ->
  Endpoint l (Request p q h b ->{r; e} (s, Option (Redacted String)))
foreign pure security_set_cookie from "flick:http-api/HttpApi" "httpApiSecuritySetCookie"
  arity 2
