/// JSON text: parsing it gives inert data a codec can decode.
module Json exposing (parse, stringify, to_unknown, json)

/// The value of JSON text, or the reason it is not JSON.
parse : String -> Result SchemaError Unknown
foreign pure parse from "flick:rt" "jsonParse"

/// The JSON text of a value.
stringify : Json -> String
foreign pure stringify from "flick:rt" "jsonStringify"

/// A JSON value as input for decoding.
to_unknown : Json -> Unknown
foreign pure to_unknown from "flick:rt" "identity"

/// Any JSON value, kept as it is.
json : PureCodec Json Json
foreign pure json from "flick:Schema" "Json"
