/// What a `server fn` is, as std's plugin writes it: the procedure of its
/// calls, from its name and the witnesses of what it sends; the call any
/// code makes; and the implementation `Server.handler` serves.
module Server.Derive exposing (
  Errors,
  Procedure,
  call,
  function,
  guarded,
  no_errors,
  procedure,
  with_error,
)

/// The witnesses of the errors a server function sends, `e` their row.
type Errors (e : ErrorRow)

/// No errors.
no_errors : Errors none
foreign pure no_errors from "@flick-lang/runtime/effect/server/Functions" "serverNoErrors"

/// The errors `e` and `t`, sent with its witness.
with_error : forall t e. Schema t -> Errors e -> Errors {t | e}
foreign pure with_error from "@flick-lang/runtime/effect/server/Functions" "serverError"
  arity 2

/// How the calls of a server function go: a payload `p`, a success `s`
/// and the errors `e`.
type Procedure p (e : ErrorRow) s

/// The procedure of the server function `name`, its module's with it.
procedure : forall p e s. String -> Schema p -> Schema s -> Errors e -> Procedure p e s
foreign pure procedure from "@flick-lang/runtime/effect/server/Functions" "serverProcedure"
  arity 4

/// A call of the procedure: to `FLICK_SERVER_URL` on Node, to the page's
/// origin in a browser, at `Server.path`.
call : forall p e s. Procedure p e s -> p ->{; Rpc.ClientError | e} s
foreign effect call from "@flick-lang/runtime/effect/server/Functions" "serverCall"
  arity 2

/// The implementation of a procedure: what it needs, and `Server`, so no
/// client reaches it.
function :
  forall p r e s. Procedure p e s -> (p ->{r; e} s) -> Server.Function ({Server.Server} + r)
foreign pure function from "@flick-lang/runtime/effect/server/Functions" "serverFunction"
  arity 2

/// The implementation of a procedure whose errors have `Unauthorized`.
guarded : forall p r e s. Procedure p e s -> (p ->{r; e} s) -> Server.Guarded ({Server.Server} + r)
foreign pure guarded from "@flick-lang/runtime/effect/server/Functions" "serverFunction"
  arity 2
