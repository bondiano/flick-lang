/// A `Chunk` in a transactional cell; each operation takes part in the
/// enclosing `Tx.atomically` transaction.
module TxChunk exposing (..)

import Chunk
import Tx

/// A transactional chunk of `a`.
type TxChunk a

/// A new transactional chunk holding `initial`.
make : Chunk.Chunk a ->{} TxChunk a
foreign effect make from "flick:TxChunk" "make"

/// A new empty transactional chunk.
empty : Unit ->{} TxChunk a
foreign effect empty from "flick:TxChunk" "empty"
  arity 0

/// A new transactional chunk of the elements of the list.
from_iterable : List a ->{} TxChunk a
foreign effect from_iterable from "flick:TxChunk" "fromIterable"

/// Replaces the chunk with the second of `f` of it; returns the first.
modify : (Chunk.Chunk a -> (b, Chunk.Chunk a))^c -> TxChunk a ->{Tx.Transaction} b
foreign effect modify from "flick:TxChunk" "modify"
  arity 1
  retention call

/// Replaces the chunk with `f` of it.
update : (Chunk.Chunk a -> Chunk.Chunk a)^c -> TxChunk a ->{Tx.Transaction} Unit
foreign effect update from "flick:TxChunk" "update"
  arity 1
  retention call

/// The chunk the transaction sees.
get : TxChunk a ->{Tx.Transaction} Chunk.Chunk a
foreign effect get from "flick:TxChunk" "get"

/// Replaces the chunk.
set : Chunk.Chunk a -> TxChunk a ->{Tx.Transaction} Unit
foreign effect set from "flick:TxChunk" "set"
  arity 1

/// Adds the element at the end.
append : a -> TxChunk a ->{Tx.Transaction} Unit
foreign effect append from "flick:TxChunk" "append"
  arity 1

/// Adds the element at the start.
prepend : a -> TxChunk a ->{Tx.Transaction} Unit
foreign effect prepend from "flick:TxChunk" "prepend"
  arity 1

/// The number of elements.
size : TxChunk a ->{Tx.Transaction} Int
foreign effect size from "flick:TxChunk" "size"

/// Whether it has no elements.
is_empty : TxChunk a ->{Tx.Transaction} Bool
foreign effect is_empty from "flick:TxChunk" "isEmpty"

/// Whether it has an element.
is_non_empty : TxChunk a ->{Tx.Transaction} Bool
foreign effect is_non_empty from "flick:TxChunk" "isNonEmpty"

/// Keeps the first `n` elements.
take : Int -> TxChunk a ->{Tx.Transaction} Unit
foreign effect take from "flick:TxChunk" "take"
  arity 1

/// Removes the first `n` elements.
drop : Int -> TxChunk a ->{Tx.Transaction} Unit
foreign effect drop from "flick:TxChunk" "drop"
  arity 1

/// Keeps the elements from index `start` up to, not including, `end`.
slice : Int -> Int -> TxChunk a ->{Tx.Transaction} Unit
foreign effect slice from "flick:TxChunk" "slice"
  arity 2

/// Replaces each element with `f` of it.
map : (a -> a)^c -> TxChunk a ->{Tx.Transaction} Unit
foreign effect map from "flick:TxChunk" "map"
  arity 1
  retention call

/// Keeps the elements the predicate accepts.
filter : (a -> Bool)^c -> TxChunk a ->{Tx.Transaction} Unit
foreign effect filter from "flick:TxChunk" "filter"
  arity 1
  retention call

/// Adds the elements of the chunk at the end.
append_all : Chunk.Chunk a -> TxChunk a ->{Tx.Transaction} Unit
foreign effect append_all from "flick:TxChunk" "appendAll"
  arity 1

/// Adds the elements of the chunk at the start.
prepend_all : Chunk.Chunk a -> TxChunk a ->{Tx.Transaction} Unit
foreign effect prepend_all from "flick:TxChunk" "prependAll"
  arity 1

/// Adds the elements `other` holds, in the same transaction, at the end.
concat : TxChunk a -> TxChunk a ->{Tx.Transaction} Unit
foreign effect concat from "flick:TxChunk" "concat"
  arity 1
