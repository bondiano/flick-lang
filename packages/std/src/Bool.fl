/// Booleans: the connectives as functions, for pipelines and for passing
/// where `&&` and `||` cannot go.
module Bool exposing (..)

/// `not`, as a function.
not_ : Bool -> Bool
foreign pure not_ from "flick:Boolean" "not"

/// Both hold.
and : Bool -> Bool -> Bool
foreign pure and from "flick:Boolean" "and"
  arity 1

/// Not both hold.
nand : Bool -> Bool -> Bool
foreign pure nand from "flick:Boolean" "nand"
  arity 1

/// Either holds.
or : Bool -> Bool -> Bool
foreign pure or from "flick:Boolean" "or"
  arity 1

/// Neither holds.
nor : Bool -> Bool -> Bool
foreign pure nor from "flick:Boolean" "nor"
  arity 1

/// Exactly one holds.
xor : Bool -> Bool -> Bool
foreign pure xor from "flick:Boolean" "xor"
  arity 1

/// Both are the same.
eqv : Bool -> Bool -> Bool
foreign pure eqv from "flick:Boolean" "eqv"
  arity 1

/// `self |> implies that`: `that` holds whenever `self` does.
implies : Bool -> Bool -> Bool
foreign pure implies from "flick:Boolean" "implies"
  arity 1

/// Every element holds; `true` for the empty list.
every : List Bool -> Bool
foreign pure every from "flick:Boolean" "every"

/// Some element holds; `false` for the empty list.
some : List Bool -> Bool
foreign pure some from "flick:Boolean" "some"

/// `onTrue ()` or `onFalse ()`.
match_ : { onFalse : Unit -> a; onTrue : Unit -> a } -> Bool -> a
foreign pure match_ from "flick:Boolean" "match"
  arity 1

/// `&&` over a list, from `true`.
reducer_and : Reducer.Reducer Bool
foreign pure reducer_and from "flick:Boolean" "ReducerAnd"

/// `||` over a list, from `false`.
reducer_or : Reducer.Reducer Bool
foreign pure reducer_or from "flick:Boolean" "ReducerOr"
