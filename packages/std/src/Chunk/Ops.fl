/// Chunks filtered, searched, folded, sorted and combined: the part of
/// `Chunk` that computes from the elements. `dedupe`, `intersection` and
/// `union` compare by `==`.
module Chunk.Ops exposing (..)

import Chunk.Core exposing (Chunk, to_list)

/// The elements that satisfy `p`.
filter : (a -> Bool)^c -> Chunk a -> Chunk a
foreign pure filter from "flick:Chunk" "filter"
  arity 1
  retention call

/// The `Ok` values of `f` over the elements.
filter_map : (a -> Result e b)^c -> Chunk a -> Chunk b
foreign pure filter_map from "flick:Chunk" "filterMap"
  arity 1
  retention call

/// The `Ok` values of `f` over the elements, up to the first `Err`.
filter_map_while : (a -> Result e b)^c -> Chunk a -> Chunk b
foreign pure filter_map_while from "flick:Chunk" "filterMapWhile"
  arity 1
  retention call

/// The values of the `Some` elements.
compact : Chunk (Option a) -> Chunk a
foreign pure compact from "flick:Chunk" "compact"

/// The chunks `f` gives each element, joined.
flat_map : (a -> Chunk b)^c -> Chunk a -> Chunk b
foreign pure flat_map from "flick:Chunk" "flatMap"
  arity 1
  retention call

/// The chunks joined.
flatten : Chunk (Chunk a) -> Chunk a
foreign pure flatten from "flick:Chunk" "flatten"

/// Runs a runtime function on each element in order, for what it does.
each_effect : (a ->{r; e} Unit)^c -> Chunk a ->{r; e} Unit
let each_effect f chunk = List.each_effect f (to_list chunk)

/// Whether an element is `same` as `x`.
contains_with : (a -> a -> Bool)^c -> a -> Chunk a -> Bool
foreign pure contains_with from "flick:Chunk" "containsWith"
  arity 1
  retention call

/// Whether an element equals `x`.
contains : Eq a => a -> Chunk a -> Bool
let contains x chunk = contains_with eq x chunk

/// The first of each set of `==` elements, in order.
dedupe : Chunk a -> Chunk a
foreign pure dedupe from "flick:Chunk" "dedupe"

/// The chunk without an element `==` to the one before it.
dedupe_adjacent : Chunk a -> Chunk a
foreign pure dedupe_adjacent from "flick:Chunk" "dedupeAdjacent"

/// `c |> difference_with same d`: the elements of `c` with none `same` in `d`.
difference_with : (a -> a -> Bool)^c -> Chunk a -> Chunk a -> Chunk a
foreign pure difference_with from "flick:Chunk" "differenceWith"
  arity 1
  retention call

/// `c |> difference d`: the elements of `c` not in `d`, by `Eq`.
difference : Eq a => Chunk a -> Chunk a -> Chunk a
let difference that chunk = difference_with eq that chunk

/// `c |> intersection d`: the elements of `c` also in `d`, by `==`.
intersection : Chunk a -> Chunk a -> Chunk a
foreign pure intersection from "flick:Chunk" "intersection"
  arity 1

/// `c |> union d`: the elements of both, each once, by `==`.
union : Chunk a -> Chunk a -> Chunk a
foreign pure union from "flick:Chunk" "union"
  arity 1

/// Whether every element satisfies `p`.
every : (a -> Bool)^c -> Chunk a -> Bool
foreign pure every from "flick:Chunk" "every"
  arity 1
  retention call

/// Whether some element satisfies `p`.
some : (a -> Bool)^c -> Chunk a -> Bool
foreign pure some from "flick:Chunk" "some"
  arity 1
  retention call

/// The first element that satisfies `p`.
find_first : (a -> Bool)^c -> Chunk a -> Option a
foreign pure find_first from "flick:Chunk" "findFirst"
  arity 1
  retention call

/// The index of the first element that satisfies `p`.
find_first_index : (a -> Bool)^c -> Chunk a -> Option Int
foreign pure find_first_index from "flick:Chunk" "findFirstIndex"
  arity 1
  retention call

/// The last element that satisfies `p`.
find_last : (a -> Bool)^c -> Chunk a -> Option a
foreign pure find_last from "flick:Chunk" "findLast"
  arity 1
  retention call

/// The index of the last element that satisfies `p`.
find_last_index : (a -> Bool)^c -> Chunk a -> Option Int
foreign pure find_last_index from "flick:Chunk" "findLastIndex"
  arity 1
  retention call

/// The strings joined with `separator` between them.
join : String -> Chunk String -> String
foreign pure join from "flick:Chunk" "join"
  arity 1

/// Maps each element while threading a state from the first: the final
/// state and the mapped chunk.
map_accum : s -> (s -> a -> (s, b))^c -> (Chunk a -> (s, Chunk b))^c
foreign pure map_accum from "flick:Chunk" "mapAccum"
  arity 2
  retention call

/// The `Ok` values and the `Err` errors of `f` over the elements.
partition : (a -> Result f p)^c -> Chunk a -> (Chunk p, Chunk f)
foreign pure partition from "flick:Chunk" "partition"
  arity 1
  retention call

/// The `Ok` values and the `Err` errors.
separate : Chunk (Result e a) -> (Chunk a, Chunk e)
foreign pure separate from "flick:Chunk" "separate"

/// Folds from the first element.
reduce : b -> (b -> a -> b)^c -> (Chunk a -> b)^c
foreign pure reduce from "flick:Chunk" "reduce"
  arity 2
  retention call

/// Folds from the last element.
reduce_right : b -> (b -> a -> b)^c -> (Chunk a -> b)^c
foreign pure reduce_right from "flick:Chunk" "reduceRight"
  arity 2
  retention call

/// Sorts by `compare`, keeping equal elements in their order.
sort_by : (a -> a -> Ordering)^c -> Chunk a -> Chunk a
foreign pure sort_by from "flick:Chunk" "flickSortBy"
  arity 1
  retention call

/// Sorts by `Ord`, keeping equal elements in their order.
sort : Ord a => Chunk a -> Chunk a
let sort chunk = sort_by compare chunk

/// Sorts by the `Ord` of the key `f` gives each element.
sort_with : Ord b => (a -> b) -> Chunk a -> Chunk a
let sort_with f chunk = sort_by (fun x y -> compare (f x) (f y)) chunk

/// The firsts and the seconds of the pairs.
unzip : Chunk (a, b) -> (Chunk a, Chunk b)
foreign pure unzip from "flick:Chunk" "unzip"

/// `c |> zip d`: the pairs of the elements at each index of both.
zip : Chunk b -> Chunk a -> Chunk (a, b)
foreign pure zip from "flick:Chunk" "zip"
  arity 1

/// `c |> zip_with d f`: `f` of the elements at each index of both.
zip_with : Chunk b -> (a -> b -> d)^c -> (Chunk a -> Chunk d)^c
foreign pure zip_with from "flick:Chunk" "zipWith"
  arity 2
  retention call
