/// Server markup. Keep `react-dom/server` out of `Ui`, so client programs
/// do not load it.
module Ui.Server exposing (..)

import Atom
import Stream.Core exposing (Stream)

/// The markup of `ui`; a client root mounted on it with `Ui.Dom.mount`
/// hydrates it. Its views read atoms from the provided registry: give each
/// request its own with `provide Atom.layer { … }`, so requests
/// rendered at once do not see each other's atoms, and nothing reads that
/// registry once its `provide` ends. Handlers do not run here.
render : Ui^c ->{Async, Atom.Registry; none} String
foreign effect render from "@flick-lang/effect-ts/ui/server" "uiServerRender"
  retention call

/// The serializable atoms of the registry as a JSON
/// `<script type="application/json" id="flick-state-…">` for the container
/// with this id, to put in the page after rendering it: `Ui.Dom.mount` on
/// that container writes them into its registry before its first render,
/// so the client starts from the server's values. An atom whose value its
/// codec does not encode is a defect naming its key.
state : String ->{Atom.Registry; none} String
foreign effect state from "@flick-lang/effect-ts/ui/server" "uiServerState"
  arity 1

/// The container `<div id="container" data-flick-ssr>` with the markup of
/// `ui`, in chunks as React renders them, for a response to stream. A view
/// of `Ui.suspended` that reads a loading task is sent as its fallback, and
/// its markup follows once the task ends; a task read outside one is sent
/// as `Loading` and not waited for. The serializable atoms come in JSON
/// scripts: the shell's before it, a serializable task's value before the
/// markup that shows it, so `Ui.Dom.mount` on the container hydrates that
/// markup from the server's values. Run it inside the `provide` of the
/// request's registry.
stream : String -> Ui -> Stream {Async, Atom.Registry} none String
foreign pure stream from "@flick-lang/effect-ts/ui/server" "uiServerStream"
  arity 2

/// The HTML of `ui`, without React: a template for mail or any markup no
/// client hydrates. Text and attribute values are escaped as `text` keeps
/// markup in text; views read atoms as a server does, from a registry of
/// this call alone, so the same `ui` always gives the same HTML. Handlers
/// are left out, and a foreign component, which only React renders, is a
/// defect.
to_html : Ui -> String
foreign pure to_html from "@flick-lang/effect-ts/ui/html" "uiToHtml"
