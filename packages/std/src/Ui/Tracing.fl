/// Optional action spans on the Effect adapter. Disabled by default; a root
/// captures this setting when mounted. Requires the optional Effect adapter.
module Ui.Tracing exposing (with_action_spans)

with_action_spans : Bool -> (Eff r e a)^c ->{r; e} a
foreign effect with_action_spans from "@flick-lang/effect-ts/ui/tracing" "withActionSpans"
  arity 1
  retention call
