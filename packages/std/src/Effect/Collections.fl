/// The part of `Effect` that runs a task per element of a list, and the
/// checks of a task's result.
module Effect.Collections exposing (..)

import Cause
import Effect.Core exposing (Concurrency)

/// Every typed error of `validate`, in the order of the elements.
type error ValidationError (e : ErrorRow) = ValidationError (NonEmpty.NonEmpty (Errors e))

/// Runs `f` on each element, as many at once as `concurrency` lets; the
/// results in order. The first typed failure stops the others.
for_each : Concurrency -> (a ->{r; e} b)^c -> List a ->{r; e} List b
foreign effect for_each from "flick:Effect" "flickForEach"
  arity 2
  retention call

/// Runs every task, as many at once as `concurrency` lets; the results in
/// order. The first typed failure stops the others.
all : Detached r => Concurrency -> List ((Eff r e a)^c) ->{r; e} List a
foreign effect all from "flick:Effect" "flickAll"
  arity 1
  retention call

/// Runs `f` on every element: the results and the typed errors apart, in
/// order; it fails only with a defect or an interruption.
partition : Concurrency -> (a ->{r; e} b)^c -> List a ->{r} (List b, List (Errors e))
foreign effect partition from "flick:Effect" "flickPartition"
  arity 2
  retention call

/// Runs `f` on every element: all the results, or every typed error.
validate : Concurrency -> (a ->{r; e} b)^c -> List a ->{r; ValidationError e} List b
foreign effect validate from "flick:Effect" "flickValidate"
  arity 2
  retention call

/// The elements `f` keeps, in order.
filter : Concurrency -> (a ->{r; e} Bool)^c -> List a ->{r; e} List a
foreign effect filter from "flick:Effect" "flickFilter"
  arity 2
  retention call

/// The values the filter passes, in order.
filter_map : (a -> Result x b)^c -> List a ->{} List b
foreign effect filter_map from "flick:Effect" "filterMap"
  arity 1
  retention call

/// The values the runtime filter passes, in order.
filter_map_effect : Concurrency -> (a ->{r; e} Result x b)^c -> List a ->{r; e} List b
foreign effect filter_map_effect from "flick:Effect" "flickFilterMapEffect"
  arity 2
  retention call

/// The first element `f` holds for, trying one after another.
find_first : (a ->{r; e} Bool)^c -> List a ->{r; e} Option a
foreign effect find_first from "flick:Effect" "findFirst"
  arity 1
  retention call

/// The first value the runtime filter passes.
find_first_filter : (a ->{r; e} Result x b)^c -> List a ->{r; e} Option b
foreign effect find_first_filter from "flick:Effect" "findFirstFilter"
  arity 1
  retention call

/// The result of the first task to succeed, trying one after another; the
/// last failure when all fail.
first_success_of : List ((Eff r e a)^c) ->{r; e} a
foreign effect first_success_of from "flick:Effect" "firstSuccessOf"
  retention call

/// The first element of the list `task` gives.
head : (Eff r e (List a))^c ->{r; Cause.NoSuchElementError | e} a
foreign effect head from "flick:Effect" "flickHead"
  retention call

/// Folds the list from `zero` with the runtime `f`, from the first element.
reduce : b -> (b -> a ->{r; e} b)^c -> List a ->{r; e} b
foreign effect reduce from "flick:Effect" "flickReduce"
  arity 2
  retention call

/// The result of `task` if `p` holds for it, else `fallback` of it.
filter_or_else : (a -> Bool)^c -> (a ->{r2; e2} a)^c -> (Eff r e a)^c ->{r + r2; e + e2} a
foreign effect filter_or_else from "flick:Effect" "filterOrElse"
  arity 2
  retention call

/// The value the filter passes of `task`'s result, else `fallback` of what
/// it refused.
filter_map_or_else : (a -> Result x b)^c -> (x ->{r2; e2} b)^c -> (Eff r e a)^c ->{r + r2; e + e2} b
foreign effect filter_map_or_else from "flick:Effect" "filterMapOrElse"
  arity 2
  retention call

/// The result of `task` if `p` holds for it, else fails with `f` of it.
filter_or_fail : (a -> Bool)^c -> (a -> Errors e2)^c -> (Eff r e a)^c ->{r; e + e2} a
foreign effect filter_or_fail from "flick:Effect" "filterOrFail"
  arity 2
  retention call

/// The value the filter passes of `task`'s result, else fails with `f` of
/// what it refused.
filter_map_or_fail : (a -> Result x b)^c -> (x -> Errors e2)^c -> (Eff r e a)^c ->{r; e + e2} b
foreign effect filter_map_or_fail from "flick:Effect" "filterMapOrFail"
  arity 2
  retention call
