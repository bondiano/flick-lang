/// The part of `Effect` that runs one task: schedules, delays, timing,
/// repetition, defects and the exit of a task.
module Effect.Core exposing (..)

import Duration
import Fiber
import Resource
import Schedule

/// How many tasks of a collection run at once: one after another, at most
/// `n`, or all of them.
type Concurrency = Sequential | Bounded Int | Unbounded

/// A reusable cold task that succeeds with `()`, requires no services and
/// has no expected errors. Use it instead of an empty `task` body.
void : Eff none none Unit
foreign pure void from "flick:Effect" "void"

/// Suspends the fiber for the duration.
sleep : Duration.Duration ->{Async} Unit
foreign effect sleep from "flick:Effect" "sleep"

/// Runs `task` again after each typed failure, as long as the schedule,
/// which gets the error, recurs; then fails with the last error. A defect
/// or an interruption is never retried.
retry : Schedule.Schedule r2 e2 (Errors e) o -> (Eff r e a)^c ->{Async | r + r2; e + e2} a
foreign effect retry from "flick:Effect" "retry"
  arity 1
  retention call

/// `retry`, with `fallback` given the last error and the schedule's output
/// when the schedule stops.
retry_or_else :
  Schedule.Schedule r2 e2 (Errors e) o ->
  (Errors e -> o ->{r3; e3} a) ->
  (Eff r e a)^c ->{Async | r + r2 + r3; e2 + e3}
  a
foreign effect retry_or_else from "flick:Effect" "retryOrElse"
  arity 2
  retention call

/// Runs `task`, then again as long as the schedule, which gets each
/// result, recurs; the schedule's last output. The first typed failure
/// stops it.
repeat : Schedule.Schedule r2 e2 a o -> (Eff r e a)^c ->{Async | r + r2; e + e2} o
foreign effect repeat from "flick:Effect" "repeat"
  arity 1
  retention call

/// `repeat`, with `fallback` given the error and the metadata of the last
/// step, if one ran, when the task or the schedule fails.
repeat_or_else :
  Schedule.Schedule r2 e2 a o ->
  (Errors (e + e2) -> Option (Schedule.Metadata o a) ->{r3; e3} o) ->
  (Eff r e a)^c ->{Async | r + r2 + r3; e3}
  o
foreign effect repeat_or_else from "flick:Effect" "repeatOrElse"
  arity 2
  retention call

/// Runs `task` by the schedule, which gets no input, delaying before each
/// run after the first; the schedule's last output.
schedule : Schedule.Schedule r2 e2 i o -> (Eff r e a)^c ->{Async | r + r2; e + e2} o
foreign effect schedule from "flick:Effect" "schedule"
  arity 1
  retention call

/// `repeat` with `initial` as the schedule's first input.
schedule_from : a -> Schedule.Schedule r2 e2 a o -> (Eff r e a)^c ->{Async | r + r2; e + e2} o
foreign effect schedule_from from "flick:Effect" "scheduleFrom"
  arity 2
  retention call

/// Dies with a defect carrying the message: not a typed error, so no
/// `try … with` handles it.
die : String ->{} a
foreign effect die from "flick:Effect" "die"

/// Fails with the whole cause of the failure `f ()` gives.
fail_cause_sync : (Unit -> Failure e)^c ->{; e} a
foreign effect fail_cause_sync from "flick:Effect" "flickFailCauseSync"
  retention call

/// Never ends; only an interruption stops it.
never : Unit ->{Async} a
foreign effect never from "flick:Effect" "flickNever"
  arity 0

/// Lets the other fibers run before this one goes on.
yield_now : Unit ->{Async} Unit
foreign effect yield_now from "flick:Effect" "flickYieldNow"
  arity 0

/// `yield_now` with the priority of the scheduler's task, a Float as the
/// scheduler takes it.
yield_now_with : Float ->{Async} Unit
foreign effect yield_now_with from "flick:Effect" "yieldNowWith"

/// How `task` ends, its typed failure, defect or interruption included;
/// never fails itself.
exit : (Eff r e a)^c ->{r} Exit e a
foreign effect exit from "flick:Effect" "flickExit"
  retention call

/// Runs `task`, then `other`: both results. `parallel` runs them at once.
zip : (Eff r2 e2 b)^c -> (Eff r e a)^c ->{r + r2; e + e2} (a, b)
foreign effect zip from "flick:Effect" "zip"
  arity 1
  retention call

/// Runs `task`, then `other`, and combines their results with `f`.
zip_with : (Eff r2 e2 b)^c -> (a -> b -> d)^c -> (Eff r e a)^c ->{r + r2; e + e2} d
foreign effect zip_with from "flick:Effect" "zipWith"
  arity 2
  retention call

/// Runs `task` after the duration.
delay : Duration.Duration -> (Eff r e a)^c ->{r; e} a
foreign effect delay from "flick:Effect" "delay"
  arity 1
  retention call

/// The result of `task` with how long it ran.
timed : (Eff r e a)^c ->{r; e} (Duration.Duration, a)
foreign effect timed from "flick:Effect" "timed"
  retention call

/// Runs `fallback` instead when `task` does not end within the duration;
/// `task` is interrupted.
timeout_or_else : Duration.Duration -> (Eff r2 e2 a)^c -> (Eff r e a)^c ->{r + r2; e + e2} a
foreign effect timeout_or_else from "flick:Effect" "flickTimeoutOrElse"
  arity 2
  retention call

/// Runs `task` again and again until it fails.
forever : (Eff r e a)^c ->{r; e} b
foreign effect forever from "flick:Effect" "forever"
  retention call

/// Runs `task` again after each typed failure until it succeeds.
eventually : (Eff r e a)^c ->{r} a
foreign effect eventually from "flick:Effect" "eventually"
  retention call

/// `n` copies of `task`, none of them run yet.
replicate : Int -> Eff r e a -> List (Eff r e a)
foreign pure replicate from "flick:Effect" "replicate"
  arity 1

/// Runs `task` `n` times, as many at once as `concurrency` lets; the
/// results in order.
replicate_effect : Detached r => Concurrency -> Int -> (Eff r e a)^c ->{r; e} List a
foreign effect replicate_effect from "flick:Effect" "flickReplicateEffect"
  arity 2
  retention call

/// Runs `task` only if `condition` gives `true`: its result, or `None`.
when_ : (Eff r2 e2 Bool)^c -> (Eff r e a)^c ->{r + r2; e + e2} Option a
foreign effect when_ from "flick:Effect" "when"
  arity 1
  retention call

/// A resource of the value `task` gives, refreshed automatically: it is
/// acquired now and again by the schedule, and released when the innermost
/// `scope` (or the one of region `s`) closes.
resource_auto :
  Fiber.Provided r2 s =>
  Schedule.Schedule r2 e2 i o ->
  (forall t. Eff {Scope t | r} e a^{t})^c ->{Scope s | r + r2}
  Resource.Resource s e a
foreign effect resource_auto from "flick:Effect" "flickResourceAuto"
  arity 1
  retention owner
