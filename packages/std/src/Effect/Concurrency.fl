/// The part of `Effect` about fibers: interruption and its masks, races
/// of many tasks, caching a task's result, and execution plans.
module Effect.Concurrency exposing (..)

import Duration
import ExecutionPlan

/// Interrupts the current fiber.
interrupt : Unit ->{} a
foreign effect interrupt from "flick:Effect" "flickInterrupt"
  arity 0

/// Runs `task` so that it may be interrupted, inside an uninterruptible
/// region too.
interruptible : (Eff r e a)^c ->{r; e} a
foreign effect interruptible from "flick:Effect" "interruptible"
  retention call

/// Runs `task` to its end even if the fiber is interrupted meanwhile.
uninterruptible : (Eff r e a)^c ->{r; e} a
foreign effect uninterruptible from "flick:Effect" "uninterruptible"
  retention call

/// Runs `f` uninterruptibly; `restore` makes a task inside it as
/// interruptible as outside.
uninterruptible_mask : ((Eff r2 e2 b -> Eff r2 e2 b) ->{r; e} a)^c ->{r; e} a
foreign effect uninterruptible_mask from "flick:Effect" "uninterruptibleMask"
  retention call

/// Runs `f` interruptibly; `restore` makes a task inside it as
/// interruptible as outside.
interruptible_mask : ((Eff r2 e2 b -> Eff r2 e2 b) ->{r; e} a)^c ->{r; e} a
foreign effect interruptible_mask from "flick:Effect" "interruptibleMask"
  retention call

/// The result of the first task to succeed; the others are interrupted
/// and awaited.
race_all : Detached r => List ((Eff r e a)^c) ->{r; e} a
foreign effect race_all from "flick:Effect" "raceAll"
  retention call

/// The first task to end, however it ends; the others are interrupted and
/// awaited.
race_all_first : Detached r => List ((Eff r e a)^c) ->{r; e} a
foreign effect race_all_first from "flick:Effect" "raceAllFirst"
  retention call

/// The id of the current fiber.
fiber_id : Unit ->{} Float
foreign effect fiber_id from "flick:Effect" "flickFiberId"
  arity 0

/// A task that runs `task` the first time and gives its outcome each time.
cached : Eff r e a ->{} Eff r e a
foreign effect cached from "flick:Effect" "cached"

/// `cached`, running `task` again once the duration has passed.
cached_with_ttl : Duration.Duration -> Eff r e a ->{} Eff r e a
foreign effect cached_with_ttl from "flick:Effect" "cachedWithTTL"
  arity 1

/// `cached_with_ttl`, and a task that forgets the cached outcome.
cached_invalidate_with_ttl : Duration.Duration -> Eff r e a ->{} (Eff r e a, Eff none none Unit)
foreign effect cached_invalidate_with_ttl from "flick:Effect" "cachedInvalidateWithTTL"
  arity 1

/// Runs `task` with the services of the plan's first step, and on a
/// failure with those of the next steps as the plan says; `on_event` sees
/// each attempt.
with_execution_plan :
  ExecutionPlan.ExecutionPlan p r2 e2 (Errors e) ->
  (ExecutionPlan.Event e ->{r} Unit)^c ->
  (Eff (p + r) e a)^c ->{Async | r + r2; e + e2}
  a
foreign effect with_execution_plan from "flick:Effect" "flickWithExecutionPlan"
  arity 1
  retention call
