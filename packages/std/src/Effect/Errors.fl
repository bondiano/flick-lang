/// The part of `Effect` that sees the whole failure of a task: its cause as
/// an opaque `Failure`, its exit, a defect as inert text, and finalizers.
/// Typed errors alone are handled by `try … with`.
module Effect.Errors exposing (..)

import LogLevel

/// Handles every failure of `task`, defects and interruptions included,
/// with `f` of its cause.
catch_cause : (Failure e ->{r2; e2} a)^c -> (Eff r e a)^c ->{r + r2; e2} a
foreign effect catch_cause from "flick:Effect" "flickCatchCause"
  arity 1
  retention call

/// `catch_cause` of the failures `p` holds for; the others stay.
catch_cause_if :
  (Failure e -> Bool)^c -> (Failure e ->{r2; e2} a)^c -> (Eff r e a)^c ->{r + r2; e + e2} a
foreign effect catch_cause_if from "flick:Effect" "flickCatchCauseIf"
  arity 2
  retention call

/// `catch_cause` of the failures the filter passes, with what it gave; a
/// failure it refuses stays as the filter returns it.
catch_cause_filter :
  (Failure e -> Result (Failure e) b)^c ->
  (b -> Failure e ->{r2; e2} a)^c ->
  (Eff r e a)^c ->{r + r2; e + e2}
  a
foreign effect catch_cause_filter from "flick:Effect" "flickCatchCauseFilter"
  arity 2
  retention call

/// Recovers from a defect of `task` with `f` of its inert text; typed
/// failures stay.
catch_defect : (String ->{r2; e2} a)^c -> (Eff r e a)^c ->{r + r2; e + e2} a
foreign effect catch_defect from "flick:Effect" "flickCatchDefect"
  arity 1
  retention call

/// Runs `f` of the cause when `task` fails, then fails as it did.
tap_cause : (Failure e ->{r2; e2} b)^c -> (Eff r e a)^c ->{r + r2; e + e2} a
foreign effect tap_cause from "flick:Effect" "flickTapCause"
  arity 1
  retention call

/// `tap_cause` of the failures `p` holds for.
tap_cause_if :
  (Failure e -> Bool)^c -> (Failure e ->{r2; e2} b)^c -> (Eff r e a)^c ->{r + r2; e + e2} a
foreign effect tap_cause_if from "flick:Effect" "flickTapCauseIf"
  arity 2
  retention call

/// `tap_cause` of the failures the filter passes, with what it gave.
tap_cause_filter :
  (Failure e -> Result (Failure e) b)^c ->
  (b -> Failure e ->{r2; e2} x)^c ->
  (Eff r e a)^c ->{r + r2; e + e2}
  a
foreign effect tap_cause_filter from "flick:Effect" "flickTapCauseFilter"
  arity 2
  retention call

/// Runs `f` of a defect's inert text when `task` dies, then dies as it did.
tap_defect : (String ->{r2; e2} b)^c -> (Eff r e a)^c ->{r + r2; e + e2} a
foreign effect tap_defect from "flick:Effect" "flickTapDefect"
  arity 1
  retention call

/// `on_failure` of the cause or `on_success` of the value; never fails.
match_cause : (Failure e -> b)^c -> (a -> b)^c -> (Eff r e a)^c ->{r} b
foreign effect match_cause from "flick:Effect" "flickMatchCause"
  arity 2
  retention call

/// `match_cause`, reading an already ended task without a new step.
match_cause_eager : (Failure e -> b)^c -> (a -> b)^c -> (Eff r e a)^c ->{r} b
foreign effect match_cause_eager from "flick:Effect" "flickMatchCauseEager"
  arity 2
  retention call

/// Runs `on_failure` of the cause or `on_success` of the value.
match_cause_effect :
  (Failure e ->{r2; e2} b)^c -> (a ->{r3; e3} b)^c -> (Eff r e a)^c ->{r + r2 + r3; e2 + e3} b
foreign effect match_cause_effect from "flick:Effect" "flickMatchCauseEffect"
  arity 2
  retention call

/// `match_cause_effect`, reading an already ended task without a new step.
match_cause_effect_eager :
  (Failure e ->{r2; e2} b)^c -> (a ->{r3; e3} b)^c -> (Eff r e a)^c ->{r + r2 + r3; e2 + e3} b
foreign effect match_cause_effect_eager from "flick:Effect" "flickMatchCauseEffectEager"
  arity 2
  retention call

/// Turns each typed failure of `task` into a defect.
or_die : (Eff r e a)^c ->{r} a
foreign effect or_die from "flick:Effect" "orDie"
  retention call

/// Runs `task` and drops its typed failure, logging it at the level if
/// one is given.
ignore_ : Option LogLevel.LogLevel -> (Eff r e a)^c ->{r} Unit
foreign effect ignore_ from "flick:Effect" "flickIgnore"
  arity 1
  retention call

/// Runs `task` and drops any failure, defects included, logging it at the
/// level if one is given.
ignore_cause : Option LogLevel.LogLevel -> (Eff r e a)^c ->{r} Unit
foreign effect ignore_cause from "flick:Effect" "flickIgnoreCause"
  arity 1
  retention call

/// Runs `finalizer` after `task`, however it ends.
ensuring : (Eff r2 none b)^c -> (Eff r e a)^c ->{r + r2; e} a
foreign effect ensuring from "flick:Effect" "ensuring"
  arity 1
  retention call

/// Runs `cleanup` of the cause when `task` fails, then fails as it did.
on_error : (Failure e ->{r2} b)^c -> (Eff r e a)^c ->{r + r2; e} a
foreign effect on_error from "flick:Effect" "flickOnError"
  arity 1
  retention call

/// `on_error` of the failures `p` holds for.
on_error_if :
  (Failure e -> Bool)^c -> (Failure e ->{r2; e2} Unit)^c -> (Eff r e a)^c ->{r + r2; e + e2} a
foreign effect on_error_if from "flick:Effect" "flickOnErrorIf"
  arity 2
  retention call

/// `on_error` of the failures the filter passes, with what it gave.
on_error_filter :
  (Failure e -> Result (Failure e) b)^c ->
  (b -> Failure e ->{r2; e2} Unit)^c ->
  (Eff r e a)^c ->{r + r2; e + e2}
  a
foreign effect on_error_filter from "flick:Effect" "flickOnErrorFilter"
  arity 2
  retention call

/// Runs `f` of the exit after `task`, however it ends.
on_exit : (Exit e a ->{r2; e2} Unit)^c -> (Eff r e a)^c ->{r + r2; e + e2} a
foreign effect on_exit from "flick:Effect" "flickOnExit"
  arity 1
  retention call

/// `on_exit` of the exits `p` holds for.
on_exit_if :
  (Exit e a -> Bool)^c -> (Exit e a ->{r2; e2} Unit)^c -> (Eff r e a)^c ->{r + r2; e + e2} a
foreign effect on_exit_if from "flick:Effect" "flickOnExitIf"
  arity 2
  retention call

/// `on_exit` of the exits the filter passes, with what it gave.
on_exit_filter :
  (Exit e a -> Result x b)^c ->
  (b -> Exit e a ->{r2; e2} Unit)^c ->
  (Eff r e a)^c ->{r + r2; e + e2}
  a
foreign effect on_exit_filter from "flick:Effect" "flickOnExitFilter"
  arity 2
  retention call

/// `on_exit` with a finalizer `f` may skip by giving `None`; with
/// `interruptible` the finalizer may be interrupted.
on_exit_primitive :
  Bool -> (Exit e a -> Option (Eff r2 e2 Unit))^c -> (Eff r e a)^c ->{r + r2; e + e2} a
foreign effect on_exit_primitive from "flick:Effect" "flickOnExitPrimitive"
  arity 2
  retention call

/// Runs `f` of the ids of the interrupting fibers when `task` is
/// interrupted.
on_interrupt : (List Float ->{r2; e2} Unit)^c -> (Eff r e a)^c ->{r + r2; e + e2} a
foreign effect on_interrupt from "flick:Effect" "flickOnInterrupt"
  arity 1
  retention call

/// Registers `finalizer` with the owner of region `s`: it runs when that
/// scope closes, with the cause of its failure if it failed.
add_finalizer : (Option RawCause ->{r} Unit)^c ->{Scope s | r} Unit
foreign effect add_finalizer from "flick:Effect" "flickAddFinalizer"
  retention owner

/// Runs `task`, reporting its failures (only defects with `defects_only`)
/// to the current error reporters.
with_error_reporting : Bool -> (Eff r e a)^c ->{r; e} a
foreign effect with_error_reporting from "flick:Effect" "flickWithErrorReporting"
  arity 1
  retention call
