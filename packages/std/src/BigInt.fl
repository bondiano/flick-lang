/// Operations on `BigInt`. The operators `/` and `%` divide by zero to zero;
/// the checked forms return the error instead.
module BigInt exposing (..)

/// The integer a number holds exactly, if it is one.
from_number : Float -> Option BigInt
foreign pure from_number from "flick:rt" "bigintFromNumber"

/// The nearest number: a lossy conversion.
to_number : BigInt -> Float
foreign pure to_number from global "Number"

/// The decimal digits, without `n`.
to_string : BigInt -> String
foreign pure to_string from global "String"

/// The integer of optional sign and decimal digits, blanks around allowed.
parse : String -> Option BigInt
let parse s =
  let text = String.trim s
  let sign = String.char_code_at 0 text
  let negative = sign == Some 45
  let start = if negative || sign == Some 43 then 1 else 0
  digits : Int -> BigInt -> Option BigInt
  let rec digits i n =
    match String.char_code_at i text with
    | Some c -> if c >= 48 && c <= 57 then digits (i + 1) (n * 10n + into (c - 48)) else None
    | None -> Some (if negative then -n else n)
  if String.length text > start then digits start 0n else None
  @native "flick:rt" "bigintParse" when js || go

/// The absolute value.
abs : BigInt -> BigInt
let abs n = if n < 0n then -n else n
  @native "flick:BigInt" "abs" when js || go

/// Division rounding toward zero.
divide : BigInt -> BigInt -> Result Int.ArithmeticError BigInt
let divide a b = if b == 0n then Err (Int.ArithmeticError "division by zero") else Ok (a / b)
  @native "flick:rt" "bigintDivide" when js || go

/// The remainder of division rounding toward zero, with the sign of the dividend.
remainder : BigInt -> BigInt -> Result Int.ArithmeticError BigInt
let remainder a b = if b == 0n then Err (Int.ArithmeticError "division by zero") else Ok (a % b)
  @native "flick:rt" "bigintRemainder" when js || go

/// `self + that`: `x |> BigInt.sum 1n`.
sum : BigInt -> BigInt -> BigInt
let sum that self = self + that
  @native "flick:BigInt" "sum" when js || go
    arity 1

/// `self - that`.
subtract : BigInt -> BigInt -> BigInt
let subtract that self = self - that
  @native "flick:BigInt" "subtract" when js || go
    arity 1

/// `self * that`.
multiply : BigInt -> BigInt -> BigInt
let multiply that self = self * that
  @native "flick:BigInt" "multiply" when js || go
    arity 1

/// `n + 1n`.
increment : BigInt -> BigInt
let increment n = n + 1n
  @native "flick:BigInt" "increment" when js || go

/// `n - 1n`.
decrement : BigInt -> BigInt
let decrement n = n - 1n
  @native "flick:BigInt" "decrement" when js || go

/// The greatest common divisor, not negative.
gcd : BigInt -> BigInt -> BigInt
let gcd that self =
  euclid : BigInt -> BigInt -> BigInt
  let rec euclid a b = if b == 0n then a else euclid b (a % b)
  euclid (abs self) (abs that)
  @native "flick:BigInt" "gcd" when js || go
    arity 1

/// The least common multiple, not negative; 0 when either is 0.
lcm : BigInt -> BigInt -> BigInt
let lcm that self = if self == 0n || that == 0n then 0n else abs (self / gcd that self * that)
  @native "flick:BigInt" "lcm" when js || go
    arity 1

/// The integer square root; `None` for a negative number.
sqrt : BigInt -> Option BigInt
let sqrt n =
  // Newton's steps down from n / 2, to the floor of the root
  down : BigInt -> BigInt
  let rec down guess = if guess * guess > n then down ((guess + n / guess) / 2n) else guess
  if n < 0n then None else if n < 2n then Some n else Some (down (n / 2n))
  @native "flick:BigInt" "sqrt" when js || go

/// The sum of the list, 0 when it is empty.
sum_all : List BigInt -> BigInt
let sum_all xs =
  total : BigInt -> Int -> BigInt
  let rec total out i =
    match List.get i xs with
    | Some n -> total (out + n) (i + 1)
    | None -> out
  total 0n 0
  @native "flick:BigInt" "sumAll" when js || go

/// The product of the list, 1 when it is empty.
multiply_all : List BigInt -> BigInt
let multiply_all xs =
  product : BigInt -> Int -> BigInt
  let rec product out i =
    match List.get i xs with
    | Some n -> product (out * n) (i + 1)
    | None -> out
  product 1n 0
  @native "flick:BigInt" "multiplyAll" when js || go

/// The lesser of the two.
min : BigInt -> BigInt -> BigInt
let min that self = if self < that then self else that
  @native "flick:BigInt" "min" when js || go
    arity 1

/// The greater of the two.
max : BigInt -> BigInt -> BigInt
let max that self = if self > that then self else that
  @native "flick:BigInt" "max" when js || go
    arity 1

/// `self < that`: `x |> BigInt.is_less_than 3n`.
is_less_than : BigInt -> BigInt -> Bool
let is_less_than that self = self < that
  @native "flick:BigInt" "isLessThan" when js || go
    arity 1

/// `self <= that`.
is_less_than_or_equal_to : BigInt -> BigInt -> Bool
let is_less_than_or_equal_to that self = self <= that
  @native "flick:BigInt" "isLessThanOrEqualTo" when js || go
    arity 1

/// `self > that`.
is_greater_than : BigInt -> BigInt -> Bool
let is_greater_than that self = self > that
  @native "flick:BigInt" "isGreaterThan" when js || go
    arity 1

/// `self >= that`.
is_greater_than_or_equal_to : BigInt -> BigInt -> Bool
let is_greater_than_or_equal_to that self = self >= that
  @native "flick:BigInt" "isGreaterThanOrEqualTo" when js || go
    arity 1

/// Whether `self` lies within `minimum` and `maximum`, both included.
between : { minimum : BigInt; maximum : BigInt } -> BigInt -> Bool
let between bounds self = self >= bounds.minimum && self <= bounds.maximum
  @native "flick:BigInt" "between" when js || go
    arity 1

/// `self` kept within `minimum` and `maximum`.
clamp : { minimum : BigInt; maximum : BigInt } -> BigInt -> BigInt
let clamp bounds self =
  if self < bounds.minimum then
    bounds.minimum
  else if self > bounds.maximum then
    bounds.maximum
  else
    self
  @native "flick:BigInt" "clamp" when js || go
    arity 1

/// The number, when the integer is a safe one.
to_safe_number : BigInt -> Option Float
let to_safe_number n =
  if n > 9007199254740991n || n < -9007199254740991n then None else Some (to_number n)
  @native "flick:BigInt" "toNumber" when js || go

/// The integer of a safe integer number.
from_safe_number : Float -> Option BigInt
let from_safe_number x = if Float.is_safe_integer x then from_number x else None
  @native "flick:BigInt" "fromNumber" when js || go

/// The integer JS `BigInt` reads from the string (`"12"`, `"0x1f"`); blank or
/// malformed text is `None`.
from_string : String -> Option BigInt
let from_string text =
  let trimmed = String.trim text
  // JS's `0x`, `0o` and `0b`, without a sign
  let base =
    match String.slice 0 2 trimmed with
    | "0x" | "0X" -> 16
    | "0o" | "0O" -> 8
    | "0b" | "0B" -> 2
    | _ -> 10
  digit : Int -> Int
  let digit c =
    if c >= 48 && c <= 57 then
      c - 48
    else if c >= 97 && c <= 122 then
      c - 87
    else if c >= 65 && c <= 90 then
      c - 55
    else
      99
  value : BigInt -> Int -> Option BigInt
  let rec value acc i =
    match String.char_code_at i trimmed with
    | Some c ->
      let d = digit c
      if d < base then value (acc * into base + into d) (i + 1) else None
    | None -> Some acc
  if trimmed == "" then
    None
  else if base == 10 then
    parse trimmed
  else if String.length trimmed > 2 then
    value 0n 2
  else
    None
  @native "flick:BigInt" "fromString" when js || go

/// How `n` compares with 0.
sign : BigInt -> Ordering
let sign n = if n < 0n then LT else if n > 0n then GT else EQ
  @native "flick:BigInt" "flickSign" when js || go

/// A BigInt as a JSON string of digits.
json : PureCodec Json BigInt
foreign pure json from "flick:rt" "codecBigint"
