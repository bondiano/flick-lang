/// Immutable hash maps; each map keeps the witness of its keys.
module HashMap exposing (..)

import EqHash

/// A map from keys `k` to values `v` under the witness `w` of its keys.
type HashMap w k v

/// The empty map of the witness.
with : EqHash.EqHash w k -> HashMap w k v
foreign pure with from "flick:rt" "hashMapWith"

/// The empty map of the canonical instances.
empty : Hash k => HashMap EqHash.Canonical k v
foreign pure empty from "flick:rt" "hashMapEmpty"

/// The map with `key` bound to `value`.
insert : k -> v -> HashMap w k v -> HashMap w k v
foreign pure insert from "flick:rt" "hashMapInsert"

/// The map without `key`.
remove : k -> HashMap w k v -> HashMap w k v
foreign pure remove from "flick:rt" "hashMapRemove"

/// The value of `key`, if the map has it.
get : k -> HashMap w k v -> Option v
foreign pure get from "flick:rt" "hashMapGet"

/// The number of entries.
size : HashMap w k v -> Int
foreign pure size from "flick:rt" "hashMapSize"

/// The entries, in no particular order.
to_list : HashMap w k v -> List (k, v)
foreign pure to_list from "flick:rt" "hashMapToList"

/// The entries of both maps, the second's value for a key both have; their
/// witness must be the same.
union : HashMap w k v -> HashMap w k v -> HashMap w k v
foreign pure union from "flick:rt" "hashMapUnion"

/// The same entries under another witness of the keys.
rehash : EqHash.EqHash x k -> HashMap w k v -> HashMap x k v
foreign pure rehash from "flick:rt" "hashMapRehash"

/// The map of the entries under the witness; a later entry for a key
/// replaces an earlier one.
from_list : EqHash.EqHash w k -> List (k, v) -> HashMap w k v
foreign pure from_list from "flick:HashMap" "flickFromList"

/// The map of the pairs of a sequence, such as a `for` that yields them,
/// as `from_list` builds it: `HashMap.from_seq EqHash.canonical (for { … } yield (k, v))`.
from_seq : EqHash.EqHash w k -> (Seq (k, v))^d -> HashMap w k v
let from_seq witness pairs = from_list witness (Seq.to_list pairs)

/// The entries as a sequence, in no particular order: a source of `for`.
to_seq : HashMap w k v -> Seq (k, v)
let to_seq map = Seq.of_list (to_list map)

/// Whether the map has no entries.
is_empty : HashMap w k v -> Bool
foreign pure is_empty from "flick:HashMap" "flickIsEmpty"

/// Whether the map has `key`.
has : k -> HashMap w k v -> Bool
foreign pure has from "flick:HashMap" "flickHas"

/// `get` with the key's hash already computed by the map's witness; another
/// hash finds nothing.
get_hash : k -> Int -> HashMap w k v -> Option v
foreign pure get_hash from "flick:HashMap" "flickGetHash"

/// `has` with the key's hash already computed by the map's witness.
has_hash : k -> Int -> HashMap w k v -> Bool
foreign pure has_hash from "flick:HashMap" "flickHasHash"

/// Whether some entry satisfies `f value key`.
has_by : (v -> k -> Bool)^c -> HashMap w k v -> Bool
foreign pure has_by from "flick:HashMap" "flickHasBy"
  arity 2
  retention call

/// The keys, in no particular order.
keys : HashMap w k v -> List k
foreign pure keys from "flick:HashMap" "flickKeys"

/// The values, in no particular order.
values : HashMap w k v -> List v
foreign pure values from "flick:HashMap" "flickValues"

/// The map with the entry of `key` decided by `f`: it gets the current value,
/// if any, and `None` removes the key.
modify_at : k -> (Option v -> Option v)^c -> (HashMap w k v -> HashMap w k v)^c
foreign pure modify_at from "flick:HashMap" "flickModifyAt"
  arity 3
  retention call

/// `modify_at` with the key's hash already computed by the map's witness.
modify_hash : k -> Int -> (Option v -> Option v)^c -> (HashMap w k v -> HashMap w k v)^c
foreign pure modify_hash from "flick:HashMap" "flickModifyHash"
  arity 4
  retention call

/// The map with the value of `key` replaced by `f value`, if it has the key.
modify : k -> (v -> v)^c -> (HashMap w k v -> HashMap w k v)^c
foreign pure modify from "flick:HashMap" "flickModify"
  arity 3
  retention call

/// The map without any of the keys.
remove_many : List k -> HashMap w k v -> HashMap w k v
foreign pure remove_many from "flick:HashMap" "flickRemoveMany"

/// The map with each entry inserted in order.
insert_many : List (k, v) -> HashMap w k v -> HashMap w k v
foreign pure insert_many from "flick:HashMap" "flickSetMany"

/// Each value mapped by `f value key`.
map : (v -> k -> b)^c -> HashMap w k v -> HashMap w k b
foreign pure map from "flick:HashMap" "flickMap"
  arity 2
  retention call

/// The union of the maps `f value key` gives for each entry.
flat_map : (v -> k -> HashMap w k b)^c -> HashMap w k v -> HashMap w k b
foreign pure flat_map from "flick:HashMap" "flickFlatMap"
  arity 2
  retention call

/// Folds the entries in no particular order: `f acc value key`.
reduce : z -> (z -> v -> k -> z)^c -> (HashMap w k v -> z)^c
foreign pure reduce from "flick:HashMap" "flickReduce"
  arity 3
  retention call

/// The entries for which `f value key` holds.
filter : (v -> k -> Bool)^c -> HashMap w k v -> HashMap w k v
foreign pure filter from "flick:HashMap" "flickFilter"
  arity 2
  retention call

/// The entries whose value is `Some`, unwrapped.
compact : HashMap w k (Option v) -> HashMap w k v
foreign pure compact from "flick:HashMap" "flickCompact"

/// The entries `f value key` keeps with `Ok`, mapped to its value.
filter_map : (v -> k -> Result x b)^c -> HashMap w k v -> HashMap w k b
foreign pure filter_map from "flick:HashMap" "flickFilterMap"
  arity 2
  retention call

/// Some entry for which `f value key` holds, if any.
find_first : (v -> k -> Bool)^c -> HashMap w k v -> Option (k, v)
foreign pure find_first from "flick:HashMap" "flickFindFirst"
  arity 2
  retention call

/// Whether `f value key` holds for some entry.
some : (v -> k -> Bool)^c -> HashMap w k v -> Bool
foreign pure some from "flick:HashMap" "flickSome"
  arity 2
  retention call

/// Whether `f value key` holds for every entry.
every : (v -> k -> Bool)^c -> HashMap w k v -> Bool
foreign pure every from "flick:HashMap" "flickEvery"
  arity 2
  retention call

/// Runs `f value key` on each entry, in no particular order.
for_each : (v -> k ->{r; e} Unit)^c -> HashMap w k v ->{r; e} Unit
let for_each f m = List.each_effect (fun (key, value) -> f value key) (to_list m)

/// A map as a JSON array of `[key, value]` pairs, rebuilt with the
/// canonical instances; of a repeated key the last pair wins.
json :
  Hash k => PureCodec Json k -> PureCodec Json v -> PureCodec Json (HashMap EqHash.Canonical k v)
foreign pure json from "flick:Schema" "flickHashMapJson"
