/// A count of permits taken and given back inside `Tx.atomically`
/// transactions; taking more than are available retries the transaction
/// until they are.
module TxSemaphore exposing (..)

import Tx

/// A transactional semaphore.
type TxSemaphore

/// A new semaphore with `permits` permits, all available.
make : Int ->{} TxSemaphore
foreign effect make from "flick:TxSemaphore" "make"

/// The permits not taken.
available : TxSemaphore ->{Tx.Transaction} Int
foreign effect available from "flick:TxSemaphore" "available"

/// The permits it was made with.
capacity : TxSemaphore ->{Tx.Transaction} Int
foreign effect capacity from "flick:TxSemaphore" "capacity"

/// Takes a permit, waiting for one.
acquire : TxSemaphore ->{Async, Tx.Transaction} Unit
foreign effect acquire from "flick:TxSemaphore" "acquire"

/// Takes `n` permits, waiting for them.
acquire_n : Int -> TxSemaphore ->{Async, Tx.Transaction} Unit
foreign effect acquire_n from "flick:TxSemaphore" "acquireN"
  arity 1

/// Takes a permit if one is available.
try_acquire : TxSemaphore ->{Tx.Transaction} Bool
foreign effect try_acquire from "flick:TxSemaphore" "tryAcquire"

/// Takes `n` permits if they are available.
try_acquire_n : Int -> TxSemaphore ->{Tx.Transaction} Bool
foreign effect try_acquire_n from "flick:TxSemaphore" "tryAcquireN"
  arity 1

/// Gives back a permit.
release : TxSemaphore ->{Tx.Transaction} Unit
foreign effect release from "flick:TxSemaphore" "release"

/// Gives back `n` permits.
release_n : Int -> TxSemaphore ->{Tx.Transaction} Unit
foreign effect release_n from "flick:TxSemaphore" "releaseN"
  arity 1

/// Runs `body` holding a permit.
with_permit : TxSemaphore -> ((Eff r e a)^c ->{r; e} a)^c
foreign effect with_permit from "flick:TxSemaphore" "withPermit"
  arity 1
  retention call

/// Runs `body` holding `n` permits.
with_permits : TxSemaphore -> Int -> ((Eff r e a)^c ->{r; e} a)^c
foreign effect with_permits from "flick:TxSemaphore" "withPermits"
  arity 2
  retention call

/// Holds a permit until the scope of region `s` closes.
with_permit_scoped : TxSemaphore ->{Scope s} Unit
foreign effect with_permit_scoped from "flick:TxSemaphore" "withPermitScoped"
