/// An API as a type: a record that derives `HttpApi` is a group whose
/// fields are its endpoints, `field : Get "/path/:id" req res {E1, E2}`. The
/// field names the endpoint and the type's name in snake case the group;
/// `req` is a record of the parts the request has, of `path`, `query`,
/// `headers` and `payload`; `res` is the success, sent with 200,
/// `Created res` with 201 and `Unit` with 204 and no body; each error of
/// the row is sent as its `Problem` instance says.
///
/// ```flick
/// type alias Users = {
///   current_user : Authed (Get "/api/user" { headers : Credentials } UserBody {Unauthorized});
///   profile : Get "/api/profiles/:username" { path : ProfilePath } ProfileBody {NotFound};
/// } deriving HttpApi
/// ```
///
/// The path is a string, or a constructor of a route type that derives
/// `Url` with the type of each parameter in place of a value:
/// `Get (Profiles Username None)` is `"/profiles/:username"`.
///
/// The type has the companions `Users.endpoints`, the record of its
/// endpoints, which `HttpApi.call` requests, and `Users.api`, the group,
/// which `HttpApi.add_group` adds to an API. With `Authed` or `MaybeAuthed`
/// endpoints, `Users.api` takes the security scheme, the service those
/// endpoints get and how a request makes it, required and optional, as
/// `HttpApi.with_auth` and `HttpApi.with_optional_auth` do.
///
/// A part is decoded by the value named after its type in snake case in the
/// type's module, `update_user_body` for `UpdateUserBody`, when that is a
/// `PureCodec Json` of it, else by the JSON codec of its schema.
module HttpApi.Derive exposing (..)

import Codec
import HttpApi exposing (Endpoint, ErrorCases, Request, Security, error_case, with_success)
import Schema

/// What `deriving HttpApi` makes of a record: its companions `api` and
/// `endpoints`, which std's plugin writes with the functions below.
@derive std
class HttpApi a

/// An endpoint at `path` of a record that derives `HttpApi`; `Post`,
/// `Put`, `Patch` and `Delete` are the other methods.
type Get (path : Symbol) req res (e : ErrorRow)

type Post (path : Symbol) req res (e : ErrorRow)

type Put (path : Symbol) req res (e : ErrorRow)

type Patch (path : Symbol) req res (e : ErrorRow)

type Delete (path : Symbol) req res (e : ErrorRow)

/// The success `a`, sent with 201.
type Created a

/// The endpoint needs the service its group's check makes; without valid
/// credentials the check fails, and the handler does not run.
type Authed endpoint

/// The endpoint gets the service of its group's optional check, which also
/// serves anonymous requests.
type MaybeAuthed endpoint

/// How an error of an endpoint is answered: its status and its JSON body.
class Problem e =
  problem : { status : Int; body : PureCodec Json e }

/// The cases and the error `t`, as its `Problem` instance says.
problem_case : Problem t => ErrorCases e -> ErrorCases {t | e}
let problem_case cases =
  let answer = problem
  error_case answer.status answer.body cases

/// What a group serves for an endpoint.
type alias Handler p q h b (r : ServiceRow) (e : ErrorRow) s = Request p q h b ->{r; e} s

/// What a group serves for an `Authed` or `MaybeAuthed` endpoint: its
/// handler also gets the service `a` the group's check makes.
type alias Guarded p q h b (a : ServiceRow) (r : ServiceRow) (e : ErrorRow) s =
  Request p q h b ->{a + r; e} s

/// A group with `Authed` or `MaybeAuthed` endpoints, `g`, given the security
/// scheme, the service `a` they get and how a request with the headers `h`
/// makes it, failing with the errors `e` every such endpoint declares.
type alias Secured (a : ServiceRow) (r : ServiceRow) h (e : ErrorRow) g =
  Security ->
    ServiceTag a ->
    Handler Unit Unit h Unit r e (ServiceImpl a) ->
    Handler Unit Unit h Unit r e (ServiceImpl a) ->
    g

@lang wire_codec
/// The codec of a part or the success of a derived endpoint, written
/// `(wire_codec : PureCodec Json T)`: the compiler puts in its place the
/// value named after `T` in snake case in `T`'s module when that is a
/// `PureCodec Json T`, else `T.json` of a refined type or `String.json` of
/// a type of the Prelude, else the JSON codec of `T`'s schema.
wire_codec : PureCodec Json t
// never run: each use is one of the codecs above
let wire_codec = Codec.json (Schema.recursive "wire_codec" (fun itself -> itself))

@lang path_params
/// The `:name` parameters of the path `path` are the fields of the record
/// `p`, or there are none and `p` is no record: the compiler knows.
class PathParams (path : Symbol) p

/// The endpoint `method` serves at `path` as `label`, its parts, success
/// and errors added by `parts`; the `:name` parameters of the path are the
/// fields of its `path` part. The path is a string, or a route type's
/// constructor: `Profiles Username None` is `"/profiles/:username"`.
at :
  PathParams path p =>
  HttpApi.Method ->
  Record.Label path ->
  Record.Label l ->
  (Endpoint l (Request Unit Unit Unit Unit ->{r; none} Unit) ->
    Endpoint l (Request p q h b ->{r; e} s)) ->
  Endpoint l (Request p q h b ->{r; e} s)
let at method path label parts = parts (HttpApi.endpoint method (path_text path) label)

/// The path a label stands for.
path_text : Record.Label path -> String
foreign pure path_text from "@flick-lang/runtime" "identity"

/// The success `s2`, sent with 200.
ok :
  PureCodec Json s2 ->
  Endpoint l (Request p q h b ->{r; e} s) ->
  Endpoint l (Request p q h b ->{r; e} s2)
let ok success endpoint = with_success 200 success endpoint

/// The success `s2`, sent with 201.
created :
  PureCodec Json s2 ->
  Endpoint l (Request p q h b ->{r; e} s) ->
  Endpoint l (Request p q h b ->{r; e} s2)
let created success endpoint = with_success 201 success endpoint

/// The request with only its headers, which is what a group's check reads.
headers_of : Request p q h b -> Request Unit Unit h Unit
let headers_of request = { path = (); query = (); headers = request.headers; payload = () }

/// `HttpApi.with_auth` with a check of the headers, failing with errors the
/// endpoint declares.
with_header_auth :
  Security ->
  ServiceTag a ->
  Handler Unit Unit h Unit r e (ServiceImpl a) ->
  Endpoint l (Request p q h b ->{a + r; e} s) ->
  Endpoint l (Request p q h b ->{a + r; e} s)
let with_header_auth security tag check endpoint =
  HttpApi.with_auth security tag (fun request -> check (headers_of request)) endpoint

/// `HttpApi.with_optional_auth` with a check of the headers.
with_optional_header_auth :
  Security ->
  ServiceTag a ->
  Handler Unit Unit h Unit r e (ServiceImpl a) ->
  Endpoint l (Request p q h b ->{a + r; e} s) ->
  Endpoint l (Request p q h b ->{a + r; e} s)
let with_optional_header_auth security tag check endpoint =
  HttpApi.with_optional_auth security tag (fun request -> check (headers_of request)) endpoint
