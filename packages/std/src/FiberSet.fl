/// A set of children owned by a `scope`, interrupted when it closes. `join`
/// waits for the first failure of any of them, so the set is the supervisor
/// of the children it runs.
module FiberSet exposing (..)

import Fiber

/// Children of region `s` that fail with an error of `e` or succeed with `a`.
type FiberSet (s : Region) (e : ErrorRow) a

/// How `run` starts a child: `propagateInterruption` makes an interruption
/// of the child fail `join`; `startImmediately` runs it before `run` returns.
type alias RunOptions = { propagateInterruption : Bool; startImmediately : Bool }

/// An empty set owned by the innermost `scope` (or the one of region `s`).
make : Unit ->{Scope s} FiberSet s e a
foreign effect make from "flick:FiberSet" "flickMake"
  arity 0

/// Runs `task` as a child of the set; it may hold only what outlives the
/// set's region.
run :
  Fiber.Outlives c s =>
  RunOptions -> (Eff {Scope s | r} e a)^c -> FiberSet s e a ->{r} Fiber.Fiber e a
foreign effect run from "flick:FiberSet" "flickRun"
  arity 1
  retention owner

/// Adds a child spawned elsewhere; with `propagate_interruption` its
/// interruption fails `join`.
add : Bool -> Fiber.Fiber e a -> FiberSet s e a ->{} Unit
foreign effect add from "flick:FiberSet" "flickAdd"
  arity 1
  retention call

/// Interrupts every child and empties the set.
clear : FiberSet s e a ->{Async} Unit
foreign effect clear from "flick:FiberSet" "clear"
  retention call

/// How many children are running.
size : FiberSet s e a ->{} Int
foreign effect size from "flick:FiberSet" "size"
  retention call

/// Waits until the scope closes or a child fails, and fails as it did.
join : FiberSet s e a ->{Async; e} Unit
foreign effect join from "flick:FiberSet" "join"
  retention call

/// Waits until no child is running.
await_empty : FiberSet s e a ->{Async} Unit
foreign effect await_empty from "flick:FiberSet" "awaitEmpty"
  retention call
