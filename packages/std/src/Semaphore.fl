/// A number of permits that tasks take and give back, limiting how many run
/// at once.
module Semaphore exposing (..)

/// A pool of permits.
type Semaphore

/// A semaphore with `permits` permits.
make : Int ->{} Semaphore
foreign effect make from "flick:Semaphore" "make"

/// Changes the number of permits; tasks holding permits keep them.
resize : Int -> Semaphore ->{} Unit
foreign effect resize from "flick:Semaphore" "resize"
  arity 1

/// Runs `task` holding `permits` permits, waiting for them first; they are
/// given back however it ends.
with_permits : Semaphore -> Int -> (Eff r e a)^c ->{r; e} a
foreign effect with_permits from "flick:Semaphore" "withPermits"
  arity 2
  retention call

/// `with_permits` with one permit.
with_permit : Semaphore -> (Eff r e a)^c ->{r; e} a
foreign effect with_permit from "flick:Semaphore" "withPermit"
  arity 1
  retention call

/// Runs `task` with `permits` permits if they are free now, `None` without
/// running it otherwise.
with_permits_if_available : Semaphore -> Int -> (Eff r e a)^c ->{r; e} Option a
foreign effect with_permits_if_available from "flick:Semaphore" "withPermitsIfAvailable"
  arity 2
  retention call

/// Takes `permits` permits, waiting until they are free; the number taken.
take : Int -> Semaphore ->{Async} Int
foreign effect take from "flick:Semaphore" "take"
  arity 1

/// Takes `permits` permits if they are free now; whether it did.
take_if_available : Int -> Semaphore ->{} Bool
foreign effect take_if_available from "flick:Semaphore" "takeIfAvailable"
  arity 1

/// Gives back `permits` permits; the permits free after.
release : Int -> Semaphore ->{} Int
foreign effect release from "flick:Semaphore" "release"
  arity 1

/// Gives back every permit taken; the permits free after.
release_all : Semaphore ->{} Int
foreign effect release_all from "flick:Semaphore" "releaseAll"
