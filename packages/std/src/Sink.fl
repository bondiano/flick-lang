foreign pure fail_cause from "@flick-lang/effect-ts/effect/Sink" "flickFailCause"
  reviewed "effect@4.1.2 sha256:9dde72609fde03bf"

/// Fails with the cause of the failure `f` computes when it runs.
fail_cause_sync : (Unit -> Failure e) -> Sink none e i l a
foreign pure fail_cause_sync from "@flick-lang/effect-ts/effect/Sink" "flickFailCauseSync"
  reviewed "effect@4.1.2 sha256:96763334c6a0934c"

/// Consumes everything and never ends.
never : Sink none none i l a
foreign pure never from "@flick-lang/effect-ts/effect/Sink" "never"
  reviewed "effect@4.1.2 sha256:a7d0529bf85187ba"

/// The sink without its leftovers.
ignore_leftover : Sink r e i l a -> Sink r e i l2 a
foreign pure ignore_leftover from "@flick-lang/effect-ts/effect/Sink" "ignoreLeftover"
  reviewed "effect@4.1.2 sha256:c9cf1505d19c2ce5"

/// Consumes everything, giving nothing.
drain : Sink none none i l Unit
foreign pure drain from "@flick-lang/effect-ts/effect/Sink" "drain"
  reviewed "effect@4.1.2 sha256:96e1077debf00e32"

/// Folds elements from `initial` with `f` while `continue` holds of the
