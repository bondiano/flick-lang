foreign pure from_pubsub from "@flick-lang/effect-ts/effect/Sink" "fromPubSub"
  reviewed "effect@4.1.2 sha256:185b5de08415f467"

/// Consumes nothing and gives the value.
succeed : a -> Sink none none i l a
foreign pure succeed from "@flick-lang/effect-ts/effect/Sink" "succeed"
  reviewed "effect@4.1.2 sha256:983d2c73de619f59"

/// Consumes nothing and gives the value `f` computes when it runs.
sync : (Unit -> a) -> Sink none none i l a
foreign pure sync from "@flick-lang/effect-ts/effect/Sink" "sync"
  reviewed "effect@4.1.2 sha256:0fd3fd651767b37d"

/// The sink `f` builds each time it runs.
suspend : (Unit -> Sink r e i l a) -> Sink r e i l a
foreign pure suspend from "@flick-lang/effect-ts/effect/Sink" "suspend"
  reviewed "effect@4.1.2 sha256:ff7088c26b505c32"

/// Fails with the error.
