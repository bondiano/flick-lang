/// What consumes a stream. `Sink r e i l a` reads chunks of `i`, may stop
/// early and hand back leftovers of `l`, fails with `e`, needs `r`, and
/// gives `a`. A sink is a pure description; a stream runs it. Callbacks
/// kept in a sink hold no captures.
module Sink exposing (..)

import Channel exposing (Channel, WritableStream)
import Duration
import Filter
import PubSub
import Queue
import Stream.Core exposing (Stream)

/// A consumer of elements of `i` giving `a`, with leftovers of `l`.
type Sink (r : ServiceRow) (e : ErrorRow) i l a

/// How a sink ends: its value and the elements it did not consume.
type alias End a l = (a, Option (NonEmpty.NonEmpty l))

/// The sink of a channel that reads chunks and ends with an `End`.
from_channel : Channel r e (NonEmpty.NonEmpty i) o (End a l) none Unit -> Sink r e i l a
foreign pure from_channel from "flick:Sink" "flickFromChannel"

/// The channel of a sink: it reads chunks and ends with an `End`.
to_channel : Sink r e i l a -> Channel r e (NonEmpty.NonEmpty i) o (End a l) none Unit
foreign pure to_channel from "flick:Sink" "flickToChannel"

/// The sink of what `f` does with the stream of its input; it leaves
/// nothing over.
make : (Stream none none i ->{r; e} a) -> Sink {Async | r} e i l a
foreign pure make from "flick:Sink" "flickMake"

/// Writes each chunk to a web stream, closing it at the end when
/// `closeOnDone`; `onError` makes the typed error of what it throws.
from_writable_stream :
  { evaluate : Unit -> WritableStream a; onError : JsValue -> Errors e; closeOnDone : Bool } ->
  Sink {Async} e a l Unit
foreign pure from_writable_stream from "flick:Sink" "fromWritableStream"

/// Runs the task, consuming nothing, and ends as it gives.
from_effect_end : Eff r e (End a l) -> Sink r e i l a
foreign pure from_effect_end from "flick:Sink" "flickFromEffectEnd"

/// Runs the task, consuming nothing, and gives its value.
from_effect : Eff r e a -> Sink r e i l a
foreign pure from_effect from "flick:Sink" "fromEffect"

/// Offers every element to the queue and ends it at the end.
from_queue : Queue.Queue e i -> Sink none none i l Unit
foreign pure from_queue from "flick:Sink" "fromQueue"

/// Publishes every element to the hub.
from_pubsub : PubSub.PubSub i -> Sink none none i l Unit
foreign pure from_pubsub from "flick:Sink" "fromPubSub"

/// Consumes nothing and gives the value.
succeed : a -> Sink none none i l a
foreign pure succeed from "flick:Sink" "succeed"

/// Consumes nothing and gives the value `f` computes when it runs.
sync : (Unit -> a) -> Sink none none i l a
foreign pure sync from "flick:Sink" "sync"

/// The sink `f` builds each time it runs.
suspend : (Unit -> Sink r e i l a) -> Sink r e i l a
foreign pure suspend from "flick:Sink" "suspend"

/// Fails with the error.
fail : Errors e -> Sink none e i l a
foreign pure fail from "flick:Sink" "fail"

/// Fails with the error `f` computes when it runs.
fail_sync : (Unit -> Errors e) -> Sink none e i l a
foreign pure fail_sync from "flick:Sink" "failSync"

/// Fails with the whole cause of `failure`.
fail_cause : Failure e -> Sink none e i l a
foreign pure fail_cause from "flick:Sink" "flickFailCause"

/// Fails with the cause of the failure `f` computes when it runs.
fail_cause_sync : (Unit -> Failure e) -> Sink none e i l a
foreign pure fail_cause_sync from "flick:Sink" "flickFailCauseSync"

/// Consumes everything and never ends.
never : Sink none none i l a
foreign pure never from "flick:Sink" "never"

/// The sink without its leftovers.
ignore_leftover : Sink r e i l a -> Sink r e i l2 a
foreign pure ignore_leftover from "flick:Sink" "ignoreLeftover"

/// Consumes everything, giving nothing.
drain : Sink none none i l Unit
foreign pure drain from "flick:Sink" "drain"

/// Folds elements from `initial` with `f` while `continue` holds of the
/// state; the rest is left over.
fold : (Unit -> s) -> (s -> Bool) -> (s -> i ->{r; e} s) -> Sink r e i i s
foreign pure fold from "flick:Sink" "fold"
  arity 3

/// `fold` a chunk at a time.
fold_array : (Unit -> s) -> (s -> Bool) -> (s -> NonEmpty.NonEmpty i ->{r; e} s) -> Sink r e i l s
foreign pure fold_array from "flick:Sink" "foldArray"
  arity 3

/// Folds at most `max` elements.
fold_until : (Unit -> s) -> Int -> (s -> i ->{r; e} s) -> Sink r e i i s
foreign pure fold_until from "flick:Sink" "foldUntil"
  arity 3

/// Whether `f` holds for every element; stops at the first that fails.
every : (i -> Bool) -> Sink none none i i Bool
foreign pure every from "flick:Sink" "every"

/// Whether `f` holds for some element; stops at the first.
some : (i -> Bool) -> Sink none none i i Bool
foreign pure some from "flick:Sink" "some"

/// The value mapped by `f`.
map : (a -> b) -> Sink r e i l a -> Sink r e i l b
foreign pure map from "flick:Sink" "map"
  arity 1

/// The value replaced by `b`.
as_ : b -> Sink r e i l a -> Sink r e i l b
foreign pure as_ from "flick:Sink" "as"
  arity 1

/// Each element mapped by `f` before the sink reads it.
map_input : (i0 -> i) -> Sink r e i l a -> Sink r e i0 l a
foreign pure map_input from "flick:Sink" "mapInput"
  arity 1

/// Each element mapped by the task `f` gives.
map_input_effect : (i0 ->{r2; e2} i) -> Sink r e i l a -> Sink (r + r2) (e + e2) i0 l a
foreign pure map_input_effect from "flick:Sink" "mapInputEffect"
  arity 1

/// Each chunk mapped by `f` before the sink reads it.
map_input_array : (NonEmpty.NonEmpty i0 -> NonEmpty.NonEmpty i) -> Sink r e i l a -> Sink r e i0 l a
foreign pure map_input_array from "flick:Sink" "mapInputArray"
  arity 1

/// Each chunk mapped by the task `f` gives.
map_input_array_effect :
  (NonEmpty.NonEmpty i0 ->{r2; e2} NonEmpty.NonEmpty i) ->
  Sink r e i l a ->
  Sink (r + r2) (e + e2) i0 l a
foreign pure map_input_array_effect from "flick:Sink" "mapInputArrayEffect"
  arity 1

/// The end, value and leftovers, mapped by `f`.
map_end : (End a l -> End a2 l2) -> Sink r e i l a -> Sink r e i l2 a2
foreign pure map_end from "flick:Sink" "flickMapEnd"
  arity 1

/// The end mapped by the task `f` gives.
map_effect_end : (End a l ->{r2; e2} End a2 l2) -> Sink r e i l a -> Sink (r + r2) (e + e2) i l2 a2
foreign pure map_effect_end from "flick:Sink" "flickMapEffectEnd"
  arity 1

/// The value mapped by the task `f` gives.
map_effect : (a ->{r2; e2} b) -> Sink r e i l a -> Sink (r + r2) (e + e2) i l b
foreign pure map_effect from "flick:Sink" "mapEffect"
  arity 1

/// Each typed error mapped by `f`.
map_error : (Errors e -> Errors e2) -> Sink r e i l a -> Sink r e2 i l a
foreign pure map_error from "flick:Sink" "mapError"
  arity 1

/// Each leftover mapped by `f`.
map_leftover : (l -> l2) -> Sink r e i l a -> Sink r e i l2 a
foreign pure map_leftover from "flick:Sink" "mapLeftover"
  arity 1

/// The first `n` elements; the rest is left over.
take : Int -> Sink none none i i (List i)
foreign pure take from "flick:Sink" "take"

/// Runs the sink, then the one `f` builds of its value on what is left.
flat_map : (a -> Sink r2 e2 i i b) -> Sink r e i i a -> Sink (r + r2) (e + e2) i i b
foreign pure flat_map from "flick:Sink" "flatMap"
  arity 1

/// Folds elements with `f` while `continue` holds of the state.
reduce_while : (Unit -> s) -> (s -> Bool) -> (s -> i -> s) -> Sink none none i i s
foreign pure reduce_while from "flick:Sink" "reduceWhile"
  arity 3

/// `reduce_while` with a task for each step.
reduce_while_effect : (Unit -> s) -> (s -> Bool) -> (s -> i ->{r; e} s) -> Sink r e i i s
foreign pure reduce_while_effect from "flick:Sink" "reduceWhileEffect"
  arity 3

/// `reduce_while` a chunk at a time.
reduce_while_array :
  (Unit -> s) -> (s -> Bool) -> (s -> NonEmpty.NonEmpty i -> s) -> Sink none none i l s
foreign pure reduce_while_array from "flick:Sink" "reduceWhileArray"
  arity 3

/// `reduce_while_array` with a task for each chunk.
reduce_while_array_effect :
  (Unit -> s) -> (s -> Bool) -> (s -> NonEmpty.NonEmpty i ->{r; e} s) -> Sink r e i l s
foreign pure reduce_while_array_effect from "flick:Sink" "reduceWhileArrayEffect"
  arity 3

/// Folds every element with `f`.
reduce : (Unit -> s) -> (s -> i -> s) -> Sink none none i l s
foreign pure reduce from "flick:Sink" "reduce"
  arity 2

/// Folds every chunk with `f`.
reduce_array : (Unit -> s) -> (s -> NonEmpty.NonEmpty i -> s) -> Sink none none i l s
foreign pure reduce_array from "flick:Sink" "reduceArray"
  arity 2

/// Folds every element with a task.
reduce_effect : (Unit -> s) -> (s -> i ->{r; e} s) -> Sink r e i l s
foreign pure reduce_effect from "flick:Sink" "reduceEffect"
  arity 2

/// The first element, if any; the rest is left over.
head : Unit -> Sink none none i i (Option i)
foreign pure head from "flick:Sink" "head"
  arity 0

/// The last element, if any.
last : Unit -> Sink none none i l (Option i)
foreign pure last from "flick:Sink" "last"
  arity 0

/// The first element for which `f` holds.
find : (i -> Bool) -> Sink none none i i (Option i)
foreign pure find from "flick:Sink" "find"

/// The first element for which the task `f` gives `True`.
find_effect : (i ->{r; e} Bool) -> Sink r e i i (Option i)
foreign pure find_effect from "flick:Sink" "findEffect"

/// The sum of the elements.
sum : Sink none none Float l Float
foreign pure sum from "flick:Sink" "sum"

/// The number of elements.
count : Sink none none i l Int
foreign pure count from "flick:Sink" "count"

/// Every element, in order.
collect : Unit -> Sink none none i l (List i)
foreign pure collect from "flick:Sink" "collect"
  arity 0

/// The elements while `f` holds; the rest is left over.
take_while : (i -> Bool) -> Sink none none i i (List i)
foreign pure take_while from "flick:Sink" "takeWhile"

/// The elements the filter passes, as it maps them, up to the first it
/// rejects.
take_while_filter : Filter.Filter i b x -> Sink none none i i (List b)
foreign pure take_while_filter from "flick:Sink" "takeWhileFilter"

/// The elements while the task `f` gives `True`.
take_while_effect : (i ->{r; e} Bool) -> Sink r e i i (List i)
foreign pure take_while_effect from "flick:Sink" "takeWhileEffect"

/// `take_while_filter` with an effectful filter.
take_while_filter_effect : Filter.FilterEffect r e i b x -> Sink r e i i (List b)
foreign pure take_while_filter_effect from "flick:Sink" "takeWhileFilterEffect"

/// The elements up to and including the first for which `f` holds.
take_until : (i -> Bool) -> Sink none none i i (List i)
foreign pure take_until from "flick:Sink" "takeUntil"

/// `take_until` with a task.
take_until_effect : (i ->{r; e} Bool) -> Sink r e i i (List i)
foreign pure take_until_effect from "flick:Sink" "takeUntilEffect"

/// Runs `f` on each element.
for_each : (i ->{r; e} x) -> Sink r e i l Unit
foreign pure for_each from "flick:Sink" "forEach"

/// Runs `f` on each chunk.
for_each_array : (NonEmpty.NonEmpty i ->{r; e} x) -> Sink r e i l Unit
foreign pure for_each_array from "flick:Sink" "forEachArray"

/// Runs `f` on each element while it gives `True`.
for_each_while : (i ->{r; e} Bool) -> Sink r e i l Unit
foreign pure for_each_while from "flick:Sink" "forEachWhile"

/// Runs `f` on each chunk while it gives `True`.
for_each_while_array : (NonEmpty.NonEmpty i ->{r; e} Bool) -> Sink r e i l Unit
foreign pure for_each_while_array from "flick:Sink" "forEachWhileArray"

/// The sink the task builds when it runs.
unwrap : Eff r e1 (Sink r2 e2 i l a) -> Sink {Async | r + r2} (e1 + e2) i l a
foreign pure unwrap from "flick:Sink" "unwrap"

/// Runs `summary` before and after the sink, and pairs its value with `f`
/// of the two results.
summarized : Eff r2 e2 x -> (x -> x -> y) -> Sink r e i l a -> Sink (r + r2) (e + e2) i l (a, y)
foreign pure summarized from "flick:Sink" "summarized"
  arity 2

/// The value paired with how long the sink ran.
with_duration : Sink r e i l a -> Sink r e i l (a, Duration.Duration)
foreign pure with_duration from "flick:Sink" "withDuration"

/// Consumes everything and gives how long it took.
timed : Sink none none i l Duration.Duration
foreign pure timed from "flick:Sink" "timed"

/// Provides the service named by the tag with the implementation.
provide_service : ServiceTag s -> ServiceImpl s -> Sink (s + r) e i l a -> Sink r e i l a
foreign pure provide_service from "flick:Sink" "provideService"
  arity 2

/// On a typed error, runs the sink `f` builds of it instead.
or_else : (Errors e -> Sink r2 e2 i l a) -> Sink r e i l a -> Sink (r + r2) (e + e2) i l a
foreign pure or_else from "flick:Sink" "orElse"
  arity 1

/// Recovers from a typed error with the value of the task `f` builds.
catch : (Errors e ->{r2; e2} a) -> Sink r e i l a -> Sink (r + r2) e2 i l a
foreign pure catch from "flick:Sink" "catch"
  arity 1

/// Recovers from any failure with the value of the task `f` builds.
catch_cause : (Failure e ->{r2; e2} a) -> Sink r e i l a -> Sink (r + r2) e2 i l a
foreign pure catch_cause from "flick:Sink" "flickCatchCause"
  arity 1

/// Runs `f` with how the sink ended.
on_exit : (Exit e a ->{r2; e2} x) -> Sink r e i l a -> Sink (r + r2) (e + e2) i l a
foreign pure on_exit from "flick:Sink" "flickOnExit"
  arity 1

/// Runs the task when the sink ends, however it ends.
ensuring : Eff r2 e2 x -> Sink r e i l a -> Sink (r + r2) (e + e2) i l a
foreign pure ensuring from "flick:Sink" "ensuring"
  arity 1
