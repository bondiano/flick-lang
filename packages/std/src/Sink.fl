foreign pure fold_until from "@flick-lang/effect-ts/effect/Sink" "foldUntil"
  arity 3
  reviewed "effect@4.1.2 sha256:c42b0503c09f43b1"

/// Whether `f` holds for every element; stops at the first that fails.
every : (i -> Bool) -> Sink none none i i Bool
