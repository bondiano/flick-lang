foreign pure fold from "@flick-lang/effect-ts/effect/Sink" "fold"
  arity 3
  reviewed "effect@4.1.2 sha256:339c3605526f01e5"

/// `fold` a chunk at a time.
fold_array : (Unit -> s) -> (s -> Bool) -> (s -> NonEmpty.NonEmpty i ->{r; e} s) -> Sink r e i l s
foreign pure fold_array from "@flick-lang/effect-ts/effect/Sink" "foldArray"
  arity 3
  reviewed "effect@4.1.2 sha256:73d9fabd4f46bd4e"

/// Folds at most `max` elements.
