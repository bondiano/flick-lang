  reviewed "effect@4.1.2 sha256:b66c40368d50445e"

/// Whether `f` holds for some element; stops at the first.
some : (i -> Bool) -> Sink none none i i Bool
foreign pure some from "@flick-lang/effect-ts/effect/Sink" "some"
  reviewed "effect@4.1.2 sha256:7154ca600c4d207e"

