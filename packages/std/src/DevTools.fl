/// The Effect DevTools: a program that provides `layer` sends its spans, as
/// they start and end, over a WebSocket to the DevTools at `url`, which
/// must already listen. The module is experimental.
module DevTools exposing (..)

/// Spans sent to the DevTools at `url`; they listen on
/// `ws://localhost:34437` by default.
layer : String -> Layer none none none
foreign pure layer from "flick:devtools/DevTools" "devToolsLayer"

/// Where the DevTools listen, and the headers of the WebSocket's handshake:
/// a token a proxy in front of them checks, say.
type alias Options = { url : String; headers : List (String, String) }

/// `layer` with handshake headers, which only Node's WebSocket sends.
/// Node only.
layer_with : Options -> Layer none none none
foreign pure layer_with from "flick:devtools/DevToolsNode" "devToolsLayerWith"
