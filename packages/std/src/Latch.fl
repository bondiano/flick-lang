/// A gate tasks wait at until it opens.
module Latch exposing (..)

/// A gate, open or closed.
type Latch

/// A fresh latch, open when `open` holds.
make : Bool ->{} Latch
foreign effect make from "flick:Latch" "make"

/// Opens the latch, letting every waiting and later task through; whether
/// it was closed.
open : Latch ->{} Bool
foreign effect open from "flick:Latch" "open"

/// Lets the tasks waiting now through, leaving the latch closed; whether
/// any waited.
release : Latch ->{} Bool
foreign effect release from "flick:Latch" "release"

/// Waits until the latch opens or releases its waiters.
await_ : Latch ->{Async} Unit
foreign effect await_ from "flick:Latch" "await"

/// Closes the latch; whether it was open.
close : Latch ->{} Bool
foreign effect close from "flick:Latch" "close"

/// Runs `task` once the latch is open: `task |> Latch.when_open latch`.
when_open : Latch -> (Eff r e a)^c ->{r; e} a
foreign effect when_open from "flick:Latch" "whenOpen"
  arity 1
  retention call

/// Whether the latch is open now.
is_open : Latch ->{} Bool
foreign is_open from "flick:Latch" "isOpen"
