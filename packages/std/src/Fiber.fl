/// Children of a `scope`: a child runs until its owner's scope closes, and
/// its supervisor observes how it failed.
module Fiber exposing (
  Owner,
  Fiber,
  Outlives,
  Provided,
  spawn,
  join,
  await_,
  await_all,
  join_all,
  interrupt,
  interrupt_as,
  interrupt_all,
  interrupt_all_as,
)

@lang owner
/// The owner of a `scope`; `scope s { … }` names it `s`.
type Owner (s : Region)

/// A running child that fails with an error of `e` or succeeds with `a`.
type Fiber (e : ErrorRow) a

@lang outlives
/// The captures `c` end no earlier than the region `s`. The compiler
/// decides it from the scopes; a program cannot declare instances of it.
class Outlives (c : CaptureRow) (s : Region)

@lang provided
/// The services `r` come from providers that end no earlier than the
/// region `s`: a child of its owner runs with them after the code that
/// started it. The compiler decides it from the `provide`s and scopes; a
/// signature names it for an owner and services its caller gives.
class Provided (r : ServiceRow) (s : Region)

/// Starts `task` as a child of `owner`; `supervisor` observes its failure.
/// Both may hold only what outlives the owner.
spawn : Owner s -> (Failure e ->{Scope s | r} Unit)^c -> (Eff {Scope s | r} e a)^c ->{r} Fiber e a
foreign effect spawn from "flick:rt" "fiberSpawn"
  retention owner

/// Waits for the child: its result, or its failure with the original cause.
join : Fiber e a ->{Async; e} a
foreign effect join from "flick:rt" "fiberJoin"

/// Waits for the child and gives how it ended, without failing.
await_ : Fiber e a ->{Async} Exit e a
foreign effect await_ from "flick:Fiber" "flickAwait"

/// Waits for every child; how each ended, in order.
await_all : List (Fiber e a) ->{Async} List (Exit e a)
foreign effect await_all from "flick:Fiber" "flickAwaitAll"

/// Waits for every child: their results in order, or the first failure.
join_all : List (Fiber e a) ->{Async; e} List a
foreign effect join_all from "flick:Fiber" "flickJoinAll"

/// Interrupts the child and waits until it ended; its supervisor sees the
/// interruption.
interrupt : Fiber e a ->{Async} Unit
foreign effect interrupt from "flick:Fiber" "flickInterrupt"

/// `interrupt`, naming the fiber id of the interruption.
interrupt_as : Option Float -> Fiber e a ->{Async} Unit
foreign effect interrupt_as from "flick:Fiber" "flickInterruptAs"
  arity 1

/// Interrupts every child and waits until they ended.
interrupt_all : List (Fiber e a) ->{Async} Unit
foreign effect interrupt_all from "flick:Fiber" "flickInterruptAll"

/// `interrupt_all`, naming the fiber id of the interruption.
interrupt_all_as : Float -> List (Fiber e a) ->{Async} Unit
foreign effect interrupt_all_as from "flick:Fiber" "flickInterruptAllAs"
  arity 1
