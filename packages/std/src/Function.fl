/// Functions as values: the helpers that Flick does not write with `|>`,
/// `fun` or a tuple pattern.
module Function exposing (..)

/// A value computed when asked for.
type alias LazyArg a = Unit -> a

/// The function that always gives `value`.
constant : a -> LazyArg a
foreign pure constant from "flick:Function" "constant"
  arity 1

/// Always `true`.
const_true : LazyArg Bool
foreign pure const_true from "flick:Function" "constTrue"

/// Always `false`.
const_false : LazyArg Bool
foreign pure const_false from "flick:Function" "constFalse"

/// Always `()`.
const_void : LazyArg Unit
foreign pure const_void from "flick:Function" "constVoid"

/// `f` with its two arguments swapped.
flip : (a -> b -> c) -> b -> a -> c
foreign pure flip from "flick:Function" "flickFlip"
  arity 1

/// `compose g f` applies `f`, then `g`.
compose : (b -> c) -> (a -> b) -> a -> c
foreign pure compose from "flick:Function" "compose"
  arity 1

/// A value of any type from one that cannot exist.
absurd : Never -> a
foreign pure absurd from "flick:Function" "absurd"

/// `f` taking its two arguments as a pair.
tupled : (a -> b -> c) -> (a, b) -> c
foreign pure tupled from "flick:Function" "tupled"
  arity 1

/// `f` of a pair taking the two parts as arguments.
untupled : ((a, b) -> c) -> a -> b -> c
foreign pure untupled from "flick:Function" "flickUntupled"
  arity 1

/// Its second argument.
sk : a -> b -> b
foreign pure sk from "flick:Function" "SK"
