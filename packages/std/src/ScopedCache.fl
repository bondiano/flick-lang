/// A `Cache` whose lookups acquire resources. A value is used only inside
/// `use`, which holds it: an entry's resources are released when it is
/// dropped and no `use` holds its value, and all of them when the `scope`
/// owning the cache's region closes. Keys are compared by `==`.
module ScopedCache exposing (..)

import Duration

/// A cache of region `s` from keys of `k` to values of `a`, whose lookup
/// fails with `e`.
type ScopedCache (s : Region) k (e : ErrorRow) a

/// A cache owned by the innermost `scope` (or the one of region `s`);
/// `lookup` runs with the services of the call that made it, and what it
/// acquires belongs to its entry, a region `t` of its own: a value of a type
/// that names its region, such as `File t`, cannot be cached. Entries live
/// for `timeToLive` (`None`: until evicted).
make :
  {
    lookup : forall t. k ->{Scope t | r; e} a^{t};
    capacity : Int;
    timeToLive : Option Duration.Duration;
  } ->{Scope s | r}
  ScopedCache s k e a
foreign effect make from "flick:ScopedCache" "flickMake"

/// `make`, the time to live of each entry computed from how its lookup
/// ended and its key.
make_with :
  {
    lookup : forall t. k ->{Scope t | r; e} a^{t};
    capacity : Int;
    timeToLive : Option (Exit e a -> k -> Duration.Duration);
  } ->{Scope s | r}
  ScopedCache s k e a
foreign effect make_with from "flick:ScopedCache" "flickMakeWith"

/// Runs `f` with the value of `key`, looking it up once if it is missing or
/// expired; a failed lookup is cached too. The value stays acquired until
/// `f` ends, and what `f` gives cannot hold it.
use : k -> ScopedCache s k e a -> (forall t. a^{t} ->{r; e2} b)^c ->{r; e + e2} b
foreign effect use from "flick:ScopedCache" "flickUse"
  retention call

/// `use` of the value of `key` if it is cached, waiting for a lookup under
/// way, without a new one; fails as the cached lookup did.
use_option : k -> ScopedCache s k e a -> (forall t. (Option a)^{t} ->{r; e2} b)^c ->{r; e + e2} b
foreign effect use_option from "flick:ScopedCache" "flickUseOption"
  retention call

/// `use` of the value of `key` if a lookup of it has succeeded and not
/// expired.
use_success : k -> ScopedCache s k e a -> (forall t. (Option a)^{t} ->{r; e2} b)^c ->{r; e2} b
foreign effect use_success from "flick:ScopedCache" "flickUseSuccess"
  retention call

/// Caches `value` for `key`.
set : k -> a -> ScopedCache s k e a ->{} Unit
foreign effect set from "flick:ScopedCache" "flickSet"
  arity 2
  retention call

/// Whether `key` is cached.
has : k -> ScopedCache s k e a ->{} Bool
foreign effect has from "flick:ScopedCache" "has"
  arity 1
  retention call

/// Drops `key`.
invalidate : k -> ScopedCache s k e a ->{} Unit
foreign effect invalidate from "flick:ScopedCache" "invalidate"
  arity 1
  retention call

/// Drops `key` if its value satisfies `f`; whether it did.
invalidate_when : k -> (a -> Bool)^c -> (ScopedCache s k e a ->{} Bool)^c
foreign effect invalidate_when from "flick:ScopedCache" "flickInvalidateWhen"
  arity 2
  retention call

/// Looks `key` up again, cached or not, starting its time to live anew; the
/// previous value is released once no `use` holds it.
refresh : k -> ScopedCache s k e a ->{Async; e} Unit
foreign effect refresh from "flick:ScopedCache" "flickRefresh"
  arity 1
  retention call

/// Drops every key.
invalidate_all : ScopedCache s k e a ->{} Unit
foreign effect invalidate_all from "flick:ScopedCache" "invalidateAll"
  retention call

/// The number of cached keys.
size : ScopedCache s k e a ->{} Int
foreign effect size from "flick:ScopedCache" "size"
  retention call

/// The cached keys.
keys : ScopedCache s k e a ->{} List k
foreign effect keys from "flick:ScopedCache" "keys"
  retention call
