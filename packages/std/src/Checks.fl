/// Checks for refined types, which the compiler can also apply to a constant
/// and exporters can state: `refined type Email = String where Checks.email`.
module Checks exposing (..)

@lang check_email
/// One `@` with text on both sides and a dot in the domain; not every rule
/// of email addresses.
email : String -> Bool
foreign pure email from "@flick-lang/runtime" "checkEmail"

@lang check_non_empty
non_empty : String -> Bool
foreign pure non_empty from "@flick-lang/runtime" "checkNonEmpty"

@lang check_positive
positive : Float -> Bool
foreign pure positive from "@flick-lang/runtime" "checkPositive"
