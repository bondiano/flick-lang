/// Channels that decode or encode each chunk with a codec, failing with
/// `SchemaError`; upstream errors and the done value pass through.
module ChannelSchema exposing (..)

import Channel exposing (Channel)

/// Decodes each chunk of wire values.
decode :
  Codec rd re w a ->
  Channel rd {SchemaError | ie} (NonEmpty.NonEmpty w) (NonEmpty.NonEmpty a) d ie d
foreign pure decode from "flick:ChannelSchema" "flickDecode"

/// Decodes each chunk of unknown values.
decode_unknown :
  Codec rd re w a ->
  Channel rd {SchemaError | ie} (NonEmpty.NonEmpty Unknown) (NonEmpty.NonEmpty a) d ie d
foreign pure decode_unknown from "flick:ChannelSchema" "flickDecode"

/// Encodes each chunk to wire values.
encode :
  Codec rd re w a ->
  Channel re {SchemaError | ie} (NonEmpty.NonEmpty a) (NonEmpty.NonEmpty w) d ie d
foreign pure encode from "flick:ChannelSchema" "flickEncode"

/// Encodes each chunk, its wire values as unknown values.
encode_unknown :
  Codec rd re w a ->
  Channel re {SchemaError | ie} (NonEmpty.NonEmpty a) (NonEmpty.NonEmpty Unknown) d ie d
foreign pure encode_unknown from "flick:ChannelSchema" "flickEncode"

/// A channel over wire values as one over decoded ones: its input is
/// encoded with `inputSchema` and its output decoded with `outputSchema`.
duplex :
  { inputSchema : Codec ird ire iw ia; outputSchema : Codec ord ore ow oa } ->
  Channel r e (NonEmpty.NonEmpty iw) (NonEmpty.NonEmpty ow) d {SchemaError | ie} id ->
  Channel (r + ire + ord) {SchemaError | e} (NonEmpty.NonEmpty ia) (NonEmpty.NonEmpty oa) d ie id
foreign pure duplex from "flick:ChannelSchema" "flickDuplex"
  arity 1

/// `duplex` of a channel whose output is unknown values.
duplex_unknown :
  { inputSchema : Codec ird ire iw ia; outputSchema : Codec ord ore ow oa } ->
  Channel r e (NonEmpty.NonEmpty iw) (NonEmpty.NonEmpty Unknown) d {SchemaError | ie} id ->
  Channel (r + ire + ord) {SchemaError | e} (NonEmpty.NonEmpty ia) (NonEmpty.NonEmpty oa) d ie id
foreign pure duplex_unknown from "flick:ChannelSchema" "flickDuplex"
  arity 1
