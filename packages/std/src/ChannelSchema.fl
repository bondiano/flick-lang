/// Effect's `ChannelSchema`: channels that decode or encode each chunk
/// with a codec, failing with `SchemaError`; upstream errors and the done
/// value pass through.
module ChannelSchema exposing (..)

import Channel exposing (Channel)

/// Decodes each chunk of wire values.
decode :
  Codec rd re w a ->
  Channel rd {SchemaError | ie} (NonEmpty.NonEmpty w) (NonEmpty.NonEmpty a) d ie d
foreign pure decode from "@flick-lang/effect-ts/effect/ChannelSchema" "flickDecode"
  reviewed "effect@4.1.2 sha256:b68dc558b2a1522b"

/// Decodes each chunk of unknown values.
decode_unknown :
  Codec rd re w a ->
  Channel rd {SchemaError | ie} (NonEmpty.NonEmpty Unknown) (NonEmpty.NonEmpty a) d ie d
foreign pure decode_unknown from "@flick-lang/effect-ts/effect/ChannelSchema" "flickDecode"
  reviewed "effect@4.1.2 sha256:b8cf3a9ea357e5e4"

/// Encodes each chunk to wire values.
encode :
  Codec rd re w a ->
  Channel re {SchemaError | ie} (NonEmpty.NonEmpty a) (NonEmpty.NonEmpty w) d ie d
foreign pure encode from "@flick-lang/effect-ts/effect/ChannelSchema" "flickEncode"
  reviewed "effect@4.1.2 sha256:deab460a9c9e371a"

/// Encodes each chunk, its wire values as unknown values.
encode_unknown :
  Codec rd re w a ->
  Channel re {SchemaError | ie} (NonEmpty.NonEmpty a) (NonEmpty.NonEmpty Unknown) d ie d
foreign pure encode_unknown from "@flick-lang/effect-ts/effect/ChannelSchema" "flickEncode"
  reviewed "effect@4.1.2 sha256:db0ae9d339ef3dc5"

/// A channel over wire values as one over decoded ones: its input is
/// encoded with `inputSchema` and its output decoded with `outputSchema`.
duplex :
  { inputSchema : Codec ird ire iw ia; outputSchema : Codec ord ore ow oa } ->
  Channel r e (NonEmpty.NonEmpty iw) (NonEmpty.NonEmpty ow) d {SchemaError | ie} id ->
  Channel (r + ire + ord) {SchemaError | e} (NonEmpty.NonEmpty ia) (NonEmpty.NonEmpty oa) d ie id
foreign pure duplex from "@flick-lang/effect-ts/effect/ChannelSchema" "flickDuplex"
  arity 1
  reviewed "effect@4.1.2 sha256:549ab6426e2eb9ed"

/// `duplex` of a channel whose output is unknown values.
duplex_unknown :
  { inputSchema : Codec ird ire iw ia; outputSchema : Codec ord ore ow oa } ->
  Channel r e (NonEmpty.NonEmpty iw) (NonEmpty.NonEmpty Unknown) d {SchemaError | ie} id ->
  Channel (r + ire + ord) {SchemaError | e} (NonEmpty.NonEmpty ia) (NonEmpty.NonEmpty oa) d ie id
foreign pure duplex_unknown from "@flick-lang/effect-ts/effect/ChannelSchema" "flickDuplex"
  arity 1
  reviewed "effect@4.1.2 sha256:1cab1c2c63ba1071"
