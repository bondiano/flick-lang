{
  "name": "@flick-lang/effect-ts",
  "version": "0.1.0",
  "description": "Effect adapter for code generated by the Flick compiler",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bondiano/flick-lang.git",
    "directory": "packages/effect-ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "./dist/bridge.js",
    "./dist/bridge_kernel.js",
    "./dist/bridge_data.js",
    "./dist/bridge_layer.js",
    "./dist/bridge_schema.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "default": "./dist/bridge.js"
    },
    "./runner/*": {
      "types": "./dist/runner/*.d.ts",
      "default": "./dist/runner/*.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./ui/react": {
      "types": "./dist/ui/react/index.d.ts",
      "default": "./dist/ui/react/index.js"
    },
    "./ui/html": {
      "types": "./dist/ui/html.d.ts",
      "default": "./dist/ui/html.js"
    },
    "./ui/server": {
      "types": "./dist/ui/server.d.ts",
      "default": "./dist/ui/server.js"
    },
    "./sql": {
      "types": "./dist/sql/index.d.ts",
      "default": "./dist/sql/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./effect/*": {
      "types": "./dist/effect/*.d.ts",
      "default": "./dist/effect/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings",
    "test": "tsc -p tsconfig.build.json && node --test"
  },
  "dependencies": {
    "@effect/platform-browser": "4.1.2",
    "@effect/platform-node": "4.1.2",
    "effect": "4.1.2",
    "@flick-lang/runtime": "workspace:*"
  },
  "peerDependencies": {
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "jsdom": "30.1.3",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.1.0-beta"
  }
}
