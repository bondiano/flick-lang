/// What only a server does: a function that needs `Server` is unreachable
/// from a client entry, `target = "client"` in `flick.toml` (`FLICK-E009`).
/// A `server fn` runs here and is called from anywhere over HTTP: its name
/// is the call, `server name` its implementation, which `handler` serves.
module Server exposing (..)

import Http.Headers
import Http.ServerRequest exposing (ServerRequest)
import Http.ServerResponse exposing (ServerResponse)
import Layer
import Schema

@lang server
/// The server a program runs on; it has no operations of its own.
service Server

/// Provides `Server` to a server entry.
node : Layer none none {Server}
let node = Layer.succeed Server {}

@lang server_function
/// The implementation of a `server fn` with its name and the codecs of
/// what it sends: `server name` gives it, `handler` serves it. `r` is what
/// it needs, `Server` among it.
type Function (r : ServiceRow)

@lang server_guarded
/// The implementation of a `server fn` that lists `Unauthorized` among its
/// errors: it runs for a caller `authenticated` lets in, so `handler`
/// serves it only through that.
type Guarded (r : ServiceRow)

/// A call `authenticated` turns away: its credentials prove no one. The
/// body of the function does not run, and the caller gets this error.
type error Unauthorized = Unauthorized
  deriving Eq, Show, Schema

/// The implementations of `functions`, each run with the service `tag`
/// that `check` makes from the headers of its call: from a cookie or an
/// `authorization` header, say. A call `check` fails with `Unauthorized`
/// does not run the function. Each call has its own: concurrent callers do
/// not see each other's.
authenticated :
  ServiceTag a ->
  (Http.Headers.Headers ->{r; Unauthorized} ServiceImpl a) ->
  List (Guarded (a + r)) ->
  List (Function r)
foreign pure authenticated from "@flick-lang/runtime/effect/server/Functions" "serverAuthenticated"
  arity 3

/// Where `handler` is mounted and the calls of every `server fn` go:
/// `Http.Router.route (Some Http.Method.POST) Server.path handler`.
path : String
let path = "/_flick/fn"

/// The calls of `functions`, each a POST of its name and payload as
/// NDJSON, for a route at `path`. It holds region `s`: when the scope
/// owning it closes, the calls it serves finish and run their finalizers.
handler : List (Function r) ->{Scope s | r;} (ServerRequest ->{Async;} ServerResponse)^{s}
foreign effect handler from "@flick-lang/runtime/effect/server/FunctionsNode" "serverHandler"
  retention owner
